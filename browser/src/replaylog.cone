// What a client that joins late is told. The server keeps the requests it has
// sent its clients, as the bytes it sent (netcodec.cone), and replays them to a
// newcomer in the order they were sent: the content to build (the Objects),
// the beings, and where everything stands now. A request that sets a value
// (a part's place, its tint, a material's glow, a burst of the burner) replaces
// the one before it for the same part, so the log is as long as the world is
// big, not as long as the session.

struct LogEntry {
  key: u64;                    // what a later request of the same kind replaces; 0: nothing does
  bytes: List[u8];
}

pub struct ReplayLog {
  entries: List[LogEntry];     // in the order sent (replayed by position; never removed)
  at: Dict[u64, usize];        // a replaceable request's key -> its entry's position (entries never move)

  pub fn empty() ReplayLog { ReplayLog(List[LogEntry](), Dict[u64, usize]()) }

  pub fn len(self: &) usize { entries.len() }

  // A copy of the bytes of entry 'i'
  pub fn copyOf(self: &, i: usize) List[u8] {
    let src = &entries[i];
    var out = List[u8].withCapacity(src.bytes.len());
    var k = 0usize;
    while k < src.bytes.len() {
      out.push(*src.bytes[k]);
      k = k + 1usize;
    }
    out
  }

  // Request 'r', which was encoded as 'one', is kept
  pub fn add(self: &mut, r: &Request, one: List[u8]) {
    let key = replaceKey(r);
    if key != 0u64 {
      var found = entries.len();
      match at.get(&key) {
        case let Some(p) { found = *p; }
        else {}
      }
      if found < entries.len() {
        entries.set(found, LogEntry(key, one));
        return;
      }
      at.insert(key, entries.len());
    }
    entries.push(LogEntry(key, one));
  }
}

// What identifies the request among those a later one replaces: a different number for each kind and part. 0: none
fn replaceKey(r: &Request) u64 {
  match r {
    case let Place(p) { return idKey(p.id, 1u64); }
    case let Tint(t) { return idKey(t.id, 2u64); }
    case let Glow(g) { return idKey(g.material.id, 3u64); }
    case let Fire(f) { return idKey(f.id, 4u64); }
    case let Parent(pa) { return idKey(pa.id, 5u64); }
    case let LightSource(ls) { return idKey(ls.id, 6u64); }
    case let CastsShadow(cs) { return idKey(cs.id, 7u64); }
    else {}
  }
  0u64
}

fn idKey(id: PartId, kind: u64) u64 {
  ((u64.from(id.key.slot()) << 3u64) | kind) + (u64.from(id.key.generation()) << 40u64)
}
