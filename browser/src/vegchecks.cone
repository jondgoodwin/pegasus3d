// The vegetation's headless checks (part of 'browser.exe --checks'): the
// layout's rules, read off its items on the baked island, with no mesh, scene
// or GPU.
//
//   no tree within 4.4 m of the path's centre, none (trunk and a margin) in the cottage
//   every tree and plant stands on the ground: its base within 5 cm of the island's height there
//   everything inside the fence, on land above the sea
//   no edging stone or rock on the walking surface (centre distance less its reach at least 0.85 m,
//   the half width 0.9 m less 0.05 m), every edging stone within 0.6 m outside the edge
//   no edging stone more than 1.5 m from the path's centre, none in the cottage
//   no two trees closer than 3 m
//   the layout rebuilt from its seed is the same list, item for item
//   the counts: trees, rocks and plants within their caps, and some of every kind

fn vegAbs(x f32) f32 { if x < 0. { 0. - x; } else { x; }; }

fn vegIsTree(k u32) bool { k == K_PINE or k == K_MAPLE or k == K_SPECIMEN; }

fn checkVegetation() bool {
  print <- "The vegetation's layout:\n";
  bakeIsland();
  imm items = vegetationLayout();
  mut counts Array[usize, 8] = [0usize, 0usize, 0usize, 0usize, 0usize, 0usize, 0usize, 0usize];
  mut treeOnPath = 0usize;
  mut treeInCottage = 0usize;
  mut notOnGround = 0usize;
  mut outside = 0usize;
  mut edgingFar = 0usize;
  mut edgingInCottage = 0usize;
  mut tooClose = 0usize;
  mut worstGround f32 = 0.;
  mut nearestTreeToPath f32 = 1000.;
  mut i = 0usize;
  while i < items.len() {
    imm it = items[i];
    counts[usize.from(it.kind)] = counts[usize.from(it.kind)] + 1usize;
    imm gh = groundHeight(it.x, it.z);
    if vegAbs(it.y - gh) > worstGround { worstGround = vegAbs(it.y - gh); }
    if vegAbs(it.y - gh) > 0.05 { notOnGround = notOnGround + 1usize; }
    if !insideIslandFence(it.x, it.z) or gh <= 0.1 { outside = outside + 1usize; }
    if vegIsTree(it.kind) {
      imm pd = pathDistanceAt(it.x, it.z);
      if pd < nearestTreeToPath { nearestTreeToPath = pd; }
      if pd < 4.4 { treeOnPath = treeOnPath + 1usize; }
      if nearCottage(it.x, it.z, 0.4, 0.5) { treeInCottage = treeInCottage + 1usize; }
      mut j = i + 1usize;
      while j < items.len() {
        imm o = items[j];
        if vegIsTree(o.kind) {
          imm dx = it.x - o.x;
          imm dz = it.z - o.z;
          if dx * dx + dz * dz < 9. { tooClose = tooClose + 1usize; }
        }
        j = j + 1usize;
      }
    }
    if it.kind == K_EDGING {
      if pathDistanceAt(it.x, it.z) > 1.5 { edgingFar = edgingFar + 1usize; }
      if nearCottage(it.x, it.z, 0.1, 0.) { edgingInCottage = edgingInCottage + 1usize; }
    }
    i = i + 1usize;
  }
  print <- "  items: "; print <- items.len(); print <- " (specimens "; print <- counts[0usize]; print <- ", pines "; print <- counts[1usize];
  print <- ", forest maples "; print <- counts[2usize]; print <- ", rocks "; print <- counts[3usize]; print <- ", edging stones ";
  print <- counts[4usize]; print <- ", hostas "; print <- counts[5usize]; print <- ", ferns "; print <- counts[6usize]; print <- ", flowers ";
  print <- counts[7usize]; print <- ")\n";
  mut ok = expect("no tree within 4.4 m of the path's centre", treeOnPath == 0usize);
  print <- "    (the nearest is "; print <- nearestTreeToPath; print <- " m)\n";
  ok = expect("no tree's trunk in the cottage", treeInCottage == 0usize) and ok;
  ok = expect("every tree and plant stands on the ground (base within 5 cm of its height)", notOnGround == 0usize) and ok;
  print <- "    (the worst is "; print <- worstGround; print <- " m)\n";
  ok = expect("everything inside the fence, on land", outside == 0usize) and ok;
  ok = expect("no edging stone more than 1.5 m from the path's centre", edgingFar == 0usize) and ok;
  ok = expect("none in the cottage", edgingInCottage == 0usize) and ok;
  ok = expect("no two trees closer than 3 m", tooClose == 0usize) and ok;
  ok = expect("trees stay within their cap (the anchors extra)", counts[1usize] + counts[2usize] <= MAX_TREES + 8usize) and ok;
  ok = expect("two specimen maples", counts[0usize] == 2usize) and ok;
  ok = expect("some of every other kind", counts[1usize] > 10usize and counts[2usize] > 3usize and counts[3usize] > 20usize
    and counts[4usize] > 50usize and counts[5usize] > 5usize and counts[6usize] > 20usize and counts[7usize] > 10usize) and ok;
  // the same from the seed again
  imm again = vegetationLayoutAgain();
  mut same = again.len() == items.len();
  i = 0usize;
  while same and i < items.len() {
    imm a = items[i];
    imm b = again[i];
    if a.kind != b.kind or a.variant != b.variant or a.x != b.x or a.z != b.z or a.yaw != b.yaw or a.scale != b.scale { same = false; }
    i = i + 1usize;
  }
  ok = expect("the layout rebuilt from its seed is the same list, item for item", same) and ok;
  ok = checkAssemblyLayout(&items) and ok;
  ok = checkLanterns(&items) and ok;
  ok = checkPathEdge(&items) and ok;
  ok;
}

// The path's edge: no edging stone or rock reaches onto the walking surface (half width 0.9 m, less
// 0.05 m of tolerance), and every edging stone sits within 0.6 m outside the edge. The distance is
// to the centreline's own segments, not the baked grid. A stone's reach is its item's radius; a
// rock's is ROCK_REACH a metre of scale.
fn checkPathEdge(items &List[Item]) bool {
  print <- "The path's edge:\n";
  imm line = pathCentreline();
  mut onPath = 0usize;
  mut rockOnPath = 0usize;
  mut stones = 0usize;
  mut outer = 0usize;
  mut nearest = 1000.;
  mut farthest = 0.;
  mut nearestRock = 1000.;
  mut i = 0usize;
  while i < items.len() {
    imm it = items[i];
    if it.kind == K_EDGING or it.kind == K_ROCK {
      imm d = vegAbs(alongAndOff(&line, it.x, it.z).y);
      if it.kind == K_EDGING {
        imm gap = d - it.radius - 0.9;
        stones = stones + 1usize;
        if gap < nearest { nearest = gap; }
        if gap > farthest { farthest = gap; }
        if gap < -0.05 { onPath = onPath + 1usize; }
        if gap > 0.6 { outer = outer + 1usize; }
      } else {
        imm gap = d - ROCK_REACH * it.scale - 0.9;
        if gap < nearestRock { nearestRock = gap; }
        if gap < -0.05 { rockOnPath = rockOnPath + 1usize; }
      }
    }
    i = i + 1usize;
  }
  mut ok = expect("no edging stone reaches onto the walking surface", onPath == 0usize);
  print <- "    ("; print <- stones; print <- " stones, the nearest "; print <- nearest; print <- " m clear of the edge, the farthest "; print <- farthest; print <- " m)\n";
  ok = expect("every edging stone lies within 0.6 m outside the edge", outer == 0usize) and ok;
  ok = expect("no rock reaches onto the walking surface", rockOnPath == 0usize) and ok;
  print <- "    (the nearest rock "; print <- nearestRock; print <- " m clear of the edge)\n";
  ok;
}

// Where (x, z) lies against the path's centreline: x the distance along the path back from its end
// at the steps' foot, y the signed distance off it (positive on its left, the heading's left-hand
// normal), by projection on its nearest segment
fn alongAndOff(line &List[Vec3], x f32, z f32) Vec2 {
  mut best = 1.0e9;
  mut along = 0.;
  mut off = 0.;
  mut arc = 0.;
  mut k = line.len() - 1usize;
  while k > 0usize {
    imm a = *line[k - 1usize];
    imm b = *line[k];
    imm sx = b.x - a.x;
    imm sz = b.z - a.z;
    imm sl = (sx * sx + sz * sz).sqrt() + 0.00001;
    imm u = ((x - a.x) * sx + (z - a.z) * sz) / (sl * sl);
    imm t = if u < 0. { 0.; } elif u > 1. { 1.; } else { u; };
    imm px = a.x + sx * t;
    imm pz = a.z + sz * t;
    imm d = ((x - px) * (x - px) + (z - pz) * (z - pz)).sqrt();
    if d < best {
      best = d;
      along = arc + sl * (1. - t);
      off = ((x - px) * (0. - sz) + (z - pz) * sx) / sl;
    }
    arc = arc + sl;
    k = k - 1usize;
  }
  new Vec2(along, off);
}

// The path lanterns: six pairs, the two of a pair within 0.3 m of one distance along the path and on
// opposite sides of it, each just beyond the path's edge (1.0 to 1.8 m off its centre), the first pair
// 1.5 to 2.2 m back from the steps' foot and the last 14 to 17 m, the pairs 2.4 to 3.2 m apart, and
// nothing laid out (edging stones included) within 0.7 m of any of the twelve
fn checkLanterns(items &List[Item]) bool {
  print <- "The path lanterns:\n";
  imm spots = lanternSpots();
  imm line = pathCentreline();
  mut ok = expect("twelve lanterns, six pairs", spots.len() == LANTERN_COUNT and LANTERN_COUNT == 2usize * LANTERN_PAIRS);
  mut paired = true;
  mut oppositeSides = true;
  mut offsetsRight = true;
  mut spacedRight = true;
  mut worstSplit = 0.;
  mut lastAlong = 0.;
  mut p = 0usize;
  while p < LANTERN_PAIRS and spots.len() == LANTERN_COUNT {
    imm l = alongAndOff(&line, (*spots[2usize * p]).x, (*spots[2usize * p]).y);
    imm r = alongAndOff(&line, (*spots[2usize * p + 1usize]).x, (*spots[2usize * p + 1usize]).y);
    imm split = vegAbs(l.x - r.x);
    if split > worstSplit { worstSplit = split; }
    if split > 0.3 { paired = false; }
    if !(l.y > 0. and r.y < 0.) { oppositeSides = false; }
    if vegAbs(l.y) < 1.0 or vegAbs(l.y) > 1.8 or vegAbs(r.y) < 1.0 or vegAbs(r.y) > 1.8 { offsetsRight = false; }
    if p == 0usize and (l.x < 1.5 or l.x > 2.2) { spacedRight = false; }
    if p > 0usize and (l.x - lastAlong < 2.4 or l.x - lastAlong > 3.2) { spacedRight = false; }
    if p == LANTERN_PAIRS - 1usize and (l.x < 14. or l.x > 17.) { spacedRight = false; }
    print <- "    pair "; print <- p; print <- ": "; print <- l.x; print <- " m back from the steps, "; print <- l.y; print <- " and ";
    print <- r.y; print <- " m off the centre (the two "; print <- split; print <- " m apart along it)\n";
    print <- "      left at ("; print <- (*spots[2usize * p]).x; print <- ", "; print <- (*spots[2usize * p]).y; print <- "), right at (";
    print <- (*spots[2usize * p + 1usize]).x; print <- ", "; print <- (*spots[2usize * p + 1usize]).y; print <- ")\n";
    lastAlong = l.x;
    p = p + 1usize;
  }
  ok = expect("the two of each pair within 0.3 m of the same distance along the path", paired) and ok;
  ok = expect("on opposite sides of it", oppositeSides) and ok;
  ok = expect("each 1.0 to 1.8 m off the centre, just beyond the edge", offsetsRight) and ok;
  ok = expect("the first pair 1.5 to 2.2 m back, the pairs 2.4 to 3.2 m apart, the last 14 to 17 m out", spacedRight) and ok;
  mut crowded = 0usize;
  mut i = 0usize;
  while i < items.len() {
    mut j = 0usize;
    while j < spots.len() {
      imm dx = items[i].x - (*spots[j]).x;
      imm dz = items[i].z - (*spots[j]).y;
      if dx * dx + dz * dz < 0.49 { crowded = crowded + 1usize; }
      j = j + 1usize;
    }
    i = i + 1usize;
  }
  ok = expect("nothing laid out within 0.7 m of a lantern", crowded == 0usize) and ok;
  ok;
}

// The assembly's places (bakedworld's table) against the layout: nothing laid out stands in an
// object's reach (the amphora, the horn-flower, the ball, the launch button, the balloon and the
// lawn route round the cottage's east end to the button), the nearest tree is well off the
// balloon, and the moved objects stand where the plan says
fn checkAssemblyLayout(items &List[Item]) bool {
  print <- "The assembly's places:\n";
  imm spots = worldObjects();
  mut inReach = 0usize;
  mut i = 0usize;
  while i < items.len() {
    imm it = items[i];
    mut s = 0usize;
    while s < spots.len() {
      imm o = *spots[s];
      imm dx = it.x - o.x;
      imm dz = it.z - o.z;
      // (an edging stone is let touch: it hugs the path, which the lawn route's first point is near)
      if it.kind != K_EDGING and dx * dx + dz * dz < o.y * o.y { inReach = inReach + 1usize; }
      s = s + 1usize;
    }
    i = i + 1usize;
  }
  mut ok = expect("nothing laid out stands within an object's reach or on the lawn route", inReach == 0usize);
  mut nearest f32 = 1000.;
  imm at = placeXZ(BALLOON);
  i = 0usize;
  while i < items.len() {
    imm it = items[i];
    if vegIsTree(it.kind) {
      imm dx = it.x - at.x;
      imm dz = it.z - at.y;
      imm d = (dx * dx + dz * dz).sqrt();
      if d < nearest { nearest = d; }
    }
    i = i + 1usize;
  }
  print <- "    (the nearest tree's trunk is "; print <- nearest; print <- " m from the balloon's axis)\n";
  ok = expect("no tree within 10 m of the balloon, so it rises clear", nearest >= 10.) and ok;
  imm button = placeXZ(LAUNCH_BUTTON);
  imm gap = (button.x - at.x) * (button.x - at.x) + (button.y - at.y) * (button.y - at.y);
  ok = expect("the boarding spot (where the launch button stood) 9 to 11 m short of the balloon, on the cottage's side",
    gap > 81. and gap < 121. and button.y > at.y) and ok;
  imm ball = placeXZ(BALL);
  ok = expect("the ball on the lawn east of the path, 10 to 12 m in front of the porch",
    ball.x > -14. and ball.y - 331.7 > 10. and ball.y - 331.7 < 12.) and ok;
  // The route's own points inside the fence and off the cottage
  mut routeOk = true;
  i = 0usize;
  while i < LAWN_ROUTE_N {
    imm p = lawnRouteAt(i);
    if !insideIslandFence(p.x, p.y) or nearCottage(p.x, p.y, 0.3, 1.5) { routeOk = false; }
    i = i + 1usize;
  }
  ok = expect("the lawn route inside the fence and 1.5 m off the cottage", routeOk) and ok;
  ok;
}
