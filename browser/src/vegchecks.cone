// The vegetation's headless checks (part of 'browser.exe --checks'): the
// layout's rules, read off its items on the baked island, with no mesh, scene
// or GPU.
//
//   no tree within 4.4 m of the path's centre, none (trunk and a margin) in the cottage
//   every tree and plant stands on the ground: its base within 5 cm of the island's height there
//   everything inside the fence, on land above the sea
//   no edging stone more than 1.3 m from the path's centre, none in the cottage
//   no two trees closer than 3 m
//   the layout rebuilt from its seed is the same list, item for item
//   the counts: trees, rocks and plants within their caps, and some of every kind

fn vegAbs(x f32) f32 { if x < 0. { 0. - x; } else { x; }; }

fn vegIsTree(k u32) bool { k == K_PINE or k == K_MAPLE or k == K_SPECIMEN; }

fn checkVegetation() bool {
  print <- "The vegetation's layout:\n";
  bakeIsland();
  imm items = vegetationLayout();
  mut counts Array[usize, 8] = [0usize, 0usize, 0usize, 0usize, 0usize, 0usize, 0usize, 0usize];
  mut treeOnPath = 0usize;
  mut treeInCottage = 0usize;
  mut notOnGround = 0usize;
  mut outside = 0usize;
  mut edgingFar = 0usize;
  mut edgingInCottage = 0usize;
  mut tooClose = 0usize;
  mut worstGround f32 = 0.;
  mut nearestTreeToPath f32 = 1000.;
  mut i = 0usize;
  while i < items.len() {
    imm it = items[i];
    counts[usize.from(it.kind)] = counts[usize.from(it.kind)] + 1usize;
    imm gh = groundHeight(it.x, it.z);
    if vegAbs(it.y - gh) > worstGround { worstGround = vegAbs(it.y - gh); }
    if vegAbs(it.y - gh) > 0.05 { notOnGround = notOnGround + 1usize; }
    if !insideIslandFence(it.x, it.z) or gh <= 0.1 { outside = outside + 1usize; }
    if vegIsTree(it.kind) {
      imm pd = pathDistanceAt(it.x, it.z);
      if pd < nearestTreeToPath { nearestTreeToPath = pd; }
      if pd < 4.4 { treeOnPath = treeOnPath + 1usize; }
      if nearCottage(it.x, it.z, 0.4, 0.5) { treeInCottage = treeInCottage + 1usize; }
      mut j = i + 1usize;
      while j < items.len() {
        imm o = items[j];
        if vegIsTree(o.kind) {
          imm dx = it.x - o.x;
          imm dz = it.z - o.z;
          if dx * dx + dz * dz < 9. { tooClose = tooClose + 1usize; }
        }
        j = j + 1usize;
      }
    }
    if it.kind == K_EDGING {
      if pathDistanceAt(it.x, it.z) > 1.3 { edgingFar = edgingFar + 1usize; }
      if nearCottage(it.x, it.z, 0.1, 0.) { edgingInCottage = edgingInCottage + 1usize; }
    }
    i = i + 1usize;
  }
  print <- "  items: "; print <- items.len(); print <- " (specimens "; print <- counts[0usize]; print <- ", pines "; print <- counts[1usize];
  print <- ", forest maples "; print <- counts[2usize]; print <- ", rocks "; print <- counts[3usize]; print <- ", edging stones ";
  print <- counts[4usize]; print <- ", hostas "; print <- counts[5usize]; print <- ", ferns "; print <- counts[6usize]; print <- ", flowers ";
  print <- counts[7usize]; print <- ")\n";
  mut ok = expect("no tree within 4.4 m of the path's centre", treeOnPath == 0usize);
  print <- "    (the nearest is "; print <- nearestTreeToPath; print <- " m)\n";
  ok = expect("no tree's trunk in the cottage", treeInCottage == 0usize) and ok;
  ok = expect("every tree and plant stands on the ground (base within 5 cm of its height)", notOnGround == 0usize) and ok;
  print <- "    (the worst is "; print <- worstGround; print <- " m)\n";
  ok = expect("everything inside the fence, on land", outside == 0usize) and ok;
  ok = expect("no edging stone more than 1.3 m from the path's centre", edgingFar == 0usize) and ok;
  ok = expect("none in the cottage", edgingInCottage == 0usize) and ok;
  ok = expect("no two trees closer than 3 m", tooClose == 0usize) and ok;
  ok = expect("trees stay within their cap (the anchors extra)", counts[1usize] + counts[2usize] <= MAX_TREES + 8usize) and ok;
  ok = expect("two specimen maples", counts[0usize] == 2usize) and ok;
  ok = expect("some of every other kind", counts[1usize] > 10usize and counts[2usize] > 3usize and counts[3usize] > 20usize
    and counts[4usize] > 50usize and counts[5usize] > 5usize and counts[6usize] > 20usize and counts[7usize] > 10usize) and ok;
  // the same from the seed again
  imm again = vegetationLayoutAgain();
  mut same = again.len() == items.len();
  i = 0usize;
  while same and i < items.len() {
    imm a = items[i];
    imm b = again[i];
    if a.kind != b.kind or a.variant != b.variant or a.x != b.x or a.z != b.z or a.yaw != b.yaw or a.scale != b.scale { same = false; }
    i = i + 1usize;
  }
  ok = expect("the layout rebuilt from its seed is the same list, item for item", same) and ok;
  ok = checkAssemblyLayout(&items) and ok;
  ok;
}

// The assembly's places (bakedworld's table) against the layout: nothing laid out stands in an
// object's reach (the amphora, the horn-flower, the ball, the launch button, the balloon and the
// lawn route round the cottage's east end to the button), the nearest tree is well off the
// balloon, and the moved objects stand where the plan says
fn checkAssemblyLayout(items &List[Item]) bool {
  print <- "The assembly's places:\n";
  imm spots = worldObjects();
  mut inReach = 0usize;
  mut i = 0usize;
  while i < items.len() {
    imm it = items[i];
    mut s = 0usize;
    while s < spots.len() {
      imm o = *spots[s];
      imm dx = it.x - o.x;
      imm dz = it.z - o.z;
      // (an edging stone is let touch: it hugs the path, which the lawn route's first point is near)
      if it.kind != K_EDGING and dx * dx + dz * dz < o.y * o.y { inReach = inReach + 1usize; }
      s = s + 1usize;
    }
    i = i + 1usize;
  }
  mut ok = expect("nothing laid out stands within an object's reach or on the lawn route", inReach == 0usize);
  mut nearest f32 = 1000.;
  imm at = placeXZ(BALLOON);
  i = 0usize;
  while i < items.len() {
    imm it = items[i];
    if vegIsTree(it.kind) {
      imm dx = it.x - at.x;
      imm dz = it.z - at.y;
      imm d = (dx * dx + dz * dz).sqrt();
      if d < nearest { nearest = d; }
    }
    i = i + 1usize;
  }
  print <- "    (the nearest tree's trunk is "; print <- nearest; print <- " m from the balloon's axis)\n";
  ok = expect("no tree within 10 m of the balloon, so it rises clear", nearest >= 10.) and ok;
  imm button = placeXZ(LAUNCH_BUTTON);
  imm gap = (button.x - at.x) * (button.x - at.x) + (button.y - at.y) * (button.y - at.y);
  ok = expect("the launch button 9 to 11 m short of the balloon, on the cottage's side", gap > 81. and gap < 121. and button.y > at.y) and ok;
  imm ball = placeXZ(BALL);
  ok = expect("the ball on the lawn east of the path, 10 to 12 m in front of the porch",
    ball.x > -14. and ball.y - 331.7 > 10. and ball.y - 331.7 < 12.) and ok;
  // The route's own points inside the fence and off the cottage
  mut routeOk = true;
  i = 0usize;
  while i < LAWN_ROUTE_N {
    imm p = lawnRouteAt(i);
    if !insideIslandFence(p.x, p.y) or nearCottage(p.x, p.y, 0.3, 1.5) { routeOk = false; }
    i = i + 1usize;
  }
  ok = expect("the lawn route inside the fence and 1.5 m off the cottage", routeOk) and ok;
  ok;
}
