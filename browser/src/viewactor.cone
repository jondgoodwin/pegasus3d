// The view actor: what each browser shows and picks from, run on the actors
// package's workers. It owns the view's scene (parts/viewscene.cone: which
// parts are live, the placement tree for drawing and the platforms), the
// picking system (picking.cone), the snapshot for render, the render actor it
// draws with, and a body for each being it draws: the one it drives, which it
// PREDICTS, and the others, which it INTERPOLATES. It holds no timer, no area
// and no world: the truth is the simulation's (simactor.cone), and this half
// takes what the simulation sends, over its connection (netlink.cone; what
// crosses is in simview.cone, as bytes in netcodec.cone), and builds from the
// content it holds itself what the simulation names (Request.Object).
//
// THE BEING THE USER DRIVES is stepped here at once, by the same code the
// simulation runs (Being.step: the gait, support.cone's collision and
// platforms) from the intents of each fixed step, so the user's own mannequin
// answers a key in the frame it is pressed whatever the connection's delay.
// The intents go to the simulation numbered, the last INPUT_KEPT of them in
// each packet. When a snapshot arrives with the last input sequence number the
// simulation has applied, this half compares the body it predicted after that
// input with the simulation's: if they agree (they do, unless the world
// differs from what was predicted) nothing happens; if not, its own body is
// set to the simulation's and the inputs not yet applied are played again, and
// the difference is blended away over CORRECTION_SECONDS (a large one at once).
// The camera (the view rig of being.cone) follows this body, here.
//
// THE OTHER BEINGS are drawn DELAY_TICKS (100 ms) in the past, between two
// snapshots, so that a snapshot lost or late does not show; the gait is
// animated here from the interpolated speed and heading (Figure.poseFrom). In
// single player, where nothing is late, the delay is none and a being is drawn
// at the snapshot's state.
//
// THE CLOCK. The simulation's tick is estimated from each snapshot and the
// round-trip time (netmsg's), smoothed; the others are drawn at that tick less
// the delay. Scene time (the day, the lanterns, the ride) is the snapshot's,
// carried on by the estimate.
//
// ITS FRAME is one message from the shell, which it answers when the frame is
// presented. In single player (LOCKSTEP) the halves take turns, so that a frame
// is the same every time:
//
//   frame(input)  the frame's controls and the intents of each step: the user's
//                 body predicted, the camera and the birds stepped; the messages
//                 sent, the last of them a Frame that asks the simulation to take
//                 the steps; the frame ends (complete) when the simulation's
//                 FrameDone, said after all else it had to say, arrives; the
//                 requests applied in the order sent (the placement
//                 tree, the picking system, and render's kept in order), the
//                 snapshot of the beings compared with the prediction, the others
//                 posed, the world matrices and THE SNAPSHOT published; the frame
//                 DRAWN, awaited: the snapshot and render's requests moved to the
//                 render actor, the snapshot moved back once presented; what the
//                 view saw told to the simulation (endFrame, awaited), which
//                 answers with what the shell reports; the shell told
//
// Connected (--connect) the simulation is another process: what has arrived is
// applied first, then the steps are predicted, and nothing is awaited.
//
// GOING ONLINE (goOnline, the panel's Join): single player becomes connected without a restart. The server is dialled while
// single player runs on; its first words are kept in a second ViewState (`online`); when the server has taken this client in
// (Possessed) the switch is made at the start of the next frame, where nothing is in flight: render forgets the old world
// (RenderActor.reset), the in-process simulation stops (SimActor.stop), `online` replaces `st`, and the frame is a connected one.
// A dial that fails leaves single player as it was.
//
//   finish()      the end of the run: the simulation's and the world's lines,
//                 render's, the script's verdict, and the run's exit code to
//                 the shell

// What the shell hands the view each frame: its steps, the user's intents
// and the keys and click of the frame, and the window's sizes
pub struct FrameInput {
  pub frame u64;
  pub steps List[Step];       // the fixed steps due this frame, in order
  pub intents Intents;        // the user's controller's, for the possessed being
  pub lookKeys f32;           // PageUp 1 to PageDown -1: the view looks up or down
  pub lookDrag f32;           // the view's pitch change this frame from the right-button drag, radians
  pub pause bool;             // pressed this frame: P (pause), F (x10), V (first or third person), Tab (the next being)
  pub fast bool;
  pub weather bool;           // and T (the next weather)
  pub view bool;
  pub swap bool;
  pub click bool;             // the left button pressed, at 'pointer'
  pub pointer Vec2;
  pub viewSize Vec2;          // the window in its own units (the pointer's)
  pub alpha f32;              // the picture this far from the step before the last to the last
  pub resized bool;           // the window changed size: 'width' by 'height' pixels
  pub width u32;
  pub height u32;
  pub hudHide bool;           // H pressed: the HUD (hud.cone) is hidden or shown
  pub hudSlots u32;           // bit n: F(n+1) pressed, the hotbar's slot n
  pub panelEvents List[PanelEvent]; // the "Play with others" panel's keys, text and mouse (requestpanel.cone), taken from the walk's
  pub panelHint bool;         // the HUD says which key opens that panel

  // No frame yet
  pub fn none() FrameInput {
    new FrameInput(0u64, List[Step].empty(), Intents.none(), 0., 0., false, false, false, false, false, false, new Vec2(0., 0.),
      new Vec2(HEADLESS_W, HEADLESS_H), 0., false, 0u32, 0u32, false, 0u32, List[PanelEvent].empty(), false);
  }
}

// What the view tells the shell once a frame is presented
pub struct FrameReport {
  pub simulateNs u64;         // the phases, as each actor timed its own
  pub publishNs u64;
  pub renderNs u64;
  pub presentNs u64;
  pub swapNs u64;             // the present phase's swapchain present and acquire
  pub acquireNs u64;
  pub status u32;             // the image acquired's status
  pub you Walk;               // the possessed being's body
  pub waiting usize;          // requests waiting after the apply point
  pub parts usize;            // parts the scene has
  pub rows usize;             // rows render draws, and particle emitters
  pub emitters usize;
  pub worldDone bool;         // every object of the world sent
  pub worldSentFrame u64;     // the frame that sent its last; 0 before
  pub refused bool;           // the server would not have this client (its name): the run is over
  pub join String;            // the panel's Join was pressed this frame: the name to play under (else empty)
  pub panel u32 = 0u32;       // render's word on the "Play with others" panel (requestpanel.cone: PANEL_OPEN, PANEL_TEXT)
  pub online bool = false;    // the view is connected to a server (from the start, or since a Join)
  pub dialing bool = false;   // a Join is dialling: the frame's steps are single player's still

  // Nothing yet: what the shell holds until a report comes
  pub fn none() FrameReport {
    new FrameReport(0u64, 0u64, 0u64, 0u64, 0u64, 0u64, 0u, Walk.make(new Vec3(0., 0., 0.), 0.), 0usize, 0usize, 0usize,
      0usize, false, 0u64, false, String.empty());
  }
}

// A player's name and the being it is above (a server's clients: BeingAdded says so)
pub struct NameTag {
  being u32;
  name String;
}

// No being is known to be the user's
const NO_BEING = 0xFFFFFFFFu32;
// The others are drawn this many fixed steps (1/60 s) in the past when connected
const DELAY_TICKS f64 = 6.;
const TICKS_PER_SECOND f64 = 60.;
// A prediction that differs from the simulation's by more than this (metres) is corrected
const FIX_ERROR f32 = 0.002;
// A correction up to this (metres) is blended away, over this long; a larger one is made at once
const SNAP_ERROR f32 = 2.;
const CORRECTION_SECONDS f32 = 0.1;
// The most steps of predicted state kept to compare, play again, or wait for
const HISTORY_MAX = 600usize;

// The most GPU upload (bytes, estimated: uploadCost) the requests of one frame may ask of render. A frame's uploads share one
// staging block that grows by doubling from 64 KB and gives up on its 9th (about 16 MB), so a late joiner, told the whole
// world in a frame or two, would fail there; the rest waits for the frames after (held), in order.
const UPLOAD_BUDGET = 4194304u64;
// A Join that has had no answer from the server after this long (ns) is given up
const DIAL_LIMIT_NS u64 = 12000000000u64;

// One of the user's steps: the input, and the body predicted after it
struct Predicted {
  seq u64;
  intents Intents;
  look f32;
  dt f32;
  stepped bool;               // the body was stepped by it here (not, before the first snapshot)
  position Vec3;
  yaw f32;
  grounded bool;
  rig ViewRig;                // the camera before the step, so that a step played again moves it as the first did
}

// A snapshot's state of a being, at the simulation's tick
struct Sample {
  tick u64;
  state BeingState;
}

// What the view keeps of a being besides its body in the cast
struct Puppet {
  samples List[Sample];       // the last snapshots of it, oldest first
  landings u32;               // landings (mod 256) of it already taken into its gait
  respawns u32;
  started bool;               // single player: its body has been set from its first snapshot
  placed bool;                // its part has been placed
  placedAt Vec3;              // and where
  placedYaw f32;
}

// The view actor's state
pub struct ViewState {
  pub scene ViewScene;
  pub picks PickSystem;       // what each shown part is, for picking
  pub picked PartId;          // the part highlighted: the last click's
  pub lastPick PickHit;       // the last click's answer
  pub clicks u64;
  pub view Vec2;              // the window in its own units, as the shell last said
  pub net NetSide;            // the connection
  pub cast Cast;              // the beings drawn, and the camera that follows the one driven
  puppets List[Puppet];       // one for each being of the cast
  pub own usize;              // the being this client drives (NO_ROW: not known yet)
  ownWanted u32;              // told to drive, before the being exists
  ownReady bool;              // its body has been set to the simulation's
  forceSnap bool;             // the next snapshot of it is taken whole
  pub birds Birds;            // this browser's flock
  history List[Predicted];
  corr Vec3;                  // a correction being blended away: how far the body drawn is from the body
  pub late u64;               // frames whose state did not arrive with the simulation's answer
  lateNow bool;               // this frame's did not
  snapshot Snapshot;          // the last published, handed back by render once drawn
  forRender List[Request];    // render's share of this frame's requests, in order
  seq u64;                    // the last input sequence number given
  recent List[InputSample];   // the last INPUT_KEPT ticks of intents
  testFixed bool;             // a scripted run's, from the simulation
  testView Pose;
  testFov f32;
  testShot String;
  shared List[MaterialId];    // the materials the world shares across its objects, by key, as built here
  lockstep bool;              // single player: the halves take turns
  joined bool;                // the connection is open
  closed bool;                // and it has ended
  inbox List[ToView];         // reliable messages received, not yet applied
  states List[WorldState];    // snapshots received, not yet taken (oldest first)
  testIn List[TestView];      // scripted runs' own, received
  reliableGot u64;
  lastState WorldState;       // the newest snapshot taken
  hasState bool;
  weather Weathering;
  moves List[PlatformMove];
  platformsNow List[PlatformNow];
  stepSeconds f32;            // the frame's steps, seconds
  given List[Intents];        // scratch for Cast.stepEach
  stepIt List[bool];
  localTick u64;              // fixed steps taken here
  tickOffset f64;             // the simulation's tick less ours, estimated
  synced bool;
  pub rttMs i64;
  rate u32;                   // the scene clock's rate, as the last snapshot said
  pub sceneNow f64;           // scene time, as estimated
  pub snapshots u64;          // snapshots taken
  pub corrections u64;        // predictions found wrong and corrected
  pub worstError f32;         // the largest difference found (metres), set-downs not counted
  pub setDowned u64;          // times the simulation set the user's body down (a respawn, a script's hook): not a misprediction, so not a correction
  pub worstSetDown f32;       // the farthest of them (metres)
  pub stale u64;              // snapshots that arrived out of order and were dropped
  ownEver bool;               // the user's body has been set to the simulation's at least once
  pub worldBuilt u32;         // objects of the world built here
  pub bytesIn u64;            // bytes received, as the connection counts them
  pub bytesOut u64;
  frameTick u64;              // the tick the simulation said its last frame ended at (single player)
  pub resyncs u64;            // times the user's body was set to the simulation's with no prediction to compare (the first snapshots)
  rttMinMs i64;               // the least round trip lately: the one with the least waiting in it
  gapMax f64;                 // the longest gap between snapshots lately, in ticks (decaying)
  joinedNow bool;             // the connection opened since the actor last said so
  leftNow bool;               // or ended
  frameDone bool;             // single player: the simulation said its frame was done
  pub simulateNs u64;         // and how long it took
  pub publishNs u64;
  pub play PlayView;          // the playground's: the props, the spells' paint and the lock-on (playview.cone)
  pub hud HudView;            // the HUD's: shown or hidden, and the frame time (hud.cone)
  pub audio AudioView;        // the sound: made by the shell (audioOpen), touched only from this actor's turns
  playerName String;          // the name this client plays under (--name), sent to a server in its Hello
  refusedWhy String;          // the server's reason, if it would not have this client
  refusedNow bool;            // it was refused: the run ends
  tags List[NameTag];         // the names shown above the mannequins of the players
  pub land Island;  // the baked island, shared by every actor (read it with &land)
  pub opts RunOptions;        // what the arguments say that this actor acts on (--script, --trace)
  pub joinFailed String;      // a Join that did not get in: why, said once in the next HudFrame
  held List[Request];         // render's requests held back from earlier frames by UPLOAD_BUDGET, oldest first, sent before forRender's
  heldTotal u64;              // bytes of upload (estimated) the held back have cost render so far this backlog
  heldFrames u32;             // and the frames it has taken
  heldStartedAt u64;          // when it began (the performance counter)
  pub possessedSeen bool = false;   // a server's Possessed has arrived: it has taken this client in (goOnline waits for it)
  pub shotFrame u64 = 0u64;   // the test hook's (--switch-at): the frame the "switch-after" view is saved at

  pub fn make(birds Birds, lockstep bool, audio AudioView, playerName String, land Island, opts RunOptions) ViewState {
    imm still = Pose.look(new Vec3(0., 0., 0.), 0., 0.);
    new ViewState(ViewScene.empty(), PickSystem.empty(), PartId.none(), new PickHit(PartId.none(), 0., 0u32, 0u64),
      0u64, new Vec2(HEADLESS_W, HEADLESS_H), NetSide.make(), Cast.client(land.share()), List[Puppet].empty(), NO_ROW, NO_BEING, false,
      false, birds, List[Predicted].empty(), new Vec3(0., 0., 0.), 0u64, false, Snapshot.empty(), List[Request].empty(), 0u64,
      List[InputSample].empty(), false, still, FOV, String.empty(), List[MaterialId].empty(), lockstep, false, false,
      List[ToView].empty(), List[WorldState].empty(), List[TestView].empty(), 0u64,
      new WorldState(0u64, 0d, 1u32, 0u64, List[BeingState].empty(), List[PropState].empty(), List[FxState].empty()), false, Weathering.fair(), List[PlatformMove].empty(), List[PlatformNow].empty(), 0.,
      List[Intents].empty(), List[bool].empty(), 0u64, 0d, false, 0i64, 1u32, 0d, 0u64, 0u64, 0., 0u64, 0., 0u64, false, 0u32, 0u64, 0u64, 0u64, 0u64, 0i64, 2d, false, false, false, 0u64, 0u64,
      PlayView.make(), HudView.make(hudStartsShown(opts.scripted)), audio, playerName, String.empty(), false, List[NameTag].empty(),
      land, opts, String.empty(), List[Request].empty(), 0u64, 0u32, 0u64);
  }

  // Reliable messages sent to the simulation, ever
  pub fn reliableSentCount(self &) u64 {
    if net.has(1u32) { net.peer(1u32).reliableSent; } else { 0u64; };
  }

  // ---- the connection ----

  // One event from the connection
  fn onEvent(self &mut, event NetEvent) {
    mut ev = event;
    match ev {
      case imm j Joined {
        net.open(j.id, j.conn);
        joined = true;
        joinedNow = true;
        // Connected: the server's first word from us is the name we play under
        if !lockstep { net.sendReliable(j.id, encodeToSim(ToSim.Hello(self.playerName.copy()))); }
      }
      case imm l Left {
        net.close(l.id);
        closed = true;
        leftNow = true;
        print <- "The connection ended\n";
      }
      case mut m Message {
        mut data = List[u8].empty();
        data <=> m.data;
        reliableGot = reliableGot + 1u64;
        mut msg = decodeToView(data);
        match &mut msg {
          case mut fd &mut FrameDone {
            frameDone = true;
            frameTick = fd.tick;
            simulateNs = fd.simulateNs;
            publishNs = fd.publishNs;
          }
          case mut rf &mut Refused {
            refusedWhy = rf.reason.copy();
            refusedNow = true;
            print <- "REFUSED by the server: "; printStr(rf.reason.view()); print <- "\n";
          }
          case mut pb &mut Possessed {
            possessedSeen = true;
            inbox.push(ToView.Possessed(pb.being));
          }
          else { inbox.push(msg); }
        }
      }
      case mut u Update {
        mut data = List[u8].empty();
        data <=> u.data;
        if u32.from(u.stream) == STREAM_STATE {
          mut w = new WorldState(0u64, 0d, 1u32, 0u64, List[BeingState].empty(), List[PropState].empty(), List[FxState].empty());
          if decodeState(data, &mut w) { states.push(w); }
        } elif u32.from(u.stream) == STREAM_TEST {
          mut t = new TestView(false, Pose.look(new Vec3(0., 0., 0.), 0., 0.), FOV, String.empty());
          if decodeTest(data, &mut t) { testIn.push(t); }
        }
      }
      case imm r Refused {
        print <- "A send was refused: "; print <- r.size; print <- " bytes against "; print <- r.limit; print <- "\n";
      }
    }
  }

  // ---- before the simulation's turn ----

  // The frame's controls, a click picked, the steps predicted and the intents of each step sent
  fn beforeSim(self &mut, input &FrameInput) {
    view = input.viewSize;
    stepSeconds = 0.;
    // The camera's pitch, from the drag: here at once, and told to the simulation's mirror of it
    if input.lookDrag != 0. {
      cast.rig.tilt(input.lookDrag);
      if lockstep { net.sendReliable(1u32, encodeToSim(ToSim.Look(input.lookDrag))); }
    }
    if input.pause { net.sendReliable(1u32, encodeToSim(ToSim.Command(COMMAND_PAUSE))); }
    if input.fast { net.sendReliable(1u32, encodeToSim(ToSim.Command(COMMAND_FAST))); }
    if input.weather { net.sendReliable(1u32, encodeToSim(ToSim.Command(COMMAND_WEATHER))); }
    if input.swap and lockstep { net.sendReliable(1u32, encodeToSim(ToSim.Command(COMMAND_SWAP))); }
    if input.click { self.click(input.pointer); }
    // The playground's keys (B, F1 to F3): turned into actions for the simulation, and the lock-on kept
    if input.hudSlots != 0u32 or play.lock.isLocked() {
      imm acts = playInput(&mut play, input.hudSlots, &cast, own, &snapshot, &scene, f32.from(input.steps.len()) / 60., &mut forRender);
      mut a = 0usize;
      while a < acts.len() {
        net.sendReliable(1u32, copyBytes(acts[a]));
        a = a + 1usize;
      }
    }
    if opts.autoWalk and joined and ownReady {
      imm autos = playAuto(&mut play, localTick, &cast, own);
      mut au = 0usize;
      while au < autos.len() { net.sendReliable(1u32, copyBytes(autos[au])); au = au + 1usize; }
    }
    // The steps: one input a step, numbered; the user's body and the camera follow it at once, and the birds fly on
    mut i = 0usize;
    while i < input.steps.len() {
      imm step = *input.steps[i];
      if joined {
        seq = seq + 1u64;
        imm sample = new InputSample(seq, input.intents, input.lookKeys);
        recent.push(sample);
        self.stepOwn(sample, step);
      }
      birds.step(&land, step.dt * f32.from(rate));
      stepSeconds = stepSeconds + step.dt;
      localTick = localTick + 1u64;
      i = i + 1usize;
    }
    // V: first or third person, after the steps (as the simulation's mirror does)
    if input.view {
      cast.rig.toggle();
      if lockstep { net.sendReliable(1u32, encodeToSim(ToSim.Command(COMMAND_VIEW))); }
    }
    // Those the simulation has not yet said it applied are kept (at least the last INPUT_KEPT, at most INPUT_MOST)
    while recent.len() > INPUT_MOST or (recent.len() > INPUT_KEPT and recent[0usize].seq <= lastState.appliedInput) {
      mut keep = List[InputSample].empty();
      mut q = 1usize;
      while q < recent.len() { keep.push(*recent[q]); q = q + 1usize; }
      recent <=> keep;
    }
    // The last INPUT_KEPT, every frame (a lost packet loses nothing); single player sends one only when there is a step
    if joined and recent.len() > 0usize and (input.steps.len() > 0usize or !lockstep) {
      net.sendLatest(1u32, STREAM_INPUT, encodeInput(&recent));
    }
  }

  // One step of the user's body by 'sample': predicted, the camera and the history following it
  fn stepOwn(self &mut, sample InputSample, step Step) {
    mut done = false;
    mut pos = new Vec3(0., 0., 0.);
    mut yaw = 0.;
    mut grounded = true;
    imm rigBefore = cast.rig;
    if own != NO_ROW and ownReady {
      self.stepBody(sample.intents, sample.lookKeys, step.dt);
      self.blendCorrection(step.dt);
      imm body = cast.beings[own].body;
      pos = body.position;
      yaw = body.yaw;
      grounded = cast.beings[own].figure.grounded;
      done = true;
    }
    history.push(new Predicted(sample.seq, sample.intents, sample.lookKeys, step.dt, done, pos, yaw, grounded, rigBefore));
    if history.len() > HISTORY_MAX {
      mut keep = List[Predicted].empty();
      mut q = history.len() - HISTORY_MAX;
      while q < history.len() { keep.push(*history[q]); q = q + 1usize; }
      history <=> keep;
    }
  }

  // The user's body stepped by 'intents' (the camera tilted by the look keys first, and following it)
  fn stepBody(self &mut, intents Intents, lookKeys f32, dt f32) {
    while given.len() < cast.beings.len() { given.push(Intents.none()); stepIt.push(false); }
    mut b = 0usize;
    while b < cast.beings.len() { stepIt.set(b, false); b = b + 1usize; }
    given.set(own, intents);
    stepIt.set(own, true);
    cast.rig.tilt(lookKeys * LOOK_KEY_RATE * dt);
    cast.stepEach(&given, &stepIt, dt, true);
  }

  // The correction being blended away eased a step, and the camera moved with what is drawn
  fn blendCorrection(self &mut, dt f32) {
    if corr.x == 0. and corr.y == 0. and corr.z == 0. { return; }
    // The camera is drawn where the body is drawn
    imm r = &mut cast.rig;
    r.now = new Pose(r.now.origin + corr, r.now.orientation);
    imm k = libc.expf(0. - dt / CORRECTION_SECONDS);
    corr = new Vec3(corr.x * k, corr.y * k, corr.z * k);
    if corr.length() < 0.0005 { corr = new Vec3(0., 0., 0.); }
  }

  // A click at 'pointer': the part it hits picked, reported and highlighted
  // (the one before let go), and told to the simulation, which tells the
  // part's sender if it listens for its clicks. The eye is where the last
  // picture was drawn from: the snapshot render handed back.
  fn click(self &mut, pointer Vec2) {
    imm eye = snapshot.eyeTo;
    imm ray = rayThrough(eye, FOV, pointer.x, pointer.y, view.x, view.y);
    imm t0 = sdl.GetPerformanceCounter();
    imm hit = picks.pick(&scene, ray);
    imm us = f64.from(sdl.GetPerformanceCounter() - t0) / f64.from(sdl.GetPerformanceFrequency()) * 1.0e6d;
    clicks = clicks + 1u64;
    lastPick = hit;
    print <- "Click at ("; print <- pointer.x; print <- ", "; print <- pointer.y; print <- "): ";
    if hit.id.isNone() {
      print <- "nothing";
    } else {
      imm name = scene.nameOf(hit.id);
      printStr(name.view()); print <- ", "; print <- hit.distance; print <- " m away";
    }
    print <- " ("; print <- hit.boxesHit; print <- " boxes entered, "; print <- hit.triangles; print <- " triangles tested, ";
    print <- us; print <- " us)\n";
    if !picked.isNone() and !(picked == hit.id) { self.highlight(picked, false); }
    if !hit.id.isNone() {
      self.highlight(hit.id, true);
      net.sendReliable(1u32, encodeToSim(ToSim.Click(hit.id)));
    }
    picked = hit.id;
  }

  // Part 'id' drawn highlighted ('on') or as it is, if it is live
  fn highlight(self &mut, id PartId, on bool) {
    if scene.isLive(id) { forRender.push(Request.Highlight(id, on)); }
  }

  // ---- after the simulation's turn: what has arrived ----

  // What has arrived applied: the requests in the order sent, the weather, the beings' snapshots (the user's compared with
  // its prediction, the others kept to be drawn), the scripted run's own
  fn applyIncoming(self &mut) {
    lateNow = true;
    testFixed = false;
    testFov = FOV;
    mut moved = inbox.len() > 0usize;
    mut messages = List[ToView].empty();
    messages <=> inbox;
    imm ms = messages.viewMut();
    mut i = 0usize;
    while i < ms.len {
      mut m ToView = ToView.Nothing;
      m <=> ms[i];
      match &mut m {
        case mut q &mut Requests {
          mut batch = List[Request].empty();
          batch <=> q.batch;
          self.applyRequests(batch);
        }
        case mut p &mut Possessed { ownWanted = p.being; self.checkOwn(); }
        case mut w &mut Weather { weather = w.weather; }
        case mut bu &mut Burst {
          playBurst(&mut play, bu.kind, bu.being, bu.position, bu.normal, bu.color, bu.tick);
          // The zap's "ah!", at the being's chest
          if bu.kind == BURST_ZAP and usize.from(bu.being) < cast.beings.len() {
            imm zb = cast.beings[usize.from(bu.being)];
            audio.voiceAt(zb.body.position + new Vec3(0., 0.7 * zb.figure.height, 0.), if zb.figure.height < 1.7 { 200.; } else { 120.; });
          }
        }
        else {}
      }
      i = i + 1usize;
    }
    // The platforms as the requests left them, and the bodies on a platform that moved carried with it
    if moved or stepSeconds > 0. {
      scene.propagate();
      scene.platformMoves(&mut moves);
      carryRiders(&mut cast, &moves, stepSeconds);
      scene.platformsNow(&mut platformsNow);
      cast.phys.syncPlatforms(&platformsNow);
      // The body carried is where the last step left it, for comparing with the simulation's (which carries it too)
      if own != NO_ROW and ownReady and history.len() > 0usize and moves.len() > 0usize {
        imm li = history.len() - 1usize;
        imm lp = *history[li];
        if lp.stepped {
          history.set(li, new Predicted(lp.seq, lp.intents, lp.look, lp.dt, true, cast.beings[own].body.position,
            cast.beings[own].body.yaw, lp.grounded, lp.rig));
        }
      }
    }
    // The snapshots
    mut got = states.len() > 0usize;
    imm ss = states.viewMut();
    mut s = 0usize;
    while s < ss.len {
      mut w = new WorldState(0u64, 0d, 1u32, 0u64, List[BeingState].empty(), List[PropState].empty(), List[FxState].empty());
      w.tick = ss[s].tick;
      w.now = ss[s].now;
      w.rate = ss[s].rate;
      w.appliedInput = ss[s].appliedInput;
      w.beings <=> ss[s].beings;
      w.props <=> ss[s].props;
      w.fx <=> ss[s].fx;
      self.takeState(w);
      s = s + 1usize;
    }
    states.clear();
    if got or (lockstep and hasState and frameTick <= lastState.tick) { lateNow = false; }
    if lateNow and lockstep { late = late + 1u64; }
    // A scripted run's camera and file name
    imm ts = testIn.viewMut();
    mut t = 0usize;
    while t < ts.len {
      testFixed = ts[t].fixedView;
      testView = ts[t].view;
      testFov = ts[t].fov;
      testShot = ts[t].shot.copy();
      t = t + 1usize;
    }
    testIn.clear();
  }

  // A snapshot taken: each being's state kept to draw from, the user's body compared with the prediction, the clock
  // estimated
  fn takeState(self &mut, w WorldState) {
    if hasState and w.tick <= lastState.tick {
      stale = stale + 1u64;
      return;
    }
    snapshots = snapshots + 1u64;
    mut st = w;
    // The clock
    self.syncClock(st.tick);
    if opts.traceOn {
      if snapshots == 1u64 { print <- "QPCFREQ "; print <- sdl.GetPerformanceFrequency(); print <- "\n"; }
      print <- "TA "; print <- st.tick; print <- " "; print <- sdl.GetPerformanceCounter(); print <- " "; print <- rttMs; print <- " "; print <- localTick;
      print <- "\n";
    }
    rate = st.rate;
    mut k = 0usize;
    mut ownState = new BeingState(0u32, false, new Vec3(0., 0., 0.), 0., 0., 0., 0., 0., true, Intents.none(), PartId.none(), 1., 0u32,
      0u32, 0., FIG_WALK, 0., false, noRots());
    mut hasOwn = false;
    while k < st.beings.len() {
      imm b = *st.beings[k];
      imm idx = usize.from(b.being);
      if idx < cast.beings.len() {
        imm p = &mut puppets[idx];
        p.samples.push(new Sample(st.tick, b));
        while p.samples.len() > 8usize {
          mut keep = List[Sample].empty();
          mut q = 1usize;
          while q < p.samples.len() { keep.push(*p.samples[q]); q = q + 1usize; }
          p.samples <=> keep;
        }
        if idx == own { ownState = b; hasOwn = true; }
      }
      k = k + 1usize;
    }
    playTakeState(&mut play, st.tick, &mut st.props, &st.fx, &mut cast);
    lastState.tick = st.tick;
    lastState.now = st.now;
    lastState.rate = st.rate;
    lastState.appliedInput = st.appliedInput;
    hasState = true;
    if hasOwn { self.reconcile(ownState, st.appliedInput); }
  }

  // This machine's clock in the simulation's ticks (1/60 s): the clock the estimate of the simulation's is made against.
  // (Not the steps taken here: a frame that took long drops steps, and they would put the estimate out.)
  fn nowTick(self &) f64 { f64.from(sdl.GetTicksNS()) / 16666666.67d; }

  // The simulation's tick, estimated from a snapshot of tick 'tick' that has just arrived, and the round-trip time
  fn syncClock(self &mut, tick u64) {
    // The one way trip is half the round trip with the least waiting in it (the round trip includes the other end's wait to send)
    imm rtt = if rttMinMs > 0i64 { rttMinMs; } else { rttMs; };
    imm oneWay = f64.from(rtt) / 2000. * TICKS_PER_SECOND;
    if hasState {
      imm gap = f64.from(tick - lastState.tick);
      gapMax = if gap > gapMax * 0.99 { gap; } else { gapMax * 0.99; };
    }
    imm est = f64.from(tick) + oneWay - self.nowTick();
    imm off = est - tickOffset;
    if !synced or off > 12. or off < -12. {
      tickOffset = est;
      synced = true;
    } else {
      tickOffset = tickOffset + (est - tickOffset) * 0.05;
    }
  }

  // The user's body compared with the simulation's after the same input: if they differ, the body is set to the
  // simulation's, the inputs it has not yet applied are played again, and the difference blended away
  fn reconcile(self &mut, s BeingState, applied u64) {
    if own == NO_ROW or !s.exact { return; }
    // Limp, or getting up: the simulation's alone (it is not predicted); on its word that it stands again, the body is taken whole
    {
      imm ob = &mut cast.beings[own];
      if ob.figure.active and (s.mode != FIG_WALK or ob.figure.mode != FIG_WALK) {
        if followServer(&mut cast.phys, &mut ob.figure, &mut ob.body, &s) {
          ob.before = ob.body;
          ob.intents = s.intents;
          ob.figure.health = s.health;
          self.dropHistory(applied);
          corr = new Vec3(0., 0., 0.);
          ownReady = true;
          ownEver = true;
          forceSnap = true;
          return;
        }
        forceSnap = true;
      }
    }
    // The body we predicted after input 'applied'
    mut found = NO_ROW;
    mut h = 0usize;
    while h < history.len() {
      if history[h].seq == applied and history[h].stepped { found = h; }
      h = h + 1usize;
    }
    mut wrong = forceSnap or !ownReady;
    mut err = 0.;
    if !wrong and found != NO_ROW {
      imm hp = *history[found];
      imm dx = hp.position.x - s.position.x;
      imm dy = hp.position.y - s.position.y;
      imm dz = hp.position.z - s.position.z;
      err = libc.sqrtf(dx * dx + dy * dy + dz * dz);
      imm dyaw = libc.fabsf(wrapPi(hp.yaw - s.yaw));
      wrong = err > FIX_ERROR or dyaw > 0.001 or hp.grounded != s.grounded;
    } elif !wrong and applied > 0u64 {
      // Nothing to compare with (the input was before our history, or we did not step it)
      wrong = true;
    }
    // The simulation set the body down somewhere (setDown counts them, and the snapshot carries the count): the body is taken whole
    // there, which is the intended result and not a prediction found wrong, so it is counted apart from the corrections
    imm setDown = (cast.beings[own].figure.setDowns & 255u32) != s.respawns;
    if setDown and found != NO_ROW and ownReady { wrong = true; }
    if setDown { if err > worstSetDown { worstSetDown = err; } } elif err > worstError { worstError = err; }
    if opts.traceOn {
      print <- "TR "; print <- localTick; print <- " "; print <- applied; print <- " "; print <- i64.from(libc.floorf(err * 1000. + 0.5)); print <- " ";
      print <- i64.from(wrong); print <- "\n";
    }
    if !wrong {
      self.dropHistory(applied);
      return;
    }
    if setDown and ownEver { setDowned = setDowned + 1u64; }
    elif found == NO_ROW { resyncs = resyncs + 1u64; } else { corrections = corrections + 1u64; }
    imm drawn = cast.beings[own].body.position + corr;
    // The camera as it was before the step the simulation's state is the result of
    mut rigApplied = cast.rig;
    mut appliedLook = 0.;
    mut appliedDt = 0.;
    mut haveApplied = false;
    if found != NO_ROW and ownEver and !forceSnap {
      rigApplied = history[found].rig;
      appliedLook = history[found].look;
      appliedDt = history[found].dt;
      haveApplied = true;
    }
    self.dropHistory(applied);
    mut now = cast.beings[own].body.position;
    {
      imm b = &mut cast.beings[own];
      // The simulation's body, whole
      b.body.position = s.position;
      b.body.yaw = s.yaw;
      b.before = b.body;
      if b.figure.active {
        if (b.figure.setDowns & 255u32) != s.respawns {
          b.figure.setDown(&mut b.body, s.position, s.yaw);
          b.figure.setDowns = s.respawns;
        }
        b.figure.speed = s.speed;
        b.figure.vy = s.vy;
        b.figure.airVx = s.airVx;
        b.figure.airVz = s.airVz;
        b.figure.grounded = s.grounded;
        b.figure.on = s.platform;
        b.figure.health = s.health;
        b.figure.anchored = false;
      } else {
        b.figure.setDowns = s.respawns;
      }
      b.intents = s.intents;
    }
    // Its inputs not yet applied played again, and the camera with them, from where it stood before the first
    if haveApplied {
      // The camera followed the step as the simulation's body took it
      cast.rig = rigApplied;
      cast.rig.tilt(appliedLook * LOOK_KEY_RATE * appliedDt);
      cast.look(appliedDt);
    } elif history.len() > 0usize and ownEver and !forceSnap {
      imm saved = history[0usize].rig;
      cast.rig = saved;
    }
    mut i = 0usize;
    while i < history.len() {
      imm hp = *history[i];
      self.stepBody(hp.intents, hp.look, hp.dt);
      imm body = cast.beings[own].body;
      history.set(i, new Predicted(hp.seq, hp.intents, hp.look, hp.dt, true, body.position, body.yaw,
        cast.beings[own].figure.grounded, hp.rig));
      i = i + 1usize;
    }
    now = cast.beings[own].body.position;
    // What is drawn eases from where it was to where the body is now, unless that is far
    imm back = drawn - now;
    if forceSnap or !ownReady or back.length() > SNAP_ERROR {
      corr = new Vec3(0., 0., 0.);
    } else {
      corr = back;
      // The camera is where it was drawn, and eases to where it belongs with the body
      imm r = &mut cast.rig;
      r.before = new Pose(r.before.origin + corr, r.before.orientation);
      r.now = new Pose(r.now.origin + corr, r.now.orientation);
    }
    if !ownEver {
      // The first time: the camera put where the body is
      cast.rig.snap();
      cast.look(1. / 60.);
    }
    ownEver = true;
    forceSnap = false;
    ownReady = true;
  }

  // History up to input 'applied' let go
  fn dropHistory(self &mut, applied u64) {
    mut keep = List[Predicted].empty();
    mut q = 0usize;
    while q < history.len() {
      if history[q].seq > applied { keep.push(*history[q]); }
      q = q + 1usize;
    }
    history <=> keep;
  }

  // The being this client drives, once it is told which and the being exists
  fn checkOwn(self &mut) {
    if ownWanted == NO_BEING or usize.from(ownWanted) >= cast.beings.len() { return; }
    if own == usize.from(ownWanted) { return; }
    own = usize.from(ownWanted);
    cast.possess(own);
    ownReady = false;
    forceSnap = true;
    corr = new Vec3(0., 0., 0.);
  }

  // Apply every request the simulation sent, in the order sent: the
  // placement tree and live parts here, the picking system's here, and
  // render's moved on in the same order (forRender)
  fn applyRequests(self &mut, batch List[Request]) {
    mut b = batch;
    imm requests = b.viewMut();
    mut i = 0usize;
    while i < requests.len {
      mut r Request = Request.Done;
      r <=> requests[i];
      mut toRender = false;
      match &mut r {
        case mut s &mut Spawn {
          mut name = String.empty();
          name <=> s.name;
          scene.applySpawn(s.id, name);
        }
        case mut p &mut Place { scene.applyPlace(p.id, p.at); }
        case mut pa &mut Parent { scene.applyParent(pa.id, pa.parent); }
        case mut d &mut Despawn {
          // The part and its whole subtree: the scene's rows first, then
          // every other system's for each part that went (render's as a
          // Despawn of each, in order)
          mut gone = List[PartId].empty();
          if scene.applyDespawn(d.id, &mut gone) {
            mut k = 0usize;
            while k < gone.len() {
              imm id = *gone[k];
              picks.drop(id);
              forRender.push(Request.Despawn(id));
              mut bi = 0usize;
              while bi < cast.beings.len() {
                imm bb = &mut cast.beings[bi];
                if bb.part == id { bb.gone = true; }
                bi = bi + 1usize;
              }
              k = k + 1usize;
            }
          }
        }
        case mut ob &mut Object {
          // Content this browser holds: built here, with the ids the simulation reserved for it
          mut objectIds = List[PartId].empty();
          objectIds <=> ob.ids;
          self.buildObject(ob.spec.copy(), objectIds);
        }
        case mut ba &mut BeingAdded {
          if usize.from(ba.being) == cast.beings.len() {
            imm away = new Vec3(0., 0. - 5000., 0.);
            if ba.plain {
              cast.add(Being.make(ba.part, Walk.make(away, 0.)));
            } else {
              cast.add(Being.mannequin(ba.part, away, 0., Figure.make(ba.height, ba.seed, List[PartId].empty())));
            }
            puppets.push(new Puppet(List[Sample].empty(), 0u32, 0u32, false, false, away, 0.));
            if ba.name.len() > 0usize { tags.push(new NameTag(ba.being, ba.name.copy())); }
            self.checkOwn();
          }
        }
        case mut pl &mut Platform { scene.applyPlatform(pl.id, pl.shape); }
        case mut dm &mut DefineMesh {
          // The picking system keeps its shape; the render system uploads it
          picks.shape(dm.mesh, &dm.shape);
          toRender = true;
        }
        case mut ds &mut DefineSkinnedMesh {
          // Picked as modelled; drawn posed
          picks.shape(ds.mesh, &ds.shape);
          toRender = true;
        }
        case mut bn &mut Bones { toRender = true; }
        case mut dl &mut DefineMaterial { toRender = true; }
        case mut sh &mut Show {
          // The picking system keeps which mesh it is (not the ground's: an
          // anchored part is drawn wherever the viewer is)
          if sh.anchor == 0. { picks.show(sh.id, sh.mesh); }
          toRender = true;
        }
        case mut ef &mut Effect { audioNoteEffect(&mut audio, &scene, ef.id, ef.start, ef.stop); toRender = true; }
        case mut f &mut Fire { audioNoteEffect(&mut audio, &scene, f.id, f.start, f.stop); toRender = true; }
        case mut gl &mut Glow { toRender = true; }
        case mut tn &mut Tint { toRender = true; }
        case mut ls &mut LightSource { toRender = true; }
        case mut cs &mut CastsShadow { toRender = true; }
        case mut cu &mut Cull { toRender = true; }
        case mut k &mut Sky { toRender = true; }
        else {}
      }
      if toRender { forRender.push(r); }
      i = i + 1usize;
    }
  }

  // An object of the content this browser holds itself, built again from the Object request that named it: the
  // same code that made it in the simulation, its parts, meshes and materials given the ids the simulation
  // reserved for them. Its requests are applied here, in order, as any are.
  fn buildObject(self &mut, spec ObjectSpec, ids List[PartId]) {
    mut door = Door.empty();
    door.replayIds(ids);
    if spec.kind == OBJ_WORLD {
      worldBuilt = worldBuilt + 1u32;
      mut h = hydrate(&land, spec.index);
      mut partIds = List[PartId].empty();
      mut places = List[Transform3].empty();
      inject(&mut h, &mut door, &mut partIds, &mut places, &mut shared);
      playNoteObject(&mut play, spec.index, &partIds);
    } elif spec.kind == OBJ_SHELL {
      seedScene(&land, &mut door);
    } elif spec.kind == OBJ_MANNEQUIN {
      imm root = door.newPart(spec.name.view());
      spawnMannequin(&mut door, spec.height, spec.color, root);
    } elif spec.kind == OBJ_TESTCUBE {
      buildTestCube(&mut door);
    }
    door.endReplay();
    self.applyRequests(door.takeInbox());
  }

  // ---- the beings drawn ----

  // The tick the others are drawn at, for the step at 'local' ticks: the simulation's now, less the delay. In single
  // player, where nothing is late, the newest there is
  fn drawTick(self &, since f64) f64 {
    if lockstep or !synced { return 1.0e18; }
    // 100 ms behind, or, on a link that delivers fewer snapshots (the protocol slows to 10 packets a second when the
    // round trip is long, or snapshots are lost), enough behind to have two of them
    imm wanted = gapMax * 1.5 + 1.;
    since + tickOffset - (if wanted > DELAY_TICKS { wanted; } else { DELAY_TICKS; });
  }

  // The state of a being at tick 'tick': between the two snapshots either side of it, or the newest
  fn stateAt(self &, p &Puppet, tick f64) BeingState {
    imm n = p.samples.len();
    imm last = p.samples[n - 1usize].state;
    // Limp or getting up: the newest the simulation said (its pose is not blended)
    if last.mode != FIG_WALK { return last; }
    if tick >= f64.from(p.samples[n - 1usize].tick) {
      // Beyond the newest snapshot (late, or the clock estimate a little ahead): on at its velocity, for a while
      mut ahead = tick - f64.from(p.samples[n - 1usize].tick);
      if ahead > 6. { ahead = 6.; }
      imm v = velocityOf(&last);
      return new BeingState(last.being, false, last.position + v * f32.from(ahead / TICKS_PER_SECOND), last.yaw, last.speed, last.vy,
        last.airVx, last.airVz, last.grounded, last.intents, last.platform, last.health, last.respawns, last.landings, last.landSpeed,
        FIG_WALK, 0., false, noRots());
    }
    if n == 1usize { return last; }
    mut i = n - 2usize;
    while i > 0usize and f64.from(p.samples[i].tick) > tick { i = i - 1usize; }
    imm a = p.samples[i].state;
    imm c = p.samples[i + 1usize].state;
    if c.mode != FIG_WALK { return c; }
    imm ta = f64.from(p.samples[i].tick);
    imm tc = f64.from(p.samples[i + 1usize].tick);
    mut t = 0.;
    if tc > ta { t = f32.from((tick - ta) / (tc - ta)); }
    if t < 0. { t = 0.; }
    if t > 1. { t = 1.; }
    // The path between two snapshots: a cubic through both places with the velocities they carry (so that a
    // being that is speeding up or slowing down is not cut short across a gap of lost snapshots)
    imm span = f32.from((tc - ta) / TICKS_PER_SECOND);
    imm va = velocityOf(&a);
    imm vc = velocityOf(&c);
    imm t2 = t * t;
    imm t3 = t2 * t;
    imm h00 = 2. * t3 - 3. * t2 + 1.;
    imm h10 = t3 - 2. * t2 + t;
    imm h01 = 0. - 2. * t3 + 3. * t2;
    imm h11 = t3 - t2;
    imm pos = a.position * h00 + va * (span * h10) + c.position * h01 + vc * (span * h11);
    imm yaw = a.yaw + wrapPi(c.yaw - a.yaw) * t;
    new BeingState(a.being, false, pos, yaw, a.speed + (c.speed - a.speed) * t, a.vy + (c.vy - a.vy) * t, a.airVx, a.airVz,
      a.grounded, a.intents, a.platform, a.health, a.respawns, a.landings, a.landSpeed, FIG_WALK, 0., false, noRots());
  }

  // Every being but the one the user drives posed for each of this frame's steps, from the snapshots
  fn poseOthers(self &mut, steps &List[Step]) {
    if lockstep {
      self.predictOthers(steps);
      return;
    }
    mut k = 0usize;
    while k < steps.len() {
      imm step = *steps[k];
      imm since = self.nowTick() - f64.from(steps.len() - k - 1usize);
      imm at = self.drawTick(since);
      mut b = 0usize;
      while b < cast.beings.len() {
        if b != own and !cast.beings[b].gone and puppets[b].samples.len() > 0usize {
          imm s = self.stateAt(puppets[b], at);
          self.poseOne(b, s, step.dt);
          if opts.traceOn {
            print <- "TV "; print <- i64.from(at * 1000d); print <- " "; print <- sdl.GetPerformanceCounter(); print <- " ";
            print <- b; print <- " "; print <- i64.from(libc.floorf(s.position.x * 1000. + 0.5)); print <- " ";
            print <- i64.from(libc.floorf(s.position.y * 1000. + 0.5)); print <- " "; print <- i64.from(libc.floorf(s.position.z * 1000. + 0.5));
            print <- "\n";
          }
        }
        b = b + 1usize;
      }
      k = k + 1usize;
    }
    // One that has no step this frame is still placed where its snapshot says
    if steps.len() == 0usize {
      mut b = 0usize;
      while b < cast.beings.len() {
        if b != own and !cast.beings[b].gone and puppets[b].samples.len() > 0usize and !puppets[b].placed {
          imm s = self.stateAt(puppets[b], self.drawTick(self.nowTick()));
          self.poseOne(b, s, 0.);
        }
        b = b + 1usize;
      }
    }
  }

  // Single player, where each snapshot is the newest there is and nothing is late: the others stepped by the same
  // physics and gait the simulation steps them by (Being.step), by the intents their snapshot says they were last
  // given, and set to the snapshot where they differ from it (a script that moved one, a fall): so that a being
  // that is taken over is exactly as the simulation has it
  fn predictOthers(self &mut, steps &List[Step]) {
    mut b = 0usize;
    while b < cast.beings.len() {
      if b != own and !cast.beings[b].gone and puppets[b].samples.len() > 0usize {
        imm n = puppets[b].samples.len();
        imm s = puppets[b].samples[n - 1usize].state;
        if cast.beings[b].figure.active and followServer(&mut cast.phys, &mut cast.beings[b].figure, &mut cast.beings[b].body, &s) {
          // Limp or getting up: shown as the simulation says, not stepped
          puppets[b].started = true;
          cast.beings[b].before = cast.beings[b].body;
          cast.beings[b].intents = s.intents;
        } elif !puppets[b].started {
          // The first snapshot of it: it stands as the snapshot says
          puppets[b].started = true;
          self.setBodyTo(b, s);
        } else {
          mut k = 0usize;
          while k < steps.len() {
            cast.beings[b].step(&mut cast.phys, s.intents, steps[k].dt);
            k = k + 1usize;
          }
          if steps.len() > 0usize {
            imm being = cast.beings[b];
            imm dx = being.body.position.x - s.position.x;
            imm dy = being.body.position.y - s.position.y;
            imm dz = being.body.position.z - s.position.z;
            if dx * dx + dy * dy + dz * dz > 0.003 * 0.003 or being.figure.grounded != s.grounded
              or (being.figure.setDowns & 255u32) != s.respawns {
              self.setBodyTo(b, s);
            }
          }
        }
      }
      b = b + 1usize;
    }
  }

  // Being 'b' set whole to state 's'
  fn setBodyTo(self &mut, b usize, s BeingState) {
    imm being = &mut cast.beings[b];
    being.body.position = s.position;
    being.body.yaw = s.yaw;
    being.before = being.body;
    being.intents = s.intents;
    if being.figure.active {
      if (being.figure.setDowns & 255u32) != s.respawns {
        being.figure.setDown(&mut being.body, s.position, s.yaw);
        being.figure.setDowns = s.respawns;
      }
      being.figure.speed = s.speed;
      being.figure.vy = s.vy;
      being.figure.airVx = s.airVx;
      being.figure.airVz = s.airVz;
      being.figure.grounded = s.grounded;
      being.figure.on = s.platform;
      being.figure.health = s.health;
      being.figure.anchored = false;
    }
  }

  // Being 'b' set to state 's' and its gait stepped on by 'dt'
  fn poseOne(self &mut, b usize, s BeingState, dt f32) {
    imm being = &mut cast.beings[b];
    imm p = &mut puppets[b];
    being.body.position = s.position;
    being.body.yaw = s.yaw;
    being.intents = s.intents;
    if being.figure.active and followServer(&mut cast.phys, &mut being.figure, &mut being.body, &s) {
      being.before = being.body;
      return;
    }
    if being.figure.active {
      if p.respawns != s.respawns {
        p.respawns = s.respawns;
        being.figure.setDown(&mut being.body, s.position, s.yaw);
      }
      if p.landings != s.landings {
        p.landings = s.landings;
        being.figure.landedAt(s.landSpeed);
      }
      being.figure.speed = s.speed;
      being.figure.vy = s.vy;
      being.figure.airVx = s.airVx;
      being.figure.airVz = s.airVz;
      being.figure.grounded = s.grounded;
      being.figure.on = s.platform;
      being.figure.health = s.health;
      being.figure.poseFrom(&mut cast.phys, s.position, s.yaw, s.speed, s.intents.turn * TURN_RATE, s.grounded, dt);
    }
  }

  // Each being's part placed where its body is, when it has moved, and each mannequin posed by the skinning matrices
  // of its gait
  fn placeBeings(self &mut) {
    mut i = 0usize;
    while i < cast.beings.len() {
      imm b = cast.beings[i];
      if !b.gone and scene.isLive(b.part) {
        imm p = &mut puppets[i];
        imm drawn = i == own and ownReady;
        imm known = drawn or p.samples.len() > 0usize;
        mut at = b.body.position;
        if drawn { at = at + corr; }
        if !known { at = new Vec3(0., 0. - 5000., 0.); }
        if !p.placed or p.placedAt.x != at.x or p.placedAt.y != at.y or p.placedAt.z != at.z or p.placedYaw != b.body.yaw {
          p.placed = known;
          p.placedAt = at;
          p.placedYaw = b.body.yaw;
          scene.applyPlace(b.part, bodyPlacement(at, b.body.yaw));
        }
        if b.figure.active and known {
          forRender.push(Request.Bones(b.part, b.figure.skinning()));
        }
      }
      i = i + 1usize;
    }
  }

  // The frame's snapshot for drawing: the beings placed, the world matrices, the camera, the birds and the weather
  fn publishSnapshot(self &mut, steps &List[Step]) {
    self.poseOthers(steps);
    self.placeBeings();
    {
      imm propsAt = self.drawTick(self.nowTick());
      playPlaceProps(&mut play, &mut scene, propsAt, propsAt > 1.0e17);
    }
    scene.propagate();
    // Scene time: the snapshot's, carried on by the estimate when connected
    mut nowS = lastState.now;
    if !lockstep and hasState and synced {
      nowS = lastState.now + (self.nowTick() + tickOffset - f64.from(lastState.tick)) / TICKS_PER_SECOND * f64.from(rate);
    }
    sceneNow = nowS;
    mut last = Snapshot.empty();
    last <=> snapshot;
    snapshot = scene.publish(last, nowS, hourAt(nowS), cast.eyesBefore(), cast.eyes());
    mut flock = List[BirdFrame].empty();
    birds.publish(&mut flock);
    snapshot.birds <=> flock;
    snapshot.weather = weather;
    playSplats(&mut play, &cast, lastState.tick, &mut snapshot.splats);
    audioFromView(self, steps);   // the frame's sound (audioview.cone)
    snapshot.fixedView = testFixed;
    snapshot.fov = testFov;
    if testFixed { snapshot.view = testView; }
  }

  // The requests render takes this frame: those held back before, then this frame's, in order, as many as fit the frame's
  // upload budget (always at least one); the rest are held for the next frame. In the usual frame there is nothing held and
  // little to upload, and they all go.
  fn takeForRender(self &mut, frame u64) List[Request] {
    mut out = List[Request].empty();
    if lockstep {
      // Single player builds its world a few objects a frame (the world actor's steps) and has never outgrown staging
      out <=> forRender;
      return out;
    }
    if held.len() == 0usize {
      mut total = 0u64;
      imm fs = forRender.viewMut();
      mut k = 0usize;
      while k < fs.len { total = total + uploadCost(&fs[k]); k = k + 1usize; }
      if total <= UPLOAD_BUDGET {
        out <=> forRender;
        return out;
      }
    }
    // Held first, then this frame's
    mut all = List[Request].empty();
    all <=> held;
    imm fresh = forRender.viewMut();
    mut f = 0usize;
    while f < fresh.len {
      mut r Request = Request.Done;
      r <=> fresh[f];
      all.push(r);
      f = f + 1usize;
    }
    forRender.clear();
    imm items = all.viewMut();
    mut spent = 0u64;
    mut i = 0usize;
    while i < items.len {
      imm c = uploadCost(&items[i]);
      if spent > 0u64 and spent + c > UPLOAD_BUDGET { break; }
      spent = spent + c;
      mut r Request = Request.Done;
      r <=> items[i];
      out.push(r);
      i = i + 1usize;
    }
    mut rest = 0usize;
    while i < items.len {
      mut r Request = Request.Done;
      r <=> items[i];
      held.push(r);
      rest = rest + 1usize;
      i = i + 1usize;
    }
    if heldFrames == 0u32 { heldStartedAt = sdl.GetPerformanceCounter(); }
    heldTotal = heldTotal + spent;
    heldFrames = heldFrames + 1u32;
    if rest == 0usize {
      imm ms = f64.from(sdl.GetPerformanceCounter() - heldStartedAt) / f64.from(sdl.GetPerformanceFrequency()) * 1000d;
      print <- "Upload: a burst of "; print <- heldTotal / 1048576u64; print <- " MB (estimated) spread over "; print <- heldFrames;
      print <- " frames, done at frame "; print <- frame; print <- ", "; print <- ms; print <- " ms after it began\n";
      heldTotal = 0u64;
      heldFrames = 0u32;
    }
    out;
  }

  // What is moved to render for the frame: the snapshot and render's requests,
  // and the name of a scripted view to save
  fn drawOrder(self &mut, input &FrameInput) DrawOrder {
    mut snap = Snapshot.empty();
    snap <=> snapshot;
    imm requests = self.takeForRender(input.frame);
    new DrawOrder(snap, requests, input.alpha, input.frame, input.resized, input.width, input.height, self.shotFor(input.frame),
      self.hudFrame(input));
  }

  // The view to save at frame 'f': the scripted run's (from the simulation), else the test hook's (--switch-at N): one the frame
  // before the switch is asked for, one a while after it was made
  fn shotFor(self &, f u64) String {
    imm joinShot = panelJoinShotAt(&opts, f);
    if joinShot.len() > 0usize { return String.from(joinShot); }
    if opts.switchAt > 0u64 and lockstep and f + 1u64 == opts.switchAt { return String.from("switch-before"); }
    if shotFrame > 0u64 and f == shotFrame { return String.from("switch-after"); }
    // (a switch that has not been made 200 frames on, because the dial failed, is shown as it is: single player carrying on)
    if opts.switchAt > 0u64 and lockstep and f == opts.switchAt + 200u64 { return String.from("switch-after"); }
    testShot.copy();
  }

  // What the HUD shows this frame (hud.cone): where the user's being and the others are, the clock, the weather, the frame time
  fn hudFrame(self &mut, input &FrameInput) HudFrame {
    if input.hudHide { hud.on = !hud.on; }
    hud.tick();
    mut you = new Vec3(0., 0., 0.);
    mut yaw = 0.;
    mut others = List[Vec3].empty();
    imm driven = if own != NO_ROW { own; } else { cast.possessed; };
    mut i = 0usize;
    while i < cast.beings.len() {
      imm b = cast.beings[i];
      if i == driven {
        you = b.body.position;
        yaw = b.body.yaw;
      } elif !b.gone and b.figure.active {
        // (a plain walker, with no figure, is nobody to see: the other mannequins are the characters)
        others.push(b.body.position);
      }
      i = i + 1usize;
    }
    // The players' names, above their heads (the user's own is not shown to the user)
    mut plates = List[HudTag].empty();
    mut t = 0usize;
    while t < tags.len() {
      imm being = usize.from(tags[t].being);
      if being != driven and being < cast.beings.len() and !cast.beings[being].gone and cast.beings[being].figure.active {
        plates.push(new HudTag(cast.beings[being].body.position + new Vec3(0., 0.45 + cast.beings[being].figure.height, 0.), tags[t].name.copy()));
      }
      t = t + 1usize;
    }
    // (a scripted run's frame time and step are not repeatable: it shows none, and steps by 1/60)
    mut hf = new HudFrame(hud.on, f32.from(hourAt(sceneNow)), weather.target, if opts.scripted { 0.; } else { hud.smoothMs; }, !lockstep, rttMs,
      you, yaw, others, input.hudSlots, if opts.scripted { 0.016666668; } else { hud.stepSeconds(); }, plates, cast.eyes(), FOV,
      copyPanelEvents(&input.panelEvents), input.panelHint and lockstep, String.empty());
    // A Join that did not get in is told once (to the panel, which shows why)
    if joinFailed.len() > 0usize {
      hf.joinFailed = joinFailed.copy();
      joinFailed = String.empty();
    }
    hf;
  }

  // The user's body, for the shell's report
  pub fn youBody(self &) Walk {
    if own != NO_ROW and own < cast.beings.len() { return cast.beings[own].body; }
    Walk.make(new Vec3(0., 0., 0.), 0.);
  }
}

actor ViewActor {
  st ViewState;
  sim Option[SimActor];
  render RenderActor;
  frames Sender[FrameReport];  // the shell's: each frame presented
  ended Sender[i32];           // the shell's: the run's exit code, at the end
  joined Sender[bool];         // the shell's: whether the connection opened
  cur FrameInput;              // the frame being made
  // Going online (goOnline, below): single player carries on while a server is dialled
  online Option[ViewState];    // the state of the connected view being made, receiving the server's first messages
  endpoint Option[Endpoint];   // the dialled link's endpoint (shut when the dial fails, or at the end of the run)
  attempt u32;                 // the dial in progress (a late event of an earlier one is ignored)
  dialSince u64;               // when it began, ns (0: none)
  onlineReady bool;            // the server has taken this client in: the switch is made when the next frame begins
  switched bool;               // it was made: the first link's late events are ignored, the dialled link's are the view's

  // The view made, with the simulation (single player) and render actors named, and the
  // shell's inboxes, and this browser's flock
  fn init(self &new, sim Option[SimActor], render RenderActor, frames Sender[FrameReport], ended Sender[i32],
      birds Birds, lockstep bool, joined Sender[bool], audioOpts AudioOptions, automated bool, opts RunOptions,
      playerName String, land Island) {
    // The sound's sink, opened here on the constructing (main) thread: the view is this actor's own from then on
    mut state = ViewState.make(birds, lockstep, audioOpen(&audioOpts, automated), playerName, land, opts);
    // The physics this browser predicts its own mannequin by: the same ground and solids as the simulation's, its own world
    imm solids = worldSolids(&land);
    state.cast.phys.ensureGround();
    state.cast.phys.setSolids(&solids);
    // (the test hook, --switch-at N, on a run that is connected from the start: the same view saved, for comparing with a switch's)
    if !lockstep and opts.switchAt > 0u64 { state.shotFrame = opts.switchAt + 120u64; }
    *self =new Self(state, sim, render, frames, ended, joined, FrameInput.none(), None[ViewState], None[Endpoint], 0u32, 0u64, false, false);
  }

  // What the connection tells (its handler sends it here): it opened or ended, a message, a value. In single player the
  // simulation's FrameDone, said last, finishes the frame that was begun
  pub async do onNet(self, ev NetEvent) {
    if switched { return; }   // the first link's (the simulation's in-process pair): it ended with the switch
    st.onEvent(ev);
    if st.joinedNow {
      st.joinedNow = false;
      joined <- true;
    }
    if st.leftNow {
      st.leftNow = false;
      if !st.joined { joined <- false; }
    }
    if st.frameDone {
      st.frameDone = false;
      st.applyIncoming();
      selfactor.complete();
    }
  }

  // ---- going online (the panel's Join) ----

  // Dial the server at 'address' under 'name' while single player carries on. The server's first words are received into a
  // second, connected state made on the side (ViewState with no lockstep, which sends its Hello when the link opens and keeps
  // what arrives unapplied). Only when the server has taken this client in (its Possessed, after the replay of the world so far)
  // is the switch made, at the start of the next frame (frame, above). A dial that gets no answer, or a server that refuses the
  // name, ends here with a word for the panel (ViewState.joinFailed) and single player has not stopped. Answers whether a dial
  // was begun.
  pub async do goOnline(self, address String, name String) bool {
    if !st.lockstep or switched or dialSince != 0u64 { return false; }
    if !addressReadable(address.view()) {
      st.joinFailed = String.from("That server address is not readable.");
      return false;
    }
    print <- "Joining "; printStr(address.view()); print <- " as "; printStr(name.view()); print <- "\n";
    imm land = st.land.share();
    mut fresh = ViewState.make(Birds.make(&land), false, AudioView.silent(), name.copy(), land.share(), st.opts);
    imm solids = worldSolids(&land);
    fresh.cast.phys.ensureGround();
    fresh.cast.phys.setSolids(&solids);
    online = Some[ViewState](fresh);
    attempt = attempt + 1u32;
    imm me = selfactor;
    imm gen = attempt;
    imm handler = eventHandler(new So[fn(ev NetEvent) + Sendable](fn(ev NetEvent) [me, gen] { me.onOnline(gen, ev); }));
    imm bound = mustConnect(parseAddress(address.view()), NetConfig.defaults(), handler);
    endpoint = Some[Endpoint](bound.endpoint);
    dialSince = sdl.GetTicksNS();
    true;
  }

  // What the dialled link tells (attempt 'gen' of it): before the switch it is kept in the state on the side, and decides how the
  // dial ends; after the switch it is the view's own link, as a --connect view's is
  pub async do onOnline(self, gen u32, ev NetEvent) {
    if gen != attempt { return; }
    if switched {
      st.onEvent(ev);
      st.joinedNow = false;
      st.leftNow = false;
      return;
    }
    mut why = String.empty();
    mut ready = false;
    match &mut online {
      case mut o &mut Some {
        o.onEvent(ev);
        o.joinedNow = false;
        if dialSince == 0u64 {
          // (the switch is being made: this is only kept)
        } elif o.refusedNow {
          why = o.refusedWhy.copy();
        } elif o.leftNow {
          why = String.from(if o.joined { "The server closed the connection."; } else { "The server did not answer."; });
        } elif o.possessedSeen {
          ready = true;
        }
      }
      else {}
    }
    if why.len() > 0usize { self.failDial(why); }
    elif ready { onlineReady = true; }
  }

  // A dial that did not get in: the link let go, and the reason left for the panel. Single player never stopped.
  fn failDial(self, why String) {
    print <- "Join failed: "; printStr(why.view()); print <- "\n";
    match &mut online {
      case mut o &mut Some { if o.net.has(1u32) { o.net.hangUp(1u32); } }
      else {}
    }
    online = None;
    match &endpoint {
      case imm e Some { e.shutdown(); }
      else {}
    }
    endpoint = None;
    dialSince = 0u64;
    onlineReady = false;
    st.joinFailed = why;
  }

  // The frame (above). Single player: the user's body predicted, the inputs sent and the simulation asked to take the
  // frame's steps; the rest of the frame waits for its answer. Connected: what has arrived is applied, the steps
  // predicted and the frame completed at once
  pub async do frame(self, input FrameInput) {
    cur = input;
    // A Join still dialling after too long is given up (the handshake's own limit is 5 s; this is the backstop)
    if dialSince != 0u64 and !onlineReady and sdl.GetTicksNS() - dialSince > DIAL_LIMIT_NS {
      self.failDial(String.from("The server did not answer."));
    }
    // THE SWITCH, here, at the start of a frame: no frame is in flight (the last was presented and reported before the shell
    // called this), so the simulation owes the view nothing (no Frame asked, no FrameDone to come). Single player's world
    // goes, the server's is taken up exactly as a fresh --connect takes it: a late joiner.
    if onlineReady {
      onlineReady = false;
      dialSince = 0u64;   // (from here the link's words decide nothing more: the switch is being made)
      // Render forgets the old world: a Despawn of every part the view held, its meshes and materials let go
      mut sweep = List[Request].empty();
      mut live = List[PartId].empty();
      st.scene.liveIds(&mut live);
      if !st.picked.isNone() and st.scene.isLive(st.picked) { sweep.push(Request.Highlight(st.picked, false)); }
      mut k = 0usize;
      while k < live.len() {
        sweep.push(Request.Despawn(*live[k]));
        k = k + 1usize;
      }
      imm forgotten = await render.reset(sweep);
      // The new state takes over, carrying what is the browser's rather than the world's: the sound, the HUD's toggles and
      // frame-time smoothing, this browser's flock and the window's size
      mut next Option[ViewState] = None;
      next <=> online;
      match &mut next {
        case mut n &mut Some {
          n.audio <=> st.audio;
          n.birds <=> st.birds;
          n.hud <=> st.hud;
          n.view = st.view;
          if n.opts.switchAt > 0u64 { n.shotFrame = cur.frame + 120u64; }
          st <=> *n;
        }
        else {}
      }
      switched = true;
      st.joinedNow = false;
      // The in-process simulation is over, quietly (what its connection tells from here is ignored: 'switched'), and so is the
      // first state's end of that connection
      match &sim {
        case imm s Some { imm stopped = await s.stop(); }
        else {}
      }
      sim = None;
      match &mut next {
        case mut old &mut Some { old.net.hangUp(1u32); }
        else {}
      }
      print <- "Online: frame "; print <- cur.frame; print <- ", single player's world let go\n";
    }
    if st.lockstep {
      st.beforeSim(&cur);
      st.net.sendReliable(1u32, encodeToSim(ToSim.Frame(cur.frame, copySteps(&cur.steps))));
    } else {
      st.applyIncoming();
      st.beforeSim(&cur);
      selfactor.complete();
    }
  }

  // The rest of the frame: the snapshot published, the frame drawn, what the view saw told to the simulation, the shell told
  pub async do complete(self) {
    imm connected = !st.lockstep;
    imm frameNo = cur.frame;
    imm t1 = sdl.GetTicksNS();
    st.publishSnapshot(&cur.steps);
    imm order = st.drawOrder(&cur);
    imm t2 = sdl.GetTicksNS();
    imm shown = await render.draw(order);
    mut p = shown;
    p.snapshot <=> st.snapshot;
    mut seen = RenderFacts.empty();
    seen <=> p.facts;
    mut you = st.youBody();
    mut waiting = 0usize;
    mut parts = st.scene.partCount();
    mut worldDone = false;
    mut worldSent = 0u64;
    match &sim {
      case imm s Some {
        imm end = await s.endFrame(new ViewFacts(frameNo, seen, st.picked, st.lastPick, st.clicks, st.view, p.shotFailed,
          st.late > 0u64));
        you = end.you;
        waiting = end.waiting;
        parts = end.parts;
        worldDone = end.worldDone;
        worldSent = end.worldSentFrame;
      }
      else {
        // Connected: the world is done when the last object has been built here
        worldDone = st.worldBuilt >= OBJECTS;
        worldSent = 0u64;
      }
    }
    // Connected: the round-trip time, once a second
    if connected and frameNo % 60u64 == 30u64 and st.net.has(1u32) {
      imm conn = st.net.peer(1u32).conn;
      imm cs = await conn.stats();
      st.rttMs = cs.rttMs;
      if cs.rttMs > 0i64 {
        // The least lately: it creeps up, so that a link that has got slower is believed in time
        imm creep = st.rttMinMs + st.rttMinMs / 50i64 + 1i64;
        st.rttMinMs = if st.rttMinMs == 0i64 or cs.rttMs < creep { cs.rttMs; } else { creep; };
      }
      st.bytesIn = cs.bytesReceived;
      st.bytesOut = cs.bytesSent;
    }
    if st.opts.traceOn { print.flush(); }
    mut report = new FrameReport(st.simulateNs, st.publishNs + (t2 - t1), p.renderNs, p.presentNs, p.swapNs, p.acquireNs, p.status,
      you, waiting, parts, p.rows, p.emitters, worldDone, worldSent, st.refusedNow, p.join.copy());
    report.panel = p.panel;
    report.online = !st.lockstep;
    report.dialing = dialSince != 0u64;
    frames <- report;
  }

  // The end of the run: the simulation's and the world's lines, the link's,
  // render's, the script's verdict, and the exit code to the shell
  pub async do finish(self, hasWindow bool) {
    print <- "Link: "; print <- st.snapshots; print <- " snapshots taken, "; print <- st.stale; print <- " dropped as old; ";
    print <- st.late; print <- " frames with the state late; "; print <- st.corrections; print <- " corrections (worst "; print <- st.worstError;
    print <- " m), "; print <- st.resyncs; print <- " resyncs, "; print <- st.setDowned; print <- " set-downs (farthest "; print <- st.worstSetDown;
    print <- " m)\n";
    if !st.lockstep {
      imm fb = st.youBody();
      print <- "FINAL "; print <- st.own; print <- " "; print <- i64.from(libc.floorf(fb.position.x * 1000. + 0.5)); print <- " ";
      print <- i64.from(libc.floorf(fb.position.y * 1000. + 0.5)); print <- " "; print <- i64.from(libc.floorf(fb.position.z * 1000. + 0.5)); print <- "\n";
      playReport(&st.play);
      print <- "Scene: "; print <- st.scene.partCount(); print <- " parts live, "; print <- st.worldBuilt; print <- " world objects built here, ";
      print <- st.cast.beings.len(); print <- " beings\n";
      if st.net.has(1u32) {
        imm conn = st.net.peer(1u32).conn;
        imm cs = await conn.stats();
        print <- "NET rtt "; print <- cs.rttMs; print <- " ms, loss "; print <- cs.lossPermille; print <- " per 1000; received "; print <- cs.packetsReceived;
        print <- " packets, "; print <- cs.bytesReceived; print <- " bytes; sent "; print <- cs.packetsSent; print <- " packets, "; print <- cs.bytesSent;
        print <- " bytes\n";
      }
    }
    mut code = 0i32;
    match &sim {
      case imm s Some { imm reported = await s.finishScene(); }
      else {}
    }
    imm end = await render.finish(hasWindow);
    if !end.clean { code = 1i32; }
    match &sim {
      case imm s Some {
        imm c = await s.verdict(end.clean);
        code = c;
      }
      else {}
    }
    st.audio.finish();
    // A link dialled by a Join: its socket's thread must stop before the actors' runtime does (the shell's own, when the run began
    // connected, is shut by the shell)
    match &endpoint {
      case imm e Some { e.shutdown(); }
      else {}
    }
    // The script's walkers are put down by Being.setDown (counted, and the snapshot carries the count), so what the view counts as a
    // correction is a real misprediction: the script lifts one mannequin 6 m on purpose, and nothing in it is out by more than that
    // (not after a switch to a server: the script's walkers are the single-player simulation's, which has ended)
    if st.opts.scripted and !switched {
      imm okSets = st.setDowned >= 1u64 and st.worstSetDown > 100.;
      imm okFix = st.worstError < 6.5;
      print <- "Corrections: the script's set-downs are counted apart ("; print <- st.setDowned; print <- ", farthest "; print <- st.worstSetDown;
      print <- " m): "; if okSets { print <- "yes\n"; } else { print <- "NO\n"; }
      print <- "Corrections: none of the "; print <- st.corrections; print <- " is out by more than the 6 m the script lifts a mannequin (worst ";
      print <- st.worstError; print <- " m): "; if okFix { print <- "yes\n"; } else { print <- "NO\n"; }
      if !okSets or !okFix { code = 1i32; }
    }
    ended <- code;
  }
}

// About how many bytes render's staging memory takes to upload what request 'r' defines (0 for any other): a mesh's vertex
// streams and indices, an image or a field's texels with their mip levels
fn uploadCost(r &Request) u64 {
  match r {
    case imm dm DefineMesh { return meshCost(&dm.shape); }
    case imm ds DefineSkinnedMesh { return meshCost(&ds.shape) + u64.from(ds.skin.joints.len()) * 8u64; }
    case imm dl DefineMaterial {
      return u64.from(dl.paint.pixels.len()) * 2u64 + u64.from(dl.maps.normal.pixels.len()) * 2u64
        + u64.from(dl.maps.orm.pixels.len()) * 2u64 + u64.from(dl.maps.field.values.len() + dl.maps.field2.values.len()) * 6u64 + 256u64;
    }
    else {}
  }
  0u64;
}

fn meshCost(m &Mesh) u64 {
  u64.from(m.positions.len()) * 40u64 + u64.from(m.indices.len()) * 4u64;
}

// A being's velocity as its snapshot has it, m/s: along its heading at its speed on the ground, as it fell in the air
fn velocityOf(s &BeingState) Vec3 {
  if s.grounded { return new Vec3(0. - libc.sinf(s.yaw) * s.speed, 0., 0. - libc.cosf(s.yaw) * s.speed); }
  new Vec3(s.airVx, s.vy, s.airVz);
}

// A copy of the panel's events of a frame
fn copyPanelEvents(src &List[PanelEvent]) List[PanelEvent] {
  mut out = List[PanelEvent].withCapacity(src.len());
  mut i = 0usize;
  while i < src.len() {
    imm e = src[i];
    out.push(new PanelEvent(e.kind, e.a, e.b, e.code, e.mods, e.text.copy()));
    i = i + 1usize;
  }
  out;
}

// A copy of the steps of a frame
fn copySteps(src &List[Step]) List[Step] {
  mut out = List[Step].withCapacity(src.len());
  mut i = 0usize;
  while i < src.len() {
    out.push(*src[i]);
    i = i + 1usize;
  }
  out;
}
