// The audio walk: a scripted walk that is listened to (--audio-walk FILE.wav), after the sound's own brief: past the
// brook and over the bridge, the mixer's output recorded to a WAV.
//
// The user's mannequin is set down on the lawn route 8 m south of the stone bridge, standing for a second (the wind and the
// brook from a distance), then walks north at the walk speed (1.8 m/s) straight along the route, over the bridge's hump and on
// into the back yard towards the balloon, whose burner is firing in its bursts (the world's own, on the ground: 3 s on, 1 s off).
// The mute key (N) is pressed at AUDIO_MUTE_ON and again at AUDIO_MUTE_OFF, so the recording has a second of silence; the key
// events are pushed into SDL's own queue like every script's. No real keyboard is read.
//
// The run is on frame's synthetic clock (one step a frame), headless or windowed, so the walk is exact and the recording is the
// same every time.

// The walk's frames: a second standing, then the walk, ending in the yard
pub const AUDIO_WALK_FRAMES = 1300u64;
const AUDIO_STAND = 60u64;
const AUDIO_MUTE_ON = 400u64;
const AUDIO_MUTE_OFF = 460u64;

// The start of the walk: on the lawn route, 8 m south of the bridge's middle, a little east of the route's line so that the
// straight line north over the bridge keeps to its road
const AUDIO_START_X f32 = -7.0;
const AUDIO_START_Z f32 = 322.4;

// Where the user's mannequin is set down: the landing beach, or the audio walk's start (RunOptions.audioWalk)
pub fn userStart(audioWalk bool) Vec2 {
  if audioWalk { return new Vec2(AUDIO_START_X, AUDIO_START_Z); }
  new Vec2(BEACH_X, BEACH_Z)
}

// The walk's intents by fixed step: stand, then walk straight ahead
pub fn audioWalkIntents(n u64) Intents {
  if n < AUDIO_STAND { return Intents.none(); }
  new Intents(1., 0., false, false)
}

// The mute key pressed and let go (the script's own events), at the frames given
pub fn audioWalkKeys(f u64) {
  if f == AUDIO_MUTE_ON or f == AUDIO_MUTE_OFF { pushKey(SCANCODE_N, true); }
  if f == AUDIO_MUTE_ON + 2u64 or f == AUDIO_MUTE_OFF + 2u64 { pushKey(SCANCODE_N, false); }
}
