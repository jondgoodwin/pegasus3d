// The creatures' part of the scripted run (creatures.cone, creatureview.cone, talkpanel.cone): `browser.exe --creatures-only --shots DIR`
// (after the first 300 frames of the run, which settle the island), and the last part of the full run, after the labyrinth's. The
// wooden mannequin (being 1) is the visitor; the views are fixed eyes (the run's other close-ups are), and a picture is saved at each frame
// named below. The visitor's keys go into SDL's own queue, never the system's: E and the click on a question by the shell (crPush: it
// knows the window and where the panel puts its buttons), the jump and the walks by the simulation's script (as portalscript.cone's).
// Times are frames counted from the part's first (k):
//
//    0      the creatures made (the west guard in blue and the east in red; the east guard lies in a scripted run), the visitor set
//           down at the hall's south end                                                   cr-hall (67) cr-guard-west (79) cr-guard-east (91)
//  100      set down before the east guard, facing it; E (105): the panel opens            cr-talk-open (125)
//  130      a click on the second question, "Which door would your fellow name?": the guard answers   cr-talk-reply (160)
//  165      E closes it; the guard's words stay over its head                              cr-guard-says (185)
//  200      the door the answer leaves is the east one: walked through (the corridor's)    cr-door-right (255)
//  270      the other, the west, walked through to the Worm's chamber                      cr-door-wrong (285)
//           the Worm rises, chats                                                          cr-worm-rise (345) cr-worm-up (400) cr-worm-says (530)
//  600      the Minotaur at home; the visitor in the court's north-west far from it       cr-bull-patrol (620)
//  640      paint (F1's path: PlaySim) thrown at the pillar the Minotaur has a clear run to; it winds up, charges, runs into it
//           and staggers (stars)                                                           cr-bull-windup (665) cr-bull-charge (775) cr-bull-hit (900) cr-bull-stars (960)
// 1320      the Minotaur at home again; the visitor 12 m before it, facing it: it winds up and charges at the visitor; the
//           visitor jumps when it is 4 m off (a Space pushed by the script) and is vaulted over it   cr-leap-windup (1350) cr-leap-charge (1440)
//           cr-leap-near (1500) cr-leap-1 ... cr-leap-6 (1512 to 1572, every 12 frames of the vault) cr-leap-landed (1600)
//           the visitor runs on east through the door to the staircase hall                 cr-stairs (1840)
//
// What it checks, in the frames' own words (st.run.creaturesOk): the answer is the one the puzzle gives, the Worm rose once and said at
// least two lines, the charge ran into the pillar and staggered, the vault happened and nobody was shoved, and the visitor got to the
// staircase hall.

pub const CRS_FRAMES = 1900u64;

// The first frame of the creatures' part: 300 in the creatures-only run, else after the labyrinth's
pub fn creaturesFrom(opts &RunOptions) u64 {
  if opts.creaturesOnly { 300u64 } else { labScriptEnd(opts) }
}

pub fn creaturesScriptEnd(opts &RunOptions) u64 { creaturesFrom(opts) + CRS_FRAMES }

pub fn creaturesIn(opts &RunOptions, f u64) bool {
  if opts.creaturesOnly { return f >= creaturesFrom(opts); }
  // (the full run's last part: not in the runs of one part alone, whose frames, run on by a soak, would come to it)
  if opts.labOnly || opts.portalOnly || opts.mirrorOnly || opts.panelOnly || opts.hudOnly || opts.gallery { return false; }
  opts.scripted && f >= creaturesFrom(opts) && f < creaturesScriptEnd(opts)
}

// The pillar the stagger is aimed at (292.5 degrees on the ring about the court's middle), on its side towards the Minotaur
fn crPillarPoint() Vec3 { new Vec3(17.6, LAB_Y + 1.4, 383.5) }

// The pictures saved, by frame k of the part
pub fn creaturesShotAt(opts &RunOptions, f u64) &str {
  if !creaturesIn(opts, f) { return ""; }
  let k = f - creaturesFrom(opts);
  if k == 67u64 { return "cr-hall"; }
  if k == 79u64 { return "cr-guard-west"; }
  if k == 91u64 { return "cr-guard-east"; }
  if k == 125u64 { return "cr-talk-open"; }
  if k == 160u64 { return "cr-talk-reply"; }
  if k == 185u64 { return "cr-guard-says"; }
  if k == 255u64 { return "cr-door-right"; }
  if k == 285u64 { return "cr-door-wrong"; }
  if k == 345u64 { return "cr-worm-rise"; }
  if k == 400u64 { return "cr-worm-up"; }
  if k == 530u64 { return "cr-worm-says"; }
  if k == 620u64 { return "cr-bull-patrol"; }
  if k == 665u64 { return "cr-bull-windup"; }
  if k == 775u64 { return "cr-bull-charge"; }
  if k == 900u64 { return "cr-bull-hit"; }
  if k == 960u64 { return "cr-bull-stars"; }
  // (the vault begins at frame 1505 of this deterministic run, when the Minotaur is 4 m off, and lasts 78 steps)
  if k == 1350u64 { return "cr-leap-windup"; }
  if k == 1440u64 { return "cr-leap-charge"; }
  if k == 1500u64 { return "cr-leap-near"; }
  if k == 1512u64 { return "cr-leap-1"; }
  if k == 1524u64 { return "cr-leap-2"; }
  if k == 1536u64 { return "cr-leap-3"; }
  if k == 1548u64 { return "cr-leap-4"; }
  if k == 1560u64 { return "cr-leap-5"; }
  if k == 1572u64 { return "cr-leap-6"; }
  if k == 1600u64 { return "cr-leap-landed"; }
  if k == 1840u64 { return "cr-stairs"; }
  ""
}

pub fn creaturesHasView(opts &RunOptions, f u64) bool { creaturesIn(opts, f) }

// The lens of the part's view at frame k
pub fn creaturesViewFov(opts &RunOptions, f u64) f32 {
  let k = f - creaturesFrom(opts);
  if k < 60u64 { return 1.2; }
  if k < 100u64 { return 0.9; }
  if k < 200u64 { return 0.95; }
  if k < 270u64 { return 1.15; }
  if k < 600u64 { return 1.0; }
  if k < 1320u64 { return 1.05; }
  1.0
}

// The Minotaur's place, for the views that follow it
fn crBull(st &SimState) Vec3 {
  if st.creatures.bull < st.cast.beings.len() { st.cast.beings[st.creatures.bull].body.position } else { bullHome() }
}

// The visitor's place
fn crYou(st &SimState) Vec3 { st.cast.beings[1usize].body.position }

// The eye of the part's view at frame k: fixed eyes in the hall and the Worm's chamber, the ones in the court follow the Minotaur
pub fn creaturesView(st &mut SimState, f u64) Pose {
  let k = f - creaturesFrom(&st.opts);
  let y = LAB_Y;
  if k < 60u64 { return lookFrom(new Vec3(0., y + 1.7, 323.), new Vec3(0., y + 1.9, 341.)); }
  if k < 72u64 { return lookFrom(new Vec3(0., y + 1.7, 323.), new Vec3(0., y + 1.9, 341.)); }
  if k < 84u64 { return lookFrom(new Vec3(-2.2, y + 1.65, 334.), new Vec3(-5.2, y + 1.35, 338.8)); }
  if k < 100u64 { return lookFrom(new Vec3(2.2, y + 1.65, 334.), new Vec3(5.2, y + 1.35, 338.8)); }
  if k < 200u64 { return lookFrom(new Vec3(2.6, y + 1.75, 333.2), new Vec3(5.2, y + 1.55, 338.8)); }
  if k < 270u64 { return lookFrom(new Vec3(3.5, y + 1.7, 335.5), new Vec3(8., y + 1.5, 342.5)); }
  if k < 330u64 { return lookFrom(new Vec3(-12.2, y + 1.7, 335.), new Vec3(-8., y + 1.4, 341.5)); }
  if k < 600u64 { return lookFrom(new Vec3(-10.8, y + 1.6, 344.6), new Vec3(-8., y + 1.0, 349.)); }
  let b = crBull(st);
  if k < 1320u64 {
    // From beside the court's east side, the Minotaur in the middle of the picture
    if k < 700u64 { return lookFrom(new Vec3(19., y + 2., 399.), b + new Vec3(0., 1.2, 0.)); }
    return lookFrom(new Vec3(26., y + 2.6, 376.), b + new Vec3(-1.5, 1.2, 0.));
  }
  let you = crYou(st);
  if k < 1830u64 {
    // The leap, from the side of the line between the two
    let mid = new Vec3((b.x + you.x) * 0.5, y + 1.5, (b.z + you.z) * 0.5);
    return lookFrom(new Vec3(mid.x - 1., y + 2.0, mid.z + 8.), mid);
  }
  lookFrom(new Vec3(46., y + 2.3, 390.), new Vec3(36., y + 1.5, 392.))
}

// SDL events from the shell, for frame f (the visitor's H and the click on the panel's second button, aimed where the panel puts
// its buttons: talkTarget), as panelscript.cone's panelPush does
pub fn crPush(opts &RunOptions, f u64, view Vec2, pixels Vec2, scale f32) {
  if !creaturesIn(opts, f) { return; }
  let k = f - creaturesFrom(opts);
  if k == 105u64 || k == 165u64 { pushKey(SCANCODE_H, true); }
  if k == 106u64 || k == 166u64 { pushKey(SCANCODE_H, false); }
  if k == 130u64 || k == 131u64 {
    let at = talkTarget(1u32, pixels.x / scale, pixels.y / scale);
    pushButton(at.x * scale * view.x / pixels.x, at.y * scale * view.y / pixels.y, k == 130u64);
  }
}

// The heading that faces from a to b on the ground
fn crFace(a Vec3, b Vec3) f32 { libc.atan2f(0. - (b.x - a.x), 0. - (b.z - a.z)) }

fn crWalkOn(shift bool) {
  if shift { pushKey(sdl.SCANCODE_LSHIFT, true); }
  pushKey(sdl.SCANCODE_W, true);
}

fn crWalkOff() {
  pushKey(sdl.SCANCODE_W, false);
  pushKey(sdl.SCANCODE_LSHIFT, false);
}

fn crSay(st &SimState, f u64, what &str, ok bool) {
  print <- "Creatures, frame "; print <- f; print <- ": "; printStr(what); print <- ": "; if ok { print <- "yes\n"; } else { print <- "NO\n"; }
}

// The part's actions and checks at frame f (after it is presented)
pub fn creaturesDrive(st &mut SimState, f u64) {
  if !creaturesIn(&st.opts, f) { return; }
  let k = f - creaturesFrom(&st.opts);
  let y = LAB_Y;
  let vi = 1usize;
  if k == 0u64 {
    st.scene.clock.ns = u64.from(nanosOf(7500.0));
    st.weather.setNow(WEATHER_FAIR);
    st.seedCreatures();
    st.cast.possess(vi);
    st.cast.beings[vi].setDown(new Vec3(0., y, 322.5), 3.1415927);
    st.run.creaturesOk = true;
    return;
  }
  // The visitor before the east guard, facing it
  if k == 100u64 {
    let g = st.cast.beings[*st.creatures.guards[1usize]].body.position;
    let at = new Vec3(4.6, y, 335.6);
    st.cast.beings[vi].setDown(at, crFace(at, g));
  }
  if k == 190u64 {
    let want = answerCode(Q_OTHER, CR_GUARD_E, st.creatures.liar);
    let door = doorToTake(want, CR_GUARD_E);
    crSay(st, f, "the east guard answered the fellow-question once, and the answer leaves the east door", st.creatures.said == 1u32 && door == DOOR_EAST);
    if !(st.creatures.said == 1u32 && door == DOOR_EAST) { st.run.creaturesOk = false; }
    print <- "  (the "; print <- if st.creatures.liar == 0u32 { "west" } else { "east" }; print <- " guard lies: the answer was '"; printStr(guardSays(want).view()); print <- "')\n";
  }
  // The right door: from beside the east guard through the east door, at a run
  if k == 200u64 {
    let at = new Vec3(7., y, 338.8);
    st.cast.beings[vi].setDown(at, crFace(at, new Vec3(8., y, 345.)));
  }
  if k == 204u64 { crWalkOn(true); }
  if k == 258u64 { crWalkOff(); }
  if k == 266u64 {
    let p = crYou(st);
    crSay(st, f, "walked through the east door, into the corridor", p.z > 342. && p.x > 6.4 && p.x < 9.6);
    print <- "  (the visitor at ("; print <- p.x; print <- ", "; print <- p.z; print <- "))\n";
    if !(p.z > 342. && p.x > 6.4 && p.x < 9.6) { st.run.creaturesOk = false; }
  }
  // The wrong door: through the west door into the Worm's chamber
  if k == 270u64 {
    let at = new Vec3(LAB_DOOR_LEFT_X, y, 339.2);
    st.cast.beings[vi].setDown(at, 3.1415927);
  }
  if k == 274u64 { crWalkOn(true); }
  if k == 324u64 { crWalkOff(); }
  if k == 560u64 {
    let ok = st.creatures.wormRises == 1u32 && st.creatures.wormTalks >= 2u32;
    crSay(st, f, "the Worm rose once and has said two lines or more", ok);
    print <- "  (rose "; print <- st.creatures.wormRises; print <- " time(s), said "; print <- st.creatures.wormTalks; print <- " line(s))\n";
    if !ok { st.run.creaturesOk = false; }
  }
  // The Minotaur: far from the visitor, patrolling; then paint thrown at the pillar
  if k == 600u64 {
    bullReset(&mut st.creatures, &mut st.cast, st.tick);
    st.cast.beings[vi].setDown(new Vec3(2., y, 379.), 0.);
  }
  if k == 640u64 {
    let b = st.cast.beings[vi];
    let eye = b.body.position + new Vec3(0., 0.936 * b.figure.height, 0.);
    let d = crPillarPoint() - eye;
    let l = libc.sqrtf(d.x * d.x + d.y * d.y + d.z * d.z);
    st.play.receive(st.firstClient(), PLAY_SPELL, SPELL_PAINT, NO_TARGET, eye, new Vec3(d.x / l, d.y / l, d.z / l));
  }
  if k == 1000u64 {
    let ok = st.creatures.hits == 1u32 && st.creatures.shoves == 0u32 && st.creatures.charges == 1u32;
    crSay(st, f, "the Minotaur charged the paint once, ran into the pillar and staggered", ok);
    print <- "  ("; print <- st.creatures.winds; print <- " wind-up(s), "; print <- st.creatures.charges; print <- " charge(s), "; print <- st.creatures.hits; print <- " stagger(s), mode ";
    print <- st.creatures.mode; print <- ")\n";
    if !ok { st.run.creaturesOk = false; }
  }
  // The bull-leap
  if k == 1320u64 {
    bullReset(&mut st.creatures, &mut st.cast, st.tick);
    st.cast.beings[vi].setDown(new Vec3(18., y, 391.), 0. - 1.5707964);
    st.creatures.mark = 0u64;
  }
  if k > 1330u64 && k < 1700u64 && st.creatures.mark == 0u64 && st.creatures.mode == BM_CHARGE && st.creatures.leaps == 0u32 {
    let d = crFlat(crYou(st), crBull(st));
    if d < 4.0 && d > 1.3 {
      pushKey(sdl.SCANCODE_SPACE, true);
      st.creatures.mark = k;
    }
  }
  if st.creatures.mark != 0u64 && k == st.creatures.mark + 3u64 { pushKey(sdl.SCANCODE_SPACE, false); }
  if st.creatures.mark != 0u64 && k == st.creatures.mark + 85u64 { crWalkOn(true); }
  if k == 1815u64 { crWalkOff(); }
  if k == 1860u64 {
    let p = crYou(st);
    let ok = st.creatures.leaps == 1u32 && st.creatures.shoves == 0u32 && p.x > 41.5;
    crSay(st, f, "the visitor was vaulted over the Minotaur, not shoved, and is in the staircase hall", ok);
    print <- "  ("; print <- st.creatures.leaps; print <- " leap(s) at frame "; print <- st.creatures.mark; print <- ", "; print <- st.creatures.shoves; print <- " shove(s); the visitor at ("; print <- p.x;
    print <- ", "; print <- p.z; print <- "))\n";
    if !ok { st.run.creaturesOk = false; }
  }
}

pub fn checkCreaturesRun(st &SimState) bool { st.run.creaturesOk }
