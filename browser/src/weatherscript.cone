// The weather's part of the scripted run: after the assembly (frame ASM_FROM +
// ASM_FRAMES) the day clock is set to noon of a fourth day and the sky, the
// light and the weather are saved from the walker's place beside the cottage,
// a window of ten frames each (the clock and the weather set at the window's
// first frame, the picture saved at its fifth).
//
//   window  what is looked at
//     0     the sky from the cottage's lawn, up and to the south, in fair weather, at noon
//     1     the same view 60 s of scene time later: the clouds have drifted east
//           (their pattern carried 420 m at the low layer's height, 660 m at the
//           cirrus's) and their shapes have changed
//    2-7    the cottage, in clear weather, fair, cloudy, overcast, rain and snow
//     8     no picture: snow set, then T pressed through SDL's queue, which sends
//           the weather to clear (checked: the target, and the blend between)
//
// Each of windows 2 to 7 has the weather set to settled (no crossfade in the
// picture) at the window's first frame, as a fresh start of that state; the
// crossfade's own numbers are checked in the browser's --checks.

pub const WX_FROM = BROOK_FROM + BROOK_WINDOW * BROOK_WINDOWS;   // after the brook's views (brookscript.cone)
pub const WX_WINDOW = 10u64;
pub const WX_WINDOWS = 9u64;
pub const WX_FRAMES = WX_WINDOW * WX_WINDOWS + 4u64;

// Noon of the fourth day (the clock's hour 84), in seconds of scene time
const WX_NOON f64 = 4620d;

mut wxOk bool = true;

fn wxWindow(f u64) u64 { (f - WX_FROM) / WX_WINDOW; }

fn wxName(w u64) &str {
  if w == 0u64 { return "weather-sky-a"; }
  if w == 1u64 { return "weather-sky-b"; }
  if w == 2u64 { return "weather-clear"; }
  if w == 3u64 { return "weather-fair"; }
  if w == 4u64 { return "weather-cloudy"; }
  if w == 5u64 { return "weather-overcast"; }
  if w == 6u64 { return "weather-rain"; }
  "weather-snow";
}

// The weather pictures saved at frame 'f', or an empty name
pub fn wxShotAt(f u64) &str {
  if (f - WX_FROM) % WX_WINDOW != 4u64 or wxWindow(f) >= 8u64 { return ""; }
  wxName(wxWindow(f));
}

pub fn wxHasView(f u64) bool { f < WX_FROM + WX_WINDOW * WX_WINDOWS; }

// The eye beside the cottage: 15 m out, 3 m to the right of the door
fn wxEye() Vec3 { ow(-10. + 3., 1.7, -24. + 15.); }

pub fn wxView(f u64) Pose {
  imm w = wxWindow(f);
  imm eye = wxEye();
  if w <= 1u64 {
    // Up 35 degrees towards the south (-z), the wind blowing the clouds across to the right
    return lookFrom(eye, eye + new Vec3(0., 0.57357645, -0.81915206) * 50.);
  }
  lookFrom(eye, ow(-10. + 0.3, 4.5, -24.));
}

// The weather's requests of the scene at frame 'f'
pub fn wxDrive(st &mut SimState, f u64) {
  if f < WX_FROM or f >= WX_FROM + WX_WINDOW * WX_WINDOWS { return; }
  imm w = wxWindow(f);
  imm k = (f - WX_FROM) % WX_WINDOW;
  if k == 0u64 {
    mut secs = WX_NOON;
    if w == 1u64 { secs = WX_NOON + 60d; }
    if w >= 2u64 { secs = WX_NOON + 120d + 2d * f64.from(w - 2u64); }
    st.scene.clock.ns = u64.from(nanosOf(secs));
    if w <= 1u64 { st.weather.setNow(WEATHER_FAIR); }
    elif w <= 7u64 { st.weather.setNow(u32.from(w - 2u64)); }
    else { st.weather.setNow(WEATHER_SNOW); }
  }
  // Two frames after T went down (wxPush), the weather has been sent to clear and is part way
  if w == 8u64 and k == 7u64 {
    imm now = st.scene.now();
    imm p = st.weather.at(now);
    print <- "Frame "; print <- f; print <- ", T pressed in snow: the weather goes to "; printStr(weatherName(st.weather.target));
    print <- ", snow "; print <- p.snow; print <- " at "; print <- now; print <- " s of scene time\n";
    if st.weather.target != WEATHER_CLEAR or !(p.snow > 0.) or !(p.snow < 1.) {
      wxOk = false;
      print <- "  the weather key is WRONG\n";
    }
  }
}

// The weather's events for frame 'f': T down and up in window 8 (called with
// the frame about to be driven)
pub fn wxPush(f u64) {
  if f == WX_FROM + 8u64 * WX_WINDOW + 2u64 { pushKey(SCANCODE_T, true); }
  if f == WX_FROM + 8u64 * WX_WINDOW + 4u64 { pushKey(SCANCODE_T, false); }
}

// Whether the weather's checks have held
pub fn checkWeatherRun() bool { wxOk; }
