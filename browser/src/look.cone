// The look: how the scene's light becomes the picture.
//
// LIGHT IN PHYSICAL UNITS. The scene keeps render's one lighting convention
// (render's renderframe.slang): the sun's colour is its irradiance in lux
// (about 100 000 at noon), the ambient light and the sky seen are radiance
// in nits (cd/m2), and a part's glow (Look.glowing) is radiance in nits.
// Colours of surfaces are albedos, 0 to 1, as before.
//
// EXPOSURE. The renderer multiplies everything it draws by the exposure as
// it draws it (pre-exposure), so the half-float frame holds numbers near 1.
// The exposure is a camera's at an EV100 (render's exposureFromEv100,
// Frostbite's), scripted from the sun's height, not adapted to the picture:
// EV 15 with the sun high (photography's sunny-16 rule), falling as the sun
// sets, to EV -1 at night. The curve between is a tuning, not a measurement
// (ev100ForSun). The sun and the moon, the ambient light and the sky seen all
// follow the day clock (skyrig.cone, over Cone's analyticdaylight package).
//
// THE POST. The renderer draws into a half-float frame (render's Post),
// which is bloomed (Jimenez's chain, 4% of a wide blur mixed in, so a glow
// spreads in proportion to its brightness) and tone-mapped by AgX (Sobotka's,
// Wrensch's fit) into the window's texture: bright light rolls off towards
// white instead of clipping, and very bright colours lose saturation.

// The Post's settings: AgX, the default bloom, no exposure of its own (the
// renderer's is applied as it draws)
pub fn lookPost(post: &mut Post) {
  post.toneMapper = TONE_MAP_AGX;
  post.bloom = 0.04;
  post.exposure = 1.;
}

// The EV100 for a sun at 'sinElevation' (the sine of its height above the
// horizon): a tuned curve through EV 15 from 30 degrees up, 14 at 10
// degrees, 12 at the horizon, 8 at -6 degrees (civil twilight's end), 4 at
// -12 and -1 from -18 down (night: the moon's light and the ambient floor
// then show dark but walkable), straight between
pub fn ev100ForSun(sinElevation: f32) f32 {
  let keys: Array[f32, 6] = [-0.309, -0.208, -0.105, 0., 0.174, 0.5];
  let evs: Array[f32, 6] = [-1., 4., 8., 12., 14., 15.];
  if sinElevation <= keys[0] { return evs[0]; }
  var i = 1usize;
  while i < 6usize {
    if sinElevation <= keys[i] {
      let t = (sinElevation - keys[i - 1usize]) / (keys[i] - keys[i - 1usize]);
      return evs[i - 1usize] + (evs[i] - evs[i - 1usize]) * t;
    }
    i = i + 1usize;
  }
  evs[5]
}

// How many stops brighter than the meter the picture is exposed: AgX rolls
// a sunlit white off to about 0.55 of the display's white, so half a stop
// up keeps the rooks' cream from going grey, at the cost of mid-tones a
// little lighter than they were drawn clamped
pub const EXPOSURE_COMPENSATION: f32 = 0.5;

// The renderer's exposure under 'sky': from its sun's height
pub fn exposureFor(sky: &SkyLook) f32 {
  exposureForElevation(sky.sunDirection.normalize().y)
}

// The renderer's exposure for a sun whose sine of height is 'sinElevation':
// the sun's, not the light's (at night the light is the moon, whose height
// must not move the exposure)
pub fn exposureForElevation(sinElevation: f32) f32 {
  exposureFromEv100(ev100ForSun(sinElevation) - EXPOSURE_COMPENSATION)
}

// AUTO-EXPOSURE, UNDER THE DAY'S. The renderer's exposure above is the day clock's (and the weather opens
// it by its stops): it makes the day's brightness, and the night dark. Render's auto-exposure meters the
// frame and moves the tone map's exposure on top of that so that the frame's average is a middle grey:
// left alone it would lift a night to a dusk. So its target is the day's own: 'autoExposureTrim' is the
// stops by which the metered average at this hour stands from a middle grey with the day's exposure alone
// (measured from the scripted views, PEGASUS_DBG=meter), added to what it finds, so it holds the scripted
// look where the view is the typical one and follows only what the view holds (a sky, a dark room), within
// a narrow band. Its trim is a smooth function of the sun's height, as the day's exposure is, and the
// adaptation is slow, so nothing pumps at dusk.
pub const AUTO_EXPOSURE_MIN: f32 = -1.5;
pub const AUTO_EXPOSURE_MAX: f32 = 0.75;

// The stops the metered average stands below a middle grey, with the day's exposure alone, by the sun's
// sine of height: measured over the scripted views (their mean log2 luminance, less log2 0.18 = -2.47):
// about 0 in daylight, -0.3 as the sun touches the horizon, -2.2 at dusk, -2.7 in the dark. Under a dull
// sky the weather has opened the exposure by 'weatherEv' stops, and the metered average is up about 0.4 of that.
pub fn autoExposureTrim(sinElevation: f32, weatherEv: f32) f32 {
  let keys: Array[f32, 7] = [-0.309, -0.208, -0.105, -0.03, 0.04, 0.17, 0.5];
  let trims: Array[f32, 7] = [-2.7, -2.6, -2.2, -1., -0.3, -0.1, -0.1];
  var t = trims[6];
  if sinElevation <= keys[0] {
    t = trims[0];
  } else {
    var i = 1usize;
    while i < 7usize {
      if sinElevation <= keys[i] {
        let u = (sinElevation - keys[i - 1usize]) / (keys[i] - keys[i - 1usize]);
        t = trims[i - 1usize] + (trims[i] - trims[i - 1usize]) * u;
        break;
      }
      i = i + 1usize;
    }
  }
  t + 0.4 * weatherEv
}
