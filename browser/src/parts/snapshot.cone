// What the scene publishes each frame for drawing: a plain struct, handed
// over whole. It holds what the render system needs from the scene and
// nothing it would have to walk or ask back for: every placed part's world
// matrix (already composed down the placement tree), the scene's time and
// the day clock's reading, and the eye the picture is drawn from (the
// possessed being's, at the last two fixed steps, to draw between).
//
// Today the browser keeps one and passes it from the publish phase to the
// draw phase. When the scene and render are actors, the scene moves the
// snapshot to render each frame (and render moves the last one back, so its
// lists are reused, as Scene.publish already does with the one it is given).

pub struct Snapshot {
  pub now f64;                // the scene's time, seconds
  pub hour f64;               // the day clock's reading
  pub eyeFrom Pose;           // the possessed being's eyes at the step before the last
  pub eyeTo Pose;             // and at the last
  pub worlds Table[Mat4];     // each placed part's world matrix

  pub fn empty() Snapshot {
    imm still = Pose.look(new Vec3(0., 0., 0.), 0., 0.);
    new Snapshot(0d, START_HOUR, still, still, Table[Mat4].empty());
  }

  // Part 'id''s world matrix; the identity if it has no placement
  pub fn worldOf(self &, id PartId) Mat4 {
    imm row = worlds.find(id);
    if row == NO_ROW { return Mat4.identity(); }
    *worlds.rows[row];
  }

  // The eye 'alpha' of the way from the step before the last to the last
  pub fn eye(self &, alpha f32) Pose {
    new Pose(eyeFrom.origin + (eyeTo.origin - eyeFrom.origin) * alpha, eyeFrom.orientation.slerp(eyeTo.orientation, alpha));
  }
}
