// What the scene publishes each frame for drawing: a plain struct, handed
// over whole. It holds what the render system needs from the scene and
// nothing it would have to walk or ask back for: every placed part's world
// matrix (already composed down the placement tree), the scene's time and
// the day clock's reading, the eye the picture is drawn from (the possessed
// being's, at the last two fixed steps, to draw between, or a scripted
// close-up's), and the birds, as the simulation left them.
//
// The scene actor moves it to the render actor each frame, in the draw
// message, and the render actor moves it back once the frame is presented,
// so its lists are reused (Scene.publish makes the next one in the one it is
// given). One holds the lists: while render draws from it, the scene's place
// for it holds an empty one.

pub struct Snapshot {
  pub now: f64;                // the scene's time, seconds
  pub hour: f64;               // the day clock's reading
  pub eyeFrom: Pose;           // the possessed being's eyes at the step before the last
  pub eyeTo: Pose;             // and at the last
  pub worlds: Table[Mat4];     // each placed part's world matrix
  pub birds: List[BirdFrame];  // each bird, at the last two steps of the flock
  pub fixedView: bool;         // drawn from 'view' through 'fov', not from the eyes (a scripted close-up)
  pub view: Pose;
  pub fov: f32;                // the vertical field of view, radians
  pub weather: Weathering;     // the weather, a closed form of 'now'
  pub splats: List[SplatDraw]; // the playground's paint on surfaces, as decals to draw this frame (playview.cone)
  pub glassOpen: bool;         // the looking-glass has opened: a glass surface is a portal (portal.cone, viewsurface.cone)
  pub thread: List[ThreadSeg]; // Ariadne's threads, as the segments to draw (portalview.cone)
  pub bits: List[BitDraw];     // the Worm's spheres, the Minotaur's stars when it is dazed (creatureview.cone)
  pub feetFrom: Pose;          // where the possessed being's feet stand (the ground point) and which way it is turned, at the step before the last
  pub feetTo: Pose;            // and at the last: what a headset's head is placed on (--xr: renderactor.cone's xrEye)

  pub fn empty() Snapshot {
    let still = Pose.look(Vec3(0., 0., 0.), 0., 0.);
    Snapshot(0.0, START_HOUR, still, still, Table[Mat4].empty(), List[BirdFrame].empty(), false, still, 1.0471976,
      Weathering.fair(), List[SplatDraw].empty(), false, List[ThreadSeg].empty(), List[BitDraw].empty(), still, still)
  }

  // Part 'id''s world matrix; the identity if it has no placement
  pub fn worldOf(self: &, id: PartId) Mat4 {
    let row = worlds.find(id);
    if row == NO_ROW { return Mat4.identity(); }
    *worlds.rows[row]
  }

  // The eye 'alpha' of the way from the step before the last to the last,
  // or the close-up's
  pub fn eye(self: &, alpha: f32) Pose {
    if fixedView { return view; }
    Pose(eyeFrom.origin + (eyeTo.origin - eyeFrom.origin) * alpha, eyeFrom.orientation.slerp(eyeTo.orientation, alpha))
  }

  // The being's feet 'alpha' of the way from the step before the last to the last: the ground point and its heading. The one
  // thing under a headset's head that is smoothed (the head's own motion never is).
  pub fn feet(self: &, alpha: f32) Pose {
    Pose(feetFrom.origin + (feetTo.origin - feetFrom.origin) * alpha, feetFrom.orientation.slerp(feetTo.orientation, alpha))
  }
}

// A sphere to draw this frame: where and how big (the model), its colour, and whether it gives off light (creatureview.cone: the
// Worm's body, the stars about a dazed Minotaur)
pub struct BitDraw {
  pub model: Mat4;
  pub tint: Color;
  pub glow: bool;
}

// A stretch of Ariadne's thread to draw: from 'a' to 'b', in 'tint' (radiance, nits)
pub struct ThreadSeg {
  pub a: Vec3;
  pub b: Vec3;
  pub tint: Color;
}

// A splat of paint as a decal of this frame: the box that places it (its up away from the surface), its colour, and how much of
// it shows (it fades out over its last seconds)
pub struct SplatDraw {
  pub model: Mat4;
  pub tint: Color;
  pub fade: f32;
}

// A bird as the snapshot carries it: where it was and its wings' phase at
// the flock's step before the last, and its pose at the last (boidflock's
// BirdPose, the parts the drawing reads)
pub struct BirdFrame {
  pub before: Vec3;
  pub phaseBefore: f32;
  pub position: Vec3;
  pub forward: Vec3;
  pub up: Vec3;
  pub right: Vec3;
  pub phase: f32;              // the wings' phase, radians
  pub amp: f32;                // and their amplitude, 0 to 1
}
