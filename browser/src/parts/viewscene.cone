// The view's scene: what the view half of the browser keeps of the parts so it
// can draw and pick, apart from the simulation's Scene (parts.cone).
//
// The simulation owns the registry (it reserves every id and decides whether a
// request is live), the timers, areas, platforms and clock. The view is told,
// in order, the requests the simulation accepted, and applies the ones that
// concern what it keeps: which parts are live and their names (for people),
// and the placement tree, from which it publishes each frame's snapshot for
// drawing. It checks nothing the simulation has not; a request it is sent has
// already been found to name a live part.
//
// This is the same placement code (placement.cone) the simulation runs for its
// platforms and areas: two copies of the tree, each fed the same requests, as
// the shared-island note says (the view applies the server world's requests as
// it applies the local world's).

pub struct ViewScene {
  placements: Placements;
  names: Table[String];        // the live parts, by id: their names
  pub applied: u64;            // requests applied
  pub refused: u64;            // and refused (naming a part this side does not hold)
  platforms: Table[PlatformRow]; // the parts that are platforms: the view's own bodies stand on them

  pub fn empty() ViewScene {
    new ViewScene(Placements.empty(), Table[String].empty(), 0u64, 0u64, Table[PlatformRow].empty())
  }

  // Part 'id' is a platform of this shape (the floor a body stands on and is carried by)
  pub fn applyPlatform(self: &mut, id: PartId, shape: PlatformShape) bool {
    if !self.isLive(id) { refused = refused + 1u64; return false; }
    platforms.put(id, new PlatformRow(shape, Mat4.identity(), false));
    applied = applied + 1u64;
    true
  }

  // How each platform moved since the frame before (as Scene.platformMoves)
  pub fn platformMoves(self: &mut, out: &mut List[PlatformMove]) {
    out.clear();
    var i = 0usize;
    while i < platforms.len() {
      let id = *platforms.ids[i];
      let row = *platforms.rows[i];
      let now = placements.worldOf(id);
      if row.seen && !sameMatrix(&row.world, &now) { out.push(new PlatformMove(id, row.world, now)); }
      if !row.seen || !sameMatrix(&row.world, &now) { platforms.rows.set(i, new PlatformRow(row.shape, now, true)); }
      i = i + 1usize;
    }
  }

  // The platforms as they stand now (as Scene.platformsNow)
  pub fn platformsNow(self: &, out: &mut List[PlatformNow]) {
    out.clear();
    var i = 0usize;
    while i < platforms.len() {
      let id = *platforms.ids[i];
      let world = placements.worldOf(id);
      out.push(new PlatformNow(id, world, world.inverse(), platforms.rows[i].shape));
      i = i + 1usize;
    }
  }

  // Whether part 'id' is live here (spawned, not despawned)
  pub fn isLive(self: &, id: PartId) bool { names.find(id) != NO_ROW }

  // Part 'id''s name, for people; empty if it is gone
  pub fn nameOf(self: &, id: PartId) String {
    let row = names.find(id);
    if row == NO_ROW { return String.empty(); }
    names.rows[row].copy()
  }

  // How many parts are live
  pub fn partCount(self: &) usize { names.len() }

  // Every live part's id, appended to 'out' (the switch to a server despawns each in render)
  pub fn liveIds(self: &, out: &mut List[PartId]) {
    var i = 0usize;
    while i < names.ids.len() {
      out.push(*names.ids[i]);
      i = i + 1usize;
    }
  }

  // Whether part 'id' has a placement
  pub fn isPlaced(self: &, id: PartId) bool { placements.find(id) != NO_ROW }

  // Part 'id''s world matrix as last propagated; the identity if it has none
  pub fn worldMatrix(self: &, id: PartId) Mat4 { placements.worldOf(id) }

  pub fn applySpawn(self: &mut, id: PartId, name: String) {
    names.put(id, name);
    applied = applied + 1u64;
  }

  pub fn applyPlace(self: &mut, id: PartId, at: Transform3) bool {
    if !self.isLive(id) { refused = refused + 1u64; return false; }
    placements.place(id, at);
    applied = applied + 1u64;
    true
  }

  pub fn applyParent(self: &mut, id: PartId, parent: PartId) bool {
    if !self.isLive(id) || !(parent.isNone() || self.isLive(parent)) {
      refused = refused + 1u64;
      return false;
    }
    if !placements.setParent(id, parent) { refused = refused + 1u64; return false; }
    applied = applied + 1u64;
    true
  }

  // The part and its whole subtree gone. The ids that go are put in 'gone'
  // (the part itself first), for the picking system and render to drop theirs.
  pub fn applyDespawn(self: &mut, id: PartId, gone: &mut List[PartId]) bool {
    if !self.isLive(id) { refused = refused + 1u64; return false; }
    gone.push(id);
    placements.removeSubtree(id, gone);
    var i = 0usize;
    while i < gone.len() {
      names.remove(*gone[i]);
      platforms.remove(*gone[i]);
      i = i + 1usize;
    }
    applied = applied + 1u64;
    true
  }

  // Every world matrix brought up to date, in one pass over what changed
  pub fn propagate(self: &mut) { placements.propagate(); }

  // The frame's snapshot, made in 'recycled' (the last one, handed back so
  // its lists are reused): every placed part's world matrix as last
  // propagated, the scene's time 'now' and the day clock's reading, and the
  // eye between 'eyeFrom' and 'eyeTo' (the simulation's, as it sent them)
  pub fn publish(self: &, recycled: Snapshot, now: f64, hour: f64, eyeFrom: Pose, eyeTo: Pose) Snapshot {
    var s = recycled;
    s.worlds.clear();
    var i = 0usize;
    while i < placements.ids.len() {
      s.worlds.put(*placements.ids[i], *placements.world[i]);
      i = i + 1usize;
    }
    s.now = now;
    s.hour = hour;
    s.eyeFrom = eyeFrom;
    s.eyeTo = eyeTo;
    s
  }
}
