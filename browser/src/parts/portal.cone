// The portal: how the island's looking-glass opens onto the labyrinth, where the labyrinth sits, and how a being crosses.
//
// WHERE (the shared contract of the labyrinth lanes). The labyrinth is in the same scene, far beneath the island: the
// antechamber's floor at y = LAB_FLOOR. Its entry point E is (0, LAB_FLOOR, 300), on the antechamber's south wall, facing +z.
// The looking-glass on the cottage's back wall lands a being at the mouth of a short corridor, MOUTH_Z, that runs +z to E (a
// doorway 1 m wide in the antechamber's south wall at E, which labrooms.cone keeps: its entrance corridor, x -1.5 to 1.5, z 285 to
// 299, is built there with the rest of the rooms).
//
// WHAT THE ROOMS MUST KEEP. An item's world (island or labyrinth) is told by the height of the middle of its mesh's bounds where it is
// placed (rendersys.cone): a part of the labyrinth must have it under UNDER_Y, whether the part sits at y = -300 or its mesh is modelled
// there. Its floors and walls are solids (bakedworld/labrooms.cone, collision.cone's allSolids). Lights: the labyrinth is lit by its own
// lamps alone (renderactor.cone: no sun under UNDER_Y), so a room's light is a lamp or a LightSource part.
//
// THE PORTAL IS A TRANSLATION. The glass (viewsurface.cone, the cottage's pane) and the corridor's mouth are two panes with
// opposite normals; a being that goes through the one comes out of the other, moved by a translation ('glassToMouth', its
// height the cottage's ground): its heading is kept, since both faces look along z. A rotation would need the rest of the
// machinery in viewsurface.cone and being.cone made general; none is needed for this.
//
// CROSSING is decided where the bodies are stepped (being.cone), by the eye's move across a gate's plane inside its opening: the
// gates are the same in the simulation and in a view's prediction, so both cross at the same step and nothing is corrected. A gate
// needs a hole in the world to be reached: the cottage's back wall has none, so while the glass is open its solid is notched
// (physics.cone 'setGlassOpen') where the pane is.
//
// THE LOOP. The corridor that will not end has a gate at its far end that sends a being back by a whole number of the corridor's
// bays (a corridor whose bays are alike looks the same from either place, so the move cannot be seen) if it goes through facing
// forward; one that goes through backwards (walking backwards, its heading the way it came) is let through to the court. The
// picture of what lies past the gate is the corridor's own geometry, which repeats.

// The kinds of view surface (the look's fourth parameter; viewsurface.cone)
pub const SURFACE_MIRROR = 0u32;
pub const SURFACE_PORTAL = 1u32;
// A looking-glass: a mirror until the portal it is the near side of has opened (the view says: 'open'), then a portal
pub const SURFACE_GLASS = 2u32;

// The world a surface's picture shows when it is a portal (the look's last parameter)
pub const DEST_DAY = 0u32;
pub const DEST_UNDER = 1u32;

// The layer bit of what is in the labyrinth (an item's layer is chosen by its height: the island's are render's default, 1): a picture of
// the labyrinth draws these alone, one of the island those alone, so neither draws what the other holds (viewsurface.cone, rendersys.cone)
pub const LAB_LAYER = 4u32;

// Below this a being is in the labyrinth (the island's lowest ground is far above it)
pub const UNDER_Y f32 = -150.;

// (the one test of the labyrinth: its light and exposure, LAB_EV and labAmbient(), are in bakedworld/labyrinth.cone)
pub fn underground(y f32) bool { y < UNDER_Y }

// How far the camera sees under the island and over it, metres (under, the island's terrain is 300 m overhead, and nothing there is
// wanted)
pub const UNDER_FAR f32 = 120.;
pub const DAY_FAR f32 = 6000.;

// ---- Where ----

pub const LAB_FLOOR f32 = -300.;
// E, the entry point, and the mouth of the corridor to it
pub const E_X f32 = 0.;
pub const E_Z f32 = 300.;
pub const MOUTH_Z f32 = 291.;
// The corridor's half width and height, and the dead end behind the mouth (the camera of a being just through sits there)
pub const CORR_HALF f32 = 0.5;
pub const CORR_HEIGHT f32 = 2.5;
pub const TAIL_Z f32 = 286.;

// The cottage's pane: the plane it lies in (its back wall at z = 324, less the pane's stand-off), the middle of its width, and the
// opening's size: it spans 0.55 to 2.25 m above the cottage's ground and 1 m across
pub const GLASS_Z f32 = 323.966;
pub const GLASS_X f32 = -14.5;
pub const PANE_HALF f32 = 0.5;
pub const PANE_LOW f32 = 0.55;
pub const PANE_HIGH f32 = 2.25;
// The cottage's root: the middle of its front wall (cottage.cone's frame), where its ground height is taken
pub const COTTAGE_X f32 = -16.;
pub const COTTAGE_Z f32 = 330.;

// The corridor that will not end: the rooms' corridor between the hall and the court (bakedworld/labrooms.cone), which runs +z at
// x = LOOP_X from its start LOOP_Z0 to its end LOOP_Z1, 3.2 m wide and LOOP_HEIGHT high, in bays LOOP_BAY long (a column pair and a
// hanging lamp each, so every bay is alike). The gate is LOOP_GATE_Z, between a lamp and a column pair, and a being through it facing
// forward is moved back LOOP_BACK, two bays
pub const LOOP_X f32 = 8.;
pub const LOOP_Z0 f32 = 342.;
pub const LOOP_Z1 f32 = 372.;
pub const LOOP_BAY f32 = 6.;
pub const LOOP_GATE_Z f32 = 359.5;
pub const LOOP_BACK f32 = 12.;
pub const LOOP_HALF f32 = 1.6;
pub const LOOP_HEIGHT f32 = 3.4;

// The exit: the doorway at the top of the grand staircase, in the wall z = EXIT_Z, 4 m wide (EXIT_HALF each side of EXIT_X), its sill
// EXIT_UP above the labyrinth's floor and EXIT_HIGH over the sill. A being through it comes out on the island at the brook's spring
// (SPRING_X, SPRING_Z: the first control point of island/brook.cone, checked in portalchecks.cone), moved by a translation like the
// others (so it faces +z, 28 degrees off the rill's first run, down the hill). The exit is one way: nothing on the island leads back
pub const EXIT_X f32 = 67.;
pub const EXIT_Z f32 = 430.5;
pub const EXIT_HALF f32 = 2.;
pub const EXIT_UP f32 = 11.2;
pub const EXIT_HIGH f32 = 3.4;
pub const SPRING_X f32 = 34.;
pub const SPRING_Z f32 = 128.;

// The notch cut in the cottage's back wall's solid while the glass is open: the pane's width and a little over, this deep
pub const NOTCH_HALF f32 = 0.55;
pub const NOTCH_DEPTH f32 = 1.;

// What a gate does with a being that crosses it
pub const GATE_PLAIN = 0u32;
pub const GATE_LOOP = 1u32;     // a being facing forward through it is moved back; one walking backwards is let through
pub const NO_GATE = 0xffffffffu32;

// A gate: the plane z = 'z' crossed along 'dir' (+1 or -1) by an eye inside x0..x1 and y0..y1, which moves the being by 'shift'
pub struct Gate {
  pub z f32;
  pub dir f32;
  pub x0 f32;
  pub x1 f32;
  pub y0 f32;
  pub y1 f32;
  pub shift Vec3;
  pub rule u32;
  pub needsOpen bool;            // only while the looking-glass is open
}

// The translation from the cottage's pane to the corridor's mouth: its height from the cottage's ground 'ground' to the labyrinth's floor
pub fn glassToMouth(ground f32) Vec3 { new Vec3(E_X - GLASS_X, LAB_FLOOR - ground, MOUTH_Z - GLASS_Z) }

// The translation from the exit doorway to the spring: the sill's height to the ground at the spring, 'spring'
pub fn exitToSpring(spring f32) Vec3 { new Vec3(SPRING_X - EXIT_X, spring - (LAB_FLOOR + EXIT_UP), SPRING_Z - EXIT_Z) }

// The gates by their place in 'Portals.gates' (the beings note which they went through)
pub const GATE_GLASS = 0u32;
pub const GATE_MOUTH = 1u32;
pub const GATE_LOOPING = 2u32;
pub const GATE_EXIT = 3u32;

// The gates of the world, the glass's state, and the cottage's ground and the spring's they were made for
pub struct Portals {
  pub gates List[Gate];
  pub open bool = false;
  pub ground f32 = 0.;
  pub spring f32 = 0.;

  // The gates for a cottage whose ground is at height 'ground', and a spring whose ground is at 'spring'
  pub fn make(ground f32, spring f32) Portals {
    var gates = List[Gate].empty();
    let t = glassToMouth(ground);
    // Through the pane into the corridor, and back out of its mouth
    gates.push(new Gate(GLASS_Z, 1., GLASS_X - PANE_HALF, GLASS_X + PANE_HALF, ground + PANE_LOW, ground + PANE_HIGH, t, GATE_PLAIN, true));
    gates.push(new Gate(MOUTH_Z, -1., E_X - PANE_HALF, E_X + PANE_HALF, LAB_FLOOR + PANE_LOW, LAB_FLOOR + PANE_HIGH,
      new Vec3(0. - t.x, 0. - t.y, 0. - t.z), GATE_PLAIN, true));
    // The corridor that will not end
    gates.push(new Gate(LOOP_GATE_Z, 1., LOOP_X - LOOP_HALF, LOOP_X + LOOP_HALF, LAB_FLOOR, LAB_FLOOR + LOOP_HEIGHT,
      new Vec3(0., 0., 0. - LOOP_BACK), GATE_LOOP, false));
    // The exit: up the stairs and through the doorway to the spring
    gates.push(new Gate(EXIT_Z, 1., EXIT_X - EXIT_HALF, EXIT_X + EXIT_HALF, LAB_FLOOR + EXIT_UP + PANE_LOW, LAB_FLOOR + EXIT_UP + EXIT_HIGH,
      exitToSpring(spring), GATE_PLAIN, false));
    new Portals(gates, false, ground, spring)
  }

  pub fn none() Portals { Portals.make(0., 0.) }

  // The gate that an eye going from 'was' to 'now' (world points) crosses, facing 'yaw' (0 faces -z), or NO_GATE
  pub fn crossing(self &, was Vec3, now Vec3, yaw f32) u32 {
    var i = 0usize;
    while i < gates.len() {
      let g = gates[i];
      if !g.needsOpen or open {
        let s0 = (was.z - g.z) * g.dir;
        let s1 = (now.z - g.z) * g.dir;
        if s0 <= 0. and s1 > 0. {
          let t = s0 / (s0 - s1);
          let x = was.x + (now.x - was.x) * t;
          let y = was.y + (now.y - was.y) * t;
          if x >= g.x0 and x <= g.x1 and y >= g.y0 and y <= g.y1 {
            // A loop sends only a being moving forward as it faces; one that moves backwards goes through
            if g.rule == GATE_LOOP {
              let fx = 0. - sin(yaw);
              let fz = 0. - cos(yaw);
              if (now.x - was.x) * fx + (now.z - was.z) * fz >= 0. { return u32.from(i); }
            } else {
              return u32.from(i);
            }
          }
        }
      }
      i = i + 1usize;
    }
    NO_GATE
  }
}
