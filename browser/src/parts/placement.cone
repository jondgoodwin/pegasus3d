// The placement tree: where each part is, relative to its parent.
//
// Flat arrays, one row per placed part: its id, its local placement (in its
// parent's frame), its parent's row, its world matrix and whether it
// changed. ROWS ARE KEPT PARENTS BEFORE CHILDREN, so world matrices are
// brought up to date in one linear pass over the rows from the first that
// changed: a row is recomputed (world = parent's world x local) when it was
// placed again or its parent was recomputed earlier in the same pass. Rows
// before the first change are not touched.
//
// The order is kept by the two operations that could break it. A part put
// under a parent that comes after it in the rows has its subtree moved to
// the end (after every other row, its parent's included), in the order it
// had. A part removed takes its subtree with it, and the rows after close
// up, in order. Both are linear in the rows, and rare next to Place, which
// is O(1) and only marks the row.
//
// A part named by a Parent request before it was ever placed is placed at
// its parent's origin (the identity).

pub const NO_PARENT = 0xFFFFFFFFu;

pub struct Placements {
  ids List[PartId];
  local List[Transform3];
  parent List[u32];           // the parent's row, or NO_PARENT
  world List[Mat4];
  dirty List[bool];           // placed since the last pass (during a pass: recomputed in it)
  index List[u32];            // a slot's row plus one; 0 where it has none
  firstDirty usize;           // no row before this one has changed; the row count when none has
  pub recomputed u64;         // world matrices recomputed, ever

  pub fn empty() Placements {
    new Placements(List[PartId].empty(), List[Transform3].empty(), List[u32].empty(), List[Mat4].empty(),
      List[bool].empty(), List[u32].empty(), 0usize, 0u64);
  }

  pub fn len(self &) usize { ids.len(); }

  // The row of part 'id', or NO_ROW
  pub fn find(self &, id PartId) usize {
    imm s = usize.from(id.slot());
    if s >= index.len() { return NO_ROW; }
    imm r = *index[s];
    if r == 0u32 { return NO_ROW; }
    imm row = usize.from(r - 1u32);
    if !(*ids[row] == id) { return NO_ROW; }
    row;
  }

  // Part 'id''s world matrix as last propagated; the identity if it has no row
  pub fn worldOf(self &, id PartId) Mat4 {
    imm row = self.find(id);
    if row == NO_ROW { return Mat4.identity(); }
    *world[row];
  }

  // Part 'id''s parent, or none
  pub fn parentOf(self &, id PartId) PartId {
    imm row = self.find(id);
    if row == NO_ROW { return PartId.none(); }
    imm p = *parent[row];
    if p == NO_PARENT { return PartId.none(); }
    *ids[usize.from(p)];
  }

  fn markDirty(self &mut, row usize) {
    dirty.set(row, true);
    if row < firstDirty { firstDirty = row; }
  }

  // A new row for part 'id', at the end, with no parent
  fn append(self &mut, id PartId, at Transform3) usize {
    imm row = ids.len();
    ids.push(id);
    local.push(at);
    parent.push(NO_PARENT);
    world.push(at.toMat4());
    dirty.push(true);
    imm s = usize.from(id.slot());
    while index.len() <= s { index.push(0u32); }
    index.set(s, u32.from(row) + 1u32);
    if row < firstDirty { firstDirty = row; }
    row;
  }

  // Part 'id' placed at 'at' in its parent's frame
  pub fn place(self &mut, id PartId, at Transform3) {
    imm row = self.find(id);
    if row == NO_ROW {
      self.append(id, at);
      return;
    }
    local.set(row, at);
    self.markDirty(row);
  }

  // Whether row 'r' is row 'top' or below it
  fn isUnder(self &, r usize, top usize) bool {
    mut at = r;
    while at != top {
      imm p = *parent[at];
      if p == NO_PARENT { return false; }
      at = usize.from(p);
    }
    true;
  }

  // Part 'id' put under 'p' (none: no parent), keeping its own placement.
  // False if 'p' is 'id' or below it.
  pub fn setParent(self &mut, id PartId, p PartId) bool {
    mut row = self.find(id);
    if row == NO_ROW { row = self.append(id, Transform3.identity()); }
    if p.isNone() {
      parent.set(row, NO_PARENT);
      self.markDirty(row);
      return true;
    }
    mut prow = self.find(p);
    if prow == NO_ROW { prow = self.append(p, Transform3.identity()); }
    if self.isUnder(prow, row) { return false; }
    if prow > row {
      // The parent comes after: the subtree goes to the end, after it
      mut order = List[u32].withCapacity(ids.len());
      mut moved = List[u32].empty();
      mut inSub = List[bool].withCapacity(ids.len());
      mut i = 0usize;
      while i < ids.len() {
        mut sub = i == row;
        if !sub and i > row {
          imm q = *parent[i];
          sub = q != NO_PARENT and *inSub[usize.from(q)];
        }
        inSub.push(sub);
        if sub { moved.push(u32.from(i)); } else { order.push(u32.from(i)); }
        i = i + 1usize;
      }
      i = 0usize;
      while i < moved.len() { order.push(*moved[i]); i = i + 1usize; }
      self.reorder(&order, row);
      row = self.find(id);
      prow = self.find(p);
    }
    parent.set(row, u32.from(prow));
    self.markDirty(row);
    true;
  }

  // Part 'id''s row taken away with every row below it; the ids below it
  // (not 'id' itself) pushed onto 'gone'. The rows after close up in order.
  pub fn removeSubtree(self &mut, id PartId, gone &mut List[PartId]) {
    imm row = self.find(id);
    if row == NO_ROW { return; }
    mut order = List[u32].withCapacity(ids.len());
    mut inSub = List[bool].withCapacity(ids.len());
    mut i = 0usize;
    while i < ids.len() {
      mut sub = i == row;
      if !sub and i > row {
        imm q = *parent[i];
        sub = q != NO_PARENT and *inSub[usize.from(q)];
      }
      inSub.push(sub);
      if sub {
        if i != row { gone.push(*ids[i]); }
        imm s = usize.from((*ids[i]).slot());
        index.set(s, 0u32);
      } else {
        order.push(u32.from(i));
      }
      i = i + 1usize;
    }
    self.reorder(&order, row);
  }

  // The rows rebuilt in 'order' (old rows; any left out are dropped),
  // parents remapped; every row from 'from' on may have moved
  fn reorder(self &mut, order &List[u32], from usize) {
    imm n = ids.len();
    mut newRow = List[u32].withCapacity(n);
    mut i = 0usize;
    while i < n { newRow.push(NO_PARENT); i = i + 1usize; }
    i = 0usize;
    while i < order.len() { newRow.set(usize.from(*order[i]), u32.from(i)); i = i + 1usize; }
    mut nIds = List[PartId].withCapacity(order.len());
    mut nLocal = List[Transform3].withCapacity(order.len());
    mut nParent = List[u32].withCapacity(order.len());
    mut nWorld = List[Mat4].withCapacity(order.len());
    mut nDirty = List[bool].withCapacity(order.len());
    i = 0usize;
    while i < order.len() {
      imm old = usize.from(*order[i]);
      nIds.push(*ids[old]);
      nLocal.push(*local[old]);
      imm p = *parent[old];
      nParent.push(if p == NO_PARENT { NO_PARENT; } else { *newRow[usize.from(p)]; });
      nWorld.push(*world[old]);
      nDirty.push(*dirty[old]);
      index.set(usize.from((*ids[old]).slot()), u32.from(i) + 1u32);
      i = i + 1usize;
    }
    ids <=> nIds;
    local <=> nLocal;
    parent <=> nParent;
    world <=> nWorld;
    dirty <=> nDirty;
    if from < firstDirty { firstDirty = from; }
    if firstDirty > ids.len() { firstDirty = ids.len(); }
  }

  // Every world matrix brought up to date: one pass from the first row that
  // changed, a row recomputed if it was placed again or its parent was
  // recomputed in this pass (parents come first, so theirs is done); then
  // the marks cleared
  pub fn propagate(self &mut) {
    imm n = ids.len();
    if firstDirty >= n { firstDirty = n; return; }
    mut i = firstDirty;
    while i < n {
      imm p = *parent[i];
      mut changed = *dirty[i];
      if !changed and p != NO_PARENT { changed = *dirty[usize.from(p)]; }
      if changed {
        imm own = (*local[i]).toMat4();
        world.set(i, if p == NO_PARENT { own; } else { *world[usize.from(p)] * own; });
        dirty.set(i, true);
        recomputed = recomputed + 1u64;
      }
      i = i + 1usize;
    }
    i = firstDirty;
    while i < n { dirty.set(i, false); i = i + 1usize; }
    firstDirty = n;
  }
}
