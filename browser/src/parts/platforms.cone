// Platforms: a part a being can stand on and be carried by.
//
// A PLATFORM is an aspect of a part, as an area is: a Platform request names
// the part and its shape, in the part's own frame, so it moves with the part
// and its parents (a balloon's basket under its envelope, a lift's car, a
// raft). The shape is a level floor (a rectangle at a height) and walls on
// any of the rectangle's four edges, standing from the floor to a height.
// The part may be turned about its up axis and scaled alike in every
// direction; a floor tilted by its part is not supported (it is taken as
// level), since nothing tilts one yet.
//
// The scene keeps each platform's world matrix as the last frame left it,
// so that, once the placements are propagated, it can say how each platform
// moved since: the bodies standing on it are carried by that move (the
// physics does the carrying, in the scene actor: support.cone). The scene
// does no physics itself: it only knows where its platforms are and how they
// moved.

// Which of the floor's edges has a wall: the edge at the least x, the most
// x, the least z, the most z (in the part's frame)
pub const WALL_MIN_X = 1u32;
pub const WALL_MAX_X = 2u32;
pub const WALL_MIN_Z = 4u32;
pub const WALL_MAX_Z = 8u32;

// A platform's shape, in its part's frame: the floor's top at 'floorY', over
// x from 'min.x' to 'max.x' and z from 'min.y' to 'max.y'; walls 'wallHeight'
// above it on the edges 'walls' names (WALL_ flags). A wall is the face a
// body inside meets: its thickness is the part's mesh's business.
pub struct PlatformShape {
  pub floorY f32;
  pub min Vec2;
  pub max Vec2;
  pub wallHeight f32;
  pub walls u32;

  pub fn make(floorY f32, min Vec2, max Vec2, wallHeight f32, walls u32) PlatformShape {
    new PlatformShape(floorY, min, max, wallHeight, walls);
  }

  // Whether (x, z), in the part's frame, is over the floor
  pub fn over(self &, x f32, z f32) bool { x >= min.x and x <= max.x and z >= min.y and z <= max.y; }
}

// A platform's row: its shape, its world matrix when last seen (after the
// last frame's propagation), and whether it has been seen yet
pub struct PlatformRow {
  pub shape PlatformShape;
  pub world Mat4;
  pub seen bool;
}

// A platform as it stands now: its part, its world matrix and the inverse,
// and its shape
pub struct PlatformNow {
  pub id PartId;
  pub world Mat4;
  pub inverse Mat4;
  pub shape PlatformShape;
}

// How a platform moved since the frame before: from 'from' to 'to' (its
// world matrices)
pub struct PlatformMove {
  pub id PartId;
  pub from Mat4;
  pub to Mat4;
}

// Whether two matrices are the same, every cell
pub fn sameMatrix(a &Mat4, b &Mat4) bool {
  mut i = 0usize;
  while i < 16usize {
    if a.m[i] != b.m[i] { return false; }
    i = i + 1usize;
  }
  true;
}

// ---- Solids: static things a body stands on or is stopped by ----
//
// A SOLID is a vertical prism over a shape in the ground plane (a circle or
// an axis-aligned rectangle), standing from 'y0' to 'y1' in the world. It
// never moves and is not a part. Its top is a floor a body can step onto
// when the top is no higher than a step above its feet (a low rock, a stair
// tread, a porch deck); its sides stop a capsule when the top is higher than
// that (a tree trunk, a house wall, a deck seen from the ground). One
// mechanism for all of them (support.cone does the standing and the stopping).
pub const SOLID_CIRCLE = 0u32;
pub const SOLID_BOX = 1u32;

pub struct Solid {
  pub kind u32;
  pub x0 f32;     // a circle: its middle's x; a box: its least x
  pub z0 f32;     // a circle: its middle's z; a box: its least z
  pub x1 f32;     // a circle: its radius;     a box: its most x
  pub z1 f32;     // a circle: unused;         a box: its most z
  pub y0 f32;     // the bottom, world metres (low enough to meet the ground on any slope)
  pub y1 f32;     // the top

  pub fn circle(x f32, z f32, radius f32, y0 f32, y1 f32) Solid { new Solid(SOLID_CIRCLE, x, z, radius, 0., y0, y1); }
  pub fn box(x0 f32, z0 f32, x1 f32, z1 f32, y0 f32, y1 f32) Solid { new Solid(SOLID_BOX, x0, z0, x1, z1, y0, y1); }

  // Whether (x, z) is over the solid's shape
  pub fn over(self &, x f32, z f32) bool {
    if kind == SOLID_CIRCLE {
      imm dx = x - x0;
      imm dz = z - z0;
      return dx * dx + dz * dz <= x1 * x1;
    }
    x >= x0 and x <= x1 and z >= z0 and z <= z1;
  }
}
