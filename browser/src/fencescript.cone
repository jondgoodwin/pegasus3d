// The island's roaming part of the scripted run, last of all (after the villagers', frame FENCE_FROM): the pictures
// of what lies beyond the old fence now that a walker may go anywhere on the island and stops only at the water's edge.
// Each is taken from a walker's eye (1.7 m up) on ground it could now walk to, a window of ten frames each, the picture
// saved at the fifth; the day clock stays at the villagers' noon in fair weather. The viewer is not moved (as in the
// run's other close-ups), so the pictures say nothing of the villagers or the walkers' physics; --checks walks the shore.
//
//   window  what is looked at
//     0     the west lowland, from 300 m west of the cottage, looking west along the island's south side
//     1     the east lowland, from 260 m east, looking east
//     2     the hill's foot behind the cottage's field, looking north up the hill
//     3     the hill's flank, 150 m up the slope, looking up along it
//     4     from the summit, looking south down the island to the cottage's cove
//     5     from the summit, looking north over the far shore
//     6     the east shore, from the land 36 m short of the beach, looking out to sea (a walker running east stops in the shallows)
//     7     the south-east spit, from its root, looking along it
//     8     the west coast, from the land behind its beach, looking out to sea

pub const FENCE_FROM = NPC_FROM + NPC_FRAMES;
pub const FENCE_WINDOW = 10u64;
pub const FENCE_WINDOWS = 9u64;
pub const FENCE_FRAMES = FENCE_WINDOW * FENCE_WINDOWS;

fn fenceWindow(f u64) u64 { (f - FENCE_FROM) / FENCE_WINDOW }

fn fenceInWindows(f u64) bool { f >= FENCE_FROM && f < FENCE_FROM + FENCE_FRAMES }

pub fn fenceShotAt(f u64) &str {
  if !fenceInWindows(f) || (f - FENCE_FROM) % FENCE_WINDOW != 5u64 { return ""; }
  let w = fenceWindow(f);
  if w == 0u64 { return "roam-west"; }
  if w == 1u64 { return "roam-east"; }
  if w == 2u64 { return "roam-hillfoot"; }
  if w == 3u64 { return "roam-flank"; }
  if w == 4u64 { return "roam-summit-south"; }
  if w == 5u64 { return "roam-summit-north"; }
  if w == 6u64 { return "roam-shore-east"; }
  if w == 7u64 { return "roam-spit"; }
  "roam-shore-west"
}

pub fn fenceHasView(f u64) bool { fenceInWindows(f) }

// The eye's place on the ground (x, z) and what it looks at: (x, z) and 'up' metres over the ground there
fn fenceEye(isl &Island, x f32, z f32, tx f32, tz f32, up f32) Pose {
  lookFrom(new Vec3(x, groundHeight(isl, x, z) + 1.7, z), new Vec3(tx, groundHeight(isl, tx, tz) + up, tz))
}

pub fn fenceView(isl &Island, f u64) Pose {
  let w = fenceWindow(f);
  if w == 0u64 { return fenceEye(isl, -300., 340., -420., 300., 4.); }
  if w == 1u64 { return fenceEye(isl, 260., 380., 380., 360., 4.); }
  if w == 2u64 { return fenceEye(isl, 0., 170., 20., 60., 8.); }
  if w == 3u64 { return fenceEye(isl, -120., 20., -60., -60., 6.); }
  if w == 4u64 { return fenceEye(isl, 16., -264., -16., 300., -5.); }
  if w == 5u64 { return fenceEye(isl, 16., -264., 40., -700., 0.); }
  if w == 6u64 { return fenceEye(isl, 500., 285., 620., 285., 0.); }
  if w == 7u64 { return fenceEye(isl, 560., 440., 676., 556., 2.); }
  fenceEye(isl, -600., 56., -700., 56., 0.)
}

// The part's own report, after the picture's frame is presented: where the eye stands, and that it is on ground a walker could
// stand on (ground at or above the wading limit), so that the picture shows what a walker could now see
pub fn fenceDrive(st &mut SimState, f u64) {
  if !fenceInWindows(f) || (f - FENCE_FROM) % FENCE_WINDOW != 5u64 { return; }
  let w = fenceWindow(f);
  let eye = fenceView(&st.land, f).origin;
  let ground = groundHeight(&st.land, eye.x, eye.z);
  print <- "Frame "; print <- f; print <- ", roaming view "; print <- w; print <- " from ("; print <- eye.x; print <- ", "; print <- eye.z;
  print <- "), the ground there "; print <- ground; print <- " m";
  if ground < 0. - WADE_DEPTH {
    print <- ": NOT ground a walker can stand on\n";
    st.fenceRunOk = false;
  } else { print <- ", walkable\n"; }
}

// Whether the roaming part has held
pub fn checkFenceRun(st &SimState) bool { st.fenceRunOk }
