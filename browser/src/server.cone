// The server and the test runs that go with it (browser.cone's modes):
//
//   --serve PORT     a headless simulation (no window, no GPU) listening on a UDP port, ticking at its own
//                    fixed rate on the real clock, sending each client the world's requests and snapshots of the
//                    beings. The same SimActor single player runs, with no view in this process.
//   --impair LOSS LATENCY JITTER
//                    with --serve: a relay in front of the server that loses LOSS in 1000 packets and delays each
//                    by LATENCY ms and up to JITTER more, each way (netmsg's LossyRelay), for trying the
//                    prediction and interpolation on a bad link; the port to connect to is printed
//   --connect HOST:PORT
//                    a browser (windowed, or --headless) whose simulation is remote
//   --name NAME      with --connect: the name this client plays under, shown above its mannequin to the others (letters,
//                    digits, spaces and . _ - ; 24 at most; default: this machine's name). The server refuses a name
//                    already in use, and the client prints why and ends (exit code 3)
//   --autowalk       the controller is a script, not the keyboard: a walk with turns, a run and a jump
//   --loopback       with --serve: listen on 127.0.0.1 only, not every interface (tests; no firewall prompt)
//   --trace          print what the test checks read (see browser/tools/netcheck.py)
//   --run-for S      stop after S seconds of real time (any mode with a real clock)

// The address 'text' ("a.b.c.d:port" or "localhost:port") as a socket address (an unreadable one is the local machine, port 0)
fn parseAddress(text: &str) SocketAddr {
  let b: &Array[u8] = text;
  var octets = List[u32].empty();
  var cur = 0u32;
  var port = 0u32;
  var inPort = false;
  var digits = false;
  var i = 0usize;
  while i < b.len {
    let c = b[i];
    if c >= 48u8 && c <= 57u8 {
      if inPort { port = port * 10u32 + u32.from(c - 48u8); } else { cur = cur * 10u32 + u32.from(c - 48u8); }
      digits = true;
    } elif c == 46u8 && !inPort {
      octets.push(cur);
      cur = 0u32;
    } elif c == 58u8 && !inPort {
      octets.push(cur);
      inPort = true;
      digits = false;
    }
    i = i + 1usize;
  }
  if octets.len() == 4usize {
    return SocketAddr.v4(u8.from(*octets[0usize]), u8.from(*octets[1usize]), u8.from(*octets[2usize]), u8.from(*octets[3usize]), u16.from(port));
  }
  // "localhost:port" (or anything else without four numbers): this machine
  SocketAddr.localhost(u16.from(port))
}

// Whether 'text' is an address parseAddress reads as it was meant: "a.b.c.d:port" (each part in range) or "localhost:port".
// (There is no name lookup: a host name would otherwise be taken for this machine.)
fn addressReadable(text: &str) bool {
  let b: &Array[u8] = text;
  var parts = 0u32;       // numbers read before the port
  var cur = 0u32;
  var digits = 0u32;
  var i = 0usize;
  if b.len > 10usize && b[0usize] == 108u8 && b[1usize] == 111u8 && b[2usize] == 99u8 && b[9usize] == 116u8 && b[10usize] == 58u8 {
    // "localhost:" then the port
    i = 11usize;
    while i < b.len {
      if b[i] < 48u8 || b[i] > 57u8 { return false; }
      cur = cur * 10u32 + u32.from(b[i] - 48u8);
      if cur > 65535u32 { return false; }
      digits = digits + 1u32;
      i = i + 1usize;
    }
    return digits > 0u32 && cur > 0u32;
  }
  i = 0usize;
  while i < b.len {
    let c = b[i];
    if c >= 48u8 && c <= 57u8 {
      cur = cur * 10u32 + u32.from(c - 48u8);
      digits = digits + 1u32;
      if cur > 65535u32 { return false; }
    } elif c == 46u8 && parts < 3u32 {
      if digits == 0u32 || cur > 255u32 { return false; }
      parts = parts + 1u32;
      cur = 0u32;
      digits = 0u32;
    } elif c == 58u8 && parts == 3u32 {
      if digits == 0u32 || cur > 255u32 { return false; }
      parts = 4u32;
      cur = 0u32;
      digits = 0u32;
    } else {
      return false;
    }
    i = i + 1usize;
  }
  parts == 4u32 && digits > 0u32 && cur > 0u32
}

// The script a test's walker follows, by fixed step: stand, walk, walk turning left, run, jump, stand, back up, turn on the spot, stand
pub fn autoIntents(n: u64) Intents {
  if n < 90u64 { return Intents.none(); }
  if n < 450u64 { return Intents(1., 0., false, false); }
  if n < 510u64 { return Intents(1., 1., false, false); }
  if n < 750u64 { return Intents(1., 0., true, false); }
  if n < 770u64 { return Intents(0., 0., false, true); }
  if n < 830u64 { return Intents.none(); }
  if n < 950u64 { return Intents(-1., 0., false, false); }
  if n < 1010u64 { return Intents(0., -1., false, false); }
  Intents.none()
}

// The net check's walk through the looking-glass (--portal-walk): it asks at tick 200 to be put down 3 m before the cottage's glass (viewactor.cone),
// stands, runs through the glass and down the corridor into the room (300 steps), turns about (180 steps at a quarter turn in 1.5 s: a half turn),
// and runs back out through the corridor's mouth onto the island (300)
pub fn portalWalkIntents(n: u64) Intents {
  if n < 240u64 { return Intents.none(); }
  if n < 540u64 { return Intents(1., 0., true, false); }
  if n < 720u64 { return Intents(0., 1., false, false); }
  if n < 1020u64 { return Intents(1., 0., true, false); }
  Intents.none()
}

// A server: the island baked, the simulation made, the port bound, and a tick at a time until the run is over
fn serveRun(config: Config, startup: &Startup) i32 {
  var opts = startup.opts;
  opts.scripted = false;       // a server runs no script
  let serve = &startup.serve;
  var host = Host.open(config);
  if !host.isOpen() { return 1i32; }
  let unbaked = Island.empty();
  let birds = Birds.make(&unbaked);   // before the island is baked, as ever: the ground is 0 m
  let bare = bakeIsland().withVegetation(!opts.vegetationOff);
  let land = layOutVegetation(&bare);
  let isl = &land;
  var joinedTx: Sender[bool];
  var joinedRx: Receiver[bool];
  joinedTx, joinedRx = Channel[bool].make();
  var servedTx: Sender[u64];
  var servedRx: Receiver[u64];
  servedTx, servedRx = Channel[u64].make();
  let world = WorldActor(false, land.share());
  let sim = SimActor(opts, birds, world, true, joinedTx, servedTx.clone(), land.share(), GalleryPlan.none(), startup.people.share());
  let simHandler = eventHandler(Uni[fn(ev: NetEvent) + Sendable](fn(ev: NetEvent) [sim] { sim.onNet(ev); }));
  // Every interface, so other machines can join; with --loopback this machine only, which Windows' firewall never asks about
  let bindTo = if serve.loopback { SocketAddr.localhost(u16.from(serve.port)) } else { SocketAddr.v4(0u8, 0u8, 0u8, 0u8, u16.from(serve.port)) };
  let bound = mustListen(bindTo, NetConfig.defaults(), simHandler);
  print <- "Serving on UDP port "; print <- u32.from(bound.port); print <- "\n";
  var relayOpt: Option[LossyRelay] = None;
  if serve.impairOn {
    let link = LinkConfig.lossy(serve.impairLoss, i64.from(serve.impairLatency), i64.from(serve.impairJitter));
    var relay = startLossyRelay(SocketAddr.localhost(bound.port), link, link, 1u64);
    print <- "Relay: port "; print <- u32.from(relay.port); print <- " ("; print <- serve.impairLoss; print <- " per 1000 lost, ";
    print <- serve.impairLatency; print <- " ms and up to "; print <- serve.impairJitter; print <- " more each way)\n";
    relayOpt = Some[LossyRelay](relay);
  }
  print.flush();
  let start = sdl.GetTicksNS();
  var e = sdl.Event.empty();
  while host.beginFrame() {
    print.flush();
    if opts.runForSeconds > 0u64 && sdl.GetTicksNS() - start > opts.runForSeconds *1000000000u64 { break; }
    while host.nextEvent(&mut e) {}
    var steps = List[Step].empty();
    while host.fixed.next() {
      steps.push(host.step());
    }
    if steps.len() > 0usize {
      sim.serveTick(Advance(host.frame, steps, 0u64, 0u64));
      match servedRx.recv() {
        case Some(t) {}
        case is None[u64] { break; }
      }
    }
    thread.sleep(Duration.fromMillis(2i64));
  }
  sim.serveEnd();
  servedRx.recv();
  match &mut relayOpt {
    case &mut Some(var r) { r.stop(); }
    else {}
  }
  bound.endpoint.shutdown();
  thread.sleep(Duration.fromMillis(300i64));
  let st = actors.stats();
  print <- "Actors: "; print <- u64.from(st.workers); print <- " workers, "; print <- st.messages; print <- " messages\n";
  host.finish();
  0i32
}
