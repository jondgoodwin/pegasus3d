// The --checks of the messages as bytes (netcodec.cone): each kind written and read back, the quantised state
// within what its numbers promise, and everything under the limits of one packet.

fn sameBytes(a &List[u8], b &List[u8]) bool {
  if a.len() != b.len() { return false; }
  mut i = 0usize;
  while i < a.len() {
    if *a[i] != *b[i] { return false; }
    i = i + 1usize;
  }
  true;
}

fn idOf(slot u32) PartId { new PartId(Ref[PartRecord].of(slot, 1u32)); }

// Request 'r' written, read back and written again: the same bytes. 'size' is how long it is
fn requestRoundTrips(what &str, request Request) bool {
  mut first = List[u8].empty();
  imm r = request;
  if !encodeRequest(&r, &mut first) {
    print <- "  "; printStr(what); print <- ": would not encode\n";
    return false;
  }
  mut back = List[Request].empty();
  mut rd = Rd.make(copyBytes(&first));
  if !decodeRequest(&mut rd, &mut back) or back.len() != 1usize or rd.left() != 0usize {
    print <- "  "; printStr(what); print <- ": would not decode\n";
    return false;
  }
  mut second = List[u8].empty();
  encodeRequest(back[0usize], &mut second);
  imm same = sameBytes(&first, &second);
  print <- "  "; printStr(what); print <- ": "; print <- first.len(); print <- " bytes, "; if same { print <- "the same back\n"; } else { print <- "DIFFERENT back\n"; }
  same;
}

fn checkNet() bool {
  print <- "Messages as bytes:\n";
  mut ok = true;

  // Each request kind
  imm at = new Transform3(new Vec3(-16.25, 312.5, 330.125), new Quat(0., 0.7071068, 0., 0.7071068), new Vec3(9., 9., 9.));
  ok = requestRoundTrips("Spawn", Request.Spawn(idOf(7u32), String.from("path lantern"))) and ok;
  ok = requestRoundTrips("Place", Request.Place(idOf(300u32), at)) and ok;
  ok = requestRoundTrips("Parent", Request.Parent(idOf(8u32), idOf(7u32))) and ok;
  ok = requestRoundTrips("Despawn", Request.Despawn(idOf(9u32))) and ok;
  ok = requestRoundTrips("Show", Request.Show(idOf(9u32), new MeshId(idOf(2u32)), new MaterialId(idOf(3u32)), 0.)) and ok;
  ok = requestRoundTrips("Fire", Request.Fire(idOf(40u32), 123456u32, 12.5d, 13.75d)) and ok;
  ok = requestRoundTrips("Glow", Request.Glow(new MaterialId(idOf(11u32)), new Color(2800., 1100., 260., 1.))) and ok;
  ok = requestRoundTrips("Tint", Request.Tint(idOf(12u32), new Color(1.45, 1.45, 1.45, 1.))) and ok;
  ok = requestRoundTrips("Platform", Request.Platform(idOf(13u32), PlatformShape.make(0.1, new Vec2(-0.5, -0.4), new Vec2(0.5, 0.4), 0.8, 11u32))) and ok;
  ok = requestRoundTrips("BeingAdded", Request.BeingAdded(3u32, idOf(14u32), false, 1.62, 11u32)) and ok;
  ok = requestRoundTrips("LightSource", Request.LightSource(idOf(15u32), LightLook.spot(new Vec3(0., 1., 0.), new Vec3(0., -1., 0.),
    new Color(1., 0.5, 0.2, 1.), 40., 12., 0.3, 0.5))) and ok;
  ok = requestRoundTrips("CastsShadow", Request.CastsShadow(idOf(16u32), false)) and ok;

  // An Object: its ids as runs (consecutive slots in one generation), and a shared material among them
  mut ids = List[PartId].empty();
  mut k = 0u32;
  while k < 3u32 { ids.push(idOf(100u32 + k)); k = k + 1u32; }                       // meshes
  ids.push(idOf(40u32));                                                            // a material the world had already
  k = 0u32;
  while k < 900u32 { ids.push(idOf(200u32 + k)); k = k + 1u32; }                    // parts
  imm spec = new ObjectSpec(OBJ_MANNEQUIN, 2u32, 1.75, new Color(0.6, 0.4, 0.2, 1.), String.from("mannequin 2"));
  mut idsCopy = List[PartId].empty();
  mut ci = 0usize;
  while ci < ids.len() { idsCopy.push(*ids[ci]); ci = ci + 1usize; }
  imm obj = Request.Object(spec, idsCopy);
  mut idsBack = List[Request].empty();
  mut one = List[u8].empty();
  encodeRequest(&obj, &mut one);
  print <- "  Object (904 ids in 4 runs): "; print <- one.len(); print <- " bytes\n";
  mut rd = Rd.make(copyBytes(&one));
  decodeRequest(&mut rd, &mut idsBack);
  mut same = idsBack.len() == 1usize;
  if same {
    match idsBack[0usize] {
      case imm o Object {
        same = o.ids.len() == ids.len();
        mut i = 0usize;
        while same and i < ids.len() {
          if !(*o.ids[i] == *ids[i]) { same = false; }
          i = i + 1usize;
        }
        same = same and o.spec.kind == OBJ_MANNEQUIN and o.spec.index == 2u32 and o.spec.name.view() == "mannequin 2";
      }
      else { same = false; }
    }
  }
  ok = expect("an Object's ids come back as they went", same) and ok;

  // Requests packed into messages that fit
  mut items = List[List[u8]].empty();
  k = 0u32;
  while k < 100u32 {
    mut b = List[u8].empty();
    imm placed = Request.Place(idOf(300u32 + k), at);
    encodeRequest(&placed, &mut b);
    items.push(b);
    k = k + 1u32;
  }
  mut from = 0usize;
  mut messages = 0u32;
  mut biggest = 0usize;
  mut got = 0usize;
  while from < items.len() {
    mut msg = List[u8].empty();
    from = packRequests(&items, from, &mut msg);
    messages = messages + 1u32;
    if msg.len() > biggest { biggest = msg.len(); }
    match decodeToView(msg) {
      case imm q Requests { got = got + q.batch.len(); }
      else {}
    }
  }
  print <- "  100 places: "; print <- messages; print <- " messages, the largest "; print <- biggest; print <- " bytes\n";
  ok = expect("100 requests pack into reliable messages that fit and all come back", got == 100usize and biggest <= MAX_RELIABLE) and ok;

  // The state: quantised (positions to a millimetre, the heading to a 16th of a degree's tenth, speeds in fixed point) and whole
  mut beings = List[BeingState].empty();
  beings.push(new BeingState(0u32, false, new Vec3(-23.4567, 12.7891, 499.1234), 3.0, 1.8, 0., 0., 0., true, new Intents(1., -1., true, false),
    PartId.none(), 0.5, 3u32, 250u32, 7.5, 0u32, 0., false, noRots()));
  beings.push(new BeingState(1u32, true, new Vec3(-10.123456, 33.5, 301.987654), -2.5, -1.8, -4.2, 1.1, -0.9, false, new Intents(0., 0., false, true),
    idOf(21u32), 1., 1u32, 2u32, 0., 0u32, 0., false, noRots()));
  mut w = new WorldState(4294967295u64, 1234.567d, 10u32, 987654u64, beings);
  imm bytes = encodeState(&w);
  mut back = new WorldState(0u64, 0d, 1u32, 0u64, List[BeingState].empty());
  imm decoded = decodeState(copyBytes(&bytes), &mut back);
  ok = expect("a snapshot decodes", decoded and back.beings.len() == 2usize) and ok;
  if decoded and back.beings.len() == 2usize {
    imm a = back.beings[0usize];
    imm b = back.beings[1usize];
    ok = expect("its tick, scene time, clock rate and input sequence number", back.tick == 4294967295u64 and back.now == 1234.567d
      and back.rate == 10u32 and back.appliedInput == 987654u64) and ok;
    ok = expect("a quantised position is within a millimetre", libc.fabsf(a.position.x + 23.4567) <= 0.0006 and libc.fabsf(a.position.y - 12.7891) <= 0.0006
      and libc.fabsf(a.position.z - 499.1234) <= 0.0006) and ok;
    ok = expect("its heading within 0.0001 radians, its speed within a millimetre a second", libc.fabsf(wrapPi(a.yaw - 3.0)) <= 0.0001
      and libc.fabsf(a.speed - 1.8) <= 0.001) and ok;
    ok = expect("its intents, ground, health, setdowns and landings", a.intents.ahead == 1. and a.intents.turn == -1. and a.intents.run and !a.intents.jump
      and a.grounded and libc.fabsf(a.health - 0.5) <= 0.003 and a.respawns == 3u32 and a.landings == 250u32
      and libc.fabsf(a.landSpeed - 7.5) <= 0.001 and a.platform.isNone() and !a.exact) and ok;
    ok = expect("a whole one comes back to the bit", b.exact and b.position.x == -10.123456 and b.position.y == 33.5 and b.position.z == 301.987654
      and b.yaw == -2.5 and b.speed == -1.8 and b.vy == -4.2 and b.airVx == 1.1 and b.airVz == -0.9 and !b.grounded and b.intents.jump
      and b.platform == idOf(21u32)) and ok;
  }
  // Forty beings are a snapshot of what size
  mut many = List[BeingState].empty();
  k = 0u32;
  while k < 40u32 {
    many.push(new BeingState(k, k == 0u32, new Vec3(-23.4567, 12.7891, 499.1234), 3.0, 1.8, 0., 0., 0., true, new Intents(1., 0., false, false),
      PartId.none(), 1., 0u32, 0u32, 0., 0u32, 0., false, noRots()));
    k = k + 1u32;
  }
  mut manyState = new WorldState(1u64, 1d, 1u32, 1u64, many);
  imm big = encodeState(&manyState);
  print <- "  a snapshot of forty beings: "; print <- big.len(); print <- " bytes (the limit "; print <- MAX_LATEST; print <- ")\n";
  ok = expect("a snapshot of forty beings fits a packet", big.len() <= MAX_LATEST) and ok;
  // A ragdoll: its 14 bodies' rotations (4 bytes each), a get-up's time
  mut spun = noRots();
  k = 0u32;
  while k < 14u32 {
    spun[usize.from(k)] = Quat.angleAxis(0.3 * f32.from(k) - 1.7, new Vec3(0.3, 0.9, -0.2).normalize());
    k = k + 1u32;
  }
  mut rag = List[BeingState].empty();
  rag.push(new BeingState(0u32, false, new Vec3(5., 3., 7.), 0.5, 0., -3., 0., 0., false, Intents.none(), PartId.none(), 0.75, 0u32, 1u32, 9., 1u32, 0., true, spun));
  rag.push(new BeingState(1u32, false, new Vec3(6., 0., 8.), 1.5, 0., 0., 0., 0., true, Intents.none(), PartId.none(), 0.75, 0u32, 1u32, 9., 2u32, 1.234, false, noRots()));
  imm ragBytes = encodeState(&new WorldState(5u64, 1d, 1u32, 1u64, rag));
  mut ragBack = new WorldState(0u64, 0d, 1u32, 0u64, List[BeingState].empty());
  imm ragOk = decodeState(copyBytes(&ragBytes), &mut ragBack) and ragBack.beings.len() == 2usize;
  mut spinErr = 0.;
  if ragOk and ragBack.beings[0usize].hasRots {
    k = 0u32;
    while k < 14u32 {
      imm q = ragBack.beings[0usize].rots[usize.from(k)];
      imm p = spun[usize.from(k)];
      imm d = libc.fabsf(q.x * p.x + q.y * p.y + q.z * p.z + q.w * p.w);
      imm e = 2. * libc.acosf(if d > 1. { 1.; } else { d; });
      if e > spinErr { spinErr = e; }
      k = k + 1u32;
    }
  } else { spinErr = 9.; }
  print <- "  a ragdoll's snapshot: "; print <- ragBytes.len(); print <- " bytes for two beings, its rotations within "; print <- spinErr * 57.29578; print <- " degrees\n";
  ok = expect("a ragdoll's 14 rotations come back within 0.2 degrees, with its mode, and a get-up's time within a millisecond",
    ragOk and spinErr < 0.0035 and ragBack.beings[0usize].mode == 1u32 and ragBack.beings[1usize].mode == 2u32
    and libc.fabsf(ragBack.beings[1usize].modeT - 1.234) < 0.0011) and ok;
  // Forty ragdolls do not fit: the snapshot still fits a packet, the beings that did not get room come as walkers
  mut limp = List[BeingState].empty();
  k = 0u32;
  while k < 40u32 {
    limp.push(new BeingState(k, false, new Vec3(5., 3., 7.), 0.5, 0., -3., 0., 0., false, Intents.none(), PartId.none(), 0.75, 0u32, 1u32, 9., 1u32, 0., true, spun));
    k = k + 1u32;
  }
  imm limpBytes = encodeState(&new WorldState(5u64, 1d, 1u32, 1u64, limp));
  print <- "  a snapshot of forty ragdolls: "; print <- limpBytes.len(); print <- " bytes\n";
  ok = expect("a snapshot of forty ragdolls still fits a packet", limpBytes.len() <= MAX_LATEST) and ok;

  // The inputs: the last INPUT_MOST of them, numbered
  mut samples = List[InputSample].empty();
  k = 0u32;
  while k < u32.from(INPUT_MOST) {
    samples.push(new InputSample(1000u64 + u64.from(k), new Intents(if k % 3u32 == 0u32 { 1.; } elif k % 3u32 == 1u32 { -1.; } else { 0.; }, 0.5, k % 2u32 == 0u32,
      k % 5u32 == 0u32), if k % 4u32 == 0u32 { 1.; } else { 0.; }));
    k = k + 1u32;
  }
  imm inputBytes = encodeInput(&samples);
  mut inputBack = List[InputSample].empty();
  imm inputOk = decodeInput(copyBytes(&inputBytes), &mut inputBack);
  mut inputSame = inputOk and inputBack.len() == samples.len();
  mut i = 0usize;
  while inputSame and i < samples.len() {
    imm x = samples[i];
    imm y = inputBack[i];
    inputSame = x.seq == y.seq and x.intents.ahead == y.intents.ahead and libc.fabsf(x.intents.turn - y.intents.turn) <= 0.005
      and x.intents.run == y.intents.run and x.intents.jump == y.intents.jump and x.lookKeys == y.lookKeys;
    i = i + 1usize;
  }
  print <- "  "; print <- samples.len(); print <- " input samples: "; print <- inputBytes.len(); print <- " bytes\n";
  ok = expect("an input batch comes back, its sequence numbers whole and its keys whole (an axis to 1/127)", inputSame and inputBytes.len() <= MAX_LATEST) and ok;

  // The messages to the simulation
  match decodeToSim(encodeToSim(ToSim.Click(idOf(77u32)))) {
    case imm c Click { ok = expect("a click comes back", c.part == idOf(77u32)) and ok; }
    else { ok = expect("a click comes back", false) and ok; }
  }
  match decodeToSim(encodeToSim(ToSim.Command(COMMAND_WEATHER))) {
    case imm c Command { ok = expect("a command comes back", c.kind == COMMAND_WEATHER) and ok; }
    else { ok = expect("a command comes back", false) and ok; }
  }
  match decodeToSim(encodeToSim(ToSim.Look(-0.25))) {
    case imm l Look { ok = expect("a pitch comes back", l.pitch == -0.25) and ok; }
    else { ok = expect("a pitch comes back", false) and ok; }
  }
  mut steps = List[Step].empty();
  steps.push(new Step(41u64, 16666666u64, 0.016666666, 683333306u64, 1u32));
  match decodeToSim(encodeToSim(ToSim.Frame(77u64, steps))) {
    case imm f Frame { ok = expect("a frame's steps come back", f.frame == 77u64 and f.steps.len() == 1usize and f.steps[0usize].index == 41u64
      and f.steps[0usize].dt == 0.016666666 and f.steps[0usize].startNs == 683333306u64) and ok; }
    else { ok = expect("a frame's steps come back", false) and ok; }
  }
  // Weather
  mut wx = Weathering.fair();
  wx.goTo(WEATHER_RAIN, 100d, 12.);
  match decodeToView(encodeWeather(&wx)) {
    case imm q Weather { ok = expect("a weather change comes back", q.weather.same(&wx)) and ok; }
    else { ok = expect("a weather change comes back", false) and ok; }
  }
  // A scripted run's own
  imm test = new TestView(true, Pose.look(new Vec3(1., 2., 3.), 0.5, 0.25), 0.9, String.from("sky-bird-1"));
  mut testBack = new TestView(false, Pose.look(new Vec3(0., 0., 0.), 0., 0.), FOV, String.empty());
  ok = expect("a scripted view comes back", decodeTest(encodeTest(&test), &mut testBack) and testBack.fixedView and testBack.shot.view() == "sky-bird-1"
    and testBack.view.origin.z == 3. and testBack.fov == 0.9) and ok;

  // Nonsense is refused, never trusted
  mut garbage = List[u8].empty();
  garbage.push(1u8);
  garbage.push(0u8);
  garbage.push(5u8);
  garbage.push(10u8);
  mut state = new WorldState(0u64, 0d, 1u32, 0u64, List[BeingState].empty());
  ok = expect("a short or corrupt message is refused", !decodeState(copyBytes(&garbage), &mut state)
    and !decodeInput(copyBytes(&garbage), &mut inputBack)) and ok;
  match decodeToView(copyBytes(&garbage)) {
    case imm q Requests { ok = expect("a corrupt batch of requests is refused", false) and ok; }
    else {}
  }
  ok;
}
