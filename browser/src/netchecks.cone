// The --checks of the messages as bytes (netcodec.cone): each kind written and read back, the quantised state
// within what its numbers promise, and everything under the limits of one packet.

fn sameBytes(a: &List[u8], b: &List[u8]) bool {
  if a.len() != b.len() { return false; }
  var i = 0usize;
  while i < a.len() {
    if *a[i] != *b[i] { return false; }
    i = i + 1usize;
  }
  true
}

fn idOf(slot: u32) PartId { PartId(Ref[PartRecord].of(slot, 1u32)) }

// Request 'r' written, read back and written again: the same bytes. 'size' is how long it is
fn requestRoundTrips(what: &str, request: Request) bool {
  var first = List[u8].empty();
  let r = request;
  if !encodeRequest(&r, &mut first) {
    print <- "  "; printStr(what); print <- ": would not encode\n";
    return false;
  }
  var back = List[Request].empty();
  var rd = Rd.make(copyBytes(&first));
  if !decodeRequest(&mut rd, &mut back) || back.len() != 1usize || rd.left() != 0usize {
    print <- "  "; printStr(what); print <- ": would not decode\n";
    return false;
  }
  var second = List[u8].empty();
  encodeRequest(back[0usize], &mut second);
  let same = sameBytes(&first, &second);
  print <- "  "; printStr(what); print <- ": "; print <- first.len(); print <- " bytes, "; if same { print <- "the same back\n"; } else { print <- "DIFFERENT back\n"; }
  same
}

fn checkNet() bool {
  print <- "Messages as bytes:\n";
  var ok = true;

  // Each request kind
  let at = Transform3(Vec3(-16.25, 312.5, 330.125), Quat(0., 0.7071068, 0., 0.7071068), Vec3(9., 9., 9.));
  ok = requestRoundTrips("Spawn", Request.Spawn(idOf(7u32), String.from("path lantern"))) && ok;
  ok = requestRoundTrips("Place", Request.Place(idOf(300u32), at)) && ok;
  ok = requestRoundTrips("Parent", Request.Parent(idOf(8u32), idOf(7u32))) && ok;
  ok = requestRoundTrips("Despawn", Request.Despawn(idOf(9u32))) && ok;
  ok = requestRoundTrips("Show", Request.Show(idOf(9u32), MeshId(idOf(2u32)), MaterialId(idOf(3u32)), 0.)) && ok;
  ok = requestRoundTrips("Fire", Request.Fire(idOf(40u32), 123456u32, 12.5, 13.75)) && ok;
  ok = requestRoundTrips("Glow", Request.Glow(MaterialId(idOf(11u32)), Color(2800., 1100., 260., 1.))) && ok;
  ok = requestRoundTrips("Tint", Request.Tint(idOf(12u32), Color(1.45, 1.45, 1.45, 1.))) && ok;
  ok = requestRoundTrips("Platform", Request.Platform(idOf(13u32), PlatformShape.make(0.1, Vec2(-0.5, -0.4), Vec2(0.5, 0.4), 0.8, 11u32))) && ok;
  ok = requestRoundTrips("BeingAdded", Request.BeingAdded(3u32, idOf(14u32), false, 1.62, 11u32, String.from("Jon"), 4u32)) && ok;
  ok = requestRoundTrips("BeingAdded (a mannequin)", Request.BeingAdded(3u32, idOf(14u32), false, 1.62, 11u32, String.from("Jon"), NO_PERSON)) && ok;
  ok = requestRoundTrips("LightSource", Request.LightSource(idOf(15u32), LightLook.spot(Vec3(0., 1., 0.), Vec3(0., -1., 0.),
    Color(1., 0.5, 0.2, 1.), 40., 12., 0.3, 0.5))) && ok;
  ok = requestRoundTrips("CastsShadow", Request.CastsShadow(idOf(16u32), false)) && ok;

  // An Object: its ids as runs (consecutive slots in one generation), and a shared material among them
  var ids = List[PartId].empty();
  var k = 0u32;
  while k < 3u32 { ids.push(idOf(100u32 + k)); k = k + 1u32; }                       // meshes
  ids.push(idOf(40u32));                                                            // a material the world had already
  k = 0u32;
  while k < 900u32 { ids.push(idOf(200u32 + k)); k = k + 1u32; }                    // parts
  let spec = ObjectSpec(OBJ_MANNEQUIN, 2u32, 1.75, Color(0.6, 0.4, 0.2, 1.), String.from("mannequin 2"));
  var idsCopy = List[PartId].empty();
  var ci = 0usize;
  while ci < ids.len() { idsCopy.push(*ids[ci]); ci = ci + 1usize; }
  let obj = Request.Object(spec, idsCopy);
  var idsBack = List[Request].empty();
  var one = List[u8].empty();
  encodeRequest(&obj, &mut one);
  print <- "  Object (904 ids in 4 runs): "; print <- one.len(); print <- " bytes\n";
  var rd = Rd.make(copyBytes(&one));
  decodeRequest(&mut rd, &mut idsBack);
  var same = idsBack.len() == 1usize;
  if same {
    match idsBack[0usize] {
      case let Object(o) {
        same = o.ids.len() == ids.len();
        var i = 0usize;
        while same && i < ids.len() {
          if !(*o.ids[i] == *ids[i]) { same = false; }
          i = i + 1usize;
        }
        same = same && o.spec.kind == OBJ_MANNEQUIN && o.spec.index == 2u32 && o.spec.name.view() == "mannequin 2";
      }
      else { same = false; }
    }
  }
  ok = expect("an Object's ids come back as they went", same) && ok;

  // Requests packed into messages that fit
  var items = List[List[u8]].empty();
  k = 0u32;
  while k < 100u32 {
    var b = List[u8].empty();
    let placed = Request.Place(idOf(300u32 + k), at);
    encodeRequest(&placed, &mut b);
    items.push(b);
    k = k + 1u32;
  }
  var from = 0usize;
  var messages = 0u32;
  var biggest = 0usize;
  var got = 0usize;
  while from < items.len() {
    var msg = List[u8].empty();
    from = packRequests(&items, from, &mut msg);
    messages = messages + 1u32;
    if msg.len() > biggest { biggest = msg.len(); }
    match decodeToView(msg) {
      case let Requests(q) { got = got + q.batch.len(); }
      else {}
    }
  }
  print <- "  100 places: "; print <- messages; print <- " messages, the largest "; print <- biggest; print <- " bytes\n";
  ok = expect("100 requests pack into reliable messages that fit and all come back", got == 100usize && biggest <= MAX_RELIABLE) && ok;

  // The state: quantised (positions to a millimetre, the heading to a 16th of a degree's tenth, speeds in fixed point) and whole
  var beings = List[BeingState].empty();
  beings.push(BeingState(0u32, false, Vec3(-23.4567, 12.7891, 499.1234), 3.0, 1.8, 0., 0., 0., true, Intents(1., -1., true, false),
    PartId.none(), 0.5, 3u32, 250u32, 7.5, 0u32, 0., false, noRots()));
  beings.push(BeingState(1u32, true, Vec3(-10.123456, 33.5, 301.987654), -2.5, -1.8, -4.2, 1.1, -0.9, false, Intents(0., 0., false, true),
    idOf(21u32), 1., 1u32, 2u32, 0., 0u32, 0., false, noRots()));
  var propList = List[PropState].empty();
  propList.push(PropState(0u32, Vec3(-9.5, 4.6, 342.25), Quat.angleAxis(0.7, Vec3(0.3, 0.9, 0.1).normalize())));
  propList.push(PropState(7u32, Vec3(-22.001, 5.1234, 300.5), Quat.angleAxis(2.9, Vec3(1., 0., 0.))));
  var fxList = List[FxState].empty();
  fxList.push(FxState(1u32, FX_ZAP, 123456u64));
  var w = WorldState(4294967295u64, 1234.567, 10u32, 987654u64, beings, propList, fxList);
  let bytes = encodeState(&w);
  var back = WorldState(0u64, 0.0, 1u32, 0u64, List[BeingState].empty(), List[PropState].empty(), List[FxState].empty());
  let decoded = decodeState(copyBytes(&bytes), &mut back);
  ok = expect("a snapshot decodes", decoded && back.beings.len() == 2usize) && ok;
  if decoded && back.beings.len() == 2usize {
    let a = back.beings[0usize];
    let b = back.beings[1usize];
    ok = expect("its tick, scene time, clock rate and input sequence number", back.tick == 4294967295u64 && back.now == 1234.567
      && back.rate == 10u32 && back.appliedInput == 987654u64) && ok;
    ok = expect("a quantised position is within a millimetre", libc.fabsf(a.position.x + 23.4567) <= 0.0006 && libc.fabsf(a.position.y - 12.7891) <= 0.0006
      && libc.fabsf(a.position.z - 499.1234) <= 0.0006) && ok;
    ok = expect("its heading within 0.0001 radians, its speed within a millimetre a second", libc.fabsf(wrapPi(a.yaw - 3.0)) <= 0.0001
      && libc.fabsf(a.speed - 1.8) <= 0.001) && ok;
    ok = expect("its intents, ground, health, setdowns and landings", a.intents.ahead == 1. && a.intents.turn == -1. && a.intents.run && !a.intents.jump
      && a.grounded && libc.fabsf(a.health - 0.5) <= 0.003 && a.respawns == 3u32 && a.landings == 250u32
      && libc.fabsf(a.landSpeed - 7.5) <= 0.001 && a.platform.isNone() && !a.exact) && ok;
    ok = expect("a whole one comes back to the bit", b.exact && b.position.x == -10.123456 && b.position.y == 33.5 && b.position.z == 301.987654
      && b.yaw == -2.5 && b.speed == -1.8 && b.vy == -4.2 && b.airVx == 1.1 && b.airVz == -0.9 && !b.grounded && b.intents.jump
      && b.platform == idOf(21u32)) && ok;
    // The playground's props and spells ride in the snapshot
    ok = expect("two props and a spell in force come back", back.props.len() == 2usize && back.fx.len() == 1usize) && ok;
    if back.props.len() == 2usize && back.fx.len() == 1usize {
      let p0 = back.props[0usize];
      let p1 = back.props[1usize];
      ok = expect("a prop's slot and place to a millimetre", p0.slot == 0u32 && p1.slot == 7u32 && libc.fabsf(p0.position.x + 9.5) <= 0.0006
        && libc.fabsf(p0.position.y - 4.6) <= 0.0006 && libc.fabsf(p1.position.z - 300.5) <= 0.0006 && libc.fabsf(p1.position.x + 22.001) <= 0.0006) && ok;
      let sent = Quat.angleAxis(2.9, Vec3(1., 0., 0.));
      let dot = libc.fabsf(sent.x * p1.rotation.x + sent.y * p1.rotation.y + sent.z * p1.rotation.z + sent.w * p1.rotation.w);
      ok = expect("a prop's rotation within a fifth of a degree", dot > 0.999998) && ok;
      ok = expect("a spell's being, kind and the tick it began", back.fx[0usize].being == 1u32 && back.fx[0usize].kind == FX_ZAP
        && back.fx[0usize].start == 123456u64) && ok;
    }
  }
  // The playground's two messages: an action to the simulation, a burst to the view
  match decodeToSim(encodeToSim(ToSim.Play(PLAY_SPELL, SPELL_ZAP, 3u32, Vec3(1., 2., 3.), Vec3(0., 0.6, -0.8)))) {
    case let Play(pl) {
      ok = expect("an action comes back whole", pl.kind == PLAY_SPELL && pl.spell == SPELL_ZAP && pl.target == 3u32 && pl.eye.y == 2.
        && pl.dir.z == -0.8) && ok;
    }
    else { ok = expect("an action comes back whole", false) && ok; }
  }
  let burstBytes = encodeBurst(&BurstInfo(BURST_PAINT, 2u32, Vec3(0.1, 1.2, -0.3), Vec3(0., 0., 1.), 3u32, 99999u64));
  match decodeToView(burstBytes) {
    case let Burst(bu) {
      ok = expect("a burst comes back whole", bu.kind == BURST_PAINT && bu.being == 2u32 && bu.position.y == 1.2 && bu.normal.z == 1. && bu.color == 3u32
        && bu.tick == 99999u64) && ok;
    }
    else { ok = expect("a burst comes back whole", false) && ok; }
  }
  // A person sitting down on a seat, one standing up and one hailing cross with one pose byte more (and the seat and how far the sit
  // is), and a being doing none of it nothing more
  {
    var posedBeings = List[BeingState].empty();
    var sitting = BeingState(0u32, false, Vec3(-17.85, 0.6, 331.2), 3.1415927, 0., 0., 0., 0., true, Intents.none(), PartId.none(), 1., 0u32, 0u32, 0., 0u32, 0., false, noRots());
    sitting.seat = 3u32;
    sitting.sitT = 0.6;
    sitting.sitDown = true;
    posedBeings.push(sitting);
    var rising = BeingState(1u32, false, Vec3(-5., 3., 300.), 1.5, 0., 0., 0., 0., true, Intents.none(), PartId.none(), 1., 0u32, 0u32, 0., 0u32, 0., false, noRots());
    rising.seat = 1u32;
    rising.sitT = 0.25;
    rising.sitDown = false;
    posedBeings.push(rising);
    var hailer = BeingState(2u32, false, Vec3(-20., 4., 340.), 0.5, 1.8, 0., 0., 0., true, Intents(1., 0., false, false), PartId.none(), 1., 0u32, 0u32, 0., 0u32, 0., false, noRots());
    hailer.hail = 1.2;
    posedBeings.push(hailer);
    posedBeings.push(BeingState(3u32, false, Vec3(-20., 4., 345.), 0.5, 0., 0., 0., 0., true, Intents.none(), PartId.none(), 1., 0u32, 0u32, 0., 0u32, 0., false, noRots()));
    var posedState = WorldState(7u64, 1.0, 1u32, 1u64, posedBeings, List[PropState].empty(), List[FxState].empty());
    let posedBytes = encodeState(&posedState);
    var posedBack = WorldState(0u64, 0.0, 1u32, 0u64, List[BeingState].empty(), List[PropState].empty(), List[FxState].empty());
    let posedOk = decodeState(copyBytes(&posedBytes), &mut posedBack) && posedBack.beings.len() == 4usize;
    ok = expect("a snapshot with a sitter, a person standing up, a hailer and a walker decodes", posedOk) && ok;
    if posedOk {
      let s0 = posedBack.beings[0usize];
      let s1 = posedBack.beings[1usize];
      let s2 = posedBack.beings[2usize];
      let s3 = posedBack.beings[3usize];
      ok = expect("the sitter's seat, how far it has sat down, and that it is sitting down", s0.seat == 3u32 && libc.fabsf(s0.sitT - 0.6) < 0.005 && s0.sitDown && s0.hail < 0. && s0.mode == FIG_WALK) && ok;
      ok = expect("the one standing up: its seat, how far, and that it is getting up", s1.seat == 1u32 && libc.fabsf(s1.sitT - 0.25) < 0.005 && !s1.sitDown) && ok;
      ok = expect("the hailer: when it began, to a fiftieth of a second, and no seat", libc.fabsf(s2.hail - 1.2) < 0.02 && s2.seat == 0u32) && ok;
      ok = expect("a walker has neither (and no byte of it)", s3.seat == 0u32 && s3.hail < 0.) && ok;
    }
    // (the walker's bytes are what they were: a person doing neither costs nothing)
    var plain = List[BeingState].empty();
    plain.push(*posedBack.beings[3usize]);
    var plainState = WorldState(7u64, 1.0, 1u32, 1u64, plain, List[PropState].empty(), List[FxState].empty());
    var sittingOnly = List[BeingState].empty();
    sittingOnly.push(*posedBack.beings[0usize]);
    var sittingState = WorldState(7u64, 1.0, 1u32, 1u64, sittingOnly, List[PropState].empty(), List[FxState].empty());
    print <- "  a being: "; print <- encodeState(&plainState).len(); print <- " bytes of a snapshot; sitting: "; print <- encodeState(&sittingState).len(); print <- "\n";
    ok = expect("sitting costs a pose byte, the seat and the progress (three bytes) and a person standing or walking nothing",
      encodeState(&sittingState).len() == encodeState(&plainState).len() + 3usize) && ok;
  }
  // The input's sit and hail bits
  {
    var samples = List[InputSample].empty();
    var it = Intents(0.5, -1., true, false);
    it.sit = true;
    samples.push(InputSample(10u64, it, 0.25));
    var it2 = Intents(0., 0., false, false);
    it2.hail = true;
    samples.push(InputSample(11u64, it2, 0.));
    let bytes2 = encodeInput(&samples);
    var back2 = List[InputSample].empty();
    let okIn = decodeInput(copyBytes(&bytes2), &mut back2) && back2.len() == 2usize;
    ok = expect("an input batch carries the S and H keys: sit and hail", okIn && back2[0usize].intents.sit && !back2[0usize].intents.hail
      && back2[1usize].intents.hail && !back2[1usize].intents.sit && back2[0usize].intents.run) && ok;
  }
  // Forty beings are a snapshot of what size
  var many = List[BeingState].empty();
  k = 0u32;
  while k < 40u32 {
    many.push(BeingState(k, k == 0u32, Vec3(-23.4567, 12.7891, 499.1234), 3.0, 1.8, 0., 0., 0., true, Intents(1., 0., false, false),
      PartId.none(), 1., 0u32, 0u32, 0., 0u32, 0., false, noRots()));
    k = k + 1u32;
  }
  var manyState = WorldState(1u64, 1.0, 1u32, 1u64, many, List[PropState].empty(), List[FxState].empty());
  let big = encodeState(&manyState);
  print <- "  a snapshot of forty beings: "; print <- big.len(); print <- " bytes (the limit "; print <- MAX_LATEST; print <- ")\n";
  ok = expect("a snapshot of forty beings fits a packet", big.len() <= MAX_LATEST) && ok;
  // A ragdoll: its 14 bodies' rotations (4 bytes each), a get-up's time
  var spun = noRots();
  k = 0u32;
  while k < 14u32 {
    spun[usize.from(k)] = Quat.angleAxis(0.3 * f32.from(k) - 1.7, Vec3(0.3, 0.9, -0.2).normalize());
    k = k + 1u32;
  }
  var rag = List[BeingState].empty();
  rag.push(BeingState(0u32, false, Vec3(5., 3., 7.), 0.5, 0., -3., 0., 0., false, Intents.none(), PartId.none(), 0.75, 0u32, 1u32, 9., 1u32, 0., true, spun));
  rag.push(BeingState(1u32, false, Vec3(6., 0., 8.), 1.5, 0., 0., 0., 0., true, Intents.none(), PartId.none(), 0.75, 0u32, 1u32, 9., 2u32, 1.234, false, noRots()));
  let ragBytes = encodeState(&WorldState(5u64, 1.0, 1u32, 1u64, rag, List[PropState].empty(), List[FxState].empty()));
  var ragBack = WorldState(0u64, 0.0, 1u32, 0u64, List[BeingState].empty(), List[PropState].empty(), List[FxState].empty());
  let ragOk = decodeState(copyBytes(&ragBytes), &mut ragBack) && ragBack.beings.len() == 2usize;
  var spinErr = 0.f;
  if ragOk && ragBack.beings[0usize].hasRots {
    k = 0u32;
    while k < 14u32 {
      let q = ragBack.beings[0usize].rots[usize.from(k)];
      let p = spun[usize.from(k)];
      let d = libc.fabsf(q.x * p.x + q.y * p.y + q.z * p.z + q.w * p.w);
      let e = 2. * libc.acosf(if d > 1. { 1. } else { d });
      if e > spinErr { spinErr = e; }
      k = k + 1u32;
    }
  } else { spinErr = 9.; }
  print <- "  a ragdoll's snapshot: "; print <- ragBytes.len(); print <- " bytes for two beings, its rotations within "; print <- spinErr * 57.29578; print <- " degrees\n";
  ok = expect("a ragdoll's 14 rotations come back within 0.2 degrees, with its mode, and a get-up's time within a millisecond",
    ragOk && spinErr < 0.0035 && ragBack.beings[0usize].mode == 1u32 && ragBack.beings[1usize].mode == 2u32
    && libc.fabsf(ragBack.beings[1usize].modeT - 1.234) < 0.0011) && ok;
  // Forty ragdolls do not fit: the snapshot still fits a packet, the beings that did not get room come as walkers
  var limp = List[BeingState].empty();
  k = 0u32;
  while k < 40u32 {
    limp.push(BeingState(k, false, Vec3(5., 3., 7.), 0.5, 0., -3., 0., 0., false, Intents.none(), PartId.none(), 0.75, 0u32, 1u32, 9., 1u32, 0., true, spun));
    k = k + 1u32;
  }
  let limpBytes = encodeState(&WorldState(5u64, 1.0, 1u32, 1u64, limp, List[PropState].empty(), List[FxState].empty()));
  print <- "  a snapshot of forty ragdolls: "; print <- limpBytes.len(); print <- " bytes\n";
  ok = expect("a snapshot of forty ragdolls still fits a packet", limpBytes.len() <= MAX_LATEST) && ok;

  // The inputs: the last INPUT_MOST of them, numbered
  var samples = List[InputSample].empty();
  k = 0u32;
  while k < u32.from(INPUT_MOST) {
    samples.push(InputSample(1000u64 + u64.from(k), Intents(if k % 3u32 == 0u32 { 1. } else if k % 3u32 == 1u32 { -1. } else { 0. }, 0.5, k % 2u32 == 0u32,
      k % 5u32 == 0u32), if k % 4u32 == 0u32 { 1. } else { 0. }));
    k = k + 1u32;
  }
  let inputBytes = encodeInput(&samples);
  var inputBack = List[InputSample].empty();
  let inputOk = decodeInput(copyBytes(&inputBytes), &mut inputBack);
  var inputSame = inputOk && inputBack.len() == samples.len();
  var i = 0usize;
  while inputSame && i < samples.len() {
    let x = samples[i];
    let y = inputBack[i];
    inputSame = x.seq == y.seq && x.intents.ahead == y.intents.ahead && libc.fabsf(x.intents.turn - y.intents.turn) <= 0.005
      && x.intents.run == y.intents.run && x.intents.jump == y.intents.jump && x.lookKeys == y.lookKeys;
    i = i + 1usize;
  }
  print <- "  "; print <- samples.len(); print <- " input samples: "; print <- inputBytes.len(); print <- " bytes\n";
  ok = expect("an input batch comes back, its sequence numbers whole and its keys whole (an axis to 1/127)", inputSame && inputBytes.len() <= MAX_LATEST) && ok;

  // The messages to the simulation
  match decodeToSim(encodeToSim(ToSim.Click(idOf(77u32)))) {
    case let Click(c) { ok = expect("a click comes back", c.part == idOf(77u32)) && ok; }
    else { ok = expect("a click comes back", false) && ok; }
  }
  match decodeToSim(encodeToSim(ToSim.Command(COMMAND_WEATHER))) {
    case let Command(c) { ok = expect("a command comes back", c.kind == COMMAND_WEATHER) && ok; }
    else { ok = expect("a command comes back", false) && ok; }
  }
  match decodeToSim(encodeToSim(ToSim.Look(-0.25))) {
    case let Look(l) { ok = expect("a pitch comes back", l.pitch == -0.25) && ok; }
    else { ok = expect("a pitch comes back", false) && ok; }
  }
  var steps = List[Step].empty();
  steps.push(Step(41u64, 16666666u64, 0.016666666, 683333306u64, 1u32));
  match decodeToSim(encodeToSim(ToSim.Frame(77u64, steps))) {
    case let Frame(f) { ok = expect("a frame's steps come back", f.frame == 77u64 && f.steps.len() == 1usize && f.steps[0usize].index == 41u64
      && f.steps[0usize].dt == 0.016666666 && f.steps[0usize].startNs == 683333306u64) && ok; }
    else { ok = expect("a frame's steps come back", false) && ok; }
  }
  // Weather
  var wx = Weathering.fair();
  wx.goTo(WEATHER_RAIN, 100.0, 12.);
  match decodeToView(encodeWeather(&wx)) {
    case let Weather(q) { ok = expect("a weather change comes back", q.weather.same(&wx)) && ok; }
    else { ok = expect("a weather change comes back", false) && ok; }
  }
  // A scripted run's own
  let test = TestView(true, Pose.look(Vec3(1., 2., 3.), 0.5, 0.25), 0.9, String.from("sky-bird-1"));
  var testBack = TestView(false, Pose.look(Vec3(0., 0., 0.), 0., 0.), FOV, String.empty());
  ok = expect("a scripted view comes back", decodeTest(encodeTest(&test), &mut testBack) && testBack.fixedView && testBack.shot.view() == "sky-bird-1"
    && testBack.view.origin.z == 3. && testBack.fov == 0.9) && ok;

  // Nonsense is refused, never trusted
  var garbage = List[u8].empty();
  garbage.push(1u8);
  garbage.push(0u8);
  garbage.push(5u8);
  garbage.push(10u8);
  var state = WorldState(0u64, 0.0, 1u32, 0u64, List[BeingState].empty(), List[PropState].empty(), List[FxState].empty());
  ok = expect("a short or corrupt message is refused", !decodeState(copyBytes(&garbage), &mut state)
    && !decodeInput(copyBytes(&garbage), &mut inputBack)) && ok;
  match decodeToView(copyBytes(&garbage)) {
    case let Requests(q) { ok = expect("a corrupt batch of requests is refused", false) && ok; }
    else {}
  }
  ok
}
