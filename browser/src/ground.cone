// The ground's height, for whatever stands on it. Today the ground is flat
// (y = 0); T1's island will replace this one function with the terrain's,
// and nothing that asks (the mannequin's capsule, its feet, the third-person
// camera) changes. It answers for any (x, z) in metres.

pub fn groundHeight(x f32, z f32) f32 { 0.; }

// The highest ground under a capsule of 'radius' standing at (x, z): the
// centre and four points on its footprint ring, so a thin ridge cannot be
// straddled
pub fn footprintHeight(x f32, z f32, radius f32) f32 {
  mut top = groundHeight(x, z);
  imm a = groundHeight(x + radius, z);
  imm b = groundHeight(x - radius, z);
  imm c = groundHeight(x, z + radius);
  imm d = groundHeight(x, z - radius);
  if a > top { top = a; }
  if b > top { top = b; }
  if c > top { top = c; }
  if d > top { top = d; }
  top;
}
