// The ground's height, for whatever stands on it: the island's (src/island/
// island.cone), exact against the triangles the GPU draws, so a foot, a
// capsule or a camera meets the picture. It answers for any (x, z) in metres
// (past the island's grid, the sea floor); before the island is baked, 0.

pub fn groundHeight(isl &Island, x f32, z f32) f32 { islandHeight(isl, x, z); }

// The highest ground under a capsule of 'radius' standing at (x, z): the
// centre and four points on its footprint ring, so a thin ridge cannot be
// straddled
pub fn footprintHeight(isl &Island, x f32, z f32, radius f32) f32 {
  mut top = groundHeight(isl, x, z);
  imm a = groundHeight(isl, x + radius, z);
  imm b = groundHeight(isl, x - radius, z);
  imm c = groundHeight(isl, x, z + radius);
  imm d = groundHeight(isl, x, z - radius);
  if a > top { top = a; }
  if b > top { top = b; }
  if c > top { top = c; }
  if d > top { top = d; }
  top;
}
