  0.1442, 1.1203, 0.1442, 1.1271, 0.1441, 1.1340, 0.1441, 1.1409, 0.1440, 1.1478, 0.1440, 1.1546,
  0.1439, 1.1615, 0.1435, 1.1684, 0.1452, 1.1753, 0.1469, 1.1821, 0.1486, 1.1890, 0.1512, 1.1959,
  0.1546, 1.2027, 0.1576, 1.2096, 0.1619, 1.2165, 0.1671, 1.2234, 0.1778, 1.2302, 0.1946, 1.2371,
  0.1976, 1.2440, 0.1972, 1.2509, 0.2023, 1.2577, 0.2101, 1.2646, 0.2036, 1.2715, 0.2096, 1.2784,
  0.2049, 1.2852, 0.1856, 1.2921, 0.1615, 1.2990, 0.1538, 1.3058, 0.1413, 1.3127, 0.1198, 1.3196,
  0.1035, 1.3265, 0.0881, 1.3333, 0.0747, 1.3402, 0.0601, 1.3471, 0.0438, 1.3540, 0.0335, 1.3608,
  0.0275, 1.3677, 0.0241, 1.3746, 0.0223, 1.3814, 0.0206, 1.3883, 0.0206, 1.3952, 0.0137, 1.4021,
  0.0137, 1.4089, 0.0198, 1.4158, 0.0232, 1.4227, 0.0232, 1.4296, 0.0223, 1.4364, 0.0206, 1.4433,
  0.0189, 1.4502, 0.0155, 1.4570, 0.0112, 1.4639, 0.0086, 1.4708, 0.0043, 1.4777];

// The handle's traced centreline (radius, height), from the neck to the shoulder
imm HANDLE_LINE Array[f32, 20] = [
  0.1418, 1.1306, 0.1589, 1.1478, 0.1847, 1.1589, 0.2105, 1.1495, 0.2165, 1.1263, 0.2165, 1.0962,
  0.2165, 1.0447, 0.2148, 0.9931, 0.2105, 0.9716, 0.1933, 0.9519];

// The lid rim's stretch smoothed: the heights between which a radius is
// replaced by the 1-2-1 mean of it and its neighbours (the trace's own)
const RIM_FROM f32 = 1.243;
const RIM_TO f32 = 1.286;

// The outline as lathed: the axis, the underside, the trace (its rim
// smoothed), the tip
fn amphoraOutline() List[Vec2] {
  mut pts = List[Vec2].withCapacity(218usize);
  pts.push(p2(0., 0.));
  pts.push(p2(0.1448, 0.));
  imm n = 215usize;
  mut i = 0usize;
  while i < n {
    imm r = AMPHORA_OUTLINE[2usize * i];
    imm y = AMPHORA_OUTLINE[2usize * i + 1usize];
    if y > RIM_FROM and y < RIM_TO {
      imm before = AMPHORA_OUTLINE[2usize * i - 2usize];
      imm after = AMPHORA_OUTLINE[2usize * i + 2usize];
      pts.push(p2(0.25 * before + 0.5 * r + 0.25 * after, y));
    } else {
      pts.push(p2(r, y));
    }
    i = i + 1usize;
  }
  pts.push(p2(0., AMPHORA_TIP));
  pts;
}

// ---- Where a point of the outline is ----

// The outline walked by its length: each point's distance along it
struct Outline {
  pub pts List[Vec2];
  pub along List[f32];
  pub length f32;

  pub fn make() Outline {
    imm pts = amphoraOutline();
    mut along = List[f32].withCapacity(pts.len());
    mut s = 0.;
    along.push(0.);
    mut i = 1usize;
    while i < pts.len() {
      s = s + (*pts[i]).distance(*pts[i - 1usize]);
      along.push(s);
      i = i + 1usize;
    }
    new Outline(pts, along, s);
  }

  // The point 's' metres along it (radius, height)
  pub fn at(self &, s f32) Vec2 {
    mut i = 1usize;
    while i + 1usize < pts.len() and *along[i] < s { i = i + 1usize; }
    imm s0 = *along[i - 1usize];
    imm s1 = *along[i];
    imm t = if s1 > s0 { clampF((s - s0) / (s1 - s0), 0., 1.); } else { 0.; };
    (*pts[i - 1usize]).lerp(*pts[i], t);
  }

  // How far along it the outline first reaches height 'y'
  pub fn alongAt(self &, y f32) f32 {
    mut i = 2usize;
    while i + 1usize < pts.len() and (*pts[i]).y < y { i = i + 1usize; }
    imm a = *pts[i - 1usize];
    imm b = *pts[i];
    imm t = if b.y > a.y { clampF((y - a.y) / (b.y - a.y), 0., 1.); } else { 0.; };
    *along[i - 1usize] + (*along[i] - *along[i - 1usize]) * t;
  }
}

// ---- The paint ----

// The colours, sRGB 0 to 1, and their roughness: black glaze, terracotta,
// red, cream, the bud's olive grey
const GLAZE = 0u32;
const CLAY = 1u32;
const RED = 2u32;
const CREAM = 3u32;
const OLIVE = 4u32;
imm VASE_COLOURS Array[f32, 15] = [0.125, 0.10, 0.09, 0.81, 0.55, 0.34, 0.50, 0.20, 0.16, 0.89, 0.80, 0.64,
  0.50, 0.48, 0.41];
imm VASE_ROUGHNESS Array[f32, 5] = [0.28, 0.8, 0.6, 0.75, 0.7];

// Where the patterns sit along the outline, found once
struct PaintMarks {
  pub dots f32;               // the neck's chain of dots
  pub tongueEnd f32;          // the tongues' rounded ends
  pub rayBase f32;            // the rays' bases
  pub rayTip f32;             // and their points
}

fn near(x f32, at f32, half f32) bool { x > at - half and x < at + half; }

// The paint at 'u' round (0 at +x, a whole turn to 1) and the outline's
// point 's' metres along it, at radius 'r' and height 'y': the band the
// height falls in (the trace's table), and in it the pattern. Distances
// across the surface are r times the angle; along it, s.
fn vasePaint(u f32, s f32, r f32, y f32, marks &PaintMarks) u32 {
  if y >= 1.433 { return OLIVE; }                                   // the bud
  if y >= 1.404 { return RED; }                                     // the knob
  if y >= 1.393 { return GLAZE; }                                   // the collar ring
  if y >= 1.364 {                                                   // the lid's top
    if near(y, 1.372, 0.0012) or near(y, 1.385, 0.0012) { return CREAM; }
    return RED;
  }
  if y >= 1.307 {                                                   // the lid's cone
    if y >= 1.337 and y < 1.343 { return RED; }
    if y >= 1.31 and y < 1.33 { return CLAY; }
    return GLAZE;
  }
  if y >= 1.161 { return GLAZE; }                                   // the lid's rim, the lip, the upper neck
  if y >= 1.070 {                                                   // the neck's band
    if y < 1.0735 or y > 1.1575 { return GLAZE; }
    // A chain of red dots, 48 round, on a thin dark line
    imm pitch = 2. * pi * r / 48.;
    imm dx = (fract(u * 48.) - 0.5) * pitch;
    imm ds = s - marks.dots;
    if dx * dx + ds * ds < 0.0045 * 0.0045 { return RED; }
    if near(ds, 0., 0.0008) { return GLAZE; }
    return CLAY;
  }
  if y >= 1.060 { return GLAZE; }                                   // a ring
  if y >= 1.038 {
    if near(y, 1.048, 0.0012) { return CREAM; }
    return CLAY;
  }
  if y >= 1.015 { return GLAZE; }                                   // the neck's foot
  if y >= 0.875 {
    // The tongues: 64 round, black and red by turns, hanging from the
    // ring above, each three quarters of its slot wide, its end rounded
    imm slot = 2. * pi * r / 64.;
    imm k = u32.from(libc.floorf(u * 64.));
    imm dx = (fract(u * 64.) - 0.5) * slot;
    imm half = 0.38 * slot;
    imm ds = s - marks.tongueEnd;
    if ds < 0. { return CLAY; }
    imm inside = if ds >= half { libc.fabsf(dx) <= half; } else { dx * dx + (ds - half) * (ds - half) <= half * half; };
    if !inside { return CLAY; }
    return if k % 2u32 == 0u32 { GLAZE; } else { RED; };
  }
  if y >= 0.856 {                                                   // two thin lines: the panels' top
    if near(y, 0.8605, 0.0013) or near(y, 0.8695, 0.0013) { return GLAZE; }
    return CLAY;
  }
  if y >= 0.323 {
    // The panels, front and back (+z and -z: a quarter and three quarters
    // round), 67 degrees each way from their middles: a thin dark frame line
    // 6 mm in from each side, black glaze beyond them, under the handles
    imm deg = u * 360.;
    imm off = libc.fabsf(deg - 180. * libc.floorf(deg / 180.) - 90.);
    imm inside = (67. - off) * pi / 180. * r;
    if inside < 0. { return GLAZE; }
    if inside > 0.006 and inside < 0.0085 { return GLAZE; }
    return CLAY;
  }
  if y >= 0.312 {                                                   // a thin dark line
    if near(y, 0.3175, 0.0015) { return GLAZE; }
    return CLAY;
  }
  if y >= 0.223 { return GLAZE; }                                   // the broad band
  if y >= 0.183 {
    if near(y, 0.21, 0.0013) { return RED; }
    return CLAY;
  }
  if y >= 0.121 {
    if y > 0.1805 { return GLAZE; }                                 // a thin line over them
    // The rays: 24 round, black and red by turns, their bases at the
    // bottom, widest a third of the way up, pointed at the top
    imm t = clampF((s - marks.rayBase) / (marks.rayTip - marks.rayBase), 0., 1.);
    imm k = u32.from(libc.floorf(u * 24.));
    imm half = 0.42 * sin(pi * (0.2 + 0.8 * t));
    if libc.fabsf(fract(u * 24.) - 0.5) > half { return CLAY; }
    return if k % 2u32 == 0u32 { GLAZE; } else { RED; };
  }
  if y >= 0.115 { return GLAZE; }
  if y >= 0.104 { return CREAM; }
  if y >= 0.076 { return RED; }                                     // the stem's band
  if y >= 0.069 { return CREAM; }
  GLAZE;                                                            // the foot
}

// The paint (sRGB) and the ORM map (occlusion 1, the colour's roughness,
// not metal), PAINT_ROUND by PAINT_ALONG, each texel the mean of 2 x 2
// samples; 'outline' is the lathe's, which its uv's v follows
fn vaseImages(outline &Outline, paint &mut Image, orm &mut Image) {
  imm w = PAINT_ROUND;
  imm h = PAINT_ALONG;
  imm marks = new PaintMarks(outline.alongAt(1.1115), outline.alongAt(0.882), outline.alongAt(0.121),
    outline.alongAt(0.1795));
  mut colour = List[u8].withCapacity(usize.from(w * h * 3));
  colour.resize(usize.from(w * h * 3), 0u8);
  mut rough = List[u8].withCapacity(usize.from(w * h * 3));
  rough.resize(usize.from(w * h * 3), 0u8);
  // each row of the parallel loop writes only its own texels, through raw pointers
  imm colourOut = colour.viewMut() as *u8;
  imm roughOut = rough.viewMut() as *u8;
  parallel each y in 0 < h {
    // The two rows of samples' places on the outline
    imm sa = (f32.from(y) + 0.25) / f32.from(h) * outline.length;
    imm sb = (f32.from(y) + 0.75) / f32.from(h) * outline.length;
    imm pa = outline.at(sa);
    imm pb = outline.at(sb);
    mut x = 0;
    while x < w {
      mut sum Array[f32, 4] = [0., 0., 0., 0.];
      mut k = 0;
      while k < 4 {
        imm u = (f32.from(x) + 0.25 + 0.5 * f32.from(k % 2)) / f32.from(w);
        imm c = if k < 2 { vasePaint(u, sa, pa.x, pa.y, &marks); } else { vasePaint(u, sb, pb.x, pb.y, &marks); };
        imm i = usize.from(c) * 3usize;
        sum[0usize] = sum[0usize] + VASE_COLOURS[i];
        sum[1usize] = sum[1usize] + VASE_COLOURS[i + 1usize];
        sum[2usize] = sum[2usize] + VASE_COLOURS[i + 2usize];
        sum[3usize] = sum[3usize] + VASE_ROUGHNESS[usize.from(c)];
        k = k + 1;
      }
      imm at = usize.from(y * w + x) * 3usize;
      *(colourOut + at) = u8.from(sum[0usize] * 0.25 * 255. + 0.5);
      *(colourOut + at + 1usize) = u8.from(sum[1usize] * 0.25 * 255. + 0.5);
      *(colourOut + at + 2usize) = u8.from(sum[2usize] * 0.25 * 255. + 0.5);
      *(roughOut + at) = 255u8;
      *(roughOut + at + 1usize) = u8.from(sum[3usize] * 0.25 * 255. + 0.5);
      x = x + 1;
    }
  }
  *paint = new Image(w, h, 3, colour);
  *orm = new Image(w, h, 3, rough);
}

// ---- The handles ----

// A Catmull-Rom curve through 'pts' (uniform), 'per' points a span, the
// ends' spans reaching the first and last points
fn catmullRom(pts &List[Vec3], per u32) List[Vec3] {
  mut out = List[Vec3].empty();
  imm n = pts.len();
  mut i = 0usize;
  while i + 1usize < n {
    imm p0 = if i == 0usize { *pts[0usize] * 2. - *pts[1usize]; } else { *pts[i - 1usize]; };
    imm p1 = *pts[i];
    imm p2v = *pts[i + 1usize];
    imm p3 = if i + 2usize < n { *pts[i + 2usize]; } else { *pts[i + 1usize] * 2. - *pts[i]; };
    mut k = 0u32;
    while k < per {
      imm t = f32.from(k) / f32.from(per);
      imm t2 = t * t;
      imm t3 = t2 * t;
      out.push((p1 * 2. + (p2v - p0) * t + (p0 * 2. - p1 * 5. + p2v * 4. - p3) * t2 + (p1 * 3. - p0 - p2v * 3. + p3) * t3) * 0.5);
      k = k + 1u32;
    }
    i = i + 1usize;
  }
  out.push(*pts[n - 1usize]);
  out;
}

// One handle, in the plane through the axis at +x: the traced centreline,
// carried on into the jar at both ends along its own direction there, swept
// with a round tube, capped
fn handleMesh() mesh.Mesh {
  mut line = List[Vec3].empty();
  mut i = 0usize;
  while i < 10usize {
    line.push(v(HANDLE_LINE[2usize * i], HANDLE_LINE[2usize * i + 1usize], 0.));
    i = i + 1usize;
  }
  imm first = *line[0usize];
  imm last = *line[9usize];
  imm into0 = (first - *line[1usize]).normalize();
  imm into1 = (last - *line[8usize]).normalize();
  mut pts = List[Vec3].empty();
  pts.push(first + into0 * HANDLE_BURY);
  i = 0usize;
  while i < 10usize { pts.push(*line[i]); i = i + 1usize; }
  pts.push(last + into1 * HANDLE_BURY);
  imm curve = catmullRom(&pts, 8u32);
  imm path = Path.fromPoints(curve.view(), false);
  imm tube = Profile.polygon(24u32, HANDLE_RADIUS);
  imm swept = sweep(&tube, &path, 0., 1., 1., true);
  swept.triangulate(true);
}

// ---- The amphora ----

pub struct AmphoraStats {
  pub latheMs f64;
  pub handlesMs f64;
  pub paintMs f64;
}
mut amphoraStats AmphoraStats = new AmphoraStats(0d, 0d, 0d);

// The milliseconds from performance counter 'a' to 'b'
fn msBetween(a u64, b u64) f64 { f64.from(b - a) / f64.from(sdl.GetPerformanceFrequency()) * 1000d; }

// The amphora's one part into 'h': the jar and its handles as one mesh,
// painted, glossy where glazed
fn hydrateAmphora(h &mut Hydrated, at Transform3) {
  imm t0 = sdl.GetPerformanceCounter();
  imm outline = Outline.make();
  imm profile = Profile.fromPoints(outline.pts.view(), false);
  imm jar = lathe(&profile, up(), 2. * pi, AMPHORA_STEPS);
  mut m = jar.triangulate(true);
  imm t1 = sdl.GetPerformanceCounter();
  // The handles, at +x and at -x, glazed black: their uvs on the foot's black
  imm glaze = new Vec2(0.5, outline.alongAt(0.03) / outline.length);
  mut k = 0;
  while k < 2 {
    mut handle = handleMesh();
    if k == 1 { handle.transform(Mat4.fromQuat(Quat.angleAxis(pi, up()))); }
    handle.uvs.clear();
    mut j = 0usize;
    while j < handle.positions.len() { handle.uvs.push(glaze); j = j + 1usize; }
    m.append(&handle);
    k = k + 1;
  }
  imm t2 = sdl.GetPerformanceCounter();
  mut paint = Image.empty();
  mut orm = Image.empty();
  vaseImages(&outline, &mut paint, &mut orm);
  imm t3 = sdl.GetPerformanceCounter();
  amphoraStats = new AmphoraStats(msBetween(t0, t1), msBetween(t1, t2), msBetween(t2, t3));
  h.addMapped("amphora", m, Look.physicallyBased(new Color(1., 1., 1., 1.), 1., 0.), paint, Maps.images(Image.empty(), orm), at);
}
