  0.2577, 0.3368, 0.2607, 0.3436, 0.2642, 0.3505, 0.2672, 0.3574, 0.2706, 0.3643, 0.2732, 0.3711,
  0.2766, 0.3780, 0.2792, 0.3849, 0.2818, 0.3918, 0.2848, 0.3986, 0.2869, 0.4055, 0.2895, 0.4124,
  0.2921, 0.4192, 0.2947, 0.4261, 0.2964, 0.4330, 0.2985, 0.4399, 0.3007, 0.4467, 0.3028, 0.4536,
  0.3050, 0.4605, 0.3067, 0.4674, 0.3084, 0.4742, 0.3101, 0.4811, 0.3119, 0.4880, 0.3131, 0.4948,
  0.3149, 0.5017, 0.3162, 0.5086, 0.3174, 0.5155, 0.3187, 0.5223, 0.3204, 0.5292, 0.3213, 0.5361,
  0.3230, 0.5430, 0.3239, 0.5498, 0.3243, 0.5567, 0.3256, 0.5636, 0.3269, 0.5704, 0.3273, 0.5773,
