  0.3329, 0.6254, 0.3329, 0.6323, 0.3338, 0.6392, 0.3338, 0.6460, 0.3346, 0.6529, 0.3351, 0.6598,
  0.3355, 0.6667, 0.3359, 0.6735, 0.3359, 0.6804, 0.3363, 0.6873, 0.3363, 0.6942, 0.3363, 0.7010,
  0.3363, 0.7079, 0.3368, 0.7148, 0.3363, 0.7216, 0.3363, 0.7285, 0.3363, 0.7354, 0.3359, 0.7423,
  0.3355, 0.7491, 0.3351, 0.7560, 0.3338, 0.7629, 0.3329, 0.7698, 0.3316, 0.7766, 0.3308, 0.7835,
  0.3295, 0.7904, 0.3282, 0.7973, 0.3269, 0.8041, 0.3252, 0.8110, 0.3239, 0.8179, 0.3213, 0.8247,
  0.3179, 0.8316, 0.3153, 0.8385, 0.3123, 0.8454, 0.3084, 0.8522, 0.3058, 0.8591, 0.2994, 0.8660,
  0.2938, 0.8729, 0.2869, 0.8797, 0.2805, 0.8866, 0.2728, 0.8935, 0.2650, 0.9003, 0.2599, 0.9072,
  0.2560, 0.9141, 0.2521, 0.9210, 0.2496, 0.9278, 0.2419, 0.9347, 0.2316, 0.9416, 0.2189, 0.9485,
  0.2048, 0.9553, 0.1903, 0.9622, 0.1764, 0.9691, 0.1639, 0.9759, 0.1542, 0.9828, 0.1452, 0.9897,
  0.1383, 0.9966, 0.1332, 1.0034, 0.1280, 1.0103, 0.1229, 1.0172, 0.1198, 1.0241, 0.1198, 1.0309,
