// The labyrinth's geometry kit: boxes, walls with doorways, lathed columns, stairs, frescoed bands and panels,
// light wells and braziers. Every piece is made from the plan's numbers (labrooms.cone), and the collision it
// stands for (the world's Solids) comes out of the same call, so the picture and the walls cannot disagree.
//
// The kit builds meshes into slots, one slot a material (LM_), and the solids into one list. A run that wants only
// the solids (the simulation, which draws nothing) passes 'want' false and the meshes are not made.

// The mesh slots, one for each material the labyrinth is drawn in
pub const LM_FLOOR = 0usize;           // flagstones
pub const LM_PLASTER_RED = 1usize;     // lime plaster, tinted ochre red
pub const LM_PLASTER_OCHRE = 2usize;   // tinted yellow ochre
pub const LM_PLASTER_CREAM = 3usize;   // tinted lime white
pub const LM_ASHLAR = 4usize;          // dressed gypsum blocks
pub const LM_CEILING = 5usize;         // dark timber
pub const LM_COL_RED = 6usize;         // the columns' shafts
pub const LM_BLACK = 7usize;           // capitals, bases, lintels (near black)
pub const LM_BAND = 8usize;            // the rosette bands' tile
pub const LM_SPIRAL = 9usize;          // the spirals' and the waves' tile
pub const LM_DOLPHIN = 10usize;
pub const LM_GRIFFIN = 11usize;
pub const LM_LILY = 12usize;
pub const LM_GYPSUM = 13usize;         // the throne, the benches, the stairs' parapets
pub const LM_SKY = 14usize;            // the light wells' daylight (glows)
pub const LM_FLAME = 15usize;          // the braziers' flames (glow)
pub const LM_BRONZE = 16usize;         // braziers and bowls
pub const LM_BANNER_BLUE = 17usize;
pub const LM_BANNER_OCHRE = 18usize;
pub const LM_COUNT = 19usize;

// A light the labyrinth places: where, and what
pub struct LabLamp {
  pub at Vec3;
  pub look LightLook;
}

pub struct LabGeo {
  pub meshes List[mesh.Mesh];
  pub solids List[Solid];
  pub lamps List[LabLamp];
  pub want bool;
  // What the navigation mesh is made of (labnav.cone): the level tops a body walks on, as rectangles (x0, z0, x1, z1) at a height each,
  // the circles it must go round (x, z, radius), and the boxes (x0, z0, x1, z1)
  pub tops List[Vec4];
  pub topY List[f32];
  pub circles List[Vec3];
  pub boxes List[Vec4];
  // The pieces of glass (glassware.cone), each a part of its own in a glass look: only made when the meshes are wanted
  pub glass List[GlassPiece];

  pub fn make(want bool) LabGeo {
    mut ms = List[mesh.Mesh].empty();
    mut i = 0usize;
    while i < LM_COUNT { ms.push(mesh.Mesh.empty()); i = i + 1usize; }
    new LabGeo(ms, List[Solid].empty(), List[LabLamp].empty(), want, List[Vec4].empty(), List[f32].empty(), List[Vec3].empty(), List[Vec4].empty(),
      List[GlassPiece].empty());
  }

  // A level top to walk on: the rectangle at height y
  pub fn top(self &mut, x0 f32, z0 f32, x1 f32, z1 f32, y f32) {
    tops.push(new Vec4(x0, z0, x1, z1));
    topY.push(y);
  }
}

// ---- Solids ----

fn lgSolid(g &mut LabGeo, x0 f32, x1 f32, y0 f32, y1 f32, z0 f32, z1 f32) {
  g.solids.push(Solid.box(x0, z0, x1, z1, y0, y1));
}

// ---- Primitive meshes ----

// A box in slot 'slot', uvs in tiles of 'tile' metres; and its solid if 'solid'
fn lgBox(g &mut LabGeo, slot usize, solid bool, x0 f32, x1 f32, y0 f32, y1 f32, z0 f32, z1 f32, tile f32) {
  if g.want {
    imm m = &mut g.meshes[slot];
    ctBoxT(m, x0, x1, y0, y1, z0, z1, tile);
  }
  if solid { lgSolid(g, x0, x1, y0, y1, z0, z1); }
}

// A quad a, b, c, d (counterclockwise seen from the side its normal is on), with explicit uvs
fn lgQuadUV(m &mut mesh.Mesh, a Vec3, b Vec3, c Vec3, d Vec3, ua Vec2, ub Vec2, uc Vec2, ud Vec2) {
  imm n = (b - a).cross(c - a).normalize();
  imm base = u32.from(m.positions.len());
  m.positions.push(a); m.positions.push(b); m.positions.push(c); m.positions.push(d);
  m.normals.push(n); m.normals.push(n); m.normals.push(n); m.normals.push(n);
  m.uvs.push(ua); m.uvs.push(ub); m.uvs.push(uc); m.uvs.push(ud);
  m.indices.push(base); m.indices.push(base + 1u32); m.indices.push(base + 2u32);
  m.indices.push(base); m.indices.push(base + 2u32); m.indices.push(base + 3u32);
}

// A quad from the horizontal run p0 to p1 (at heights y0 up to y1) facing 'out' (a horizontal unit vector), its uvs
// u0 to u1 along it and v0 to v1 up it
fn lgFaceUV(m &mut mesh.Mesh, p0 Vec3, p1 Vec3, y0 f32, y1 f32, out Vec3, u0 f32, u1 f32, v0 f32, v1 f32) {
  imm a = new Vec3(p0.x, y0, p0.z);
  imm b = new Vec3(p1.x, y0, p1.z);
  imm c = new Vec3(p1.x, y1, p1.z);
  imm d = new Vec3(p0.x, y1, p0.z);
  imm n = (b - a).cross(c - a);
  if n.dot(out) >= 0. {
    lgQuadUV(m, a, b, c, d, new Vec2(u0, v0), new Vec2(u1, v0), new Vec2(u1, v1), new Vec2(u0, v1));
  } else {
    lgQuadUV(m, b, a, d, c, new Vec2(u1, v0), new Vec2(u0, v0), new Vec2(u0, v1), new Vec2(u1, v1));
  }
}

// ---- A lathed solid: a profile of (radius, height) points turned about the vertical axis at (cx, cy, cz) ----
fn lgLathe(m &mut mesh.Mesh, pts &List[Vec2], seg i32, cx f32, cy f32, cz f32, scale f32) {
  imm n = pts.len();
  // each profile segment's outward normal in (r, y)
  mut nr = List[Vec2].empty();
  mut k = 0usize;
  while k + 1usize < n {
    imm a = *pts[k];
    imm b = *pts[k + 1usize];
    imm dr = b.x - a.x;
    imm dy = b.y - a.y;
    imm len = libc.sqrtf(dr * dr + dy * dy);
    if len < 0.00001 { nr.push(new Vec2(1., 0.)); } else { nr.push(new Vec2(dy / len, 0. - dr / len)); }
    k = k + 1usize;
  }
  k = 0usize;
  while k + 1usize < n {
    imm a = *pts[k];
    imm b = *pts[k + 1usize];
    imm nk = *nr[k];
    // the normal at each end: smoothed with the neighbouring segment's if the profile turns gently
    mut na = nk;
    if k > 0usize {
      imm np = *nr[k - 1usize];
      if np.x * nk.x + np.y * nk.y > 0.7 { na = new Vec2(np.x + nk.x, np.y + nk.y); }
    }
    mut nb = nk;
    if k + 2usize < n {
      imm nn = *nr[k + 1usize];
      if nn.x * nk.x + nn.y * nk.y > 0.7 { nb = new Vec2(nn.x + nk.x, nn.y + nk.y); }
    }
    imm la = libc.sqrtf(na.x * na.x + na.y * na.y);
    imm lb = libc.sqrtf(nb.x * nb.x + nb.y * nb.y);
    na = new Vec2(na.x / la, na.y / la);
    nb = new Vec2(nb.x / lb, nb.y / lb);
    mut j = 0;
    while j < seg {
      imm t0 = 2. * 3.1415927 * f32.from(j) / f32.from(seg);
      imm t1 = 2. * 3.1415927 * f32.from(j + 1) / f32.from(seg);
      imm c0 = libc.cosf(t0); imm s0 = libc.sinf(t0);
      imm c1 = libc.cosf(t1); imm s1 = libc.sinf(t1);
      imm a0 = new Vec3(cx + a.x * scale * c0, cy + a.y * scale, cz + a.x * scale * s0);
      imm a1 = new Vec3(cx + a.x * scale * c1, cy + a.y * scale, cz + a.x * scale * s1);
      imm b0 = new Vec3(cx + b.x * scale * c0, cy + b.y * scale, cz + b.x * scale * s0);
      imm b1 = new Vec3(cx + b.x * scale * c1, cy + b.y * scale, cz + b.x * scale * s1);
      imm base = u32.from(m.positions.len());
      m.positions.push(a0); m.positions.push(a1); m.positions.push(b1); m.positions.push(b0);
      m.normals.push(new Vec3(na.x * c0, na.y, na.x * s0)); m.normals.push(new Vec3(na.x * c1, na.y, na.x * s1));
      m.normals.push(new Vec3(nb.x * c1, nb.y, nb.x * s1)); m.normals.push(new Vec3(nb.x * c0, nb.y, nb.x * s0));
      imm u0 = f32.from(j) / f32.from(seg);
      imm u1 = f32.from(j + 1) / f32.from(seg);
      m.uvs.push(new Vec2(u0, a.y)); m.uvs.push(new Vec2(u1, a.y)); m.uvs.push(new Vec2(u1, b.y)); m.uvs.push(new Vec2(u0, b.y));
      // winding by the diagonals' cross against the outward normal
      imm face = (b1 - a0).cross(b0 - a1);
      imm outward = new Vec3(nk.x * (c0 + c1) * 0.5, nk.y, nk.x * (s0 + s1) * 0.5);
      if face.dot(outward) >= 0. {
        m.indices.push(base); m.indices.push(base + 1u32); m.indices.push(base + 2u32);
        m.indices.push(base); m.indices.push(base + 2u32); m.indices.push(base + 3u32);
      } else {
        m.indices.push(base); m.indices.push(base + 2u32); m.indices.push(base + 1u32);
        m.indices.push(base); m.indices.push(base + 3u32); m.indices.push(base + 2u32);
      }
      j = j + 1;
    }
    k = k + 1usize;
  }
}

fn pt(r f32, y f32) Vec2 { new Vec2(r, y); }

// ---- A Minoan column: wider at the top, a black cushion capital under a square abacus, standing on a black base ----
// 'y0' the floor, 's' the scale (1 is 3.5 m tall: 0.45 across at the foot, 0.55 at the top of the shaft)
pub fn lgColumn(g &mut LabGeo, x f32, y0 f32, z f32, s f32) {
  if g.want {
    mut shaft = List[Vec2].empty();
    shaft.push(pt(0.225, 0.1)); shaft.push(pt(0.275, 3.05));
    imm red = &mut g.meshes[LM_COL_RED];
    lgLathe(red, &shaft, 20, x, y0, z, s);
    mut black = List[Vec2].empty();
    // the base: a low black drum, its top turned in to the shaft
    black.push(pt(0.0, 0.0)); black.push(pt(0.33, 0.0)); black.push(pt(0.33, 0.09)); black.push(pt(0.26, 0.10)); black.push(pt(0.225, 0.1));
    lgLathe(&mut g.meshes[LM_BLACK], &black, 20, x, y0, z, s);
    mut cap = List[Vec2].empty();
    // the neck ring and the cushion (the echinus), bulging out and in under the abacus
    cap.push(pt(0.275, 3.05)); cap.push(pt(0.30, 3.07)); cap.push(pt(0.30, 3.12)); cap.push(pt(0.335, 3.15)); cap.push(pt(0.375, 3.2));
    cap.push(pt(0.395, 3.26)); cap.push(pt(0.385, 3.32)); cap.push(pt(0.34, 3.36)); cap.push(pt(0.0, 3.36));
    lgLathe(&mut g.meshes[LM_BLACK], &cap, 20, x, y0, z, s);
    imm h = 0.34 * s;
    ctBoxT(&mut g.meshes[LM_BLACK], x - h, x + h, y0 + 3.36 * s, y0 + 3.5 * s, z - h, z + h, 1.);
  }
  g.solids.push(Solid.circle(x, z, 0.29 * s, y0 - 0.5, y0 + 3.5 * s));
  g.circles.push(new Vec3(x, z, 0.29 * s));
}

// A square pillar of dressed gypsum 'w' across and 'h' tall, a red band round its top, a black plinth and cap
pub fn lgPillar(g &mut LabGeo, x f32, y0 f32, z f32, w f32, h f32) {
  imm a = w * 0.5;
  lgBox(g, LM_GYPSUM, false, x - a, x + a, y0 + 0.2, y0 + h - 0.5, z - a, z + a, 1.8);
  lgBox(g, LM_BLACK, false, x - a - 0.08, x + a + 0.08, y0, y0 + 0.2, z - a - 0.08, z + a + 0.08, 1.);
  lgBox(g, LM_COL_RED, false, x - a - 0.03, x + a + 0.03, y0 + h - 0.5, y0 + h - 0.2, z - a - 0.03, z + a + 0.03, 1.);
  lgBox(g, LM_BLACK, false, x - a - 0.12, x + a + 0.12, y0 + h - 0.2, y0 + h, z - a - 0.12, z + a + 0.12, 1.);
  lgSolid(g, x - a - 0.08, x + a + 0.08, y0 - 0.5, y0 + h, z - a - 0.08, z + a + 0.08);
  g.boxes.push(new Vec4(x - a - 0.08, z - a - 0.08, x + a + 0.08, z + a + 0.08));
}

// ---- Walls ----

// A slab of a wall in its own plane: 'alongX' true, the wall runs along x, standing across z from 'c0' to 'c1'; false, along z,
// across x. From 'a' to 'b' along it, 'y0' to 'y1', its first half (the lower perpendicular coordinates) in slot 'low' and its
// second in 'high'. Solid as a whole.
fn lgSlab(g &mut LabGeo, alongX bool, c0 f32, c1 f32, a f32, b f32, y0 f32, y1 f32, low usize, high usize, solid bool) {
  imm mid = (c0 + c1) * 0.5;
  if alongX {
    lgBox(g, low, false, a, b, y0, y1, c0, mid, 2.);
    lgBox(g, high, false, a, b, y0, y1, mid, c1, 2.);
    if solid { lgSolid(g, a, b, y0, y1, c0, c1); }
  } else {
    lgBox(g, low, false, c0, mid, y0, y1, a, b, 2.);
    lgBox(g, high, false, mid, c1, y0, y1, a, b, 2.);
    if solid { lgSolid(g, c0, c1, y0, y1, a, b); }
  }
}

// A doorway in a wall: its middle along the wall, its width and its height above the floor
pub struct LabDoor {
  pub at f32;
  pub w f32;
  pub h f32;
}

fn dr(at f32, w f32, h f32) LabDoor { new LabDoor(at, w, h); }

// A wall with doorways: from 'a' to 'b' along it, the floor at 'y0' and its top at 'y1'; the slab's halves in 'low' and 'high'.
// Each doorway gets a black timber lintel and, if 'frames', blue-and-cream rosette jambs (the Knossos door frames).
pub fn lgWall(g &mut LabGeo, alongX bool, c0 f32, c1 f32, a f32, b f32, y0 f32, y1 f32, doors &List[LabDoor], low usize, high usize,
    frames bool) {
  mut from = a;
  mut i = 0usize;
  while i <= doors.len() {
    mut to = b;
    if i < doors.len() { to = doors[i].at - doors[i].w * 0.5; }
    if to > from + 0.001 { lgSlab(g, alongX, c0, c1, from, to, y0 - 1., y1, low, high, true); }
    if i < doors.len() {
      imm d = doors[i];
      imm lo = d.at - d.w * 0.5;
      imm hi = d.at + d.w * 0.5;
      // above the doorway: the lintel course; below, the threshold is the floor's
      lgSlab(g, alongX, c0, c1, lo, hi, y0 + d.h, y1, low, high, true);
      // the threshold: floor through the wall's thickness
      if alongX {
        lgBox(g, LM_FLOOR, true, lo, hi, y0 - 1., y0, c0, c1, 4.);
        g.top(lo, c0, hi, c1, y0);
      } else {
        lgBox(g, LM_FLOOR, true, c0, c1, y0 - 1., y0, lo, hi, 4.);
        g.top(c0, lo, c1, hi, y0);
      }
      from = hi;
      if g.want {
        // the black timber lintel across the head, proud of both faces, and the rosette jambs down both sides
        imm t = 0.09;
        if alongX {
          lgBox(g, LM_BLACK, false, lo - 0.25, hi + 0.25, y0 + d.h - 0.28, y0 + d.h, c0 - t, c1 + t, 1.);
        } else {
          lgBox(g, LM_BLACK, false, c0 - t, c1 + t, y0 + d.h - 0.28, y0 + d.h, lo - 0.25, hi + 0.25, 1.);
        }
        if frames {
          lgJamb(g, alongX, c0, c1, lo - 0.45, lo, y0, y0 + d.h - 0.28);
          lgJamb(g, alongX, c0, c1, hi, hi + 0.45, y0, y0 + d.h - 0.28);
        }
      }
    }
    i = i + 1usize;
  }
}

// A jamb strip of the rosette chain: 0.45 m wide from 'p0' to 'p1' along the wall, from y0 to y1, on both faces
fn lgJamb(g &mut LabGeo, alongX bool, c0 f32, c1 f32, p0 f32, p1 f32, y0 f32, y1 f32) {
  imm m = &mut g.meshes[LM_BAND];
  // the chain: 0.45 m a rosette, 0.45 m across; its tile strip B has the rosettes' middle at y = 0.45 of 0.9, so v 0.5 + (0.225 to 0.675) / 1.8
  imm vlo = 0.725;
  imm vhi = 0.975;
  imm u0 = y0 / 1.8;
  imm u1 = y1 / 1.8;
  // (the strip runs up the jamb: u is the tile's along-direction, so the quad's along-direction is vertical)
  imm e = 0.004;
  if alongX {
    lgJambFace(m, new Vec3(p0, 0., c0 - e), new Vec3(p1, 0., c0 - e), y0, y1, new Vec3(0., 0., -1.), u0, u1, vlo, vhi);
    lgJambFace(m, new Vec3(p0, 0., c1 + e), new Vec3(p1, 0., c1 + e), y0, y1, new Vec3(0., 0., 1.), u0, u1, vlo, vhi);
  } else {
    lgJambFace(m, new Vec3(c0 - e, 0., p0), new Vec3(c0 - e, 0., p1), y0, y1, new Vec3(-1., 0., 0.), u0, u1, vlo, vhi);
    lgJambFace(m, new Vec3(c1 + e, 0., p0), new Vec3(c1 + e, 0., p1), y0, y1, new Vec3(1., 0., 0.), u0, u1, vlo, vhi);
  }
}

// One face of a jamb: the vertical quad over the horizontal run p0-p1, its uv's u up the quad and v across it
fn lgJambFace(m &mut mesh.Mesh, p0 Vec3, p1 Vec3, y0 f32, y1 f32, out Vec3, u0 f32, u1 f32, vlo f32, vhi f32) {
  imm a = new Vec3(p0.x, y0, p0.z);
  imm b = new Vec3(p1.x, y0, p1.z);
  imm c = new Vec3(p1.x, y1, p1.z);
  imm d = new Vec3(p0.x, y1, p0.z);
  // texture coordinates: (u, v) with u along the tile = up the jamb, v across: so the quad's uvs are (v across, u up) swapped
  imm n = (b - a).cross(c - a);
  if n.dot(out) >= 0. {
    lgQuadUV(m, a, b, c, d, new Vec2(u0, vlo), new Vec2(u0, vhi), new Vec2(u1, vhi), new Vec2(u1, vlo));
  } else {
    lgQuadUV(m, b, a, d, c, new Vec2(u0, vhi), new Vec2(u0, vlo), new Vec2(u1, vlo), new Vec2(u1, vhi));
  }
}

// ---- Frescoed bands and panels on a wall face ----

// Which strip of which tile: the strip's v range
pub const BAND_A = 0u32;      // Akrotiri's rosettes (tile LM_BAND, lower half)
pub const BAND_B = 1u32;      // the rosette chain (LM_BAND, upper half)
pub const BAND_C = 2u32;      // running spirals (LM_SPIRAL, lower half)
pub const BAND_D = 3u32;      // the wavy band (LM_SPIRAL, upper half)

// A band along a wall face: the face's plane is at 'plane' (x if the wall runs along z, z if along x), its 'out' sign +1 or -1 the way
// the face looks, running from 'a' to 'b' along the wall, 'y0' up 'height' metres (the strip drawn 'scale' times its size, so its 0.9 m
// is 0.9 * scale tall: height should be that). It breaks at each doorway that reaches its height.
pub fn lgBand(g &mut LabGeo, which u32, alongX bool, plane f32, sign f32, a f32, b f32, y0in f32, scale f32, doors &List[LabDoor], doorFloor f32) {
  if !g.want { return; }
  imm slot = if which < 2u32 { LM_BAND; } else { LM_SPIRAL; };
  // (strip A is 1.2 m tall in the tile's lower two thirds, strip B 0.54 m in its top third, C and D 0.9 m in the spiral tile's halves;
  // a band's top is at y0 + 0.9 * scale whichever: A reaches 0.3 * scale below y0)
  imm vlo = if which == 0u32 { 0.003; } elif which == 1u32 { 0.703; } elif which == 2u32 { 0.003; } else { 0.503; };
  imm vhi = if which == 0u32 { 0.664; } elif which == 1u32 { 0.997; } else { vlo + 0.494; };
  imm height = if which == 0u32 { 1.2 * scale; } elif which == 1u32 { 0.54 * scale; } else { 0.9 * scale; };
  imm y0 = y0in - (if which == 0u32 { 0.3 * scale; } else { 0.; });
  // the runs between the doorways that the band would cross
  mut from = a;
  mut i = 0usize;
  while i <= doors.len() {
    mut to = b;
    mut cross = false;
    if i < doors.len() {
      cross = doorFloor + doors[i].h > y0;
      if cross { to = doors[i].at - doors[i].w * 0.5 - 0.5; }
    }
    if to > from + 0.05 { lgBandRun(g, slot, alongX, plane, sign, from, to, a, y0, height, 1.8 * scale, vlo, vhi); }
    if i < doors.len() and cross { from = doors[i].at + doors[i].w * 0.5 + 0.5; }
    i = i + 1usize;
  }
}

fn lgBandRun(g &mut LabGeo, slot usize, alongX bool, plane f32, sign f32, from f32, to f32, origin f32, y0 f32, height f32, tile f32,
    vlo f32, vhi f32) {
  imm m = &mut g.meshes[slot];
  imm e = 0.006 * sign;
  imm u0 = (from - origin) / tile;
  imm u1 = (to - origin) / tile;
  if alongX {
    lgFaceUV(m, new Vec3(from, 0., plane + e), new Vec3(to, 0., plane + e), y0, y0 + height, new Vec3(0., 0., sign), u0, u1, vlo, vhi);
  } else {
    lgFaceUV(m, new Vec3(plane + e, 0., from), new Vec3(plane + e, 0., to), y0, y0 + height, new Vec3(sign, 0., 0.), u0, u1, vlo, vhi);
  }
}

// A 3.0 by 1.5 m panel (slot 'slot': dolphins, griffins or lilies) on a wall face, its middle at (along) 'at', its bottom at 'y0'
pub fn lgPanel(g &mut LabGeo, slot usize, alongX bool, plane f32, sign f32, at f32, y0 f32, scale f32) {
  if !g.want { return; }
  imm m = &mut g.meshes[slot];
  imm e = 0.008 * sign;
  imm hw = 1.5 * scale;
  // u runs along +x or +z; seen from the face's own side the picture reads left to right if it runs to the viewer's right
  imm flip = if alongX { sign < 0.; } else { sign > 0.; };
  imm ua = if flip { 1.; } else { 0.; };
  imm ub = 1. - ua;
  if alongX {
    lgFaceUV(m, new Vec3(at - hw, 0., plane + e), new Vec3(at + hw, 0., plane + e), y0, y0 + 1.5 * scale, new Vec3(0., 0., sign), ua, ub, 0., 1.);
  } else {
    lgFaceUV(m, new Vec3(plane + e, 0., at - hw), new Vec3(plane + e, 0., at + hw), y0, y0 + 1.5 * scale, new Vec3(sign, 0., 0.), ua, ub, 0., 1.);
  }
}

// ---- Floors and ceilings ----

// A floor slab: the walking surface at y0, 1 m of stone under it
pub fn lgFloor(g &mut LabGeo, x0 f32, x1 f32, z0 f32, z1 f32, y0 f32) {
  lgBox(g, LM_FLOOR, true, x0, x1, y0 - 1., y0, z0, z1, 4.);
  g.top(x0, z0, x1, z1, y0);
}

// A timber ceiling over a room at 'yTop' with beams across it every 'pitch', and an optional square hole (a light well) at (hx, hz) of
// half size 'hs' (0 for none)
pub fn lgCeiling(g &mut LabGeo, x0 f32, x1 f32, z0 f32, z1 f32, yTop f32, hx f32, hz f32, hs f32) {
  if !g.want { return; }
  if hs <= 0. {
    lgBox(g, LM_CEILING, false, x0, x1, yTop, yTop + 0.6, z0, z1, 2.);
  } else {
    lgBox(g, LM_CEILING, false, x0, hx - hs, yTop, yTop + 0.6, z0, z1, 2.);
    lgBox(g, LM_CEILING, false, hx + hs, x1, yTop, yTop + 0.6, z0, z1, 2.);
    lgBox(g, LM_CEILING, false, hx - hs, hx + hs, yTop, yTop + 0.6, z0, hz - hs, 2.);
    lgBox(g, LM_CEILING, false, hx - hs, hx + hs, yTop, yTop + 0.6, hz + hs, z1, 2.);
  }
  // beams across the narrower way, every 2.6 m, 0.22 wide, hanging 0.3 below
  imm acrossX = (x1 - x0) < (z1 - z0);
  imm span = if acrossX { z1 - z0; } else { x1 - x0; };
  imm count = i32.from(span / 2.6);
  mut k = 1;
  while k < count {
    imm t = span * f32.from(k) / f32.from(count);
    if acrossX {
      imm zz = z0 + t;
      if hs > 0. and zz > hz - hs - 0.2 and zz < hz + hs + 0.2 { k = k + 1; continue; }
      lgBox(g, LM_CEILING, false, x0, x1, yTop - 0.3, yTop, zz - 0.11, zz + 0.11, 1.);
    } else {
      imm xx = x0 + t;
      if hs > 0. and xx > hx - hs - 0.2 and xx < hx + hs + 0.2 { k = k + 1; continue; }
      lgBox(g, LM_CEILING, false, xx - 0.11, xx + 0.11, yTop - 0.3, yTop, z0, z1, 1.);
    }
    k = k + 1;
  }
}

// ---- A light well: a shaft of lime plaster over a hole in a ceiling, with daylight at its top from nowhere ----
// (hx, hz) the middle, 'hs' half its width, from the ceiling at 'yTop' up 'rise' metres; a cool spot light shines down it
pub fn lgLightWell(g &mut LabGeo, hx f32, hz f32, hs f32, yTop f32, rise f32, candela f32, range f32) {
  if g.want {
    imm w = 0.4;
    imm top = yTop + rise;
    lgBox(g, LM_PLASTER_CREAM, false, hx - hs - w, hx - hs, yTop, top + w, hz - hs - w, hz + hs + w, 2.);
    lgBox(g, LM_PLASTER_CREAM, false, hx + hs, hx + hs + w, yTop, top + w, hz - hs - w, hz + hs + w, 2.);
    lgBox(g, LM_PLASTER_CREAM, false, hx - hs, hx + hs, yTop, top + w, hz - hs - w, hz - hs, 2.);
    lgBox(g, LM_PLASTER_CREAM, false, hx - hs, hx + hs, yTop, top + w, hz + hs, hz + hs + w, 2.);
    // the daylight: a bright plate under the shaft's cap (facing down), a metre below its top
    imm m = &mut g.meshes[LM_SKY];
    imm sy = top - 0.1;
    lgQuadUV(m, new Vec3(hx - hs, sy, hz - hs), new Vec3(hx + hs, sy, hz - hs), new Vec3(hx + hs, sy, hz + hs), new Vec3(hx - hs, sy, hz + hs),
      new Vec2(0., 0.), new Vec2(1., 0.), new Vec2(1., 1.), new Vec2(0., 1.));
    // (that winding faces up; the daylight is seen from below, so the other way)
    lgQuadUV(m, new Vec3(hx - hs, sy, hz + hs), new Vec3(hx + hs, sy, hz + hs), new Vec3(hx + hs, sy, hz - hs), new Vec3(hx - hs, sy, hz - hs),
      new Vec2(0., 0.), new Vec2(1., 0.), new Vec2(1., 1.), new Vec2(0., 1.));
  }
  mut look = LightLook.spot(new Vec3(0., 0., 0.), new Vec3(0., -1., 0.), new Color(0.78, 0.9, 1., 1.), candela, range, 0.45, 0.75);
  look.radius = hs * 0.8;
  g.lamps.push(new LabLamp(new Vec3(hx, yTop + rise - 0.5, hz), look));
}

// ---- A brazier: a bronze bowl on a post, a flame in it, a warm light over it ----
pub fn lgBrazier(g &mut LabGeo, x f32, y0 f32, z f32, s f32, candela f32) {
  if g.want {
    mut post = List[Vec2].empty();
    post.push(pt(0.0, 0.0)); post.push(pt(0.26, 0.0)); post.push(pt(0.26, 0.06)); post.push(pt(0.07, 0.12)); post.push(pt(0.055, 0.7));
    post.push(pt(0.09, 0.78)); post.push(pt(0.2, 0.9)); post.push(pt(0.3, 1.05)); post.push(pt(0.31, 1.12)); post.push(pt(0.27, 1.1));
    post.push(pt(0.18, 0.98)); post.push(pt(0.0, 0.95));
    lgLathe(&mut g.meshes[LM_BRONZE], &post, 16, x, y0, z, s);
    mut flame = List[Vec2].empty();
    flame.push(pt(0.0, 0.99)); flame.push(pt(0.17, 1.0)); flame.push(pt(0.19, 1.1)); flame.push(pt(0.15, 1.22)); flame.push(pt(0.09, 1.38));
    flame.push(pt(0.04, 1.52)); flame.push(pt(0.0, 1.66));
    lgLathe(&mut g.meshes[LM_FLAME], &flame, 10, x, y0, z, s);
  }
  g.solids.push(Solid.circle(x, z, 0.3 * s, y0 - 0.5, y0 + 1.2 * s));
  g.circles.push(new Vec3(x, z, 0.3 * s));
  mut look = LightLook.point(new Vec3(0., 0., 0.), new Color(1., 0.55, 0.22, 1.), candela, 12. + 8. * s);
  look.radius = 0.15;
  g.lamps.push(new LabLamp(new Vec3(x, y0 + 1.45 * s, z), look));
}

// ---- Stairs ----

// A flight of treads going +x (alongX) or +z, from 'start' along, 'n' treads of 'run' deep and 'rise' high, 'width' wide across from 'c0'
// to 'c1'; the first tread's top is 'rise' over the floor 'y0'. Each tread is a block from the floor up (solid), in gypsum.
pub fn lgFlight(g &mut LabGeo, alongX bool, start f32, run f32, rise f32, n i32, c0 f32, c1 f32, y0 f32) {
  mut i = 0;
  while i < n {
    imm a = start + run * f32.from(i);
    imm top = y0 + rise * f32.from(i + 1);
    if alongX {
      lgBox(g, LM_GYPSUM, true, a, a + run, y0 - 0.5, top, c0, c1, 1.8);
      g.top(a, c0, a + run, c1, top);
    } else {
      lgBox(g, LM_GYPSUM, true, c0, c1, y0 - 0.5, top, a, a + run, 1.8);
      g.top(c0, a, c1, a + run, top);
    }
    i = i + 1;
  }
}

// A sloped parapet beside a flight: low 'h' tall wall of 'thick', its top following the treads from height 'ya' at 'a' to 'yb' at 'b'
// along x (alongX) or z, at the cross coordinate 'c0' to 'c1'
pub fn lgParapet(g &mut LabGeo, alongX bool, a f32, b f32, c0 f32, c1 f32, ya f32, yb f32, h f32) {
  if g.want {
    imm m = &mut g.meshes[LM_GYPSUM];
    if alongX {
      ctPara(m, new Vec3(a, ya - h, c0), new Vec3(b - a, yb - ya, 0.), new Vec3(0., h, 0.), new Vec3(0., 0., c1 - c0), 1.8);
    } else {
      ctPara(m, new Vec3(c0, ya - h, a), new Vec3(0., yb - ya, b - a), new Vec3(0., h, 0.), new Vec3(c1 - c0, 0., 0.), 1.8);
    }
  }
  g.boxes.push(new Vec4(if alongX { a; } else { c0; }, if alongX { c0; } else { a; }, if alongX { b; } else { c1; }, if alongX { c1; } else { b; }));
  // solid: a ramp box whose top follows the line
  if alongX { g.solids.push(Solid.ramp(a, c0, b, c1, ya - h - 2., ya, yb, false)); }
  else { g.solids.push(Solid.ramp(c0, a, c1, b, ya - h - 2., ya, yb, true)); }
}

// ---- A banner: hanging cloth, in folds ----
// In the plane x = 'px' (facing +x), from 'z0' to 'z1' across, the top at 'ytop' and the bottom at 'ybot'; the cloth sways +-'amp' in x
pub fn lgBanner(g &mut LabGeo, slot usize, px f32, z0 f32, z1 f32, ytop f32, ybot f32, amp f32, phase f32) {
  if !g.want { return; }
  imm m = &mut g.meshes[slot];
  imm nz = 14;
  imm ny = 18;
  imm base = u32.from(m.positions.len());
  mut j = 0;
  while j <= ny {
    imm t = f32.from(j) / f32.from(ny);
    mut i = 0;
    while i <= nz {
      imm s = f32.from(i) / f32.from(nz);
      imm swing = amp * t * libc.sinf(s * 3.1415927 * 5. + phase + t * 2.);
      imm dxdz = amp * t * libc.cosf(s * 3.1415927 * 5. + phase + t * 2.) * 3.1415927 * 5. / (z1 - z0);
      imm dxdy = amp * libc.cosf(0.) * 0. + amp * libc.sinf(s * 3.1415927 * 5. + phase + t * 2.) / (ytop - ybot);
      imm x = px + swing;
      imm y = ytop - (ytop - ybot) * t;
      // a pointed swallow-tail at the bottom
      mut yy = y;
      if t > 0.85 { yy = y + (t - 0.85) * 6. * lpAbs(s - 0.5) * 0.7 * (ytop - ybot) * 0.2 - 0.0; }
      imm n = new Vec3(1., dxdy * -1., 0. - dxdz).normalize();
      m.positions.push(new Vec3(x, yy, z0 + (z1 - z0) * s));
      m.normals.push(n);
      m.uvs.push(new Vec2(s, 1. - t));
      i = i + 1;
    }
    j = j + 1;
  }
  j = 0;
  while j < ny {
    mut i = 0;
    while i < nz {
      imm a = base + u32.from(j * (nz + 1) + i);
      imm b = a + 1u32;
      imm c = a + u32.from(nz + 1);
      imm d = c + 1u32;
      // facing +x: counterclockwise from +x with z across and y up (down the rows): (a, c, d) then (a, d, b)
      m.indices.push(a); m.indices.push(c); m.indices.push(d);
      m.indices.push(a); m.indices.push(d); m.indices.push(b);
      i = i + 1;
    }
    j = j + 1;
  }
}
