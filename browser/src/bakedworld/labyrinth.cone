// The labyrinth as a world object: Minoan rooms far beneath the island (labrooms.cone's plan, labgeo.cone's kit, labpaint.cone's
// frescoes). hydrateLabyrinth makes its meshes, bakes its textures and sends its parts and lights like any object of the baked-in
// world; labSolids is the same plan's collision, for the simulation and every view.
//
// HOW IT IS LIT. The island's sun, sky, fog and shadows must not reach it, and they do not by distance (300 m, and the island's
// ground above it is not a ceiling the sun passes through): it has its own ceilings, and the renderer, when the eye is underground
// (renderactor.cone: eye under UNDER_Y, parts/portal.cone's underground(): the one test of the labyrinth), swaps the frame's light for
// the labyrinth's: no sun, a dim warm ambient, a fixed exposure, no sky, no birds, no fog, no sun shadows, no image-based light.
// What lights the rooms are the local lights this file places: a brazier's warm light, a hanging lamp's, and a cool spot light down
// each light well, "daylight from nowhere" (a bright plate at the shaft's top glows). All of it is in physical units, set to the
// labyrinth's exposure (LAB_EV). A portal's picture of the labyrinth, seen from the island (the looking-glass), is lit and exposed the
// same way (renderactor.cone's PictureEnv); a picture of the island, seen from here, by the island's sun.
//
// HOW IT IS KEPT OUT OF THE ISLAND'S FRAME. Every part is a scene item with a visibility range of 250 m: culled from the island's
// camera (300 m above) and every other, so it costs the island nothing; and it is on the labyrinth's layer (an item whose mesh's middle
// is under UNDER_Y, rendersys.cone), so a picture of the island leaves it out and one of the labyrinth leaves the island out.
//
// THE PORTALS in it (three panes, view surfaces): the mouth of the entrance corridor, the way back to the cottage's looking-glass; the
// gate of the corridor that will not end, a picture of the corridor as it is two bays back; and the doorway at the staircase's top, a
// window onto the spring that is the way out. Their places and links are parts/portal.cone's.

// The labyrinth's exposure (EV100): rooms lit by lamps, a dim interior
pub const LAB_EV f32 = 6.;

// How many stops darker (a higher EV100) a picture of the labyrinth is exposed when it is seen from the island, in a pane: the
// island's light is 9 stops over the rooms', and a room seen from sunlight through a doorway is a dim glow, not white
pub const LAB_DAY_VIEW_STOPS f32 = 3.5;

// The ambient radiance (nits) the rooms have beside their lamps: dim and warm, the light that comes back off the walls
pub fn labAmbient() Color { new Color(40., 34., 27., 1.) }

pub const LAB_TILE_BAND f32 = 1.8;
pub const LAB_TILE_PANEL f32 = 3.0;

// The shared keys of the labyrinth's materials: none (its materials are its own)

// A fresco tile 'which' baked at 'size' texels a side: 0 the rosette bands, 1 the spirals and the wavy band, 2 the
// dolphins, 3 the griffins, 4 the lilies, 5 the lime plaster, 6 the ashlar
fn labBake(which u32, size i32) pbrmaterial.TextureSet {
  let tile = if which < 2u32 { LAB_TILE_BAND } elif which == 5u32 { 2. } elif which >= 6u32 { 1.8 } else { LAB_TILE_PANEL };
  var field = surfacepatterns.PatternField.empty(size, tile, if which == 7u32 { 0.012 } elif which >= 5u32 { 0.012 } else { 0.005 });
  if which == 0u32 { surfacepatterns.fillTexels(&uni field, (u, v) => bandTexel(u, v)); }
  elif which == 1u32 { surfacepatterns.fillTexels(&uni field, (u, v) => spiralTexel(u, v)); }
  elif which == 2u32 { surfacepatterns.fillTexels(&uni field, (u, v) => dolphinTexel(u, v)); }
  elif which == 3u32 { surfacepatterns.fillTexels(&uni field, (u, v) => griffinTexel(u, v)); }
  elif which == 4u32 { surfacepatterns.fillTexels(&uni field, (u, v) => lilyTexel(u, v)); }
  elif which == 5u32 { surfacepatterns.fillTexels(&uni field, (u, v) => plasterTexel(u, v)); }
  elif which == 7u32 { surfacepatterns.fillTexels(&uni field, (u, v) => gypsumTexel(u, v)); }
  else { surfacepatterns.fillTexels(&uni field, (u, v) => ashlarTexel(u, v)); }
  surfacepatterns.finishField(&mut field, 0.01, 3)
}

// A fresco tile through the bake cache (the seed of its key is its number)
fn labSet(h &mut Hydrated, which u32, size i32) pbrmaterial.TextureSet {
  var name = String.from("lab-fresco-");
  name <- which;
  bakeSet(&mut h.stats.textures, name.view(), size, which, () => labBake(which, size))
}

// The floor: big pale flagstones, 1.1 m across, a dusty gap
fn labBakeFloor() pbrmaterial.TextureSet {
  var p = surfacepatterns.FlagstoneParams.garden(1024, 4242u32);
  p.tileMetres = 4.;
  p.stoneSize = 1.1;
  p.gap = 0.03;
  p.colorA = srgb(204., 192., 164.);
  p.colorB = srgb(150., 138., 118.);
  p.lichen = srgb(168., 156., 128.);
  p.gapSoil = srgb(70., 62., 52.);
  p.gapGrowth = srgb(96., 90., 70.);
  p.growth = 0.;
  p.variation = 0.12;
  surfacepatterns.bakeFlagstones(&p)
}

// The fresco tiles as BMPs in 'dir' (fresco-0.bmp ...), for looking at them
pub fn labDumpFrescos(dir &str) bool {
  var ok = true;
  var k = 0u32;
  while k < 8u32 {
    let t0 = sdl.GetPerformanceCounter();
    var set = labBake(k, 1024);
    let ms = f64.from(sdl.GetPerformanceCounter() - t0) * 1000.0 / f64.from(sdl.GetPerformanceFrequency());
    let img = ctTake(set.size, &mut set.baseColor);
    var name = String.from(dir);
    name <- "/fresco-"; name <- k; name <- ".bmp";
    let bytes = img.toBmp();
    let bv = bytes.view();
    let f = libc.fopen(name.cstr(), "wb");
    if !f { ok = false; }
    else {
      libc.fwrite(&bv[0] as *u8, 1usize, bv.len, f);
      libc.fclose(f);
    }
    print <- "fresco "; print <- k; print <- ": baked in "; print <- ms; print <- " ms\n";
    k = k + 1u32;
  }
  ok
}

// The labyrinth's collision: its floors, walls, columns, pillars, treads and furniture as the world's Solids
pub fn labSolids(out &mut List[Solid]) {
  var g = LabGeo.make(false);
  labBuild(&mut g);
  var i = 0usize;
  while i < g.solids.len() { out.push(*g.solids[i]); i = i + 1usize; }
}

// The plan with no meshes: its walkable tops and obstacles (labnav.cone's input) and its solids
pub fn labPlan() LabGeo {
  var g = LabGeo.make(false);
  labBuild(&mut g);
  g
}

// How many lights the labyrinth places
pub fn labLightCount() usize {
  let g = labPlan();
  g.lamps.len()
}

// The panes (view surfaces) hydrateLabyrinth sends: the entrance corridor's mouth, the looping corridor's gate, the exit's doorway
pub const LAB_PORTAL_PARTS = 3usize;

// How many parts hydrateLabyrinth sends: one for each material slot that has triangles, a part for each light and the three panes (the
// checks' count of the world's parts)
pub fn labPartCount() usize {
  var g = LabGeo.make(true);
  labBuild(&mut g);
  var n = g.lamps.len() + LAB_PORTAL_PARTS + g.glass.len();
  var slot = 0usize;
  while slot < LM_COUNT {
    if g.meshes[slot].triangleCount() > 0usize { n = n + 1usize; }
    slot = slot + 1usize;
  }
  n
}

// The names of the parts, by slot
let LAB_NAMES Array[&str, 19] = ["labyrinth floor", "labyrinth red plaster", "labyrinth ochre plaster", "labyrinth cream plaster", "labyrinth ashlar",
  "labyrinth ceiling", "labyrinth columns", "labyrinth black", "labyrinth rosette bands", "labyrinth spirals", "labyrinth dolphins",
  "labyrinth griffins", "labyrinth lilies", "labyrinth gypsum", "labyrinth daylight", "labyrinth flames", "labyrinth bronze",
  "labyrinth blue banners", "labyrinth ochre banners"];

// The labyrinth as data: textures baked, meshes made, its parts and lights described
pub fn hydrateLabyrinth(isl &Island, h &mut Hydrated) {
  let t0 = sdl.GetPerformanceCounter();
  var g = LabGeo.make(true);
  labBuild(&mut g);
  let t1 = sdl.GetPerformanceCounter();
  let white = new Color(1., 1., 1., 1.);
  var mats = List[usize].empty();
  // 0 floor
  // (every tile through the bake cache: bakecache.cone; the three plasters are one bake, tinted three ways, so the second and
  // third are cache hits even on a cold start)
  var floor = bakeSet(&mut h.stats.textures, "lab-floor", 1024, 4242u32, () => labBakeFloor());
  mats.push(ctKitMaterial(h, &mut floor, white));
  // 1 to 3 plasters, tinted
  var p1 = labSet(h, 5u32, 512);
  mats.push(ctKitMaterial(h, &mut p1, srgb(160., 58., 40.)));
  var p2 = labSet(h, 5u32, 512);
  mats.push(ctKitMaterial(h, &mut p2, srgb(222., 168., 74.)));
  var p3 = labSet(h, 5u32, 512);
  mats.push(ctKitMaterial(h, &mut p3, srgb(238., 226., 190.)));
  // 4 ashlar
  var ash = labSet(h, 6u32, 512);
  mats.push(ctKitMaterial(h, &mut ash, srgb(214., 198., 160.)));
  // 5 ceiling timber, 6 column red, 7 black
  mats.push(h.addMaterial(Look.physicallyBased(srgb(74., 48., 32.), 0.8, 0.), Image.empty(), Maps.none(), 0u32));
  mats.push(h.addMaterial(Look.physicallyBased(srgb(184., 70., 48.), 0.6, 0.), Image.empty(), Maps.none(), 0u32));
  mats.push(h.addMaterial(Look.physicallyBased(srgb(34., 30., 32.), 0.5, 0.), Image.empty(), Maps.none(), 0u32));
  // 8 to 12 the frescoes
  var b0 = labSet(h, 0u32, 1024);
  mats.push(ctKitMaterial(h, &mut b0, white));
  var b1 = labSet(h, 1u32, 1024);
  mats.push(ctKitMaterial(h, &mut b1, white));
  var b2 = labSet(h, 2u32, 1024);
  mats.push(ctKitMaterial(h, &mut b2, white));
  var b3 = labSet(h, 3u32, 1024);
  mats.push(ctKitMaterial(h, &mut b3, white));
  var b4 = labSet(h, 4u32, 1024);
  mats.push(ctKitMaterial(h, &mut b4, white));
  let t2 = sdl.GetPerformanceCounter();
  // 13 gypsum, 14 daylight, 15 flames, 16 bronze, 17 and 18 the banners
  var gyp = labSet(h, 7u32, 512);
  mats.push(ctKitMaterial(h, &mut gyp, srgb(228., 212., 176.)));
  let sky = new Color(0.85, 0.93, 1., 1.);
  mats.push(h.addMaterial(Look.shiny(sky, 1., 4.).glowing(sky, 220.), Image.empty(), Maps.none(), 0u32));
  let fire = new Color(1., 0.38, 0.07, 1.);
  mats.push(h.addMaterial(Look.shiny(fire, 1., 4.).glowing(fire, 30.), Image.empty(), Maps.none(), 0u32));
  mats.push(h.addMaterial(Look.physicallyBased(srgb(104., 76., 44.), 0.4, 0.4), Image.empty(), Maps.none(), 0u32));
  mats.push(h.addMaterial(Look.physicallyBased(srgb(44., 84., 150.), 0.9, 0.), Image.empty(), Maps.none(), 0u32));
  mats.push(h.addMaterial(Look.physicallyBased(srgb(204., 142., 52.), 0.9, 0.), Image.empty(), Maps.none(), 0u32));
  // the parts: one for each slot that has any triangles, a scene item of its own (culled beyond 250 m)
  let ms = g.meshes.viewMut();
  var slot = 0usize;
  var gypsumPart = TOP;
  while slot < LM_COUNT {
    if ms[slot].triangleCount() > 0usize {
      var shape = mesh.Mesh.empty();
      shape <=> ms[slot];
      let mi = h.addMesh(shape);
      let part = h.part(LAB_NAMES[slot], mi, *mats[slot], TOP, Transform3.identity());
      if slot == LM_FLAME or slot == LM_SKY { h.noShadow(part); }
      if slot == LM_GYPSUM { gypsumPart = part; }
      cullSmall(h, part, 250., 10.);
    }
    slot = slot + 1usize;
  }
  // The throne's seat (the gypsum's part: the throne is of it): its sit point on the seat block (labrooms.cone's lgThrone: x -44.9 to
  // -43.7, its top 0.95 m over the hall's floor), the sitter facing east into the room (yaw -pi/2), its feet on the plinth's top (0.3 m
  // over the floor), so the seat is 0.65 m over them
  if gypsumPart != TOP {
    h.seat(gypsumPart, v(-44.25, LAB_Y + 0.95, LAB_THRONE_Z), 0. - 1.5707964, 0.65, 0., 1.);
  }
  // the glass: each piece (glassware.cone) a part of its own in its own glass look, a scene item like the rest, casting no shadow
  // (see-through draws cast none)
  let gs = g.glass.viewMut();
  var gi = 0usize;
  while gi < gs.len() {
    var shape = mesh.Mesh.empty();
    shape <=> gs[gi].shape;
    let gmat = h.addMaterial(gs[gi].look, Image.empty(), Maps.none(), 0u32);
    let gpart = h.part(gs[gi].name.view(), h.addMesh(shape), gmat, TOP, new Transform3(gs[gi].at, Quat.identity(), v(1., 1., 1.)));
    h.noShadow(gpart);
    cullSmall(h, gpart, 250., 10.);
    gi = gi + 1usize;
  }
  // the three panes (view surfaces, viewsurface.cone: a part whose look names SHADER_MIRROR; the mesh is the plane, -1 to 1, facing +y)
  let pane = h.addMesh(mesh.Mesh.plane(1, 1.));
  // 1. the mouth of the entrance corridor: the way back, a portal onto the cottage's back wall (facing +z, towards E)
  let ground = groundHeight(isl, COTTAGE_X, COTTAGE_Z);
  let t = glassToMouth(ground);
  let mouthLook = h.addMaterial(Look.shaded(SHADER_MIRROR, [0.92, 0.94, 0.95, f32.from(SURFACE_PORTAL), 0. - t.x, 0. - t.y, 0. - t.z,
    f32.from(DEST_DAY)]), Image.empty(), Maps.none(), 0u32);
  let mouthAt = new Transform3(v(E_X, LAB_FLOOR + (PANE_LOW + PANE_HIGH) * 0.5, MOUTH_Z), Quat.angleAxis(pi * 0.5, v(1., 0., 0.)),
    v(PANE_HALF, 1., (PANE_HIGH - PANE_LOW) * 0.5));
  h.noShadow(h.part("looking-glass back", pane, mouthLook, TOP, mouthAt));
  // 2. the corridor that will not end: an invisible portal across it at its gate (facing -z, towards the hall), showing the corridor as
  // it is LOOP_BACK before it. A being that goes through facing forward is moved there (portal.cone), so the picture is what it will
  // see; the pane is a little over the corridor's size, its edges in the walls
  let loopLook = h.addMaterial(Look.shaded(SHADER_MIRROR, [1., 1., 1., f32.from(SURFACE_PORTAL), 0., 0., 0. - LOOP_BACK, f32.from(DEST_UNDER)]),
    Image.empty(), Maps.none(), 0u32);
  let loopAt = new Transform3(v(LOOP_X, LAB_FLOOR + LOOP_HEIGHT * 0.5, LOOP_GATE_Z), Quat.angleAxis(0. - pi * 0.5, v(1., 0., 0.)),
    v(LOOP_HALF + 0.05, 1., LOOP_HEIGHT * 0.5 + 0.05));
  h.noShadow(h.part("looping gate", pane, loopLook, TOP, loopAt));
  // 3. the exit: the staircase's top doorway (facing -z, towards the stairs), a window onto the island at the brook's spring. It is
  // one way: the spring has no pane, and a being there does not come back down
  let out = exitToSpring(groundHeight(isl, SPRING_X, SPRING_Z));
  let exitLook = h.addMaterial(Look.shaded(SHADER_MIRROR, [0.97, 0.97, 0.95, f32.from(SURFACE_PORTAL), out.x, out.y, out.z, f32.from(DEST_DAY)]),
    Image.empty(), Maps.none(), 0u32);
  let exitAt = new Transform3(v(EXIT_X, LAB_FLOOR + EXIT_UP + EXIT_HIGH * 0.5, EXIT_Z), Quat.angleAxis(0. - pi * 0.5, v(1., 0., 0.)),
    v(EXIT_HALF, 1., EXIT_HIGH * 0.5));
  h.noShadow(h.part("exit to the spring", pane, exitLook, TOP, exitAt));
  // the lights
  var i = 0usize;
  while i < g.lamps.len() {
    let l = g.lamps[i];
    h.lamp("labyrinth light", TOP, new Transform3(l.at, Quat.identity(), v(1., 1., 1.)), l.look);
    i = i + 1usize;
  }
  let t3 = sdl.GetPerformanceCounter();
  let hz = f64.from(sdl.GetPerformanceFrequency()) / 1000.0;
  print <- "The labyrinth: geometry in "; print <- f64.from(t1 - t0) / hz; print <- " ms, "; print <- g.lamps.len(); print <- " lights, ";
  print <- g.solids.len(); print <- " solids; textures baked in "; print <- f64.from(t2 - t1) / hz; print <- " ms\n";
}
