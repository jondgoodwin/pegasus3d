// What a body cannot walk through: the world's solids, built from the same
// numbers that place the things they stand for, so moving a rock (or a tree,
// or the cottage) moves its solid.
//
//   tree trunks   a circle of the trunk's radius at the tree's foot (a specimen or
//                 forest maple, a pine), standing well above any head
//   rocks         a circle of the rock's footprint (the layout's radius), as high as
//                 the rock's mesh stands out of the ground; a low rock is a step,
//                 a tall one a wall (support.cone decides which, by the body's feet)
//   the cottage   its walls and chimney as boxes (cottage.cone's cottageSolids);
//                 the door is shut in the model, so the house is solid; and its
//                 porch deck and two steps as boxes with walkable tops
//
// Not solid: ferns, flowers, hostas, edging stones, the lantern stakes, the porch's
// posts, the pots and the rook (a body walks through them).
//
// A trunk's radius is the tree generator's own, read off the same parameters
// that grow the tree (vegetation.cone's seeds and heights): the trunk's length
// from the seed, its radius a 'ratio' of that, tapering up the trunk, taken at
// the height of a hip (TRUNK_AT), times the item's scale. The --checks compare it
// with the radius of a tree grown in full.

// Where on the trunk its solid's radius is taken: the height of a mannequin's hip, metres
pub const TRUNK_AT f32 = 1.;

// How high a tree's solid stands above its foot: above any head
const TREE_SOLID_TOP f32 = 40.;
// How far below its foot a solid reaches (ground higher beside it on a slope is still within it)
const SOLID_BELOW f32 = 6.;

// The trunk radius of a tree grown from 'p', at scale 1, at TRUNK_AT up
pub fn trunkRadiusOf(p &weberpenn.TreeParams) f32 {
  mut rng = weberpenn.Rng.make(p.seed);
  imm l0 = p.levelParams[0usize];
  imm trunk = (p.scale + p.scaleV * rng.signed()) * (l0.length + l0.lengthV * rng.signed());
  // The trunk is curveRes segments, a radius at each end (taper, and the flare at its foot: weberpenn's
  // radiusAt), the mesh a straight taper between the two ends of the segment TRUNK_AT lies in
  imm n = if l0.curveRes < 1 { 1; } else { l0.curveRes; };
  imm seg = trunk / f32.from(n);
  mut j = i32.from(TRUNK_AT / seg);
  if j > n - 1 { j = n - 1; }
  imm t = (TRUNK_AT - f32.from(j) * seg) / seg;
  imm a = trunkRadiusAtFraction(p, trunk * p.ratio, f32.from(j) / f32.from(n));
  imm b = trunkRadiusAtFraction(p, trunk * p.ratio, f32.from(j + 1) / f32.from(n));
  a * (1. - t) + b * t;
}

// weberpenn's radius of the trunk at the fraction 'z' of its length, from the radius 'r0' at its foot
fn trunkRadiusAtFraction(p &weberpenn.TreeParams, r0 f32, z f32) f32 {
  imm l0 = p.levelParams[0usize];
  imm y = if 1. - 8. * z > 0. { 1. - 8. * z; } else { 0.; };
  imm r = r0 * (1. - l0.taper * z * 0.97) * (1. + p.flare * (libc.powf(100., y) - 1.) / 100.);
  if r > p.minRadius { r; } else { p.minRadius; };
}

// A tree item's variant's trunk radius at scale 1 (0 for what is not a tree)
pub fn trunkRadiusAt1(kind u32, variant u32) f32 {
  if kind == K_SPECIMEN {
    imm p = weberpenn.redMaple(SPECIMEN_SEEDS[usize.from(variant)], SPECIMEN_HEIGHTS[usize.from(variant)]);
    return trunkRadiusOf(&p);
  }
  if kind == K_MAPLE {
    imm p = weberpenn.redMaple(MAPLE_SEEDS[usize.from(variant)], MAPLE_HEIGHTS[usize.from(variant)]);
    return trunkRadiusOf(&p);
  }
  if kind == K_PINE {
    imm p = weberpenn.whitePine(PINE_SEEDS[usize.from(variant)], PINE_HEIGHTS[usize.from(variant)]);
    return trunkRadiusOf(&p);
  }
  0.;
}

// The same tree grown in full: the radius of its trunk where TRUNK_AT up it (a check's reference)
pub fn grownTrunkRadius(kind u32, variant u32) f32 {
  mut p = weberpenn.redMaple(SPECIMEN_SEEDS[usize.from(variant % 2u32)], SPECIMEN_HEIGHTS[usize.from(variant % 2u32)]);
  if kind == K_MAPLE { p = weberpenn.redMaple(MAPLE_SEEDS[usize.from(variant)], MAPLE_HEIGHTS[usize.from(variant)]); }
  if kind == K_PINE { p = weberpenn.whitePine(PINE_SEEDS[usize.from(variant)], PINE_HEIGHTS[usize.from(variant)]); }
  imm tree = weberpenn.grow(&p);
  imm stem = tree.stems[0usize];
  mut k = 1usize;
  while k < stem.points.len() and stem.points[k].y < TRUNK_AT { k = k + 1usize; }
  // Between the points either side of TRUNK_AT
  imm y0 = stem.points[k - 1usize].y;
  imm y1 = stem.points[k].y;
  imm t = (TRUNK_AT - y0) / (y1 - y0);
  *stem.radii[k - 1usize] * (1. - t) + *stem.radii[k] * t;
}

// The top of a rock above where its item stands: the mesh's own top (at scale 1) less how far it is sunk
// into the ground (both scale with the rock)
pub fn rockTop(top f32, scale f32) f32 { (top - ROCK_SINK * 2.) * scale; }

// Every solid of the world: the vegetation's trunks and rocks, and the cottage
pub fn worldSolids() List[Solid] {
  mut out = List[Solid].empty();
  imm items = vegetationLayout();
  // The trunks' radii (eight kinds of tree) and the rocks' tops (six kinds of rock, from their meshes)
  mut trunks = List[f32].empty();
  mut v = 0u32;
  while v < SPECIMEN_VARIANTS { trunks.push(trunkRadiusAt1(K_SPECIMEN, v)); v = v + 1u32; }
  v = 0u32;
  while v < MAPLE_VARIANTS { trunks.push(trunkRadiusAt1(K_MAPLE, v)); v = v + 1u32; }
  v = 0u32;
  while v < PINE_VARIANTS { trunks.push(trunkRadiusAt1(K_PINE, v)); v = v + 1u32; }
  mut tops = List[f32].empty();
  v = 0u32;
  while v < ROCK_VARIANTS {
    tops.push(rockVariant(v).bounds().max.y);
    v = v + 1u32;
  }
  mut i = 0usize;
  while i < items.len() {
    imm it = items[i];
    if it.kind == K_SPECIMEN or it.kind == K_MAPLE or it.kind == K_PINE {
      imm row = if it.kind == K_SPECIMEN { 0usize; } elif it.kind == K_MAPLE { usize.from(SPECIMEN_VARIANTS); }
        else { usize.from(SPECIMEN_VARIANTS + MAPLE_VARIANTS); };
      out.push(Solid.circle(it.x, it.z, *trunks[row + usize.from(it.variant)] * it.scale, it.y - SOLID_BELOW, it.y + TREE_SOLID_TOP));
    } elif it.kind == K_ROCK {
      out.push(Solid.circle(it.x, it.z, it.radius, it.y - SOLID_BELOW, it.y + rockTop(*tops[usize.from(it.variant)], it.scale)));
    }
    i = i + 1usize;
  }
  cottageSolids(placeOf(COTTAGE, 0.).translation, &mut out);
  out;
}
