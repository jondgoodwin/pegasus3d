// The cottage chimney's smoke: a slow, soft stream of wood smoke, an emitter
// of vfx's smoke style (puffs drawn over what is behind them, not added as
// light). It is a closed form in each puff's age (vfx's emitters are
// descriptions, not simulations), in metres, in the chimney pot's frame:
//
//   RISE   a puff leaves the pot at 0.9 m/s (within a quarter), eases under a
//          little drag (0.1 a second) and is lifted by a little warmth that
//          cools in a few seconds: about 0.9 m/s at first, 0.5 m/s by the
//          end of its life, and 5.5 to 7.5 m above the pot at 8 s.
//   DRIFT  the world's breeze (weather.cone's wind: fixed in the world,
//          towards +x, away from the chimney's wall, the same wind that
//          carries the clouds), pushes with WIND_PUSH, 0.05 m/s/s, against the drag: a puff
//          settles to 0.5 m/s sideways, 1.2 m downwind of its rise by 8 s.
//   GROW   a puff is 0.26 m wide at the pot and 1.5 m by its end, and its
//          path wanders in a widening spiral (0.05 m/s of its age).
//   FADE   in over the first 8% of its life, out over the last 65%; it is a
//          mid grey at the pot, paler and thinner as it spreads.
//   IRREGULAR  six puffs a second, each with its own life (8 s, within
//          a quarter), speed, size, direction and place on the pot's mouth,
//          all drawn from the seed; puffs of unlike speed overtake one another.
//
// THE LIGHT. Smoke lights itself by nothing: it is a pale grey the sky and
// the sun light, so its colour here is an albedo and the browser scales it
// every frame by the light (RenderSystem.smokeLight: the exposure times the
// ambient and the sun's share, in the frame's units). At noon smoke is pale
// grey-white; at night it is dim, as the cottage's walls are.

const SMOKE_SEED = 5391u32;

pub fn chimneySmoke() Emitter {
  var e = Emitter.make();
  e.layer = 7u32;
  e.rate = 6.;
  e.lifetime = 8.;
  e.lifetimeJitter = 0.25;
  e.shape = SHAPE_DISC;
  e.radius = 0.07;
  e.spread = radians(10.);
  e.speed = 0.9;
  e.speedJitter = 0.25;
  e.drag = 0.1;
  e.gravity = v(WIND_PUSH * WIND_DIR_X, 0., WIND_PUSH * WIND_DIR_Z);
  e.buoyancy = 0.12;
  e.cooling = 0.3;
  e.wobble = 0.05;
  e.wobbleRate = 0.7;
  e.sizeStart = 0.26;
  e.sizeEnd = 1.5;
  e.sizeJitter = 0.3;
  e.fadeIn = 0.08;
  e.fadeOut = 0.65;
  e.colors = [Color(0.40, 0.40, 0.42, 0.5), Color(0.48, 0.48, 0.50, 0.4), Color(0.58, 0.58, 0.60, 0.3),
    Color(0.66, 0.66, 0.68, 0.18)];
  e.colorAt = [0., 0.3, 0.7, 1.];
  e
}

// The smoke's one layer, as smoke
pub fn chimneyPlume() List[EffectLayer] {
  var layers = List[EffectLayer].empty();
  layers.push(EffectLayer(chimneySmoke(), EFFECT_SMOKE));
  layers
}

// The smoke into 'h', on the pot's mouth: 'stack' is the stack's part (the
// pot's own frame), the mouth 0.435 m up the pot from the flaunching's foot
fn hydrateSmoke(h: &mut Hydrated, stack: usize) {
  let mouth = stackHeight() + FLAUNCH_TOP - POT_SINK + 0.435;
  h.effects.push(EffectDesc(String.from("chimney smoke"), chimneyPlume(), stack,
    Transform3(v(0., mouth, 0.), Quat.identity(), v(1., 1., 1.)), SMOKE_SEED, 0.0, EFFECT_NEVER));
}
