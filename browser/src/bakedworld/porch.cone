// The porch's clutter: two small clay pots with a clump of flowers in each,
// either side of the door, standing on the deck. (The lathed rook beside the
// door is sculptures.cone's, placed in bakedworld.cone's table.)
//
// A POT is one lathe of an outline traced by eye from a garden pot: a narrow
// foot, a belly, a rolled rim and, inside the rim, the soil's surface a little
// below it. It is the amphora's way (amphora.cone: a Profile lathed round y),
// in plain terracotta, with no paint; 0.35 m tall.
//
// A CLUMP of flowers is the vegetation's kind (leafrosette's flowerClumpMesh,
// the same call and the same paint as vegetation.cone's beds), a little
// smaller to fit the pot, one violet and one buttercup yellow, planted on the
// soil. Each pot and its clump are two parts, both in the world (the
// cottage is not their parent: they are the porch's, not the house's).
//
// WHERE. In the cottage's own frame (its front wall's middle on the ground, x
// to the right, z out towards the viewer), the deck is 0.6 m up, runs from x
// -2.4 to 2.7 and is 1.6 m deep; the door is 0.8 m wide at x = 0. The pots
// stand at x = -1.1 and 1.1, half a metre out from the wall, under the wall
// lanterns' brackets (x -0.7 and 0.85).

const POT_STEPS = 48u32;                 // the lathe's steps round
pub const POT_HEIGHT f32 = 0.345;        // the rim's top
pub const POT_SOIL f32 = 0.31;           // the soil's surface

// The pots' places in the cottage's frame: x, z
imm POT_PLACES Array[f32, 4] = [-1.1, 0.55, 1.1, 0.55];

// The pot's outline (radius, height), foot to rim and down inside it to the soil's middle
fn clayPotMesh() mesh.Mesh {
  imm pts Array[Vec2, 12] = [p2(0., 0.), p2(0.10, 0.), p2(0.11, 0.015), p2(0.14, 0.08), p2(0.17, 0.17), p2(0.185, 0.26),
    p2(0.19, 0.31), p2(0.20, 0.325), p2(0.20, 0.345), p2(0.18, 0.345), p2(0.17, 0.31), p2(0., 0.31)];
  imm profile = Profile.fromPoints(&pts, false);
  imm pot = lathe(&profile, up(), 2. * pi, POT_STEPS);
  pot.triangulate(true);
}

// The deck's top at world (x, z): the cottage's floor above the ground at its frame
fn deckHeight() f32 { groundHeight(PLACES[usize.from(COTTAGE) * 4usize], PLACES[usize.from(COTTAGE) * 4usize + 1usize]) + PORCH_FLOOR; }

// The pots and their flowers into 'h'
fn hydratePorchPots(h &mut Hydrated) {
  imm clay = h.addMaterial(Look.physicallyBased(srgb(178., 98., 62.), 0.8, 0.), Image.empty(), Maps.none(), 0u32);
  imm pot = h.addMesh(clayPotMesh());
  imm petals Array[Color, 2] = [rgbf(142., 106., 196.), rgbf(240., 206., 64.)];
  imm centres Array[Color, 2] = [rgbf(236., 214., 96.), rgbf(176., 120., 40.)];
  imm cx = PLACES[usize.from(COTTAGE) * 4usize];
  imm cz = PLACES[usize.from(COTTAGE) * 4usize + 1usize];
  imm y = deckHeight();
  mut k = 0usize;
  while k < 2usize {
    imm x = cx + POT_PLACES[k * 2usize];
    imm z = cz + POT_PLACES[k * 2usize + 1usize];
    imm bloom = h.addMaterial(Look.physicallyBased(white(), 0.7, 0.), flowerPaint(petals[k], centres[k]), Maps.none(), 0u32);
    mut p = new leafrosette.FlowerParams();
    p.seed = 140u32 + u32.from(k) * 9u32;
    p.flowers = 6 + i32.from(k) * 2;
    p.height = 0.32;
    p.head = 0.05;
    p.spread = 0.1;
    imm clump = h.addMesh(leafrosette.flowerClumpMesh(&p));
    imm at = new Transform3(v(x, y, z), Quat.angleAxis(0.9 * f32.from(k + 1usize), up()), v(1., 1., 1.));
    h.part("porch pot", pot, clay, TOP, at);
    h.part("porch flowers", clump, bloom, TOP,
      new Transform3(v(x, y + POT_SOIL - 0.01, z), at.rotation, v(1., 1., 1.)));
    k = k + 1usize;
  }
}
