// The baked-in world: what the browser shows before it can fetch one. It
// stands in for a world that arrives from elsewhere, so it reaches the
// browser exactly as a downloaded one will: it is given the scene's Door,
// reserves ids and sends requests, and nothing else. It never sees a scene
// table, the render system or a GPU handle (the scene module keeps them
// private: the Door is all a sender can hold).
//
// HYDRATE, THEN INJECT. Each object is a description in Cone, ported from
// the example programs of Cone's sculpt and vfx packages (examples are not
// importable, and these are this world's own content, not library code).
// Hydrating one runs its description through the libraries into plain data:
// meshes, materials and their paint images, emitters, and parts naming
// them with their parents and placements (a Hydrated, which holds no id
// and touches no scene). Injecting it defines its meshes and materials
// (one the world shares across objects only once), reserves an id for each
// of its parts and sends that part's Spawn, Place, Parent and Show (or
// Effect) through the Door. The Hydrated is the message: when worlds arrive from another actor,
// that actor hydrates and sends the Hydrated, and only 'inject' runs here.
//
// One object is hydrated and injected a call ('step'), so the browser keeps
// drawing frames while a world arrives, its objects appearing one by one.
//
// THE OBJECTS, in metres in the island's world (y up, +x east, +z south towards
// the sea; the cottage's front wall is centred at (-16, 330) and faces south
// down the path, and the viewer lands on the beach at (-22, 499) facing -z):
//   an amphora, 1.5 m          (a lidded black-figure amphora: its outline traced
//                               from a photograph and lathed, two handles swept,
//                               its bands painted; just east of the path, three
//                               metres before the cottage's steps)
//   a horn-flower, 2 m         (the horn as a plant: its stalk cut short, the
//                               flower's petals on the cut, leaves up it; beside
//                               the amphora)
//   the cottage, 7 m to the ridge (cottage.cone: measured from the reference frame, one
//                               tree of 26 parts: walls, battens, roofs, windows, door,
//                               porch, steps, two wall lanterns, and the brick chimney,
//                               chimney.cone's stack on a brick shaft, flaunching and a
//                               pot, 7.3 m up: bricks in stretcher bond, a colour, normal
//                               and ORM map)
//   a hot-air balloon, 25 m    (sculpt's balloon, the photograph's chevrons, its
//                               envelope painted; one burner head, vfx's burner flame
//                               on it; a wicker basket for two standing riders, open at
//                               the front, a platform they ride on; the launch button,
//                               a red cap on the back rail, whose clicks the world
//                               listens for: they send the balloon on its ride) in the
//                               backyard, 24 m behind the cottage
//   a lathed rook, 0.56 m      (sculpt's lathed rook: one lathe and four merlons joined
//                               on, ivory) on the porch deck's east end, beside the door
//   (the launch button)        (nothing now: the button is in the basket; its place is
//                               the boarding spot, where the lawn route round the
//                               cottage's east end ends)
//   a ball, 1 m across         (checkered; lying on the lawn east of the path, where
//                               a child left it)
//   twelve path lanterns, 0.5 m (cottage.cone: six pairs facing across the path's last 16 m;
//                               stake, glass, bulb and cap, each a part, in three materials shared with the cottage's wall lanterns)
//   two porch pots, 0.34 m     (porch.cone: a lathed clay pot with a clump of flowers
//                               in it, either side of the door)
//   rocks                      (the rock family, noiserock's meshes in the kit's granite,
//                               scattered by layout.cone: vegetation.cone)
//   the vegetation             (two specimen red maples, the pines and forest maples,
//                               edging stones, hostas, ferns and flowers: one part a copy
//                               of a few variants' meshes; layout.cone says where,
//                               vegetation.cone makes them)
//
// Not in this scene: the chess rook, the horn, the mound and the starship. The
// starship's code (dragonship/, gpu/) stays for a later space scene; hydrateShip
// below is its one way into a world, and nothing calls it.
//
// THE WORLD MOVES. Once a frame, 'tick' reads the world's mail (the button's
// clicks, posted by the browser into the Door) and sends its motions, each
// a formula of the scene's time (motions.cone), as Place and Fire requests.
//
// Its files are one module, and only this one, the designated file, imports:
//
//   bakedworld.cone   the objects' list and places, hydrate, inject, step, tick
//   motions.cone      the balloon's ride (its path, heading and speed) and its burner's bursts
//   balloon.cone      the balloon and its paint
//   flame.cone        the burner's flame and its pilot light
//   sculptures.cone   the lathed rook, the horn (the horn-flower's stalk)
//   layout.cone       where the vegetation stands: the rules and the seed
//   vegetation.cone   the trees', rocks' and plants' meshes, textures and parts
//   amphora.cone      the amphora, its handles and its paint
//   chimney.cone      the brick chimney (a shaft and a stack) and its maps
//   cottage.cone      the cottage, its materials, and the lanterns
//   lights.cone       what glows and when: dusk and dawn, nearness, pools of light
//   hornflower.cone   the horn-flower
//   porch.cone        the porch's pots and the flowers in them

mod bakedworld;

import stdio use *;
import libc;
import sdl;
import collections use *;
import geomath use *;
import mesh;
import noise;
import pbrmaterial;
import surfacepatterns;
import sculpt use *;
import render use Image;
import vfx use Emitter, SHAPE_DISC;
import parts use *;
import dragonship;
// The island: where the ground is, and where the path runs
import island use { groundHeight, groundSlope, forestDensity, pathCentreline, pathDistanceAt, insideFence, PATH_HALF_WIDTH,
  START_X, START_Z };
// The vegetation's generators (Cone's own packages)
import weberpenn;
import noiserock;
import leafrosette;

fn v(x f32, y f32, z f32) Vec3 { new Vec3(x, y, z); }
fn p2(x f32, y f32) Vec2 { new Vec2(x, y); }
fn up() Vec3 { v(0., 1., 0.); }
fn fract(x f32) f32 { x - libc.floorf(x); }

// sRGB 0-255 as a linear colour
fn srgb(r f32, g f32, b f32) Color {
  new Color(libc.powf(r / 255., 2.2), libc.powf(g / 255., 2.2), libc.powf(b / 255., 2.2), 1.);
}

// ---- Hydrated: an object as data ----

// No parent: a part placed in the world
pub const TOP = 0xFFFFFFFFusize;

// A material of an object: its look, paint and maps, and, if it is one the
// world shares across objects, its key (SHARED_ keys; 0: its own)
pub struct MaterialDesc {
  pub look Look;
  pub paint Image;
  pub maps Maps;              // a physical look's normal and ORM maps
  pub shared u32;

  pub fn empty() MaterialDesc { new MaterialDesc(Look.plain(new Color(1., 1., 1., 1.)), Image.empty(), Maps.none(), 0u32); }
}

// One part of an object: what it is called, which of the object's meshes
// and materials it is drawn as, its parent (another of the object's parts,
// before it; TOP: none) and where it stands in its parent's frame
pub struct PartDesc {
  pub name String;
  pub mesh usize;
  pub material usize;
  pub parent usize;
  pub at Transform3;
}

// One effect of an object: its layers, its parent (one of the object's
// parts; TOP: none) and where it starts in its parent's frame, the seed,
// and when it first fires and stops (the scene's seconds)
pub struct EffectDesc {
  pub name String;
  pub layers List[EffectLayer];
  pub parent usize;
  pub at Transform3;
  pub seed u32;
  pub start f64;
  pub stop f64;

  pub fn empty() EffectDesc {
    new EffectDesc(String.empty(), List[EffectLayer].empty(), TOP, Transform3.identity(), 0u32, 0d, 0d);
  }
}

// (The materials the world shares across its objects have keys 2 to 9, the
// cottage's, the lanterns' and the maples'; key 1 was the two rooks' ivory.)

// An object hydrated: its meshes, its materials, and its parts and effects
// naming them, ready to send
pub struct Hydrated {
  pub meshes List[mesh.Mesh];
  pub materials List[MaterialDesc];
  pub parts List[PartDesc];
  pub effects List[EffectDesc];

  pub fn empty() Hydrated {
    new Hydrated(List[mesh.Mesh].empty(), List[MaterialDesc].empty(), List[PartDesc].empty(), List[EffectDesc].empty());
  }

  // A mesh of the object: its index
  pub fn addMesh(self &mut, shape mesh.Mesh) usize {
    meshes.push(shape);
    meshes.len() - 1usize;
  }

  // A material of the object: its index
  pub fn addMaterial(self &mut, look Look, paint Image, maps Maps, shared u32) usize {
    materials.push(new MaterialDesc(look, paint, maps, shared));
    materials.len() - 1usize;
  }

  // A part drawn as mesh 'm' in material 'mat', under part 'parent': its index
  pub fn part(self &mut, name &str, m usize, mat usize, parent usize, at Transform3) usize {
    parts.push(new PartDesc(String.from(name), m, mat, parent, at));
    parts.len() - 1usize;
  }

  // A part with a mesh and a material of its own, placed in the world
  pub fn add(self &mut, name &str, shape mesh.Mesh, look Look, paint Image, at Transform3) usize {
    imm m = self.addMesh(shape);
    imm mat = self.addMaterial(look, paint, Maps.none(), 0u32);
    self.part(name, m, mat, TOP, at);
  }

  // A part of a physical look, with its maps
  pub fn addMapped(self &mut, name &str, shape mesh.Mesh, look Look, paint Image, maps Maps, at Transform3) usize {
    imm m = self.addMesh(shape);
    imm mat = self.addMaterial(look, paint, maps, 0u32);
    self.part(name, m, mat, TOP, at);
  }

  // How many triangles its parts draw (a mesh shared by several counted for each)
  pub fn triangles(self &) u64 {
    mut n = 0u64;
    mut i = 0usize;
    while i < parts.len() {
      n = n + u64.from(meshes[parts[i].mesh].triangleCount());
      i = i + 1usize;
    }
    n;
  }
}

// ---- The world's objects ----

// The objects placed come first (they have a row in PLACES), then the vegetation's
pub const OBJECTS = 16u32;
imm NAMES Array[&str, 16] = ["amphora", "horn-flower", "cottage", "balloon", "lathed rook", "launch button", "ball",
  "path lanterns", "porch pots", "rocks", "specimen maples", "pines", "forest maples", "edging stones",
  "hostas and ferns", "flowers"];

// The objects the world moves, or the script looks at
pub const AMPHORA = 0u32;
pub const HORNFLOWER = 1u32;
pub const COTTAGE = 2u32;
pub const BALLOON = 3u32;
pub const LATHED_ROOK = 4u32;
pub const BUTTON = 5u32;
pub const BALL = 6u32;
pub const LANTERNS = 7u32;
pub const PORCH_POTS = 8u32;

// Object 'k''s name
pub fn objectName(k u32) &str { NAMES[usize.from(k)]; }

// Where each stands, in the island's world: x, z, its yaw (radians) and its
// scale (metres a unit). (The browser began as a flat world with its own origin;
// the island put that world on its lowland, shifted by WORLD_DX and WORLD_DZ,
// and this table was once in its coordinates. Assembly moved most things, so it
// is in the island's now; the amphora and the cottage stand where they stood.)
imm PLACES Array[f32, 36] = [
  -13.4, 337., 0., 1.,          // the amphora: just east of the path, 3 m before the cottage's steps
  -10.9, 337.8, 0., 1.,         // the horn-flower, 2.5 m east of the amphora, leaning east, away from the path
  -16., 330., 0., 1.,           // the cottage: the middle of its front wall, facing +z, down the path
  -10., 300., 0.3, 9.,          // the balloon, in the backyard: 24 m behind the back wall, a little east of the
                                // cottage's middle, 9 m a unit. From the steps its envelope shows over the roof's right side.
                                // Turned so its basket's open front faces south-south-east, down the lawn route's end
  -13.8, 330.8, 0.3, 0.32,      // the lathed rook, on the porch deck's east end (its y is the deck's, PORCH_FLOOR):
                                // 0.56 m tall at this scale
  -6., 309., 0.5, 1.,           // where the launch button stood, 9 m short of the basket: now the boarding spot, where the
                                // lawn route round the cottage's east end ends (the button is in the basket; nothing stands here)
  -9., 342., 0.6, 1.,           // the ball, lying on the lawn east of the path, 12 m in front of the porch
  -16., 330., 0., 1.,           // the path lanterns' frame: the cottage's (they stand in its front path; not turned)
  -16., 330., 0., 1.];          // the porch pots' frame: the cottage's, too (their places are in porch.cone)

// The porch deck's top above the ground at the cottage's frame (cottage.cone's CT_FLOOR)
pub const PORCH_FLOOR f32 = 0.6;

// Where object 'k' stands: x and z
pub fn placeXZ(k u32) Vec2 { p2(PLACES[usize.from(k) * 4usize], PLACES[usize.from(k) * 4usize + 1usize]); }

// Object 'k' placed on the ground at its row's place, 'y' above it
fn placeOf(k u32, y f32) Transform3 {
  imm i = usize.from(k) * 4usize;
  imm s = PLACES[i + 3usize];
  imm x = PLACES[i];
  imm z = PLACES[i + 1usize];
  new Transform3(v(x, y + groundHeight(x, z), z), Quat.angleAxis(PLACES[i + 2usize], up()), v(s, s, s));
}

// A mesh moved so it stands on y = 0 centred on its own axis (x = z = 0)
fn grounded(m mesh.Mesh) mesh.Mesh {
  mut out = m;
  imm b = out.bounds();
  out.transform(Mat4.fromTranslation(v(0. - (b.min.x + b.max.x) * 0.5, 0. - b.min.y, 0. - (b.min.z + b.max.z) * 0.5)));
  out;
}

// Object 'k' as data: every mesh made and painted, every part placed
pub fn hydrate(k u32) Hydrated {
  mut h = Hydrated.empty();
  if k == AMPHORA {
    hydrateAmphora(&mut h, placeOf(k, 0.));
    print <- "The amphora: lathed in "; print <- amphoraStats.latheMs; print <- " ms, its handles in ";
    print <- amphoraStats.handlesMs; print <- " ms, its paint and ORM map in "; print <- amphoraStats.paintMs; print <- " ms\n";
  } elif k == HORNFLOWER {
    hydrateHornflower(&mut h, placeOf(k, 0.));
  } elif k == PORCH_POTS {
    hydratePorchPots(&mut h);
  } elif k == ROCKS {
    hydrateRocks(&mut h);
  } elif k == SPECIMENS {
    hydrateSpecimens(&mut h);
  } elif k == PINES {
    hydratePines(&mut h);
  } elif k == FOREST_MAPLES {
    hydrateForestMaples(&mut h);
  } elif k == EDGING {
    hydrateEdging(&mut h);
  } elif k == GROUNDCOVER {
    hydrateGroundcover(&mut h);
  } elif k == FLOWERS {
    hydrateFlowers(&mut h);
  } elif k == COTTAGE {
    hydrateCottage(&mut h, placeOf(k, 0.));
    print <- "The cottage's chimney: its bricks' colour and height in "; print <- chimneyStats.heightMs;
    print <- " ms, the normal map from the height in "; print <- chimneyStats.mapsMs; print <- " ms\n";
    print <- "The cottage's texture kit: board, shingle, deck and stone tiles baked in "; print <- cottageStats.bakeMs; print <- " ms\n";
  } elif k == LANTERNS {
    hydrateLanterns(&mut h, placeOf(k, 0.));
  } elif k == BALLOON {
    hydrateBalloon(&mut h, k);
  } elif k == LATHED_ROOK {
    // On the porch deck: its foot at the deck's top, not the ground's
    imm ivory = h.addMaterial(ivoryLook(), Image.empty(), Maps.none(), 0u32);
    imm shape = h.addMesh(grounded(lathedRookMesh(ROOK_STEPS)));
    h.part("lathed rook", shape, ivory, TOP, placeOf(k, PORCH_FLOOR));
    print <- "The lathed rook's merlon: "; print <- merlonHolesBefore; print <- " holes as lathed, ";
    print <- merlonHolesAfter; print <- " once capped\n";
  } elif k == BUTTON {
    // Nothing: the launch button rides in the balloon's basket now (balloon.cone).
    // The object keeps its place in the list, so the others' numbers stay.
  } elif k == BALL {
    // A ball a metre across, checkered; it lies where it was left, still
    h.add("ball", mesh.Mesh.sphere(BALL_RADIUS, 32), Look.checkered(srgb(240., 150., 30.), 0.25), Image.empty(),
      placeOf(k, BALL_RADIUS));
  }
  h;
}

// The rook's ivory
fn ivoryLook() Look { Look.shiny(srgb(232., 222., 196.), 0.5, 40.); }

// The balloon's heading as it stands on its spot (radians about +y)
pub fn balloonRestYaw() f32 { PLACES[usize.from(BALLOON) * 4usize + 2usize]; }

// ---- The starship (dragonship/, meshed on the GPU) ----

// Not in the cottage scene (a space scene will want it). Where it hovered there:
// 10 m a unit, 156 m long, outside the fence to the west; its lowest point (its
// keel, 2.8 units below its spine's line) this far above the ground
const SHIP_HOVER f32 = 12.;
const SHIP_SCALE f32 = 10.;
const SHIP_X f32 = -126.;
const SHIP_Z f32 = 184.;

fn hydrateShip(h &mut Hydrated) {
  mut ship = dragonship.meshShip();
  print <- "The starship: the world's GPU device made in "; print <- ship.deviceOnlyMs;
  print <- " ms, it and the kernels in "; print <- ship.deviceMs;
  print <- " ms, described in "; print <- ship.describeMs; print <- " ms, its frame meshed in "; print <- ship.frameMs;
  print <- " ms, its membranes in "; print <- ship.membraneMs; print <- " ms";
  if !ship.ok { print <- "; meshing FAILED"; }
  print <- "\n";
  imm at = new Transform3(v(SHIP_X, SHIP_HOVER + 2.8 * SHIP_SCALE + groundHeight(SHIP_X, SHIP_Z), SHIP_Z), Quat.identity(),
    v(SHIP_SCALE, SHIP_SCALE, SHIP_SCALE));
  mut frame = mesh.Mesh.empty();
  frame <=> ship.frame;
  mut skin = mesh.Mesh.empty();
  skin <=> ship.membrane;
  // Blue-black chitin, glossy; the membranes darker and dull
  h.add("starship frame", frame, Look.shiny(new Color(0.07, 0.08, 0.12, 1.), 0.9, 64.), Image.empty(), at);
  h.add("starship membranes", skin, Look.plain(new Color(0.035, 0.04, 0.065, 1.)), Image.empty(), at);
  // The lights, glowing (radiance in nits, against a sunlit scene's EV 15,
  // where 39 000 nits is white): the wings' cool blue-white, the ports dim
  // warm, the eyes and the mouth hot
  imm names Array[&str, 4] = ["starship wing lights", "starship ports", "starship eyes", "starship mouth"];
  imm colors Array[Color, 4] = [new Color(0.7, 0.8, 1., 1.), new Color(0.9, 0.45, 0.15, 1.),
    new Color(1., 0.6, 0.15, 1.), new Color(1., 0.75, 0.3, 1.)];
  imm nits Array[f32, 4] = [150000., 60000., 250000., 400000.];
  imm lights = ship.lights.viewMut();
  mut i = 0usize;
  while i < 4usize {
    mut m = mesh.Mesh.empty();
    m <=> lights[i];
    h.add(names[i], m, Look.shiny(colors[i], 1., 4.).glowing(colors[i], nits[i]), Image.empty(), at);
    i = i + 1usize;
  }
}

// ---- Inject: an object's parts sent through the Door ----

// Every mesh and material of 'h' defined, and every part reserved and
// sent: its Spawn, its Place, its Parent (if it has one), its Show or
// Effect. A material the world shares is defined once, the first time an
// object uses it, and kept in 'shared' (by its key) for the next. The ids
// go into 'ids', and where each was placed (in its parent's frame) into
// 'places'. 'h' is taken apart (its meshes and images move into the
// requests).
pub fn inject(h &mut Hydrated, door &mut Door, ids &mut List[PartId], places &mut List[Transform3],
    shared &mut List[MaterialId]) {
  mut meshIds = List[MeshId].withCapacity(h.meshes.len());
  imm meshes = h.meshes.viewMut();
  mut i = 0usize;
  while i < meshes.len {
    mut shape = mesh.Mesh.empty();
    shape <=> meshes[i];
    meshIds.push(door.defineMesh(shape));
    i = i + 1usize;
  }
  mut materialIds = List[MaterialId].withCapacity(h.materials.len());
  imm materials = h.materials.viewMut();
  i = 0usize;
  while i < materials.len {
    mut d = MaterialDesc.empty();
    d <=> materials[i];
    imm key = usize.from(d.shared);
    while shared.len() <= key { shared.push(MaterialId.none()); }
    if key > 0usize and !(*shared[key]).isNone() {
      materialIds.push(*shared[key]);
    } else {
      mut paint = Image.empty();
      paint <=> d.paint;
      mut maps = Maps.none();
      maps <=> d.maps;
      imm id = door.defineMaterial(d.look, paint, maps);
      if key > 0usize { shared.set(key, id); }
      materialIds.push(id);
    }
    i = i + 1usize;
  }
  imm first = ids.len();
  i = 0usize;
  while i < h.parts.len() {
    imm p = h.parts[i];
    imm id = door.newPart(p.name.view());
    door.send(Request.Place[id, p.at]);
    if p.parent != TOP { door.send(Request.Parent[id, *ids[first + p.parent]]); }
    door.send(Request.Show[id, *meshIds[p.mesh], *materialIds[p.material], 0.]);
    ids.push(id);
    places.push(p.at);
    i = i + 1usize;
  }
  imm effects = h.effects.viewMut();
  i = 0usize;
  while i < effects.len {
    mut e = EffectDesc.empty();
    e <=> effects[i];
    imm id = door.newPart(e.name.view());
    door.send(Request.Place[id, e.at]);
    if e.parent != TOP { door.send(Request.Parent[id, *ids[first + e.parent]]); }
    mut layers = List[EffectLayer].empty();
    layers <=> e.layers;
    door.send(Request.Effect[id, layers, e.seed, e.start, e.stop]);
    ids.push(id);
    places.push(e.at);
    i = i + 1usize;
  }
}

// The world's own timer: an alarm at ALARM_AT seconds of scene time, to
// show a timer's mail coming back
pub const ALARM_TOKEN = 1u64;
pub const ALARM_AT f64 = 3d;
// ---- The world's progress ----

// What hydrating one object cost
pub struct Hydration {
  pub object u32;
  pub parts u32;
  pub triangles u64;
  pub seconds f64;            // hydrating it (the meshes and the paint)
  pub injectSeconds f64;      // sending it
}

pub struct BakedWorld {
  next u32;
  pub ids List[PartId];       // every part it has sent, in the order sent
  places List[Transform3];    // where each was first placed
  firstOf List[usize];        // object k's first part's index in 'ids'
  pub log List[Hydration];
  pub flight Flight;          // the balloon's
  pub pressedAt f64;          // when the button was last pressed; negative: never
  capDown bool;               // the button's cap is drawn pressed
  sentRide f32;               // the seconds into the balloon's ride last sent (0: on its spot)
  pub fires u64;              // bursts of the burner fired (Fire requests sent)
  pub moves u64;              // Place requests sent by motions
  pub presses u64;            // the button's clicks read from the mail
  shared List[MaterialId];    // the materials it shares across objects, by key
  pub alarms u64;             // its alarm's rings read from the mail
  pub alarmHeardAt f64;       // the scene's time it read the last; negative: never
  pub arrivals u64;           // steps into the balloon's basket read from the mail
  pub departures u64;         // and goings out of it
  pub dusks u64;              // dusks and dawns read from the mail
  pub dawns u64;
  pub hardLandings u64;       // hard landings read from the mail
  pub lastLandingSpeed f32;
  pub lights Lights;          // what glows, when, and nearness to the path lanterns (lights.cone)

  pub fn make() BakedWorld {
    new BakedWorld(0u32, List[PartId].empty(), List[Transform3].empty(), List[usize].empty(), List[Hydration].empty(),
      Flight.grounded(), -1d, false, 0., 0u64, 0u64, 0u64, List[MaterialId].empty(), 0u64, -1d, 0u64, 0u64, 0u64, 0u64,
      0u64, 0., Lights.make());
  }

  // The materials the lights glow, as far as they are defined yet
  pub fn glowMaterials(self &) GlowMaterials {
    new GlowMaterials(self.sharedOf(SHARED_LANTERN_BULB), self.sharedOf(SHARED_LANTERN_GLASS),
      self.sharedOf(SHARED_LANTERN_POOL), self.sharedOf(SHARED_WINDOW_ROOM), self.sharedOf(SHARED_WINDOW_POOL));
  }

  // The material shared under 'key', or none if it is not defined yet
  fn sharedOf(self &, key u32) MaterialId {
    imm k = usize.from(key);
    if k < shared.len() { *shared[k]; } else { MaterialId.none(); };
  }

  // Whether every object has been sent
  pub fn done(self &) bool { next >= OBJECTS; }

  // Whether object 'k' has been sent
  pub fn has(self &, k u32) bool { next > k; }

  // Object 'k''s part 'j' (sent)
  pub fn partOf(self &, k u32, j usize) PartId { *ids[*firstOf[usize.from(k)] + j]; }

  // How many parts object 'k' has (sent)
  pub fn partsOf(self &, k u32) usize {
    imm from = *firstOf[usize.from(k)];
    if usize.from(k) + 1usize < firstOf.len() { *firstOf[usize.from(k) + 1usize] - from; } else { ids.len() - from; };
  }

  // The button's cap, in the balloon's basket: the part whose clicks the world listens for
  pub fn buttonCap(self &) PartId { if self.has(BALLOON) { self.partOf(BALLOON, BALLOON_CAP); } else { PartId.none(); }; }

  // The balloon's basket: the platform its riders stand on, and the area they step into
  pub fn basket(self &) PartId { if self.has(BALLOON) { self.partOf(BALLOON, BALLOON_BASKET); } else { PartId.none(); }; }

  // Once a frame, at the scene's time 'now' (seconds): the mail read (a
  // click on the button sends the balloon on its ride), then every motion
  // sent as Place (and Fire) requests: the button's cap, the balloon's
  // place on its ride and its burner (the ball lies still, and is sent nothing)
  pub fn tick(self &mut, door &mut Door, now f64) {
    lights.arrive(now);
    mut mail = door.takeMail();
    imm msgs = mail.viewMut();
    mut i = 0usize;
    while i < msgs.len {
      mut m Message = Message.Read[];
      m <=> msgs[i];
      match &mut m {
        case mut c &mut Clicked {
          if c.id == self.buttonCap() {
            presses = presses + 1u64;
            pressedAt = now;
            imm wasFlying = flight.flying(now);
            flight = flight.pressed(now);
            print <- "The world: the launch button pressed at "; print <- now; print <- " s; the balloon ";
            if wasFlying { print <- "is on its ride already (the press is ignored)\n"; }
            else { print <- "sets off on its ride ("; print <- FLIGHT_SECONDS; print <- " s)\n"; }
          }
        }
        case mut r &mut Rang {
          if r.token == ALARM_TOKEN {
            alarms = alarms + 1u64;
            alarmHeardAt = now;
            print <- "The world: its alarm for "; print <- r.at; print <- " s rang, heard at "; print <- now; print <- " s\n";
          }
        }
        case mut en &mut Entered {
          if lights.near(en.area, true) {
            print <- "The world: someone came near a path lantern at "; print <- now; print <- " s\n";
          }
          if en.area == self.basket() {
            arrivals = arrivals + 1u64;
            print <- "The world: someone stepped into the balloon's basket at "; print <- now; print <- " s\n";
          }
        }
        case mut lf &mut Left {
          lights.near(lf.area, false);
          if lf.area == self.basket() {
            departures = departures + 1u64;
            print <- "The world: someone stepped out of the balloon's basket at "; print <- now; print <- " s\n";
          }
        }
        case mut dk &mut Dusk {
          dusks = dusks + 1u64;
          lights.dusk(dk.at);
          print <- "The world: dusk, at "; print <- dk.at; print <- " s; the lamps go on\n";
        }
        case mut dn &mut Dawn {
          dawns = dawns + 1u64;
          lights.dawn(dn.at);
          print <- "The world: dawn, at "; print <- dn.at; print <- " s; the lamps go off\n";
        }
        case mut hl &mut HardLanding {
          hardLandings = hardLandings + 1u64;
          lastLandingSpeed = hl.speed;
          print <- "The world: a hard landing at "; print <- hl.speed; print <- " m/s, hurting "; print <- hl.damage; print <- "\n";
        }
        else {}
      }
      i = i + 1usize;
    }
    // The lamps: faded on or off, and the path lanterns brightened by nearness
    imm glowing = self.glowMaterials();
    lights.tick(door, now, &glowing);
    if self.has(BALLOON) {
      // The button's cap, on its mount in the basket (in the basket's frame: the balloon's units)
      imm down = pressedAt >= 0d and now - pressedAt < BUTTON_HELD;
      if down != capDown {
        capDown = down;
        imm j = *firstOf[usize.from(BALLOON)] + BALLOON_CAP;
        mut at = *places[j];
        if down { at.translation.y = at.translation.y - CAP_DIP; }
        door.send(Request.Place[*ids[j], at]);
        moves = moves + 1u64;
      }
      imm t = flight.elapsed(now);
      if t != sentRide {
        // The balloon is one tree: its envelope moved and turned, and
        // everything under it (skirt, cables, burner, flame, basket and
        // button) moves with it; whoever stands in the basket is carried
        // by the scene (the basket is a platform)
        sentRide = t;
        imm root = *firstOf[usize.from(BALLOON)];
        mut at = *places[root];
        imm pose = ridePose(t, balloonRestYaw());
        at.translation = at.translation + pose.offset;
        at.rotation = Quat.angleAxis(pose.yaw, up());
        door.send(Request.Place[*ids[root], at]);
        moves = moves + 1u64;
      }
      // The burner: its burst now, sent when it is not the last one sent
      imm burst = flight.burst(now);
      if burst.start != flight.firedStart or burst.stop != flight.firedStop {
        flight.firedStart = burst.start;
        flight.firedStop = burst.stop;
        imm flame = self.partOf(BALLOON, BALLOON_FLAME);
        door.send(Request.Fire[flame, noise.hash1(i32.from(burst.start * 10d), BALLOON_SEED), burst.start, burst.stop]);
        fires = fires + 1u64;
      }
    }
  }

  // Hydrate the next object and send it through 'door'; false once there
  // are none left
  pub fn step(self &mut, door &mut Door) bool {
    if next >= OBJECTS { return false; }
    // Its alarm, armed as it begins
    if next == 0u32 { door.timer(ALARM_TOKEN, ALARM_AT); }
    imm hz = f64.from(sdl.GetPerformanceFrequency());
    imm t0 = sdl.GetPerformanceCounter();
    mut h = hydrate(next);
    imm t1 = sdl.GetPerformanceCounter();
    imm parts = u32.from(h.parts.len() + h.effects.len());
    imm tris = h.triangles();
    firstOf.push(ids.len());
    inject(&mut h, door, &mut ids, &mut places, &mut shared);
    if next == BALLOON {
      // The button's clicks are the world's to hear; the basket is a
      // platform to stand on and ride, and an area: who steps in is told
      imm first = *firstOf[usize.from(BALLOON)];
      door.send(Request.Listen[*ids[first + BALLOON_CAP]]);
      door.send(Request.Platform[*ids[first + BALLOON_BASKET], basketPlatform()]);
      door.send(Request.Area[*ids[first + BALLOON_BASKET], basketArea()]);
    }
    if next == LANTERNS {
      // Each path lantern's stake is an area; coming near brightens its
      // glass, bulb and pool (cottage.cone: four parts a lantern, then the pools)
      imm first = *firstOf[usize.from(LANTERNS)];
      mut k = 0usize;
      while k < LANTERN_COUNT {
        imm stake = *ids[first + k * 4usize];
        door.send(Request.Area[stake, Volume.sphere(v(0., 0.2, 0.), NEAR_RADIUS)]);
        lights.addLantern(stake, *ids[first + k * 4usize + 1usize], *ids[first + k * 4usize + 2usize],
          *ids[first + LANTERN_POOLS + k]);
        k = k + 1usize;
      }
    }
    imm t2 = sdl.GetPerformanceCounter();
    log.push(new Hydration(next, parts, tris, f64.from(t1 - t0) / hz, f64.from(t2 - t1) / hz));
    next = next + 1u32;
    true;
  }

  // The log, printed
  pub fn report(self &) {
    mut total = 0d;
    mut tris = 0u64;
    mut i = 0usize;
    while i < log.len() {
      imm e = log[i];
      print <- "  "; printStr(objectName(e.object)); print <- ": "; print <- e.parts; print <- " parts, ";
      print <- e.triangles; print <- " triangles; hydrated in "; print <- e.seconds * 1000d; print <- " ms, sent in ";
      print <- e.injectSeconds * 1000d; print <- " ms\n";
      total = total + e.seconds + e.injectSeconds;
      tris = tris + e.triangles;
      i = i + 1usize;
    }
    print <- "  all: "; print <- ids.len(); print <- " parts, "; print <- tris; print <- " triangles, ";
    print <- total * 1000d; print <- " ms\n";
  }
}
