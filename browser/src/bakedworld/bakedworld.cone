// The island: where the ground is, and where the path runs
import island use { Island, Item, groundHeight, groundSlope, forestDensity, groveDensity, pathCentreline, pathDistanceAt, insideDressed, PATH_HALF_WIDTH,
  START_X, START_Z, BrookPoint, brookPoints, brookLength, brookDistanceAt, BROOK_BRIDGE };
