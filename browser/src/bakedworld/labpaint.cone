// The labyrinth's frescoes, painted at start-up as procedural textures (labyrinth.cone places them).
//
// METHOD. Each fresco is a tile of surfacepatterns' PatternField: a function of the texel's place (u, v) in the tile
// gives a height, a colour, a roughness and a cavity, and the package turns the field into the maps (a normal map from
// the height, ambient occlusion, an ORM map), exactly as the cottage's boards and flagstones are made. Nothing is a
// file and no photograph is read: every motif is drawn from signed distances (a circle, a capsule, a spiral arm, a
// wavy ribbon) in metres on the wall, in flat colours with dark outlines, the Minoan way. Raised plaster (the white
// ribbons of the Akrotiri rosettes) is a height, so the light catches it.
//
// THE TILES, each square, each strip or panel drawn in metres of the wall it will hang on:
//   band tile    1.8 m: the lower half 0.9 m the Akrotiri rosette band (blue rosettes in interlocking wavy white
//                       frames on red, a blue and black dentil strip above), the upper half the Knossos rosette
//                       chain (blue rosettes in a row on cream, between blue and red lines: the door frames')
//   spiral tile  1.8 m: the lower half running spirals on cream between blue, red and yellow lines (Queen's
//                       Megaron's), the upper half the throne room's red, blue and yellow wavy band
//   dolphins     3.0 x 1.5 m panel (the u axis is stretched twice as wide as the v): blue dolphins with white
//                       bellies, fish and sea urchins on cream with pale blue wavy water lines
//   griffins     3.0 x 1.5 m panel: red wall, the cream wavy ground, reeds and recumbent griffins with rosette collars
//   lilies       3.0 x 1.5 m panel: red trumpet lilies with yellow stamens on an ochre ground
//
// The palette is the fresco painters': ochre red, yellow ochre, Egyptian blue, near-black, lime white and the mixed
// green (Research\portal-and-labyrinth-ideas.md part b).

// Anti-aliasing: one texel of the strip tiles, metres
const LP_AA f32 = 0.0019;
const LP_PI f32 = 3.1415927;

fn lpCl(x f32) f32 { if x < 0. { 0. } elif x > 1. { 1. } else { x } }
fn lpFrac(x f32) f32 { x - libc.floorf(x) }
fn lpAbs(x f32) f32 { if x < 0. { 0. - x } else { x } }
fn lpMax(a f32, b f32) f32 { if a > b { a } else { b } }
fn lpMin(a f32, b f32) f32 { if a < b { a } else { b } }
fn lpLen(x f32, y f32) f32 { libc.sqrtf(x * x + y * y) }
fn lpStep(a f32, b f32, x f32) f32 { let t = lpCl((x - a) / (b - a)); t * t * (3. - 2. * t) }

// Coverage of a shape from its signed distance (negative inside), in metres
fn lpCov(d f32) f32 { lpCl(0.5 - d / LP_AA) }

// The distance to the segment a-b
fn lpSeg(x f32, y f32, ax f32, ay f32, bx f32, bz f32) f32 {
  let dx = bx - ax;
  let dy = bz - ay;
  let l2 = dx * dx + dy * dy;
  var t = 0.f;
  if l2 > 0.0000001 { t = lpCl(((x - ax) * dx + (y - ay) * dy) / l2); }
  lpLen(x - ax - dx * t, y - ay - dy * t)
}

// The signed distance to the triangle a, b, c (negative inside)
fn lpTri(x f32, y f32, ax f32, ay f32, bx f32, bz f32, cx f32, cz f32) f32 {
  let d = lpMin(lpSeg(x, y, ax, ay, bx, bz), lpMin(lpSeg(x, y, bx, bz, cx, cz), lpSeg(x, y, cx, cz, ax, ay)));
  let s1 = (bx - ax) * (y - ay) - (bz - ay) * (x - ax);
  let s2 = (cx - bx) * (y - bz) - (cz - bz) * (x - bx);
  let s3 = (ax - cx) * (y - cz) - (ay - cz) * (x - cx);
  if (s1 >= 0. && s2 >= 0. && s3 >= 0.) || (s1 <= 0. && s2 <= 0. && s3 <= 0.) { 0. - d } else { d }
}

fn pal(r f32, g f32, b f32) Color { surfacepatterns.rgb255(r, g, b) }

fn lpMixC(a Color, b Color, t f32) Color {
  new Color(a.red + (b.red - a.red) * t, a.green + (b.green - a.green) * t, a.blue + (b.blue - a.blue) * t, 1.)
}

// The painter's state at one texel: the colour so far, the plaster's height, the roughness
struct Px {
  c Color;
  h f32;
  r f32;

  fn lay(self &mut, col Color, cov f32, height f32) {
    if cov <= 0. { return; }
    c = lpMixC(c, col, cov);
    h = h + (height - h) * cov;
  }
}

// The fresco painters' colours (linear)
fn cRed() Color { pal(150., 52., 36.) }
fn cRedDeep() Color { pal(118., 38., 30.) }
fn cOchre() Color { pal(214., 160., 62.) }
fn cOchreDeep() Color { pal(186., 120., 40.) }
fn cBlue() Color { pal(70., 124., 186.) }
fn cBlueLight() Color { pal(128., 176., 220.) }
fn cBlueDark() Color { pal(34., 52., 92.) }
fn cBlack() Color { pal(34., 28., 30.) }
fn cWhite() Color { pal(240., 234., 214.) }
fn cCream() Color { pal(236., 224., 186.) }
fn cGreen() Color { pal(112., 128., 72.) }
fn cPink() Color { pal(226., 168., 146.) }

// The plaster's grain: a few thousandths of relief and a faint lightness, so a flat colour is not a plastic one
fn lpGrain(u f32, v f32, seed u32) f32 {
  surfacepatterns.fbmNoise(u, v, 24, 24, seed, 3, 0.55)
}

fn lpFinish(px &Px, u f32, v f32, seed u32) surfacepatterns.PatternTexel {
  let g = lpGrain(u, v, seed);
  let c = px.c;
  let k = 1. + 0.07 * g;
  new surfacepatterns.PatternTexel(lpCl(px.h + 0.05 * g), new Color(c.red * k, c.green * k, c.blue * k, 1.), 0.78 + 0.1 * g, 0.9 + 0.1 * lpCl(px.h * 2.))
}

// ---- A rosette: the blue flower of the bands and the door frames ----
fn lpRosette(p &mut Px, x f32, y f32, cx f32, cy f32, rad f32, petals f32) {
  let dx = x - cx;
  let dy = y - cy;
  let r = lpLen(dx, dy);
  if r > rad * 1.2 { return; }
  let th = libc.atan2f(dy, dx);
  let a = lpFrac(th * petals / (2. * LP_PI));
  let w = lpAbs(a - 0.5) * 2.;
  // The petals: a pointed tip at a = 1/2, a valley between
  let rp = rad * (1. - 0.42 * libc.powf(w, 1.3));
  let d = r - rp;
  p.lay(cBlueDark(), lpCov(d - 0.0045), 0.35);
  p.lay(cBlue(), lpCov(d), 0.38);
  // The inner flower, its petals between the outer's
  let a2 = lpFrac(th * petals / (2. * LP_PI) + 0.5);
  let w2 = lpAbs(a2 - 0.5) * 2.;
  let r2 = rad * 0.66 * (1. - 0.4 * libc.powf(w2, 1.3));
  p.lay(cBlueLight(), lpCov(r - r2), 0.4);
  p.lay(cBlueDark(), lpCov(lpAbs(r - rad * 0.30) - 0.0035), 0.4);
  p.lay(cCream(), lpCov(r - rad * 0.27), 0.4);
}

// ---- Akrotiri's rosette band (strip A): y up the band, 0 to 1.2 m, x along it, 0 to 1.8 m (a cell 1.8 m by 0.9, as the fresco's) ----
// (the first likeness check found the first version's cells too flat: 2.7 wide for each high where the fresco's are 1.5)
fn lpBandA(p &mut Px, x f32, y f32) {
  p.c = cRed();
  p.h = 0.18;
  let yc = 0.50f;
  let t = lpAbs(x - 0.9) / 0.9;
  let sq = libc.sqrtf(lpMax(0., 1. - t * t));
  let hh = 0.43 * libc.powf(lpMax(0.0001, 1. - t * t), 0.55) + 0.045 * libc.sinf(19. * t) * sq;
  let db = lpAbs(y - yc) - hh;
  // inside: lime-white ground
  p.lay(cCream(), lpCov(db + 0.105), 0.3);
  // the two wavy white ribbons, raised, a shadow line outside the first and a grey groove between
  let ribbon1 = lpAbs(db + 0.021) - 0.021;
  let ribbon2 = lpAbs(db + 0.083) - 0.019;
  p.lay(pal(104., 44., 34.), lpCov(lpAbs(db - 0.005) - 0.005), 0.12);
  p.lay(pal(176., 160., 138.), lpCov(lpAbs(db + 0.052) - 0.004), 0.2);
  p.lay(cWhite(), lpCov(ribbon1), 0.55 + 0.45 * lpCl(1. - lpAbs(db + 0.021) / 0.021));
  p.lay(cWhite(), lpCov(ribbon2), 0.55 + 0.45 * lpCl(1. - lpAbs(db + 0.083) / 0.019));
  // the rosettes of the cell: four, two above two
  if sq > 0.1 {
    lpRosette(p, x, y, 0.9 - 0.36, yc - 0.15, 0.16, 14.);
    lpRosette(p, x, y, 0.9 + 0.36, yc - 0.15, 0.16, 14.);
    lpRosette(p, x, y, 0.9 - 0.2, yc + 0.17, 0.155, 14.);
    lpRosette(p, x, y, 0.9 + 0.2, yc + 0.17, 0.155, 14.);
  }
  // the yellow crescents where the cells meet (the tile's edge, so each end draws its half)
  var k = 0;
  while k < 2 {
    let cx = 1.8 * f32.from(k);
    let dc = lpLen(x - cx, y - yc) - 0.036;
    let dd = lpLen(x - cx - 0.014, y - yc + 0.01) - 0.034;
    p.lay(cOchre(), lpCov(lpMax(dc, 0. - dd)), 0.6);
    k = k + 1;
  }
  // the dentil strip along the top: near black with blue teeth, over a white line
  p.lay(cWhite(), lpCov(lpAbs(y - 1.075) - 0.007), 0.4);
  p.lay(cBlack(), lpCov(1.09 - y), 0.2);
  let tooth = lpAbs(lpFrac(x / 0.05) - 0.5) - 0.3;
  p.lay(cBlue(), lpCl(0.5 - tooth * 0.05 / LP_AA) * lpCov(lpAbs(y - 1.14) - 0.05), 0.25);
}

// ---- Knossos's rosette chain (strip B): 4 rosettes in a row on cream between blue and red lines ----
fn lpBandB(p &mut Px, x f32, y f32) {
  p.c = cCream();
  p.h = 0.25;
  // (0.54 m high: lines at the edges, a rosette 0.37 across in the middle)
  p.lay(cBlue(), lpCov(lpAbs(y - 0.02) - 0.02), 0.3);
  p.lay(cBlue(), lpCov(lpAbs(y - 0.52) - 0.02), 0.3);
  p.lay(cRed(), lpCov(lpAbs(y - 0.054) - 0.006), 0.3);
  p.lay(cRed(), lpCov(lpAbs(y - 0.486) - 0.006), 0.3);
  p.lay(cOchre(), lpCov(lpAbs(y - 0.07) - 0.003), 0.3);
  p.lay(cOchre(), lpCov(lpAbs(y - 0.47) - 0.003), 0.3);
  let cell = lpFrac(x / 0.45) * 0.45;
  p.lay(cBlue(), lpCov(lpLen(cell - 0.225, y - 0.27) - 0.205), 0.3);
  p.lay(cCream(), lpCov(lpLen(cell - 0.225, y - 0.27) - 0.19), 0.3);
  lpRosette(p, cell, y, 0.225, 0.27, 0.185, 16.);
  p.lay(cPink(), lpCov(lpLen(cell - 0.225, y - 0.27) - 0.045), 0.4);
  p.lay(cOchre(), lpCov(lpLen(cell - 0.225, y - 0.27) - 0.02), 0.4);
}

pub fn bandTexel(u f32, v f32) surfacepatterns.PatternTexel {
  var p = new Px(cRed(), 0.2, 0.8);
  let x = u * 1.8;
  if v < 0.6667 { lpBandA(&mut p, x, v * 1.8); }
  elif v >= 0.7 { lpBandB(&mut p, x, (v - 0.7) * 1.8); }
  lpFinish(&p, u, v, 11u32)
}

// ---- A spiral arm of the running spiral: the distance to a spiral of outer radius 'rad' about (cx, cy) ----
// counterclockwise inward, 2.35 turns, starting at angle 0 (its outer end level with the centre, on the right)
fn lpSpiral(x f32, y f32, cx f32, cy f32, rad f32) f32 {
  let dx = x - cx;
  let dy = y - cy;
  let r = lpLen(dx, dy);
  let turns = 2.35f;
  let total = turns * 2. * LP_PI;
  let rin = rad * 0.1;
  let b = (rad - rin) / total;
  let phi = libc.atan2f(dy, dx);
  let want = (rad - r) / b;
  let n = libc.floorf((want - phi) / (2. * LP_PI) + 0.5);
  var s = phi + 2. * LP_PI * n;
  if s < 0. { s = s + 2. * LP_PI; }
  if s > total { s = total; }
  let ra = rad - b * s;
  var best = lpLen(x - cx - ra * libc.cosf(s), y - cy - ra * libc.sinf(s));
  let s2 = s - 2. * LP_PI;
  if s2 >= 0. {
    let ra2 = rad - b * s2;
    let d2 = lpLen(x - cx - ra2 * libc.cosf(s2), y - cy - ra2 * libc.sinf(s2));
    if d2 < best { best = d2; }
  }
  let s3 = s + 2. * LP_PI;
  if s3 <= total {
    let ra3 = rad - b * s3;
    let d3 = lpLen(x - cx - ra3 * libc.cosf(s3), y - cy - ra3 * libc.sinf(s3));
    if d3 < best { best = d3; }
  }
  // a radial gap is longer than the true distance to a coiling arm
  best * lpMax(0.82, r / libc.sqrtf(r * r + b * b))
}

// Running spirals (strip C): spirals 0.45 m apart on one line, each linked to the next by an arch over the top
fn lpBandC(p &mut Px, x f32, y f32) {
  p.c = cCream();
  p.h = 0.25;
  p.lay(cBlue(), lpCov(lpAbs(y - 0.03) - 0.03), 0.3);
  p.lay(cBlue(), lpCov(lpAbs(y - 0.87) - 0.03), 0.3);
  p.lay(cRed(), lpCov(lpAbs(y - 0.082) - 0.008), 0.3);
  p.lay(cRed(), lpCov(lpAbs(y - 0.818) - 0.008), 0.3);
  p.lay(cOchre(), lpCov(lpAbs(y - 0.104) - 0.004), 0.3);
  p.lay(cOchre(), lpCov(lpAbs(y - 0.796) - 0.004), 0.3);
  let cy = 0.45f;
  let rad = 0.17f;
  let k0 = libc.floorf(x / 0.45);
  var best = 9.f;
  var j = -1;
  while j <= 1 {
    let cx = (k0 + f32.from(j) + 0.5) * 0.45;
    let d = lpSpiral(x, y, cx, cy, rad);
    if d < best { best = d; }
    // the arch from this spiral's outer end (on its right) up and over, down onto the next one's outer arm on its left
    let bb = (rad - rad * 0.1) / (2.35 * 2. * LP_PI);
    let gap = 0.45 - 2. * rad + bb * LP_PI;
    let ax = cx + rad + gap * 0.5;
    let da = lpAbs(lpLen(x - ax, y - cy) - gap * 0.5);
    if y > cy - 0.001 && da < best { best = da; }
    j = j + 1;
  }
  p.lay(cBlack(), lpCov(best - 0.0105), 0.55);
  p.lay(pal(98., 36., 30.), lpCov(best - 0.0072), 0.5);
  let kc = libc.floorf(x / 0.45);
  let ccx = (kc + 0.5) * 0.45;
  p.lay(cBlue(), lpCov(lpLen(x - ccx, y - cy) - 0.022), 0.5);
}

// The throne room's wavy band (strip D): red, blue, yellow and cream waves, solid, running along it
fn lpBandD(p &mut Px, x f32, y f32) {
  p.c = cCream();
  p.h = 0.2;
  let wave = 0.045 * libc.sinf(x * 26.) + 0.02 * libc.sinf(x * 61. + 1.3);
  let yy = y + wave;
  let idx = libc.floorf(yy / 0.065);
  let m = idx - 3. * libc.floorf(idx / 3.);
  var col = cRed();
  if m > 1.5 { col = cBlue(); } elif m > 0.5 { col = cOchre(); }
  p.lay(col, lpCl(1. - lpAbs(yy - 0.45) * 2.6) , 0.3);
  p.lay(cBlack(), lpCov(lpAbs(lpFrac(yy / 0.065) - 0.5) * 0.065 - 0.031) * 0.0, 0.3);
  p.lay(cRed(), lpCov(lpAbs(y - 0.03) - 0.02), 0.25);
  p.lay(cRed(), lpCov(lpAbs(y - 0.87) - 0.02), 0.25);
}

pub fn spiralTexel(u f32, v f32) surfacepatterns.PatternTexel {
  var p = new Px(cCream(), 0.2, 0.8);
  let x = u * 1.8;
  if v < 0.5 { lpBandC(&mut p, x, v * 1.8); }
  else { lpBandD(&mut p, x, (v - 0.5) * 1.8); }
  lpFinish(&p, u, v, 12u32)
}

// ---- The panels (3.0 m by 1.5 m: u across the 3 m, v up the 1.5 m) ----

// A fish at (cx, cy), length 'len', heading along +x if 'dir' is 1 (-1 the other way), a body colour and a back colour
fn lpFish(p &mut Px, x f32, y f32, cx f32, cy f32, len f32, dir f32, body Color, back Color) {
  let dx = (x - cx) * dir;
  let dy = y - cy;
  if lpAbs(dx) > len * 0.7 || lpAbs(dy) > len * 0.4 { return; }
  let bl = len * 0.5;
  let bt = len * 0.14;
  let e = (lpLen(dx / bl, dy / bt) - 1.) * bt;
  let tail = lpTri(dx, dy, 0. - bl * 0.7, 0., 0. - len * 0.7, bt * 1.6, 0. - len * 0.7, 0. - bt * 1.6);
  let d = lpMin(e, tail);
  p.lay(cBlueDark(), lpCov(d - 0.0035), 0.3);
  p.lay(body, lpCov(d), 0.35);
  p.lay(back, lpCov(lpMax(d, bt * 0.1 - dy)), 0.35);
  p.lay(cBlack(), lpCov(lpLen(dx - bl * 0.55, dy - bt * 0.1) - len * 0.018), 0.3);
}

// The dolphin's body half-thickness at 'u' (0 at the tail's root, 1 at the head)
fn lpProf(u f32) f32 {
  let us Array[f32, 10] = [0., 0.11, 0.22, 0.33, 0.44, 0.55, 0.66, 0.77, 0.88, 1.];
  let rs Array[f32, 10] = [0.012, 0.03, 0.062, 0.088, 0.1, 0.098, 0.088, 0.075, 0.062, 0.05];
  var i = 1usize;
  while i < 9usize && u > us[i] { i = i + 1usize; }
  let t = lpCl((u - us[i - 1usize]) / (us[i] - us[i - 1usize]));
  rs[i - 1usize] + (rs[i] - rs[i - 1usize]) * t
}

// A dolphin of 1 m (times 'sc'): the body a chain of circles along a bowed spine, its head at +x of its own frame, turned 'ang'
// radians about (cx, cy); flipped if 'flip' is -1
fn lpDolphin(p &mut Px, x f32, y f32, cx f32, cy f32, sc f32, ang f32, flip f32) {
  let ca = libc.cosf(ang);
  let sa = libc.sinf(ang);
  let rx = x - cx;
  let ry = y - cy;
  let lx = (rx * ca + ry * sa) / sc;
  let ly = (0. - rx * sa + ry * ca) / sc * flip;
  if lx < -0.66 || lx > 0.6 || ly < -0.3 || ly > 0.36 { return; }
  var best = 9.f;
  var belly = 9.f;
  var i = 0;
  while i <= 30 {
    let u = f32.from(i) / 30.;
    let xs = -0.5 + 0.9 * u;
    let ys = 0.045 * libc.sinf(LP_PI * u) - 0.02;
    let r = lpProf(u);
    let d = lpLen(lx - xs, ly - ys) - r;
    if d < best { best = d; }
    let db = lpLen(lx - xs, ly - (ys - r * 0.55)) - r * 0.62;
    if db < belly { belly = db; }
    i = i + 1;
  }
  best = lpMin(best, lpSeg(lx, ly, 0.38, -0.02, 0.53, -0.04) - 0.016);
  // the tail flukes, a crescent: two leaves out from the tail's root
  best = lpMin(best, lpTri(lx, ly, -0.49, 0.0, -0.63, 0.11, -0.565, 0.0));
  best = lpMin(best, lpTri(lx, ly, -0.49, 0.0, -0.63, -0.11, -0.565, 0.0));
  // the dorsal fin, swept back, and the pectoral fin below
  best = lpMin(best, lpTri(lx, ly, -0.03, 0.1, 0.09, 0.1, -0.09, 0.185));
  best = lpMin(best, lpTri(lx, ly, 0.12, -0.07, 0.03, -0.2, 0.21, -0.12));
  let dd = best * sc;
  p.lay(cBlueDark(), lpCov(dd - 0.0045), 0.3);
  p.lay(cBlue(), lpCov(dd), 0.35);
  // the white belly with its yellow edge, and the eye
  let inBody = lpCov(dd + 0.004);
  p.lay(cOchre(), lpCov(belly * sc) * inBody, 0.3);
  p.lay(cWhite(), lpCov(belly * sc + 0.006) * inBody, 0.3);
  p.lay(cBlack(), lpCov(lpLen(lx - 0.30, ly - 0.015) * sc - 0.0075), 0.3);
}

// The water: pale blue wavy lines on cream
fn lpWater(p &mut Px, x f32, y f32) {
  let wx = x * 9. + 0.9 * libc.sinf(y * 11. + x * 2.) + 0.5 * libc.sinf(y * 29.);
  let wy = y * 11. + 0.7 * libc.sinf(x * 7. + 1.) + 0.4 * libc.sinf(x * 23.);
  let w1 = lpFrac(wx * 0.5 + wy * 0.35);
  let w2 = lpFrac(wy * 0.5 - wx * 0.3);
  let d1 = lpMin(w1, 1. - w1);
  let d2 = lpMin(w2, 1. - w2);
  p.lay(pal(160., 196., 222.), lpCl(1. - d1 / 0.045) * 0.9, 0.22);
  p.lay(pal(160., 196., 222.), lpCl(1. - d2 / 0.045) * 0.9, 0.22);
}

pub fn dolphinTexel(u f32, v f32) surfacepatterns.PatternTexel {
  var p = new Px(cCream(), 0.2, 0.8);
  let x = u * 3.;
  let y = v * 1.5;
  lpWater(&mut p, x, y);
  // the fish, a few, in blue, yellow and rose
  lpFish(&mut p, x, y, 0.35, 1.0, 0.20, 1., cBlue(), cBlueDark());
  lpFish(&mut p, x, y, 0.92, 0.70, 0.17, 1., cOchre(), cOchreDeep());
  lpFish(&mut p, x, y, 1.62, 1.18, 0.18, -1., cBlueLight(), cBlueDark());
  lpFish(&mut p, x, y, 1.78, 0.52, 0.15, 1., cPink(), cRed());
  lpFish(&mut p, x, y, 2.85, 1.12, 0.17, -1., cBlue(), cBlueDark());
  lpFish(&mut p, x, y, 0.30, 0.45, 0.15, 1., cOchre(), cOchreDeep());
  lpFish(&mut p, x, y, 1.20, 0.38, 0.12, 1., cOchre(), cOchreDeep());
  // the dolphins: four, on slants, heads down
  lpDolphin(&mut p, x, y, 0.80, 0.55, 0.95, -0.34, 1.);
  lpDolphin(&mut p, x, y, 1.45, 0.88, 0.95, -0.22, 1.);
  lpDolphin(&mut p, x, y, 2.25, 0.92, 0.95, -0.2, 1.);
  lpDolphin(&mut p, x, y, 2.40, 0.38, 0.85, -0.3, 1.);
  // the cloud-scallops along the top and the sea urchins along the bottom (near black)
  var k = 0;
  while k < 12 {
    let bx = 0.12 + 0.25 * f32.from(k);
    p.lay(cBlueDark(), lpCov(lpLen(x - bx, y - 1.5) - 0.13), 0.3);
    k = k + 1;
  }
  k = 0;
  while k < 9 {
    let bx = 0.2 + 0.34 * f32.from(k) + 0.06 * libc.sinf(f32.from(k) * 2.3);
    p.lay(cBlack(), lpCov(lpLen(x - bx, y - 0.02) - (0.06 + 0.02 * lpFrac(f32.from(k) * 0.7))), 0.4);
    k = k + 1;
  }
  // the red frame lines
  p.lay(cRed(), lpCov(lpAbs(y - 0.012) - 0.012), 0.3);
  p.lay(cRed(), lpCov(lpAbs(y - 1.488) - 0.012), 0.3);
  p.lay(cRed(), lpCov(lpAbs(x - 0.012) - 0.012), 0.3);
  p.lay(cRed(), lpCov(lpAbs(x - 2.988) - 0.012), 0.3);
  lpFinish(&p, u, v, 13u32)
}

// ---- A reed: a stem with leaf pairs, in the throne room's griffin frieze ----
fn lpReed(p &mut Px, x f32, y f32, bx f32, b0 f32, hgt f32, lean f32) {
  let dx = x - bx - lean * (y - b0) * (y - b0);
  let dy = y - b0;
  if dy < -0.02 || dy > hgt + 0.1 || lpAbs(dx) > 0.2 { return; }
  var best = lpAbs(dx);
  if dy < 0. || dy > hgt { best = 1.; }
  var i = 1;
  while i <= 5 {
    let ly = b0 + hgt * f32.from(i) / 5.5;
    let len = 0.14 * (1. - f32.from(i) / 7.);
    let lx0 = bx + lean * (ly - b0) * (ly - b0);
    let dl = lpSeg(x, y, lx0, ly, lx0 - len, ly + len * 0.9);
    let dr = lpSeg(x, y, lx0, ly, lx0 + len, ly + len * 0.9);
    if dl < best { best = dl; }
    if dr < best { best = dr; }
    i = i + 1;
  }
  p.lay(pal(120., 134., 104.), lpCov(best - 0.0045), 0.35);
}

// A griffin lying on its belly, facing +x of its frame (flip -1: the other way), 1.2 m from its tail's root to its beak
fn lpGriffin(p &mut Px, x f32, y f32, cx f32, cy f32, sc f32, flip f32) {
  let lx = (x - cx) * flip / sc;
  let ly = (y - cy) / sc;
  if lx < -0.95 || lx > 0.75 || ly < -0.2 || ly > 0.8 { return; }
  // the body: a long ellipse on the ground, the haunch, the folded foreleg and its paw
  var best = (lpLen((lx + 0.15) / 0.46, (ly - 0.1) / 0.12) - 1.) * 0.12;
  best = lpMin(best, lpLen(lx + 0.45, ly - 0.09) - 0.14);
  best = lpMin(best, lpSeg(lx, ly, 0.1, 0.06, 0.42, 0.03) - 0.04);
  best = lpMin(best, lpLen(lx - 0.46, ly - 0.035) - 0.05);
  // the chest and neck, up to the head; the head, the hooked beak
  best = lpMin(best, lpSeg(lx, ly, 0.17, 0.12, 0.25, 0.30) - 0.09);
  best = lpMin(best, lpSeg(lx, ly, 0.25, 0.30, 0.29, 0.50) - 0.06);
  best = lpMin(best, lpLen(lx - 0.31, ly - 0.55) - 0.07);
  best = lpMin(best, lpSeg(lx, ly, 0.34, 0.56, 0.47, 0.53) - 0.028);
  best = lpMin(best, lpSeg(lx, ly, 0.47, 0.53, 0.485, 0.47) - 0.018);
  // the tail: a long curl up behind
  best = lpMin(best, lpSeg(lx, ly, -0.58, 0.12, -0.72, 0.2) - 0.02);
  best = lpMin(best, lpSeg(lx, ly, -0.72, 0.2, -0.78, 0.38) - 0.017);
  best = lpMin(best, lpSeg(lx, ly, -0.78, 0.38, -0.70, 0.52) - 0.015);
  best = lpMin(best, lpSeg(lx, ly, -0.70, 0.52, -0.6, 0.5) - 0.013);
  let d = best * sc;
  p.lay(pal(120., 80., 50.), lpCov(d - 0.0045), 0.55);
  p.lay(cCream(), lpCov(d), 0.6);
  // the wing: curling scrolls over the shoulder in red, blue and ochre
  var k = 0;
  while k < 4 {
    let kk = f32.from(k);
    let rr = (0.06 + 0.035 * kk) * sc;
    let ringY = cy + (0.22 + 0.02 * kk) * sc;
    let ring = lpAbs(lpLen(x - cx - (0.06 + 0.012 * kk) * sc * flip, y - ringY) - rr) - 0.0055;
    let onBody = lpCl((y - ringY) * 60.);
    var col = cRed();
    if k % 2 == 1 { col = cBlue(); }
    p.lay(col, lpCov(ring) * onBody, 0.6);
    k = k + 1;
  }
  // the crest: scrolls behind the head
  var j = 0;
  while j < 3 {
    let jj = f32.from(j);
    let rr = (0.035 + 0.02 * jj) * sc;
    let ring = lpAbs(lpLen(x - cx - (0.25 - 0.015 * jj) * sc * flip, y - cy - (0.58 + 0.01 * jj) * sc) - rr) - 0.0045;
    let behind = lpCl((0.31 - lx) * 30.);
    p.lay(cRed(), lpCov(ring) * behind, 0.6);
    j = j + 1;
  }
  // the collar: a rosette on the chest; the eye and the beak's tip
  lpRosette(p, x, y, cx + 0.255 * sc * flip, cy + 0.27 * sc, 0.062 * sc, 12.);
  p.lay(cBlack(), lpCov((lpLen(lx - 0.33, ly - 0.565) - 0.012) * sc), 0.6);
  p.lay(cOchre(), lpCov((lpLen(lx - 0.455, ly - 0.52) - 0.016) * sc), 0.6);
}

pub fn griffinTexel(u f32, v f32) surfacepatterns.PatternTexel {
  var p = new Px(cRed(), 0.2, 0.8);
  let x = u * 3.;
  let y = v * 1.5;
  // the cream stripes high up the wall
  p.lay(cCream(), lpCov(lpAbs(y - 1.42) - 0.018), 0.3);
  p.lay(cCream(), lpCov(lpAbs(y - 1.34) - 0.018), 0.3);
  p.lay(cCream(), lpCov(lpAbs(y - 1.26) - 0.018), 0.3);
  // the cream ground: a wavy upper edge, over the frieze's lower half
  let top = 0.62 + 0.09 * libc.sinf(x * 5.1) + 0.06 * libc.sinf(x * 11.7 + 2.) + 0.04 * libc.sinf(x * 19.);
  p.lay(cCream(), lpCov(y - top), 0.3);
  // reeds
  var k = 0;
  while k < 8 {
    let rx = 0.35 + 0.37 * f32.from(k) + 0.03 * f32.from(k % 3);
    lpReed(&mut p, x, y, rx, 0.45, 0.5 + 0.06 * f32.from(k % 2), 0.2 - 0.05 * f32.from(k % 4));
    k = k + 1;
  }
  // the griffins, one each way
  lpGriffin(&mut p, x, y, 0.95, 0.40, 1.05, 1.);
  lpGriffin(&mut p, x, y, 2.3, 0.40, 1.05, -1.);
  // the wavy band along the foot of the frieze
  p.lay(cRedDeep(), lpCov(lpAbs(y - 0.17) - 0.008), 0.3);
  let stripe = lpFrac(x * 5. + 0.4 * libc.sinf(y * 40. + x * 3.));
  if y < 0.15 {
    var col = cRed();
    if stripe > 0.66 { col = cBlue(); } elif stripe > 0.33 { col = cOchre(); }
    p.lay(col, lpCl(0.5 + (0.15 - y) / LP_AA * 0.3), 0.25);
  }
  lpFinish(&p, u, v, 14u32)
}

// ---- A lily: three on a ground of ochre (Akrotiri's Spring fresco) ----
fn lpPetal(x f32, y f32, ox f32, oy f32, ang f32, len f32, wid f32) f32 {
  // a leaf from (ox, oy) out along 'ang', widest a third of the way
  let ca = libc.cosf(ang);
  let sa = libc.sinf(ang);
  let lx = ((x - ox) * ca + (y - oy) * sa) / len;
  let ly = (0. - (x - ox) * sa + (y - oy) * ca) / wid;
  if lx < 0. || lx > 1. { return 1.; }
  let half = libc.sqrtf(lpMax(0., lx)) * (1. - lx) * 2.0 + 0.0001;
  (lpAbs(ly) - half * 0.5 * 2.) * wid * 0.6
}

fn lpLily(p &mut Px, x f32, y f32, bx f32, b0 f32, hgt f32, lean f32, scale f32) {
  let dy = y - b0;
  if dy < -0.02 || dy > hgt + 0.4 || lpAbs(x - bx) > 0.6 { return; }
  // the stem, curving
  let sx = bx + lean * (y - b0) * (y - b0) / hgt;
  var stem = lpAbs(x - sx) - 0.006;
  if dy < 0. || dy > hgt { stem = 1.; }
  p.lay(cBlack(), lpCov(stem - 0.0025), 0.35);
  p.lay(cGreen(), lpCov(stem), 0.35);
  // two leaves on the stem
  let lf1 = lpPetal(x, y, bx + lean * 0.05 * hgt, b0 + hgt * 0.25, 0.5, 0.2 * scale, 0.04 * scale);
  let lf2 = lpPetal(x, y, bx + lean * 0.12 * hgt, b0 + hgt * 0.4, 2.65, 0.2 * scale, 0.04 * scale);
  p.lay(cBlack(), lpCov(lpMin(lf1, lf2) - 0.003), 0.35);
  p.lay(cGreen(), lpCov(lpMin(lf1, lf2)), 0.35);
  // the flower: three trumpet petals fanned out and curled, red with a dark outline and a lighter vein
  let fx = bx + lean * hgt;
  let fy = b0 + hgt;
  var pet = 9.f;
  var i = 0;
  while i < 3 {
    let a = 0.55 + 0.85 * f32.from(i);
    let d = lpPetal(x, y, fx, fy, a, 0.22 * scale, 0.07 * scale);
    if d < pet { pet = d; }
    i = i + 1;
  }
  p.lay(cBlack(), lpCov(pet - 0.0045), 0.4);
  p.lay(cRed(), lpCov(pet), 0.45);
  p.lay(cRedDeep(), lpCov(pet + 0.014), 0.4);
  // stamens: long curved threads ending in yellow dots
  var j = 0;
  while j < 5 {
    let sa = 0.9 + 0.3 * f32.from(j);
    let tx = fx + 0.17 * scale * libc.cosf(sa);
    let ty = fy + 0.17 * scale * libc.sinf(sa);
    p.lay(cBlack(), lpCov(lpSeg(x, y, fx, fy, tx, ty) - 0.0013), 0.4);
    p.lay(cOchreDeep(), lpCov(lpLen(x - tx, y - ty) - 0.009), 0.45);
    j = j + 1;
  }
}

pub fn lilyTexel(u f32, v f32) surfacepatterns.PatternTexel {
  var p = new Px(cOchre(), 0.2, 0.8);
  let x = u * 3.;
  let y = v * 1.5;
  // ochre ground, mottled with paler rock
  let m = surfacepatterns.fbmNoise(u, v, 6, 3, 15u32, 3, 0.5);
  p.c = lpMixC(cOchre(), pal(236., 196., 120.), lpCl(0.5 + m * 1.4));
  // a white wavy line low, the sea of the spring's ground
  p.lay(cWhite(), lpCov(lpAbs(y - 0.18 - 0.05 * libc.sinf(x * 6.)) - 0.016), 0.4);
  var k = 0;
  while k < 7 {
    let fk = f32.from(k);
    lpLily(&mut p, x, y, 0.3 + 0.4 * fk + 0.05 * libc.sinf(fk * 3.), 0.12, 0.7 + 0.35 * lpFrac(fk * 0.618), 0.18 * (1. - 2. * lpFrac(fk * 0.37)), 1.0);
    k = k + 1;
  }
  // the red frame
  p.lay(cRedDeep(), lpCov(lpAbs(y - 0.01) - 0.014), 0.3);
  p.lay(cRedDeep(), lpCov(lpAbs(y - 1.49) - 0.014), 0.3);
  p.lay(cRedDeep(), lpCov(lpAbs(x - 0.01) - 0.014), 0.3);
  p.lay(cRedDeep(), lpCov(lpAbs(x - 2.99) - 0.014), 0.3);
  lpFinish(&p, u, v, 16u32)
}

// ---- The plain surfaces: plaster and masonry, white-ish, tinted by their material ----

// Lime plaster: a faint mottle, a few thousandths of undulation, hair cracks
pub fn plasterTexel(u f32, v f32) surfacepatterns.PatternTexel {
  let a = surfacepatterns.fbmNoise(u, v, 6, 6, 21u32, 4, 0.55);
  let b = surfacepatterns.fbmNoise(u, v, 20, 20, 22u32, 3, 0.5);
  let k = 0.9 + 0.09 * a + 0.04 * b;
  new surfacepatterns.PatternTexel(lpCl(0.5 + 0.35 * a + 0.1 * b), new Color(k, k, k, 1.), 0.86, 1.)
}

// Ashlar: blocks 0.9 m by 0.45 m in courses, the joints dark and recessed, each block its own tone
pub fn ashlarTexel(u f32, v f32) surfacepatterns.PatternTexel {
  let x = u * 1.8;
  let y = v * 1.8;
  let row = libc.floorf(y / 0.45);
  let off = if (row - 2. * libc.floorf(row / 2.)) > 0.5 { 0.45f } else { 0. };
  let col = libc.floorf((x + off) / 0.9);
  let fx = lpFrac((x + off) / 0.9) * 0.9;
  let fy = lpFrac(y / 0.45) * 0.45;
  let edge = lpMin(lpMin(fx, 0.9 - fx), lpMin(fy, 0.45 - fy));
  let id = surfacepatterns.unitHash(i32.from(col) + 17, i32.from(row) + 5, 31u32);
  let n = surfacepatterns.fbmNoise(u, v, 12, 12, 32u32, 4, 0.55);
  let tone = 0.82 + 0.16 * id + 0.08 * n;
  let joint = lpStep(0.006, 0.018, edge);
  let k = tone * (0.5 + 0.5 * joint);
  new surfacepatterns.PatternTexel(lpCl(0.35 + 0.65 * joint * (0.7 + 0.3 * id) + 0.1 * n), new Color(k, k * 0.98, k * 0.94, 1.), 0.84, 0.55 + 0.45 * joint)
}

// Worn gypsum and limestone: blocks and steps with an uneven, pitted surface (the first likeness check of the staircase found the
// clean treads "faceted" where the photograph's weathered stone sweeps): a coarse relief, pits, a few cracks, a mottled warm colour
pub fn gypsumTexel(u f32, v f32) surfacepatterns.PatternTexel {
  let coarse = surfacepatterns.fbmNoise(u, v, 5, 5, 41u32, 4, 0.6);
  let mid = surfacepatterns.fbmNoise(u, v, 14, 14, 42u32, 3, 0.55);
  let fine = surfacepatterns.fbmNoise(u, v, 40, 40, 43u32, 3, 0.5);
  let crack = surfacepatterns.ridgedNoise(u, v, 4, 4, 44u32, 3, 0.5);
  let pit = lpStep(0.35, 0.7, 0.5 + 0.9 * fine);
  let k = 0.86 + 0.12 * coarse + 0.07 * mid;
  let dark = 1. - 0.25 * lpStep(0.82, 0.95, crack);
  let kk = k * dark * (0.92 + 0.08 * pit);
  new surfacepatterns.PatternTexel(lpCl(0.5 + 0.25 * coarse + 0.3 * mid + 0.2 * fine - 0.2 * lpStep(0.82, 0.95, crack)),
    new Color(kk, kk * 0.97, kk * 0.9, 1.), 0.9, 0.7 + 0.3 * pit)
}
