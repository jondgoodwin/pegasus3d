// The balloon burner's flame, ported from vfx's burner example
// (packages/vfx/examples/burner.cone): the core, the tongue, the embers and
// the pilot light, each an emitter firing up the nozzle's +y, in metres.
// The flame is live: drawn at the scene's time, fired in bursts by the
// world (the Fire request) as the example fires it, or held on while the
// balloon climbs. The pilot light is a part of its own, which never stops,
// so a burst can end without putting it out.

fn flameTongue() Emitter {
  mut e = Emitter.make();
  e.layer = 1u32;
  e.rate = 700.;
  e.lifetime = 0.5;
  e.lifetimeJitter = 0.35;
  e.shape = SHAPE_DISC;
  e.radius = 0.09;
  e.spread = radians(9.);
  e.speed = 6.5;
  e.speedJitter = 0.3;
  e.drag = 2.5;
  e.gravity = v(0., -9.81, 0.);
  e.buoyancy = 28.;
  e.cooling = 3.;
  e.wobble = 0.28;
  e.wobbleRate = 11.;
  e.sizeStart = 0.2;
  e.sizeEnd = 0.6;
  e.sizeJitter = 0.35;
  e.stretch = 0.035;
  e.fadeIn = 0.06;
  e.fadeOut = 0.45;
  e.colors = [new Color(1., 0.62, 0.26, 0.18), new Color(1., 0.42, 0.1, 0.22), new Color(1., 0.2, 0.04, 0.14),
    new Color(0.6, 0.08, 0.02, 0.)];
  e.colorAt = [0., 0.25, 0.6, 1.];
  e;
}

fn flameCore() Emitter {
  mut e = Emitter.make();
  e.layer = 2u32;
  e.rate = 500.;
  e.lifetime = 0.13;
  e.lifetimeJitter = 0.3;
  e.shape = SHAPE_DISC;
  e.radius = 0.06;
  e.spread = radians(4.);
  e.speed = 6.;
  e.speedJitter = 0.15;
  e.sizeStart = 0.12;
  e.sizeEnd = 0.2;
  e.stretch = 0.02;
  e.fadeIn = 0.1;
  e.fadeOut = 0.3;
  e.colors = [new Color(0.3, 0.5, 1., 0.3), new Color(0.6, 0.75, 1., 0.3), new Color(1., 0.8, 0.5, 0.2),
    new Color(1., 0.6, 0.2, 0.)];
  e.colorAt = [0., 0.3, 0.7, 1.];
  e;
}

fn flameEmbers() Emitter {
  mut e = Emitter.make();
  e.layer = 3u32;
  e.rate = 14.;
  e.lifetime = 1.4;
  e.lifetimeJitter = 0.4;
  e.shape = SHAPE_DISC;
  e.radius = 0.08;
  e.spread = radians(22.);
  e.speed = 7.;
  e.speedJitter = 0.3;
  e.drag = 0.9;
  e.gravity = v(0., -9.81, 0.);
  e.buoyancy = 9.;
  e.cooling = 1.2;
  e.wobble = 0.35;
  e.wobbleRate = 6.;
  e.sizeStart = 0.045;
  e.sizeEnd = 0.025;
  e.fadeOut = 0.5;
  e.trailTime = 0.12;
  e.colors = [new Color(1., 0.75, 0.35, 4.), new Color(1., 0.45, 0.1, 3.), new Color(1., 0.2, 0.03, 1.5),
    new Color(0.5, 0.05, 0.01, 0.)];
  e.colorAt = [0., 0.3, 0.7, 1.];
  e;
}

fn flamePilot() Emitter {
  mut e = Emitter.make();
  e.layer = 4u32;
  e.rate = 160.;
  e.lifetime = 0.22;
  e.lifetimeJitter = 0.3;
  e.shape = SHAPE_DISC;
  e.radius = 0.02;
  e.spread = radians(8.);
  e.speed = 0.7;
  e.buoyancy = 3.;
  e.cooling = 2.;
  e.wobble = 0.05;
  e.wobbleRate = 14.;
  e.sizeStart = 0.07;
  e.sizeEnd = 0.04;
  e.fadeIn = 0.15;
  e.colors = [new Color(0.3, 0.5, 1., 0.6), new Color(0.35, 0.55, 1., 0.5), new Color(0.6, 0.6, 1., 0.25),
    new Color(1., 0.6, 0.3, 0.)];
  e.colorAt = [0., 0.4, 0.8, 1.];
  e;
}

// The example's intensities are for an HDR frame that is tone-mapped after;
// the browser draws straight into the display's 8-bit frame, where hundreds
// of overlapping additive sprites clip to white. So the dense layers (the
// core, the tongue, the pilot) are drawn at this fraction of the example's
// intensity, which keeps the flame's colour; the sparse embers are not.
const FLAME_DIMMED f32 = 0.3;

fn dimmed(e Emitter) Emitter {
  mut out = e;
  mut k = 0usize;
  while k < 4usize {
    out.colors[k].alpha = out.colors[k].alpha * FLAME_DIMMED;
    k = k + 1usize;
  }
  out;
}

// The flame's layers: the core and the tongue as sprites, the embers as
// trails
fn burnerFlame() List[EffectLayer] {
  mut layers = List[EffectLayer].empty();
  layers.push(new EffectLayer(dimmed(flameCore()), EFFECT_SPRITES));
  layers.push(new EffectLayer(dimmed(flameTongue()), EFFECT_SPRITES));
  layers.push(new EffectLayer(flameEmbers(), EFFECT_TRAILS));
  layers;
}

// The pilot light's one layer, sprites
fn pilotLight() List[EffectLayer] {
  mut layers = List[EffectLayer].empty();
  layers.push(new EffectLayer(dimmed(flamePilot()), EFFECT_SPRITES));
  layers;
}
