// The bowling pins: the playground near the balloon's ten pins, which are the amphora at PIN_SCALE. One object of the world: one
// lathed mesh and one material (the amphora's, painted) shared by ten parts, one for each pin, stood in a triangle (four rows,
// the apex towards the lane's head). Where they stand, and the lane they are bowled down, are here because the world places them
// and the physics world (props.cone) makes their bodies at the same places.

// The pins are the amphora at this scale (0.89 m tall, 0.4 m across the belly)
pub const PIN_SCALE: f32 = 0.6;
pub const PIN_COUNT = 10usize;

// Where the apex pin stands (x, z): the playground's rack, in the balloon's backyard, 26 m west of the balloon's spot on a strip of
// lawn flat to 20 cm and 5 m from the nearest tree or rock (found by a scan of the backyard; playchecks.cone's checkSite pins it).
// The lane runs west, away from the balloon, so a ball that overruns the pins rolls on away from its basket
pub const RACK_X: f32 = -36.;
pub const RACK_Z: f32 = 298.;
// The distance between rows, and between pins in a row (metres)
pub const RACK_ROW: f32 = 0.72;
// How far the lane's head is before the apex, where the ball waits, and the lane's yaw: it runs from the head to the apex in the
// direction a walker of this yaw faces ((-sin yaw, -cos yaw): yaw 0 is -z)
pub const LANE_LENGTH: f32 = 11.;
pub const LANE_YAW: f32 = 1.5707964;    // a quarter turn: the lane runs west, -x

// The direction the lane runs, head to apex
pub fn laneDir() Vec3 { Vec3(0. - libc.sinf(LANE_YAW), 0., 0. - libc.cosf(LANE_YAW)) }

// The place of pin 'k''s foot, in x and z: the apex first, then rows of two, three and four (row r has r+1 pins), each row farther
// along the lane than the one before
pub fn pinSpot(k: usize) Vec2 {
  var row = 0usize;
  var first = 0usize;
  while first + row + 1usize <= k { first = first + row + 1usize; row = row + 1usize; }
  let place = k - first;
  let along = f32.from(row) * RACK_ROW;
  let across = (f32.from(place) - f32.from(row) * 0.5) * RACK_ROW;
  let d = laneDir();
  // The lane's right is d turned a quarter turn about up
  let right = Vec3(0. - d.z, 0., d.x);
  Vec2(RACK_X + d.x * along + right.x * across, RACK_Z + d.z * along + right.z * across)
}

// The ball's home, at the lane's head
pub fn ballHomeSpot() Vec2 {
  let d = laneDir();
  Vec2(RACK_X - d.x * LANE_LENGTH, RACK_Z - d.z * LANE_LENGTH)
}

// The pins into 'h': the amphora's mesh and material once (its first part is pin 0), then the other nine parts sharing them. Part k
// is the pin at pinSpot(k), standing on the ground
fn hydratePins(isl: &Island, h: &mut Hydrated) {
  let s0 = pinSpot(0usize);
  hydrateAmphora(h, Transform3(v(s0.x, groundHeight(isl, s0.x, s0.y), s0.y), Quat.identity(), v(PIN_SCALE, PIN_SCALE, PIN_SCALE)));
  var k = 1usize;
  while k < PIN_COUNT {
    let s = pinSpot(k);
    let at = Transform3(v(s.x, groundHeight(isl, s.x, s.y), s.y), Quat.identity(), v(PIN_SCALE, PIN_SCALE, PIN_SCALE));
    h.part("bowling pin", 0usize, 0usize, TOP, at);
    k = k + 1usize;
  }
}
