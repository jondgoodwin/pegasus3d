// The rooks and the horn, each ported from one of sculpt's example programs
// (packages/sculpt/examples/), in its own units; the world scales and
// places them. Each answers its finest mesh as triangles with smooth or flat
// normals.

// ---- The rook (rook.cone): a profile lathed, hollowed and crenellated by
// three booleans ----

// A box from lo to hi: the cube cage, scaled and moved
fn rookBox(lo: Vec3, hi: Vec3) mesh.PolyMesh {
  var parts = List[mesh.PolyMesh].empty();
  parts.push(mesh.PolyMesh.cube(0.5));
  var places = List[Transform3].empty();
  places.push(Transform3((lo + hi) * 0.5, Quat.identity(), hi - lo));
  var problems = List[String].empty();
  joinPlaced(&parts, &places, &mut problems)
}

// The lathes' steps round a whole turn: 3.75 degrees each (the example's
// 32, 11.25 degrees, showed facets)
pub const ROOK_STEPS = 96u32;

fn rookMesh(steps: u32) mesh.Mesh {
  let pts: Array[Vec2, 9] = [p2(0., 0.), p2(0.9, 0.), p2(0.9, 0.15), p2(0.75, 0.25), p2(0.6, 0.35), p2(0.55, 1.2),
    p2(0.7, 1.35), p2(0.7, 1.7), p2(0., 1.7)];
  let profile = Profile.fromPoints(&pts, false);
  let body = lathe(&profile, up(), 2. * pi, steps);
  var problems = List[String].empty();
  // The hollow: a cylinder of radius 0.5 from 1.45 up through the top
  let rect: Array[Vec2, 4] = [p2(0., 1.45), p2(0.5, 1.45), p2(0.5, 2.), p2(0., 2.)];
  let hollowProfile = Profile.fromPoints(&rect, false);
  let hollow = lathe(&hollowProfile, up(), 2. * pi, steps);
  let cup = booleanDifference(&body, &hollow, &mut problems);
  // The crenellations: two bars 0.24 wide, cutting 0.2 down from the top
  let bar1 = rookBox(v(-1., 1.5, -0.12), v(1., 2., 0.12));
  let bar2 = rookBox(v(-0.12, 1.5, -1.), v(0.12, 2., 1.));
  let once = booleanDifference(&cup, &bar1, &mut problems);
  let rook = booleanDifference(&once, &bar2, &mut problems);
  rook.triangulate(false)
}

// ---- The second rook, an experiment: the same rook with no booleans ----
//
// The body and its hollow are ONE lathe of an outline that goes up the
// outside, over the rim (at the crenellations' floor) and down the inside
// to the hollow's floor, as the balloon's basket is lathed. Each merlon is
// the battlement's cross-section (a closed rectangle) lathed over a short
// arc, its two open ends capped, then copied round four times and joined to
// the body, standing on its rim. The notches between merlons have radial
// sides (each a plane through the axis), where the boolean rook's, cut by
// bars, are parallel.

// 'm' with each hole closed by a face: a lathe over less than a whole turn
// is left open at both ends
fn capped(m: &mesh.PolyMesh) mesh.PolyMesh {
  var counts = List[u32].empty();
  var indices = List[u32].empty();
  var f = 0usize;
  while f < m.faceCount() {
    let vs = m.faceVertices(u32.from(f));
    counts.push(u32.from(vs.len()));
    var i = 0usize;
    while i < vs.len() { indices.push(*vs[i]); i = i + 1usize; }
    f = f + 1usize;
  }
  var seen = List[bool].withCapacity(m.vertexCount());
  var k = 0usize;
  while k < m.vertexCount() { seen.push(false); k = k + 1usize; }
  var holes = 0u32;
  k = 0usize;
  while k < m.vertexCount() {
    if !*seen[k] && m.isBoundaryVertex(u32.from(k)) {
      let loop = boundaryLoop(m, u32.from(k));
      counts.push(u32.from(loop.len()));
      var i = 0usize;
      while i < loop.len() {
        indices.push(*loop[i]);
        seen.set(usize.from(*loop[i]), true);
        i = i + 1usize;
      }
      holes = holes + 1u32;
    }
    k = k + 1usize;
  }
  var problems = List[String].empty();
  mesh.PolyMesh.fromPolygons(m.positions.view(), counts.view(), indices.view(), &mut problems)
}

// Holes a mesh has: boundary loops, counted (what 'capped' closed)
pub fn holesIn(m: &mesh.PolyMesh) u32 {
  var seen = List[bool].withCapacity(m.vertexCount());
  var k = 0usize;
  while k < m.vertexCount() { seen.push(false); k = k + 1usize; }
  var holes = 0u32;
  k = 0usize;
  while k < m.vertexCount() {
    if !*seen[k] && m.isBoundaryVertex(u32.from(k)) {
      let loop = boundaryLoop(m, u32.from(k));
      var i = 0usize;
      while i < loop.len() { seen.set(usize.from(*loop[i]), true); i = i + 1usize; }
      holes = holes + 1u32;
    }
    k = k + 1usize;
  }
  holes
}

// The rook's mesh; 'stats' gets what the experiment found about the merlon's lathe, for the report
fn lathedRookMesh(steps: u32, stats: &mut BakeStats) mesh.Mesh {
  // Up the outside to the crenellations' floor (1.5), in over the rim to
  // the hollow's wall (0.5), down to its floor (1.45) and in to the axis
  let pts: Array[Vec2, 11] = [p2(0., 0.), p2(0.9, 0.), p2(0.9, 0.15), p2(0.75, 0.25), p2(0.6, 0.35), p2(0.55, 1.2),
    p2(0.7, 1.35), p2(0.7, 1.5), p2(0.5, 1.5), p2(0.5, 1.45), p2(0., 1.45)];
  let outline = Profile.fromPoints(&pts, false);
  let body = lathe(&outline, up(), 2. * pi, steps);
  // A merlon: the battlement's section, 0.2 thick and 0.2 high, lathed over
  // three sixteenths of a turn (67.5 degrees: the notches 22.5, about the
  // bars' 0.24 at the wall's middle), its ends capped
  let sq: Array[Vec2, 4] = [p2(0.5, 1.5), p2(0.7, 1.5), p2(0.7, 1.7), p2(0.5, 1.7)];
  let section = Profile.fromPoints(&sq, true);
  let arcSteps = steps * 3u32 / 16u32;
  let arc = 2. * pi * f32.from(arcSteps) / f32.from(steps);
  let open = lathe(&section, up(), arc, arcSteps);
  stats.merlonHolesBefore = holesIn(&open);
  let merlon = capped(&open);
  stats.merlonHolesAfter = holesIn(&merlon);
  // Centred on 45 degrees, so the notches are on the axes, as the bars cut them
  var one = List[mesh.PolyMesh].empty();
  one.push(merlon);
  var turn = List[Transform3].empty();
  turn.push(Transform3(v(0., 0., 0.), Quat.angleAxis(0.25 * pi - 0.5 * arc, up()), v(1., 1., 1.)));
  var problems = List[String].empty();
  let placed = joinPlaced(&one, &turn, &mut problems);
  let merlons = arrayRadial(&placed, 4u32, up(), 2. * pi, v(0., 0., 0.), -1.);
  var parts = List[mesh.PolyMesh].empty();
  parts.push(body);
  parts.push(merlons);
  let rook = join(&parts, &mut problems);
  rook.triangulate(false)
}

// (Step 2's urn, sculpt's vase example, has given way to the amphora,
// amphora.cone; its flower's petals now crown the horn-flower,
// hornflower.cone.)

// (The boulder, sculpt's pebble example, has given way to the rock family,
// vegetation.cone.)

// (Step 3's chimney, sculpt's chimney example's cage, has given way to a
// brick stack, chimney.cone.)

// ---- The horn (hornfamily.cone, experiment 1's stage 0): an ellipse swept
// along an arc, tapering, its ribs a channel displaced along the normals ----

const HORN_AROUND = 64u32;     // outline points
const HORN_RINGS = 360u32;     // path segments: about 16 rings a rib at 22 ribs

// The stage horn: 3 long, its base's radius 0.12 of that, bent 0.9 radians
const HORN_LENGTH: f32 = 3.;
const HORN_GIRTH: f32 = 0.12;
const HORN_BEND: f32 = 0.9;
const HORN_TAPER: f32 = 1.;
const HORN_BLADE: f32 = 1.25;

fn clampF(x: f32, lo: f32, hi: f32) f32 { if x < lo {lo} elif x > hi {hi} else {x} }

// The path: a circular arc of the bend and the horn's 'length', as one
// cubic Bezier (the arc's usual four-thirds-tangent fit), bending towards
// +x; cut at 'cut' of the curve's parameter (1: the whole horn) by de
// Casteljau's split, in 'rings' segments
fn hornPath(length: f32, cut: f32, rings: u32) Path {
  let side = v(1., 0., 0.);
  let rho = length / HORN_BEND;
  let tip = side * (rho * (1. - cos(HORN_BEND))) + up() * (rho * sin(HORN_BEND));
  let tipDir = side * sin(HORN_BEND) + up() * cos(HORN_BEND);
  let k = 4. / 3. * tan(HORN_BEND / 4.) * rho;
  let c = CubicBezier3(v(0., 0., 0.), up() * k, tip - tipDir * k, tip);
  if cut >= 1. { return Path.fromCubic(c, rings); }
  let a = c.p0.lerp(c.p1, cut);
  let b = c.p1.lerp(c.p2, cut);
  let d = c.p2.lerp(c.p3, cut);
  let ab = a.lerp(b, cut);
  let bd = b.lerp(d, cut);
  Path.fromCubic(CubicBezier3(c.p0, a, ab, ab.lerp(bd, cut)), rings)
}

// The radius 'u' of the way along a horn 'length' long
fn hornRadius(u: f32, length: f32) f32 {
  let r0 = HORN_GIRTH * length;
  r0 * (0.03 + 0.97 * libc.powf(1. - clampF(u, 0., 1.), HORN_TAPER))
}

// The stage horn: 3 m along, whole
fn hornMesh() mesh.Mesh { hornMeshCut(HORN_LENGTH, 1., HORN_RINGS) }

// A horn 'length' along, cut at 'cut' of its way (its rib spacing and its
// taper as the whole horn's, but ending where it is cut), 'rings' rings
fn hornMeshCut(length: f32, cut: f32, rings: u32) mesh.Mesh {
  // The bare horn: the blade swept, each ring scaled by the taper
  var pts = List[Vec2].withCapacity(usize.from(HORN_AROUND));
  let w = libc.sqrtf(HORN_BLADE);
  var j = 0u32;
  while j < HORN_AROUND {
    let a = 2. * pi * f32.from(j) / f32.from(HORN_AROUND);
    pts.push(p2(cos(a) * w, sin(a) / w));
    j = j + 1u32;
  }
  let outline = Profile.fromPoints(pts.view(), true);
  let path = hornPath(length, cut, rings);
  var m = sweepScaled(&outline, &path, 0., true, u => hornRadius(u * cut, length));
  let along = m.findFloatChannel(mesh.VertexDomain, "along");
  // Regular ribs, 22 along the whole horn
  let ribs = RibField.plain(22. * cut, 7u32);
  ribField(&mut m, "ribs", &ribs);
  // Their height, times the local radius, along the normals
  let ribChannel = m.findFloatChannel(mesh.VertexDomain, "ribs");
  let horn = displaceAlongNormal(&m, q => m.float(ribChannel, q) * 0.14 * hornRadius(m.float(along, q) * cut, length));
  horn.triangulate(true)
}
