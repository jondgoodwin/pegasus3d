// Glass objets d'art: pieces of glass the world places like any part, in a glass look (parts.cone's Look.clearGlass). A
// piece is a CLOSED VOLUME (a ball, or a hollow vessel whose outline runs up the outside, over the rim and down the
// inside), because where the card has ray tracing the renderer casts rays through it: a ray enters at the outer face, bends
// by Snell's law, meets the inner face, leaves, and finds whatever is behind (the braziers' flames, the columns, the
// frescoes, the sky), each face reflecting by Fresnel's law and coloured glass absorbing by Beer-Lambert's, in the glass's
// own volume. On a card without ray tracing the same description is drawn as raster glass (the frame so far refracted
// through the piece, the screen reflected in it). Nothing here knows which; the material is one description.
//
// Three pieces are made from two functions (a crystal ball, hollow vessels) and a table of outlines: the world adds more by
// adding an outline or a colour.

// One piece of glassware: what it is called, its shape, its look, and where it stands (the middle of its foot)
pub struct GlassPiece {
  pub name: String;
  pub shape: mesh.Mesh;
  pub look: Look;
  pub at: Vec3;
}

// A solid ball of radius 'r' about its own middle (a crystal ball): a closed sphere
pub fn gwBall(r: f32) mesh.Mesh { mesh.Mesh.sphere(r, 48) }

// A hollow vessel, turned from the outline 'outer' of (radius, height) points, foot to rim, the foot's first point on the axis:
// the glass is 'wall' metres thick, the floor 'floor' thick, and the whole is one closed outline (its two ends on the axis, at radius
// 0 exactly, so the turned surface has no hole), the outside up, the rim across, the inside down, so that a ray crossing it enters
// glass, leaves it, enters it again and leaves. 'seg' steps round.
pub fn gwVessel(outer: &List[Vec2], wall: f32, floor: f32, seg: i32) mesh.Mesh {
  var pts = List[Vec2].empty();
  let n = outer.len();
  var i = 0usize;
  while i < n { pts.push(*outer[i]); i = i + 1usize; }
  // across the rim, then down the inside, wherever the inside stands above the floor
  var k = n - 1usize;
  var lowest = 0.f;
  while k >= 1usize {
    let p = *outer[k];
    if p.y > floor + 0.01 {
      let r = if p.x - wall > 0.004 { p.x - wall } else { 0.004 };
      pts.push(Vec2(r, p.y));
      lowest = r;
    }
    k = k - 1usize;
  }
  pts.push(Vec2(lowest, floor));
  pts.push(Vec2(0., floor));
  var m = mesh.Mesh.empty();
  lgLathe(&mut m, &pts, seg, 0., 0., 0., 1.);
  m
}

// A ruby-red ewer: a teardrop body, a slender neck and a flared lip, 0.82 m tall
pub fn gwEwerOutline() List[Vec2] {
  let raw: Array[f32, 24] = [0., 0., 0.07, 0., 0.10, 0.02, 0.14, 0.10, 0.17, 0.20, 0.175, 0.30, 0.155, 0.40, 0.11, 0.50,
    0.07, 0.58, 0.055, 0.66, 0.06, 0.74, 0.09, 0.82];
  gwPoints(&raw)
}

// A cobalt flask: a stout round body and a short neck, 0.64 m tall
pub fn gwFlaskOutline() List[Vec2] {
  let raw: Array[f32, 24] = [0., 0., 0.08, 0., 0.14, 0.04, 0.19, 0.12, 0.205, 0.21, 0.185, 0.30, 0.13, 0.38, 0.075, 0.44,
    0.06, 0.52, 0.065, 0.60, 0.085, 0.64, 0.085, 0.64];
  gwPoints(&raw)
}

// An outline's pairs of numbers as points; a repeated last pair is dropped
fn gwPoints(raw: &Array[f32, 24]) List[Vec2] {
  var out = List[Vec2].empty();
  var i = 0usize;
  while i + 1usize < 24usize {
    let p = Vec2(raw[i], raw[i + 1usize]);
    if out.len() == 0usize || (*out[out.len() - 1usize]).x != p.x || (*out[out.len() - 1usize]).y != p.y { out.push(p); }
    i = i + 2usize;
  }
  out
}

// The looks: a crystal (clear, a fine dispersing glass), and coloured glass, where the colour is what is left of white light
// after 'distance' metres of the glass (a wall 8 mm thick is a fraction of it, so the colour wants a small distance)
pub fn gwCrystal() Look {
  Look.clearGlass(Color(1., 1., 1., 1.), 1.52, 0., Color(0.97, 0.99, 1., 1.), 1.).dispersing(0.5)
}

// A sapphire-blue globe, for a ball of glass on a garden plinth: solid, so its colour goes the ball's width (0.4 m) and not a wall's
pub fn gwSapphire() Look {
  Look.clearGlass(Color(1., 1., 1., 1.), 1.5, 0., Color(0.22, 0.46, 0.95, 1.), 0.18).dispersing(0.2)
}

pub fn gwRuby() Look {
  Look.clearGlass(Color(1., 1., 1., 1.), 1.5, 0.008, Color(0.62, 0.01, 0.03, 1.), 0.012)
}

pub fn gwCobalt() Look {
  Look.clearGlass(Color(1., 1., 1., 1.), 1.5, 0.008, Color(0.02, 0.10, 0.80, 1.), 0.012)
}

// A pedestal for a piece: a low gypsum drum of 'height' metres standing at (x, z) on the floor 'y0', in the labyrinth's gypsum, solid
// to walk round. (The collision is the plan's, so it comes out of labBuild with or without meshes.)
pub fn lgPedestal(g: &mut LabGeo, x: f32, y0: f32, z: f32, height: f32) {
  if g.want {
    var pts = List[Vec2].empty();
    pts.push(pt(0.001, 0.)); pts.push(pt(0.32, 0.)); pts.push(pt(0.32, 0.08)); pts.push(pt(0.22, 0.15)); pts.push(pt(0.19, 0.24));
    pts.push(pt(0.19, height - 0.14)); pts.push(pt(0.26, height - 0.07)); pts.push(pt(0.28, height - 0.03)); pts.push(pt(0.28, height));
    pts.push(pt(0.001, height));
    lgLathe(&mut g.meshes[LM_GYPSUM], &pts, 20, x, y0, z, 1.);
  }
  g.solids.push(Solid.circle(x, z, 0.32, y0 - 0.5, y0 + height));
  g.circles.push(Vec3(x, z, 0.32));
}

// ---- The checks ----

// A position's place on a grid of 0.1 mm (within 3 m of the origin), as one number
fn gwCell(p: Vec3) u64 {
  let x = u64.from(i32.from(libc.floorf(p.x * 10000. + 0.5)) + 32768);
  let y = u64.from(i32.from(libc.floorf(p.y * 10000. + 0.5)) + 32768);
  let z = u64.from(i32.from(libc.floorf(p.z * 10000. + 0.5)) + 32768);
  (x << 32u64) | (y << 16u64) | z
}

// Whether 'm' (within 3 m of the origin) is a closed surface: every edge (by position, so the lathe's duplicated corners meet) is
// shared by exactly two triangles
fn gwClosed(m: &mesh.Mesh, bad: &mut usize) bool {
  var lo = List[u64].empty();
  var hi = List[u64].empty();
  var t = 0usize;
  while t + 2usize < m.indices.len() {
    let p0 = gwCell(*m.positions[usize.from(*m.indices[t])]);
    let p1 = gwCell(*m.positions[usize.from(*m.indices[t + 1usize])]);
    let p2 = gwCell(*m.positions[usize.from(*m.indices[t + 2usize])]);
    // (a triangle with two corners in one place, which the turned surface has at a pole, has no area and no edges)
    if p0 != p1 && p1 != p2 && p0 != p2 {
      var c = 0usize;
      while c < 3usize {
        let a = if c == 0usize { p0 } elif c == 1usize { p1 } else { p2 };
        let b = if c == 0usize { p1 } elif c == 1usize { p2 } else { p0 };
        lo.push(if a < b { a } else { b });
        hi.push(if a < b { b } else { a });
        c = c + 1usize;
      }
    }
    t = t + 3usize;
  }
  var open = 0usize;
  var i = 0usize;
  while i < lo.len() {
    var n = 0usize;
    var j = 0usize;
    while j < lo.len() { if *lo[j] == *lo[i] && *hi[j] == *hi[i] { n = n + 1usize; } j = j + 1usize; }
    if n != 2usize { open = open + 1usize; }
    i = i + 1usize;
  }
  *bad = open;
  open == 0usize
}

// The glass objets d'art: each a closed volume (a ray must be able to leave what it entered), in a glass look, and the cottage's
// panes slabs of one
pub fn checkGlass() bool {
  print <- "The glass:\n";
  var ok = true;
  var bad = 0usize;
  let ball = gwBall(0.2);
  if !gwClosed(&ball, &mut bad) { print <- "  NO: the crystal ball is not a closed surface ("; print <- bad; print <- " open edges)\n"; ok = false; }
  let ewer = gwVessel(&gwEwerOutline(), 0.008, 0.02, 40);
  if !gwClosed(&ewer, &mut bad) { print <- "  NO: the ewer is not a closed surface ("; print <- bad; print <- " open edges)\n"; ok = false; }
  let flask = gwVessel(&gwFlaskOutline(), 0.008, 0.02, 40);
  if !gwClosed(&flask, &mut bad) { print <- "  NO: the flask is not a closed surface ("; print <- bad; print <- " open edges)\n"; ok = false; }
  var slab = mesh.Mesh.empty();
  ctBox(&mut slab, 0., 0.5, 0., 1., 0., CT_PANE_T);
  if !gwClosed(&slab, &mut bad) { print <- "  NO: a pane's slab is not a closed surface ("; print <- bad; print <- " open edges)\n"; ok = false; }
  print <- "  ("; print <- ball.triangleCount(); print <- " triangles in the ball, "; print <- ewer.triangleCount(); print <- " in the ewer, ";
  print <- flask.triangleCount(); print <- " in the flask, "; print <- slab.triangleCount(); print <- " in a pane)\n";
  if ewer.triangleCount() == 0usize || flask.triangleCount() == 0usize { print <- "  NO: a vessel has no triangles\n"; ok = false; }
  // The looks are glass: see-through, physical, the ruby's red the most let through, the cobalt's blue
  let ruby = gwRuby();
  let cobalt = gwCobalt();
  let blend = Look.plain(Color(1., 1., 1., 1.)).translucent(0.5).alphaMode;
  if ruby.glass <= 0. || ruby.alphaMode != blend || !ruby.physical { print <- "  NO: the ruby is not drawn as glass\n"; ok = false; }
  if !(ruby.absorb.red > ruby.absorb.green && ruby.absorb.red > ruby.absorb.blue) { print <- "  NO: the ruby does not pass red most\n"; ok = false; }
  if !(cobalt.absorb.blue > cobalt.absorb.red && cobalt.absorb.blue > cobalt.absorb.green) { print <- "  NO: the cobalt does not pass blue most\n"; ok = false; }
  // The labyrinth's pieces: three, standing on pedestals that are solid
  var plan = LabGeo.make(true);
  labBuild(&mut plan);
  let pieces = plan.glass.len();
  if pieces != 3usize { print <- "  NO: the labyrinth has "; print <- pieces; print <- " glass pieces, not three\n"; ok = false; }
  if ok { print <- "  every piece of glass is a closed volume in a glass look: yes\n"; }
  ok
}

// A piece of glass placed in the plan (only when the meshes are wanted)
pub fn lgGlass(g: &mut LabGeo, name: &str, shape: mesh.Mesh, look: Look, at: Vec3) {
  if g.want { g.glass.push(GlassPiece(String.from(name), shape, look, at)); }
}
