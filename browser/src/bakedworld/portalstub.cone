// The labyrinth's placeholders, until the rooms lane's real ones are merged (WI\labyrinth.md): a plain room at E, the corridor that
// leads to it from the looking-glass's mouth, and a corridor that will not end. All of it plain boxes in the world's frame, in this
// file alone, so that the merge is a matter of deleting it and its few lines elsewhere (OBJECTS, NAMES and 'hydrate' in
// bakedworld.cone; 'addSolids' where the solids are set, simactor.cone and viewactor.cone).
//
//   the entrance     the mouth (z = MOUTH_Z) is the opening of a short dead end behind it, and a corridor 1 m wide runs on to E. The
//                    pane at the mouth (a view surface, the way back to the island) fills the opening from 0.55 to 2.25 m; the
//                    sill under it and the lintel over it are not solid (a being goes through the pane and the move takes it away)
//   the room         12 m by 12 m, 3.5 m high, E on its south wall, two red columns, two lamps
//   the loop         a corridor 1.8 m wide, from LOOP_Z0 to LOOP_Z1, in bays LOOP_BAY long: a lamp and a pair of posts in each bay,
//                    all alike, so a being moved back whole bays sees nothing change. It is lit by lamps of short reach, so that
//                    its far end is dark (and cannot be seen to jump). At its end an exit, a glowing panel. It is detached from
//                    the room at x = LOOP_X
//
// Every box has a visible mesh; those with 'solid' also stop a body, and the tops of those a body can stand on are walkable
// (physics.cone's addSolids).

// The stub's parts: its four meshes (walls, floors, red, the exit), the pane at the mouth, the loop's gate, and nine lamps (four at the entrance and in
// the room, five in the loop corridor)
pub const PORTAL_STUB_PARTS = 15usize;
pub const PORTAL_STUB_LAMPS = 9usize;

// One box of the stub
struct StubBox {
  x0 f32;
  z0 f32;
  x1 f32;
  z1 f32;
  y0 f32;
  y1 f32;
  solid bool;
  look u32;                      // STUB_WALL, STUB_FLOOR, STUB_RED, STUB_GLOW
}

const STUB_WALL = 0u32;
const STUB_FLOOR = 1u32;
const STUB_RED = 2u32;
const STUB_GLOW = 3u32;

fn sb(x0 f32, z0 f32, x1 f32, z1 f32, y0 f32, y1 f32, solid bool, look u32) StubBox {
  new StubBox(x0, z0, x1, z1, y0, y1, solid, look);
}

// The stub's boxes
fn stubBoxes() List[StubBox] {
  mut b = List[StubBox].empty();
  imm f = LAB_FLOOR;
  imm ceil = LAB_FLOOR + CORR_HEIGHT;
  imm roomTop = LAB_FLOOR + 3.5;
  imm ch = CORR_HALF;
  // The entrance: floor, ceiling, walls, from the dead end's wall to the room
  b.push(sb(0. - 1.5, 285., 1.5, 300., f - 1., f, true, STUB_FLOOR));
  b.push(sb(0. - 1.5, 285., 1.5, 300., ceil, ceil + 0.5, true, STUB_WALL));
  b.push(sb(0. - 1.5, 285., 0. - ch, 299., f, ceil, true, STUB_WALL));
  b.push(sb(ch, 285., 1.5, 299., f, ceil, true, STUB_WALL));
  b.push(sb(0. - 1.5, 285., 1.5, TAIL_Z, f, ceil, true, STUB_WALL));
  // The mouth's frame: a sill under the pane and a lintel over it, not solid
  b.push(sb(0. - ch, MOUTH_Z, ch, MOUTH_Z + 0.15, f, f + PANE_LOW, false, STUB_RED));
  b.push(sb(0. - ch, MOUTH_Z, ch, MOUTH_Z + 0.15, f + PANE_HIGH, ceil, false, STUB_RED));
  // The room
  b.push(sb(0. - 7., 299., 7., 313., f - 1., f, true, STUB_FLOOR));
  b.push(sb(0. - 7., 299., 7., 313., roomTop, roomTop + 0.5, true, STUB_WALL));
  b.push(sb(0. - 7., 299., 0. - ch, 300., f, roomTop, true, STUB_WALL));
  b.push(sb(ch, 299., 7., 300., f, roomTop, true, STUB_WALL));
  b.push(sb(0. - 7., 299., 0. - 6., 313., f, roomTop, true, STUB_WALL));
  b.push(sb(6., 299., 7., 313., f, roomTop, true, STUB_WALL));
  b.push(sb(0. - 7., 312., 7., 313., f, roomTop, true, STUB_WALL));
  // Two red columns, wider at the top
  b.push(sb(0. - 3.2, 304.8, 0. - 2.8, 305.2, f, f + 3.5, true, STUB_RED));
  b.push(sb(2.8, 304.8, 3.2, 305.2, f, f + 3.5, true, STUB_RED));
  // The corridor that will not end
  imm lx = LOOP_X;
  imm lh = LOOP_HALF;
  b.push(sb(lx - lh - 1., LOOP_Z0 - 1., lx + lh + 1., LOOP_Z1 + 1., f - 1., f, true, STUB_FLOOR));
  b.push(sb(lx - lh - 1., LOOP_Z0 - 1., lx + lh + 1., LOOP_Z1 + 1., ceil, ceil + 0.5, true, STUB_WALL));
  b.push(sb(lx - lh - 1., LOOP_Z0 - 1., lx - lh, LOOP_Z1 + 1., f, ceil, true, STUB_WALL));
  b.push(sb(lx + lh, LOOP_Z0 - 1., lx + lh + 1., LOOP_Z1 + 1., f, ceil, true, STUB_WALL));
  b.push(sb(lx - lh, LOOP_Z0 - 1., lx + lh, LOOP_Z0, f, ceil, true, STUB_WALL));
  b.push(sb(lx - lh, LOOP_Z1, lx + lh, LOOP_Z1 + 1., f, ceil, true, STUB_WALL));
  // An exit at its end: a glowing panel on the end wall
  b.push(sb(lx - 0.6, LOOP_Z1 - 0.05, lx + 0.6, LOOP_Z1, f + 0.2, f + 2.2, false, STUB_GLOW));
  // The bays: a pair of posts at the start of each
  mut z = LOOP_Z0;
  while z < LOOP_Z1 {
    b.push(sb(lx - lh, z - 0.12, lx - lh + 0.25, z + 0.12, f, ceil, false, STUB_RED));
    b.push(sb(lx + lh - 0.25, z - 0.12, lx + lh, z + 0.12, f, ceil, false, STUB_RED));
    z = z + LOOP_BAY;
  }
  b;
}

// The stub's solids, for physics.cone's addSolids
pub fn stubSolids() List[Solid] {
  mut out = List[Solid].empty();
  imm boxes = stubBoxes();
  mut i = 0usize;
  while i < boxes.len() {
    imm k = boxes[i];
    if k.solid { out.push(Solid.box(k.x0, k.z0, k.x1, k.z1, k.y0, k.y1)); }
    i = i + 1usize;
  }
  out;
}

// A lamp of the stub at (x, y, z)
fn stubLamp(h &mut Hydrated, name &str, x f32, y f32, z f32, candela f32, range f32) {
  mut l = LightLook.point(new Vec3(0., 0., 0.), new Color(1., 0.78, 0.5, 1.), candela, range);
  l.radius = 0.05;
  h.lamp(name, TOP, new Transform3(v(x, y, z), Quat.identity(), v(1., 1., 1.)), l);
}

// The stub's parts into 'h': one mesh and part a look, the pane at the mouth, and the lamps
pub fn hydratePortalStub(isl &Island, h &mut Hydrated) {
  imm boxes = stubBoxes();
  imm looks Array[Look, 4] = [Look.plain(srgb(168., 138., 100.)), Look.plain(srgb(96., 82., 70.)), Look.plain(srgb(150., 44., 30.)),
    Look.plain(srgb(30., 30., 30.)).glowing(new Color(1., 0.85, 0.55, 1.), 120.)];
  imm names Array[&str, 4] = ["labyrinth stub walls", "labyrinth stub floors", "labyrinth stub red", "labyrinth stub exit"];
  mut k = 0usize;
  while k < 4usize {
    mut m = mesh.Mesh.empty();
    mut any = false;
    mut i = 0usize;
    while i < boxes.len() {
      imm bx = boxes[i];
      if usize.from(bx.look) == k {
        ctBox(&mut m, bx.x0, bx.x1, bx.y0, bx.y1, bx.z0, bx.z1);
        any = true;
      }
      i = i + 1usize;
    }
    if any {
      imm mat = h.addMaterial(looks[k], Image.empty(), Maps.none(), 0u32);
      imm part = h.part(names[k], h.addMesh(m), mat, TOP, Transform3.identity());
      h.noShadow(part);
    }
    k = k + 1usize;
  }
  // The pane at the mouth: the way back to the island, a portal onto the cottage's back wall (viewsurface.cone)
  imm ground = groundHeight(isl, COTTAGE_X, COTTAGE_Z);
  imm t = glassToMouth(ground);
  imm pane = h.addMesh(mesh.Mesh.plane(1, 1.));
  imm look = h.addMaterial(Look.shaded(SHADER_MIRROR, [0.92, 0.94, 0.95, f32.from(SURFACE_PORTAL), 0. - t.x, 0. - t.y, 0. - t.z,
    f32.from(DEST_DAY)]), Image.empty(), Maps.none(), 0u32);
  imm at = new Transform3(v(E_X, LAB_FLOOR + (PANE_LOW + PANE_HIGH) * 0.5, MOUTH_Z), Quat.angleAxis(pi * 0.5, v(1., 0., 0.)),
    v(PANE_HALF, 1., (PANE_HIGH - PANE_LOW) * 0.5));
  imm glass = h.part("looking-glass back", pane, look, TOP, at);
  h.noShadow(glass);
  // The corridor that will not end: an invisible portal across it at its gate, showing the corridor as it is LOOP_BACK before it. A
  // being that goes through facing forward is moved there (portal.cone), so the picture is what it will see; the pane is a little
  // over the corridor's size, its edges in the walls
  imm loopLook = h.addMaterial(Look.shaded(SHADER_MIRROR, [1., 1., 1., f32.from(SURFACE_PORTAL), 0., 0., 0. - LOOP_BACK, f32.from(DEST_UNDER)]),
    Image.empty(), Maps.none(), 0u32);
  imm loopAt = new Transform3(v(LOOP_X, LAB_FLOOR + CORR_HEIGHT * 0.5, LOOP_GATE_Z), Quat.angleAxis(0. - pi * 0.5, v(1., 0., 0.)),
    v(LOOP_HALF + 0.05, 1., CORR_HEIGHT * 0.5 + 0.05));
  imm gate = h.part("looping gate", pane, loopLook, TOP, loopAt);
  h.noShadow(gate);
  // The lamps: the entrance's, the room's, the loop corridor's (one a bay, at its middle, short of reach)
  stubLamp(h, "stub lamp tail", 0., LAB_FLOOR + 2.0, 288., 60., 5.);
  stubLamp(h, "stub lamp corridor", 0., LAB_FLOOR + 2.0, 295., 80., 6.);
  stubLamp(h, "stub lamp room 1", 0. - 4., LAB_FLOOR + 3.0, 306., 120., 9.);
  stubLamp(h, "stub lamp room 2", 4., LAB_FLOOR + 3.0, 306., 120., 9.);
  mut z = LOOP_Z0 + LOOP_BAY * 0.5;
  while z < LOOP_Z1 {
    stubLamp(h, "stub lamp loop", LOOP_X, LAB_FLOOR + 2.0, z, 70., 5.);
    z = z + LOOP_BAY;
  }
}
