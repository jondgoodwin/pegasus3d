// The hot-air balloon, ported from sculpt's balloon example
// (packages/sculpt/examples/balloon.cone): the photograph's chevron balloon,
// standing on the ground with its basket down, its burner alight (the flame
// is flame.cone's).
//
// ONE BALLOON, part by part (y is up, the mouth at y = 0, the equator's
// radius about 1; the world scales it 9 m a unit):
// - the envelope: one cubic Bezier from the mouth to the crown, lathed into
//   GORES x 4 columns; each gore bulges between its load tapes (a channel
//   from the lathe's "along" channel, displaced along the normals); the
//   tapes are creased, so subdivision keeps a valley at each; subdivided
//   twice. Its paint is an image made here, read through the lathe's uv;
// - the skirt below the mouth: a short open profile lathed and solidified;
// - the burner frame: a square ring, four uprights, the burner can;
// - the suspension cables, from each load tape's foot to the frame's
//   nearest corner;
// - the basket: an open profile lathed in 4 steps (square, hollow, rimmed),
//   its wicker an image made here;
// - two passengers' heads.

const BALLOON_SEED = 1783u32;       // the Montgolfiers' year
const BULGE f32 = 0.045;            // a gore's bulge, per unit of radius
const TAPE f32 = 2.;                // the load tapes' crease (sharp for two levels)
const BALLOON_LEVELS = 2u32;
const PAINT_TEXELS = 32;            // the paint's texels across a gore
// Paint, sRGB: navy, blue, teal, yellow, red, purple, white, orange, green
imm PAINT Array[f32, 27] = [0.13, 0.15, 0.40, 0.16, 0.34, 0.78, 0.02, 0.60, 0.58, 0.98, 0.86, 0.06,
  0.90, 0.10, 0.08, 0.50, 0.24, 0.74, 0.95, 0.95, 0.92, 0.98, 0.50, 0.06, 0.20, 0.62, 0.20];

fn tri(x f32) f32 { libc.fabsf(2. * fract(x) - 1.); }

// What differs between balloons (the example's Look)
struct BalloonLook {
  pub gores u32;            // a multiple of 4: the cables gather at the frame's four corners
  pub pattern u32;          // 0 chevrons, 1 stepped diagonals, 2 gore stripes with a band
  pub paint Array[u32, 6];  // indices into PAINT
  pub fat f32;              // the envelope's width, 1 as photographed
  pub skirt u32;            // the skirt's paint
}

// The photograph's chevron balloon
fn chevrons() BalloonLook { new BalloonLook(24u32, 0u32, [3u32, 2u32, 1u32, 0u32, 2u32, 3u32], 1.04, 4u32); }

// ---- The envelope ----

// A gore's panel colour at (u, v) of the lathe's uv: u around, v up from the mouth
fn paintAt(look &BalloonLook, u f32, vv f32) u32 {
  imm gores = f32.from(look.gores);
  imm g = u32.from(libc.floorf(u * gores));
  if look.pattern == 0u32 {
    // Chevrons: plain gores at the foot and the crown, between them bands
    // dipping to a V across every four gores
    if vv < 0.3 { return look.paint[usize.from(g % 3u32)]; }
    if vv > 0.84 { return look.paint[usize.from((g + 1u32) % 3u32)]; }
    imm b = u32.from(libc.floorf((vv - 0.3) * 8. + 1.4 * tri(u * gores / 4. + 0.5)));
    imm cycle Array[usize, 4] = [3usize, 4usize, 3usize, 5usize];
    return look.paint[cycle[usize.from(b % 4u32)]];
  }
  if look.pattern == 1u32 {
    imm r = u32.from(libc.floorf(vv * 13.));
    return look.paint[usize.from((r + g) % 5u32)];
  }
  if vv > 0.55 and vv < 0.64 { return look.paint[5usize]; }
  look.paint[usize.from(g % 3u32)];
}

// The envelope's paint as an image: 'texels' a gore across and 32 times
// that up, each texel the mean of 2 x 2 samples, the load tapes a darker
// strip a sixteenth of a gore wide
fn envelopeImage(look &BalloonLook, texels i32) Image {
  imm w = i32.from(look.gores) * texels;
  imm h = 32 * texels;
  mut img = new Image(w, h, 3, List[u8].withCapacity(usize.from(w * h * 3)));
  mut y = 0;
  while y < h {
    mut x = 0;
    while x < w {
      imm shade = if x % texels < (texels + 15) / 16 { 0.75; } else { 1.; };
      mut sum Array[f32, 3] = [0., 0., 0.];
      mut s = 0;
      while s < 4 {
        imm u = (f32.from(x) + 0.25 + 0.5 * f32.from(s % 2)) / f32.from(w);
        imm c = usize.from(paintAt(look, u, (f32.from(y) + 0.25 + 0.5 * f32.from(s / 2)) / f32.from(h))) * 3usize;
        sum[0usize] = sum[0usize] + PAINT[c];
        sum[1usize] = sum[1usize] + PAINT[c + 1usize];
        sum[2usize] = sum[2usize] + PAINT[c + 2usize];
        s = s + 1;
      }
      mut k = 0usize;
      while k < 3usize {
        img.pixels.push(u8.from(sum[k] * 0.25 * shade * 255. + 0.5));
        k = k + 1usize;
      }
      x = x + 1;
    }
    y = y + 1;
  }
  img;
}

// The envelope's cage: the profile lathed, each gore puffed out between its
// tapes, the tapes creased
fn envelopeCage(look &BalloonLook) mesh.PolyMesh {
  imm f = look.fat;
  imm curve = new CubicBezier2(p2(0.24, 0.), p2(0.95 * f, 0.62), p2(1.5 * f, 2.3), p2(0., 2.2));
  imm profile = Profile.fromCubic(curve, 24u32);
  mut env = lathe(&profile, up(), 2. * pi, look.gores * 4u32);
  imm gores = f32.from(look.gores);
  imm along = env.findFloatChannel(mesh.VertexDomain, "along");
  imm bulge = env.addFloatChannel(mesh.VertexDomain, "bulge", 0.);
  mut i = 0u32;
  while i < u32.from(env.vertexCount()) {
    imm p = *env.positions[usize.from(i)];
    imm r = (p.x * p.x + p.z * p.z).sqrt();
    env.setFloat(bulge, i, sin(pi * fract(env.float(along, i) * gores)) * r);
    i = i + 1u32;
  }
  // The tapes: edges up a gore's edge, off the axis
  imm crease = env.addFloatChannel(mesh.EdgeDomain, "crease", 0.);
  mut e = 0u32;
  while e < u32.from(env.edgeCount()) {
    imm a = env.fromVertex(2u32 * e);
    imm b = env.toVertex(2u32 * e);
    imm pa = *env.positions[usize.from(a)];
    imm pb = *env.positions[usize.from(b)];
    imm la = env.float(along, a);
    imm onTape = fract(la * gores + 0.001) < 0.002;
    if onTape and la == env.float(along, b) and pa.x * pa.x + pa.z * pa.z > 0.0001 and pb.x * pb.x + pb.z * pb.z > 0.0001 {
      env.setFloat(crease, e, TAPE);
    }
    e = e + 1u32;
  }
  displaceAlongNormal(&env, "bulge", BULGE);
}

// The skirt below the mouth, a little narrower at its foot
fn skirtMesh(look &BalloonLook) mesh.Mesh {
  imm pts Array[Vec2, 3] = [p2(0.2, -0.15), p2(0.225, -0.07), p2(0.24, 0.)];
  imm profile = Profile.fromPoints(&pts, false);
  imm s = lathe(&profile, up(), 2. * pi, look.gores * 2u32);
  imm solid = solidify(&s, 0.006, 0., false, true);
  solid.triangulate(true);
}

// ---- The rig: burner frame, burner, cables ----

const RING f32 = 0.07;              // the frame's corners from the axis
const RING_Y f32 = -0.40;
const TOP_Y f32 = -0.46;            // the basket's rim
const BASKET f32 = 0.13;            // the basket's corners from the axis
pub const NOZZLE_Y f32 = -0.33;     // the burner can's top (RING_Y + 0.07)

// The frame and the burner: steel
fn burnerFrame() mesh.Mesh {
  imm corners Array[Vec3, 4] = [v(RING, RING_Y, 0.), v(0., RING_Y, 0. - RING), v(0. - RING, RING_Y, 0.), v(0., RING_Y, RING)];
  imm square = Path.fromPoints(&corners, true);
  imm tube = Profile.polygon(6u32, 0.006);
  imm ring = sweep(&tube, &square, 0., 1., 1., false);
  imm postLine = Path.line(v(BASKET - 0.008, TOP_Y, 0.), v(RING, RING_Y, 0.), 1u32);
  imm post = sweep(&tube, &postLine, 0., 1., 1., false);
  imm posts = arrayRadial(&post, 4u32, up(), 2. * pi, v(0., 0., 0.), -1.);
  imm can Array[Vec2, 5] = [p2(0., RING_Y - 0.01), p2(0.035, RING_Y - 0.01), p2(0.035, RING_Y + 0.05),
    p2(0.024, RING_Y + 0.07), p2(0., RING_Y + 0.07)];
  imm canProfile = Profile.fromPoints(&can, false);
  imm burner = lathe(&canProfile, up(), 2. * pi, 16u32);
  mut m = ring.triangulate(true);
  imm postsMesh = posts.triangulate(true);
  m.append(&postsMesh);
  imm burnerMesh = burner.triangulate(true);
  m.append(&burnerMesh);
  m;
}

// The cables: from the foot of each load tape to the frame's nearest corner
fn cables(look &BalloonLook) mesh.Mesh {
  imm g = i32.from(look.gores);
  imm wire = Profile.polygon(3u32, 0.0016);
  mut quarter = mesh.Mesh.empty();
  mut k = 0 - g / 8 + 1;
  while k <= g / 8 {
    imm a = 2. * pi * f32.from(k) / f32.from(g);
    // The lathe turns from +x towards -z
    imm foot = v(0.2 * cos(a), -0.15, 0. - 0.2 * sin(a));
    imm line = Path.line(foot, v(RING, RING_Y, 0.), 1u32);
    imm cable = sweep(&wire, &line, 0., 1., 1., false);
    imm cableMesh = cable.triangulate(true);
    quarter.append(&cableMesh);
    k = k + 1;
  }
  // arrayRadial wants a PolyMesh: the quarter's triangles as one
  mut problems = List[String].empty();
  mut counts = List[u32].empty();
  mut t = 0usize;
  while t < quarter.triangleCount() { counts.push(3u32); t = t + 1usize; }
  imm q = mesh.PolyMesh.fromPolygons(quarter.positions.view(), counts.view(), quarter.indices.view(), &mut problems);
  imm all = arrayRadial(&q, 4u32, up(), 2. * pi, v(0., 0., 0.), -1.);
  all.triangulate(true);
}

// ---- The basket ----

// Floor, outer wall, rim, inner wall, inner floor: lathed in 4 steps
fn basketProfile() Profile {
  imm pts Array[Vec2, 6] = [p2(0., TOP_Y - 0.16), p2(BASKET, TOP_Y - 0.16), p2(BASKET, TOP_Y), p2(BASKET - 0.014, TOP_Y),
    p2(BASKET - 0.014, TOP_Y - 0.14), p2(0., TOP_Y - 0.14)];
  Profile.fromPoints(&pts, false);
}

fn basketMesh() mesh.Mesh {
  imm profile = basketProfile();
  imm b = lathe(&profile, up(), 2. * pi, 4u32);
  b.triangulate(true);
}

// Wicker: strands over and under in cells about 1/16 of a wall across, each
// cell's shade jittered; the rim in leather
fn wickerImage() Image {
  imm w = 512;
  imm h = 256;
  imm profile = basketProfile();
  imm length = profile.length();
  imm across = 64.;
  imm down = libc.floorf(length / (4. * BASKET * 1.4142136 / across));
  imm rimFrom = (BASKET + 0.16) / length;
  imm rimTo = (BASKET + 0.174) / length;
  mut img = new Image(w, h, 3, List[u8].withCapacity(usize.from(w * h * 3)));
  mut y = 0;
  while y < h {
    imm vv = (f32.from(y) + 0.5) / f32.from(h);
    mut x = 0;
    while x < w {
      imm cx = (f32.from(x) + 0.5) / f32.from(w) * across;
      imm cy = vv * down;
      imm i = i32.from(libc.floorf(cx));
      imm j = i32.from(libc.floorf(cy));
      imm strand = if (i + j) % 2 == 0 { sin(pi * fract(cy)); } else { sin(pi * fract(cx)); };
      mut shade = (0.45 + 0.55 * strand) * (1. + 0.12 * noise.toSigned(noise.hash2(i, j, BALLOON_SEED).x));
      mut c Array[f32, 3] = [0.80, 0.52, 0.26];
      if vv > rimFrom - 0.01 and vv < rimTo + 0.01 { c = [0.30, 0.16, 0.08]; shade = 1.; }
      mut k = 0usize;
      while k < 3usize {
        imm b = c[k] * shade;
        img.pixels.push(if b >= 1. { 255u8; } else { u8.from(b * 255. + 0.5); });
        k = k + 1usize;
      }
      x = x + 1;
    }
    y = y + 1;
  }
  img;
}

// The two passengers' heads, in balloon units
fn headsMesh() mesh.Mesh {
  mut m = mesh.Mesh.empty();
  imm heads Array[f32, 4] = [0.04, 0.02, -0.035, -0.03];
  mut k = 0usize;
  while k < 2usize {
    mut head = mesh.Mesh.sphere(0.022, 10);
    head.transform(Mat4.fromTranslation(v(heads[k * 2usize], TOP_Y + 0.035, heads[k * 2usize + 1usize])));
    m.append(&head);
    k = k + 1usize;
  }
  m;
}

// ---- The balloon, as the world's object 'k' ----

// The balloon's parts into 'h', as one tree: the envelope its root, placed
// by the world's place for 'k' with the basket's floor on the ground; under
// the envelope the skirt, the cables, the burner frame (and under it the
// flame and the pilot light) and the basket (and under it the passengers),
// each at its parent's origin, since all are made in the balloon's units
// about one axis. Moving the envelope moves the whole balloon.
fn hydrateBalloon(h &mut Hydrated, k u32) {
  imm look = chevrons();
  imm scale = PLACES[usize.from(k) * 4usize + 3usize];
  // The basket's floor is TOP_Y - 0.16 below the mouth
  imm lift = (0. - (TOP_Y - 0.16)) * scale;
  imm at = placeOf(k, lift);
  imm here = Transform3.identity();

  imm cage = envelopeCage(&look);
  imm fine = subdivide(&cage, BALLOON_LEVELS);
  imm envelope = h.add("balloon envelope", fine.triangulate(true), Look.shiny(new Color(1., 1., 1., 1.), 0.12, 12.),
    envelopeImage(&look, PAINT_TEXELS), at);
  imm sc = usize.from(look.skirt) * 3usize;
  imm skirtLook = Look.plain(new Color(PAINT[sc] * PAINT[sc] * 0.5, PAINT[sc + 1usize] * PAINT[sc + 1usize] * 0.5,
    PAINT[sc + 2usize] * PAINT[sc + 2usize] * 0.5, 1.));
  h.part("balloon skirt", h.addMesh(skirtMesh(&look)), h.addMaterial(skirtLook, Image.empty(), Maps.none(), 0u32), envelope, here);
  imm frameLook = Look.shiny(new Color(0.55, 0.55, 0.57, 1.), 0.8, 48.);
  imm frame = h.part("balloon burner frame", h.addMesh(burnerFrame()), h.addMaterial(frameLook, Image.empty(), Maps.none(), 0u32),
    envelope, here);
  h.part("balloon cables", h.addMesh(cables(&look)),
    h.addMaterial(Look.plain(new Color(0.04, 0.04, 0.04, 1.)), Image.empty(), Maps.none(), 0u32), envelope, here);
  imm basket = h.part("balloon basket", h.addMesh(basketMesh()),
    h.addMaterial(Look.plain(new Color(1., 1., 1., 1.)), wickerImage(), Maps.none(), 0u32), envelope, here);
  h.part("balloon passengers", h.addMesh(headsMesh()),
    h.addMaterial(Look.plain(new Color(0.5, 0.5, 0.52, 1.)), Image.empty(), Maps.none(), 0u32), basket, here);

  // The flame, on the burner can's top, in metres (not scaled with the
  // balloon): placed under the burner frame by the inverse of the frame's
  // place, so it stands in the world where it always did
  imm nozzle = at.translation + at.rotation.rotate(v(0., NOZZLE_Y * scale, 0.));
  imm inFrame = at.inverse();
  // Its first burst, on the ground: the world fires the rest (BakedWorld.tick)
  h.effects.push(new EffectDesc(String.from("balloon burner flame"), burnerFlame(), frame,
    inFrame * new Transform3(nozzle, Quat.identity(), v(1., 1., 1.)), noise.hash1(0, BALLOON_SEED), 0d, BURST_ON));
  // The pilot light beside it, never out
  h.effects.push(new EffectDesc(String.from("balloon pilot light"), pilotLight(), frame,
    inFrame * new Transform3(nozzle + v(0.05, 0.01, 0.), Quat.identity(), v(1., 1., 1.)), BALLOON_SEED, 0d, EFFECT_NEVER));
}
