// The hot-air balloon, ported from sculpt's balloon example
// (packages/sculpt/examples/balloon.cone): the photograph's chevron balloon,
// standing on the ground with its basket down, its burner alight (the flame
// is flame.cone's).
//
// ONE BALLOON, part by part (y is up, the mouth at y = 0, the equator's
// radius about 1; the world scales it 9 m a unit):
// - the envelope: one cubic Bezier from the mouth to the crown, lathed into
//   GORES x 4 columns; each gore bulges between its load tapes (a function of
//   the lathe's "along" channel, displaced along the normals); the
//   tapes are creased, so subdivision keeps a valley at each; subdivided
//   twice. Its paint is an image made here, read through the lathe's uv;
// - the skirt below the mouth: a short open profile lathed and solidified;
// - the burner frame, dark charcoal steel: a square ring, four uprights from
//   the basket's corners, four spokes holding the one burner head (a can)
//   over the middle; and the launch button's mount on the basket's back rail;
// - the burner's coil, copper, wound round the can, and its valve fittings,
//   brass: two valves on the spokes and a ring at the nozzle. No part of the
//   burner is pale or wood-toned, so above the basket it cannot be taken for
//   a mannequin's head;
// - the suspension cables, from each load tape's foot to the frame's
//   nearest corner;
// - the basket, big enough for two standing mannequins: 1.9 m square inside,
//   its walls 1.1 m above its floor, wicker (an image made here), and open
//   at the front (its +z side), so a walker steps straight in; its rim
//   leather. It is a PLATFORM (parts/platforms.cone): its floor holds up
//   whoever stands on it and carries them, its three walls stop them;
// - the launch button: a red cap on the mount, inside the basket at the
//   back rail. The world listens for its clicks.
//
// The basket and the burner are laid out in metres (below) and scaled into
// the balloon's units, 9 m a unit (the world's place for the balloon).

const BALLOON_SEED = 1783u32;       // the Montgolfiers' year
const BULGE f32 = 0.045;            // a gore's bulge, per unit of radius
const TAPE f32 = 2.;                // the load tapes' crease (sharp for two levels)
const BALLOON_LEVELS = 2u32;
const PAINT_TEXELS = 32;            // the paint's texels across a gore
// Paint, sRGB: navy, blue, teal, yellow, red, purple, white, orange, green
imm PAINT Array[f32, 27] = [0.13, 0.15, 0.40, 0.16, 0.34, 0.78, 0.02, 0.60, 0.58, 0.98, 0.86, 0.06,
  0.90, 0.10, 0.08, 0.50, 0.24, 0.74, 0.95, 0.95, 0.92, 0.98, 0.50, 0.06, 0.20, 0.62, 0.20];

fn tri(x f32) f32 { libc.fabsf(2. * fract(x) - 1.); }

// What differs between balloons (the example's Look)
struct BalloonLook {
  pub gores u32;            // a multiple of 4: the cables gather at the frame's four corners
  pub pattern u32;          // 0 chevrons, 1 stepped diagonals, 2 gore stripes with a band
  pub paint Array[u32, 6];  // indices into PAINT
  pub fat f32;              // the envelope's width, 1 as photographed
  pub skirt u32;            // the skirt's paint
}

// The photograph's chevron balloon
fn chevrons() BalloonLook { new BalloonLook(24u32, 0u32, [3u32, 2u32, 1u32, 0u32, 2u32, 3u32], 1.04, 4u32); }

// ---- The envelope ----

// A gore's panel colour at (u, v) of the lathe's uv: u around, v up from the mouth
fn paintAt(look &BalloonLook, u f32, vv f32) u32 {
  imm gores = f32.from(look.gores);
  imm g = u32.from(libc.floorf(u * gores));
  if look.pattern == 0u32 {
    // Chevrons: plain gores at the foot and the crown, between them bands
    // dipping to a V across every four gores
    if vv < 0.3 { return look.paint[usize.from(g % 3u32)]; }
    if vv > 0.84 { return look.paint[usize.from((g + 1u32) % 3u32)]; }
    imm b = u32.from(libc.floorf((vv - 0.3) * 8. + 1.4 * tri(u * gores / 4. + 0.5)));
    imm cycle Array[usize, 4] = [3usize, 4usize, 3usize, 5usize];
    return look.paint[cycle[usize.from(b % 4u32)]];
  }
  if look.pattern == 1u32 {
    imm r = u32.from(libc.floorf(vv * 13.));
    return look.paint[usize.from((r + g) % 5u32)];
  }
  if vv > 0.55 and vv < 0.64 { return look.paint[5usize]; }
  look.paint[usize.from(g % 3u32)];
}

// The envelope's paint as an image: 'texels' a gore across and 32 times
// that up, each texel the mean of 2 x 2 samples, the load tapes a darker
// strip a sixteenth of a gore wide
fn envelopeImage(look &BalloonLook, texels i32) Image {
  imm w = i32.from(look.gores) * texels;
  imm h = 32 * texels;
  mut img = new Image(w, h, 3, List[u8].withCapacity(usize.from(w * h * 3)));
  mut y = 0;
  while y < h {
    mut x = 0;
    while x < w {
      imm shade = if x % texels < (texels + 15) / 16 { 0.75; } else { 1.; };
      mut sum Array[f32, 3] = [0., 0., 0.];
      mut s = 0;
      while s < 4 {
        imm u = (f32.from(x) + 0.25 + 0.5 * f32.from(s % 2)) / f32.from(w);
        imm c = usize.from(paintAt(look, u, (f32.from(y) + 0.25 + 0.5 * f32.from(s / 2)) / f32.from(h))) * 3usize;
        sum[0usize] = sum[0usize] + PAINT[c];
        sum[1usize] = sum[1usize] + PAINT[c + 1usize];
        sum[2usize] = sum[2usize] + PAINT[c + 2usize];
        s = s + 1;
      }
      mut k = 0usize;
      while k < 3usize {
        img.pixels.push(u8.from(sum[k] * 0.25 * shade * 255. + 0.5));
        k = k + 1usize;
      }
      x = x + 1;
    }
    y = y + 1;
  }
  img;
}

// The envelope's cage: the profile lathed, each gore puffed out between its
// tapes, the tapes creased
fn envelopeCage(look &BalloonLook) mesh.PolyMesh {
  imm f = look.fat;
  imm curve = new CubicBezier2(p2(0.24, 0.), p2(0.95 * f, 0.62), p2(1.5 * f, 2.3), p2(0., 2.2));
  imm profile = Profile.fromCubic(curve, 24u32);
  mut env = lathe(&profile, up(), 2. * pi, look.gores * 4u32);
  imm gores = f32.from(look.gores);
  imm along = env.findFloatChannel(mesh.VertexDomain, "along");
  // The tapes: edges up a gore's edge, off the axis
  imm crease = env.addFloatChannel(mesh.EdgeDomain, "crease", 0.);
  mut e = 0u32;
  while e < u32.from(env.edgeCount()) {
    imm a = env.fromVertex(2u32 * e);
    imm b = env.toVertex(2u32 * e);
    imm pa = *env.positions[usize.from(a)];
    imm pb = *env.positions[usize.from(b)];
    imm la = env.float(along, a);
    imm onTape = fract(la * gores + 0.001) < 0.002;
    if onTape and la == env.float(along, b) and pa.x * pa.x + pa.z * pa.z > 0.0001 and pb.x * pb.x + pb.z * pb.z > 0.0001 {
      env.setFloat(crease, e, TAPE);
    }
    e = e + 1u32;
  }
  // Each gore puffs out between its tapes: sin of its fraction across, times the radius
  displaceAlongNormal(&env, k => {
    imm p = *env.positions[usize.from(k)];
    imm r = (p.x * p.x + p.z * p.z).sqrt();
    BULGE * (sin(pi * fract(env.float(along, k) * gores)) * r);
  });
}

// The skirt below the mouth, a little narrower at its foot
fn skirtMesh(look &BalloonLook) mesh.Mesh {
  imm pts Array[Vec2, 3] = [p2(0.2, -0.15), p2(0.225, -0.07), p2(0.24, 0.)];
  imm profile = Profile.fromPoints(&pts, false);
  imm s = lathe(&profile, up(), 2. * pi, look.gores * 2u32);
  imm solid = solidify(&s, 0.006, 0., false, true);
  solid.triangulate(true);
}

// ---- The rig and the basket, laid out in metres ----

// A metre in the balloon's units (the world places the balloon at 9 m a unit)
const M f32 = 0.11111111;

// The basket: its bottom where the old one's was (5.58 m below the mouth),
// its floor 0.12 m thick, 1.9 m square inside, its walls 0.07 m thick and
// 1.1 m above the floor, a leather roll on each wall's top
const BASKET_BOTTOM f32 = -5.58;
const FLOOR_TOP f32 = -5.46;
const INSIDE f32 = 0.95;            // half the inside's width
const OUTSIDE f32 = 1.02;           // half the outside's
const WALL_TOP f32 = -4.36;         // FLOOR_TOP + 1.1
const RIM_TOP f32 = -4.30;
const RIM_HALF f32 = 0.05;          // half the roll's width

// The burner frame: a square ring 2.75 m above the basket's floor (a tall
// mannequin's head is 1 m under the burner), its corners 0.55 m out along
// each axis, over the basket's corners
const RING_Y f32 = -2.71;
const RING f32 = 0.55;
const TUBE f32 = 0.03;              // the ring's tube and the spokes' radius
const POST f32 = 0.035;             // the uprights' radius

// The one burner head: a can 0.26 m round over the middle, from 0.09 m
// below the ring to its nozzle 0.55 m above it, the coil 0.3 m round
const CAN f32 = 0.26;
const NOZZLE f32 = -2.16;           // RING_Y + 0.55
pub const NOZZLE_Y f32 = -0.24;     // the same, in the balloon's units

// The launch button: its mount on the inside of the back rail (the -z
// wall), 0.52 m to the right of a rider who faces out of the open front,
// its top 6 cm above the rim; the cap on it
const MOUNT_X f32 = -0.52;
const MOUNT_TOP f32 = -4.24;
const CAP_RADIUS f32 = 0.07;
const CAP_HEIGHT f32 = 0.035;

// Parts' places among the balloon's (hydrateBalloon's order): the burner
// frame, the basket, the cap, and the flame (the effects come after the
// nine meshes)
pub const BALLOON_FRAME = 2usize;
pub const BALLOON_BASKET = 4usize;
pub const BALLOON_CAP = 8usize;
pub const BALLOON_FLAME = 9usize;

// A mesh laid out in metres, into the balloon's units
fn inUnits(m mesh.Mesh) mesh.Mesh {
  mut out = m;
  out.transform(Mat4.fromTrs(v(0., 0., 0.), Quat.identity(), v(M, M, M)));
  out;
}

// A box from 'lo' to 'hi' (metres) appended to 'm', every face's uv the
// metres across and up it over 'tile', so a material's image repeats at
// that size whatever the box's
fn box(m &mut mesh.Mesh, lo Vec3, hi Vec3, tile f32) {
  mut b = mesh.Mesh.cube(0.5);
  b.transform(Mat4.fromTrs((lo + hi) * 0.5, Quat.identity(), hi - lo));
  mut i = 0usize;
  while i < b.positions.len() {
    imm p = *b.positions[i];
    imm n = *b.normals[i];
    imm ax = libc.fabsf(n.x);
    imm ay = libc.fabsf(n.y);
    imm uv = if ax > 0.5 { p2(p.z, p.y); } elif ay > 0.5 { p2(p.x, p.z); } else { p2(p.x, p.y); };
    b.uvs.set(i, uv * (1. / tile));
    i = i + 1usize;
  }
  m.append(&b);
}

// A straight tube of 'radius' from 'a' to 'b' (metres), six-sided
fn tube(a Vec3, b Vec3, radius f32) mesh.Mesh {
  imm line = Path.line(a, b, 1u32);
  imm section = Profile.polygon(6u32, radius);
  sweep(&section, &line, 0., 1., 1., true).triangulate(true);
}

// The frame, dark charcoal steel: the ring, the four uprights from the
// basket's rim corners, the four spokes to the can, the can (the one
// burner head) and the launch button's mount
fn burnerFrame() mesh.Mesh {
  imm corners Array[Vec3, 4] = [v(RING, RING_Y, RING), v(RING, RING_Y, 0. - RING), v(0. - RING, RING_Y, 0. - RING),
    v(0. - RING, RING_Y, RING)];
  imm square = Path.fromPoints(&corners, true);
  imm section = Profile.polygon(6u32, TUBE);
  mut m = sweep(&section, &square, 0., 1., 1., false).triangulate(true);
  imm rim = OUTSIDE - RIM_HALF;
  mut k = 0usize;
  while k < 4usize {
    imm c = corners[k];
    imm sx = if c.x > 0. { 1.; } else { -1.; };
    imm sz = if c.z > 0. { 1.; } else { -1.; };
    imm post = tube(v(sx * rim, RIM_TOP, sz * rim), c, POST);
    m.append(&post);
    k = k + 1usize;
  }
  // The spokes, from the middle of each side of the ring in to the can
  imm spokes Array[Vec3, 4] = [v(1., 0., 0.), v(-1., 0., 0.), v(0., 0., 1.), v(0., 0., -1.)];
  k = 0usize;
  while k < 4usize {
    imm d = spokes[k];
    imm spoke = tube(v(d.x * (CAN - 0.02), RING_Y, d.z * (CAN - 0.02)), v(d.x * RING, RING_Y, d.z * RING), TUBE);
    m.append(&spoke);
    k = k + 1usize;
  }
  imm can Array[Vec2, 6] = [p2(0., RING_Y - 0.09), p2(CAN, RING_Y - 0.09), p2(CAN, RING_Y + 0.42), p2(0.2, RING_Y + 0.5),
    p2(0.17, NOZZLE), p2(0., NOZZLE)];
  imm canProfile = Profile.fromPoints(&can, false);
  imm head = lathe(&canProfile, up(), 2. * pi, 24u32).triangulate(true);
  m.append(&head);
  box(&mut m, v(MOUNT_X - 0.1, MOUNT_TOP - 0.18, 0. - INSIDE), v(MOUNT_X + 0.1, MOUNT_TOP, 0. - INSIDE + 0.12), 1.);
  inUnits(m);
}

// The coil, copper: a tube wound five times round the can, from just above
// the ring to just under the can's shoulder
fn burnerCoil() mesh.Mesh {
  imm turns = 5.;
  imm n = 160usize;
  mut pts = List[Vec3].withCapacity(n + 1usize);
  mut i = 0usize;
  while i <= n {
    imm t = f32.from(i) / f32.from(n);
    imm a = 2. * pi * turns * t;
    pts.push(v((CAN + 0.04) * cos(a), RING_Y + 0.04 + 0.33 * t, (CAN + 0.04) * sin(a)));
    i = i + 1usize;
  }
  imm path = Path.fromPoints(pts.view(), false);
  imm section = Profile.polygon(8u32, 0.028);
  inUnits(sweep(&section, &path, 0., 1., 1., true).triangulate(true));
}

// The valve fittings, brass: two valves standing on opposite spokes, each a
// short body with a handle across its top, and a ring round the nozzle
fn burnerValves() mesh.Mesh {
  mut m = mesh.Mesh.empty();
  imm body Array[Vec2, 4] = [p2(0., -0.07), p2(0.05, -0.07), p2(0.05, 0.07), p2(0., 0.07)];
  imm bodyProfile = Profile.fromPoints(&body, false);
  mut k = 0usize;
  while k < 2usize {
    imm sx = if k == 0usize { 1.; } else { -1.; };
    mut valve = lathe(&bodyProfile, up(), 2. * pi, 12u32).triangulate(true);
    valve.transform(Mat4.fromTranslation(v(sx * 0.42, RING_Y, 0.)));
    m.append(&valve);
    box(&mut m, v(sx * 0.42 - 0.02, RING_Y + 0.07, -0.1), v(sx * 0.42 + 0.02, RING_Y + 0.1, 0.1), 1.);
    k = k + 1usize;
  }
  imm ring Array[Vec2, 4] = [p2(0.165, NOZZLE - 0.06), p2(0.215, NOZZLE - 0.06), p2(0.215, NOZZLE - 0.01), p2(0.165, NOZZLE - 0.01)];
  imm ringProfile = Profile.fromPoints(&ring, true);
  imm fitting = lathe(&ringProfile, up(), 2. * pi, 24u32).triangulate(true);
  m.append(&fitting);
  inUnits(m);
}

// The cables: from the foot of each load tape to the frame's nearest corner
// (the corners are on the diagonals, over the basket's; 45 degrees is three
// gores, so a corner's cables still start on load tapes)
fn cables(look &BalloonLook) mesh.Mesh {
  imm g = i32.from(look.gores);
  imm wire = Profile.polygon(3u32, 0.0016);
  imm corner = RING * 1.4142136 * M;
  mut quarter = mesh.Mesh.empty();
  mut k = 0 - g / 8 + 1;
  while k <= g / 8 {
    imm a = 2. * pi * f32.from(k) / f32.from(g);
    // The lathe turns from +x towards -z
    imm foot = v(0.2 * cos(a), -0.15, 0. - 0.2 * sin(a));
    imm line = Path.line(foot, v(corner, RING_Y * M, 0.), 1u32);
    imm cable = sweep(&wire, &line, 0., 1., 1., false);
    imm cableMesh = cable.triangulate(true);
    quarter.append(&cableMesh);
    k = k + 1;
  }
  // arrayRadial wants a PolyMesh: the quarter's triangles as one
  mut problems = List[String].empty();
  mut counts = List[u32].empty();
  mut t = 0usize;
  while t < quarter.triangleCount() { counts.push(3u32); t = t + 1usize; }
  imm q = mesh.PolyMesh.fromPolygons(quarter.positions.view(), counts.view(), quarter.indices.view(), &mut problems);
  imm all = arrayRadial(&q, 4u32, up(), 2. * pi, v(0., 0., 0.), -1.);
  mut out = all.triangulate(true);
  out.transform(Mat4.fromTrs(v(0., 0., 0.), Quat.angleAxis(0.25 * pi, up()), v(1., 1., 1.)));
  out;
}

// ---- The basket ----

// The wicker's image repeats every WICKER_TILE metres
const WICKER_TILE f32 = 0.4;

// The basket: the floor, the two side walls (-x and +x) and the back wall
// (-z), open at the front (+z); wicker
fn basketMesh() mesh.Mesh {
  mut m = mesh.Mesh.empty();
  box(&mut m, v(0. - OUTSIDE, BASKET_BOTTOM, 0. - OUTSIDE), v(OUTSIDE, FLOOR_TOP, OUTSIDE), WICKER_TILE);
  box(&mut m, v(0. - OUTSIDE, BASKET_BOTTOM, 0. - OUTSIDE), v(0. - INSIDE, WALL_TOP, OUTSIDE), WICKER_TILE);
  box(&mut m, v(INSIDE, BASKET_BOTTOM, 0. - OUTSIDE), v(OUTSIDE, WALL_TOP, OUTSIDE), WICKER_TILE);
  box(&mut m, v(0. - INSIDE, BASKET_BOTTOM, 0. - OUTSIDE), v(INSIDE, WALL_TOP, 0. - INSIDE), WICKER_TILE);
  inUnits(m);
}

// The rim, dark leather: a roll on each wall's top, and a strip along the
// floor's open front edge
fn basketRim() mesh.Mesh {
  mut m = mesh.Mesh.empty();
  imm a = OUTSIDE + 0.015;
  imm mid = 0.5 * (OUTSIDE + INSIDE);
  box(&mut m, v(0. - mid - RIM_HALF, WALL_TOP, 0. - a), v(0. - mid + RIM_HALF, RIM_TOP, a), 1.);
  box(&mut m, v(mid - RIM_HALF, WALL_TOP, 0. - a), v(mid + RIM_HALF, RIM_TOP, a), 1.);
  box(&mut m, v(0. - mid + RIM_HALF, WALL_TOP, 0. - mid - RIM_HALF), v(mid - RIM_HALF, RIM_TOP, 0. - mid + RIM_HALF), 1.);
  box(&mut m, v(0. - a, BASKET_BOTTOM, OUTSIDE), v(a, FLOOR_TOP, a), 1.);
  inUnits(m);
}

// Wicker: strands over and under, 16 cells a tile each way (2.5 cm), each
// cell's shade jittered; the image tiles
fn wickerImage() Image {
  imm w = 256;
  imm h = 256;
  imm across = 16.;
  mut img = new Image(w, h, 3, List[u8].withCapacity(usize.from(w * h * 3)));
  mut y = 0;
  while y < h {
    mut x = 0;
    while x < w {
      imm cx = (f32.from(x) + 0.5) / f32.from(w) * across;
      imm cy = (f32.from(y) + 0.5) / f32.from(h) * across;
      imm i = i32.from(libc.floorf(cx));
      imm j = i32.from(libc.floorf(cy));
      imm strand = if (i + j) % 2 == 0 { sin(pi * fract(cy)); } else { sin(pi * fract(cx)); };
      imm shade = (0.45 + 0.55 * strand) * (1. + 0.12 * noise.toSigned(noise.hash2(i, j, BALLOON_SEED).x));
      imm c Array[f32, 3] = [0.80, 0.52, 0.26];
      mut k = 0usize;
      while k < 3usize {
        imm b = c[k] * shade;
        img.pixels.push(if b >= 1. { 255u8; } else { u8.from(b * 255. + 0.5); });
        k = k + 1usize;
      }
      x = x + 1;
    }
    y = y + 1;
  }
  img;
}

// The launch button's cap: a red disc on the mount, in the basket's frame
fn capMesh() mesh.Mesh {
  imm pts Array[Vec2, 4] = [p2(0., 0.), p2(CAP_RADIUS, 0.), p2(CAP_RADIUS, CAP_HEIGHT), p2(0., CAP_HEIGHT)];
  imm profile = Profile.fromPoints(&pts, false);
  inUnits(lathe(&profile, up(), 2. * pi, 32u32).triangulate(false));
}

// Where the cap stands in the basket's frame (the balloon's units), and how
// far it sinks when pressed: 2 cm
pub fn capPlace() Transform3 { new Transform3(v(MOUNT_X * M, MOUNT_TOP * M, (0. - INSIDE + 0.06) * M), Quat.identity(), v(1., 1., 1.)); }
pub const CAP_DIP f32 = 0.0022222;

// The basket as a platform, in its own frame (the balloon's units): its
// floor, inside its walls and out to its open front's edge; its three walls
pub fn basketPlatform() PlatformShape {
  PlatformShape.make(FLOOR_TOP * M, p2((0. - INSIDE) * M, (0. - INSIDE) * M), p2(INSIDE * M, OUTSIDE * M), (WALL_TOP - FLOOR_TOP) * M,
    WALL_MIN_X | WALL_MAX_X | WALL_MIN_Z);
}

// The basket's inside as an area, in its own frame: who steps in is told to the world
pub fn basketArea() Volume { Volume.box(v(0., (FLOOR_TOP + 0.9) * M, 0.035 * M), v(INSIDE * M, 1. * M, 0.985 * M)); }

// ---- The balloon, as the world's object 'k' ----

// The balloon's parts into 'h', as one tree: the envelope its root, placed
// by the world's place for 'k' with the basket's bottom on the ground; under
// the envelope the skirt, the burner frame (and under it the coil, the
// valves, the flame and the pilot light), the cables and the basket (and
// under it its rim and the launch button), each at its parent's origin
// (the cap at its mount), since all are made in the balloon's units about
// one axis. Moving the envelope moves the whole balloon.
fn hydrateBalloon(h &mut Hydrated, k u32) {
  imm look = chevrons();
  imm scale = PLACES[usize.from(k) * 4usize + 3usize];
  // The basket's bottom is BASKET_BOTTOM below the mouth
  imm lift = 0. - BASKET_BOTTOM * M * scale;
  imm at = placeOf(k, lift);
  imm here = Transform3.identity();
  // (The parts' order is the BALLOON_ constants' above)

  imm cage = envelopeCage(&look);
  imm fine = subdivide(&cage, BALLOON_LEVELS);
  imm envelope = h.add("balloon envelope", fine.triangulate(true), Look.shiny(new Color(1., 1., 1., 1.), 0.12, 12.),
    envelopeImage(&look, PAINT_TEXELS), at);
  imm sc = usize.from(look.skirt) * 3usize;
  imm skirtLook = Look.plain(new Color(PAINT[sc] * PAINT[sc] * 0.5, PAINT[sc + 1usize] * PAINT[sc + 1usize] * 0.5,
    PAINT[sc + 2usize] * PAINT[sc + 2usize] * 0.5, 1.));
  h.part("balloon skirt", h.addMesh(skirtMesh(&look)), h.addMaterial(skirtLook, Image.empty(), Maps.none(), 0u32), envelope, here);
  // Dark charcoal steel, sRGB (44, 46, 50), a dull sheen
  imm frame = h.part("balloon burner frame", h.addMesh(burnerFrame()),
    h.addMaterial(Look.shiny(srgb(44., 46., 50.), 0.45, 30.), Image.empty(), Maps.none(), 0u32), envelope, here);
  h.part("balloon cables", h.addMesh(cables(&look)),
    h.addMaterial(Look.plain(new Color(0.04, 0.04, 0.04, 1.)), Image.empty(), Maps.none(), 0u32), envelope, here);
  imm basket = h.part("balloon basket", h.addMesh(basketMesh()),
    h.addMaterial(Look.plain(new Color(1., 1., 1., 1.)), wickerImage(), Maps.none(), 0u32), envelope, here);
  // Dark brown leather, sRGB (62, 36, 22)
  h.part("balloon basket rim", h.addMesh(basketRim()),
    h.addMaterial(Look.shiny(srgb(62., 36., 22.), 0.15, 10.), Image.empty(), Maps.none(), 0u32), basket, here);
  // Old copper, deep and reddish, sRGB (150, 68, 36); brass, sRGB (176, 136, 44)
  h.part("balloon burner coil", h.addMesh(burnerCoil()),
    h.addMaterial(Look.shiny(srgb(150., 68., 36.), 0.9, 40.), Image.empty(), Maps.none(), 0u32), frame, here);
  h.part("balloon burner valves", h.addMesh(burnerValves()),
    h.addMaterial(Look.shiny(srgb(176., 136., 44.), 0.9, 50.), Image.empty(), Maps.none(), 0u32), frame, here);
  h.part("launch button", h.addMesh(capMesh()),
    h.addMaterial(Look.shiny(srgb(210., 30., 24.), 0.6, 40.), Image.empty(), Maps.none(), 0u32), basket, capPlace());

  // The flame, on the burner can's top, in metres (not scaled with the
  // balloon): placed under the burner frame by the inverse of the frame's
  // place, so it stands in the world where it always did
  imm nozzle = at.translation + at.rotation.rotate(v(0., NOZZLE_Y * scale, 0.));
  imm inFrame = at.inverse();
  // Its first burst, on the ground: the world fires the rest (BakedWorld.tick)
  h.effects.push(new EffectDesc(String.from("balloon burner flame"), burnerFlame(), frame,
    inFrame * new Transform3(nozzle, Quat.identity(), v(1., 1., 1.)), noise.hash1(0, BALLOON_SEED), 0d, BURST_ON));
  // The pilot light beside it, never out
  h.effects.push(new EffectDesc(String.from("balloon pilot light"), pilotLight(), frame,
    inFrame * new Transform3(nozzle + v(0.05, 0.01, 0.), Quat.identity(), v(1., 1., 1.)), BALLOON_SEED, 0d, EFFECT_NEVER));
}
