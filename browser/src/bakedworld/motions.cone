// The world's motions, each a formula of the scene's time (seconds, the
// simulation's: exact on frame's synthetic clock), sent as Place and Fire
// requests by BakedWorld.tick once a frame:
//
// - (the ball once bounced and spun here; it now lies where it was left, and
//   needs no motion)
// - the launch button's cap sinks for BUTTON_HELD after a press;
// - the balloon (one tree: its envelope moved, and everything under it with
//   it) stands in the backyard, its burner firing in the example's bursts
//   (BURST_ON seconds every BURST_PERIOD). Pressed, it flies THE RIDE: a
//   scripted flight on the scene's clock, FLIGHT_SECONDS long, up from its
//   spot, round over the island and down onto its spot again, turning as it
//   goes so that its basket's open front faces the view (below). A press
//   while it flies is ignored: the ride has one way down, its end.
//
// THE RIDE is one tweenstack 'along' animator: a centripetal Catmull-Rom
// spline through WAYPOINTS (its corners never overshoot into loops, however
// unevenly the waypoints are spaced), travelled by its length at an eased
// speed: from rest over EASE_SECONDS, steady, and to rest again over the last
// EASE_SECONDS (the end ramps, the speed rising as 1 - cos). Each waypoint
// names what its rider should be looking at; the balloon turns so its open
// front faces it, the heading interpolated between waypoints along the same
// spline's parameter, always the short way round from the last (so over the
// whole ride it turns once round, clockwise seen from above, and a rider who
// walked in and turned about faces every view in turn): tweenstack's heading
// curve, 'facingHeadings'. At the start and the end it faces as it stands.
// The animator is begun at the press's moment, so a reader that comes to it
// late (a view arriving mid-ride) is put as far into the ride as the press
// was ago.
//
// The views, in order (x east, z south to the sea; the balloon's spot is
// (-10, 300), 24 m behind the cottage, whose front faces the path):
//   lift-off       straight up 25 m over its spot, facing the cottage's back
//   over the lawn  at 60 m, east of the cottage, looking west-south-west
//                  across the lowland
//   east lowland   at 110 m, looking west-north-west over the forest to the
//                  hill's flank
//   east beach     at 140 m over the cove's east shore, looking north-west
//                  up the path to the hill
//   over the cove  at 150 m, the highest, over the cove's mouth, looking
//                  north: the beach, the path, the cottage and the 150 m hill
//                  behind, the whole island across the view
//   west coast     at 140 m, looking north-east over the lowland and the
//                  cottage to the hill
//   west lowland   at 130 m, looking east: the cottage, the cove and the
//                  long south-east peninsula
//   north-west     at 100 m behind the cottage, looking south-east over it
//                  to the cove and the beach
//   descent        down past the cottage's roof onto the spot
// The rider's eyes look level, so each view is chosen to put land, not sea,
// across the lower half of the picture: across the island, not out from it.
// The burner fires in bursts as it climbs (BURST_CLIMB_ON every
// BURST_CLIMB_PERIOD) to the top, a short burst every BURST_CRUISE_PERIOD
// after, and none for the last DESCENT_QUIET seconds, as it sinks to land.

pub const BALL_RADIUS: f32 = 0.5;

const BUTTON_HELD: f64 = 0.25;

pub const BURST_ON: f64 = 3.;
const BURST_PERIOD: f64 = 4.;
const BURST_CLIMB_ON: f64 = 3.2;
const BURST_CLIMB_PERIOD: f64 = 5.;
const BURST_CRUISE_ON: f64 = 1.5;
const BURST_CRUISE_PERIOD: f64 = 20.;
const DESCENT_QUIET: f64 = 45.;

// The ride's length in the scene's seconds, and the time it eases from and to rest
pub const FLIGHT_SECONDS: f32 = 170.;
const EASE_SECONDS: f32 = 20.;

// The waypoints: x, the height above the spot's ground, z; and the point (x,
// z) the open front is to face there (REST: as the balloon stands). The
// first and last are the spot itself.
const REST: f32 = 1.0e9;
const WAYPOINTS = 12usize;
let WAYPOINT: Array[f32, 60] = [
  -10., 0., 300.,       REST, REST,         // on its spot in the backyard
  -10., 25., 300.,      REST, REST,         // straight up, clear of the pines round it
  30., 60., 350.,       -200., 500.,        // over the lawn east of the cottage: west-south-west across the lowland
  110., 110., 440.,     -200., 300.,        // the east lowland: west-north-west over the forest to the hill's flank
  60., 140., 560.,      -120., 250.,        // over the cove's east shore: north-west up the path to the hill
  -30., 150., 650.,     -20., 0.,           // the top, over the cove's mouth: north over the beach, the cottage and the hill
  -230., 140., 580.,    100., 250.,         // the west coast: north-east over the lowland, the cottage, the hill
  -260., 130., 420.,    200., 520.,         // the west lowland: east to the cottage, the cove and the south-east peninsula
  -160., 100., 300.,    100., 560.,         // north-west of the cottage: south-east over it to the cove and the beach
  -60., 50., 270.,      -10., 450.,         // coming down behind the cottage, looking over its roof
  -10., 25., 300.,      REST, REST,         // over the spot
  -10., 0., 300.,       REST, REST];        // landed
// The highest waypoint: the climb ends there
const TOP_WAYPOINT = 5usize;

// tweenstack's target and property keys for the ride (a program's own keys start at 1024): the envelope's place
// (a Vec3, the path's point) and its heading (a rotation about +y)
const RIDE_TARGET = 4u32;
const RIDE_AT = 1027u32;
const RIDE_FACING = 1028u32;

// Where the balloon is on the ride: its envelope's place moved by 'offset'
// (metres, from where it stands), turned by 'rotation' (about +y, as the
// world's place turns it: its open front, +z, faces (sin yaw, cos yaw))
pub struct FlightPose {
  pub offset: Vec3;
  pub rotation: Quat;

  // The heading in radians (as the rotation says it, within a turn either way)
  pub fn yaw(self: &) f32 { 2. * libc.atan2f(rotation.y, rotation.w) }
}

// As it stands, on its spot
fn restPose(restYaw: f32) FlightPose { new FlightPose(new Vec3(0., 0., 0.), Quat.angleAxis(restYaw, new Vec3(0., 1., 0.))) }

// A burst of the burner: from 'start' until 'stop' (the scene's seconds)
pub struct Burst {
  pub start: f64;
  pub stop: f64;
}

const GROUND = 0u32;
const FLYING = 1u32;   // the ride, from 'since'; on its spot again from 'since' + FLIGHT_SECONDS

// The balloon's flight: on the ground since the start, or on the ride
// since a press (and on the ground again once it has ended)
pub struct Flight {
  pub state: u32;
  pub since: f64;
  pub firedStart: f64;          // the burst last sent
  pub firedStop: f64;

  // On the ground from the start, its first burst sent with its Effect
  pub fn grounded() Flight { new Flight(GROUND, 0.0, 0.0, BURST_ON) }

  // Seconds into the ride at 'now': 0 before any, FLIGHT_SECONDS once landed
  pub fn elapsed(self: &, now: f64) f32 {
    if state != FLYING { return 0.; }
    let t = f32.from(now - since);
    if t < 0. { 0. } elif t > FLIGHT_SECONDS { FLIGHT_SECONDS } else { t }
  }

  // Whether it is on the ride at 'now'
  pub fn flying(self: &, now: f64) bool { state == FLYING && now - since < f64.from(FLIGHT_SECONDS) }

  // When the ride ended (or will): its landing
  pub fn landedAt(self: &) f64 { since + f64.from(FLIGHT_SECONDS) }

  // The basket's height above its spot at 'now' (for one that has no RideAnim of its own: a ride begun at the press
  // and read at 'now', as a late reader would)
  pub fn altitude(self: &, now: f64, restYaw: f32) f32 {
    var ride = RideAnim.make();
    ride.pose(self, now, restYaw).offset.y
  }

  // Pressed at 'now': the ride begins, if it is on the ground; a press
  // while it flies is ignored
  pub fn pressed(self, now: f64) Flight {
    if self.flying(now) { return self; }
    new Flight(FLYING, now, firedStart, firedStop)
  }

  // The burner's burst at 'now'
  pub fn burst(self: &, now: f64) Burst {
    if state != FLYING { return bursts(since, BURST_PERIOD, BURST_ON, now); }
    let landed = self.landedAt();
    if now >= landed { return bursts(landed, BURST_PERIOD, BURST_ON, now); }
    let top = since + f64.from(rideTopTime());
    if now < top { return bursts(since, BURST_CLIMB_PERIOD, BURST_CLIMB_ON, now); }
    let quiet = landed - DESCENT_QUIET;
    if now < quiet { return bursts(top, BURST_CRUISE_PERIOD, BURST_CRUISE_ON, now); }
    // Sinking to land: the last burst cut short where the quiet begins
    new Burst(firedStart, if firedStop < quiet { firedStop } else { quiet })
  }
}

// Bursts 'on' seconds long every 'period' from 'from': the one at 'now'
fn bursts(from: f64, period: f64, on: f64, now: f64) Burst {
  var b = 0.0;
  if now > from { b = libc.floor((now - from) / period); }
  let start = from + b * period;
  new Burst(start, start + on)
}

// ---- The ride's path ----

// The waypoints' places, the path's points
fn ridePoints() List[Vec3] {
  var pts = List[Vec3].empty();
  var i = 0usize;
  while i < WAYPOINTS {
    pts.push(new Vec3(WAYPOINT[i * 5usize], WAYPOINT[i * 5usize + 1usize], WAYPOINT[i * 5usize + 2usize]));
    i = i + 1usize;
  }
  pts
}

// The path: centripetal Catmull-Rom through the waypoints, one past each end mirrored (so it leaves its spot and
// comes down onto it straight up and down)
fn rideCurve() tweenstack.Curve3 {
  let pts = ridePoints();
  tweenstack.Curve3.centripetal(&pts)
}

// The heading at waypoint 'i' for a balloon standing at 'restYaw': facing its target, or as it stands
fn targetYaw(i: usize, restYaw: f32) f32 {
  let k = i * 5usize;
  if WAYPOINT[k + 3usize] == REST { return restYaw; }
  libc.atan2f(WAYPOINT[k + 3usize] - WAYPOINT[k], WAYPOINT[k + 4usize] - WAYPOINT[k + 2usize])
}

// The ride as an animator: along the path over FLIGHT_SECONDS at one speed, eased from and to rest over
// EASE_SECONDS, the heading at each waypoint a turn towards its view (tweenstack unwinds them the short way round)
fn rideAnim(curve: &tweenstack.Curve3, restYaw: f32) tweenstack.Anim {
  var headings = List[f32].empty();
  var i = 0usize;
  while i < WAYPOINTS {
    headings.push(targetYaw(i, restYaw));
    i = i + 1usize;
  }
  tweenstack.Anim.along(RIDE_TARGET, RIDE_AT, curve, FLIGHT_SECONDS).byArcLength(true).withEndRamps(EASE_SECONDS)
    .facingHeadings(RIDE_FACING, &headings)
}

// The ride's whole length, metres
pub fn rideLength() f32 { rideCurve().length() }

// Its steady speed, m/s: the length over the time less one ease
pub fn rideSpeed() f32 { rideLength() / (FLIGHT_SECONDS - EASE_SECONDS) }

// When it reaches waypoint 'i', seconds into the ride (found by halving the time, the distance only growing with
// it; the end ramps' own distance)
pub fn rideTimeAt(i: usize) f32 {
  let c = rideCurve();
  let perSegment = (c.lens.len() - 1usize) / c.segments();
  let fraction = *c.lens[i * perSegment] / c.total;
  var lo = 0.f;
  var hi = FLIGHT_SECONDS;
  var k = 0;
  while k < 40 {
    let mid = 0.5 * (lo + hi);
    if tweenstack.rampProgress(mid / FLIGHT_SECONDS, FLIGHT_SECONDS, EASE_SECONDS) < fraction { lo = mid; } else { hi = mid; }
    k = k + 1;
  }
  0.5 * (lo + hi)
}

// When it reaches its highest waypoint: the climb's end
pub fn rideTopTime() f32 { rideTimeAt(TOP_WAYPOINT) }

// How many waypoints the ride has, and the height of each above the spot
pub fn rideWaypoints() usize { WAYPOINTS }
pub fn rideWaypointHeight(i: usize) f32 { WAYPOINT[i * 5usize + 1usize] }

// A ride in progress: a tweenstack registry holding the animator of the balloon's ride, begun at the press's
// moment. It is read at the scene's time (forward or back: the ride is a function of the time since the press).
pub struct RideAnim {
  reg: tweenstack.Animators;
  begunFor: f64;             // the press the animator was begun for
  begun: bool;
  start: Vec3;               // the path's first point (where the balloon stands)

  pub fn make() RideAnim { new RideAnim(tweenstack.Animators.make(), 0.0, false, new Vec3(0., 0., 0.)) }

  // Where the balloon is at 'now' on 'flight''s ride, standing at 'restYaw' on its spot: exactly as it stands before
  // the ride and after it
  pub fn pose(self: &mut, flight: &Flight, now: f64, restYaw: f32) FlightPose {
    let t = flight.elapsed(now);
    if t <= 0. || t >= FLIGHT_SECONDS { return restPose(restYaw); }
    if !begun || begunFor != flight.since {
      let curve = rideCurve();
      let a = rideAnim(&curve, restYaw);
      let pts = ridePoints();
      start = *pts[0usize];
      // (the registry's clock is brought to 'now' first: a press in its past is put that far into the ride)
      reg.tick(now);
      reg.startAt(&a, flight.since);
      begun = true;
      begunFor = flight.since;
    }
    reg.tick(now);
    let p = reg.valueVec3(RIDE_TARGET, RIDE_AT, start);
    new FlightPose(p - start, reg.valueQuat(RIDE_TARGET, RIDE_FACING, Quat.angleAxis(restYaw, new Vec3(0., 1., 0.))))
  }
}
