// The vegetation of the cottage scene: red maples and conifers (spruce, fir, white pine: whole-sprig cut-out cards,
// see "The conifers" below), rocks and
// edging stones, hostas, ferns and flowers, each family a few meshes (variants
// grown from seeds) of which many parts are copies, standing where layout.cone
// puts them. The generators are Cone's own packages (weberpenn for the trees,
// noiserock for the rocks, leafrosette for the plants); what this file adds
// is the scene's choices: which species, how many variants, how detailed, in
// which colours, and the textures, all procedural (the surfacepatterns kit's
// bark and granite; the leaves' and the plants' paints are made here).
//
// LEAVES AND CUT-OUT. Render has no alpha-test material yet (another branch is
// adding it), so every leaf is geometry: a maple leaf a blade of 7 to 24
// triangles in the leaf's own outline, drawn from both sides, a pine needle
// spray a thin triangle or two. Moving to cut-out cards later changes only
// weberpenn's foliageMesh (one card a leaf, or a cluster of leaves a card) and
// the leaf material's alpha; the trees, the parts and the layout stay.
//
// A tree is two parts: the bark (the root, which is what moves a tree) and
// its foliage, a child with no placement of its own. The colours of a leaf
// come from the palette image it samples (u: its tone, from its exposure in
// the crown), so one material, with no per-instance tint, shades a whole
// crown. The maples are in autumn colour (the sky's date is another matter):
// the palette's u runs green-yellow, gold, orange, scarlet, so the shaded inner
// and lower leaves stay greenish-yellow and the sunlit outer and top ones are
// scarlet (research: red-maple.md, "Autumn colour"). The pines stay green.
//
// OBJECTS (hydrate): 9 the rocks (they replace the old boulder), 10 the
// specimen maples, 11 the pines, 12 the forest maples, 13 the edging stones,
// 14 the hostas and ferns, 15 the flowers.

pub const ROCKS = 9u32;
pub const SPECIMENS = 10u32;
pub const PINES = 11u32;
pub const FOREST_MAPLES = 12u32;
pub const EDGING = 13u32;
pub const GROUNDCOVER = 14u32;
pub const FLOWERS = 15u32;

pub const SHARED_MAPLE_BARK = 8u32;   // after the cottage's 2-7 (cottage.cone)
pub const SHARED_MAPLE_LEAF = 9u32;

// How long the vegetation's generation took, milliseconds, and what it drew
pub struct VegetationStats {
  pub treeMs f64;
  pub barkMs f64;
  pub rockMs f64;
  pub plantMs f64;
  pub paintMs f64;
  pub treeTriangles u64;      // the variants' own, once each
  pub copies u64;             // parts of every kind
  pub drawnTriangles u64;     // what the scene draws of it, counting every copy
}

fn white() Color { new Color(1., 1., 1., 1.); }

fn byteOf(x f32) u8 { if x <= 0. { 0u8; } elif x >= 255. { 255u8; } else { u8.from(x + 0.5); }; }

// ---- The maps and the paints ----

// A kit tile's colour, normal and ORM maps as a physically based material
// (shared across objects when 'shared' is not 0)
fn vegKitMaterial(h &mut Hydrated, t &mut pbrmaterial.TextureSet, tint Color, shared u32) usize {
  h.addMaterial(Look.physicallyBased(tint, 1., 0.), ctTake(t.size, &mut t.baseColor),
    Maps.images(ctTake(t.size, &mut t.normal), ctTake(t.size, &mut t.orm)), shared);
}

// A leaf palette image (sRGB, w by h): u the tone from the shade to the sun,
// v along the blade (0.08 to 0.68: a darker edge at the base and tip) and, from 0.8, a petiole's red.
fn leafPaint(w i32, h i32, shade Color, sun Color, tinge Color, petiole Color) Image {
  mut px = List[u8].withCapacity(usize.from(w * h * 3));
  mut y = 0;
  while y < h {
    imm v = (f32.from(y) + 0.5) / f32.from(h);
    mut x = 0;
    while x < w {
      imm u = (f32.from(x) + 0.5) / f32.from(w);
      mut r = shade.red + (sun.red - shade.red) * u;
      mut g = shade.green + (sun.green - shade.green) * u;
      mut b = shade.blue + (sun.blue - shade.blue) * u;
      // the brightest sunlit leaves keep a hint of spring's red
      imm hint = if u > 0.8 { (u - 0.8) / 0.2 * 0.35; } else { 0.; };
      r = r + (tinge.red - r) * hint;
      g = g + (tinge.green - g) * hint;
      b = b + (tinge.blue - b) * hint;
      // the blade: darker at the base and the tip, the midribs a touch paler
      imm edge = 0.82 + 0.18 * vsmooth(0.08, 0.2, v) * (1. - vsmooth(0.58, 0.68, v));
      imm rib = 1. + 0.1 * (1. - vsmooth(0.28, 0.4, libc.fabsf(v - 0.36)));
      r = r * edge * rib;
      g = g * edge * rib;
      b = b * edge * rib;
      if v > 0.76 {
        imm k = vsmooth(0.76, 0.84, v);
        r = r + (petiole.red * (0.7 + 0.3 * u) - r) * k;
        g = g + (petiole.green * (0.7 + 0.3 * u) - g) * k;
        b = b + (petiole.blue * (0.7 + 0.3 * u) - b) * k;
      }
      px.push(byteOf(r)); px.push(byteOf(g)); px.push(byteOf(b));
      x = x + 1;
    }
    y = y + 1;
  }
  new Image(w, h, 3, px);
}

fn vsmooth(a f32, b f32, x f32) f32 {
  imm t = if x <= a { 0.; } elif x >= b { 1.; } else { (x - a) / (b - a); };
  t * t * (3. - 2. * t);
}

fn rgbf(r f32, g f32, b f32) Color { new Color(r, g, b, 1.); }

// A hosta or fern blade's paint (w by h): u across the blade (0.5 the midrib) or along a leaflet, v up it
fn bladePaint(w i32, h i32, base Color, tip Color, rib Color, edge Color, veins f32, seed u32) Image {
  mut px = List[u8].withCapacity(usize.from(w * h * 3));
  mut y = 0;
  while y < h {
    imm v = (f32.from(y) + 0.5) / f32.from(h);
    mut x = 0;
    while x < w {
      imm u = (f32.from(x) + 0.5) / f32.from(w);
      imm du = libc.fabsf(u - 0.5);
      mut r = base.red + (tip.red - base.red) * v;
      mut g = base.green + (tip.green - base.green) * v;
      mut b = base.blue + (tip.blue - base.blue) * v;
      // veins: faint diagonal lines running out from the midrib and up
      imm vein = 0.5 + 0.5 * libc.sinf((du * 38. - v * 20. + noise.toUnit(noise.pcg(seed + 3u32)) * 6.) * 2.);
      imm k = 1. - veins * 0.22 * vein;
      r = r * k; g = g * k; b = b * k;
      imm m = 1. - vsmooth(0.012, 0.04, du);
      r = r + (rib.red - r) * m * 0.8;
      g = g + (rib.green - g) * m * 0.8;
      b = b + (rib.blue - b) * m * 0.8;
      imm e = vsmooth(0.40, 0.5, du);
      r = r + (edge.red - r) * e * 0.5;
      g = g + (edge.green - g) * e * 0.5;
      b = b + (edge.blue - b) * e * 0.5;
      px.push(byteOf(r)); px.push(byteOf(g)); px.push(byteOf(b));
      x = x + 1;
    }
    y = y + 1;
  }
  new Image(w, h, 3, px);
}

// A flower palette (4 by 1): a stem, a petal, a centre, a petal's darker base
fn flowerPaint(petal Color, centre Color) Image {
  mut px = List[u8].empty();
  imm cs Array[Color, 4] = [rgbf(70., 120., 52.), petal, centre, rgbf(petal.red * 0.8, petal.green * 0.78, petal.blue * 0.8)];
  mut i = 0usize;
  while i < 4usize {
    imm c = cs[i];
    px.push(byteOf(c.red)); px.push(byteOf(c.green)); px.push(byteOf(c.blue));
    i = i + 1usize;
  }
  new Image(4, 1, 3, px);
}

// How many more meshes than materials the vegetation defines: 36 meshes (two
// specimens' four, six each of the pines' and forest maples', six rocks, four
// edging stones, two hostas, two ferns, six flower clumps) in 13 materials (the
// maples' bark and leaf, the pines', the granite and the edging stone, two
// hostas and two ferns, three flowers)
// (the 23 of the other things, the specimens' and maples' four coarser meshes each, and the conifers': a variant has
// six meshes and a needle material of its own, five more meshes than materials, less the one bark material they all
// share: 38 and 5 a conifer variant in all)
pub fn vegetationMeshSurplus(isl &Island) u64 { if isl.vegetationOff { 0u64; } else { 38u64 + 5u64 * u64.from(PINE_VARIANTS); }; }

// How many parts the layout makes: a tree's two (its bark and its foliage), the rest's one
pub fn vegetationParts(isl &Island) usize {
  imm items = vegetationLayout(isl);
  mut n = 0usize;
  mut i = 0usize;
  while i < items.len() {
    imm k = items[i].kind;
    n = n + (if k == K_SPECIMEN or k == K_PINE or k == K_MAPLE { 2usize; } else { 1usize; });
    i = i + 1usize;
  }
  n;
}

// ---- Item to placement ----

fn itemAt(it &Item, sink f32) Transform3 {
  new Transform3(v(it.x, it.y - sink * it.scale, it.z), Quat.angleAxis(it.yaw, up()), v(it.scale, it.scale, it.scale));
}

fn countKind(items &List[Item], kind u32) usize {
  mut n = 0usize;
  mut i = 0usize;
  while i < items.len() { if items[i].kind == kind { n = n + 1usize; } i = i + 1usize; }
  n;
}

// ---- The trees ----

// Foliage shading (render's PbrMaterial.transmission and .flutter). A maple
// leaf is thin and its autumn colour is saturated, so the sun behind it
// comes through as a glow of that colour; it turns up to about 7 degrees
// about its stem. A pine's needles pass a little light and do not flutter.
const MAPLE_TRANSLUCENCY f32 = 1.2;
const MAPLE_FLUTTER f32 = 0.12;
const CONIFER_TRANSLUCENCY f32 = 0.9;
const CONIFER_SPECULAR f32 = 0.12;
// A floor of light the needles give off, in nits (blue-green): nothing by day (the sun makes them tens of thousands),
// but at night it keeps a far crown a shade lighter than the sky behind it, as sky light would
const CONIFER_SKYGLOW f32 = 0.03;

// What a tree variant is made of: its meshes' indices in the object, and its two coarser levels (LOD 1 and 2)
struct TreeVariant {
  bark usize;
  leaves usize;
  bark1 usize;
  bark2 usize;
  leaves1 usize;
  leaves2 usize;
}

// ---- Levels of detail and ranges (Request.Cull) ----
//
// Every tree, rock, plant and stone is a thing of render's scene (visibility.cone): culled by each camera's
// frustum (and by the depth pyramid), drawn instanced from the visible set. A tree is three meshes of one
// look, LOD 0 the full one (unchanged: close up the picture is the one drawn before), LOD 1 and 2 coarser,
// drawn by the projected size of the tree's bounding sphere (Unreal's "screen size": pixels across, in a view
// as high as the window) and cross-faded by dither between levels. The levels are made from the same grown
// tree, the published way trees are simplified:
//   - bark: the limbs of the finest orders left out, fewer sides and cuts to a segment (Weber and Penn's
//     levels are what a tree is built of, so dropping the last is dropping its twigs);
//   - maple leaves: only every third (LOD 1) or ninth (LOD 2) leaf, each grown to keep the leaf area (times
//     3, so the width times root 3: Boulanger et al. 2006 and SpeedTree's leaf reduction), with fewer outline
//     points;
//   - pine plumes: the limbs' plumes all stay, only every other (LOD 1) or none (LOD 2) of the twigs'
//     plumes remain, and the plumes grow wider to keep the crown's cover.
// A small thing (a stone, a plant, a flower) has one level and a range: not drawn beyond it, the last part of
// it faded out by dither (Godot's visibility ranges), where it is a pixel or two across.

// The ranges (metres) beyond which the small things are not drawn: where they are a pixel or two across (an
// edging stone's 0.4 m is 2 pixels at 140 m in a view 720 pixels high with a 60 degree lens; a plant's 0.8 m
// is 2 at 280 m, but its cover is lost in the ground's grain long before), faded out over the last 30%
const EDGING_RANGE f32 = 140.;
const PLANT_RANGE f32 = 170.;
const FLOWER_RANGE f32 = 110.;

// A tree's levels are used from this many pixels of its sphere's diameter (LOD 0), and this many (LOD 1)
const TREE_LOD0_PX f32 = 240.;
const TREE_LOD1_PX f32 = 80.;

// Keep every 'every'th of the leaf sites
fn thinSites(tree &mut weberpenn.Tree, every usize) {
  mut w = 0usize;
  mut i = 0usize;
  while i < tree.sites.len() {
    if i % every == 0usize {
      if w != i { tree.sites.swap(w, i); }
      w = w + 1usize;
    }
    i = i + 1usize;
  }
  tree.sites.truncate(w);
}

// Keep every 'every'th of the stems of level 'fromLevel' and above (all of the others); 'drop': none of them
fn thinStems(tree &mut weberpenn.Tree, fromLevel i32, every usize, drop bool) {
  mut w = 0usize;
  mut seen = 0usize;
  mut i = 0usize;
  while i < tree.stems.len() {
    mut keep = true;
    if tree.stems[i].level >= fromLevel {
      keep = !drop and seen % every == 0usize;
      seen = seen + 1usize;
    }
    if keep {
      if w != i { tree.stems.swap(w, i); }
      w = w + 1usize;
    }
    i = i + 1usize;
  }
  tree.stems.truncate(w);
}

// A tree's bark with the limbs above 'maxLevel' left out
fn barkLevel(tree &weberpenn.Tree, maxLevel i32, subdivide i32, fat i32, mid i32) mesh.Mesh {
  mut tp = new weberpenn.TubeParams();
  tp.maxLevel = maxLevel;
  tp.subdivide = subdivide;
  tp.fatSides = fat;
  tp.midSides = mid;
  weberpenn.branchMesh(tree, &tp);
}

// Part 'root' (the bark) and part 'crown' (the foliage) of a tree are culled and levelled
fn cullTree(h &mut Hydrated, root usize, crown usize, tv &TreeVariant) {
  mut sizes = List[f32].empty();
  sizes.push(TREE_LOD0_PX);
  sizes.push(TREE_LOD1_PX);
  sizes.push(0.);
  mut barks = List[usize].empty();
  barks.push(tv.bark1);
  barks.push(tv.bark2);
  mut leaves = List[usize].empty();
  leaves.push(tv.leaves1);
  leaves.push(tv.leaves2);
  mut sizes2 = List[f32].empty();
  sizes2.push(TREE_LOD0_PX);
  sizes2.push(TREE_LOD1_PX);
  sizes2.push(0.);
  h.cull(root, barks, sizes, 0., 0.);
  h.cull(crown, leaves, sizes2, 0., 0.);
}

// A small thing: culled, not drawn beyond 'rangeMax' (its edge faded over 'margin')
fn cullSmall(h &mut Hydrated, part usize, rangeMax f32, margin f32) {
  h.cull(part, List[usize].empty(), List[f32].empty(), rangeMax, margin);
}

fn printLevels(what &str, v u32, tris Array[usize, 6]) {
  print <- "    "; printStr(what); print <- " "; print <- v; print <- " levels (bark + foliage): ";
  print <- tris[0usize]; print <- " + "; print <- tris[1usize]; print <- ", ";
  print <- tris[2usize]; print <- " + "; print <- tris[3usize]; print <- ", ";
  print <- tris[4usize]; print <- " + "; print <- tris[5usize]; print <- " triangles\n";
}

const SPECIMEN_SEEDS Array[u32, 2] = [3u32, 2u32];
const SPECIMEN_HEIGHTS Array[f32, 2] = [11., 9.6];
const MAPLE_SEEDS Array[u32, 3] = [31u32, 47u32, 59u32];
const MAPLE_HEIGHTS Array[f32, 3] = [8.6, 9.8, 7.8];

// ---- The conifers: species as data ----
//
// A K_PINE item's variant is one row of these tables: a species (SP_SPRUCE, SP_FIR or SP_PINE: the weberpenn
// tree, its whole-sprig card foliage and the needle paint that go together, 'coniferTree', 'coniferFoliage' and
// 'coniferTuft' below), a seed, a height (the tree's age in effect: its cards are finer on a young one), the
// share of its trunk bare of limbs, and its age from 0 (a sapling's yellow-green) to 1 (a mature tree's
// near-black green: weberpenn's ageTint). Three of each species, mature, middling and young; the layout's own
// scale (0.75 to 1.3) spreads the heights further. A new species is a row in each table.
const SP_SPRUCE = 0;
const SP_FIR = 1;
const SP_PINE = 2;
// (SP_PINE, the white pine, is built and painted by the functions below but is not in the tables: its pad cards read
// patchy and leafy at island distances. Adding it back is its rows here and CONIFER_SPECIES 3.)
const CONIFER_SPECIES = 2;
const CON_SPECIES Array[i32, 6] = [0, 0, 0, 1, 1, 1];
const PINE_SEEDS Array[u32, 6] = [21u32, 22u32, 28u32, 23u32, 24u32, 29u32];
const PINE_HEIGHTS Array[f32, 6] = [15., 10.5, 5.5, 14.5, 9., 5.];
const CON_BARE Array[f32, 6] = [0.3, 0.12, 0.04, 0.28, 0.1, 0.04];
const CON_AGE Array[f32, 6] = [0.85, 0.5, 0.1, 0.8, 0.45, 0.1];

// A conifer's tree: species 'sp', its seed, height, and share of trunk bare
fn coniferTree(sp i32, seed u32, height f32, bare f32) weberpenn.TreeParams {
  if sp == SP_FIR { return weberpenn.firTree(seed, height, bare); }
  if sp == SP_PINE { return weberpenn.whitePineMature(seed, height, bare); }
  weberpenn.spruceTree(seed, height, bare);
}

fn clampUnit(x f32, lo f32, hi f32) f32 { if x < lo { lo; } elif x > hi { hi; } else { x; }; }

// Its foliage at detail 'lod' (0 the full one; 1 and 2 the coarser levels: fewer and broader cards, spaced
// further apart, so the crown keeps its cover)
fn coniferFoliage(sp i32, seed u32, height f32, lod i32) weberpenn.FoliageParams {
  // the cards are finer on a young tree: their size follows its height to the power 0.45
  imm cardScale = clampUnit(libc.powf(height / 20., 0.45), 0.35, 1.);
  mut fp = weberpenn.spruceFoliage(seed + 7u32, cardScale);
  if sp == SP_FIR { fp = weberpenn.firFoliage(seed + 7u32, cardScale); }
  if sp == SP_PINE {
    fp = weberpenn.whitePineFoliage(seed + 7u32, cardScale);
    // a denser crown than the demo's: pads start nearer the trunk, closer together, three to a station
    fp.brStart = 0.2;
    fp.brStep = 0.4;
    fp.brCards = 3;
    fp.brRoll = 55.;
    fp.brWidth = fp.brWidth * 1.15;
  }
  if lod == 1 {
    fp.brStep = fp.brStep * 1.7;
    fp.brLength = fp.brLength * 1.15;
    fp.brWidth = fp.brWidth * 1.2;
  } elif lod >= 2 {
    fp.brStep = fp.brStep * 3.2;
    fp.brCards = 1;
    fp.brLength = fp.brLength * 1.3;
    fp.brWidth = fp.brWidth * 1.5;
  }
  fp;
}

// The needle paint of species 'sp': an RGBA image of its cells
fn coniferTuft(sp i32) Image {
  imm tex = if sp == SP_FIR { surfacepatterns.bakeNeedleTuft(&surfacepatterns.NeedleTuftParams.denseFir(512, 12u32)); }
    elif sp == SP_PINE { surfacepatterns.bakeNeedleTuft(&surfacepatterns.NeedleTuftParams.whitePineCrown(256, 13u32)); }
    else { surfacepatterns.bakeNeedleTuft(&surfacepatterns.NeedleTuftParams.spruce(512, 11u32)); };
  mut px = List[u8].withCapacity(tex.pixels.len());
  mut i = 0usize;
  while i < tex.pixels.len() {
    px.push(*tex.pixels[i]);
    i = i + 1usize;
  }
  new Image(tex.width, tex.height, 4, px);
}

// Autumn: u (exposure, height and the leaf's own noise, as the generator gives it) ramps green-yellow ->
// gold -> orange -> scarlet; the blade's darker base and tip, paler ribs and red petiole as leafPaint's
fn maplePaint() Image {
  imm w = 64;
  imm h = 32;
  // high-chroma pigment colours (sRGB), so they stay brilliant after the light's and the tone map's cut
  imm stops Array[Color, 4] = [rgbf(196., 214., 36.), rgbf(255., 196., 14.), rgbf(255., 112., 8.), rgbf(236., 26., 12.)];
  mut px = List[u8].withCapacity(usize.from(w * h * 3));
  mut y = 0;
  while y < h {
    imm v = (f32.from(y) + 0.5) / f32.from(h);
    mut x = 0;
    while x < w {
      imm u = (f32.from(x) + 0.5) / f32.from(w);
      // (the ramp is warped towards its warm end: most leaves of a crown in October are orange to scarlet)
      imm s = libc.powf(u, 0.75) * 3.;
      imm k = if s >= 3. { 2usize; } else { usize.from(u32.from(s)); };
      imm t = s - f32.from(u32.from(k));
      imm a = stops[k];
      imm c = stops[k + 1usize];
      mut r = a.red + (c.red - a.red) * t;
      mut g = a.green + (c.green - a.green) * t;
      mut b = a.blue + (c.blue - a.blue) * t;
      imm edge = 0.93 + 0.07 * vsmooth(0.08, 0.2, v) * (1. - vsmooth(0.58, 0.68, v));
      imm rib = 1. + 0.06 * (1. - vsmooth(0.28, 0.4, libc.fabsf(v - 0.36)));
      r = r * edge * rib;
      g = g * edge * rib;
      b = b * edge * rib;
      if v > 0.76 {
        imm kk = vsmooth(0.76, 0.84, v);
        r = r + (176. * (0.7 + 0.3 * u) - r) * kk;
        g = g + (60. * (0.7 + 0.3 * u) - g) * kk;
        b = b + (46. * (0.7 + 0.3 * u) - b) * kk;
      }
      px.push(byteOf(r)); px.push(byteOf(g)); px.push(byteOf(b));
      x = x + 1;
    }
    y = y + 1;
  }
  new Image(w, h, 3, px);
}

fn imageCopy(t &Image) Image {
  mut px = List[u8].withCapacity(t.pixels.len());
  mut i = 0usize;
  while i < t.pixels.len() {
    px.push(*t.pixels[i]);
    i = i + 1usize;
  }
  new Image(t.width, t.height, t.channels, px);
}

fn mapleBarkSet() pbrmaterial.TextureSet {
  mut bp = surfacepatterns.BarkParams.redMaple(512, 4101u32);
  surfacepatterns.bakeBark(&bp);
}

fn pineBarkSet() pbrmaterial.TextureSet {
  mut bp = surfacepatterns.BarkParams.pine(512, 4202u32);
  surfacepatterns.bakeBark(&bp);
}

fn mapleBarkMaterial(h &mut Hydrated) usize {
  imm t0 = sdl.GetPerformanceCounter();
  mut tex = bakeSet(&mut h.stats.textures, "maple-bark", 512, 4101u32, () => mapleBarkSet());
  imm m = vegKitMaterial(h, &mut tex, white(), SHARED_MAPLE_BARK);
  h.stats.veg.barkMs = h.stats.veg.barkMs + msBetween(t0, sdl.GetPerformanceCounter());
  m;
}

fn mapleLeafMaterial(h &mut Hydrated) usize {
  imm look = Look.physicallyBased(white(), 0.62, 0.).backlit(MAPLE_TRANSLUCENCY).fluttering(MAPLE_FLUTTER);
  h.addMaterial(look, maplePaint(), Maps.none(), SHARED_MAPLE_LEAF);
}

// The specimens: two full red maples, bark and leaves, each its own meshes
fn hydrateSpecimens(isl &Island, h &mut Hydrated) {
  if isl.vegetationOff { return; }
  imm items = vegetationLayout(isl);
  imm bark = mapleBarkMaterial(h);
  imm leaf = mapleLeafMaterial(h);
  mut tp = new weberpenn.TubeParams();
  tp.maxLevel = 3;
  mut variants = List[TreeVariant].empty();
  mut v = 0u32;
  while v < SPECIMEN_VARIANTS {
    imm t0 = sdl.GetPerformanceCounter();
    mut p = weberpenn.redMaple(SPECIMEN_SEEDS[usize.from(v)], SPECIMEN_HEIGHTS[usize.from(v)]);
    p.leafSites = 5;
    mut tree = weberpenn.grow(&p);
    mut fp = weberpenn.mapleFoliage(900u32 + v);
    fp.leafSize = 0.2;
    fp.sway = true;
    fp.detail = 7;
    imm bm = weberpenn.branchMesh(&tree, &tp);
    imm lm = weberpenn.foliageMesh(&tree, &fp);
    h.stats.veg.treeMs = h.stats.veg.treeMs + msBetween(t0, sdl.GetPerformanceCounter());
    h.stats.veg.treeTriangles = h.stats.veg.treeTriangles + u64.from(bm.triangleCount()) + u64.from(lm.triangleCount());
    print <- "  specimen maple "; print <- v; print <- ": "; print <- tree.stems.len(); print <- " stems, "; print <- tree.sites.len();
    print <- " leaves, "; print <- bm.triangleCount(); print <- " + "; print <- lm.triangleCount(); print <- " triangles, "; print <- tree.height;
    print <- " m tall, "; print <- tree.reach * 2.; print <- " m across\n";
    // The coarser levels: limbs of the finest orders left out, a third and then a ninth of the leaves, each
    // grown to keep the area, the outline of a leaf simpler
    imm bm1 = barkLevel(&tree, 2, 1, 8, 5);
    imm bm2 = barkLevel(&tree, 1, 1, 6, 4);
    thinSites(&mut tree, 3usize);
    fp.leafSize = fp.leafSize * 1.7320508;
    fp.detail = 5;
    imm lm1 = weberpenn.foliageMesh(&tree, &fp);
    thinSites(&mut tree, 3usize);
    fp.leafSize = fp.leafSize * 1.7320508;
    imm lm2 = weberpenn.foliageMesh(&tree, &fp);
    printLevels("specimen maple", v, [bm.triangleCount(), lm.triangleCount(), bm1.triangleCount(), lm1.triangleCount(),
      bm2.triangleCount(), lm2.triangleCount()]);
    imm tv = new TreeVariant(h.addMesh(bm), h.addMesh(lm), h.addMesh(bm1), h.addMesh(bm2), h.addMesh(lm1), h.addMesh(lm2));
    variants.push(tv);
    v = v + 1u32;
  }
  mut i = 0usize;
  while i < items.len() {
    imm it = items[i];
    if it.kind == K_SPECIMEN {
      imm tv = *variants[usize.from(it.variant)];
      imm root = h.part("specimen maple", tv.bark, bark, TOP, itemAt(it, 0.));
      imm crown = h.part("specimen maple leaves", tv.leaves, leaf, root, Transform3.identity());
      cullTree(h, root, crown, &tv);
      h.stats.veg.copies = h.stats.veg.copies + 2u64;
      h.stats.veg.drawnTriangles = h.stats.veg.drawnTriangles + u64.from(h.meshes[tv.bark].triangleCount() + h.meshes[tv.leaves].triangleCount());
    }
    i = i + 1usize;
  }
}

// The forest's maples: lighter trees (three levels, bigger and plainer leaves)
fn hydrateForestMaples(isl &Island, h &mut Hydrated) {
  if isl.vegetationOff { return; }
  imm items = vegetationLayout(isl);
  if countKind(&items, K_MAPLE) == 0usize { return; }
  // the specimens (object 13, sent first) defined these two; naming their keys again reuses them
  imm bark = h.addMaterial(Look.plain(white()), Image.empty(), Maps.none(), SHARED_MAPLE_BARK);
  imm leaf = h.addMaterial(Look.plain(white()), Image.empty(), Maps.none(), SHARED_MAPLE_LEAF);
  mut tp = new weberpenn.TubeParams();
  tp.maxLevel = 2;
  tp.subdivide = 1;
  tp.fatSides = 7;
  tp.midSides = 4;
  mut variants = List[TreeVariant].empty();
  mut v = 0u32;
  while v < MAPLE_VARIANTS {
    imm t0 = sdl.GetPerformanceCounter();
    mut p = weberpenn.redMaple(MAPLE_SEEDS[usize.from(v)], MAPLE_HEIGHTS[usize.from(v)]);
    p.levels = 3;
    p.leafFromLevel = 2;
    p.leafSites = 4;
    mut l2 = p.levelParams[2usize];
    l2.branches = 0.;
    p.levelParams[2usize] = l2;
    mut tree = weberpenn.grow(&p);
    mut fp = weberpenn.mapleFoliage(950u32 + v);
    fp.leafSize = 0.34;
    fp.sway = true;
    fp.detail = 5;
    imm bm = weberpenn.branchMesh(&tree, &tp);
    imm lm = weberpenn.foliageMesh(&tree, &fp);
    h.stats.veg.treeMs = h.stats.veg.treeMs + msBetween(t0, sdl.GetPerformanceCounter());
    h.stats.veg.treeTriangles = h.stats.veg.treeTriangles + u64.from(bm.triangleCount()) + u64.from(lm.triangleCount());
    print <- "  forest maple "; print <- v; print <- ": "; print <- tree.stems.len(); print <- " stems, "; print <- tree.sites.len();
    print <- " leaves, "; print <- bm.triangleCount(); print <- " + "; print <- lm.triangleCount(); print <- " triangles, "; print <- tree.height; print <- " m tall\n";
    // The coarser levels (as for the specimens; the outline is already the simplest)
    imm bm1 = barkLevel(&tree, 1, 1, 6, 4);
    imm bm2 = barkLevel(&tree, 0, 1, 6, 4);
    thinSites(&mut tree, 3usize);
    fp.leafSize = fp.leafSize * 1.7320508;
    imm lm1 = weberpenn.foliageMesh(&tree, &fp);
    thinSites(&mut tree, 3usize);
    fp.leafSize = fp.leafSize * 1.7320508;
    imm lm2 = weberpenn.foliageMesh(&tree, &fp);
    printLevels("forest maple", v, [bm.triangleCount(), lm.triangleCount(), bm1.triangleCount(), lm1.triangleCount(),
      bm2.triangleCount(), lm2.triangleCount()]);
    imm tv = new TreeVariant(h.addMesh(bm), h.addMesh(lm), h.addMesh(bm1), h.addMesh(bm2), h.addMesh(lm1), h.addMesh(lm2));
    variants.push(tv);
    v = v + 1u32;
  }
  mut i = 0usize;
  while i < items.len() {
    imm it = items[i];
    if it.kind == K_MAPLE {
      imm tv = *variants[usize.from(it.variant)];
      imm root = h.part("maple", tv.bark, bark, TOP, itemAt(it, 0.));
      imm crown = h.part("maple leaves", tv.leaves, leaf, root, Transform3.identity());
      cullTree(h, root, crown, &tv);
      h.stats.veg.copies = h.stats.veg.copies + 2u64;
      h.stats.veg.drawnTriangles = h.stats.veg.drawnTriangles + u64.from(h.meshes[tv.bark].triangleCount() + h.meshes[tv.leaves].triangleCount());
    }
    i = i + 1usize;
  }
}

fn hydratePines(isl &Island, h &mut Hydrated) {
  if isl.vegetationOff { return; }
  imm items = vegetationLayout(isl);
  imm t00 = sdl.GetPerformanceCounter();
  mut tex = bakeSet(&mut h.stats.textures, "pine-bark", 512, 4202u32, () => pineBarkSet());
  // the kit's pine bark is warm red-brown; an old white pine's is greyer
  imm bark = vegKitMaterial(h, &mut tex, srgb(176., 164., 156.), 0u32);
  h.stats.veg.barkMs = h.stats.veg.barkMs + msBetween(t00, sdl.GetPerformanceCounter());
  // The needle paint of each species, painted once; each variant's material is the paint under its age's tint
  // (the colour of a material multiplies its paint: a sapling's bright yellow-green to an old tree's near black)
  imm t01 = sdl.GetPerformanceCounter();
  mut paints = List[Image].empty();
  mut sp = 0;
  while sp < CONIFER_SPECIES {
    paints.push(coniferTuft(sp));
    sp = sp + 1;
  }
  h.stats.veg.paintMs = h.stats.veg.paintMs + msBetween(t01, sdl.GetPerformanceCounter());
  mut tp = new weberpenn.TubeParams();
  tp.maxLevel = 1;
  tp.subdivide = 1;
  tp.fatSides = 7;
  tp.midSides = 4;
  mut variants = List[TreeVariant].empty();
  mut needleMats = List[usize].empty();
  mut v = 0u32;
  while v < PINE_VARIANTS {
    imm t0 = sdl.GetPerformanceCounter();
    imm vi = usize.from(v);
    imm species = CON_SPECIES[vi];
    imm p = coniferTree(species, PINE_SEEDS[vi], PINE_HEIGHTS[vi], CON_BARE[vi]);
    imm tree = weberpenn.grow(&p);
    imm fp0 = coniferFoliage(species, PINE_SEEDS[vi], PINE_HEIGHTS[vi], 0);
    imm bm = weberpenn.branchMesh(&tree, &tp);
    imm lm = weberpenn.foliageMesh(&tree, &fp0);
    h.stats.veg.treeMs = h.stats.veg.treeMs + msBetween(t0, sdl.GetPerformanceCounter());
    h.stats.veg.treeTriangles = h.stats.veg.treeTriangles + u64.from(bm.triangleCount()) + u64.from(lm.triangleCount());
    print <- "  conifer "; print <- v; print <- " (species "; print <- species; print <- "): "; print <- tree.stems.len(); print <- " stems, ";
    print <- bm.triangleCount(); print <- " + "; print <- lm.triangleCount(); print <- " triangles, "; print <- tree.height; print <- " m tall\n";
    // The coarser levels: the trunk and limbs with fewer sides and then the trunk alone; the cards fewer and broader
    imm bm1 = barkLevel(&tree, 1, 1, 6, 4);
    imm bm2 = barkLevel(&tree, 0, 1, 6, 4);
    imm lm1 = weberpenn.foliageMesh(&tree, &coniferFoliage(species, PINE_SEEDS[vi], PINE_HEIGHTS[vi], 1));
    imm lm2 = weberpenn.foliageMesh(&tree, &coniferFoliage(species, PINE_SEEDS[vi], PINE_HEIGHTS[vi], 2));
    printLevels("conifer", v, [bm.triangleCount(), lm.triangleCount(), bm1.triangleCount(), lm1.triangleCount(),
      bm2.triangleCount(), lm2.triangleCount()]);
    imm tv = new TreeVariant(h.addMesh(bm), h.addMesh(lm), h.addMesh(bm1), h.addMesh(bm2), h.addMesh(lm1), h.addMesh(lm2));
    variants.push(tv);
    imm tint = weberpenn.ageTint(CON_AGE[vi], 1., PINE_SEEDS[vi]);
    needleMats.push(h.addMaterial(Look.physicallyBased(tint, 0.75, 0.).backlit(CONIFER_TRANSLUCENCY).matte(CONIFER_SPECULAR).glowing(new Color(0.25, 0.4, 0.5, 1.), CONIFER_SKYGLOW).cutOut(0.5),
      imageCopy(&*paints[usize.from(species)]), Maps.none(), 0u32));
    v = v + 1u32;
  }
  mut i = 0usize;
  while i < items.len() {
    imm it = items[i];
    if it.kind == K_PINE {
      imm tv = *variants[usize.from(it.variant)];
      imm root = h.part("pine", tv.bark, bark, TOP, itemAt(it, 0.));
      imm crown = h.part("pine needles", tv.leaves, *needleMats[usize.from(it.variant)], root, Transform3.identity());
      cullTree(h, root, crown, &tv);
      h.stats.veg.copies = h.stats.veg.copies + 2u64;
      h.stats.veg.drawnTriangles = h.stats.veg.drawnTriangles + u64.from(h.meshes[tv.bark].triangleCount() + h.meshes[tv.leaves].triangleCount());
    }
    i = i + 1usize;
  }
}

// ---- The rocks ----

fn graniteMaterial(h &mut Hydrated, seed u32, warm bool) usize {
  imm t0 = sdl.GetPerformanceCounter();
  mut tex = bakeSet(&mut h.stats.textures, if warm { "granite-warm"; } else { "granite"; }, 512, seed, () => graniteSet(seed, warm));
  imm m = vegKitMaterial(h, &mut tex, white(), 0u32);
  h.stats.veg.paintMs = h.stats.veg.paintMs + msBetween(t0, sdl.GetPerformanceCounter());
  m;
}

// The baked granite of the rocks (or, 'warm', of the edging stones)
fn graniteSet(seed u32, warm bool) pbrmaterial.TextureSet {
  mut rp = surfacepatterns.RockParams.granite(512, seed);
  if warm {
    // the edging stones' field-stone colours
    rp.colorA = srgb(148., 142., 130.);
    rp.colorB = srgb(92., 84., 76.);
    rp.lichenAmount = 0.4;
  }
  surfacepatterns.bakeRock(&rp);
}

// The family: a boulder's three proportions (squat, tall, long), each with two seeds
pub fn rockVariant(v u32) mesh.Mesh {
  mut p = new noiserock.RockParams();
  p.seed = 500u32 + v * 17u32;
  imm kind = v % 3u32;
  if kind == 0u32 { p.width = 0.5; p.height = 0.3; p.depth = 0.42; p.facets = 10; p.facetDepth = 0.7; p.bumpAmp = 0.12; }
  elif kind == 1u32 { p.width = 0.34; p.height = 0.55; p.depth = 0.32; p.facets = 8; p.facetDepth = 0.66; p.bumpAmp = 0.1; }
  else { p.width = 0.62; p.height = 0.32; p.depth = 0.3; p.facets = 9; p.facetDepth = 0.68; p.bumpAmp = 0.16; }
  p.rings = 9;
  p.slices = 14;
  noiserock.rockMesh(&p);
}

fn edgingVariant(v u32) mesh.Mesh {
  mut p = new noiserock.RockParams();
  p.seed = 800u32 + v * 13u32;
  p.width = 0.12 + 0.025 * f32.from(v % 2u32);
  p.height = 0.075;
  p.depth = 0.1 + 0.03 * f32.from(v / 2u32);
  p.facets = 4;
  p.facetDepth = 0.9;
  p.bumpAmp = 0.12;
  p.flatBase = 0.45;
  p.rings = 6;
  p.slices = 10;
  p.smooth = true;
  p.tileMetres = 1.5;
  noiserock.rockMesh(&p);
}

// How far into the ground a rock (an edging stone) is set: a third of its height
const ROCK_SINK f32 = 0.1;
const EDGING_SINK f32 = 0.025;

fn hydrateRocks(isl &Island, h &mut Hydrated) {
  if isl.vegetationOff { return; }
  imm items = vegetationLayout(isl);
  imm granite = graniteMaterial(h, 6101u32, false);
  imm t0 = sdl.GetPerformanceCounter();
  mut meshes = List[usize].empty();
  mut tris = 0u64;
  mut v = 0u32;
  while v < ROCK_VARIANTS {
    imm m = rockVariant(v);
    tris = tris + u64.from(m.triangleCount());
    meshes.push(h.addMesh(m));
    v = v + 1u32;
  }
  h.stats.veg.rockMs = h.stats.veg.rockMs + msBetween(t0, sdl.GetPerformanceCounter());
  mut i = 0usize;
  while i < items.len() {
    imm it = items[i];
    if it.kind == K_ROCK {
      imm rp = h.part("rock", *meshes[usize.from(it.variant)], granite, TOP, itemAt(it, ROCK_SINK * 2.));
      cullSmall(h, rp, 0., 0.);
      h.stats.veg.copies = h.stats.veg.copies + 1u64;
      h.stats.veg.drawnTriangles = h.stats.veg.drawnTriangles + tris / u64.from(ROCK_VARIANTS);
    }
    i = i + 1usize;
  }
}

fn hydrateEdging(isl &Island, h &mut Hydrated) {
  if isl.vegetationOff { return; }
  imm items = vegetationLayout(isl);
  imm stone = graniteMaterial(h, 6202u32, true);
  imm t0 = sdl.GetPerformanceCounter();
  mut meshes = List[usize].empty();
  mut tris = 0u64;
  mut v = 0u32;
  while v < EDGING_VARIANTS {
    imm m = edgingVariant(v);
    tris = tris + u64.from(m.triangleCount());
    meshes.push(h.addMesh(m));
    v = v + 1u32;
  }
  h.stats.veg.rockMs = h.stats.veg.rockMs + msBetween(t0, sdl.GetPerformanceCounter());
  mut i = 0usize;
  while i < items.len() {
    imm it = items[i];
    if it.kind == K_EDGING {
      // a low stone, about 0.1 m tall at scale 1, sunk a quarter of that into the ground
      imm ep = h.part("edging stone", *meshes[usize.from(it.variant)], stone, TOP, itemAt(it, EDGING_SINK));
      cullSmall(h, ep, EDGING_RANGE, EDGING_RANGE * 0.3);
      h.stats.veg.copies = h.stats.veg.copies + 1u64;
      h.stats.veg.drawnTriangles = h.stats.veg.drawnTriangles + tris / u64.from(EDGING_VARIANTS);
    }
    i = i + 1usize;
  }
}

// ---- Hostas, ferns and flowers ----

fn hydrateGroundcover(isl &Island, h &mut Hydrated) {
  if isl.vegetationOff { return; }
  imm items = vegetationLayout(isl);
  imm t0 = sdl.GetPerformanceCounter();
  // two hostas: a blue-grey one and a yellow-green one; two ferns
  imm hostaA = h.addMaterial(Look.physicallyBased(white(), 0.6, 0.),
    bladePaint(48, 48, rgbf(46., 88., 68.), rgbf(66., 112., 84.), rgbf(120., 160., 124.), rgbf(88., 124., 92.), 1., 3u32), Maps.none(), 0u32);
  imm hostaB = h.addMaterial(Look.physicallyBased(white(), 0.6, 0.),
    bladePaint(48, 48, rgbf(62., 104., 38.), rgbf(98., 140., 48.), rgbf(150., 180., 96.), rgbf(120., 148., 60.), 1., 9u32), Maps.none(), 0u32);
  imm fernA = h.addMaterial(Look.physicallyBased(white(), 0.65, 0.),
    bladePaint(16, 32, rgbf(48., 96., 36.), rgbf(86., 134., 54.), rgbf(48., 96., 36.), rgbf(48., 96., 36.), 0., 5u32), Maps.none(), 0u32);
  imm fernB = h.addMaterial(Look.physicallyBased(white(), 0.65, 0.),
    bladePaint(16, 32, rgbf(62., 110., 40.), rgbf(104., 148., 60.), rgbf(62., 110., 40.), rgbf(62., 110., 40.), 0., 7u32), Maps.none(), 0u32);
  h.stats.veg.paintMs = h.stats.veg.paintMs + msBetween(t0, sdl.GetPerformanceCounter());
  imm t1 = sdl.GetPerformanceCounter();
  mut hostaMeshes = List[usize].empty();
  mut fernMeshes = List[usize].empty();
  mut hostaTris = 0u64;
  mut fernTris = 0u64;
  mut v = 0u32;
  while v < HOSTA_VARIANTS {
    mut p = new leafrosette.HostaParams();
    p.seed = 40u32 + v * 7u32;
    imm m = leafrosette.hostaMesh(&p);
    hostaTris = hostaTris + u64.from(m.triangleCount());
    hostaMeshes.push(h.addMesh(m));
    v = v + 1u32;
  }
  v = 0u32;
  while v < FERN_VARIANTS {
    mut p = new leafrosette.FernParams();
    p.seed = 60u32 + v * 11u32;
    imm m = leafrosette.fernMesh(&p);
    fernTris = fernTris + u64.from(m.triangleCount());
    fernMeshes.push(h.addMesh(m));
    v = v + 1u32;
  }
  h.stats.veg.plantMs = h.stats.veg.plantMs + msBetween(t1, sdl.GetPerformanceCounter());
  mut i = 0usize;
  while i < items.len() {
    imm it = items[i];
    if it.kind == K_HOSTA {
      imm mat = if it.variant == 0u32 { hostaA; } else { hostaB; };
      imm hp = h.part("hosta", *hostaMeshes[usize.from(it.variant)], mat, TOP, itemAt(it, 0.));
      cullSmall(h, hp, PLANT_RANGE, PLANT_RANGE * 0.3);
      h.stats.veg.copies = h.stats.veg.copies + 1u64;
      h.stats.veg.drawnTriangles = h.stats.veg.drawnTriangles + hostaTris / u64.from(HOSTA_VARIANTS);
    } elif it.kind == K_FERN {
      imm mat = if it.variant == 0u32 { fernA; } else { fernB; };
      imm fp = h.part("fern", *fernMeshes[usize.from(it.variant)], mat, TOP, itemAt(it, 0.));
      cullSmall(h, fp, PLANT_RANGE, PLANT_RANGE * 0.3);
      h.stats.veg.copies = h.stats.veg.copies + 1u64;
      h.stats.veg.drawnTriangles = h.stats.veg.drawnTriangles + fernTris / u64.from(FERN_VARIANTS);
    }
    i = i + 1usize;
  }
}

fn hydrateFlowers(isl &Island, h &mut Hydrated) {
  if isl.vegetationOff { return; }
  imm items = vegetationLayout(isl);
  imm t0 = sdl.GetPerformanceCounter();
  // three colours: buttercup yellow, white, violet
  imm petals Array[Color, 3] = [rgbf(240., 206., 64.), rgbf(238., 238., 228.), rgbf(142., 106., 196.)];
  imm centres Array[Color, 3] = [rgbf(176., 120., 40.), rgbf(224., 186., 60.), rgbf(236., 214., 96.)];
  mut mats = List[usize].empty();
  mut c = 0usize;
  while c < 3usize {
    mats.push(h.addMaterial(Look.physicallyBased(white(), 0.7, 0.), flowerPaint(petals[c], centres[c]), Maps.none(), 0u32));
    c = c + 1usize;
  }
  mut meshes = List[usize].empty();
  mut tris = 0u64;
  mut v = 0u32;
  while v < FLOWER_VARIANTS {
    mut p = new leafrosette.FlowerParams();
    p.seed = 80u32 + v * 5u32;
    p.flowers = 4 + i32.from(v % 2u32) * 3;
    p.height = 0.38;
    p.head = 0.036;
    p.spread = 0.16;
    imm m = leafrosette.flowerClumpMesh(&p);
    tris = tris + u64.from(m.triangleCount());
    meshes.push(h.addMesh(m));
    v = v + 1u32;
  }
  h.stats.veg.plantMs = h.stats.veg.plantMs + msBetween(t0, sdl.GetPerformanceCounter());
  mut i = 0usize;
  while i < items.len() {
    imm it = items[i];
    if it.kind == K_FLOWER {
      imm fl = h.part("flowers", *meshes[usize.from(it.variant)], *mats[usize.from(it.variant / 2u32)], TOP, itemAt(it, 0.));
      cullSmall(h, fl, FLOWER_RANGE, FLOWER_RANGE * 0.3);
      h.stats.veg.copies = h.stats.veg.copies + 1u64;
      h.stats.veg.drawnTriangles = h.stats.veg.drawnTriangles + tris / u64.from(FLOWER_VARIANTS);
    }
    i = i + 1usize;
  }
}
