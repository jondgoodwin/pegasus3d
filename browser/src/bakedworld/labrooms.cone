// The labyrinth's plan: Minoan rooms 300 m under the island, built from labgeo.cone's kit.
//
//   x -46 .. 76, z 299 .. 434 in the island's world; the floor of the antechamber at y = -300 (LAB_Y).
//   +z is south, as everywhere in this world: the rooms lie to the south of the entry point E.
//
//     z 300   ANTECHAMBER   x -10..10, 20 x 20, 5.5 high: red columns, a light well, dolphins, Akrotiri's rosette band;
//                           E = (0, -300, 300) on its south wall, facing +z. Door north at x = 0.
//     z 321   HALL OF TWO DOORS   x -14..14, z 321..341: lilies, a guard plinth beside each door. Door west (x = -8):
//                           the Worm's chamber (x -14..-2, z 342..358, a dead end). Door east (x = +8): the corridor.
//     z 342   THE CORRIDOR   x 6.4..9.6, z 342..372, 3.4 high, 3.2 wide: a column pair every 6 m (the pattern's period, so a
//                           loop joined end to start shows no seam). It ends in the court's wall (x = 8).
//     z 373   THE BULL COURT   x -20..40, z 373..433, 12 high: a colonnade of 5.6 m columns round it, eight square pillars on a
//                           ring of 21 m about its middle (10, 403), a light well over the middle, 30 m of open floor to charge in.
//                           Door west (z = 403) to the throne room, door east (z = 392) to the stair.
//     x -45   THRONE ROOM   x -45..-21, z 391..415, 7 high: red walls, griffins, a gypsum throne against the west wall with
//                           cloth banners, benches along both side walls, a stone basin.
//     x 41    THE GRAND STAIRCASE   x 41..75, z 380..430, 16 high: a flight east (35 treads of 0.6 x 0.16, 5.6 m up), a landing,
//                           a flight south (the same again), a top landing at y = -288.8 and, in the south wall at x = 67, the doorway
//                           for the exit portal (LAB_EXIT), with an alcove behind it.
//
// Every wall is a slab 1 m thick, its two halves each in the material of the room it faces; each doorway has a black
// timber lintel and, between the rooms, jambs of Knossos's rosette chain.

pub const LAB_Y f32 = LAB_FLOOR;      // (parts/portal.cone's: the portals are made from the same numbers)
// (Whether a height is the labyrinth's, not the island's, is parts/portal.cone's underground(): below UNDER_Y = -150, well below the
// island's sea floor and seabed, the world's lowest being about -60. The one test for light, layer, ground and navigation.)
// Falling past this is falling out of the labyrinth
pub const LAB_VOID f32 = -330.;

// The entry point E, on the antechamber's south wall facing +z; the antechamber's middle
pub const LAB_E_X f32 = E_X;
pub const LAB_E_Z f32 = E_Z;
// The hall's guards' places (beside each door, on their plinths), and the doors' middles along x
pub const LAB_GUARD_LEFT_X f32 = -5.2;
pub const LAB_GUARD_RIGHT_X f32 = 5.2;
pub const LAB_GUARD_Z f32 = 338.8;
pub const LAB_DOOR_LEFT_X f32 = -8.;
pub const LAB_DOOR_RIGHT_X f32 = 8.;
pub const LAB_HALL_NORTH_Z f32 = 341.5;     // the hall's north wall's middle (z)
// The Worm's chamber's middle
pub const LAB_WORM_X f32 = -8.;
pub const LAB_WORM_Z f32 = 351.;
// The corridor: its middle along x, and from z0 (the hall end) to z1 (the court end)
pub const LAB_CORR_X f32 = LOOP_X;       // (the corridor that will not end: parts/portal.cone's LOOP_..., its gate and bays)
pub const LAB_CORR_Z0 f32 = LOOP_Z0;
pub const LAB_CORR_Z1 f32 = LOOP_Z1;
// The court's middle, and the charge's open floor's half width
pub const LAB_COURT_X f32 = 10.;
pub const LAB_COURT_Z f32 = 403.;
// The throne's seat
pub const LAB_THRONE_X f32 = -44.2;
pub const LAB_THRONE_Z f32 = 403.;
// The exit: the doorway at the top of the staircase, its floor 11.2 m over the labyrinth's, the portal plane just in the wall (z), facing -z
pub const LAB_EXIT_X f32 = EXIT_X;
pub const LAB_EXIT_Z f32 = EXIT_Z;
pub const LAB_EXIT_UP f32 = EXIT_UP;
// The staircase's top landing, where the walk from E ends (x, z)
pub const LAB_STAIR_TOP_X f32 = 67.;
pub const LAB_STAIR_TOP_Z f32 = 427.;

fn ds1(a LabDoor) List[LabDoor] { var l = List[LabDoor].empty(); l.push(a); l; }
fn ds0() List[LabDoor] { List[LabDoor].empty(); }

// A hanging lamp: a small bronze bowl with a flame on a rod from the ceiling
fn lgHangLamp(g &mut LabGeo, x f32, yTop f32, z f32, candela f32, range f32) {
  let y = yTop - 0.7;
  if g.want {
    var bowl = List[Vec2].empty();
    bowl.push(pt(0.0, 0.0)); bowl.push(pt(0.06, 0.0)); bowl.push(pt(0.16, 0.08)); bowl.push(pt(0.2, 0.2)); bowl.push(pt(0.17, 0.2)); bowl.push(pt(0.0, 0.13));
    lgLathe(&mut g.meshes[LM_BRONZE], &bowl, 12, x, y, z, 1.);
    var flame = List[Vec2].empty();
    flame.push(pt(0.0, 0.13)); flame.push(pt(0.12, 0.13)); flame.push(pt(0.08, 0.3)); flame.push(pt(0.0, 0.42));
    lgLathe(&mut g.meshes[LM_FLAME], &flame, 8, x, y, z, 1.);
    lgBox(g, LM_BLACK, false, x - 0.015, x + 0.015, y + 0.2, yTop, z - 0.015, z + 0.015, 1.);
  }
  var look = LightLook.point(new Vec3(0., 0., 0.), new Color(1., 0.55, 0.22, 1.), candela, range);
  look.radius = 0.1;
  g.lamps.push(new LabLamp(new Vec3(x, y + 0.45, z), look));
}

// A guard's plinth: a low block of gypsum (low enough to step on)
fn lgPlinth(g &mut LabGeo, x f32, z f32) {
  lgBox(g, LM_GYPSUM, true, x - 0.6, x + 0.6, LAB_Y, LAB_Y + 0.22, z - 0.6, z + 0.6, 1.8);
  g.top(x - 0.6, z - 0.6, x + 0.6, z + 0.6, LAB_Y + 0.22);
}

// A low wall or block that is solid and not walked on: a rail, a bench
fn lgRail(g &mut LabGeo, x0 f32, x1 f32, y0 f32, y1 f32, z0 f32, z1 f32) {
  lgBox(g, LM_GYPSUM, true, x0, x1, y0, y1, z0, z1, 1.8);
  g.boxes.push(new Vec4(x0, z0, x1, z1));
}

// The throne: a gypsum seat on a plinth with a tall wavy back against the west wall (x = -45), its seat at x = LAB_THRONE_X
fn lgThrone(g &mut LabGeo) {
  let f = LAB_Y;
  let z0 = LAB_THRONE_Z - 1.;
  let z1 = LAB_THRONE_Z + 1.;
  lgBox(g, LM_GYPSUM, true, -45., -43.2, f, f + 0.3, z0 - 0.5, z1 + 0.5, 1.8);
  lgBox(g, LM_GYPSUM, true, -44.9, -43.7, f + 0.3, f + 0.95, z0, z1, 1.8);
  // the back: slices of differing heights, its top a wave (the back of the Knossos throne)
  var k = 0;
  while k < 8 {
    let za = z0 + 2. * f32.from(k) / 8.;
    let zb = z0 + 2. * f32.from(k + 1) / 8.;
    let hgt = 2.05 + 0.3 * libc.sinf(f32.from(k) * 1.1) + 0.12 * libc.sinf(f32.from(k) * 2.9);
    lgBox(g, LM_GYPSUM, k == 0, -45., -44.55, f + 0.95, f + hgt, za, zb, 1.8);
    k = k + 1;
  }
  // the arm blocks
  lgBox(g, LM_GYPSUM, false, -44.9, -43.7, f + 0.95, f + 1.15, z0 - 0.02, z0 + 0.12, 1.8);
  lgBox(g, LM_GYPSUM, false, -44.9, -43.7, f + 0.95, f + 1.15, z1 - 0.12, z1 + 0.02, 1.8);
  g.solids.push(Solid.box(-45., z0, -44.55, z1, f, f + 2.4));
  g.boxes.push(new Vec4(-45., z0 - 0.5, -43.2, z1 + 0.5));
}

// A stone basin, shallow: a lathed bowl of gypsum at (x, z)
fn lgBasin(g &mut LabGeo, x f32, z f32) {
  if g.want {
    var bowl = List[Vec2].empty();
    bowl.push(pt(0.0, 0.0)); bowl.push(pt(0.5, 0.0)); bowl.push(pt(0.85, 0.12)); bowl.push(pt(1.0, 0.3)); bowl.push(pt(1.0, 0.4)); bowl.push(pt(0.9, 0.4));
    bowl.push(pt(0.8, 0.3)); bowl.push(pt(0.55, 0.2)); bowl.push(pt(0.0, 0.18));
    lgLathe(&mut g.meshes[LM_GYPSUM], &bowl, 24, x, LAB_Y, z, 1.);
  }
  g.solids.push(Solid.circle(x, z, 0.95, LAB_Y - 0.5, LAB_Y + 0.4));
  g.circles.push(new Vec3(x, z, 0.95));
}

// The plan
pub fn labBuild(g &mut LabGeo) {
  let f = LAB_Y;
  let none = ds0();
  let antN = ds1(dr(0., 4., 3.6));
  // E's doorway in the antechamber's south wall: 1 m wide, the entrance corridor's height (parts/portal.cone's contract)
  let antS = ds1(dr(E_X, 2. * PANE_HALF, CORR_HEIGHT));
  let courtN = ds1(dr(8., 3.2, 3.4));
  let courtW = ds1(dr(403., 5., 5.));
  let courtE = ds1(dr(392., 6., 5.5));
  let exitD = ds1(dr(LAB_EXIT_X, 4., 14.6));
  // ---- the entrance: the corridor from the looking-glass's mouth (z = MOUTH_Z) to E's doorway, x -1.5..1.5, z 285..299, 2.5 high.
  // A pane at the mouth (labyrinth.cone) is the way back to the island; the dead end behind it (z 285..286) is where the camera of a
  // being just through sits. The sill under the pane and the lintel over it are not solid: a being goes through the pane ----
  lgFloor(g, 0. - CORR_HALF, CORR_HALF, TAIL_Z - 1., 299., f);
  lgWall(g, false, -1.5, 0. - CORR_HALF, TAIL_Z - 1., 299., f, f + CORR_HEIGHT, &none, LM_ASHLAR, LM_PLASTER_RED, false);
  lgWall(g, false, CORR_HALF, 1.5, TAIL_Z - 1., 299., f, f + CORR_HEIGHT, &none, LM_PLASTER_RED, LM_ASHLAR, false);
  lgWall(g, true, TAIL_Z - 1., TAIL_Z, -1.5, 1.5, f, f + CORR_HEIGHT, &none, LM_ASHLAR, LM_PLASTER_RED, false);
  lgCeiling(g, -1.5, 1.5, TAIL_Z - 1., 299., f + CORR_HEIGHT, 0., 0., 0.);
  lgBox(g, LM_BLACK, false, 0. - CORR_HALF, CORR_HALF, f, f + PANE_LOW, MOUTH_Z, MOUTH_Z + 0.15, 1.);
  lgBox(g, LM_BLACK, false, 0. - CORR_HALF, CORR_HALF, f + PANE_HIGH, f + CORR_HEIGHT, MOUTH_Z, MOUTH_Z + 0.15, 1.);
  let bandsEntrance = ds0();
  lgBand(g, BAND_A, false, 0. - CORR_HALF, 1., TAIL_Z, 299., f + 1.95, 0.5, &bandsEntrance, f);
  lgBand(g, BAND_A, false, CORR_HALF, -1., TAIL_Z, 299., f + 1.95, 0.5, &bandsEntrance, f);
  // (its light: two lamps set in the ceiling, warm, of short reach)
  var lampLook = LightLook.point(new Vec3(0., 0., 0.), new Color(1., 0.55, 0.22, 1.), 900., 7.);
  lampLook.radius = 0.1;
  g.lamps.push(new LabLamp(new Vec3(E_X, f + 2.2, 289.), lampLook));
  g.lamps.push(new LabLamp(new Vec3(E_X, f + 2.2, 295.), lampLook));

  // ---- the antechamber: x -10..10, z 300..320, 5.5 high ----
  lgFloor(g, -10., 10., 300., 320., f);
  lgWall(g, true, 299., 300., -11., 11., f, f + 5.5, &antS, LM_ASHLAR, LM_PLASTER_OCHRE, false);
  lgWall(g, false, -11., -10., 299., 321., f, f + 5.5, &none, LM_ASHLAR, LM_PLASTER_OCHRE, false);
  lgWall(g, false, 10., 11., 299., 321., f, f + 5.5, &none, LM_PLASTER_OCHRE, LM_ASHLAR, false);
  lgWall(g, true, 320., 321., -15., 15., f, f + 5.5, &antN, LM_PLASTER_OCHRE, LM_PLASTER_CREAM, true);
  lgCeiling(g, -10., 10., 300., 320., f + 5.5, 0., 310., 2.);
  lgLightWell(g, 0., 310., 2., f + 5.5, 4., 14000., 26.);
  let bandsHere = ds0();
  lgBand(g, BAND_A, true, 300., 1., -10., 10., f + 4.5, 1., &bandsHere, f);
  lgBand(g, BAND_A, true, 320., -1., -10., 10., f + 4.5, 1., &bandsHere, f);
  lgBand(g, BAND_A, false, -10., 1., 300., 320., f + 4.5, 1., &bandsHere, f);
  lgBand(g, BAND_A, false, 10., -1., 300., 320., f + 4.5, 1., &bandsHere, f);
  lgPanel(g, LM_DOLPHIN, false, -10., 1., 310., f + 1.5, 1.4);
  lgPanel(g, LM_DOLPHIN, false, 10., -1., 310., f + 1.5, 1.4);
  lgColumn(g, -5.5, f, 305., 1.);
  lgColumn(g, 5.5, f, 305., 1.);
  lgColumn(g, -5.5, f, 315., 1.);
  lgColumn(g, 5.5, f, 315., 1.);
  lgBrazier(g, -4.5, f, 302., 1., 6500.);
  lgBrazier(g, 4.5, f, 302., 1., 6500.);
  lgBrazier(g, -8., f, 318., 1., 6500.);
  lgBrazier(g, 8., f, 318., 1., 6500.);

  // ---- the hall of two doors: x -14..14, z 321..341 ----
  lgFloor(g, -14., 14., 321., 341., f);
  lgWall(g, false, -15., -14., 321., 342., f, f + 5.5, &none, LM_ASHLAR, LM_PLASTER_CREAM, false);
  lgWall(g, false, 14., 15., 321., 342., f, f + 5.5, &none, LM_PLASTER_CREAM, LM_ASHLAR, false);
  var hallN = List[LabDoor].empty();
  hallN.push(dr(-8., 3.2, 3.4));
  hallN.push(dr(8., 3.2, 3.4));
  lgWall(g, true, 341., 342., -15., 15., f, f + 5.5, &hallN, LM_PLASTER_CREAM, LM_PLASTER_RED, true);
  lgCeiling(g, -14., 14., 321., 341., f + 5.5, 0., 0., 0.);
  lgBand(g, BAND_A, true, 321., 1., -14., 14., f + 4.5, 1., &bandsHere, f);
  lgBand(g, BAND_A, true, 341., -1., -14., 14., f + 4.5, 1., &bandsHere, f);
  lgBand(g, BAND_A, false, -14., 1., 321., 341., f + 4.5, 1., &bandsHere, f);
  lgBand(g, BAND_A, false, 14., -1., 321., 341., f + 4.5, 1., &bandsHere, f);
  lgBand(g, BAND_C, true, 321., 1., -14., 14., f + 0.9, 0.7, &bandsHere, f);
  lgPanel(g, LM_LILY, true, 321., 1., -7., f + 1.5, 1.3);
  lgPanel(g, LM_LILY, true, 321., 1., 7., f + 1.5, 1.3);
  lgPanel(g, LM_LILY, true, 341., -1., 0., f + 1.5, 1.3);
  var k = 0;
  while k < 3 {
    let zz = 325. + 6. * f32.from(k);
    lgColumn(g, -11., f, zz, 1.);
    lgColumn(g, 11., f, zz, 1.);
    k = k + 1;
  }
  lgPlinth(g, LAB_GUARD_LEFT_X, LAB_GUARD_Z);
  lgPlinth(g, LAB_GUARD_RIGHT_X, LAB_GUARD_Z);
  lgBrazier(g, -12.5, f, 323., 1., 6500.);
  lgBrazier(g, 12.5, f, 323., 1., 6500.);
  lgBrazier(g, -3., f, 339., 1., 5500.);
  lgBrazier(g, 3., f, 339., 1., 5500.);
  // the crystal ball, Jareth's: a clear ball hovering a hand's breadth over a gypsum drum in the middle of the hall, in line with the
  // doorway from the antechamber, the braziers' flames and the columns turned over in it
  lgPedestal(g, 0., f, 331., 1.0);
  if g.want { lgGlass(g, "crystal ball", gwBall(0.2), gwCrystal(), new Vec3(0., f + 1.0 + 0.2 + 0.1, 331.)); }

  // ---- the worm's chamber: x -14..-2, z 342..358, 4.2 high ----
  lgFloor(g, -14., -2., 342., 358., f);
  lgWall(g, false, -15., -14., 342., 359., f, f + 4.2, &none, LM_ASHLAR, LM_ASHLAR, false);
  lgWall(g, false, -2., -1., 342., 359., f, f + 4.2, &none, LM_ASHLAR, LM_ASHLAR, false);
  lgWall(g, true, 358., 359., -15., -1., f, f + 4.2, &none, LM_ASHLAR, LM_ASHLAR, false);
  lgCeiling(g, -14., -2., 342., 358., f + 4.2, 0., 0., 0.);
  lgBand(g, BAND_A, true, 342., 1., -14., -2., f + 3.3, 0.8, &bandsHere, f);
  lgBand(g, BAND_A, true, 358., -1., -14., -2., f + 3.3, 0.8, &bandsHere, f);
  lgBand(g, BAND_A, false, -14., 1., 342., 358., f + 3.3, 0.8, &bandsHere, f);
  lgBand(g, BAND_A, false, -2., -1., 342., 358., f + 3.3, 0.8, &bandsHere, f);
  lgColumn(g, -11.5, f, 346., 0.9);
  lgColumn(g, -4.5, f, 346., 0.9);
  lgBrazier(g, -8., f, 355., 1., 4500.);

  // ---- the corridor: x 6.4..9.6, z 342..372, 3.4 high ----
  lgFloor(g, 6.4, 9.6, 342., 372., f);
  lgWall(g, false, 5.4, 6.4, 342., 373., f, f + 3.4, &none, LM_ASHLAR, LM_PLASTER_RED, false);
  lgWall(g, false, 9.6, 10.6, 342., 373., f, f + 3.4, &none, LM_PLASTER_RED, LM_ASHLAR, false);
  lgCeiling(g, 6.4, 9.6, 342., 372., f + 3.4, 0., 0., 0.);
  lgBand(g, BAND_A, false, 6.4, 1., 342., 372., f + 2.85, 0.5, &bandsHere, f);
  lgBand(g, BAND_A, false, 9.6, -1., 342., 372., f + 2.85, 0.5, &bandsHere, f);
  k = 0;
  while k < 5 {
    let zz = 346. + 6. * f32.from(k);
    lgColumn(g, 6.9, f, zz, 0.9);
    lgColumn(g, 9.1, f, zz, 0.9);
    k = k + 1;
  }
  // (a lamp in the middle of each bay: every bay is alike, the loop's gate (z = LOOP_GATE_Z, between a lamp and a column pair) moves a
  // being two bays and nothing about the bays it passes changes)
  lgHangLamp(g, 8., f + 3.4, 349., 2600., 10.);
  lgHangLamp(g, 8., f + 3.4, 355., 2600., 10.);
  lgHangLamp(g, 8., f + 3.4, 361., 2600., 10.);
  lgHangLamp(g, 8., f + 3.4, 367., 2600., 10.);

  // ---- the bull court: x -20..40, z 373..433, 12 high ----
  lgFloor(g, -20., 40., 373., 433., f);
  lgWall(g, true, 372., 373., -21., 41., f, f + 12., &courtN, LM_PLASTER_RED, LM_ASHLAR, true);
  lgWall(g, true, 433., 434., -21., 41., f, f + 12., &none, LM_ASHLAR, LM_ASHLAR, false);
  lgWall(g, false, -21., -20., 372., 434., f, f + 12., &courtW, LM_PLASTER_RED, LM_ASHLAR, true);
  lgWall(g, false, 40., 41., 372., 434., f, f + 12., &courtE, LM_ASHLAR, LM_PLASTER_CREAM, true);
  lgCeiling(g, -20., 40., 373., 433., f + 12., 10., 403., 4.);
  lgLightWell(g, 10., 403., 4., f + 12., 6., 70000., 42.);
  lgBand(g, BAND_A, true, 373., 1., -20., 40., f + 10.5, 1.3, &bandsHere, f);
  lgBand(g, BAND_A, true, 433., -1., -20., 40., f + 10.5, 1.3, &bandsHere, f);
  lgBand(g, BAND_A, false, -20., 1., 373., 433., f + 10.5, 1.3, &bandsHere, f);
  lgBand(g, BAND_A, false, 40., -1., 373., 433., f + 10.5, 1.3, &bandsHere, f);
  lgBand(g, BAND_C, true, 373., 1., -20., 40., f + 6.2, 1.2, &courtN, f);
  lgBand(g, BAND_C, true, 433., -1., -20., 40., f + 6.2, 1.2, &bandsHere, f);
  lgBand(g, BAND_C, false, -20., 1., 373., 433., f + 6.2, 1.2, &courtW, f);
  lgBand(g, BAND_C, false, 40., -1., 373., 433., f + 6.2, 1.2, &courtE, f);
  // the colonnade: columns 5.6 m (the kit's, 1.6 times) 3 m in from the walls, a door's width clear
  var cx = -14.;
  while cx < 40. {
    if cx < 3. or cx > 13. {
      lgColumn(g, cx, f, 376., 1.6);
      lgColumn(g, cx, f, 430., 1.6);
    }
    cx = cx + 6.;
  }
  lgColumn(g, 3.5, f, 376., 1.6);
  lgColumn(g, 12.5, f, 376., 1.6);
  var cz = 382.;
  while cz < 428. {
    if cz < 397. or cz > 409. { lgColumn(g, -17., f, cz, 1.6); }
    if cz > 397. { lgColumn(g, 37., f, cz, 1.6); }
    cz = cz + 6.;
  }
  lgColumn(g, 37., f, 382., 1.6);
  // eight square pillars on a ring of 21 m about the middle, for the bull to hit
  var a = 0;
  while a < 8 {
    let ang = (22.5 + 45. * f32.from(a)) * 0.017453292;
    lgPillar(g, LAB_COURT_X + 21. * libc.cosf(ang), f, LAB_COURT_Z + 21. * libc.sinf(ang), 1.3, 6.);
    a = a + 1;
  }
  lgBrazier(g, -18., f, 375., 1.6, 22000.);
  lgBrazier(g, 38., f, 375., 1.6, 22000.);
  lgBrazier(g, -18., f, 431., 1.6, 22000.);
  lgBrazier(g, 38., f, 431., 1.6, 22000.);
  lgBrazier(g, 10., f, 375., 1.6, 22000.);
  lgBrazier(g, 10., f, 431., 1.6, 22000.);

  // ---- the throne room: x -45..-21, z 391..415, 7 high ----
  lgFloor(g, -45., -21., 391., 415., f);
  lgWall(g, true, 390., 391., -46., -21., f, f + 7., &none, LM_ASHLAR, LM_PLASTER_RED, false);
  lgWall(g, true, 415., 416., -46., -21., f, f + 7., &none, LM_PLASTER_RED, LM_ASHLAR, false);
  lgWall(g, false, -46., -45., 390., 416., f, f + 7., &none, LM_ASHLAR, LM_PLASTER_RED, false);
  lgCeiling(g, -45., -21., 391., 415., f + 7., 0., 0., 0.);
  lgBand(g, BAND_A, true, 391., 1., -45., -21., f + 6., 1., &bandsHere, f);
  lgBand(g, BAND_A, true, 415., -1., -45., -21., f + 6., 1., &bandsHere, f);
  lgBand(g, BAND_A, false, -45., 1., 391., 415., f + 6., 1., &bandsHere, f);
  lgBand(g, BAND_A, false, -21., -1., 391., 415., f + 6., 1., &bandsHere, f);
  lgBand(g, BAND_D, true, 391., 1., -45., -21., f + 0.8, 0.6, &bandsHere, f);
  lgBand(g, BAND_D, true, 415., -1., -45., -21., f + 0.8, 0.6, &bandsHere, f);
  lgBand(g, BAND_D, false, -45., 1., 391., 415., f + 0.8, 0.6, &bandsHere, f);
  lgPanel(g, LM_GRIFFIN, false, -45., 1., 396.2, f + 1.3, 1.4);
  lgPanel(g, LM_GRIFFIN, false, -45., 1., 409.8, f + 1.3, 1.4);
  lgPanel(g, LM_GRIFFIN, true, 391., 1., -33., f + 1.3, 1.4);
  lgPanel(g, LM_GRIFFIN, true, 415., -1., -33., f + 1.3, 1.4);
  lgThrone(g);
  // benches along both side walls
  lgRail(g, -44., -23., f, f + 0.55, 391., 391.7);
  lgRail(g, -44., -23., f, f + 0.55, 414.3, 415.);
  lgBasin(g, -34., 403.);
  lgColumn(g, -37., f, 397., 1.4);
  lgColumn(g, -37., f, 409., 1.4);
  lgColumn(g, -27., f, 397., 1.4);
  lgColumn(g, -27., f, 409., 1.4);
  // two vessels of coloured glass, a ruby ewer and a cobalt flask, each on a gypsum drum between the basin and the throne,
  // lit by the braziers' flames: deep vivid colour, the light of the room through them
  lgPedestal(g, -39., f, 398., 0.9);
  lgPedestal(g, -39., f, 408., 0.9);
  if g.want {
    lgGlass(g, "ruby ewer", gwVessel(&gwEwerOutline(), 0.008, 0.02, 40), gwRuby(), new Vec3(-39., f + 0.9, 398.));
    lgGlass(g, "cobalt flask", gwVessel(&gwFlaskOutline(), 0.008, 0.02, 40), gwCobalt(), new Vec3(-39., f + 0.9, 408.));
  }
  lgBrazier(g, -42., f, 398.5, 1.2, 10000.);
  lgBrazier(g, -42., f, 407.5, 1.2, 10000.);
  lgBrazier(g, -23., f, 394., 1.2, 10000.);
  lgBrazier(g, -23., f, 412., 1.2, 10000.);
  // the banners behind the throne: three, hanging from the beam, their folds fixed
  lgBanner(g, LM_BANNER_BLUE, -44.82, 399.2, 400.6, f + 6.4, f + 3.0, 0.1, 0.);
  lgBanner(g, LM_BANNER_OCHRE, -44.82, 402.2, 403.8, f + 6.4, f + 3.4, 0.1, 1.7);
  lgBanner(g, LM_BANNER_BLUE, -44.82, 405.4, 406.8, f + 6.4, f + 3.0, 0.1, 3.1);

  // ---- the grand staircase hall: x 41..75, z 380..430, 16 high ----
  lgFloor(g, 41., 75., 380., 430., f);
  lgWall(g, true, 379., 380., 41., 76., f, f + 16., &none, LM_ASHLAR, LM_PLASTER_CREAM, false);
  lgWall(g, true, 430., 431., 41., 76., f, f + 16., &exitD, LM_PLASTER_CREAM, LM_ASHLAR, true);
  lgWall(g, false, 75., 76., 379., 431., f, f + 16., &none, LM_PLASTER_CREAM, LM_ASHLAR, false);
  // the sill under the exit doorway
  lgSlab(g, true, 430., 431., LAB_EXIT_X - 2., LAB_EXIT_X + 2., f, f + LAB_EXIT_UP, LM_PLASTER_CREAM, LM_ASHLAR, true);
  lgCeiling(g, 41., 75., 380., 430., f + 16., 58., 405., 3.);
  lgLightWell(g, 58., 405., 3., f + 16., 6., 90000., 44.);
  lgBand(g, BAND_A, true, 380., 1., 41., 75., f + 14.7, 1., &bandsHere, f);
  lgBand(g, BAND_A, true, 430., -1., 41., 75., f + 14.7, 1., &bandsHere, f);
  lgBand(g, BAND_A, false, 75., -1., 380., 430., f + 14.7, 1., &bandsHere, f);
  lgBand(g, BAND_A, false, 41., 1., 380., 430., f + 14.7, 1., &bandsHere, f);
  lgBand(g, BAND_D, true, 380., 1., 41., 75., f + 1., 0.8, &bandsHere, f);
  lgPanel(g, LM_LILY, true, 380., 1., 50., f + 2.6, 1.);
  lgPanel(g, LM_LILY, true, 380., 1., 66., f + 2.6, 1.);
  // flight one east: 35 treads of 0.6 x 0.16, z 389..395, up to y = f + 5.6; the landing x 63..71, z 386..398
  lgFlight(g, true, 42., 0.6, 0.16, 35, 389., 395., f);
  lgBox(g, LM_GYPSUM, true, 63., 71., f - 0.5, f + 5.6, 386., 398., 1.8);
  g.top(63., 386., 71., 398., f + 5.6);
  // flight two south: x 63..71, from z 398, up to y = f + 11.2; the top landing z 419..433 (under the doorway's alcove too)
  lgFlight(g, false, 398., 0.6, 0.16, 35, 63., 71., f + 5.6);
  lgBox(g, LM_GYPSUM, true, 63., 71., f - 0.5, f + LAB_EXIT_UP, 419., 433., 1.8);
  g.top(63., 419., 71., 430., f + LAB_EXIT_UP);
  g.top(65., 430., 69., 433.5, f + LAB_EXIT_UP);
  // the parapets: low gypsum walls following each flight's open sides, and round the landings
  lgParapet(g, true, 42., 63., 388.65, 389., f + 0.98, f + 6.42, 1.1);
  lgParapet(g, true, 42., 63., 395., 395.35, f + 0.98, f + 6.42, 1.1);
  lgParapet(g, false, 398., 419., 62.65, 63., f + 6.58, f + 12.02, 1.1);
  lgParapet(g, false, 398., 419., 71., 71.35, f + 6.58, f + 12.02, 1.1);
  lgRail(g, 63., 71., f + 5.6, f + 6.5, 385.65, 386.);
  lgRail(g, 71., 71.35, f + 5.6, f + 6.5, 385.65, 398.);
  lgRail(g, 62.65, 63., f + 5.6, f + 6.5, 385.65, 389.);
  lgRail(g, 62.65, 63., f + 5.6, f + 6.5, 395., 398.);
  lgRail(g, 62.65, 63., f + LAB_EXIT_UP, f + LAB_EXIT_UP + 0.9, 419., 430.);
  lgRail(g, 71., 71.35, f + LAB_EXIT_UP, f + LAB_EXIT_UP + 0.9, 419., 430.);
  // columns on the landings (the parapets carried the columns of the flights above at Knossos)
  lgColumn(g, 64., f + 5.6, 387.2, 1.);
  lgColumn(g, 70., f + 5.6, 387.2, 1.);
  lgColumn(g, 70., f + 5.6, 396.8, 1.);
  lgColumn(g, 64.2, f + LAB_EXIT_UP, 424., 1.);
  lgColumn(g, 69.8, f + LAB_EXIT_UP, 424., 1.);
  lgBrazier(g, 43., f, 386., 1.4, 15000.);
  lgBrazier(g, 43., f, 398., 1.4, 15000.);
  lgBrazier(g, 50., f, 427., 1.4, 15000.);
  lgBrazier(g, 73., f, 383., 1.4, 15000.);
  lgBrazier(g, 65.2, f + LAB_EXIT_UP, 428., 1.2, 9000.);
  lgBrazier(g, 68.8, f + LAB_EXIT_UP, 428., 1.2, 9000.);
  // the alcove behind the exit doorway: where the portal will be
  lgBox(g, LM_ASHLAR, true, 64.4, 65., f + LAB_EXIT_UP - 1., f + 14.9, 431., 434.5, 2.);
  lgBox(g, LM_ASHLAR, true, 69., 69.6, f + LAB_EXIT_UP - 1., f + 14.9, 431., 434.5, 2.);
  lgBox(g, LM_PLASTER_RED, true, 65., 69., f + LAB_EXIT_UP - 1., f + 14.9, 433.5, 434.5, 2.);
  lgBox(g, LM_ASHLAR, true, 65., 69., f + 14.6, f + 15.4, 431., 433.5, 2.);
}
