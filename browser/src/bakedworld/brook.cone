// The brook's water: one ribbon mesh along the course (island/brook.cone), seven vertices across at
// a station every half metre, drawn see-through by brook.slang (SHADER_BROOK). The land under it is
// the trench the island carved; the ribbon lies at the water's level there, or a hand's breadth over
// the ground if the ground rises past it (a bank, a cobble's wet top), so it never sinks out of sight.
//
// The per-vertex data brook.slang reads (it is packed into the mesh's three streams):
//   uv      across (metres from the course, signed), along (metres from the spring)
//   normal  speed (m/s), foam (0 to 1), the wet half width
//
// THE SPEED follows the course's fall: 0.15 + 4.5 sqrt(slope), the slope taken over six metres: about
// 0.4 m/s on the yard's 0.3%, a metre a second in the dingle, two on the rill.
// THE FOAM is baked here: round each bed stone (a rock the layout set in the water: its wake reaches
// 0.8 m downstream), and at the foot of each step of the cascade, fading over the next four stations.

// Metres between stations
const BROOK_STATION f32 = 0.5;
// The ribbon runs this far beyond the wet half width as a feather that fades
const BROOK_FEATHER f32 = 0.3;
// The metres over which the water fades away at the sea
const BROOK_FADE f32 = 8.;

// The water's body colour: a faint tea-green, near clear
const BROOK_BODY_R f32 = 0.05;
const BROOK_BODY_G f32 = 0.085;
const BROOK_BODY_B f32 = 0.07;

fn mixf(a f32, b f32, t f32) f32 { a + (b - a) * t }
fn clamp01(x f32) f32 { if x < 0. { 0. } elif x > 1. { 1. } else { x } }
fn minf(a f32, b f32) f32 { if a < b { a } else { b } }

// The rocks in the water: the layout's rocks that stand within 1.4 m of the course (x, z, radius)
pub fn brookStones(isl &Island) List[Vec3] {
  let items = vegetationLayout(isl);
  var out = List[Vec3].empty();
  var i = 0usize;
  while i < items.len() {
    let it = items[i];
    if it.kind == K_ROCK && brookDistanceAt(isl, it.x, it.z) < 1.4 { out.push(new Vec3(it.x, it.z, it.radius)); }
    i = i + 1usize;
  }
  out
}

// The ribbon's mesh
fn brookRibbon(isl &Island) mesh.Mesh {
  let pts = brookPoints(isl);
  let n = pts.len();
  let stones = brookStones(isl);
  // The speed and the step foam at each point (one a metre), from the fall
  var speed = List[f32].withCapacity(n);
  var stepFoam = List[f32].withCapacity(n);
  var i = 0usize;
  while i < n {
    let a = if i >= 3usize { i - 3usize } else { 0usize };
    let b = if i + 3usize < n { i + 3usize } else { n - 1usize };
    let run = pts[b].s - pts[a].s + 0.0001;
    let fall = (pts[a].w - pts[b].w) / run;
    speed.push(minf(3., 0.15 + 4.5 * (if fall > 0. { fall } else { 0. }).sqrt()));
    // A step: the water drops more than 0.15 m a metre over the one metre
    let drop = if i + 1usize < n { pts[i].w - pts[i + 1usize].w } else { 0. };
    stepFoam.push(clamp01((drop - 0.08) / 0.2));
    i = i + 1usize;
  }
  var m = mesh.Mesh.empty();
  let stations = i32.from(pts[n - 1usize].s / BROOK_STATION) + 1;
  var at = 0usize;
  var st = 0;
  while st < stations {
    let s = f32.from(st) * BROOK_STATION;
    while at + 2usize < n && pts[at + 1usize].s < s { at = at + 1usize; }
    let p = pts[at];
    let q = pts[at + 1usize];
    let span = q.s - p.s + 0.0001;
    let u = clamp01((s - p.s) / span);
    let x = mixf(p.x, q.x, u);
    let z = mixf(p.z, q.z, u);
    let w = mixf(p.w, q.w, u);
    // The mouth fans out: in the last 16 m the wet width grows to 3.2 times (the rills spread over the sand)
    let fanT = clamp01((s - (pts[n - 1usize].s - 16.)) / 15.);
    let hw = mixf(p.width, q.width, u) * 0.5 * (1. + 2.2 * fanT * fanT * (3. - 2. * fanT));
    let v = mixf(*speed[at], *speed[at + 1usize], u);
    // The direction downstream, and across it
    let tx = q.x - p.x;
    let tz = q.z - p.z;
    let tl = (tx * tx + tz * tz).sqrt() + 0.0001;
    let nx = (0. - tz) / tl;
    let nz = tx / tl;
    // The foam at the foot of a step, drifting down for four stations: the strongest of the points upstream
    var stepF f32 = 0.;
    var back = 0usize;
    while back < 4usize && back <= at {
      let f = *stepFoam[at - back] * (1. - f32.from(back) * 0.22);
      if f > stepF { stepF = f; }
      back = back + 1usize;
    }
    var row = 0;
    while row < 7 {
      let across = (f32.from(row) - 3.) / 3. * (hw + BROOK_FEATHER);
      // The seven rows: 0, then 1/3 and 2/3 of the way to the feather's end, each side (the wet edge is
      // near the 2/3 row at hw 0.55 and a feather of 0.3)
      let px = x + nx * across;
      let pz = z + nz * across;
      let g = groundHeight(isl, px, pz);
      let y = if g + 0.02 > w { g + 0.02 } else { w };
      // Foam round the bed stones: strongest at a stone, reaching its radius and 0.4 m more, its wake
      // 0.8 m downstream
      var foam = stepF * (1. - 0.6 * (across * across) / ((hw + BROOK_FEATHER) * (hw + BROOK_FEATHER)));
      var k = 0usize;
      while k < stones.len() {
        let r = *stones[k];
        let dx = px - r.x - tx / tl * 0.4;
        let dz = pz - r.y - tz / tl * 0.4;
        let d = (dx * dx + dz * dz).sqrt();
        let reach = r.z + 0.3;
        if d < reach {
          let f = 1. - d / reach;
          if f > foam { foam = f; }
        }
        k = k + 1usize;
      }
      m.positions.push(new Vec3(px, y, pz));
      m.normals.push(new Vec3(v, clamp01(foam), hw));
      m.uvs.push(new Vec2(across, s));
      row = row + 1;
    }
    st = st + 1;
  }
  var a = 0;
  while a + 1 < stations {
    var row = 0;
    while row < 6 {
      let i0 = u32.from(a * 7 + row);
      let i1 = i0 + 1u32;
      let i2 = i0 + 7u32;
      let i3 = i2 + 1u32;
      m.indices.push(i0); m.indices.push(i2); m.indices.push(i3);
      m.indices.push(i0); m.indices.push(i3); m.indices.push(i1);
      row = row + 1;
    }
    a = a + 1;
  }
  m
}

// The brook as an object: one see-through part, the water, placed at the world's origin (its vertices are
// the world's)
fn hydrateBrook(isl &Island, h &mut Hydrated) {
  let ribbon = brookRibbon(isl);
  let look = Look.shaded(SHADER_BROOK, [brookLength(isl), BROOK_FADE, 0., 0., BROOK_BODY_R, BROOK_BODY_G, BROOK_BODY_B, 0.]);
  h.add("brook water", ribbon, look, Image.empty(), Transform3.identity());
  let stone = bridgeStone(h, 4);
  h.part("brook steps", h.addMesh(brookSteps(isl)), stone, TOP, Transform3.identity());
}

// The cascade's steps: at the head of each drop of the water (where the course's level begins to fall more
// than 0.08 m a metre) a flat stone laid across the channel, 0.4 m along it, standing 0.06 m over the upstream
// water and down well below it, with a smaller block at each end of it, so the water goes over a lip of
// stone and falls to the next. (Not solid: they are a hand's breadth high.)
fn brookSteps(isl &Island) mesh.Mesh {
  let pts = brookPoints(isl);
  var m = mesh.Mesh.empty();
  var k = 1usize;
  var n = 0;
  while k + 1usize < pts.len() {
    let drop = pts[k].w - pts[k + 1usize].w;
    let before = pts[k - 1usize].w - pts[k].w;
    if drop > 0.08 && before <= 0.08 && pts[k].ctl >= 20usize {
      let tx = pts[k + 1usize].x - pts[k - 1usize].x;
      let tz = pts[k + 1usize].z - pts[k - 1usize].z;
      let tl = (tx * tx + tz * tz).sqrt() + 0.0001;
      let dx = tx / tl;
      let dz = tz / tl;
      let ax = 0. - dz;
      let az = dx;
      let w = pts[k].w;
      let j = f32.from(n % 5) * 0.07;
      let half = 0.78 + j;
      // the slab, across the channel
      ctPara(&mut m, v(pts[k].x - ax * half - dx * 0.2, w - 0.45, pts[k].z - az * half - dz * 0.2), v(ax * 2. * half, 0., az * 2. * half),
        v(0., 0.51, 0.), v(dx * 0.4, 0., dz * 0.4), 0.9);
      // a block at each end, a little higher, and a little downstream
      let bx = pts[k].x + dx * 0.05;
      let bz = pts[k].z + dz * 0.05;
      ctPara(&mut m, v(bx - ax * (half + 0.4) - dx * 0.2, w - 0.45, bz - az * (half + 0.4) - dz * 0.2), v(ax * 0.42, 0., az * 0.42),
        v(0., 0.56 + 0.6 * j, 0.), v(dx * 0.42, 0., dz * 0.42), 0.9);
      ctPara(&mut m, v(bx + ax * (half - 0.02) - dx * 0.2, w - 0.45, bz + az * (half - 0.02) - dz * 0.2), v(ax * 0.42, 0., az * 0.42),
        v(0., 0.55 + 0.4 * j, 0.), v(dx * 0.42, 0., dz * 0.42), 0.9);
      n = n + 1;
    }
    k = k + 1usize;
  }
  m
}
