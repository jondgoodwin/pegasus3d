// What crosses between the browser's two halves, the simulation (simactor.cone)
// and the view (viewactor.cone): the messages, as values the halves use, and
// (netcodec.cone) as the bytes the protocol package (netmsg) carries between
// them, whether the halves are in one process (single player), or on either
// end of a UDP connection (--serve and --connect). The halves hold no state in
// common: everything one tells the other is one of these, sent as a reliable
// message or as latest-wins data on a stream.
//
//   view -> simulation
//     latest-wins, STREAM_INPUT   the last INPUT_KEPT ticks of this client's intents, each with
//                                 its sequence number (so a lost packet loses nothing)
//     reliable                    Click (a part picked: the simulation tells its listener),
//                                 Command (pause, x10, the weather, and, in single player,
//                                 first or third person and possess the next being),
//                                 Look (the mouse's pitch change; single player's mirror only)
//   simulation -> view
//     reliable                    Requests (the world's, and the browser's own, that the
//                                 simulation accepted, in the order applied; the content every
//                                 browser holds itself crosses as the Object that names it, not as
//                                 meshes and images), Possessed (which being is this client's),
//                                 Weather (when it changed)
//     latest-wins, STREAM_STATE   the snapshot of a tick: the tick, scene time, each being's
//                                 state, the last input sequence applied for this client
//     latest-wins, STREAM_TEST    a scripted run's camera and the view's file name; a run's
//                                 own, not the protocol's
//
// Nothing is sent that the view can work out: the bones (the view animates the
// gait itself, from the state), the camera (the view's own, following the
// being it drives), the birds (each browser flies its own flock), the hour
// (the day clock is a function of scene time).

// How many ticks of intents each input packet carries
pub const INPUT_KEPT = 10usize;
// ... and the most it carries when more are still waiting to be applied (a slow or lossy link)
pub const INPUT_MOST = 30usize;

// The streams
pub const STREAM_INPUT = 1u32;
pub const STREAM_STATE = 2u32;
pub const STREAM_TEST = 3u32;

// The keys the view sends as commands
pub const COMMAND_PAUSE = 0u32;    // P: scene time stops, or goes on
pub const COMMAND_FAST = 1u32;     // F: scene time x10, or as it was
pub const COMMAND_VIEW = 2u32;     // V: first or third person (single player: the simulation's mirror of the view's camera)
pub const COMMAND_SWAP = 3u32;     // Tab: possess the next being (single player)
pub const COMMAND_WEATHER = 4u32;  // T: the weather changes to the next state

// ---- view -> simulation ----

// One tick of the user's controller: what the possessed being means to do,
// and the pitch keys held; numbered, rising by one a tick
pub struct InputSample {
  pub seq u64;
  pub intents Intents;
  pub lookKeys f32;
}

// Reliable
pub enum ToSim {
  // A client's first message to a server: the name it plays under. The server answers by giving it a mannequin, or with
  // ToView.Refused (a name already in use, or one that is not allowed)
  pub struct Hello {
    pub name String;
    pub version u32;   // PROTOCOL_VERSION of the client's build; 0 from a build that predates versions
  }
  // The click hit part 'part': its listener, if it has one, is told
  pub struct Click {
    pub part PartId;
  }
  // A key (COMMAND_...)
  pub struct Command {
    pub kind u32;
  }
  // The view's pitch changed by 'pitch' radians (a mouse drag)
  pub struct Look {
    pub pitch f32;
  }
  // Single player, where the halves take turns: the view's frame 'frame' has these fixed steps, and the
  // simulation is to take them now (sent after the frame's inputs, so that they have all arrived)
  pub struct Frame {
    pub frame u64;
    pub steps List[Step];
  }
  // A playground action by this client's being (spells.cone): bowl the ball at the spot the view's eye looks at, or cast the spell
  // 'spell' (SPELL_...) at 'target', the being aimed at (NO_TARGET: none; paint needs none). The eye and direction are the camera's
  pub struct Play {
    pub kind u32;             // PLAY_BOWL, PLAY_SPELL
    pub spell u32;
    pub target u32;
    pub eye Vec3;
    pub dir Vec3;
  }
  pub struct Nothing;
}

// The playground's actions, spells, spell effects and what a burst is
pub const PLAY_BOWL = 0u32;
pub const PLAY_SPELL = 1u32;
pub const SPELL_PAINT = 0u32;      // F1
pub const SPELL_ZAP = 1u32;        // F2
pub const SPELL_JIG = 2u32;        // F3
pub const NO_TARGET = 0xFFFFFFFFu32;
pub const FX_NONE = 0u32;
pub const FX_ZAP = 1u32;
pub const FX_JIG = 2u32;
pub const BURST_PAINT = 1u32;
pub const BURST_ZAP = 2u32;

// What ToView.Burst carries, as a value of its own (the simulation keeps the bursts it is to tell in a list of these)
pub struct BurstInfo {
  pub kind u32;
  pub being u32;
  pub position Vec3;
  pub normal Vec3;
  pub color u32;
  pub tick u64;
}

// A spell in force on a being: its kind, and the simulation tick it began
pub struct FxState {
  pub being u32;
  pub kind u32;
  pub start u64;
}

// ---- simulation -> view ----

// One being as the tick's snapshot has it. The kinematic state of its body,
// all that is needed to predict it on (for the being the client drives), to
// draw it interpolated, and to animate its gait from. 'exact' says the
// numbers crossed whole (the being this client drives, which it compares its
// own prediction with); otherwise positions crossed in millimetres, the
// heading in 16 bits, and the speeds in fixed point.
pub struct BeingState {
  pub being u32;              // its number in the cast
  pub exact bool;
  pub position Vec3;          // the feet
  pub yaw f32;                // the heading, radians
  pub speed f32;              // along its heading, m/s
  pub vy f32;                 // vertical speed, m/s
  pub airVx f32;              // horizontal velocity while falling
  pub airVz f32;
  pub grounded bool;
  pub intents Intents;        // the gait's intent: what it was last given
  pub platform PartId;        // the platform it stands on; none: the ground, or the air
  pub health f32;             // 1 whole
  pub respawns u32;           // times it has got up again at the landing (counted, mod 256)
  pub landings u32;           // landings (mod 256), and the speed of the last
  pub landSpeed f32;
  pub mode u32;               // FIG_WALK, FIG_RAG (limp: 'position' is its pelvis, 'rots' its bodies' rotations), FIG_GETUP ('modeT' seconds in)
  pub modeT f32;
  pub hasRots bool;           // a ragdoll's 14 bodies' rotations are in 'rots' (not if the packet had no room for them)
  pub rots Array[Quat, 14];
}

// Fourteen rotations for a being that is not limp
pub fn noRots() Array[Quat, 14] {
  imm q = Quat.identity();
  [q, q, q, q, q, q, q, q, q, q, q, q, q, q];
}

// Latest-wins on STREAM_STATE: the simulation's snapshot of a tick
pub struct WorldState {
  pub tick u64;               // the simulation's fixed step, counted from the start
  pub now f64;                // the scene's time, seconds
  pub rate u32;               // the scene clock's rate (0 paused, 1, 10)
  pub appliedInput u64;       // the last input sequence number applied for this client
  pub beings List[BeingState];
  pub props List[PropState];  // the playground's pins and ball, once any has left its home (props.cone)
  pub fx List[FxState];       // the spells in force on beings: a jig, a zap (spells.cone)
}

// Latest-wins on STREAM_TEST: a scripted run's own
pub struct TestView {
  pub fixedView bool;         // drawn from 'view' through 'fov', not from the eyes
  pub view Pose;
  pub fov f32;
  pub shot String;            // the view to save from this frame, by name; empty: none
}

pub enum StateData {
  pub struct State {
    pub state WorldState;
  }
  pub struct Test {
    pub test TestView;
  }
  pub struct Nothing;
}

// Reliable
pub enum ToView {
  // The requests the simulation applied, in the order applied, that concern
  // what the view keeps or draws
  pub struct Requests {
    pub batch List[Request];
  }
  // Being 'being' is this client's to possess
  pub struct Possessed {
    pub being u32;
    pub version u32;   // the server's PROTOCOL_VERSION; 0 from a build that predates versions
  }
  // The server will not have this client (its name is taken, or is not allowed): 'reason' is for the user, and the connection
  // is ended
  pub struct Refused {
    pub reason String;
  }
  // The weather changed (weather.cone)
  pub struct Weather {
    pub weather Weathering;
  }
  // Single player: the simulation has taken the frame it was asked for, and sent everything it had to say about it
  // (the snapshot of tick 'tick' among it); it spent this long on it, in nanoseconds
  pub struct FrameDone {
    pub tick u64;
    pub simulateNs u64;
    pub publishNs u64;
  }
  // Something every view is to show or sound once (spells.cone): a splat of paint (BURST_PAINT) on a surface or on a being, a zap's
  // crack (BURST_ZAP). On a being, 'position' is in the being's own frame (its feet, facing as it did at yaw 0), otherwise the
  // world's. 'color' picks the paint; 'tick' is when it happened
  pub struct Burst {
    pub kind u32;
    pub being u32;
    pub position Vec3;
    pub normal Vec3;
    pub color u32;
    pub tick u64;
  }
  pub struct Nothing;
}

// The feet's place as a placement in the world, facing 'yaw'
pub fn bodyPlacement(position Vec3, yaw f32) Transform3 {
  new Transform3(position, Quat.angleAxis(yaw, new Vec3(0., 1., 0.)), new Vec3(1., 1., 1.));
}
