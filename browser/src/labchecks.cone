// The --checks of the labyrinth (bakedworld/labrooms.cone, labnav.cone): its solids are where its walls, doorways and floors are; a walker
// stands on its floors, is stopped by a column and a parapet, and climbs a staircase; the navigation mesh covers every room, avoids what
// stands in them and has a route from E to each place the creatures will need.

// Whether the point (x, y, z) is inside any solid of 'list'
fn labSolidHit(list &List[Solid], x f32, y f32, z f32) bool {
  mut i = 0usize;
  while i < list.len() {
    imm s = list[i];
    if s.over(x, z) and y >= s.y0 and y <= s.topAt(x, z) { return true; }
    i = i + 1usize;
  }
  false;
}

fn checkLabyrinth() bool {
  print <- "The labyrinth:\n";
  imm g = labPlan();
  imm f = LAB_Y;
  mut ok = true;
  print <- "  ("; print <- g.solids.len(); print <- " solids, "; print <- g.tops.len(); print <- " walkable tops, "; print <- g.circles.len(); print <- " circle and ";
  print <- g.boxes.len(); print <- " box obstacles, "; print <- g.lamps.len(); print <- " lights)\n";
  ok = expect("the labyrinth lies under the island's lowest ground, and every solid of it is below LAB_TOP",
    f + 20. < LAB_TOP and labSolidsAllBelow(&g.solids)) and ok;
  ok = expect("it holds the lights its rooms need: a brazier or hanging lamp in each room and a spot light down each of three light wells", g.lamps.len() >= 28usize) and ok;

  // The walls and the doorways, from the solids
  imm y = f + 1.;
  ok = expect("E is on the antechamber's south wall: the wall is solid at z 299.5, the room's air is not at z 301",
    labSolidHit(&g.solids, LAB_E_X, y, 299.5) and !labSolidHit(&g.solids, LAB_E_X, y, 301.)) and ok;
  mut open = true;
  open = !labSolidHit(&g.solids, 0., y, 320.5) and open;
  open = !labSolidHit(&g.solids, LAB_DOOR_LEFT_X, y, 341.5) and open;
  open = !labSolidHit(&g.solids, LAB_DOOR_RIGHT_X, y, 341.5) and open;
  open = !labSolidHit(&g.solids, LAB_CORR_X, y, 372.5) and open;
  open = !labSolidHit(&g.solids, -20.5, y, LAB_COURT_Z) and open;
  open = !labSolidHit(&g.solids, 40.5, y, 392.) and open;
  open = !labSolidHit(&g.solids, LAB_EXIT_X, f + LAB_EXIT_UP + 1., 430.5) and open;
  ok = expect("every doorway is clear to a body: the antechamber's north, the hall's two, the corridor's far end, the court's west and east, the exit's", open) and ok;
  mut shut = true;
  shut = labSolidHit(&g.solids, -5., y, 320.5) and shut;
  shut = labSolidHit(&g.solids, 14.5, y, 331.) and shut;
  shut = labSolidHit(&g.solids, 0., y, 341.5) and shut;
  shut = labSolidHit(&g.solids, 6., y, 350.) and shut;
  shut = labSolidHit(&g.solids, 0., y, 372.5) and shut;
  shut = labSolidHit(&g.solids, -46., y, 403.) and shut;
  ok = expect("and the walls between them are solid (the antechamber's, the hall's east, the hall's north between its doors, the corridor's, the court's, the throne room's west)", shut) and ok;
  ok = expect("a Minoan column (0.29 m round at its top) stands at the antechamber's corner, a pillar in the court", labSolidHit(&g.solids, -5.5, y, 305.) and labSolidHit(&g.solids, 10. + 21. * 0.9238795, y, 403. + 21. * 0.3826834)) and ok;

  // A walker on the labyrinth's floors (flat ground at the island's zero, 300 m over it)
  mut list = List[Solid].empty();
  labSolids(&mut list);
  mut s = Scene.empty();
  mut c = Cast.empty(Island.empty());
  imm w = putWalker(&mut s, &mut c, new Vec3(0., f, 310.), 0.);
  c.phys.setSolids(&list);
  // dropped 0.3 m (a step down, not a hard landing) onto the floor
  c.beings[w].setDown(new Vec3(0., f + 0.3, 310.), 0.);
  c.beings[w].figure.grounded = false;
  walkFor(&mut c, 2., Intents.none());
  imm settled = c.beings[w].body.position;
  print <- "  (dropped 0.3 m onto the antechamber's floor: at y "; print <- settled.y - f; print <- " above it)\n";
  ok = expect("a mannequin dropped 0.3 m in the antechamber lands on its floor (and not through it, nor on the island's ground overhead)",
    nearly(settled.y, f, 0.02) and c.beings[w].figure.grounded) and ok;
  // walked into the column at (-5.5, 305), from the south, facing -z
  c.beings[w].setDown(new Vec3(-5.5, f, 312.), 0.);
  walkFor(&mut c, 4., new Intents(1., 0., false, false));
  imm atColumn = c.beings[w].body.position;
  imm r = c.beings[w].figure.radius();
  ok = expect("walked into a column it is stopped by it, its radius off the shaft's top",
    nearly(atColumn.z, 305. + 0.29 + r, 0.03) and nearly(atColumn.y, f, 0.02)) and ok;
  // walked through the hall's left door (x -8) from the south, and on to the Worm's chamber
  c.beings[w].setDown(new Vec3(LAB_DOOR_LEFT_X, f, 335.), 3.1415927);
  walkFor(&mut c, 8., new Intents(1., 0., false, false));
  imm inWorm = c.beings[w].body.position;
  print <- "  (walked through the Worm's door: at ("; print <- inWorm.x; print <- ", "; print <- inWorm.y - f; print <- " m up, "; print <- inWorm.z; print <- "))\n";
  ok = expect("it walks through a doorway (the Worm's door, 3.2 m wide in a 1 m wall) into the next room, on the floor",
    inWorm.z > 344. and nearly(inWorm.x, LAB_DOOR_LEFT_X, 0.1) and nearly(inWorm.y, f, 0.02)) and ok;
  // up the staircase's first flight: facing +x from its foot (yaw -pi/2), a minute and a half's walk is plenty
  c.beings[w].setDown(new Vec3(43., f, 392.), 0. - 1.5707964);
  mut k = 0;
  mut top = f;
  while k < 60 * 18 {
    c.step(new Intents(1., 0., false, false), 1. / 60.);
    imm yy = c.beings[w].body.position.y;
    if yy > top { top = yy; }
    k = k + 1;
  }
  imm onLanding = c.beings[w].body.position;
  print <- "  (walked up the first flight for 18 s: at ("; print <- onLanding.x; print <- ", "; print <- onLanding.y - f; print <- " m up, "; print <- onLanding.z; print <- "))\n";
  ok = expect("it climbs the staircase's first flight (35 treads of 0.16 m) to the landing, 5.6 m up, and stops at the landing's far rail",
    nearly(onLanding.y, f + 5.6, 0.03) and onLanding.x > 63. and onLanding.x < 71.) and ok;
  // the parapet along a flight is a wall: from the middle of the flight walked toward its south side
  c.beings[w].setDown(new Vec3(50., f + 0.16 * 14., 392.), 3.1415927);
  walkFor(&mut c, 6., new Intents(1., 0., false, false));
  imm atRail = c.beings[w].body.position;
  ok = expect("the parapet beside a flight stops a walker at the flight's edge, a radius off it (it does not walk off the side)",
    atRail.z > 394.5 and atRail.z < 395. - r + 0.05 and atRail.y > f + 1.) and ok;

  // The navigation mesh
  mut nav = buildLabNav();
  print <- "  (navigation mesh: "; print <- nav.triangles; print <- " triangles, "; print <- nav.obstacles; print <- " obstacles, "; print <- nav.polygons; print <- " polygons, built in ";
  print <- f64.from(nav.buildNs) / 1000000d; print <- " ms)\n";
  mut covered = true;
  imm centres = [new Vec3(0., f, 310.), new Vec3(0., f, 331.), new Vec3(-8., f, 350.), new Vec3(8., f, 357.), new Vec3(10., f, 395.), new Vec3(-33., f, 403.),
    new Vec3(50., f, 392.), new Vec3(66., f + 5.6, 392.), new Vec3(67., f + 8.4, 408.), new Vec3(67., f + LAB_EXIT_UP, 425.)];
  mut i = 0usize;
  while i < 10usize {
    if !labCovered(&nav, centres[i], 0.6) { covered = false; print <- "  (not covered at "; print <- centres[i].x; print <- ", "; print <- centres[i].z; print <- ")\n"; }
    i = i + 1usize;
  }
  ok = expect("the mesh covers every room: the antechamber, hall, Worm's chamber, corridor, court, throne room, the stair hall's floor, its landing, the second flight and the top landing", covered) and ok;
  ok = expect("and leaves out what stands in them: a column's foot, a pillar's, the throne's",
    !labCovered(&nav, new Vec3(-5.5, f, 305.), 0.15) and !labCovered(&nav, new Vec3(10. + 21. * 0.9238795, f, 403. + 21. * 0.3826834), 0.4)
    and !labCovered(&nav, new Vec3(-44.5, f, 403.), 0.15)) and ok;
  // routes from E to the places the creatures need
  imm e = new Vec3(LAB_E_X, f, LAB_E_Z + 0.9);
  imm goals = [new Vec3(LAB_GUARD_LEFT_X, f + 0.22, LAB_GUARD_Z), new Vec3(LAB_GUARD_RIGHT_X, f + 0.22, LAB_GUARD_Z), new Vec3(LAB_WORM_X, f, LAB_WORM_Z),
    new Vec3(LAB_CORR_X, f, 357.), new Vec3(LAB_COURT_X, f, LAB_COURT_Z), new Vec3(-38., f, LAB_COURT_Z), new Vec3(LAB_STAIR_TOP_X, f + LAB_EXIT_UP, LAB_STAIR_TOP_Z)];
  mut pts = List[Vec2].empty();
  mut reached = 0usize;
  mut lenTop = 0.;
  i = 0usize;
  while i < 7usize {
    if labRoute(&mut nav, e, goals[i], &mut pts) {
      reached = reached + 1usize;
      if i == 6usize {
        mut j = 1usize;
        while j < pts.len() { imm a = *pts[j - 1usize]; imm b = *pts[j]; lenTop = lenTop + libc.sqrtf((a.x - b.x) * (a.x - b.x) + (a.y - b.y) * (a.y - b.y)); j = j + 1usize; }
      }
    } else {
      print <- "  (no route from E to goal "; print <- i; print <- ")\n";
    }
    i = i + 1usize;
  }
  print <- "  (routes from E: "; print <- reached; print <- " of 7 found; the one to the staircase's top "; print <- lenTop; print <- " m)\n";
  ok = expect("a route from E to each guard's plinth, the Worm's chamber, the corridor, the court's middle, the throne room and the staircase's top",
    reached == 7usize and lenTop > 150. and lenTop < 200.) and ok;
  ok;
}

fn labSolidsAllBelow(list &List[Solid]) bool {
  mut i = 0usize;
  while i < list.len() {
    imm s = list[i];
    imm top = if s.y1 > s.y2 { s.y1; } else { s.y2; };
    if top >= LAB_TOP { return false; }
    i = i + 1usize;
  }
  true;
}
