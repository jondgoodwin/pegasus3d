// The labyrinth's part of the scripted run (bakedworld/labyrinth.cone, labrooms.cone): the rooms seen from fixed eyes, then walked.
//
//   settle   the wooden mannequin (being 1) is possessed and set down at E on the antechamber's south wall facing +z; the day clock
//            at noon of a sixth day in fair weather (the labyrinth must not show it); 120 frames for it to settle
//   views    30 windows of ten frames, the picture saved at each one's seventh: the antechamber (from E, its columns, a column,
//            the dolphins, the light well, the rosette band flat on), the hall of two doors (both doors, a guard's plinth),
//            the worm's chamber, the corridor both ways, the court (from its door, from high in a corner, the light well, the
//            pillars), the throne room (the throne, the side, the griffins), the staircase (from the court, from its foot,
//            from its top looking down a flight, its top, the doorway of the exit); then two pairs under the same eyes with the
//            island's light changed (the antechamber at noon and at midnight, the court at noon and in rain), each pair after a
//            window of warming up for the auto-exposure: the pictures must agree (they do, but for the edges' anti-aliasing)
//   walk     the mannequin set down at E again and walked, first person, along the labyrinth's own navigation mesh route
//            (labnav.cone) to the top of the staircase, through every room but the worm's: pictures from its eyes on the way;
//            it must get there (within 2 m of the top landing and 11.2 m up) and never fall below the floors
//
// 'browser.exe --labyrinth-only --shots DIR' runs just this (frames 300 on, after the first walk's keys); in the full run it is the last
// part, after the mirror's. '--labyrinth-only --soak N --lab-hold K' holds view K (1 to 28) for the rest of N frames, to time it.

pub const LAB_SETTLE = 120u64;
pub const LAB_WINDOW = 10u64;
pub const LAB_VIEWS = 30u64;
pub const LAB_WALK_FRAMES = 6600u64;
pub const LAB_FRAMES = LAB_SETTLE + LAB_WINDOW * LAB_VIEWS + LAB_WALK_FRAMES + 60u64;

// The first frame of the labyrinth's part: 300 in the labyrinth-only run, else after the mirror's
pub fn labFrom(opts &RunOptions) u64 {
  if opts.labOnly { 300u64; } else { MIRROR_FROM_FULL + MIRROR_FRAMES; };
}

pub fn labScriptEnd(opts &RunOptions) u64 { labFrom(opts) + LAB_FRAMES; }

pub fn labIn(opts &RunOptions, f u64) bool {
  if opts.labOnly { f >= labFrom(opts); } else { f >= labFrom(opts) and f < labScriptEnd(opts); };
}

fn labViewsFrom(opts &RunOptions) u64 { labFrom(opts) + LAB_SETTLE; }
fn labWalkFrom(opts &RunOptions) u64 { labViewsFrom(opts) + LAB_WINDOW * LAB_VIEWS; }

// The views: name, eye, target (heights above the antechamber's floor), lens
imm LAB_VIEW_NAMES Array[&str, 30] = ["lab-antechamber", "lab-antechamber-columns", "lab-column", "lab-dolphins", "lab-lightwell",
  "lab-band", "lab-hall", "lab-hall-doors", "lab-hall-guard", "lab-worm", "lab-corridor", "lab-corridor-back", "lab-court-entry",
  "lab-court-wide", "lab-court-well", "lab-court-pillars", "lab-throne", "lab-throne-side", "lab-griffins", "lab-stairs-from-court",
  "lab-stairs-bottom", "lab-stairs-down", "lab-stairs-top", "lab-exit",
  // the island's light changed under the same eyes (a window of warming up first, for the auto-exposure): they must agree
  "", "lab-antechamber-day", "lab-antechamber-night", "", "lab-court-clear", "lab-court-rain"];

// eye x, y, z, target x, y, z, the lens (vertical, radians): seven numbers a view
imm LAB_VIEW_DATA Array[f32, 210] = [
  0., 1.7, 301.3, 0., 1.9, 318., 1.2,
  -8.5, 1.7, 302., 4., 2.2, 314., 1.1,
  -1.5, 1.7, 311., -5.5, 1.75, 305., 0.7,
  -2., 2.2, 310., -10., 2.35, 310., 0.55,
  3., 1.7, 306., 0., 7.5, 310., 1.1,
  0., 4.8, 306., 0., 4.8, 300., 0.34,
  0., 1.7, 322.2, 0., 2.2, 340., 1.2,
  0., 1.7, 323., 0., 2.2, 341., 1.15,
  -1., 1.7, 330., -5.2, 1.6, 338.8, 0.9,
  -8., 1.7, 343., -8., 1.6, 357., 1.2,
  8., 1.7, 342.6, 8., 1.7, 372., 1.0,
  8., 1.7, 371.4, 8., 1.7, 342., 1.0,
  8., 1.7, 374., 10., 3.5, 420., 1.2,
  -17., 4.5, 378., 20., 3., 420., 1.3,
  10., 1.7, 382., 10., 11., 403., 1.2,
  32., 1.7, 386., -5., 3., 415., 1.2,
  -23.5, 1.7, 403., -44., 1.5, 403., 1.1,
  -25., 2.2, 394., -42., 1.4, 409., 1.1,
  -37., 2.2, 396.2, -45., 2.2, 396.2, 0.55,
  29., 1.7, 392., 46., 2.5, 392., 1.1,
  43., 1.9, 392., 63., 5.5, 392., 1.1,
  67., 13., 424., 67., 7.5, 400., 1.2,
  67., 12.9, 408., 67., 13.4, 431., 1.1,
  67., 12.9, 422., 67., 13., 432., 0.9,
  0., 1.7, 301.3, 0., 1.9, 318., 1.2,
  0., 1.7, 301.3, 0., 1.9, 318., 1.2,
  0., 1.7, 301.3, 0., 1.9, 318., 1.2,
  -17., 4.5, 378., 20., 3., 420., 1.3,
  -17., 4.5, 378., 20., 3., 420., 1.3,
  -17., 4.5, 378., 20., 3., 420., 1.3];

fn labViewPose(k u64) Pose {
  imm i = usize.from(k) * 7usize;
  imm y = LAB_Y;
  lookFrom(new Vec3(LAB_VIEW_DATA[i], y + LAB_VIEW_DATA[i + 1usize], LAB_VIEW_DATA[i + 2usize]),
    new Vec3(LAB_VIEW_DATA[i + 3usize], y + LAB_VIEW_DATA[i + 4usize], LAB_VIEW_DATA[i + 5usize]));
}

pub fn labViewFov(opts &RunOptions, f u64) f32 {
  imm k = labWindowOf(opts, f);
  LAB_VIEW_DATA[usize.from(k) * 7usize + 6usize];
}

// Which window frame 'f' is in (the first before the windows, the last after them)
fn labWindowOf(opts &RunOptions, f u64) u64 {
  if opts.labHold > 0u32 { return u64.from(opts.labHold - 1u32); }
  if f < labViewsFrom(opts) { return 0u64; }
  imm k = (f - labViewsFrom(opts)) / LAB_WINDOW;
  if k >= LAB_VIEWS { LAB_VIEWS - 1u64; } else { k; };
}

fn labInViews(opts &RunOptions, f u64) bool {
  f >= labFrom(opts) + LAB_SETTLE - 2u64 and f < labWalkFrom(opts);
}

pub fn labHasView(opts &RunOptions, f u64) bool { opts.labHold > 0u32 and f >= labFrom(opts) + LAB_SETTLE or labInViews(opts, f); }

pub fn labView(st &mut SimState, f u64) Pose { labViewPose(labWindowOf(&st.opts, f)); }

// The pictures: the views' (the fifth frame of each window) and the walk's (the assembly's shot slot is used for them)
const LAB_WALK_SHOTS = 9u32;
imm LAB_WALK_NAMES Array[&str, 9] = ["lab-walk-1", "lab-walk-2", "lab-walk-3", "lab-walk-4", "lab-walk-5", "lab-walk-6", "lab-walk-7",
  "lab-walk-8", "lab-walk-9"];

pub fn labShotAt(opts &RunOptions, asm &Assembly, f u64) &str {
  if opts.labHold > 0u32 { return ""; }
  if f >= labViewsFrom(opts) and f < labWalkFrom(opts) {
    if (f - labViewsFrom(opts)) % LAB_WINDOW == 7u64 { return LAB_VIEW_NAMES[usize.from(labWindowOf(opts, f))]; }
    return "";
  }
  if f >= labWalkFrom(opts) and f == asm.shotFrame and asm.shotFrame > 0u64 { return LAB_WALK_NAMES[usize.from(asm.shotId)]; }
  "";
}

// ---- the script's own state: in the simulation's script run ----

// The place the labyrinth walk is to end at: the top landing of the staircase (the exit's step)
fn labWalkEnd() Vec3 { new Vec3(LAB_STAIR_TOP_X, LAB_Y + LAB_EXIT_UP, LAB_STAIR_TOP_Z); }

// The scene's requests of frame 'f' (after it is presented)
pub fn labDrive(st &mut SimState, f u64) {
  if !labIn(&st.opts, f) { return; }
  imm from = labFrom(&st.opts);
  imm k = f - from;
  if k == 0u64 {
    st.scene.clock.ns = u64.from(nanosOf(7500d));
    st.weather.setNow(WEATHER_FAIR);
    st.cast.possess(1usize);
    imm b = &mut st.cast.beings[1usize];
    b.setDown(new Vec3(LAB_E_X, LAB_Y, LAB_E_Z + 0.9), 3.1415927);
    print <- "The labyrinth's part: the mannequin set down at E ("; print <- LAB_E_X; print <- ", "; print <- LAB_Y; print <- ", "; print <- LAB_E_Z + 0.9;
    print <- ")\n";
    return;
  }
  if st.opts.labHold > 0u32 { return; }
  imm vf = labViewsFrom(&st.opts);
  // The island's light changed at the start of the last four windows: midnight for the first and third, rain at noon for the others
  if f >= vf and (f - vf) % LAB_WINDOW == 0u64 {
    imm w = (f - vf) / LAB_WINDOW;
    if w == 26u64 {
      st.scene.clock.ns = u64.from(nanosOf(f64.from(NIGHT_HOUR - 7.) * 60d));
      st.weather.setNow(WEATHER_FAIR);
    }
    if w == 24u64 or w == 25u64 or w == 27u64 or w == 28u64 {
      st.scene.clock.ns = u64.from(nanosOf(7500d));
      st.weather.setNow(WEATHER_FAIR);
    }
    if w == 29u64 {
      st.scene.clock.ns = u64.from(nanosOf(7500d));
      st.weather.setNow(WEATHER_RAIN);
    }
  }
  imm wf = labWalkFrom(&st.opts);
  if f == wf {
    st.weather.setNow(WEATHER_FAIR);
    st.scene.clock.ns = u64.from(nanosOf(7500d));
    imm b = &mut st.cast.beings[1usize];
    b.setDown(new Vec3(LAB_E_X, LAB_Y, LAB_E_Z + 0.9), 3.1415927);
    // The route from E to the staircase's top on the labyrinth's own navigation mesh
    mut nav = buildLabNav();
    mut pts = List[Vec2].empty();
    imm found = labRoute(&mut nav, new Vec3(LAB_E_X, LAB_Y, LAB_E_Z + 0.9), labWalkEnd(), &mut pts);
    print <- "The labyrinth's navigation mesh: "; print <- nav.triangles; print <- " triangles, "; print <- nav.obstacles; print <- " obstacles, ";
    print <- nav.polygons; print <- " polygons, built in "; print <- f64.from(nav.buildNs) / 1000000d; print <- " ms\n";
    st.route.clear();
    if found {
      mut i = 0usize;
      while i < pts.len() { imm p = *pts[i]; st.route.add(p.x, p.y); i = i + 1usize; }
      print <- "  the route from E to the staircase's top: "; print <- pts.len(); print <- " corners, "; print <- st.route.length(); print <- " m\n";
    } else {
      print <- "  NO route from E to the staircase's top\n";
      st.run.labOk = false;
    }
    st.route.frames = f;
    st.run.labMinY = 1.0e9;
    st.asm.walkShot = 0usize;
    st.run.labDone = false;
  }
  if f == wf + LAB_WALK_FRAMES + 30u64 and !st.run.labDone {
    print <- "The labyrinth walk did NOT reach the staircase's top\n";
    st.run.labOk = false;
    st.run.labDone = true;
  }
}

// The walker's keys for frame 'f' (called with the pushes), and the walk's checks
pub fn labClicks(st &mut SimState, f u64, w &Walk) {
  if !labIn(&st.opts, f) or st.opts.labHold > 0u32 { return; }
  imm wf = labWalkFrom(&st.opts);
  if f == st.asm.tapUpAt and st.asm.tapUpAt > 0u64 { pushKey(st.asm.tapKey, false); }
  if f < wf + 4u64 or st.run.labDone { return; }
  if st.route.points.len() == 0usize { return; }
  if w.position.y < st.run.labMinY { st.run.labMinY = w.position.y; }
  if (f - wf) % 600u64 == 0u64 {
    print <- "  lab walk, frame "; print <- f - wf; print <- ": at ("; print <- w.position.x; print <- ", "; print <- w.position.y - LAB_Y; print <- ", ";
    print <- w.position.z; print <- "), along the route "; print <- *st.route.along[st.route.at]; print <- " of "; print <- st.route.length(); print <- " m\n";
  }
  imm end = labWalkEnd();
  imm arrived = flatDist(w.position.x, w.position.z, end.x, end.z) < 1.2 and w.position.y > end.y - 0.5;
  imm reached = st.route.follow(&mut st.asm, w, 2.5);
  holdAhead(&mut st.asm, !arrived and st.route.go, st.route.fast);
  // pictures from its eyes along the way
  if st.asm.walkShot < usize.from(LAB_WALK_SHOTS) {
    imm frac = f32.from(st.asm.walkShot + 1usize) / f32.from(LAB_WALK_SHOTS + 1u32);
    if *st.route.along[st.route.at] >= frac * st.route.length() {
      takePicture(&mut st.asm, f + 1u64, u32.from(st.asm.walkShot));
      st.asm.walkShot = st.asm.walkShot + 1usize;
    }
  }
  if arrived or reached {
    holdAhead(&mut st.asm, false, false);
    holdTurn(&mut st.asm, 0.);
    st.run.labDone = true;
    imm up = w.position.y - LAB_Y;
    print <- "Frame "; print <- f; print <- ", the labyrinth walk ended at ("; print <- w.position.x; print <- ", "; print <- up; print <- " m up, ";
    print <- w.position.z; print <- ") after "; print <- f - wf; print <- " frames, "; print <- flatDist(w.position.x, w.position.z, end.x, end.z);
    print <- " m from the top landing's place, never farther than "; print <- st.route.dev; print <- " m from the route, the lowest it went "; print <- st.run.labMinY - LAB_Y;
    print <- " m above the antechamber's floor\n";
    if flatDist(w.position.x, w.position.z, end.x, end.z) > 2. or w.position.y < LAB_Y + LAB_EXIT_UP - 0.6 or w.position.y > LAB_Y + LAB_EXIT_UP + 0.6
      or st.run.labMinY < LAB_Y - 0.3 {
      print <- "  the labyrinth walk is WRONG\n";
      st.run.labOk = false;
    }
  }
}
