// The labyrinth's navigation mesh (navmesh, as npcs.cone's island one), for the creatures that will live there: the guards at
// their plinths, the Worm, the Minotaur.
//
// It is made from the plan's own numbers (bakedworld/labrooms.cone through labPlan): the level tops a body walks on (each room's
// floor, each doorway's threshold, every tread of the staircase, its landings, the guards' plinths) as two triangles apiece, and
// what stands on them, the columns, braziers and the basin as circle obstacles, the pillars, throne, benches and parapets as
// boxes. There is no heightfield: the walls are not obstacles because the floor stops at them. The mesh keeps the agent
// the island's gives (a 0.3 m radius, 1.9 m high, a climb of 0.4 m, so a tread of 0.16 m is walked and a bench of 0.55 m is not).
// A route is asked in 3-D (the labyrinth's floors are at different heights over one another's places).

pub fn buildLabNav() NavWorld {
  let t0 = sdl.GetTicksNS();
  let g = labPlan();
  var input = navmesh.NavInput.empty();
  var k = 0usize;
  while k < g.tops.len() {
    let r = *g.tops[k];
    let y = *g.topY[k];
    let p00 = new Vec3(r.x, y, r.y);
    let p10 = new Vec3(r.z, y, r.y);
    let p01 = new Vec3(r.x, y, r.w);
    let p11 = new Vec3(r.z, y, r.w);
    input.addTriangle(p00, p01, p10, navmesh.AreaGround);
    input.addTriangle(p10, p01, p11, navmesh.AreaGround);
    k = k + 1usize;
  }
  var obstacles = 0usize;
  k = 0usize;
  while k < g.circles.len() {
    let c = *g.circles[k];
    input.addCircleObstacle(c.x, c.y, c.z, LAB_Y - 1., LAB_Y + 30., navmesh.AreaNull);
    obstacles = obstacles + 1usize;
    k = k + 1usize;
  }
  k = 0usize;
  while k < g.boxes.len() {
    let b = *g.boxes[k];
    input.addBoxObstacle((b.x + b.z) * 0.5, (b.y + b.w) * 0.5, (b.z - b.x) * 0.5, (b.w - b.y) * 0.5, 0., LAB_Y - 1., LAB_Y + 30., navmesh.AreaNull);
    obstacles = obstacles + 1usize;
    k = k + 1usize;
  }
  var params = navmesh.NavParams.standard();
  // (a little wider than the island's 0.3 m: the capsule is 0.27 and a staircase's parapet ends make corners a route would shave)
  params.agentRadius = NAV_RADIUS + 0.15;
  params.agentHeight = NAV_HEIGHT;
  params.agentMaxClimb = STEP_UP;
  params.agentMaxSlope = NAV_SLOPE;
  params.cellSize = NAV_CELL;
  params.cellHeight = NAV_CELL_HEIGHT;
  let tris = input.triangleCount();
  var nav = navmesh.buildNavMesh(&mut input, &params);
  let polys = nav.polyCount();
  let filter = navmesh.QueryFilter.standard();
  new NavWorld(nav, filter, new Vec3(1.2, 2., 1.2), tris, obstacles, polys, sdl.GetTicksNS() - t0, 0u64, 0u64)
}

// A route from 'from' to 'to' (points on the floors) as corners on the ground plane, 'out' cleared first: whether there is one
// (a partial one is none)
pub fn labRoute(w &mut NavWorld, from Vec3, to Vec3, out &mut List[Vec2]) bool {
  out.clear();
  let r = navmesh.findRoute(&w.nav, from, to, w.ext, &w.filter);
  w.queries = w.queries + 1u64;
  if !r.found or r.partial { return false; }
  var k = 0usize;
  while k < r.points.len() {
    let p = r.points[k].pos;
    out.push(new Vec2(p.x, p.z));
    k = k + 1usize;
  }
  out.len() >= 2usize
}

// Whether the mesh has a polygon within 'radius' metres of the point (the room it stands in is covered there)
pub fn labCovered(w &NavWorld, at Vec3, radius f32) bool {
  let near = navmesh.findNearestPoly(&w.nav, at, radius, 1., radius, &w.filter);
  near.found
}
