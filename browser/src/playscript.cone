// The playground's part of the scripted run, last of all (after the roaming views', frame PLAY_FROM). The player's being is set down
// at the head of the lane facing the rack, and the patrolling villager is brought to stand beside it. The actions are given to the
// simulation as a client's would be (PlaySim.receive, from connection 1), and the views are close-ups from fixed eyes (as the run's
// other close-ups are); a picture is saved at the frames below, counted from PLAY_FROM:
//
//   frame  what happens                                              picture
//       8  the rack, the ball waiting at the head                    play-rack
//      10  the ball is bowled at the apex pin
//      35  the ball a third of the way down the lane                 play-bowl-roll
//      75  the ball has met the pins                                 play-bowl-scatter
//     200  pins and ball lying where they stopped                    play-bowl-lying
//     750  half way through the glide home                           play-reset-glide
//     900  the pins up again, the ball at the head                  play-reset-done
//    1000  paint thrown at the villager                              play-paint-villager (at 1004)
//    1010  paint thrown at the ground in front of the villager       play-paint-ground (at 1014)
//    1020  the villager zapped                                       play-zap (at 1030)
//    1100  the villager made to jig                                  play-jig (at 1130)
//
// The checks are in the frames' own words: the bowl scatters, the reset comes, each spell lands.

pub const PLAY_FROM = FENCE_FROM + FENCE_FRAMES;
pub const PLAY_FRAMES = 1200u64;

fn playIn(f u64) bool { f >= PLAY_FROM and f < PLAY_FROM + PLAY_FRAMES; }

pub fn playShotAt(f u64) &str {
  if !playIn(f) { return ""; }
  imm k = f - PLAY_FROM;
  if k == 8u64 { return "play-rack"; }
  if k == 35u64 { return "play-bowl-roll"; }
  if k == 75u64 { return "play-bowl-scatter"; }
  if k == 200u64 { return "play-bowl-lying"; }
  if k == 750u64 { return "play-reset-glide"; }
  if k == 900u64 { return "play-reset-done"; }
  if k == 1004u64 { return "play-paint-villager"; }
  if k == 1014u64 { return "play-paint-ground"; }
  if k == 1030u64 { return "play-zap"; }
  if k == 1130u64 { return "play-jig"; }
  "";
}

pub fn playHasView(f u64) bool { playIn(f); }

// The villager the spells are cast at
fn playVillager(st &SimState) usize { st.village.npcs[0usize].being; }

pub fn playView(st &SimState, f u64) Pose {
  imm k = f - PLAY_FROM;
  imm isl = &st.land;
  if k < 1000u64 {
    // The rack from the lane's side, 6 m before the apex and 3 m off it, level with a standing person's chest
    imm apex = pinSpot(5usize);
    imm ex = pinSpot(0usize).x + 6.;
    return lookFrom(new Vec3(ex, groundHeight(isl, ex, apex.y + 3.) + 1.6, apex.y + 3.),
      new Vec3(apex.x + 1.5, groundHeight(isl, apex.x, apex.y) + 0.3, apex.y));
  }
  imm v = st.cast.beings[playVillager(st)].body.position;
  if k < 1010u64 {
    return lookFrom(new Vec3(v.x + 3.2, v.y + 1.5, v.z + 2.4), new Vec3(v.x, v.y + 1.1, v.z));
  }
  if k < 1020u64 {
    // The ground the paint lands on, 5 m in front of the player
    imm head = ballHomeSpot();
    return lookFrom(new Vec3(head.x + 1., groundHeight(isl, head.x + 1., head.y + 3.) + 1.9, head.y + 3.),
      new Vec3(head.x - 5., groundHeight(isl, head.x - 5., head.y + 0.5), head.y + 0.5));
  }
  lookFrom(new Vec3(v.x + 3.4, v.y + 1.5, v.z + 2.0), new Vec3(v.x, v.y + 1.0, v.z));
}

// The player's head, where the paint and the aim start
fn playEye(st &SimState) Vec3 {
  imm b = st.cast.beings[st.cast.possessed];
  b.body.position + new Vec3(0., 0.936 * b.figure.height, 0.);
}

fn playAim(from Vec3, to Vec3) Vec3 {
  imm d = to - from;
  imm l = libc.sqrtf(d.x * d.x + d.y * d.y + d.z * d.z);
  new Vec3(d.x / l, d.y / l, d.z / l);
}

pub fn playDrive(st &mut SimState, f u64) {
  if !playIn(f) { return; }
  imm k = f - PLAY_FROM;
  imm vi = playVillager(st);
  if k == 0u64 {
    // The player at the head of the lane, facing the rack; the villager beside it, held where it stands by the jig that follows
    imm head = ballHomeSpot();
    st.cast.possess(RIDER);
    imm b = &mut st.cast.beings[RIDER];
    // (2 m behind the ball, which waits at the head)
    b.setDown(new Vec3(head.x + 2., groundHeight(&st.land, head.x + 2., head.y), head.y), 1.5707964);
    st.play.ok = true;
  }
  // The villager brought to its stop beside the lane just before the spells, and held by them after
  if k == 995u64 {
    imm stop = playgroundStop();
    st.cast.beings[vi].setDown(new Vec3(stop.x, groundHeight(&st.land, stop.x, stop.y), stop.y), 3.1415927);
  }
  if k == 10u64 {
    imm eye = playEye(st);
    imm apex = pinSpot(0usize);
    st.play.receive(st.firstClient(), PLAY_BOWL, 0u32, NO_TARGET, eye, playAim(eye, new Vec3(apex.x, groundHeight(&st.land, apex.x, apex.y) + 0.3, apex.y)));
  }
  if k == 150u64 {
    // The pins have been scattered and have fallen
    mut fell = 0u32;
    imm far = pinsDisturbed(&st.cast.phys, &st.cast.props, &mut fell);
    print <- "Frame "; print <- f; print <- ", the bowl: "; print <- fell; print <- " pins down, the farthest "; print <- far; print <- " m from its place\n";
    if fell < 4u32 or far < 2. { st.play.ok = false; print <- "  the bowl did NOT scatter the pins\n"; }
  }
  if k == 990u64 {
    imm done = propsAllHome(&st.cast.props) and st.cast.props.resets >= 1u32;
    print <- "Frame "; print <- f; print <- ", the reset: "; if done { print <- "every prop home"; } else { print <- "NOT home"; }; print <- "\n";
    if !done { st.play.ok = false; }
  }
  if k == 1000u64 {
    imm eye = playEye(st);
    imm chest = st.cast.beings[vi].body.position + new Vec3(0., 1.2, 0.);
    st.play.receive(st.firstClient(), PLAY_SPELL, SPELL_PAINT, NO_TARGET, eye, playAim(eye, chest));
  }
  if k == 1010u64 {
    imm eye = playEye(st);
    imm head = ballHomeSpot();
    st.play.receive(st.firstClient(), PLAY_SPELL, SPELL_PAINT, NO_TARGET, eye, playAim(eye, new Vec3(head.x - 5., groundHeight(&st.land, head.x - 5., head.y + 0.5), head.y + 0.5)));
  }
  if k == 1020u64 {
    imm eye = playEye(st);
    imm chest = st.cast.beings[vi].body.position + new Vec3(0., 1.2, 0.);
    st.play.receive(st.firstClient(), PLAY_SPELL, SPELL_ZAP, u32.from(vi), eye, playAim(eye, chest));
  }
  if k == 1100u64 {
    imm eye = playEye(st);
    imm chest = st.cast.beings[vi].body.position + new Vec3(0., 1.2, 0.);
    st.play.receive(st.firstClient(), PLAY_SPELL, SPELL_JIG, u32.from(vi), eye, playAim(eye, chest));
  }
  if k == 1150u64 {
    imm good = st.play.paintOnBeings >= 1u32 and st.play.paintOnSurfaces >= 1u32 and st.play.zaps == 1u32 and st.play.jigs == 1u32 and st.play.bowls == 1u32;
    print <- "Frame "; print <- f; print <- ", the spells: "; print <- st.play.paintOnBeings; print <- " paint on a being, "; print <- st.play.paintOnSurfaces;
    print <- " on a surface, "; print <- st.play.zaps; print <- " zap, "; print <- st.play.jigs; print <- " jig, "; print <- st.play.refused; print <- " refused: ";
    if good { print <- "as asked\n"; } else { print <- "NOT as asked\n"; st.play.ok = false; }
  }
}

pub fn checkPlayRun(st &SimState) bool { st.play.ok; }
