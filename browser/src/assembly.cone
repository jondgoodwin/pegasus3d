// The assembly's part of the scripted run: after the vegetation's views (frame
// 1340) the plain walker is set down on the landing beach again and walks the
// whole scene, steered by the script through SDL's own event queue (the same
// W, A, D and Shift keys, never the system's), then the lights and the
// balloon are tried from where a visitor would stand.
//
//   phase                what happens
//   walk                 from the beach to the cottage's steps along the path (Shift and W held,
//                        A and D pressed to follow it); eight pictures from the walker's eye
//                        (first person, level), the first on the beach, the last at the
//                        steps: "walk-01" to "walk-08"
//   to the basket        round the cottage's east end by the lawn route (layout.cone), to
//                        the boarding spot 13 m short of the balloon's basket; the walker
//                        turns to face its open front: "balloon-ready" (the walker's eye),
//                        then "ride-burner", the burner close up
//   board                Tab takes the first mannequin over (third person), set down where
//                        the walker stands; it walks in at the open front (W, steered) to
//                        the basket's middle, standing on its floor (checked: on the
//                        platform, and the world told someone stepped in), and turns about
//                        (A) to face out of the open front
//   the ride             a click on the launch button on the back rail (seen from the third
//                        person's camera); V to first person; the balloon flies its ride
//                        (motions.cone) while the rider stands: every frame, where it
//                        stands on the floor and which way it faces on it are checked not
//                        to drift; "ride-01" to "ride-06" from the rider's eyes at six of
//                        the waypoints, "ride-third" the rider in the basket in the air from
//                        outside it; landed, the balloon is on its spot as it stood
//   step out, back in    V to third person; W out of the open front onto the lawn (the world
//                        told it stepped out), turned about, back in, turned about again
//   the fall             the button pressed again, a second ride; at 70 m up the rider walks
//                        forward out of the open front and falls: "fall-01" stepping off,
//                        "fall-02" falling, "fall-03" landed (the landing's speed checked
//                        against the drop, its health emptied, the hard landing mailed), and
//                        2 s later got up on the landing beach: "fall-04"; the empty balloon
//                        finishes its ride at x10 scene time and lands on its spot
//   back                 the plain walker possessed again; to the steps' foot, facing the door
//   dusk                 the day clock set to 17:48: "dusk-steps" (the door, the windows and
//                        the wall lanterns), then turned about to look down the path
//                        ("dusk-path": the path lanterns); then "lanterns-dusk-approach" (from
//                        22 m out up the path) and "lanterns-dusk-back" (from the steps down it)
//   night                the clock at 23:00; the walker set down 45 m short of the steps,
//                        and walks them: "night-01", "night-02", "night-03", and
//                        "lanterns-night" (from 19 m out up the path)
//
// The keys are held and let go as the walk needs them, so a run is the same
// on every machine (frame's synthetic clock) and a picture is taken when the
// walker is at a place, not at a frame number chosen in advance. Every check
// prints what it measured; the run fails if a phase does not finish.

// The first frame of this part, and the frames the run needs for all of it (a phase that
// has not finished by the end is a failure)
pub const ASM_FROM = 1340u64;
pub const ASM_FRAMES = 19800u64;

const PH_START = 0u32;
const PH_WALK = 1u32;
const PH_STEPS = 2u32;
const PH_TO_BUTTON = 3u32;
const PH_FACE_BASKET = 4u32;
const PH_READY = 5u32;
const PH_BOARD = 6u32;
const PH_WALK_IN = 7u32;
const PH_TURN_OUT = 8u32;
const PH_PRESS = 9u32;
const PH_RIDE = 20u32;
const PH_STEP_OUT = 21u32;
const PH_REBOARD = 22u32;
const PH_PRESS_AGAIN = 23u32;
const PH_STEP_OFF = 24u32;
const PH_FALLING = 25u32;
const PH_DOWN = 26u32;
const PH_EMPTY_RIDE = 27u32;
const PH_RETURN = 28u32;
const PH_BACK = 10u32;
const PH_FACE_DOOR = 11u32;
const PH_DUSK = 12u32;
const PH_FACE_PATH = 13u32;
const PH_DUSK_PATH = 14u32;
const PH_NIGHT_WALK = 15u32;
const PH_NIGHT_END = 16u32;
const PH_SUN = 17u32;
const PH_DONE = 18u32;

// The assembly's script state: the simulation's ('SimState.asm'), made with it, touched only from the scene actor's end of frame
pub struct Assembly {
  pub phase u32;
  pub phaseFrom u64;
  pub asmOk bool;
  pub pictures u32;           // pictures taken by the phases above
  pub walkShot usize;         // the next of the walk's pictures along the path
  pub clickDownAt u64;        // the frame the launch button's click is pressed
  pub keyW bool;              // the keys the script holds
  pub keyShift bool;
  pub keyA bool;
  pub keyD bool;
  pub shotFrame u64;          // the frame whose picture is saved, and what it is called
  pub shotId u32;
  pub viewFrame u64;          // the frame drawn from the script's own eye, and where that is
  pub viewEye Vec3;
  pub viewTarget Vec3;
  pub viewLens f32;
  pub tapKey u32;             // a key tapped, and the frame it is let go
  pub tapUpAt u64;

  pub fn make() Assembly {
    new Assembly(0u32, 0u64, true, 0u32, 0usize, 0u64, false, false, false, false, 0u64, 0u32, 0u64,
      new Vec3(0., 0., 0.), new Vec3(0., 0., 0.), 1.0471976, 0u, 0u64)
  }
}

// The hour the day clock is set to for dusk (17:48 the next evening: the lamps' fade has
// finished, as glowscript.cone's) and for night (23:00)
const EVENING_HOUR f32 = 41.8083;
const NIGHT_HOUR f32 = 47.;

// A heading error within this many radians (0.7 degrees) is left alone; a turn is 1 degree a step
const TURN_BAND f32 = 0.012;

// Walk forward (W), running (Shift too) when 'fast'
fn holdAhead(a &mut Assembly, on bool, fast bool) {
  let run = on and fast;
  if on != a.keyW { a.keyW = on; pushKey(sdl.SCANCODE_W, on); }
  if run != a.keyShift { a.keyShift = run; pushKey(sdl.SCANCODE_LSHIFT, run); }
}

// Turn left while 'err' (radians the target is to the left; negative: to the right) is past the band
fn holdTurn(a &mut Assembly, err f32) {
  let wantA = err > TURN_BAND;
  let wantD = err < 0. - TURN_BAND;
  if wantA != a.keyA { a.keyA = wantA; pushKey(sdl.SCANCODE_A, wantA); }
  if wantD != a.keyD { a.keyD = wantD; pushKey(sdl.SCANCODE_D, wantD); }
}

fn wrapPi(a f32) f32 {
  var x = a;
  while x > pi { x = x - 2. * pi; }
  while x < 0. - pi { x = x + 2. * pi; }
  x
}

fn absF(x f32) f32 { if x < 0. { 0. - x } else { x } }

fn flatDist(ax f32, az f32, bx f32, bz f32) f32 { libc.sqrtf((ax - bx) * (ax - bx) + (az - bz) * (az - bz)) }

// How far left of the walker's heading the point (tx, tz) lies
fn yawError(w &Walk, tx f32, tz f32) f32 {
  let dx = tx - w.position.x;
  let dz = tz - w.position.z;
  wrapPi(libc.atan2f(0. - dx, 0. - dz) - w.yaw)
}

// ---- The route being walked ----

// The route: the simulation's script state ('SimState.route'), made with it, touched only from the scene actor's end of frame
pub struct Route {
  pub points List[Vec2];       // the points to pass through
  pub along List[f32];         // the way along them to each point
  pub at usize;                // the point the walker is nearest, never going back
  pub dev f32;                 // the farthest the walker has been from the route's nearest point
  pub frames u64;              // frames spent on it
  pub fast bool;               // the walker is headed right and may run
  pub go bool;                 // the walker is facing within 30 degrees of the way, else it turns where it stands

  pub fn make() Route { new Route(List[Vec2].empty(), List[f32].empty(), 0usize, 0., 0u64, false, true) }

  fn clear(self &mut) {
    points.clear();
    along.clear();
    at = 0usize;
    dev = 0.;
  }

  // A point on the route; a long step from the last is cut into steps of a metre at most, so the
  // route's nearest point is never far off it
  fn add(self &mut, x f32, z f32) {
    let n = points.len();
    if n > 0usize {
      let p = *points[n - 1usize];
      let d = flatDist(p.x, p.y, x, z);
      if d > 1. {
        let pieces = u32.from(libc.ceilf(d));
        var i = 1u32;
        while i < pieces {
          let t = f32.from(i) / f32.from(pieces);
          self.add(p.x + (x - p.x) * t, p.y + (z - p.y) * t);
          i = i + 1u32;
        }
      }
    }
    let m = points.len();
    if m == 0usize { along.push(0.); }
    else {
      let q = *points[m - 1usize];
      along.push(*along[m - 1usize] + flatDist(q.x, q.y, x, z));
    }
    points.push(new Vec2(x, z));
  }

  // The path from point 'from' to point 'to' of its centreline
  fn fromPath(self &mut, isl &Island, from usize, to usize) {
    self.clear();
    let line = pathCentreline(isl);
    var k = from;
    while k <= to {
      let p = *line[k];
      self.add(p.x, p.z);
      k = k + 1usize;
    }
  }

  fn length(self &) f32 { *along[along.len() - 1usize] }

  // One frame of following the route: the nearest point found, the heading steered towards a
  // point 'ahead' metres further on; true once the last point is within 0.7 m
  fn follow(self &mut, a &mut Assembly, w &Walk, ahead f32) bool {
    let n = points.len();
    var best = at;
    var bestD = flatDist(w.position.x, w.position.z, (*points[best]).x, (*points[best]).y);
    var k = at + 1usize;
    while k < n and *along[k] - *along[at] < 12. {
      let d = flatDist(w.position.x, w.position.z, (*points[k]).x, (*points[k]).y);
      if d < bestD { bestD = d; best = k; }
      k = k + 1usize;
    }
    at = best;
    if bestD > dev { dev = bestD; }
    var j = best;
    while j + 1usize < n and *along[j] - *along[best] < ahead { j = j + 1usize; }
    let target = *points[j];
    let err = yawError(w, target.x, target.y);
    holdTurn(a, err);
    let last = *points[n - 1usize];
    let toGo = flatDist(w.position.x, w.position.z, last.x, last.y);
    // Run only when headed right, on the route, and not close to its end: a run turns in a circle 11 m across
    fast = absF(err) < 0.08 and bestD < 0.6 and toGo > 8.;
    go = absF(err) < 0.5;
    toGo < 0.7
  }
}

// ---- The pictures ----

// The pictures' names (the first eight are the walk's, in order), and the others' places in the list
let SHOT_NAMES Array[&str, 31] = ["walk-01", "walk-02", "walk-03", "walk-04", "walk-05", "walk-06", "walk-07", "walk-08",
  "balloon-ready", "ride-burner", "dusk-steps", "dusk-path", "night-01", "night-02", "night-03",
  "maple-sun-ahead", "maple-sun-behind", "lanterns-dusk-approach", "lanterns-dusk-back", "lanterns-night",
  "ride-01", "ride-02", "ride-03", "ride-04", "ride-05", "ride-06", "ride-third", "fall-01", "fall-02", "fall-03", "fall-04"];
const SHOTS = 31u32;
const SHOT_LANTERNS = 17u32;

// The centreline's point 'd' metres back along the path from its end at the steps' foot (the
// nearest of its points, about a metre apart)
fn pathBack(isl &Island, d f32) Vec3 {
  let line = pathCentreline(isl);
  let k = line.len() - 1usize - usize.from(d + 0.5);
  *line[k]
}

// The door, a little above eye height, for a picture looking up the path
fn doorLookAt(isl &Island) Vec3 { new Vec3(-16., groundHeight(isl, -16., 331.) + 1.9, 331.) }

const SHOT_READY = 8u32;
const SHOT_BURNER = 9u32;
const SHOT_RIDE = 20u32;
const SHOT_RIDE_THIRD = 26u32;
const SHOT_FALL = 27u32;
const SHOT_DUSK_STEPS = 10u32;
const SHOT_DUSK_PATH = 11u32;
const SHOT_NIGHT = 12u32;
// How far along the path (of its length) each picture but the first and last is taken
let WALK_AT Array[f32, 6] = [0.12, 0.26, 0.40, 0.55, 0.70, 0.86];

// A picture of frame 'f' from the walker's eye
fn takePicture(a &mut Assembly, f u64, id u32) {
  a.shotFrame = f;
  a.shotId = id;
  a.pictures = a.pictures + 1u32;
}

// A picture of frame 'f' from 'eye', looking at 'target' through a lens of 'lens' radians
fn takeView(a &mut Assembly, f u64, id u32, eye Vec3, target Vec3, lens f32) {
  takePicture(a, f, id);
  a.viewFrame = f;
  a.viewEye = eye;
  a.viewTarget = target;
  a.viewLens = lens;
}

pub fn asmShotAt(a &Assembly, f u64) &str { if f == a.shotFrame and a.shotFrame > 0u64 { SHOT_NAMES[usize.from(a.shotId)] } else { "" } }
pub fn asmHasView(a &Assembly, f u64) bool { f == a.viewFrame and a.viewFrame > 0u64 }
pub fn asmView(a &Assembly, f u64) Pose { lookFrom(a.viewEye, a.viewTarget) }
pub fn asmFov(a &Assembly, f u64) f32 { a.viewLens }

// ---- The hooks ----

// The walker set down on the beach just before the first frame of this part
pub fn asmDrive(st &mut SimState, f u64) {
  if f != ASM_FROM - 1u64 { return; }
  let cast = &mut st.cast;
  cast.possess(0usize);
  let b = &mut cast.beings[0usize];
  b.setDown(new Vec3(BEACH_X, groundHeight(&st.land, BEACH_X, BEACH_Z), BEACH_Z), 0.);
  // The two mannequins the earlier parts of the run left standing about the lawn and the path are
  // moved off into the eastern forest, out of the pictures
  var k = 1usize;
  while k <= 2usize {
    let m = &mut cast.beings[k];
    let x = 90. + 2. * f32.from(k);
    m.body.position = new Vec3(x, groundHeight(&st.land, x, 400.), 400.);
    m.before = m.body;
    k = k + 1usize;
  }
}

// The day clock set to hour 'h' (hours beyond 24 are the next day's)
fn setHour(st &mut SimState, h f32) {
  st.scene.clock.ns = u64.from(nanosOf(f64.from(h - 7.) * 60.0));
}

// The launch button's click, pressed at 'clickDownAt' and let go two frames after, called with
// the pushes of frame 'f'
pub fn asmClicks(st &mut SimState, f u64, w &Walk) {
  if f < ASM_FROM or st.opts.portalOnly { return; }
  asmStep(st, f, w);
  if f == st.asm.clickDownAt and st.asm.clickDownAt > 0u64 {
    // Where the cap's top is drawn from the camera (the rider's, in third person)
    st.run.clickAt = placeOnView(st.cast.eyes(), FOV, partPoint(&st.scene, st.world.buttonCap(), 0.025), st.view.x, st.view.y);
    pushButton(st.run.clickAt.x, st.run.clickAt.y, true);
  }
  if f == st.asm.clickDownAt + 2u64 and st.asm.clickDownAt > 0u64 { pushButton(st.run.clickAt.x, st.run.clickAt.y, false); }
  if f == st.asm.tapUpAt and st.asm.tapUpAt > 0u64 { pushKey(st.asm.tapKey, false); }
}

// A key pressed for frame 'f' and let go two frames after (Tab, V, F)
fn tap(a &mut Assembly, f u64, key u32) {
  pushKey(key, true);
  a.tapKey = key;
  a.tapUpAt = f + 2u64;
}

fn goTo(a &mut Assembly, next u32, f u64) { a.phase = next; a.phaseFrom = f; }

// The way from the steps' foot to the button along the lawn, or back
fn routeToButton(rt &mut Route, w &Walk) {
  rt.clear();
  rt.add(w.position.x, w.position.z);
  var i = 0usize;
  while i < LAWN_ROUTE_N {
    let p = lawnRouteAt(i);
    rt.add(p.x, p.y);
    i = i + 1usize;
  }
}

fn routeFromButton(isl &Island, rt &mut Route, w &Walk) {
  rt.clear();
  rt.add(w.position.x, w.position.z);
  var i = LAWN_ROUTE_N;
  while i > 0usize {
    i = i - 1usize;
    let p = lawnRouteAt(i);
    rt.add(p.x, p.y);
  }
  let line = pathCentreline(isl);
  let end = *line[line.len() - 1usize];
  rt.add(end.x, end.z);
}

// The balloon's mouth (its envelope's root) in the world
fn balloonMouth(st &mut SimState) Vec3 { st.scene.worldMatrix(st.world.partOf(BALLOON, 0usize)).translation() }


fn say(f u64, what &str) {
  print <- "Frame "; print <- f; print <- ": "; printStr(what); print <- "\n";
}

// The state machine: frame 'f's pushes, from the walker 'w' as the last frame left it
fn asmStep(st &mut SimState, f u64, w &Walk) {
  if (st.asm.phase >= PH_FACE_BASKET and st.asm.phase < PH_BACK) or st.asm.phase >= PH_RIDE {
    // The balloon's ride and the fall from it (ridescript.cone)
    rideStep(st, f, w, f - st.asm.phaseFrom);
    return;
  }
  let scene = &st.scene;
  let world = &st.world;
  let cast = &mut st.cast;
  let sceneNow = st.sceneNow;
  let fired = st.fired;
  let since = f - st.asm.phaseFrom;
  if st.asm.phase == PH_START {
    // Standing on the beach for the first picture, then up the path
    if f == ASM_FROM + 4u64 { takePicture(&mut st.asm, f + 2u64, 0u32); }
    if f == ASM_FROM + 8u64 {
      st.route.fromPath(&st.land, 0usize, pathCentreline(&st.land).len() - 1usize);
      print <- "Frame "; print <- f; print <- ": the walk from the beach begins, a path "; print <- st.route.length(); print <- " m long\n";
      st.route.frames = f;
      st.asm.walkShot = 0usize;
      goTo(&mut st.asm, PH_WALK, f);
    }
    return;
  }
  if st.asm.phase == PH_WALK {
    let arrived = st.route.follow(&mut st.asm, w,4.);
    holdAhead(&mut st.asm, !arrived and st.route.go, st.route.fast);
    if st.asm.walkShot < 6usize and *st.route.along[st.route.at] >= WALK_AT[st.asm.walkShot] * st.route.length() {
      takePicture(&mut st.asm, f + 1u64, u32.from(st.asm.walkShot) + 1u32);
      st.asm.walkShot = st.asm.walkShot + 1usize;
    }
    if arrived { goTo(&mut st.asm, PH_STEPS, f); st.route.frames = f - st.route.frames; }
    elif since > 2600u64 { say(f, "the walk to the steps did NOT finish"); st.asm.asmOk = false; goTo(&mut st.asm, PH_STEPS, f); st.route.frames = since; }
    return;
  }
  if st.asm.phase == PH_STEPS {
    holdTurn(&mut st.asm, 0.);
    if since == 1u64 {
      // Facing the door, at the steps' foot
      takePicture(&mut st.asm, f + 3u64, 7u32);
    }
    if since == 6u64 {
      let line = pathCentreline(&st.land);
      let end = *line[line.len() - 1usize];
      print <- "The walk from the beach to the steps: "; print <- st.route.frames; print <- " frames ("; print <- f64.from(st.route.frames) / 60.0;
      print <- " s) at 12 m/s, never farther than "; print <- st.route.dev; print <- " m from the path's centreline (want under 1.8; its half width is 0.9)\n";
      print <- "  ended "; print <- flatDist(w.position.x, w.position.z, end.x, end.z); print <- " m from the steps' foot ("; print <- end.x;
      print <- ", "; print <- end.z; print <- "), facing "; print <- w.yaw; print <- " rad from -z\n";
      if st.route.dev > 1.8 or flatDist(w.position.x, w.position.z, end.x, end.z) > 1. { st.asm.asmOk = false; print <- "  the walk is WRONG\n"; }
      routeToButton(&mut st.route, w);
      st.route.frames = f;
      goTo(&mut st.asm, PH_TO_BUTTON, f);
    }
    return;
  }
  if st.asm.phase == PH_TO_BUTTON {
    let arrived = st.route.follow(&mut st.asm, w,3.);
    holdAhead(&mut st.asm, !arrived and st.route.go, st.route.fast);
    if arrived { goTo(&mut st.asm, PH_FACE_BASKET, f); }
    elif since > 1500u64 { say(f, "the walk to the basket did NOT finish"); st.asm.asmOk = false; goTo(&mut st.asm, PH_FACE_BASKET, f); }
    return;
  }
  if st.asm.phase == PH_BACK {
    let arrived = st.route.follow(&mut st.asm, w,3.);
    holdAhead(&mut st.asm, !arrived and st.route.go, st.route.fast);
    if arrived { goTo(&mut st.asm, PH_FACE_DOOR, f); }
    elif since > 1500u64 { say(f, "the walk back to the steps did NOT finish"); st.asm.asmOk = false; goTo(&mut st.asm, PH_FACE_DOOR, f); }
    return;
  }
  if st.asm.phase == PH_FACE_DOOR {
    holdTurn(&mut st.asm, yawError(w, -16., 330.));
    if absF(yawError(w, -16., 330.)) <= TURN_BAND and since > 4u64 {
      setHour(st, EVENING_HOUR);
      goTo(&mut st.asm, PH_DUSK, f);
    }
    return;
  }
  if st.asm.phase == PH_DUSK {
    if since == 12u64 { takePicture(&mut st.asm, f + 1u64, SHOT_DUSK_STEPS); }
    if since == 14u64 {
      checkLamps(st, f, "at the steps");
      goTo(&mut st.asm, PH_FACE_PATH, f);
    }
    return;
  }
  if st.asm.phase == PH_FACE_PATH {
    // Turned about to look down the path (the twelve lanterns stand in pairs along its last stretch)
    let err = yawError(w, -16., 380.);
    holdTurn(&mut st.asm, err);
    if absF(err) <= TURN_BAND and since > 8u64 {
      takePicture(&mut st.asm, f + 3u64, SHOT_DUSK_PATH);
      goTo(&mut st.asm, PH_DUSK_PATH, f);
    }
    return;
  }
  if st.asm.phase == PH_DUSK_PATH {
    // The six pairs of lanterns at dusk: from 22 m out up the path to the door, and from the steps
    // back down the rows
    if since == 5u64 {
      let eye = pathBack(&st.land, 22.);
      takeView(&mut st.asm, f + 1u64, SHOT_LANTERNS, new Vec3(eye.x, eye.y + 1.7, eye.z), doorLookAt(&st.land), 0.9);
    }
    if since == 9u64 {
      let foot = pathBack(&st.land, 0.);
      let far = pathBack(&st.land, 16.);
      takeView(&mut st.asm, f + 1u64, SHOT_LANTERNS + 1u32, new Vec3(foot.x, foot.y + 2.1, foot.z), new Vec3(far.x, far.y + 0.5, far.z), 0.9);
    }
    if since == 12u64 {
      // Night: the clock at 23:00, and the walker set down 45 m short of the steps on the path, facing them
      checkLamps(st, f, "looking down the path");
      setHour(st, NIGHT_HOUR);
      let line = pathCentreline(&st.land);
      let n = line.len();
      st.route.fromPath(&st.land, n - 46usize, n - 1usize);
      let from = *st.route.points[0usize];
      let next = *st.route.points[3usize];
      let b = &mut cast.beings[0usize];
      b.setDown(new Vec3(from.x, groundHeight(&st.land, from.x, from.y), from.y), wrapPi(libc.atan2f(0. - (next.x - from.x), 0. - (next.y - from.y))));
      holdTurn(&mut st.asm, 0.);
      takePicture(&mut st.asm, f + 8u64, SHOT_NIGHT);
      st.route.frames = f;
      st.asm.walkShot = 0usize;
      goTo(&mut st.asm, PH_NIGHT_WALK, f);
    }
    return;
  }
  if st.asm.phase == PH_NIGHT_WALK {
    // The rows by night, from 19 m out up the path to the door
    if since == 9u64 {
      let eye = pathBack(&st.land, 19.);
      takeView(&mut st.asm, f + 1u64, SHOT_LANTERNS + 2u32, new Vec3(eye.x, eye.y + 1.7, eye.z), doorLookAt(&st.land), 0.9);
    }
    if since < 10u64 { return; }
    let arrived = st.route.follow(&mut st.asm, w,5.);
    holdAhead(&mut st.asm, !arrived and st.route.go, st.route.fast);
    if st.asm.walkShot == 0usize and *st.route.along[st.route.at] >= 0.5 * st.route.length() {
      takePicture(&mut st.asm, f + 1u64, SHOT_NIGHT + 1u32);
      st.asm.walkShot = 1usize;
    }
    if arrived { goTo(&mut st.asm, PH_NIGHT_END, f); }
    elif since > 1200u64 { say(f, "the night walk did NOT finish"); st.asm.asmOk = false; goTo(&mut st.asm, PH_NIGHT_END, f); }
    return;
  }
  if st.asm.phase == PH_NIGHT_END {
    holdTurn(&mut st.asm, 0.);
    if since == 1u64 { takePicture(&mut st.asm, f + 3u64, SHOT_NIGHT + 2u32); }
    if since == 8u64 {
      let line = pathCentreline(&st.land);
      let end = *line[line.len() - 1usize];
      print <- "Frame "; print <- f; print <- ", the night walk (the clock at "; print <- hourAt(scene.now()); print <- " h): "; print <- f - st.route.frames;
      print <- " frames, never farther than "; print <- st.route.dev; print <- " m from the path; ended ";
      print <- flatDist(w.position.x, w.position.z, end.x, end.z); print <- " m from the steps' foot\n";
      if st.route.dev > 1.8 or flatDist(w.position.x, w.position.z, end.x, end.z) > 1. { st.asm.asmOk = false; print <- "  the night walk is WRONG\n"; }
      checkLamps(st, f, "at the steps by night");
      // Then noon again, for the autumn maple with the sun behind it and in front of it
      setHour(st, 60.);
      goTo(&mut st.asm, PH_SUN, f);
    }
    return;
  }
  if st.asm.phase == PH_SUN {
    // The first specimen maple, 14 m off at eye height: looking south into the noon sun (the tree
    // between), and looking north with the sun behind the eye
    let m = vegItem(&st.land, K_SPECIMEN, 0usize);
    let target = new Vec3(m.x, m.y + 5., m.z);
    if since == 10u64 {
      takeView(&mut st.asm, f + 1u64, SHOT_NIGHT + 3u32, new Vec3(m.x + 2., groundHeight(&st.land, m.x + 2., m.z - 14.) + 1.7, m.z - 14.), target, 1.0471976);
    }
    if since == 20u64 {
      takeView(&mut st.asm, f + 1u64, SHOT_NIGHT + 4u32, new Vec3(m.x + 2., groundHeight(&st.land, m.x + 2., m.z + 14.) + 1.7, m.z + 14.), target, 1.0471976);
    }
    if since == 24u64 { goTo(&mut st.asm, PH_DONE, f); }
    return;
  }
}

// The lamps: on, the bulb's glow the hour's (and the room behind a window lit, the path lantern's
// pool lit), as the glow script checks them
fn checkLamps(st &mut SimState, f u64, place &str) {
  let scene = &st.scene;
  let lights = &st.world.lights;
  let want = nitsAt(hourAt(scene.now()));
  let bulb = lights.sentNits(0usize);
  let room = lights.sentNits(2usize);
  let pool = lights.lantern;
  print <- "Frame "; print <- f; print <- ", the lights "; printStr(place); print <- ", the day clock at "; print <- hourAt(scene.now());
  print <- " h: "; if lights.on { print <- "on"; } else { print <- "OFF"; }
  print <- ", the bulb "; print <- bulb; print <- " nits (want "; print <- want; print <- "), a lit room "; print <- room;
  print <- " nits (want "; print <- want * GLOW_ROOM; print <- "), a lantern's light "; print <- pool; print <- " cd\n";
  let ok = lights.on and lights.level == 1. and bulb > want * 0.98 and bulb < want * 1.02 and room > want * GLOW_ROOM * 0.98
    and room < want * GLOW_ROOM * 1.02 and pool > 0.;
  if !ok { print <- "  the lamps are WRONG\n"; st.asm.asmOk = false; }
}

// The checks the state machine has not made as it went: the last frame finds it done, every
// picture taken
pub fn checkAssembly(a &mut Assembly, f u64, w &Walk) bool {
  if f == ASM_FROM + ASM_FRAMES - 2u64 {
    print <- "The assembly's walk: "; print <- a.pictures; print <- " pictures taken (want "; print <- SHOTS; print <- "), the last phase "; print <- a.phase;
    print <- " (want "; print <- PH_DONE; print <- ")\n";
    if a.phase != PH_DONE or a.pictures != SHOTS { a.asmOk = false; print <- "  the assembly's run did NOT finish\n"; }
  }
  a.asmOk
}
