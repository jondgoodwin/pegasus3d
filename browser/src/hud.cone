// The HUD: an overlay of a hotbar, a minimap and a status panel, laid out by
// uilayout and drawn after tone mapping by hudshader.slang (its shapes) and
// msdftext (its text). It is presentational and lives with the view: the view
// actor hands it a HudFrame each frame (what to show: the clock, the weather,
// the frame time, where the beings are, which F-keys were pressed) in the
// DrawOrder, and the render actor, which owns the GPU, holds it and draws it.
// Nothing here is game state: the hotbar's slots are placeholders that do
// nothing but cool down, and the minimap reads positions the view already has.
//
// KEYS. U hides and shows the HUD; F1 to F8 use the hotbar's slots. Nothing
// else is bound to them (walk.cone and browser.cone bind W A S D H, the arrows,
// Space, Shift, V, Tab, PageUp, PageDown, P, F, T, B and N; Escape and F11 are the
// window's). F9 and J open the "Play with others" panel (requestpanel.cone), which takes
// the keyboard and the mouse while it is up and is the HUD's only input.
//
// SCALE. The Ui is laid out in logical units and drawn at 'scale' pixels a unit
// (the display's scale, 1.5 at 150 %; PEGASUS_UI_SCALE overrides it): the draw
// list is multiplied by it, and the text is laid out at the pixel size, so
// that the signed distance field is read at its true size and stays sharp.
//
// THE MAP is a texture of the island seen from above, painted once at start-up
// from the height grid, the path's distance, the brook and the vegetation's
// layout (north, -z, up; the whole island, 2 m a texel), with the minimap
// frame showing the window of it round the player.
//
// FONT. Inter Regular (fonts/Inter-Regular.ttf, SIL Open Font Licence) is bundled and
// read first; where it cannot be read the HUD falls back to Segoe UI, or Arial, or
// Cascadia Mono from the system's font folder, and draws its shapes without text
// where none can be read. Every HUD text is one style, so only Regular is loaded
// (Inter-SemiBold.ttf is shipped for a label that wants weight).
//
// THE DRAW ORDER is every shape, then every text; a shape is never above text.

// ---- keys ----

pub const SCANCODE_H = 11u;
// The hints of the keys worth pressing (HudFrame.hintKeys): S sits, S stands, H hails
pub const HINT_SIT = 1u32;
pub const HINT_STAND = 2u32;
pub const HINT_HAIL = 4u32;
// How near someone is for H to be worth a hint, metres
pub const HAIL_HINT_RANGE f32 = 9.;
pub const SCANCODE_F1 = 58u;      // F1 to F8 are 58 to 65
pub const HOTBAR_SLOTS = 8u32;

// The map texture's handle in the draw list
const MAP_TEX = 7u32;

// ---- what the view tells the HUD each frame ----

pub struct HudFrame {
  pub on bool;                // shown (U toggles it)
  pub hour f32;               // the day clock, hours
  pub weather u32;            // the weather's state it goes to (WEATHER_...)
  pub frameMs f32;            // the smoothed frame time; 0: not shown (a scripted run's is not repeatable)
  pub connected bool;         // a connection to a server, not single player
  pub rttMs i64;
  pub you Vec3;               // the being the user drives
  pub yaw f32;                // and its heading (walk.cone's: 0 faces -z)
  pub others List[Vec3];      // the other beings
  pub keys u32;               // bit n: F(n+1) was pressed this frame
  pub dt f32;
  pub tags List[HudTag];      // the players' names, each at a point in the world (above a head)
  pub eye Pose;               // the camera they are seen from
  pub fov f32;                // and its vertical field of view
  pub events List[PanelEvent]; // the keys, text and mouse the "Play with others" panel is given this frame (requestpanel.cone)
  pub hint bool;              // show the one-line hint naming the panel's key
  pub joinFailed String;      // the panel's Join did not get in: why (said once; empty: nothing to say)
  pub talkNear u32 = 0xFFFFFFFFu32;   // the labyrinth's guards (talkpanel.cone's TalkFrame): the one within reach (CR_NONE: none) ...
  pub talkAsked bool = false;         // ... this visitor has had its question ...
  pub talkSeq u32 = 0u32;             // ... replies it has had ...
  pub talkReply u32 = 0u32;           // ... and the last one's line code
  pub hintKeys u32 = 0u32;            // the keys worth a hint now: HINT_SIT (a seat is in reach), HINT_STAND (it is on one), HINT_HAIL (someone is near)

  pub fn none() HudFrame {
    new HudFrame(false, 12., WEATHER_FAIR, 0., false, 0i64, new Vec3(0., 0., 0.), 0., List[Vec3].empty(), 0u32, 0.,
      List[HudTag].empty(), Pose.look(new Vec3(0., 0., 0.), 0., 0.), 1., List[PanelEvent].empty(), false, String.empty())
  }
}

// A name to put over the point 'at' of the world
pub struct HudTag {
  pub at Vec3;
  pub name String;
  pub speech bool = false;    // words someone is saying (a guard's answer, the Worm's line): shown even with the HUD hidden
  pub clear bool = true;      // a line from the eye to the point meets nothing (the view casts a ray through the physics world's statics); a plate
                              // with no clear line fades out, and back in when there is one
}

// How fast a plate fades, in and out: 1 / seconds (about 0.17 s from clear to gone)
const PLATE_FADE_RATE = 6.;

// The labyrinth's plan on the minimap, below ground: a fixed window on the rooms (a 140 m square about the middle of the plan: x -55..85,
// z 296.5..436.5), as the walkable rectangles the navigation mesh is made from (labPlan().tops), the floors darker and the upper levels lighter
const PLAN_CX = 15.;
const PLAN_CZ = 366.5;
const PLAN_SPAN = 140.;

// How many names the HUD can show at once (a server holds at most MAX_PLAYERS), and how far away one is still read
const PLATES = 8usize;
const PLATE_RANGE = 80.;

fn freshPlateFades() List[f32] {
  var l = List[f32].empty();
  var i = 0usize;
  while i < PLATES { l.push(0. - 1.); i = i + 1usize; }
  l
}

// 'c' with its alpha scaled by 'k'
fn fadedColor(c u32, k f32) u32 {
  let a = f32.from(c & 255u32) * k;
  (c & 0xffffff00u32) | u32.from(fclamp(a + 0.5, 0., 255.))
}

// The commands of the node 'a' or 'b' in 'list' faded by 'k' (a plate's panel and its label)
fn fadeNodes(list &mut uilayout.DrawList, a usize, b usize, k f32) {
  var i = 0usize;
  while i < list.cmds.len() {
    let c = list.cmds[i];
    if c.node == u32.from(a) or c.node == u32.from(b) {
      var d = *c;
      d.color = fadedColor(d.color, k);
      list.cmds.set(i, d);
    }
    i = i + 1usize;
  }
}

// Whether the HUD starts shown: not in a scripted run (hudscript.cone turns it on), and not with PEGASUS_HUD=off
// (to time the picture without it)
pub fn hudStartsShown(scripted bool) bool {
  let env = libc.getenv("PEGASUS_HUD");
  // (PEGASUS_HUD=on shows it in a scripted run too, to look at it in the other parts of the run: the minimap below ground in the walk)
  if scripted { return (env as usize) != 0usize and libc.strcmp(cstr.fromPtr(env), "on") == 0i32; }
  if (env as usize) != 0usize { return libc.strcmp(cstr.fromPtr(env), "off") != 0i32; }
  true
}

// What the view keeps for the HUD: whether it is shown, and the frame time
pub struct HudView {
  pub on bool;
  lastNs u64;
  lastMs f32;
  pub smoothMs f32;

  pub fn make(on bool) HudView { new HudView(on, 0u64, 0., 0.) }

  // Once a frame: the time since the last, smoothed over about ten frames
  pub fn tick(self &mut) {
    let now = sdl.GetTicksNS();
    if lastNs != 0u64 {
      let ms = f32.from(now - lastNs) / 1000000.;
      lastMs = ms;
      smoothMs = if smoothMs == 0. { ms } else { smoothMs * 0.9 + ms * 0.1 };
    }
    lastNs = now;
  }

  // The last frame's length, seconds (for the hotbar's cooldowns)
  pub fn stepSeconds(self &) f32 { fmin(lastMs, 100.) / 1000. }
}

// ---- the island seen from above ----

const MAP_SIDE = 1025usize;

fn packRgb(r f32, g f32, b f32) u32 {
  (u32.from(fclamp(r, 0., 255.)) << 16u32) | (u32.from(fclamp(g, 0., 255.)) << 8u32) | u32.from(fclamp(b, 0., 255.))
}

fn mixf(a f32, b f32, t f32) f32 { a + (b - a) * t }
fn fmin(a f32, b f32) f32 { if a < b { a } else { b } }
fn fmax(a f32, b f32) f32 { if a > b { a } else { b } }
fn fclamp(v f32, lo f32, hi f32) f32 { fmin(fmax(v, lo), hi) }

// The island's top-down picture as RGBA8, row 0 at -z (the grids' own order)
pub fn buildMapPixels(isl &Island) List[u8] {
  let heights = heightGrid(isl);
  let paths = pathGrid(isl);
  let side = MAP_SIDE;
  var rgb = List[u32].withCapacity(side * side);
  var j = 0usize;
  while j < side {
    var i = 0usize;
    while i < side {
      let at = j * side + i;
      let h = *heights[at];
      // Relief shading: the slope towards the north-west light, from the neighbours
      let il = if i > 0usize { i - 1usize } else { i };
      let ir = if i + 1usize < side { i + 1usize } else { i };
      let ju = if j > 0usize { j - 1usize } else { j };
      let jd = if j + 1usize < side { j + 1usize } else { j };
      let hl = *heights[j * side + il];
      let hr = *heights[j * side + ir];
      let hu = *heights[ju * side + i];
      let hd = *heights[jd * side + i];
      let slope = ((hl - hr) + (hu - hd)) / (4. * CELL);
      let shade = fclamp(1. + slope * 1.6, 0.55, 1.35);
      var r = 0.;
      var g = 0.;
      var b = 0.;
      if h < -0.15 {
        // The sea, deeper darker
        let t = fclamp((0. - h) / 18., 0., 1.);
        r = mixf(70., 18., t);
        g = mixf(140., 58., t);
        b = mixf(172., 104., t);
      } else {
        let sand = fclamp(1. - (h - 0.2) / 2.2, 0., 1.);
        let up = fclamp((h - 6.) / 30., 0., 1.);
        // Grass, higher ground greener-grey, a shore of sand
        r = mixf(mixf(104., 128., up), 218., sand) * shade;
        g = mixf(mixf(146., 136., up), 202., sand) * shade;
        b = mixf(mixf(84., 104., up), 150., sand) * shade;
        // The path
        let pd = *paths[at];
        let onPath = fclamp((2.6 - pd) / 1.4, 0., 1.);
        r = mixf(r, 226. * shade, onPath);
        g = mixf(g, 204. * shade, onPath);
        b = mixf(b, 150. * shade, onPath);
      }
      rgb.push(packRgb(r, g, b));
      i = i + 1usize;
    }
    j = j + 1usize;
  }
  // The trees and rocks, as discs
  let items = vegetationLayout(isl);
  var k = 0usize;
  while k < items.len() {
    let it = items[k];
    let tree = it.kind == K_MAPLE or it.kind == K_PINE or it.kind == K_SPECIMEN;
    let rock = it.kind == K_ROCK;
    if tree or rock {
      let cx = (it.x + HALF) / CELL;
      let cz = (it.z + HALF) / CELL;
      let rad = if tree { fmax(1.2, it.radius * 0.8 / CELL) } else { 0.9 };
      let col = if it.kind == K_PINE { packRgb(38., 84., 62.) } elif tree { packRgb(80., 120., 54.) } else { packRgb(128., 124., 118.) };
      let x0 = i32.from(libc.floorf(cx - rad));
      let x1 = i32.from(libc.ceilf(cx + rad));
      let z0 = i32.from(libc.floorf(cz - rad));
      let z1 = i32.from(libc.ceilf(cz + rad));
      var zz = z0;
      while zz <= z1 {
        var xx = x0;
        while xx <= x1 {
          if xx >= 0i32 and zz >= 0i32 and xx < i32.from(side) and zz < i32.from(side) {
            let dx = f32.from(xx) - cx;
            let dz = f32.from(zz) - cz;
            if dx * dx + dz * dz <= rad * rad { rgb.set(usize.from(zz) * side + usize.from(xx), col); }
          }
          xx = xx + 1i32;
        }
        zz = zz + 1i32;
      }
    }
    k = k + 1usize;
  }
  // The brook, a blue line
  let pts = brookPoints(isl);
  var p = 0usize;
  while p + 1usize < pts.len() {
    let a = pts[p];
    let b = pts[p + 1usize];
    let span = (new Vec2(b.x - a.x, b.z - a.z)).length();
    let steps = 1i32 + i32.from(span / (CELL * 0.5));
    var s = 0i32;
    while s <= steps {
      let t = f32.from(s) / f32.from(steps);
      let ix = i32.from((mixf(a.x, b.x, t) + HALF) / CELL + 0.5);
      let iz = i32.from((mixf(a.z, b.z, t) + HALF) / CELL + 0.5);
      if ix >= 0i32 and iz >= 0i32 and ix < i32.from(side) and iz < i32.from(side) {
        rgb.set(usize.from(iz) * side + usize.from(ix), packRgb(70., 132., 190.));
      }
      s = s + 1i32;
    }
    p = p + 1usize;
  }
  var out = List[u8].withCapacity(side * side * 4usize);
  var n = 0usize;
  while n < rgb.len() {
    let c = *rgb[n];
    out.push(u8.from((c >> 16u32) & 255u32));
    out.push(u8.from((c >> 8u32) & 255u32));
    out.push(u8.from(c & 255u32));
    out.push(255u8);
    n = n + 1usize;
  }
  out
}

// ---- the font ----

// The font the HUD reads: the bundled Inter Regular (fonts/Inter-Regular.ttf, in the source tree the program was built from or
// beside the program), else the system's, or none where none can be read (the HUD then draws its shapes and no text)
fn loadHudFont() Option[Font] {
  var names = List[String].empty();
  // The program is build/release/browser.exe in the source tree (fonts/ is two folders up), or has fonts/ beside it
  match process.currentExe() {
    case let exe Ok {
      let dir = exe.parent();
      let beside = dir.join("fonts/Inter-Regular.ttf");
      let tree = dir.parent().parent().join("fonts/Inter-Regular.ttf");
      names.push(String.from(beside.view()));
      names.push(String.from(tree.view()));
    }
    else {}
  }
  names.push(String.from("fonts/Inter-Regular.ttf"));
  names.push(String.from("C:/Windows/Fonts/segoeui.ttf"));
  names.push(String.from("C:/Windows/Fonts/arial.ttf"));
  names.push(String.from("C:/Windows/Fonts/CascadiaMono.ttf"));
  names.push(String.from("/usr/share/fonts/truetype/dejavu/DejaVuSans.ttf"));
  var found Option[Font] = None;
  var have = false;
  var i = 0usize;
  while i < names.len() {
    if !have {
      let file = Path.from(names[i].view());
      match fs.readFile(&file) {
        case let bytes Ok {
          match Font.load(bytes.view()) {
            case let f Ok {
              found = Some[Font](f);
              have = true;
            }
            else {}
          }
        }
        else {}
      }
    }
    i = i + 1usize;
  }
  found
}

// ---- the model: the Ui and what it shows ----

fn rgbaOf(r u32, g u32, b u32, a u32) u32 { (r << 24u32) | (g << 16u32) | (b << 8u32) | a }

pub struct HudModel {
  pub ui Ui;
  pub font Option[Font];
  pub atlas Atlas;
  pub scale f32;
  pub list uilayout.DrawList;
  logicalW f32;
  logicalH f32;
  status usize;
  timeLabel usize;
  frameLabel usize;
  modeLabel usize;
  mapFrame usize;
  placeLabel usize;
  bar usize;
  plates List[usize];         // the panels that carry players' names, one label inside each (hidden when unused)
  plateLabels List[usize];
  placePanel usize;           // the panel under the minimap
  hintLabel usize;            // the one line naming the "Play with others" key (hidden unless asked for)
  keysLabel usize;            // the line naming the keys worth pressing now: S sits on a seat in reach, S stands, H hails someone near
  pub rp RequestPanel;        // the "Play with others" panel (requestpanel.cone), on top of the rest
  pub tp TalkPanel;           // the dialogue with a guard (talkpanel.cone), likewise
  talkNear bool;              // a guard was within reach at the last frame (render's word to the shell, PANEL_NEAR)
  plateFade List[f32];        // each plate's opacity now, 0 to 1 (eased towards its tag's clear line)
  planTops List[Vec4];        // the labyrinth's walkable rectangles (x0, z0, x1, z1) ...
  planY List[f32];            // ... and the height of each

  // A HUD for a target of 'width' by 'height' pixels at 'scale' pixels a logical unit
  pub fn make(width f32, height f32, scale f32) HudModel {
    let font = loadHudFont();
    var atlas = Atlas.create(AtlasConfig.standard());
    var ui = Ui.make(width / scale, height / scale);
    // The look: a dark glass, over the picture
    let panelStyle = ui.theme.find("panel");
    let glass = ui.theme.style("hud", panelStyle);
    ui.theme.setColor(glass, uilayout.P_BG, 0u32, rgbaOf(9u32, 13u32, 20u32, 170u32));
    ui.theme.setColor(glass, uilayout.P_BORDER, 0u32, rgbaOf(150u32, 162u32, 184u32, 130u32));
    ui.theme.setNum(glass, uilayout.P_BORDER_W, 0u32, 1.);
    ui.theme.setNum(glass, uilayout.P_RADIUS, 0u32, 8.);
    ui.theme.setNum(glass, uilayout.P_PAD, 0u32, 10.);
    ui.theme.setNum(glass, uilayout.P_SPACING, 0u32, 3.);
    let hotbarStyle = ui.theme.find("hotbar");
    ui.theme.setColor(hotbarStyle, uilayout.P_BG, 0u32, rgbaOf(9u32, 13u32, 20u32, 170u32));
    ui.theme.setColor(hotbarStyle, uilayout.P_BG, uilayout.ST_HOVER, rgbaOf(30u32, 36u32, 48u32, 190u32));
    ui.theme.setColor(hotbarStyle, uilayout.P_BORDER, 0u32, rgbaOf(150u32, 162u32, 184u32, 150u32));
    ui.theme.setNum(hotbarStyle, uilayout.P_BORDER_W, 0u32, 1.5);
    ui.theme.setNum(hotbarStyle, uilayout.P_RADIUS, 0u32, 6.);
    ui.theme.setNum(hotbarStyle, uilayout.P_SIZE, 0u32, 46.);
    let mapStyle = ui.theme.find("minimap");
    ui.theme.setColor(mapStyle, uilayout.P_BORDER, 0u32, rgbaOf(170u32, 180u32, 200u32, 200u32));
    ui.theme.setNum(mapStyle, uilayout.P_BORDER_W, 0u32, 1.5);
    ui.theme.setNum(mapStyle, uilayout.P_RADIUS, 0u32, 8.);

    // The status panel, top left
    let status = uilayout.panel(&mut ui, ui.root, "hud");
    ui.setFlex(status, uilayout.LK_COLUMN, 3.);
    ui.setAnchors(status, 0., 0., 0., 0.);
    ui.setPivot(status, 0., 0.);
    ui.setOffsets(status, 14., 14., 0., 0.);
    ui.setSize(status, 172., uilayout.AUTO);
    let timeLabel = uilayout.label(&mut ui, status, "12:00   fair");
    let frameLabel = uilayout.label(&mut ui, status, "-- ms");
    let modeLabel = uilayout.label(&mut ui, status, "single player");
    let hintLabel = uilayout.label(&mut ui, status, "F9   play with others");
    ui.setVisible(hintLabel, false);
    let keysLabel = uilayout.label(&mut ui, status, "S   sit");
    ui.setVisible(keysLabel, false);

    // The minimap, top right, and where the player is under it
    let mapFrame = uilayout.minimap(&mut ui, ui.root, 176., MAP_TEX);
    ui.setAnchors(mapFrame, 1., 0., 1., 0.);
    ui.setPivot(mapFrame, 1., 0.);
    ui.setOffsets(mapFrame, -14., 14., 0., 0.);
    uilayout.minimapSetShape(&mut ui, mapFrame, uilayout.MAP_RECT);
    uilayout.minimapSetView(&mut ui, mapFrame, 0.5, 0.5, 6.);
    let placePanel = uilayout.panel(&mut ui, ui.root, "hud");
    ui.setPadding(placePanel, 8., 3., 8., 3.);
    ui.setAnchors(placePanel, 1., 0., 1., 0.);
    ui.setPivot(placePanel, 1., 0.);
    ui.setOffsets(placePanel, -14., 196., 0., 0.);
    let placeLabel = uilayout.label(&mut ui, placePanel, "x 0   z 0");

    // The hotbar, bottom centre: F1 to F8. F1 to F3 hold placeholders (a coloured square
    // that does nothing but cool down for a second and a half); the rest are empty
    let bar = uilayout.hotbar(&mut ui, ui.root, HOTBAR_SLOTS);
    ui.setAnchors(bar, 0.5, 1., 0.5, 1.);
    ui.setPivot(bar, 0.5, 1.);
    ui.setOffsets(bar, 0., -16., 0., 0.);
    uilayout.hotbarBind(&mut ui, uilayout.hotbarSlot(&ui, bar, 0u32), uilayout.BK_SPELL, 1u32, 0u32, 0xf0b43cffu32, 1.5);
    uilayout.hotbarBind(&mut ui, uilayout.hotbarSlot(&ui, bar, 1u32), uilayout.BK_SPELL, 2u32, 0u32, 0x46c8beffu32, 1.5);
    uilayout.hotbarBind(&mut ui, uilayout.hotbarSlot(&ui, bar, 2u32), uilayout.BK_SPELL, 3u32, 0u32, 0xa078e6ffu32, 1.5);
    // The players' name plates: a small glass panel each, put over a mannequin's head when there is one to name
    var plates = List[usize].empty();
    var plateLabels = List[usize].empty();
    var pl = 0usize;
    while pl < PLATES {
      let panel = uilayout.panel(&mut ui, ui.root, "hud");
      ui.setPadding(panel, 6., 2., 6., 2.);
      ui.setAnchors(panel, 0., 0., 0., 0.);
      ui.setPivot(panel, 0.5, 1.);
      let text = uilayout.label(&mut ui, panel, "name");
      ui.setVisible(panel, false);
      plates.push(panel);
      plateLabels.push(text);
      pl = pl + 1usize;
    }
    // The "Play with others" panel last, so that it is on top of everything
    let rp = RequestPanel.build(&mut ui);
    let tp = TalkPanel.build(&mut ui);
    // (the labyrinth's plan for the minimap below ground; the same call the navigation mesh is made from)
    var plan = labPlan();
    var tops = List[Vec4].empty();
    var topY = List[f32].empty();
    tops <=> plan.tops;
    topY <=> plan.topY;
    new HudModel(ui, font, atlas, scale, uilayout.DrawList.make(), width / scale, height / scale, status, timeLabel, frameLabel,
      modeLabel, mapFrame, placeLabel, bar, plates, plateLabels, placePanel, hintLabel, keysLabel, rp, tp, false, freshPlateFades(), tops, topY)
  }

  // The HUD brought up to the frame and its draw list made (in logical units; 'scale' makes pixels)
  pub fn update(self &mut, f &HudFrame, width f32, height f32) {
    if width / scale != logicalW or height / scale != logicalH {
      logicalW = width / scale;
      logicalH = height / scale;
      ui.setViewport(logicalW, logicalH);
    }
    // The panel's input first: the keys, text and mouse the shell handed over (only while it is up, or to open it)
    if rp.apply(&mut ui, &f.events, logicalW, logicalH) {
      // (just opened: laid out now, so that a mouse event later in the same frame finds its controls)
      ui.setViewport(logicalW, logicalH);
      relayout(&mut ui, &font, &mut atlas, scale);
    }
    // ... and the guard's dialogue, which E opens when a guard is within reach
    let talk = new TalkFrame(f.talkNear, f.talkAsked, f.talkSeq, f.talkReply);
    talkNear = talk.near != CR_NONE;
    if tp.apply(&mut ui, &f.events, logicalW, logicalH, &talk) {
      ui.setViewport(logicalW, logicalH);
      relayout(&mut ui, &font, &mut atlas, scale);
    }
    // Keys: F1 to F8 use a slot
    var n = 0u32;
    while n < HOTBAR_SLOTS {
      if (f.keys & (1u32 << n)) != 0u32 {
        let used = uilayout.keyDown(&mut ui, uilayout.KEY_F1 + n, 0u32);
      }
      n = n + 1u32;
    }
    uilayout.update(&mut ui, f.dt);
    let events = ui.takeEvents();
    rp.settle(&mut ui, &events);
    tp.settle(&mut ui, &events, &talk);
    rp.joined(&mut ui, f.connected, &f.joinFailed);
    // The HUD's own parts give way to the panel while it is up (and to U)
    let hudShown = f.on and !rp.open and !tp.open;
    ui.setVisible(status, hudShown);
    ui.setVisible(mapFrame, hudShown);
    ui.setVisible(placePanel, hudShown);
    ui.setVisible(bar, hudShown);
    ui.setVisible(hintLabel, f.hint and !rp.approved);
    // The keys worth pressing now (a seat in reach, a seat taken, someone to hail)
    {
      var keys = String.empty();
      if (f.hintKeys & HINT_SIT) != 0u32 { keys.append("S   sit"); }
      if (f.hintKeys & HINT_STAND) != 0u32 { keys.append("S   stand up"); }
      if (f.hintKeys & HINT_HAIL) != 0u32 {
        if keys.len() > 0usize { keys.append("    "); }
        keys.append("H   hail");
      }
      ui.setVisible(keysLabel, hudShown and keys.len() > 0usize);
      if keys.len() > 0usize { ui.setText(keysLabel, keys.view()); }
    }
    // The words
    ui.setText(timeLabel, hudClock(f.hour, f.weather).view());
    ui.setText(frameLabel, hudFrameText(f.frameMs).view());
    ui.setText(modeLabel, hudMode(f.connected, f.rttMs).view());
    // Below the island (the one test, underground()) the coordinates are the labyrinth's own, and the map is its plan
    let below = underground(f.you.y);
    var place = String.from(if below { "below ground   x " } else { "x " });
    place.appendInt(i64.from(libc.floorf(f.you.x + 0.5)));
    place.append("   z ");
    place.appendInt(i64.from(libc.floorf(f.you.z + 0.5)));
    ui.setText(placeLabel, place.view());
    // The map: the window round the player, and the beings on it. Below ground the frame shows the labyrinth's plan, fixed (the whole
    // plan fits), in the plan's own units (u, v from the window's corner); the island's picture is not drawn then (tex 0), the plan is
    // spliced in after the frame
    uilayout.minimapSetTexture(&mut ui, mapFrame, if below { 0u32 } else { MAP_TEX });
    let span = if below { PLAN_SPAN } else { 2. * HALF };
    let ox = if below { PLAN_CX - PLAN_SPAN * 0.5 } else { 0. - HALF };
    let oz = if below { PLAN_CZ - PLAN_SPAN * 0.5 } else { 0. - HALF };
    let u = (f.you.x - ox) / span;
    let v = (f.you.z - oz) / span;
    if below { uilayout.minimapSetView(&mut ui, mapFrame, 0.5, 0.5, 1.); }
    else { uilayout.minimapSetView(&mut ui, mapFrame, u, v, 6.); }
    uilayout.minimapClearMarkers(&mut ui, mapFrame);
    var o = 0usize;
    while o < f.others.len() {
      let at = f.others[o];
      let marker = uilayout.minimapAddMarker(&mut ui, mapFrame, (at.x - ox) / span, (at.z - oz) / span, 0xe8503cffu32, 8.);
      o = o + 1usize;
    }
    // (a small tick ahead of the player shows the heading: walk.cone's forward is (-sin yaw, -cos yaw))
    let ahead = if below { 5. } else { 16. };
    let tick = uilayout.minimapAddMarker(&mut ui, mapFrame, (f.you.x - sin(f.yaw) * ahead - ox) / span,
      (f.you.z - cos(f.yaw) * ahead - oz) / span, 0xffd84affu32, 4.);
    let me = uilayout.minimapAddMarker(&mut ui, mapFrame, u, v, 0xffffffffu32, 9.);
    // The players' names over their heads (in front of the camera and within PLATE_RANGE; not hidden behind anything)
    var pn = 0usize;
    while pn < PLATES {
      var shown = false;
      // (a plate's opacity eases to 1 with a clear line from the eye to its point, and to 0 without one: a fade, not a pop)
      let wantFade f32 = if pn < f.tags.len() and f.tags[pn].clear { 1. } else { 0. };
      let stepFade = PLATE_FADE_RATE * f.dt;
      // (a plate that was unused begins at its target: it appears clear or not at all; only a plate that is on goes through the fade)
      let nowFade = if *plateFade[pn] < 0. { wantFade } else { *plateFade[pn] };
      if pn >= f.tags.len() { plateFade.set(pn, 0. - 1.); }
      else { plateFade.set(pn, if wantFade > nowFade { fmin(nowFade + stepFade, wantFade) } else { fmax(nowFade - stepFade, wantFade) }); }
      if pn < f.tags.len() {
        let seen = f.eye.orientation.inverse() * (f.tags[pn].at - f.eye.origin);
        if seen.z < 0. - 0.3 and seen.length() < PLATE_RANGE {
          let px = placeOnView(f.eye, f.fov, f.tags[pn].at, width, height);
          if px.x > 0. and px.x < width and px.y > 0. and px.y < height {
            let shownName = f.tags[pn].name.copy();   // (a copy: setText may change the Ui's own strings)
            ui.setText(*plateLabels[pn], shownName.view());
            ui.setOffsets(*plates[pn], px.x / scale, px.y / scale, 0., 0.);
            shown = true;
          }
        }
      }
      ui.setVisible(*plates[pn], shown and *plateFade[pn] > 0.003 and !tp.open and !rp.open and (hudShown or (pn < f.tags.len() and f.tags[pn].speech)));
      pn = pn + 1usize;
    }
    relayout(&mut ui, &font, &mut atlas, scale);
    uilayout.drawUi(&ui, &mut list);
    pn = 0usize;
    while pn < PLATES {
      if *plateFade[pn] < 0.999 { fadeNodes(&mut list, *plates[pn], *plateLabels[pn], *plateFade[pn]); }
      pn = pn + 1usize;
    }
    if below { self.splicePlan(); }
    if hudShown { drawSpellIcons(&ui, bar, &mut list); }
  }

  // The labyrinth's plan, drawn inside the minimap frame's clip, over its backing and under its markers: each walkable rectangle of the
  // plan (labPlan().tops) in a tone by its height, the higher levels lighter, so that the staircase's flights and landings read over the
  // court they climb out of
  fn splicePlan(self &mut) {
    let n = ui.nodes[mapFrame];
    var plan = uilayout.DrawList.make();
    let ox = PLAN_CX - PLAN_SPAN * 0.5;
    let oz = PLAN_CZ - PLAN_SPAN * 0.5;
    let tones = [0xa89a7effu32, 0xbfae8affu32, 0xd2c09affu32, 0xe4d2aaffu32, 0xf2e4c0ffu32];
    var band = 0usize;
    while band < 5usize {
      var k = 0usize;
      while k < planTops.len() {
        let r = *planTops[k];
        let up = *planY[k] - LAB_Y;
        let b = if up < 0.6 { 0usize } elif up < 4. { 1usize } elif up < 8. { 2usize } elif up < 12. { 3usize } else { 4usize };
        if b == band {
          let x0 = n.gx + (r.x - ox) / PLAN_SPAN * n.w;
          let y0 = n.gy + (r.y - oz) / PLAN_SPAN * n.h;
          let x1 = n.gx + (r.z - ox) / PLAN_SPAN * n.w;
          let y1 = n.gy + (r.w - oz) / PLAN_SPAN * n.h;
          plan.rect(x0, y0, fmax(x1 - x0, 0.6), fmax(y1 - y0, 0.6), tones[band], 0., mapFrame);
        }
        k = k + 1usize;
      }
      band = band + 1usize;
    }
    var out = List[uilayout.DrawCmd].empty();
    var i = 0usize;
    while i < list.cmds.len() {
      out.push(*list.cmds[i]);
      // (the frame's clip is the push with the frame's own rectangle)
      if list.cmds[i].kind == uilayout.DC_CLIP_PUSH and list.cmds[i].x == n.gx and list.cmds[i].y == n.gy and list.cmds[i].w == n.w {
        var p = 0usize;
        while p < plan.cmds.len() { out.push(*plan.cmds[p]); p = p + 1usize; }
      }
      i = i + 1usize;
    }
    list.cmds = out;
  }
}

// The icons of the hotbar's first three slots, drawn by hand over the slots (the hotbar's own icons are images, which this overlay's
// renderer draws only for the map): a splat of paint with its drops (F1), a lightning bolt (F2), a dancer (F3)
fn drawSpellIcons(ui &Ui, bar usize, out &mut uilayout.DrawList) {
  var n = 0u32;
  while n < 3u32 {
    let slot = uilayout.hotbarSlot(ui, bar, n);
    let node = ui.nodes[slot];
    let cx = node.gx + node.w * 0.5;
    let cy = node.gy + node.h * 0.52;
    let u = node.w * 0.5 - 6.;
    if n == 0u32 {
      let paint = 0xf2268cffu32;
      out.arc(cx - u * 0.1, cy + u * 0.05, u * 0.55, 0., 6.2831855, paint, 0., slot);
      out.arc(cx + u * 0.62, cy - u * 0.5, u * 0.2, 0., 6.2831855, paint, 0., slot);
      out.arc(cx - u * 0.7, cy - u * 0.55, u * 0.16, 0., 6.2831855, paint, 0., slot);
      out.arc(cx + u * 0.15, cy + u * 0.78, u * 0.14, 0., 6.2831855, paint, 0., slot);
      out.arc(cx - u * 0.75, cy + u * 0.45, u * 0.11, 0., 6.2831855, paint, 0., slot);
    } elif n == 1u32 {
      let bolt = 0xffe53cffu32;
      out.line(cx + u * 0.35, cy - u * 0.95, cx - u * 0.35, cy + u * 0.05, bolt, 3.5, slot);
      out.line(cx - u * 0.35, cy + u * 0.05, cx + u * 0.3, cy + u * 0.05, bolt, 3.5, slot);
      out.line(cx + u * 0.3, cy + u * 0.05, cx - u * 0.3, cy + u * 0.95, bolt, 3.5, slot);
    } else {
      let dancer = 0x6ee0d2ffu32;
      out.arc(cx, cy - u * 0.72, u * 0.2, 0., 6.2831855, dancer, 0., slot);
      out.line(cx, cy - u * 0.45, cx, cy + u * 0.2, dancer, 3., slot);
      out.line(cx, cy - u * 0.3, cx - u * 0.7, cy - u * 0.7, dancer, 3., slot);
      out.line(cx, cy - u * 0.3, cx + u * 0.65, cy - u * 0.05, dancer, 3., slot);
      out.line(cx, cy + u * 0.2, cx - u * 0.45, cy + u * 0.85, dancer, 3., slot);
      out.line(cx, cy + u * 0.2, cx + u * 0.55, cy + u * 0.5, dancer, 3., slot);
    }
    n = n + 1u32;
  }
}

// The Ui laid out, text measured at its pixel size through the font and the atlas
fn relayout(ui &mut Ui, font &Option[Font], atlas &mut Atlas, scale f32) {
  var m = fn(t &str, face u32, size f32) Vec2 {
    var answer = new Vec2(f32.from(t.len()) * size * 0.5, size * 1.3);
    match font {
      case let f Some {
        let lay = layoutText(f, atlas, t, &LayoutOptions.make(size * scale));
        answer = new Vec2(lay.width / scale, lay.height / scale);
      }
      else {}
    }
    answer
  };
  uilayout.layout(ui, &mut m);
}

fn twoDigits(s &mut String, n u32) {
  if n < 10u32 { s.append("0"); }
  s.appendUInt(u64.from(n));
}

// "12:34   fair"
pub fn hudClock(hour f32, weather u32) String {
  let minutes = u32.from(libc.floorf(hour * 60. + 0.5)) % 1440u32;
  var s = String.empty();
  twoDigits(&mut s, minutes / 60u32);
  s.append(":");
  twoDigits(&mut s, minutes % 60u32);
  s.append("   ");
  s.append(weatherName(weather));
  s
}

// "6.4 ms   156 fps", or a note where the frame time is not shown
pub fn hudFrameText(ms f32) String {
  var s = String.empty();
  if ms <= 0. {
    s.append("frame time off");
    return s;
  }
  let tenths = u32.from(libc.floorf(ms * 10. + 0.5));
  s.appendUInt(u64.from(tenths / 10u32));
  s.append(".");
  s.appendUInt(u64.from(tenths % 10u32));
  s.append(" ms   ");
  s.appendUInt(u64.from(u32.from(libc.floorf(1000. / ms + 0.5))));
  s.append(" fps");
  s
}

pub fn hudMode(connected bool, rttMs i64) String {
  var s = String.empty();
  if connected {
    s.append("connected   ");
    s.appendInt(rttMs);
    s.append(" ms");
  } else {
    s.append("single player");
  }
  s
}

// ---- the GPU side ----

const PRIM_FLOATS = 24usize;
const PRIM_BYTES = 96u64;

// sRGB to linear, one channel
fn toLinear(c f32) f32 {
  if c <= 0.04045 { c / 12.92 } else { libc.powf((c + 0.055) / 1.055, 2.4) }
}

fn toLinearIf(srgb bool, c f32) f32 { if srgb { toLinear(c) } else { c } }

// A packed 0xRRGGBBAA colour as four floats, straight alpha, sRGB
fn pushColor(data &mut List[f32], c u32) {
  data.push(f32.from((c >> 24u32) & 255u32) / 255.);
  data.push(f32.from((c >> 16u32) & 255u32) / 255.);
  data.push(f32.from((c >> 8u32) & 255u32) / 255.);
  data.push(f32.from(c & 255u32) / 255.);
}

// One text of the draw list as the HUD keeps it: what it was made from, and its glyphs' quads placed on the screen, in pixels
struct TextEntry {
  x f32;
  y f32;
  w f32;
  h f32;
  color u32;
  size f32;
  align u32;
  text String;
  quads List[GlyphQuad];
  version u64;                // changes when the entry is made again
}

// 'entry' made again for command 'd' with the words 's': laid out at the pixel size, placed in its box, on whole pixels so
// that a label does not swim as the layout moves it
fn placeText(entry &mut TextEntry, font &Option[Font], atlas &mut Atlas, s &str, d &DrawCmd, scale f32, version u64) {
  entry.x = d.x;
  entry.y = d.y;
  entry.w = d.w;
  entry.h = d.h;
  entry.color = d.color;
  entry.size = d.size;
  entry.align = d.align;
  entry.text.clear();
  entry.text.append(s);
  entry.quads.clear();
  entry.version = version;
  match font {
    case let f Some {
      let lay = layoutText(f, atlas, s, &LayoutOptions.make(d.size * scale));
      var x = d.x * scale;
      if d.align == uilayout.TA_CENTER { x = x + (d.w * scale - lay.width) * 0.5; }
      elif d.align == uilayout.TA_RIGHT { x = x + d.w * scale - lay.width; }
      let px = libc.floorf(x + 0.5);
      let py = libc.floorf(d.y * scale + (d.h * scale - lay.height) * 0.5 + 0.5);
      var i = 0usize;
      while i < lay.quads.len() {
        let q = lay.quads[i];
        entry.quads.push(new GlyphQuad(q.x0 + px, q.y0 + py, q.x1 + px, q.y1 + py, q.u0, q.v0, q.u1, q.v1));
        i = i + 1usize;
      }
    }
    else {}
  }
}

struct HudGpu {
  shader ShaderModule;
  groupLayout BindGroupLayout;
  layout PipelineLayout;
  pipeline RenderPipeline;
  sampler Sampler;
  uniforms Buffer;
  texture Texture;
  view TextureView;
  group BindGroup;
  instances Buffer;
  capacity u32;
  srgb bool;
  text TextRenderer;
  slots List[TextHandle];          // one text slot (one draw) for each size and colour in use
  entries List[TextEntry];         // the list's texts, in order, as last made
  version u64;                     // the last version given to an entry
  sigs List[u64];                  // what each slot was last set from
  pub drawCalls u32;
  pub primitives u32;
  pub glyphs u32;
  pub nsData u64;                  // where the CPU time of a frame goes: the shapes' data, their upload, the texts, the two passes
  pub nsUpload u64;
  pub nsText u64;
  pub nsPass1 u64;
  pub nsPass2 u64;

  // The list's shapes drawn, then its texts, into 'target'
  fn render(self &mut, device &mut Device, encoder &mut CommandEncoder, target &Texture, model &mut HudModel, w f32, h f32) {
    let tStart = sdl.GetTicksNS();
    let scale = model.scale;
    var data = List[f32].withCapacity(model.list.cmds.len() * PRIM_FLOATS);
    var clips = List[f32].empty();
    var clip0 = -1000000.;
    var clip1 = -1000000.;
    var clip2 = 1000000.;
    var clip3 = 1000000.;
    var count = 0u32;
    var i = 0usize;
    while i < model.list.cmds.len() {
      let d = model.list.cmds[i];
      let k = d.kind;
      if k == uilayout.DC_CLIP_PUSH {
        clips.push(clip0);
        clips.push(clip1);
        clips.push(clip2);
        clips.push(clip3);
        clip0 = fmax(clip0, d.x * scale);
        clip1 = fmax(clip1, d.y * scale);
        clip2 = fmin(clip2, (d.x + d.w) * scale);
        clip3 = fmin(clip3, (d.y + d.h) * scale);
      } elif k == uilayout.DC_CLIP_POP {
        if clips.len() >= 4usize {
          let top = clips.len() - 4usize;
          clip0 = *clips[top];
          clip1 = *clips[top + 1usize];
          clip2 = *clips[top + 2usize];
          clip3 = *clips[top + 3usize];
          clips.pop();
          clips.pop();
          clips.pop();
          clips.pop();
        }
      } elif k == uilayout.DC_RECT or k == uilayout.DC_BORDER or (k == uilayout.DC_IMAGE and d.tex == MAP_TEX) {
        let x = d.x * scale;
        let y = d.y * scale;
        let pw = d.w * scale;
        let ph = d.h * scale;
        let kind = if k == uilayout.DC_RECT { 0. } elif k == uilayout.DC_BORDER { 1. } else { 4. };
        data.push(x - 2.);
        data.push(y - 2.);
        data.push(x + pw + 2.);
        data.push(y + ph + 2.);
        data.push(x + pw * 0.5);
        data.push(y + ph * 0.5);
        data.push(pw * 0.5);
        data.push(ph * 0.5);
        pushColor(&mut data, d.color);
        data.push(kind);
        data.push(d.radius * scale);
        data.push(d.thick * scale);
        data.push(0.);
        data.push(d.u0);
        data.push(d.v0);
        data.push(d.u1);
        data.push(d.v1);
        data.push(clip0);
        data.push(clip1);
        data.push(clip2);
        data.push(clip3);
        count = count + 1u32;
      } elif k == uilayout.DC_LINE {
        let ax = d.x * scale;
        let ay = d.y * scale;
        let ex = d.w * scale;
        let ey = d.h * scale;
        let pad = d.thick * scale + 2.;
        data.push(fmin(ax, ex) - pad);
        data.push(fmin(ay, ey) - pad);
        data.push(fmax(ax, ex) + pad);
        data.push(fmax(ay, ey) + pad);
        data.push(ax);
        data.push(ay);
        data.push(ex);
        data.push(ey);
        pushColor(&mut data, d.color);
        data.push(2.);
        data.push(0.);
        data.push(d.thick * scale);
        data.push(0.);
        data.push(0.);
        data.push(0.);
        data.push(0.);
        data.push(0.);
        data.push(clip0);
        data.push(clip1);
        data.push(clip2);
        data.push(clip3);
        count = count + 1u32;
      } elif k == uilayout.DC_ARC {
        let cx = d.x * scale;
        let cy = d.y * scale;
        let r = d.w * scale;
        let reach = r + d.thick * scale * 0.5 + 2.;
        data.push(cx - reach);
        data.push(cy - reach);
        data.push(cx + reach);
        data.push(cy + reach);
        data.push(cx);
        data.push(cy);
        data.push(r);
        data.push(d.a0);
        pushColor(&mut data, d.color);
        data.push(3.);
        data.push(0.);
        data.push(d.thick * scale);
        data.push(d.a1);
        data.push(0.);
        data.push(0.);
        data.push(0.);
        data.push(0.);
        data.push(clip0);
        data.push(clip1);
        data.push(clip2);
        data.push(clip3);
        count = count + 1u32;
      }
      i = i + 1usize;
    }
    let tA = sdl.GetTicksNS();
    // (whether the target is sRGB rides with its size)
    let srgbFlag = if srgb { 1. } else { 0. };
    var params = new Array[f32, 4] <- w, h, srgbFlag, 0.;
    device.queue.writeBuffer(&uniforms, 0u64, &params as *u8, 16u64);
    if count > capacity {
      device.queue.releaseBuffer(&mut instances);
      capacity = count * 2u32;
      instances = device.createBuffer(u64.from(capacity) * PRIM_BYTES, BUFFER_USAGE_VERTEX | BUFFER_USAGE_COPY_DST);
    }
    if count > 0u32 {
      let raw *f32 = data.view() as *f32;
      device.queue.writeBuffer(&instances, 0u64, raw as *u8, u64.from(count) * PRIM_BYTES);
    }
    let tB = sdl.GetTicksNS();
    // The texts, one slot each, set again only where they changed
    self.syncText(device, model, w, h);
    let tC = sdl.GetTicksNS();
    primitives = count;
    let color = new RenderPassColorAttachment(view: target.createView(), loadOp: LOAD_OP_LOAD, clearValue: new Color(0., 0., 0., 0.));
    var pass = encoder.beginRenderPass(&color);
    if count > 0u32 {
      pass.setPipeline(&pipeline);
      pass.setBindGroup(0u32, &group);
      pass.setVertexBuffer(0u32, &instances, 0u64);
      pass.draw(6u32, count, 0u32, 0u32);
      drawCalls = drawCalls + 1u32;
    }
    pass.end();
    let tD = sdl.GetTicksNS();
    text.renderOverlay(encoder, target);
    drawCalls = drawCalls + text.drawCalls;
    glyphs = u32.from(text.glyphs);
    let tE = sdl.GetTicksNS();
    nsData = nsData + (tA - tStart);
    nsUpload = nsUpload + (tB - tA);
    nsText = nsText + (tC - tB);
    nsPass1 = nsPass1 + (tD - tC);
    nsPass2 = nsPass2 + (tE - tD);
  }

  // The list's texts into the text renderer's slots. Each text is laid out once, when its words, place or colour change;
  // the texts of one size and colour are drawn as one (one slot, one draw: the passes' fixed costs are what a frame pays for)
  fn syncText(self &mut, device &mut Device, model &mut HudModel, w f32, h f32) {
    let scale = model.scale;
    // The entries brought up to the list's texts
    var n = 0usize;
    var i = 0usize;
    while i < model.list.cmds.len() {
      let d = model.list.cmds[i];
      if d.kind == uilayout.DC_TEXT {
        let s = model.list.textOf(i);
        if n >= entries.len() {
          entries.push(new TextEntry(0., 0., 0., 0., 0u32, 0., 0u32, String.empty(), List[GlyphQuad].empty(), 0u64));
        }
        let same = entries[n].x == d.x and entries[n].y == d.y and entries[n].w == d.w and entries[n].h == d.h
          and entries[n].color == d.color and entries[n].size == d.size and entries[n].align == d.align
          and entries[n].text.view() == s and entries[n].version != 0u64;
        if !same {
          version = version + 1u64;
          placeText(&mut entries[n], &model.font, &mut model.atlas, s, d, scale, version);
        }
        n = n + 1usize;
      }
      i = i + 1usize;
    }
    while entries.len() > n { entries.pop(); }
    text.syncAtlas(device, &model.atlas);
    // The groups: a size and a colour each, and a signature of the entries in them
    var gSize = List[f32].empty();
    var gColor = List[u32].empty();
    var gSig = List[u64].empty();
    var e = 0usize;
    while e < entries.len() {
      let en = entries[e];
      var g = 0usize;
      var found = false;
      while g < gSize.len() and !found {
        if *gSize[g] == en.size and *gColor[g] == en.color { found = true; } else { g = g + 1usize; }
      }
      if !found {
        gSize.push(en.size);
        gColor.push(en.color);
        gSig.push(0u64);
      }
      let sig = *gSig[g];
      gSig.set(g, (sig << 7u64) ^ (sig >> 3u64) ^ (en.version << 8u64) ^ u64.from(e));
      e = e + 1usize;
    }
    // Each group's slot, set again only if what is in it has changed
    var g = 0usize;
    while g < gSize.len() {
      while slots.len() <= g { slots.push(text.addText(device, SPACE_OVERLAY)); }
      while sigs.len() <= g { sigs.push(0u64); }
      if *sigs[g] != *gSig[g] {
        var quads = List[GlyphQuad].empty();
        var m = 0usize;
        while m < entries.len() {
          if entries[m].size == *gSize[g] and entries[m].color == *gColor[g] {
            var q = 0usize;
            while q < entries[m].quads.len() {
              quads.push(*entries[m].quads[q]);
              q = q + 1usize;
            }
          }
          m = m + 1usize;
        }
        let lay = new TextLayout(List[PlacedGlyph].empty(), quads, List[LineInfo].empty(), 0., 0., 0., *gSize[g] * scale);
        let rgba = *gColor[g];
        var style = TextStyle.plain(new Color(toLinearIf(srgb, f32.from((rgba >> 24u32) & 255u32) / 255.),
          toLinearIf(srgb, f32.from((rgba >> 16u32) & 255u32) / 255.), toLinearIf(srgb, f32.from((rgba >> 8u32) & 255u32) / 255.),
          f32.from(rgba & 255u32) / 255.));
        style.shadowColor = new Color(0., 0., 0., 0.55);
        style.shadowOffset = new Vec2(scale, scale);
        style.shadowSoftness = scale * 1.5;
        // (the quads are already on the screen, in pixels: the block's own origin is the screen's)
        text.set(device, *slots[g], &lay, &style, overlayTransform(w, h, 0., 0.));
        sigs.set(g, *gSig[g]);
      }
      g = g + 1usize;
    }
    // Slots no longer used draw nothing
    while g < slots.len() {
      text.clearText(*slots[g]);
      if g < sigs.len() { sigs.set(g, 0u64); }
      g = g + 1usize;
    }
  }
}

// The pixels a logical unit is drawn at: the window's display scale (1.5 at 150 %), or PEGASUS_UI_SCALE where it is set. The
// scripted panel run (panelscript.cone) uses the same to aim its mouse.
pub fn hudUiScale(window usize) f32 {
  var scale = 1.;
  if window != 0usize {
    let s = sdl.GetWindowDisplayScale(window as *u8 as *sdl.Window);
    if s >= 1. { scale = s; }
  }
  let env = libc.getenv("PEGASUS_UI_SCALE");
  if (env as usize) != 0usize {
    var whole = 0.;
    var frac = 0.;
    var div = 1.;
    var seenDot = false;
    var k = 0usize;
    while *(env + k) != 0u8 {
      let ch = *(env + k);
      if ch == '.' { seenDot = true; }
      elif ch >= '0' and ch <= '9' {
        if seenDot {
          div = div * 10.;
          frac = frac + f32.from(ch - '0') / div;
        } else {
          whole = whole * 10. + f32.from(ch - '0');
        }
      }
      k = k + 1usize;
    }
    if whole + frac >= 0.5 { scale = whole + frac; }
  }
  scale
}

pub struct Hud {
  pub model HudModel;
  gpu HudGpu;
  pub ready bool;
  repeat u32;
  modelNs u64;
  recordNs u64;
  drawn u64;

  // The HUD for a swapchain of 'format', 'width' by 'height' pixels, at the display's scale (or PEGASUS_UI_SCALE)
  pub fn make(device &mut Device, window usize, format u32, width u32, height u32, isl &Island) Hud {
    let scale = hudUiScale(window);
    let began = sdl.GetPerformanceCounter();
    var model = HudModel.make(f32.from(width), f32.from(height), scale);
    // Fields for the printable ASCII now, not in the middle of a frame (3 ms a glyph)
    match &model.font {
      case let f Some {
        var cp = 32u32;
        while cp < 127u32 {
          model.atlas.ensure(f, f.glyphOf(cp));
          cp = cp + 1u32;
        }
      }
      else {}
    }
    var shader = device.createShaderModule(&HUD_SPIRV);
    let entries = [new BindGroupLayoutEntry(binding: 0u32, visibility: SHADER_STAGE_VERTEX | SHADER_STAGE_FRAGMENT),
      new BindGroupLayoutEntry(binding: 1u32, visibility: SHADER_STAGE_FRAGMENT, kind: BINDING_KIND_TEXTURE),
      new BindGroupLayoutEntry(binding: 2u32, visibility: SHADER_STAGE_FRAGMENT, kind: BINDING_KIND_SAMPLER)];
    var groupLayout = device.createBindGroupLayout(&entries);
    let groupLayouts = [&groupLayout];
    var layout = device.createPipelineLayout(&groupLayouts, 0u32);
    let attributes = [new VertexAttribute(VERTEX_FORMAT_FLOAT32X4, 0u64, 0u32),
      new VertexAttribute(VERTEX_FORMAT_FLOAT32X4, 16u64, 1u32),
      new VertexAttribute(VERTEX_FORMAT_FLOAT32X4, 32u64, 2u32),
      new VertexAttribute(VERTEX_FORMAT_FLOAT32X4, 48u64, 3u32),
      new VertexAttribute(VERTEX_FORMAT_FLOAT32X4, 64u64, 4u32),
      new VertexAttribute(VERTEX_FORMAT_FLOAT32X4, 80u64, 5u32)];
    let buffers = [new VertexBufferLayout(arrayStride: PRIM_BYTES, stepMode: VERTEX_STEP_MODE_INSTANCE, attributes: &attributes)];
    let desc = new RenderPipelineDescriptor(layout: &layout, vertexModule: &shader, vertexEntryPoint: "vertexMain",
      buffers: &buffers, fragmentModule: &shader, fragmentEntryPoint: "fragmentMain", colorFormat: format,
      blendEnabled: true, colorSrcFactor: BLEND_FACTOR_ONE, colorDstFactor: BLEND_FACTOR_ONE_MINUS_SRC_ALPHA,
      alphaSrcFactor: BLEND_FACTOR_ONE, alphaDstFactor: BLEND_FACTOR_ONE_MINUS_SRC_ALPHA);
    var pipeline = device.createRenderPipeline(&desc);
    let samplerDesc = new SamplerDescriptor(addressModeU: ADDRESS_MODE_CLAMP_TO_EDGE, addressModeV: ADDRESS_MODE_CLAMP_TO_EDGE,
      addressModeW: ADDRESS_MODE_CLAMP_TO_EDGE);
    var sampler = device.createSampler(&samplerDesc);
    var uniforms = device.createBuffer(16u64, BUFFER_USAGE_UNIFORM | BUFFER_USAGE_COPY_DST);
    let textureDesc = new TextureDescriptor(u32.from(MAP_SIDE), u32.from(MAP_SIDE), TEXTURE_FORMAT_RGBA8_UNORM,
      TEXTURE_USAGE_TEXTURE_BINDING | TEXTURE_USAGE_COPY_DST);
    var texture = device.createTexture(&textureDesc);
    let pixels = buildMapPixels(isl);
    device.queue.writeTexture(&texture, pixels.view() as *u8, u32.from(MAP_SIDE) * 4u32);
    var view = texture.createView();
    let bindings = [BindGroupEntry.buffer(0u32, &uniforms), BindGroupEntry.texture(1u32, &view), BindGroupEntry.sampler(2u32, &sampler)];
    var group = device.createBindGroup(&groupLayout, &bindings);
    var instances = device.createBuffer(PRIM_BYTES * 64u64, BUFFER_USAGE_VERTEX | BUFFER_USAGE_COPY_DST);
    var text = TextRenderer.create(device, &model.atlas, format, TEXTURE_FORMAT_RGBA16_FLOAT, TEXTURE_FORMAT_DEPTH32_FLOAT);
    let srgb = format == TEXTURE_FORMAT_BGRA8_UNORM_SRGB or format == TEXTURE_FORMAT_RGBA8_UNORM_SRGB;
    let ok = pipeline.isValid() and texture.isValid() and text.isValid();
    var gpu = new HudGpu(shader, groupLayout, layout, pipeline, sampler, uniforms, texture, view, group, instances, 64u32, srgb,
      text, List[TextHandle].empty(), List[TextEntry].empty(), 0u64, List[u64].empty(), 0u32, 0u32, 0u32, 0u64, 0u64, 0u64, 0u64, 0u64);
    print <- "The HUD: made in "; print <- f64.from(sdl.GetPerformanceCounter() - began) * 1000d / f64.from(sdl.GetPerformanceFrequency());
    print <- " ms (the island's map and the font's glyphs); drawn at "; print <- scale; print <- " pixels a unit\n";
    var repeat = 1u32;
    let rep = libc.getenv("PEGASUS_HUD_REPEAT");
    if (rep as usize) != 0usize {
      var n = 0u32;
      var r = 0usize;
      while *(rep + r) >= '0' and *(rep + r) <= '9' {
        n = n * 10u32 + u32.from(*(rep + r) - '0');
        r = r + 1usize;
      }
      if n > 0u32 { repeat = n; }
    }
    new Hud(model, gpu, ok, repeat, 0u64, 0u64, 0u64)
  }

  // The HUD drawn into 'target' (its contents kept) from the frame
  pub fn draw(self &mut, device &mut Device, encoder &mut CommandEncoder, target &Texture, f &HudFrame) {
    gpu.drawCalls = 0u32;
    gpu.primitives = 0u32;
    gpu.glyphs = 0u32;
    // (hidden with U, it still runs for the panel: while it is up, or to open it)
    // (and for the guard's panel: while it is up, or a guard is within reach, so that E can open it, or was a frame ago; and for words
    // someone is saying)
    var speaking = false;
    var st = 0usize;
    while st < f.tags.len() { if f.tags[st].speech { speaking = true; } st = st + 1usize; }
    if !ready or (!f.on and !model.rp.open and f.events.len() == 0usize and f.joinFailed.len() == 0usize
      and !model.tp.open and f.talkNear == CR_NONE and !model.talkNear and !speaking) { return; }
    let w = f32.from(target.width);
    let h = f32.from(target.height);
    let t0 = sdl.GetTicksNS();
    model.update(f, w, h);
    let t1 = sdl.GetTicksNS();
    gpu.render(device, encoder, target, &mut model, w, h);
    // (PEGASUS_HUD_REPEAT=n draws the passes n times in all, to measure what they cost on the GPU)
    var again = 1u32;
    while again < repeat {
      gpu.render(device, encoder, target, &mut model, w, h);
      again = again + 1u32;
    }
    let t2 = sdl.GetTicksNS();
    modelNs = modelNs + (t1 - t0);
    recordNs = recordNs + (t2 - t1);
    drawn = drawn + 1u64;
  }

  // The panel's word for the shell after a frame (requestpanel.cone: PANEL_OPEN, PANEL_TEXT)
  pub fn panelBits(self &) u32 {
    var b = model.rp.bits(&model.ui) | model.tp.bits();
    if model.talkNear { b = b | PANEL_NEAR; }
    b
  }

  // The question chosen on the guard's panel since the last call ((guard * 256 + question) + 1), or 0
  pub fn takeTalk(self &mut) u32 { model.tp.takeChoice() }

  // The name the panel's Join was pressed for since the last call (empty: it was not)
  pub fn takeJoin(self &mut) String { model.rp.takeJoin() }

  // What the HUD cost the CPU, once at the end of the run: a line
  pub fn report(self &) {
    if model.rp.requests > 0u32 {
      print <- "The panel: "; print <- model.rp.requests; print <- " requests, "; print <- model.rp.answers; print <- " answers; the last: ";
      print <- (if model.rp.lastKind == ANS_SENT { "sent" } elif model.rp.lastKind == ANS_APPROVED { "approved" } else { "error" });
      print <- ", \""; printStr(model.rp.lastLine.view()); print <- "\"\n";
    }
    if drawn == 0u64 { return; }
    print <- "The HUD: "; print <- drawn; print <- " frames drawn; per frame "; print <- f64.from(modelNs) / f64.from(drawn) / 1000d;
    print <- " us in the layout and draw list, "; print <- f64.from(recordNs) / f64.from(drawn) / 1000d; print <- " us recording the passes ("; print <- gpu.primitives;
    print <- " shapes, "; print <- gpu.glyphs; print <- " glyphs in the last)\n";
    print <- "  recording, us a frame: shapes' data "; print <- f64.from(gpu.nsData) / f64.from(drawn) / 1000d;
    print <- ", their upload "; print <- f64.from(gpu.nsUpload) / f64.from(drawn) / 1000d;
    print <- ", texts "; print <- f64.from(gpu.nsText) / f64.from(drawn) / 1000d;
    print <- ", the shapes' pass "; print <- f64.from(gpu.nsPass1) / f64.from(drawn) / 1000d;
    print <- ", the texts' pass "; print <- f64.from(gpu.nsPass2) / f64.from(drawn) / 1000d; print <- "\n";
  }
}

