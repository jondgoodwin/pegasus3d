  FINE_I0, FINE_J0, FINE_I1, FINE_J1, groundHeight as islandHeight, constrain as islandConstrain, WORLD_DX, WORLD_DZ,
  START_X as BEACH_X, START_Z as BEACH_Z, insideFence as insideIslandFence, pathCentreline };
