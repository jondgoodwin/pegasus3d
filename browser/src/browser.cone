// ---- The shell's state (the main thread's alone) ----

mut inputState Input;
mut ctx Context;
mut user UserController;      // the user's: the actions into the possessed being's intents
mut clockKeys ClockActions;   // the pause and x10 keys
mut skyOff bool = false;      // --no-sky: the static sky and light, no birds (to time what the day costs)
mut ctxFrame u64 = 0u64;      // the frame whose actions are in 'ctx'
mut inputFrame u64 = 0u64;    // the frame whose events are in 'input'
mut automated bool = false;   // a run of a fixed number of frames: real input ignored
mut scripted bool = false;
mut shotsDir String;
mut startedAt u64 = 0u64;     // the performance counter when main began
mut worldShownAt u64 = 0u64;  // the counter once the frame that sent the world's last object was presented

// The view a headless run picks in (no window to measure)
const HEADLESS_W f32 = 1280.;
const HEADLESS_H f32 = 720.;
const FOV f32 = 1.0471976;    // 60 degrees, vertical

// Where the old flat world's viewer started (8 m back from its origin, facing
// down -z), with the old world shifted onto the island's lowland (island.cone's
// WORLD_DX, WORLD_DZ): the scripted walk's second part begins here. The
// browser's own start is the landing beach.
const START_X f32 = WORLD_DX;
const START_Z f32 = 8. + WORLD_DZ;

// SDL3's scancodes for P and F (the sdl package binds only some letters)
const SCANCODE_F = 9u;
const SCANCODE_P = 19u;

// The scene clock's keys: P pauses scene time (and starts it again), F runs
// it ten times as fast (and back), for testing the day and the timers
struct ClockActions {
  pub pause Action;
  pub fast Action;

  pub fn bind(ctx &mut Context) ClockActions {
    imm pause = ctx.action("clock.pause", BUTTON);
    ctx.bind(pause, Binding.key(SCANCODE_P));
    imm fast = ctx.action("clock.fast", BUTTON);
    ctx.bind(fast, Binding.key(SCANCODE_F));
    new ClockActions(pause, fast);
  }
}

// How many parts a mannequin is (its own, shown as its skinned body) and
// how many meshes (the body)
const FIGURE_PARTS = 1usize;
const FIGURE_MESHES = 1u64;

fn @initpure init() {
  inputState = Input.empty();
  ctx = Context.empty();
  user = UserController.bind(&mut ctx);
  clockKeys = ClockActions.bind(&mut ctx);
  shotsDir = String.empty();
  probeFrom = new Vec3(0., 0., 0.);
  // The scripted run's own (script.cone, assembly.cone): touched only from the
  // scene actor's end of frame
  clickAt = new Vec2(0., 0.);
  tempPart = PartId.none();
  ballRest = new Vec3(0., 0., 0.);
  route = List[Vec2].empty();
  routeS = List[f32].empty();
  viewEye = new Vec3(0., 0., 0.);
  viewTarget = new Vec3(0., 0., 0.);
}

fn millisSinceStart() f64 {
  f64.from(sdl.GetPerformanceCounter() - startedAt) / f64.from(sdl.GetPerformanceFrequency()) * 1000d;
}

// ---- input ----

// Whether an event may reach the walk: any, when someone is at the
// keyboard; only the script's own in a run of a fixed number of frames
fn accepted(e &sdl.Event) bool {
  if !automated { return true; }
  if e.type == sdl.EVENT_KEY_DOWN or e.type == sdl.EVENT_KEY_UP {
    return (e as &sdl.KeyboardEvent).which == SCRIPT_DEVICE;
  }
  if e.type == sdl.EVENT_MOUSE_MOTION { return (e as &sdl.MouseMotionEvent).which == SCRIPT_DEVICE; }
  if e.type == sdl.EVENT_MOUSE_BUTTON_DOWN or e.type == sdl.EVENT_MOUSE_BUTTON_UP {
    return (e as &sdl.MouseButtonEvent).which == SCRIPT_DEVICE;
  }
  if e.type == sdl.EVENT_MOUSE_WHEEL { return (e as &sdl.MouseWheelEvent).which == SCRIPT_DEVICE; }
  // The window losing focus lets go of every key held: of the real
  // keyboard's, which is ignored here, not of the script's
  if e.type == sdl.EVENT_WINDOW_FOCUS_LOST { return false; }
  true;
}

// The input package's frame begun once a frame, before its first event
fn beginInput(frameNo u64) {
  if inputFrame != frameNo {
    inputState.beginFrame();
    inputFrame = frameNo;
  }
}

// The actions brought up to date once a frame, after every event
fn updateActions(frameNo u64) {
  if ctxFrame != frameNo {
    beginInput(frameNo);
    ctx.update(&inputState);
    ctxFrame = frameNo;
  }
}

// The view the mouse's places are in: the window's own units, or a fixed
// size in a headless run
pub fn viewSize(host &mut Host) Vec2 {
  if !host.hasWindow() { return new Vec2(HEADLESS_W, HEADLESS_H); }
  imm r = host.window().windowSize();
  new Vec2(f32.from(r.w), f32.from(r.h));
}

// ---- the shell's loop ----

// The run: the window and the clock (frame's Host), the actors made, then a
// frame at a time until the run is over, and the actors' reports. Its answer
// is the run's exit code.
fn shellRun(config Config) i32 {
  mut host = Host.open(config);
  if !host.isOpen() { return 1i32; }
  automated = host.config.frames > 0u64 or watching();
  // The flock is made before the island is baked, as it was when the sky rig
  // was a global made by the module's initializer: its home's height and its
  // birds' first heights are read off the ground before there is one (0 m).
  // Making it after the bake would lift the birds (a change to every view
  // with a bird in it), so it is left as it was; the scene actor steps it.
  imm birds = Birds.make();
  // The island's land is baked first (the beings stand on it, the world
  // grows on it), here, before any actor starts: from then on it is only
  // read, by every actor
  imm bakeStart = sdl.GetPerformanceCounter();
  bakeIsland();
  print <- "The island: baked in "; print <- f64.from(sdl.GetPerformanceCounter() - bakeStart) * 1000d
    / f64.from(sdl.GetPerformanceFrequency()); print <- " ms\n";

  // The shell's three inboxes: render's word that it could make the GPU
  // side, each frame's report, and the run's exit code
  mut readyTx Sender[bool];
  mut readyRx Receiver[bool];
  readyTx, readyRx = Channel[bool].make();
  mut framesTx Sender[FrameReport];
  mut framesRx Receiver[FrameReport];
  framesTx, framesRx = Channel[FrameReport].make();
  mut endTx Sender[i32];
  mut endRx Receiver[i32];
  endTx, endRx = Channel[i32].make();

  // Render first: its initializer makes the device here, on the thread that
  // made the window (the window's handle is handed over as a number)
  mut window = 0usize;
  mut width = 0u32;
  mut height = 0u32;
  if host.hasWindow() {
    window = host.window().sdlHandle() as *u8 as usize;
    imm size = host.window().size();
    width = u32.from(size.w);
    height = u32.from(size.h);
  }
  imm render = new RenderActor(window, width, height, skyOff, scripted, shotsDir.copy(), readyTx);
  mut ready = false;
  match readyRx.recv() {
    case imm r Some { ready = r.value; }
    case is None[bool] {}
  }
  if !ready { return 1i32; }
  imm world = new WorldActor(scripted);
  imm scene = new SceneActor(scripted, birds, world, render, framesTx, endTx);
  if scripted { pushScript(1u64); }

  while host.beginFrame() {
    // Input: each event waiting into the input package (the window's own
    // already handled by frame's Host: quit, Escape, F11, a resize)
    host.beginPhase(PHASE_INPUT);
    mut resized = false;
    mut e = sdl.Event.empty();
    while host.nextEvent(&mut e) {
      if host.hasWindow() and host.window().resized {
        host.window().resized = false;
        resized = true;
      }
      beginInput(host.frame);
      if watching() { watchEvent(&e); }
      if accepted(&e) { inputState.handle(&e); }
    }
    host.endPhase(PHASE_INPUT);

    // The frame's steps, the actions brought up to date once, and what the
    // scene is handed: the user's controller's intents, the keys pressed,
    // a click, the window's sizes
    mut steps = List[Step].empty();
    while host.fixed.next() {
      host.stats.steps = host.fixed.taken;
      steps.push(host.step());
    }
    updateActions(host.frame);
    imm alpha = host.alpha();
    mut width = 0u32;
    mut height = 0u32;
    if host.hasWindow() {
      imm s = host.window().size();
      width = u32.from(s.w);
      height = u32.from(s.h);
    }
    imm input = new FrameInput(host.frame, steps, user.intents(&ctx), ctx.pressed(clockKeys.pause),
      ctx.pressed(clockKeys.fast), ctx.pressed(user.actions.view), ctx.pressed(user.actions.swap),
      (inputState.buttonsPressed & sdl.BUTTON_MASK_LEFT) != 0u, new Vec2(inputState.pointer.x, inputState.pointer.y),
      viewSize(&mut host), alpha, resized, width, height);
    scene.frame(input);

    // The frame comes back presented, with each actor's phases
    mut report = FrameReport.none();
    match framesRx.recv() {
      case imm r Some { report = r.value; }
      case is None[FrameReport] { break; }
    }
    host.stats.phase(PHASE_SIMULATE).add(report.simulateNs, host.frame);
    host.stats.phase(PHASE_PUBLISH).add(report.publishNs, host.frame);
    host.stats.phase(PHASE_RENDER).add(report.renderNs, host.frame);
    host.stats.phase(PHASE_PRESENT).add(report.presentNs, host.frame);
    if host.frame == 1u64 {
      print <- "The first frame presented "; print <- millisSinceStart(); print <- " ms after main began\n";
    }
    // The first frame on screen with every object of the world in it
    if report.worldDone and worldShownAt == 0u64 and host.frame >= report.worldSentFrame {
      worldShownAt = sdl.GetPerformanceCounter();
      print <- "The world: every object visible at frame "; print <- host.frame; print <- ", ";
      print <- millisSinceStart(); print <- " ms after main began\n";
    }
    if watching() or soaking() {
      if host.hasWindow() {
        watchPresentNs = watchPresentNs + report.swapNs;
        watchAcquireNs = watchAcquireNs + report.acquireNs;
        watchTexture(report.status);
      }
      if watching() { watchTick(&mut host, &report.you, report.waiting, report.rows, report.emitters); }
      if soaking() { soakTick(&mut host, report.worldDone, report.parts, report.waiting, report.rows, report.emitters); }
    }
  }

  // The end: the scene's, the world's and render's reports, in that order,
  // and the run's exit code
  scene.finish(host.hasWindow());
  mut code = 1i32;
  match endRx.recv() {
    case imm c Some { code = c.value; }
    case is None[i32] {}
  }
  if soaking() and soakReport() != 0i32 { code = 1i32; }
  imm st = actors.stats();
  print <- "Actors: "; print <- u64.from(st.workers); print <- " workers, "; print <- st.messages; print <- " messages in ";
  print <- st.activations; print <- " turns, "; print <- st.steals; print <- " steals\n";
  host.finish();
  code;
}

// ---- main ----

fn main(argc i32, argv **u8) i32 {
  initAll();
  startedAt = sdl.GetPerformanceCounter();
  mut config = Config.fromArgs(argc, argv);
  config.setTitle("Pegasus3D in Cone: a baked-in world");
  mut a = 1i32;
  while a < argc {
    imm arg = *(argv + usize.from(a));
    if libc.strcmp(arg, &"--checks" as *u8) == 0i32 {
      // The scene core's headless checks (checks.cone), and nothing else
      imm result = runChecks();
      finalAll();
      return result;
    } elif libc.strcmp(arg, &"--island" as *u8) == 0i32 and a + 1i32 < argc {
      // The island's preview picture, as a BMP, and nothing else
      imm path = String.fromCStr(*(argv + usize.from(a + 1i32)));
      imm ok = writePreview(path.view());
      finalAll();
      return if ok { 0i32; } else { 1i32; };
    } elif libc.strcmp(arg, &"--script" as *u8) == 0i32 {
      scripted = true;
    } elif libc.strcmp(arg, &"--no-sky" as *u8) == 0i32 {
      skyOff = true;
    } elif libc.strcmp(arg, &"--no-vegetation" as *u8) == 0i32 {
      setVegetation(false);
    } elif libc.strcmp(arg, &"--shots" as *u8) == 0i32 and a + 1i32 < argc {
      shotsDir = String.fromCStr(*(argv + usize.from(a + 1i32)));
      a = a + 1i32;
    } elif libc.strcmp(arg, &"--watch" as *u8) == 0i32 and a + 1i32 < argc {
      watchSeconds = wholeNumber(*(argv + usize.from(a + 1i32)));
      a = a + 1i32;
    } elif libc.strcmp(arg, &"--soak" as *u8) == 0i32 and a + 1i32 < argc {
      soakFrames = wholeNumber(*(argv + usize.from(a + 1i32)));
      config.frames = soakFrames;
      config.synthetic = true;
      a = a + 1i32;
    }
    a = a + 1i32;
  }
  if scripted {
    if config.frames == 0u64 {
      config.frames = SCRIPT_FRAMES;
      config.synthetic = true;
    }
    if config.frames < SCRIPT_FRAMES {
      print <- "--script wants at least "; print <- SCRIPT_FRAMES; print <- " frames\n";
      finalAll();
      return 2i32;
    }
  }
  // The actors are made and let go inside shellRun, so that finalAll finds
  // them quiet and stops the workers
  imm code = shellRun(config);
  finalAll();
  code;
}
