// ---- The shell's state (the main thread's alone) ----

// (What the arguments set is not a global: RunOptions, ServeOptions and Watch are made by main and handed down in Startup; the run's
// own times and "automated" are locals of shellRun.)

// The view a headless run picks in (no window to measure)
const HEADLESS_W: f32 = 1280.;
const HEADLESS_H: f32 = 720.;
const FOV: f32 = 1.0471976;    // 60 degrees, vertical

// Where the old flat world's viewer started (8 m back from its origin, facing
// down -z), with the old world shifted onto the island's lowland (island.cone's
// WORLD_DX, WORLD_DZ): the scripted walk's second part begins here. The
// browser's own start is the landing beach.
const START_X: f32 = WORLD_DX;
const START_Z: f32 = 8. + WORLD_DZ;

// SDL3's scancodes for P and F (the sdl package binds only some letters)
const SCANCODE_B = 5u;
const SCANCODE_F = 9u;
const SCANCODE_G = 10u;
const SCANCODE_P = 19u;
const SCANCODE_T = 23u;

// The scene clock's keys: P pauses scene time (and starts it again), F runs
// it ten times as fast (and back), for testing the day and the timers; T
// changes the weather to the next of its six states, for testing the sky
struct ClockActions {
  pub pause: Action;
  pub fast: Action;
  pub weather: Action;

  pub fn bind(ctx: &mut Context) ClockActions {
    let pause = ctx.action("clock.pause", BUTTON);
    ctx.bind(pause, Binding.key(SCANCODE_P));
    let fast = ctx.action("clock.fast", BUTTON);
    ctx.bind(fast, Binding.key(SCANCODE_F));
    let weather = ctx.action("clock.weather", BUTTON);
    ctx.bind(weather, Binding.key(SCANCODE_T));
    ClockActions(pause, fast, weather)
  }
}

// The HUD's keys (hud.cone): U hides and shows it (H hails: walk.cone), F1 to F8 use the hotbar's eight slots
struct HudActions {
  pub hide: Action;
  pub s0: Action;
  pub s1: Action;
  pub s2: Action;
  pub s3: Action;
  pub s4: Action;
  pub s5: Action;
  pub s6: Action;
  pub s7: Action;
  pub bowl: Action;            // B: bowl the ball (props.cone); it rides in 'hudSlots' as bit 8
  pub cam: Action;             // G: print the camera as a shot-list section (gallery.cone); it has its own flag in the frame's input

  fn slot(ctx: &mut Context, n: u32) Action {
    let a = ctx.action("hud.slot", BUTTON);
    ctx.bind(a, Binding.key(SCANCODE_F1 + n));
    a
  }

  pub fn bind(ctx: &mut Context) HudActions {
    let hide = ctx.action("hud.hide", BUTTON);
    ctx.bind(hide, Binding.key(SCANCODE_U));
    let a0 = HudActions.slot(ctx, 0u32);
    let a1 = HudActions.slot(ctx, 1u32);
    let a2 = HudActions.slot(ctx, 2u32);
    let a3 = HudActions.slot(ctx, 3u32);
    let a4 = HudActions.slot(ctx, 4u32);
    let a5 = HudActions.slot(ctx, 5u32);
    let a6 = HudActions.slot(ctx, 6u32);
    let a7 = HudActions.slot(ctx, 7u32);
    let bowl = ctx.action("play.bowl", BUTTON);
    ctx.bind(bowl, Binding.key(SCANCODE_B));
    let cam = ctx.action("gallery.camera", BUTTON);
    ctx.bind(cam, Binding.key(SCANCODE_G));
    HudActions(hide, a0, a1, a2, a3, a4, a5, a6, a7, bowl, cam)
  }

  // The slots pressed this frame, as bits
  pub fn pressedSlots(self: &, ctx: &Context) u32 {
    var bits = 0u32;
    if ctx.pressed(s0) { bits = bits | 1u32; }
    if ctx.pressed(s1) { bits = bits | 2u32; }
    if ctx.pressed(s2) { bits = bits | 4u32; }
    if ctx.pressed(s3) { bits = bits | 8u32; }
    if ctx.pressed(s4) { bits = bits | 16u32; }
    if ctx.pressed(s5) { bits = bits | 32u32; }
    if ctx.pressed(s6) { bits = bits | 64u32; }
    if ctx.pressed(s7) { bits = bits | 128u32; }
    if ctx.pressed(bowl) { bits = bits | 256u32; }
    bits
  }
}

// How many parts a mannequin is (its own, shown as its skinned body) and
// how many meshes (the body)
const FIGURE_PARTS = 1usize;
const FIGURE_MESHES = 1u64;

fn @initpure init() {
  audioCounts = AudioCounts.make();  // the sound's counters (audioview.cone)
  audioHeap = AudioHeap.make();      // the heap's own allocate and resize, known before main (audioview.cone)
}

// Milliseconds since 'startedAt', the performance counter when main began
fn millisSince(startedAt: u64) f64 {
  f64.from(sdl.GetPerformanceCounter() - startedAt) /f64.from(sdl.GetPerformanceFrequency()) * 1000.0
}

// ---- input ----

// Whether an event may reach the walk: any, when someone is at the
// keyboard; only the script's own in a run of a fixed number of frames
fn accepted(e: &sdl.Event, automated: bool) bool {
  if !automated { return true; }
  if e.type == sdl.EVENT_KEY_DOWN || e.type == sdl.EVENT_KEY_UP {
    return (e as &sdl.KeyboardEvent).which == SCRIPT_DEVICE;
  }
  if e.type == sdl.EVENT_MOUSE_MOTION { return (e as &sdl.MouseMotionEvent).which == SCRIPT_DEVICE; }
  if e.type == sdl.EVENT_MOUSE_BUTTON_DOWN || e.type == sdl.EVENT_MOUSE_BUTTON_UP {
    return (e as &sdl.MouseButtonEvent).which == SCRIPT_DEVICE;
  }
  if e.type == sdl.EVENT_MOUSE_WHEEL { return (e as &sdl.MouseWheelEvent).which == SCRIPT_DEVICE; }
  // Typed text has no device: the script marks its own with SCRIPT_DEVICE in the window id
  if e.type == sdl.EVENT_TEXT_INPUT { return (e as &sdl.TextInputEvent).windowID == SCRIPT_DEVICE; }
  // The window losing focus lets go of every key held: of the real
  // keyboard's, which is ignored here, not of the script's
  if e.type == sdl.EVENT_WINDOW_FOCUS_LOST { return false; }
  true
}

// The shell's input: the input package's state, the actions bound on it and the controllers over them. The main thread's alone,
// made by shellRun and kept there.
struct ShellInput {
  state: Input;
  ctx: Context;
  user: UserController;        // the user's: the actions into the possessed being's intents
  clockKeys: ClockActions;     // the pause and x10 keys
  audioKeys: AudioKeys;        // N: mute
  hudKeys: HudActions;         // the HUD's: U and F1 to F8
  ctxFrame: u64;               // the frame whose actions are in 'ctx'
  inputFrame: u64;             // the frame whose events are in 'state'
  panel: PanelRoute;           // the "Play with others" panel (requestpanel.cone): while it is up it takes the keyboard and the mouse
  hailHold: u32 = 0u32;        // frames the being is still to be told to hail, after H opened a guard's dialogue (the panel took the key)

  fn make(panelName: String, hasToken: bool, automated: bool) ShellInput {
    var ctx = Context.empty();
    let user = UserController.bind(&mut ctx);
    let clockKeys = ClockActions.bind(&mut ctx);
    let audioKeys = AudioKeys.bind(&mut ctx);
    let hudKeys = HudActions.bind(&mut ctx);
    ShellInput(Input.empty(), ctx, user, clockKeys, audioKeys, hudKeys, 0u64, 0u64, PanelRoute.make(panelName, hasToken, automated))
  }

  // The input package's frame begun once a frame, before its first event
  fn beginInput(self: &mut, frameNo: u64) {
    if inputFrame != frameNo {
      state.beginFrame();
      inputFrame = frameNo;
    }
  }

  // The actions brought up to date once a frame, after every event
  fn updateActions(self: &mut, frameNo: u64) {
    if ctxFrame != frameNo {
      self.beginInput(frameNo);
      ctx.update(&state);
      ctxFrame = frameNo;
    }
  }
}

// What the arguments say that the shell and its actors are given: where a scripted run writes its views, the server to join, and
// the sound's options. Made by main, handed to shellRun.
struct Startup {
  shotsDir: String;            // --shots DIR
  connectTo: String;           // --connect HOST:PORT
  audio: AudioOptions;
  opts: RunOptions;
  serve: ServeOptions;
  watch: Watch;                // --watch and --soak (watch.cone)
  startedAt: u64;              // the performance counter when main began
  playerName: String;          // --name NAME: the name this client plays under on a server (default: the machine's name)
  gallery: GalleryPlan;        // --gallery FILE: the shots to take (gallery.cone)
  people: People;              // humanbody's people, read from their files or made (personasset.cone)
  xrShots: String;             // --xr-shots PREFIX: with --xr and --frames, the eyes' pictures near the end go to PREFIX-left.bmp, -right.bmp and -mirror.bmp
  xrShotAt: u64;               // the frame the first of them is taken at

  fn make(startedAt: u64) Startup {
    Startup(String.empty(), String.empty(), AudioOptions.make(), RunOptions.make(), ServeOptions.make(), Watch.make(), startedAt,
      String.empty(), GalleryPlan.none(), People.empty(), String.empty(), 0u64)
  }
}

// The name a client plays under when --name does not say: this machine's (Windows' COMPUTERNAME, else HOSTNAME), cut and
// cleaned to what a server accepts (letters, digits, spaces and . _ -; 24 at most), or "player"
fn defaultPlayerName() String {
  var raw = libc.getenv("COMPUTERNAME");
  if (raw as usize) == 0usize { raw = libc.getenv("HOSTNAME"); }
  var name = String.empty();
  if (raw as usize) != 0usize {
    let text = String.fromCStr(cstr.fromPtr(raw));
    let b: &Array[u8] = text.view();
    var i = 0usize;
    while i < b.len && name.len() < 24usize {
      let c = b[i];
      let ok = (c >= 65u8 && c <= 90u8) || (c >= 97u8 && c <= 122u8) || (c >= 48u8 && c <= 57u8) || c == 46u8 || c == 95u8 || c == 45u8;
      name.appendByte(if ok { c } else { 45u8 });
      i = i + 1usize;
    }
  }
  if name.len() == 0usize { return String.from("player"); }
  name
}

// What the arguments say that the actors and the shell act on. Made by main; the actors that read it keep a copy in their state.
pub struct RunOptions {
  scripted: bool;              // --script
  skyOff: bool;                // --no-sky: the static sky and light, no birds (to time what the day costs)
  npcsEnabled: bool;           // false for --no-npcs: no villagers (to time what they cost, and to compare a run with and without)
  traceOn: bool;               // --trace
  cullMode: u32;               // --cull N: how the scene is culled (rendersys.cone)
  hudOnly: bool;               // --hud-only: just the HUD's part of the scripted run (hudscript.cone)
  audioWalk: bool;             // --audio-walk: the scripted walk that is listened to (audiowalk.cone)
  autoWalk: bool;              // --autowalk
  runForSeconds: u64;          // --run-for S
  vegetationOff: bool;         // --no-vegetation: no trees, rocks or ground cover (to time what they cost); carried by the Island
  mirrorOnly: bool = false;    // --mirror-only: just the mirror's part of the scripted run (mirrorscript.cone)
  mirrorHold: u32 = 0u32;      // --mirror-hold N: a view held for the rest of it (timing; see there)
  holdWeather: u32 = 1u32;     // --hold-weather N: the weather (parts/weather.cone's WEATHER_..., 4 rain) a held view is in; 1 fair
  labOnly: bool = false;       // --labyrinth-only: just the labyrinth's part of the scripted run (labscript.cone)
  labHold: u32 = 0u32;         // --lab-hold N: the labyrinth's view number N held for the rest of the run (timing)
  labSpawn: bool = false;      // --lab-spawn (a server's): each joiner is set down in the labyrinth's antechamber, not on the beach (the net check's --lab)
  creaturesOnly: bool = false; // --creatures-only: just the creatures' part of the scripted run (creaturescript.cone)
  portalOnly: bool = false;    // --portal-only: just the portal's part of the scripted run (portalscript.cone)
  withCreatures: bool = false; // --with-creatures: the labyrinth's creatures made from the start in a scripted run too (to time the court with them in it)
  creatureWalk: bool = false;  // --creature-walk: the net check's client walks through the creatures' places (viewactor.cone, creatureview.cone)
  portalWalk: bool = false;    // --portal-walk: the net check's client runs through the cottage's looking-glass and back (server.cone's portalWalkIntents)
  panelOnly: bool = false;     // --panel-only: just the "Play with others" panel's part of the scripted run (panelscript.cone)
  panelJoin: u32 = 0u32;       // --panel-join (1) or --panel-join-refused (2), with --panel-only: after the answer the script clicks Join (panelscript.cone)
  switchAt: u64 = 0u64;       // --switch-at N: a test hook; at frame N the panel's Join is done for the player (the address is PEGASUS_JOIN_ADDRESS)
  gallery: bool = false;       // --gallery FILE: the shot list's stills (gallery.cone), in the scripted run's harness but none of its walk
  xr: bool = false;            // --xr: drawn into an OpenXR headset (renderactor.cone's drawXr), the window mirroring the left eye; no audio device

  fn make() RunOptions { RunOptions(false, false, true, false, 2u32, false, false, false, 0u64, false) }
}

// The shared island's modes (server.cone): --serve PORT, --loopback and --impair LOSS LATENCY JITTER
struct ServeOptions {
  on: bool;
  port: u32;
  loopback: bool;              // the server listens on this machine only (no firewall prompt; tests)
  impairOn: bool;
  impairLoss: u32;
  impairLatency: u32;
  impairJitter: u32;

  fn make() ServeOptions { ServeOptions(false, 0u32, false, false, 0u32, 0u32, 0u32) }
}

// The view the mouse's places are in: the window's own units, or a fixed
// size in a headless run
pub fn viewSize(host: &mut Host) Vec2 {
  if !host.hasWindow() { return Vec2(HEADLESS_W, HEADLESS_H); }
  let r = host.window().windowSize();
  Vec2(f32.from(r.w), f32.from(r.h))
}

// ---- the shell's loop ----

// The run: the window and the clock (frame's Host), the actors made, then a
// frame at a time until the run is over, and the actors' reports. Its answer
// is the run's exit code.
fn shellRun(config: Config, startup: Startup) i32 {
  var host = Host.open(config);
  if !host.isOpen() { return 1i32; }
  let opts = startup.opts;
  let startedAt = startup.startedAt;
  var watch = startup.watch;
  var worldShownAt = 0u64;      // the counter once the frame that sent the world's last object was presented
  let automated = host.config.frames > 0u64 || watch.watching();   // a run of a fixed number of frames: real input ignored
  // The "Play with others" panel starts with the name from --name, else the name this machine was approved under, else the machine's
  var panelName = startup.playerName.copy();
  if panelName.len() == 0usize { panelName = storedName(); }
  if panelName.len() == 0usize { panelName = defaultPlayerName(); }
  let tokenStored = hasStoredToken();
  // A first run (no token yet) is told once, in a line of the HUD, which key asks to play with others; a scripted run is not
  // (so that no older view changes), except the panel's own
  let panelHint = (!automated && !tokenStored) || opts.panelOnly;
  var shell = ShellInput.make(panelName, tokenStored, automated);
  // The window's handle, for SDL's text input, and its pixels a logical unit (the scripted panel aims its mouse by it)
  var windowHandle = 0usize;
  if host.hasWindow() { windowHandle = host.window().sdlHandle() as *u8 as usize; }
  let panelScale = hudUiScale(windowHandle);
  // The flock is made before the island is baked, as it was when the sky rig
  // was a global made by the module's initializer: its home's height and its
  // birds' first heights are read off the ground before there is one (0 m).
  // Making it after the bake would lift the birds (a change to every view
  // with a bird in it), so it is left as it was; the scene actor steps it.
  let unbaked = Island.empty();
  let birds = Birds.make(&unbaked);
  // The view flies a flock of its own (cosmetic, and the same as the simulation's: both are made here)
  let viewBirds = Birds.make(&unbaked);
  // The island's land is baked first (the beings stand on it, the world
  // grows on it), here, before any actor starts: from then on it is only
  // read, by every actor
  let bakeStart = sdl.GetPerformanceCounter();
  let bare = bakeIsland().withVegetation(!opts.vegetationOff);
  print <- "The island: baked in "; print <- f64.from(sdl.GetPerformanceCounter() - bakeStart) * 1000.0
    / f64.from(sdl.GetPerformanceFrequency()); print <- " ms\n";
  // The vegetation's layout is laid out here too, before any actor starts, and goes into the island: the scene
  // actor's solids (trunks, rocks) and the world actor's trees read the same list
  let land = layOutVegetation(&bare);   // shared, read-only, by every actor
  let isl = &land;

  // The shell's three inboxes: render's word that it could make the GPU
  // side, each frame's report, and the run's exit code
  var readyTx: Sender[bool];
  var readyRx: Receiver[bool];
  readyTx, readyRx = Channel[bool].make();
  var framesTx: Sender[FrameReport];
  var framesRx: Receiver[FrameReport];
  framesTx, framesRx = Channel[FrameReport].make();
  var endTx: Sender[i32];
  var endRx: Receiver[i32];
  endTx, endRx = Channel[i32].make();

  // Render first: its initializer makes the device here, on the thread that
  // made the window (the window's handle is handed over as a number)
  var window = 0usize;
  var width = 0u32;
  var height = 0u32;
  if host.hasWindow() {
    window = host.window().sdlHandle() as *u8 as usize;
    let size = host.window().size();
    width = u32.from(size.w);
    height = u32.from(size.h);
  }
  let render = RenderActor(window, width, height, opts, startup.shotsDir.copy(), readyTx, land.share(), startup.xrShots.copy(),
    startup.xrShotAt);
  var ready = false;
  match readyRx.recv() {
    case let Some(r) { ready = r; }
    case is None[bool] {}
  }
  if !ready { return 1i32; }
  // The connection: single player joins the simulation and the view in this process (netmsg's pairInProcess); connected,
  // the view dials a server's UDP port and its simulation is there. What each end's connection tells comes to its
  // actor as a message (onNet), in the order told
  var joinedTx: Sender[bool];
  var joinedRx: Receiver[bool];
  joinedTx, joinedRx = Channel[bool].make();
  let connected = startup.connectTo.len() > 0usize;
  var simOpt: Option[SimActor] = None;
  var simOpt2: Option[SimActor] = None;
  var endpointOpt: Option[Endpoint] = None;
  var joinsToWait = 1;
  if !connected {
    let world = WorldActor(opts.scripted, land.share());
    var servedTx: Sender[u64];
    var servedRx: Receiver[u64];
    servedTx, servedRx = Channel[u64].make();
    let sim = SimActor(opts, birds, world, false, joinedTx.clone(), servedTx, land.share(), startup.gallery.copy(), startup.people.share());
    simOpt = Some[SimActor](sim);
    simOpt2 = Some[SimActor](sim);
    joinsToWait = 2;
  }
  let view = ViewActor(simOpt, render, framesTx, endTx, viewBirds, !connected, joinedTx, startup.audio.copy(), automated, opts,
    startup.playerName.copy(), land.share(), startup.people.share());
  let viewHandler = eventHandler(Uni[fn(ev: NetEvent) + Sendable](fn(ev: NetEvent) [view] { view.onNet(ev); }));
  if connected {
    let addr = parseAddress(startup.connectTo.view());
    let bound = mustConnect(addr, NetConfig.defaults(), viewHandler);
    // (the other branch hands the same handler on)
    endpointOpt = Some[Endpoint](bound.endpoint);
    print <- "Connecting to "; printStr(startup.connectTo.view()); print <- "\n";
  }
  if !connected {
    // Single player: the simulation joins its connection to the view's
    match &simOpt2 {
      case let Some(s) { s.wire(viewHandler); }
      else {}
    }
  }
  // Wait until the connection is open at both ends (the first frame has its client)
  var allJoined = true;
  var waited = 0;
  while waited < joinsToWait {
    match joinedRx.recv() {
      case let Some(j) { if !j { allJoined = false; } }
      case is None[bool] { allJoined = false; }
    }
    waited = waited + 1;
  }
  if !allJoined {
    print <- "The connection could not be opened\n";
    return 1i32;
  }
  if opts.scripted && !opts.gallery { pushScript(&opts, 1u64); }
  let runStart = sdl.GetTicksNS();
  var refusedRun = false;
  var wentOnline = false;       // the view switched to a server (a Join): its socket's thread needs time to stop, as a --connect run's
  var panelWatch = PanelWatch.make();   // the panel's scripted run: where the player was (panelscript.cone)

  while host.beginFrame() {
    if opts.runForSeconds > 0u64 && sdl.GetTicksNS() - runStart > opts.runForSeconds * 1000000000u64 { break; }
    // Input: each event waiting into the input package (the window's own
    // already handled by frame's Host: quit, Escape, F11, a resize)
    host.beginPhase(PHASE_INPUT);
    var resized = false;
    var e = sdl.Event.empty();
    let viewNow = viewSize(&mut host);
    // (the panel's scripted run pushes its own keys, text and mouse into SDL's queue, aimed by where the panel's controls are)
    if opts.panelOnly && host.hasWindow() {
      let px = host.window().size();
      panelPush(host.frame, viewNow, Vec2(f32.from(px.w), f32.from(px.h)), panelScale, opts.panelJoin != 0u32);
    }
    // (the creatures' part: the visitor's E and the click on the guard's panel, aimed where its buttons are)
    if opts.scripted && host.hasWindow() && creaturesIn(&opts, host.frame) {
      let px = host.window().size();
      crPush(&opts, host.frame, viewNow, Vec2(f32.from(px.w), f32.from(px.h)), panelScale);
    }
    while host.nextEvent(&mut e) {
      if host.hasWindow() && host.window().resized {
        host.window().resized = false;
        resized = true;
      }
      shell.beginInput(host.frame);
      if watch.watching() { watch.event(&e); }
      // Escape (Config.escapeQuits is false): it closes the "Play with others" panel while that is up, and otherwise ends the run
      // as the window's own Escape did. An automated run does not use it for the panel (its script closes the panel itself).
      if e.type == sdl.EVENT_KEY_DOWN && (&e as &sdl.KeyboardEvent).scancode == sdl.SCANCODE_ESCAPE {
        if automated || !shell.panel.escape() { host.stop(); }
      } else if accepted(&e, automated) {
        // The "Play with others" panel, while it is up, takes the keyboard and the mouse; otherwise the game does
        let offered = shell.panel.offer(&e, viewNow.x, viewNow.y);
        if offered == OFFER_OPENED {
          // (keys held as it opened are let go, as when the window loses focus, so that nothing walks on under the panel)
          var lost = sdl.Event.empty();
          lost.type = sdl.EVENT_WINDOW_FOCUS_LOST;
          shell.state.handle(&lost);
          // (H opened a guard's dialogue: the being hails as well; the key was the panel's)
          if shell.panel.hailAsked {
            shell.panel.hailAsked = false;
            shell.hailHold = 4u32;
          }
        } else if offered == OFFER_PASS {
          shell.state.handle(&e);
        }
      }
    }
    host.endPhase(PHASE_INPUT);

    // The frame's steps, the actions brought up to date once, and what the
    // scene is handed: the user's controller's intents, the keys pressed,
    // a click, the window's sizes
    var steps = List[Step].empty();
    let firstStep = host.fixed.taken;
    while host.fixed.next() {
      host.stats.steps = host.fixed.taken;
      steps.push(host.step());
    }
    shell.updateActions(host.frame);
    audioKeyFrame(&shell.audioKeys, &shell.ctx);
    let alpha = host.alpha();
    var width = 0u32;
    var height = 0u32;
    if host.hasWindow() {
      let s = host.window().size();
      width = u32.from(s.w);
      height = u32.from(s.h);
    }
    if opts.audioWalk { audioWalkKeys(host.frame); }
    var intentsNow = if opts.audioWalk { audioWalkIntents(firstStep) } else if opts.portalWalk { portalWalkIntents(firstStep) } else if opts.autoWalk { autoIntents(firstStep) } else { shell.user.intents(&shell.ctx) };
    if shell.hailHold > 0u32 {
      intentsNow.hail = true;
      shell.hailHold = shell.hailHold - 1u32;
    }
    let input = FrameInput(host.frame, steps, intentsNow, shell.user.lookKeys(&shell.ctx), shell.user.lookDrag(&shell.ctx),
      shell.ctx.pressed(shell.clockKeys.pause), shell.ctx.pressed(shell.clockKeys.fast), shell.ctx.pressed(shell.clockKeys.weather),
      shell.ctx.pressed(shell.user.actions.view), shell.ctx.pressed(shell.user.actions.swap),
      (shell.state.buttonsPressed & sdl.BUTTON_MASK_LEFT) != 0u, Vec2(shell.state.pointer.x, shell.state.pointer.y),
      viewNow, alpha, resized, width, height, shell.ctx.pressed(shell.hudKeys.hide), shell.hudKeys.pressedSlots(&shell.ctx),
      shell.panel.take(), panelHint, shell.ctx.pressed(shell.hudKeys.cam));
    view.frame(input);

    // The frame comes back presented, with each actor's phases
    var report = FrameReport.none();
    match framesRx.recv() {
      case let Some(r) { report = r; }
      case is None[FrameReport] { break; }
    }
    // Whether the panel is up (the next frame's events go to it or to the game), and SDL's text input with it
    shell.panel.told(report.panel, windowHandle, automated);
    // The panel's Join (or the test hook's, --switch-at): the view dials the server and single player carries on until the server
    // has taken this client in. The address goes by message (it is not kept anywhere). The frame is over, so nothing is in flight
    // when the view's actor takes this.
    if report.online { wentOnline = true; }
    if report.join.len() > 0usize && !report.online && !report.dialing {
      view.goOnline(joinAddress(automated), report.join.copy());
    } else if opts.switchAt > 0u64 && host.frame == opts.switchAt && !report.online && !report.dialing {
      view.goOnline(joinAddress(automated), shell.panel.openName.copy());
    }
    if opts.panelOnly { panelWatch.note(host.frame, report.you.position); }
    if report.refused {
      // The server will not have this client (its name): said already, and the run is over
      refusedRun = true;
      break;
    }
    // --xr: the headset's session is over (the runtime ended it): so is the run
    if report.xrEnded { break; }
    host.stats.phase(PHASE_SIMULATE).add(report.simulateNs, host.frame);
    host.stats.phase(PHASE_PUBLISH).add(report.publishNs, host.frame);
    host.stats.phase(PHASE_RENDER).add(report.renderNs, host.frame);
    host.stats.phase(PHASE_PRESENT).add(report.presentNs, host.frame);
    if host.frame == 1u64 {
      print <- "The first frame presented "; print <- millisSince(startedAt); print <- " ms after main began\n";
    }
    // The first frame on screen with every object of the world in it
    if report.worldDone && worldShownAt == 0u64 && host.frame >= report.worldSentFrame {
      worldShownAt = sdl.GetPerformanceCounter();
      print <- "The world: every object visible at frame "; print <- host.frame; print <- ", ";
      print <- millisSince(startedAt); print <- " ms after main began\n";
    }
    if watch.watching() || watch.soaking() {
      if host.hasWindow() {
        watch.presented(report.swapNs, report.acquireNs, report.status);
      }
      if watch.watching() { watch.tick(&mut host, &report.you, report.waiting, report.rows, report.emitters); }
      if watch.soaking() { watch.soakTick(&mut host, report.worldDone, report.parts, report.waiting, report.rows, report.emitters); }
    }
    // A run with no window on the real clock would spin: it gives the processor back between frames
    if !host.hasWindow() && !host.config.synthetic { thread.sleep(Duration.fromMillis(2i64)); }
  }

  // The end: the scene's, the world's and render's reports, in that order,
  // and the run's exit code
  view.finish(host.hasWindow() || opts.xr);   // (a headset run has the GPU whether or not it has a window)
  var code = 1i32;
  match endRx.recv() {
    case let Some(c) { code = c; }
    case is None[i32] {}
  }
  if refusedRun { code = 3i32; }
  if opts.panelOnly && !panelWatch.verdict(opts.panelJoin != 0u32) { code = 1i32; }
  if opts.panelJoin != 0u32 {
    // The Join run's own check: online at the end (the server took this player in), or still single player (it refused the name)
    let wantOnline = opts.panelJoin == 1u32;
    print <- "Panel run: after Join the browser is "; print <- (if wentOnline { "online" } else { "single player" });
    if wentOnline == wantOnline { print <- ": yes\n"; } else { print <- ": NO\n"; code = 1i32; }
  }
  if watch.soaking() && watch.soakReport() != 0i32 { code = 1i32; }
  // A connection closed before the program ends: its socket's thread must stop before the actors' runtime does
  match &endpointOpt {
    case let Some(e) { e.shutdown(); }
    else {}
  }
  if connected || wentOnline { thread.sleep(Duration.fromMillis(300i64)); }
  let st = actors.stats();
  print <- "Actors: "; print <- u64.from(st.workers); print <- " workers, "; print <- st.messages; print <- " messages in ";
  print <- st.activations; print <- " turns, "; print <- st.steals; print <- " steals\n";
  host.finish();
  code
}

// ---- main ----

fn main(argc: i32, argv: **u8) i32 {
  initAll();
  var config = Config.fromArgs(argc, argv);
  config.setTitle("Pegasus3D in Cone: a baked-in world");
  config.escapeQuits = false;     // the shell decides (shellRun): Escape closes the request panel when it is up, else ends the run
  var startup = Startup.make(sdl.GetPerformanceCounter());
  var a = 1i32;
  var requestPlayAsked = false;       // --request-play: ask to be let in (requestplay.cone), and nothing else
  var requestMessage = String.empty();
  var galleryFile = String.empty();   // --gallery FILE
  while a < argc {
    let arg = cstr.fromPtr(*(argv + usize.from(a)));     // argv's strings each end in a NUL
    if libc.strcmp(arg, "--request-play") == 0i32 {
      requestPlayAsked = true;
    } else if libc.strcmp(arg, "--message") == 0i32 && a + 1i32 < argc {
      requestMessage = String.fromCStr(cstr.fromPtr(*(argv + usize.from(a + 1i32))));
      a = a + 1i32;
    } else if libc.strcmp(arg, "--checks") == 0i32 {
      // The scene core's headless checks (checks.cone), and nothing else
      let result = runChecks();
      finalAll();
      return result;
    } else if libc.strcmp(arg, "--bake-people") == 0i32 && a + 1i32 < argc {
      // Humanbody's people made (the blend sets, about 16 s each, once) and stored in the folder given, to put in a zip
      // beside the executable as 'people' (personasset.cone), and nothing else
      let dir = String.fromCStr(cstr.fromPtr(*(argv + usize.from(a + 1i32))));
      let ok = bakePeopleInto(dir.view());
      finalAll();
      return if ok { 0i32 } else { 1i32 };
    } else if libc.strcmp(arg, "--island") == 0i32 && a + 1i32 < argc {
      // The island's preview picture, as a BMP, and nothing else
      let path = String.fromCStr(cstr.fromPtr(*(argv + usize.from(a + 1i32))));
      let ok = writePreview(path.view());
      finalAll();
      return if ok { 0i32 } else { 1i32 };
    } else if libc.strcmp(arg, "--dump-frescos") == 0i32 && a + 1i32 < argc {
      // The labyrinth's fresco tiles as BMPs in the folder given (bakedworld/labyrinth.cone), and nothing else
      let dir = String.fromCStr(cstr.fromPtr(*(argv + usize.from(a + 1i32))));
      let ok = labDumpFrescos(dir.view());
      finalAll();
      return if ok { 0i32 } else { 1i32 };
    } else if libc.strcmp(arg, "--navpic") == 0i32 && a + 1i32 < argc {
      // The villagers' navigation mesh drawn top-down (npcchecks.cone), as PNGs named PREFIX-region.png and so on, and nothing else
      let prefix = String.fromCStr(cstr.fromPtr(*(argv + usize.from(a + 1i32))));
      let ok = writeNavPictures(prefix.view());
      finalAll();
      return if ok { 0i32 } else { 1i32 };
    } else if libc.strcmp(arg, "--script") == 0i32 {
      startup.opts.scripted = true;
    } else if libc.strcmp(arg, "--gallery") == 0i32 && a + 1i32 < argc {
      // Stills from a shot list (gallery.cone): each at its camera, hour, weather and size, saved as PNGs in --shots DIR (default: the list's folder)
      galleryFile = String.fromCStr(cstr.fromPtr(*(argv + usize.from(a + 1i32))));
      a = a + 1i32;
    } else if libc.strcmp(arg, "--no-sky") == 0i32 {
      startup.opts.skyOff = true;
    } else if libc.strcmp(arg, "--audio-walk") == 0i32 && a + 1i32 < argc {
      // A scripted walk past the brook and over the bridge, recorded to a WAV (audiowalk.cone)
      startup.opts.audioWalk = true;
      startup.audio.setWavPath(String.fromCStr(cstr.fromPtr(*(argv + usize.from(a + 1i32)))));
      config.frames = AUDIO_WALK_FRAMES;
      config.synthetic = true;
      a = a + 1i32;
    } else if libc.strcmp(arg, "--xr") == 0i32 {
      // Drawn into an OpenXR headset (renderactor.cone's drawXr): the head's pose on the avatar's feet, looking round only (no walking
      // or turning by a controller yet), the window (or none, with --headless) showing the left eye. NO AUDIO DEVICE: the sound is
      // off ('audio.off' is checked first by audioOpen, before any device is asked for), so a run of this, in the simulator or a
      // headset, makes no sound at any hour; the line below says so.
      startup.opts.xr = true;
      startup.audio.off = true;
      print <- "Audio: off (--xr opens no audio device)\n";
    } else if libc.strcmp(arg, "--xr-shots") == 0i32 && a + 1i32 < argc {
      // With --xr and --frames N: each eye's picture, and the window's, near the end of the run, to PREFIX-left.bmp, PREFIX-right.bmp and
      // PREFIX-mirror.bmp (as render's xrstereo does), for a check with no one in the headset
      startup.xrShots = String.fromCStr(cstr.fromPtr(*(argv + usize.from(a + 1i32))));
      a = a + 1i32;
    } else if libc.strcmp(arg, "--no-audio") == 0i32 {
      startup.audio.off = true;
    } else if libc.strcmp(arg, "--audio-muted") == 0i32 {
      startup.audio.startMuted = true;   // the device is opened but starts muted (a press of N un-mutes), for trying the device without a sound
    } else if libc.strcmp(arg, "--audio-device") == 0i32 {
      startup.audio.forceDevice = true;
    } else if libc.strcmp(arg, "--audio-wav") == 0i32 && a + 1i32 < argc {
      startup.audio.setWavPath(String.fromCStr(cstr.fromPtr(*(argv + usize.from(a + 1i32)))));
      a = a + 1i32;
    } else if libc.strcmp(arg, "--no-vegetation") == 0i32 {
      startup.opts.vegetationOff = true;
    } else if libc.strcmp(arg, "--no-npcs") == 0i32 {
      startup.opts.npcsEnabled = false;
    } else if libc.strcmp(arg, "--cull") == 0i32 && a + 1i32 < argc {
      // How the scene is culled: 0 not at all (the draw list, as before), 1 the frustum, 2 and levels of detail and
      // ranges (the default), 3 and the depth pyramid; see cullMode (rendersys.cone)
      startup.opts.cullMode = u32.from(wholeNumber(*(argv + usize.from(a + 1i32))));
      a = a + 1i32;
    } else if libc.strcmp(arg, "--shots") == 0i32 && a + 1i32 < argc {
      startup.shotsDir = String.fromCStr(cstr.fromPtr(*(argv + usize.from(a + 1i32))));
      a = a + 1i32;
    } else if libc.strcmp(arg, "--watch") == 0i32 && a + 1i32 < argc {
      startup.watch.watchSeconds = wholeNumber(*(argv + usize.from(a + 1i32)));
      a = a + 1i32;
    } else if libc.strcmp(arg, "--soak") == 0i32 && a + 1i32 < argc {
      startup.watch.soakFrames = wholeNumber(*(argv + usize.from(a + 1i32)));
      config.frames = startup.watch.soakFrames;
      config.synthetic = true;
      a = a + 1i32;
    } else if libc.strcmp(arg, "--serve") == 0i32 && a + 1i32 < argc {
      startup.serve.on = true;
      startup.serve.port = u32.from(wholeNumber(*(argv + usize.from(a + 1i32))));
      a = a + 1i32;
    } else if libc.strcmp(arg, "--connect") == 0i32 && a + 1i32 < argc {
      startup.connectTo = String.fromCStr(cstr.fromPtr(*(argv + usize.from(a + 1i32))));
      a = a + 1i32;
    } else if libc.strcmp(arg, "--name") == 0i32 && a + 1i32 < argc {
      // The name this client plays under on a server (shown above its mannequin to the others)
      startup.playerName = String.fromCStr(cstr.fromPtr(*(argv + usize.from(a + 1i32))));
      a = a + 1i32;
    } else if libc.strcmp(arg, "--run-for") == 0i32 && a + 1i32 < argc {
      startup.opts.runForSeconds = wholeNumber(*(argv + usize.from(a + 1i32)));
      a = a + 1i32;
    } else if libc.strcmp(arg, "--switch-at") == 0i32 && a + 1i32 < argc {
      // A test hook for the panel's Join: at frame N a single-player run goes online, as pressing Join does, to the server
      // PEGASUS_JOIN_ADDRESS names (else, in this automated run, a port nothing listens on). Views "switch-before" (the frame
      // before) and "switch-after" (120 frames after the switch) are saved with --shots.
      startup.opts.switchAt = wholeNumber(*(argv + usize.from(a + 1i32)));
      a = a + 1i32;
    } else if libc.strcmp(arg, "--hud-only") == 0i32 {
      // Only the HUD's part of the scripted run (hudscript.cone), to look at it quickly: the walk to the cottage, then the HUD
      startup.opts.scripted = true;
      startup.opts.hudOnly = true;
    } else if libc.strcmp(arg, "--panel-only") == 0i32 {
      // Only the "Play with others" panel's part of the scripted run (panelscript.cone): it types a name, asks to play and sees the
      // answer (the live server's, or a stub's: PEGASUS_REQUEST_URL). PEGASUS_PLAY_DIR keeps the token out of the user's folder.
      startup.opts.scripted = true;
      startup.opts.panelOnly = true;
    } else if libc.strcmp(arg, "--panel-join") == 0i32 || libc.strcmp(arg, "--panel-join-refused") == 0i32 {
      // The panel's run, then Join: PEGASUS_REQUEST_URL must be a stub that approves and PEGASUS_JOIN_ADDRESS a server on this machine.
      // --panel-join ends well if the browser is online at the end of the run, --panel-join-refused if it is still single player
      // (the server refuses this name). A real-time clock: the server is another process.
      startup.opts.scripted = true;
      startup.opts.panelOnly = true;
      startup.opts.panelJoin = if libc.strcmp(arg, "--panel-join") == 0i32 { 1u32 } else { 2u32 };
    } else if libc.strcmp(arg, "--mirror-only") == 0i32 {
      // Only the mirror's part of the scripted run (mirrorscript.cone): the walk to the cottage, then the mirror's windows
      startup.opts.scripted = true;
      startup.opts.mirrorOnly = true;
    } else if libc.strcmp(arg, "--portal-walk") == 0i32 {
      startup.opts.portalWalk = true;
    } else if libc.strcmp(arg, "--portal-only") == 0i32 {
      // Only the portal's part of the scripted run (portalscript.cone): the looking-glass opens, a run through it and back, the
      // corridor that will not end
      startup.opts.scripted = true;
      startup.opts.portalOnly = true;
    } else if libc.strcmp(arg, "--mirror-hold") == 0i32 && a + 1i32 < argc {
      // With --mirror-only (and --soak N): after the mirror's settling, hold one view for the rest of the run, to time it:
      // 1 the mannequin's eyes with the mirror in front of them, 2 the same eyes turned away (the mirror out of sight)
      startup.opts.mirrorHold = u32.from(wholeNumber(*(argv + usize.from(a + 1i32))));
      a = a + 1i32;
    } else if libc.strcmp(arg, "--hold-weather") == 0i32 && a + 1i32 < argc {
      // With --mirror-hold: the weather the held view is in (to time what the pictures' fog costs: rain has the thickest)
      startup.opts.holdWeather = u32.from(wholeNumber(*(argv + usize.from(a + 1i32))));
      a = a + 1i32;
    } else if libc.strcmp(arg, "--labyrinth-only") == 0i32 {
      // Only the labyrinth's part of the scripted run (labscript.cone): the rooms from E, then a walk from E to the staircase's top
      startup.opts.scripted = true;
      startup.opts.labOnly = true;
    } else if libc.strcmp(arg, "--creatures-only") == 0i32 {
      // Only the creatures' part of the scripted run (creaturescript.cone): the guards and their puzzle, the Worm, the Minotaur
      startup.opts.scripted = true;
      startup.opts.creaturesOnly = true;
    } else if libc.strcmp(arg, "--with-creatures") == 0i32 {
      startup.opts.withCreatures = true;
    } else if libc.strcmp(arg, "--creature-walk") == 0i32 {
      // The net check's client walks to the creatures' places by asking the simulation to set it down at each (viewactor.cone)
      startup.opts.creatureWalk = true;
    } else if libc.strcmp(arg, "--lab-spawn") == 0i32 {
      startup.opts.labSpawn = true;
    } else if libc.strcmp(arg, "--lab-hold") == 0i32 && a + 1i32 < argc {
      // With --labyrinth-only (and --soak N): hold the labyrinth's view number N for the rest of the run, to time it
      startup.opts.labHold = u32.from(wholeNumber(*(argv + usize.from(a + 1i32))));
      a = a + 1i32;
    } else if libc.strcmp(arg, "--autowalk") == 0i32 {
      startup.opts.autoWalk = true;
    } else if libc.strcmp(arg, "--loopback") == 0i32 {
      startup.serve.loopback = true;
    } else if libc.strcmp(arg, "--trace") == 0i32 {
      startup.opts.traceOn = true;
    } else if libc.strcmp(arg, "--impair") == 0i32 && a + 3i32 < argc {
      startup.serve.impairOn = true;
      startup.serve.impairLoss = u32.from(wholeNumber(*(argv + usize.from(a + 1i32))));
      startup.serve.impairLatency = u32.from(wholeNumber(*(argv + usize.from(a + 2i32))));
      startup.serve.impairJitter = u32.from(wholeNumber(*(argv + usize.from(a + 3i32))));
      a = a + 3i32;
    }
    a = a + 1i32;
  }
  // --xr-shots: the left eye is written on the frame this says, the right eye's on the next (and the window's with the left's)
  if startup.opts.xr && startup.xrShots.len() > 0usize {
    startup.xrShotAt = if config.frames > 8u64 { config.frames - 5u64 } else { 1u64 };
  }
  if galleryFile.len() > 0usize {
    var found = false;
    match fs.readFile(&Path.from(galleryFile.view())) {
      case let Ok(text) {
        found = true;
        startup.gallery = readGallery(text.view());
      }
      else {}
    }
    if !found {
      print <- "gallery: cannot read the shot list "; printStr(galleryFile.view()); print <- "\n";
      finalAll();
      return 2i32;
    }
    if !startup.gallery.ok {
      finalAll();
      return 2i32;
    }
    startup.opts.scripted = true;
    startup.opts.gallery = true;
    config.frames = galleryEnd(&startup.gallery);
    config.synthetic = true;
    // The pictures go beside the list unless --shots says
    if startup.shotsDir.len() == 0usize {
      let gv = galleryFile.view();
      var slash = gv.len;
      var g = 0usize;
      while g < gv.len { if gv[g] == '/' || gv[g] == '\\' { slash = g; } g = g + 1usize; }
      startup.shotsDir = if slash < gv.len { galleryFile.sub(0usize, slash) } else { String.from(".") };
    }
    let made = fs.makeDirAll(&Path.from(startup.shotsDir.view()));
    print <- "Gallery: "; print <- startup.gallery.shots.len(); print <- " shots, "; print <- config.frames; print <- " frames, into ";
    printStr(startup.shotsDir.view()); print <- "\n";
  }
  if requestPlayAsked {
    if startup.playerName.len() == 0usize { startup.playerName = defaultPlayerName(); }
    let result = requestPlay(startup.playerName.view(), requestMessage.view());
    finalAll();
    return result;
  }
  // A server, and a client that has a window or not, run on the real clock (--headless alone would make it synthetic)
  if startup.serve.on || startup.connectTo.len() > 0usize || startup.opts.switchAt > 0u64 { config.synthetic = false; }
  if startup.connectTo.len() > 0usize {
    if !addressReadable(startup.connectTo.view()) {
      print <- "--connect wants HOST:PORT with HOST a dotted address (a.b.c.d) or localhost, and a port from 1 to 65535: got ";
      printStr(startup.connectTo.view()); print <- "\n";
      finalAll();
      return 2i32;
    }
    if startup.playerName.len() == 0usize { startup.playerName = defaultPlayerName(); }
  }
  // The people: from their files, or made once (personasset.cone)
  // (PEGASUS_NO_PEOPLE=1: none, and the wooden mannequins of before stand in their places, to time the one against the other)
  if (libc.getenv("PEGASUS_NO_PEOPLE") as usize) == 0usize {
    var peopleLog = PeopleLog();
    startup.people = loadPeople(&mut peopleLog, &Path.from(""));
    print <- "People: "; print <- peopleLog.loaded; print <- " read in "; print <- peopleLog.loadMs; print <- " ms, ";
    print <- peopleLog.made; print <- " made in "; print <- peopleLog.makeMs; print <- " ms\n";
  } else {
    print <- "People: none (PEGASUS_NO_PEOPLE)\n";
  }
  if startup.serve.on {
    config.headless = true;
    let served = serveRun(config, &startup);
    finalAll();
    return served;
  }
  if startup.opts.hudOnly && config.frames == 0u64 {
    config.frames = hudScriptEnd(&startup.opts);
    config.synthetic = true;
  }
  if startup.opts.panelOnly && config.frames == 0u64 {
    config.frames = panelScriptEnd(startup.opts.panelJoin != 0u32);
    config.synthetic = startup.opts.panelJoin == 0u32;   // (the Join run is on the real clock: the server is another process)
  }
  if startup.opts.mirrorOnly && config.frames == 0u64 {
    config.frames = mirrorScriptEnd(&startup.opts);
    config.synthetic = true;
  }
  if startup.opts.labOnly && config.frames == 0u64 {
    config.frames = labScriptEnd(&startup.opts);
    config.synthetic = true;
  }
  if startup.opts.portalOnly && config.frames == 0u64 {
    config.frames = portalScriptEnd(&startup.opts);
    config.synthetic = true;
  }
  if startup.opts.creaturesOnly && config.frames == 0u64 {
    config.frames = creaturesScriptEnd(&startup.opts);
    config.synthetic = true;
  }
  if startup.opts.scripted && !startup.opts.hudOnly && !startup.opts.mirrorOnly && !startup.opts.panelOnly && !startup.opts.labOnly
    && !startup.opts.portalOnly && !startup.opts.creaturesOnly && !startup.opts.gallery {
    if config.frames == 0u64 {
      config.frames = SCRIPT_FRAMES;
      config.synthetic = true;
    }
    if config.frames < SCRIPT_FRAMES {
      print <- "--script wants at least "; print <- SCRIPT_FRAMES; print <- " frames\n";
      finalAll();
      return 2i32;
    }
  }
  // The actors are made and let go inside shellRun, so that finalAll finds
  // them quiet and stops the workers
  let code = shellRun(config, startup);
  finalAll();
  code
}
