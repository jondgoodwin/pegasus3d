// The browser: a native 3-D browser in Cone, in the spirit of Pegasus3D.
// The shell and the walkable plane: an endless brown ground under a
// sky-blue sky, in metres, walked on at eye height; and a world in it, baked
// in for now (bakedworld/), standing in for a fetched one: it reaches the
// browser only through the scene's Door, reserving ids and sending the same
// requests the shell uses for its own ground and sky.
//
// It is a world the frame package runs (frame's World module trait), so the
// loop is frame's: each frame drains input, takes the simulation's fixed
// steps, publishes, draws and presents, every phase timed.
//
//   input      each event into the input package
//   simulate   one fixed step at a time: the user's controller turns the
//              actions into intents for the possessed being, every being
//              steps (being.cone), and the scene's clock moves on
//   publish    the pause and x10 keys; a click picked (picking.cone): the
//              part hit highlighted, and posted to the world's Door if the
//              world listens for it; the scene's events: timers due rung,
//              the areas sensed against the possessed being (parts/
//              events.cone); the baked-in world's next object hydrated and
//              sent (one a frame, until all are), and the world's tick: its
//              mail read, its motions sent as requests at the scene's time;
//              the beings' parts placed; then THE APPLY POINT: the scene's
//              inbox applied, each request by the system that owns what it
//              changes (parts/, rendersys.cone, picking.cone); the world
//              matrices propagated down the placement tree; and the scene's
//              SNAPSHOT published (parts/snapshot.cone): every world
//              matrix, the scene's time, and the possessed being's eyes at
//              its last two steps
//   draw       from the snapshot alone: the camera between those eyes, the
//              render system's draw list, then the effects' particles at
//              the snapshot's time
//   present    show it
//
// THE SCENE'S TIME is the scene's clock (parts/events.cone): the
// simulation's fixed steps at the clock's rate (1; 0 paused with P; 10
// with F), exact on the synthetic clock. The world's motions, the effects,
// the timers and the day clock are read from it; the walk is not.
//
// Arguments, besides frame's (--frames N, --headless, --quiet):
//   --script        walk, turn and click with no one at the keyboard: events
//                   pushed into SDL's own queue (sdl.PushEvent), never the
//                   system's, and checked against what they must do (script.cone)
//   --shots DIR     write the scripted run's views into DIR as BMPs
//   --watch S, --soak N   a watched real-time run, a soak (watch.cone)
//
// A run of a fixed number of frames (--frames, --script) takes input only
// from its own pushed events, so it is the same every time.

mod browser is World;

import stdio use *;
import libc;
import sdl;
import collections use *;
import pool use *;
import geomath use *;
import bonepose;
import walkgait;
import mesh use Mesh;
import gpu use *;
import render use *;
import arena use Arena;
import frame use World, Config, Host, Step;
import input use *;
import controls use Pose;
import vfx use ParticleRenderer, EmitterHandle, Emitter, Event;

// The submodules: the scene's parts, ids, tables and requests (parts/), whose
// names the browser folds in, and the baked-in world (bakedworld/), a sister
// of parts that imports it
use parts;
use bakedworld { BakedWorld, ROOK, LATHED_ROOK, BALL, BALLOON, BUTTON as LAUNCH_BUTTON, AMPHORA, HORNFLOWER, CHIMNEY, ALARM_AT };

// ---- The world's state ----

mut scene Scene;
mut inputState Input;
mut ctx Context;
mut cast Cast;                // the beings, and which one the user possesses
mut user UserController;      // the user's: the actions into the possessed being's intents
mut clockKeys ClockActions;   // the pause and x10 keys
mut sentBodies List[Walk];    // each being's body as its part was last placed
mut snapshot Snapshot;        // the scene's last published, drawn from
mut ctxFrame u64 = 0u64;      // the frame whose actions are in 'ctx'
mut inputFrame u64 = 0u64;    // the frame whose events are in 'input'
mut automated bool = false;   // a run of a fixed number of frames: real input ignored
mut scripted bool = false;
mut scriptOk bool = true;
mut shotsDir String;
mut unrendered u64 = 0u64;    // render requests a headless run had no GPU for
mut world BakedWorld;         // the baked-in world: what of it has been sent
mut startedAt u64 = 0u64;     // the performance counter when main began
mut worldSentFrame u64 = 0u64;  // the frame whose publish sent the world's last object
mut worldShownAt u64 = 0u64;  // the counter once that frame was presented (or applied, headless)
mut picks PickSystem;         // what each shown part is, for picking
mut picked PartId;            // the part highlighted: the last click's
mut lastPick PickHit;         // the last click's answer, for the script
mut clicks u64 = 0u64;
mut fired u64 = 0u64;         // Fire requests applied: an effect's bursts
mut sceneNow f64 = 0d;        // the scene's time, seconds, at this frame's publish
mut hardLandingsMailed u64 = 0u64;  // hard landings posted to the world's mail

// The view a headless run picks in (no window to measure)
const HEADLESS_W f32 = 1280.;
const HEADLESS_H f32 = 720.;
const FOV f32 = 1.0471976;    // 60 degrees, vertical

// Where the viewer starts: 8 m back from the origin, facing down -z
const START_Z f32 = 8.;

// SDL3's scancodes for P and F (the sdl package binds only some letters)
const SCANCODE_F = 9u;
const SCANCODE_P = 19u;

// The scene clock's keys: P pauses scene time (and starts it again), F runs
// it ten times as fast (and back), for testing the day and the timers
struct ClockActions {
  pub pause Action;
  pub fast Action;

  pub fn bind(ctx &mut Context) ClockActions {
    imm pause = ctx.action("clock.pause", BUTTON);
    ctx.bind(pause, Binding.key(SCANCODE_P));
    imm fast = ctx.action("clock.fast", BUTTON);
    ctx.bind(fast, Binding.key(SCANCODE_F));
    new ClockActions(pause, fast);
  }
}

// The GPU side, made by start; the device outlives what it made
struct Gfx {
  pub readback Buffer;
  pub shotName String;        // the file the frame read back goes to; empty: none
  pub target SurfaceTexture;
  pub post Post;              // the HDR frame drawn into, bloomed and tone-mapped into the target
  pub sys RenderSystem;
  pub renderer Renderer;
  pub swapchain SwapChain;
  pub device Device;
  pub adapter Adapter;
  pub surface Surface;
  pub instance Instance;
  pub camera Camera;
}

mut gfx Option[Gfx];

fn @initpure init() {
  gfx = None[Gfx][];
  scene = Scene.empty();
  inputState = Input.empty();
  ctx = Context.empty();
  user = UserController.bind(&mut ctx);
  clockKeys = ClockActions.bind(&mut ctx);
  cast = Cast.empty();
  sentBodies = List[Walk].empty();
  snapshot = Snapshot.empty();
  shotsDir = String.empty();
  world = BakedWorld.make();
  tempPart = PartId.none();
  probeFrom = new Vec3(0., 0., 0.);
  picks = PickSystem.empty();
  clickAt = new Vec2(0., 0.);
  picked = PartId.none();
  lastPick = new PickHit(PartId.none(), 0., 0u32, 0u64);
}

fn takeGfx() Option[Gfx] {
  mut g Option[Gfx] = None[Gfx][];
  g <=> gfx;
  g;
}

fn millisSinceStart() f64 {
  f64.from(sdl.GetPerformanceCounter() - startedAt) / f64.from(sdl.GetPerformanceFrequency()) * 1000d;
}

// Whether the run has the GPU side
fn hasGpu() bool {
  mut g = takeGfx();
  mut has = false;
  match &mut g {
    case mut some &mut Some { has = true; }
    else {}
  }
  gfx = g;
  has;
}

// Whether part 'id' is in the render system's tables: drawn, or giving off particles
fn isDrawn(id PartId) bool {
  mut g = takeGfx();
  mut drawn = false;
  match &mut g {
    case mut some &mut Some {
      drawn = some.value.sys.rows.find(id) != NO_ROW or some.value.sys.effects.find(id) != NO_ROW;
    }
    else {}
  }
  gfx = g;
  drawn;
}

// Whether part 'id' is drawn physically based
fn isPhysical(id PartId) bool {
  mut g = takeGfx();
  mut physical = false;
  match &mut g {
    case mut some &mut Some { physical = some.value.sys.isPhysical(id); }
    else {}
  }
  gfx = g;
  physical;
}

// The material part 'id' is drawn in, as the render system has it (none
// without a GPU)
fn drawnMaterial(id PartId) MaterialId {
  mut g = takeGfx();
  mut m = MaterialId.none();
  match &mut g {
    case mut some &mut Some { m = some.value.sys.materialOf(id); }
    else {}
  }
  gfx = g;
  m;
}

// The possessed being's body: where the user is
fn youBody() Walk { cast.beings[cast.possessed].body; }

// A mannequin of 'height' metres made, shown and added to the cast standing
// at 'at' facing 'yaw': the index of its being
fn addMannequin(name &[]u8, at Vec3, yaw f32, height f32, seed u32, color Color) usize {
  imm root = scene.newPart(name);
  imm parts = spawnMannequin(&mut scene, height, color, root);
  cast.add(Being.mannequin(root, at, yaw, Figure.make(height, seed, parts)));
}

// How many parts a mannequin is: its own and a part a bone
const FIGURE_PARTS = 20usize;
const FIGURE_MESHES = 19u64;

// ---- start ----

pub fn start(host &mut Host) bool {
  automated = host.config.frames > 0u64 or watching();
  seedScene(&mut scene);
  if scripted {
    // The scripted run keeps its exact walk checks: it starts as the plain
    // walker, 8 m back from the origin, facing -z, and takes the mannequin
    // over by pressing Tab at its end. The mannequins stand off to the right.
    imm youAt = cast.add(Being.make(scene.newPart("you"), Walk.make(new Vec3(0., 0., START_Z), 0.)));
    cast.possess(youAt);
    addMannequin("mannequin", new Vec3(5., 0., START_Z), 0., 1.75, 3u32, woodColor());
    addMannequin("second mannequin", new Vec3(3.5, 0., START_Z - 3.), 2.356, 1.62, 11u32, clayColor());
  } else {
    // The user's own being: a mannequin 8 m back from the origin, facing -z,
    // possessed, seen from behind and above; another stands a few metres off
    imm youAt = addMannequin("mannequin", new Vec3(0., 0., START_Z), 0., 1.75, 3u32, woodColor());
    addMannequin("second mannequin", new Vec3(3., 0., START_Z - 3.), 2.356, 1.62, 11u32, clayColor());
    cast.possess(youAt);
  }
  cast.look(1. / 60.);
  print <- "Scene: "; print <- scene.partCount(); print <- " parts reserved, ";
  print <- scene.waiting(); print <- " requests waiting\n";
  if scripted { pushScript(1u64); }
  if !host.hasWindow() { return true; }

  mut instance = Instance.create("browser");
  mut surface = instance.createSurface(host.window().sdlHandle());
  mut preference = POWER_PREFERENCE_HIGH_PERFORMANCE;
  imm env = libc.getenv(&"GPU_POWER_PREFERENCE" as *u8);
  if (env as usize) != 0usize {
    if libc.strcmp(env, &"low-power" as *u8) == 0i32 { preference = POWER_PREFERENCE_LOW_POWER; }
  }
  mut adapter = instance.requestAdapter(&surface, preference);
  if !adapter.isValid() {
    print <- "No GPU can draw to the window\n";
    return false;
  }
  print <- "Adapter: "; printStr(adapter.name.view());
  if instance.validation { print <- "; validation layer on\n"; } else { print <- "; validation layer off\n"; }
  mut device = adapter.requestDevice();
  imm size = host.window().size();
  mut swapchain = device.createSwapChain(&surface, u32.from(size.w), u32.from(size.h), TEXTURE_FORMAT_DEPTH32_FLOAT);
  // The scene is drawn into a half-float frame, which the Post blooms and
  // tone-maps into the swapchain's texture (lookPost says how)
  mut renderer = Renderer.create(&mut device, TEXTURE_FORMAT_RGBA16_FLOAT, TEXTURE_FORMAT_DEPTH32_FLOAT);
  mut post = Post.create(&mut device, swapchain.format, u32.from(size.w), u32.from(size.h));
  lookPost(&mut post);
  // The depth kept after the scene's pass, for the particles' pass to test against
  renderer.keepDepth = true;
  // The environment the physical parts are lit by besides the sun; the sky
  // drawn stays the clear colour
  imm environment = environmentSky();
  renderer.setSky(&mut device, &environment);
  renderer.drawSky = false;
  mut sys = RenderSystem.make(&mut device, TEXTURE_FORMAT_RGBA16_FLOAT);
  if !renderer.isValid() or !sys.particles.isValid() or !post.isValid() {
    print <- "The renderer could not be made\n";
    return false;
  }
  mut camera = Camera.make();
  camera.fov = FOV;
  camera.near = 0.1;
  camera.far = 1500.;
  imm target = swapchain.getCurrentTexture(&mut device);
  gfx = Some[Gfx][new Gfx(Buffer.none(), String.empty(), target, post, sys, renderer, swapchain, device,
    adapter, surface, instance, camera)];
  true;
}

// ---- input ----

// Whether an event may reach the walk: any, when someone is at the
// keyboard; only the script's own in a run of a fixed number of frames
fn accepted(e &sdl.Event) bool {
  if !automated { return true; }
  if e.type == sdl.EVENT_KEY_DOWN or e.type == sdl.EVENT_KEY_UP {
    return (e as &sdl.KeyboardEvent).which == SCRIPT_DEVICE;
  }
  if e.type == sdl.EVENT_MOUSE_MOTION { return (e as &sdl.MouseMotionEvent).which == SCRIPT_DEVICE; }
  if e.type == sdl.EVENT_MOUSE_BUTTON_DOWN or e.type == sdl.EVENT_MOUSE_BUTTON_UP {
    return (e as &sdl.MouseButtonEvent).which == SCRIPT_DEVICE;
  }
  if e.type == sdl.EVENT_MOUSE_WHEEL { return (e as &sdl.MouseWheelEvent).which == SCRIPT_DEVICE; }
  // The window losing focus lets go of every key held: of the real
  // keyboard's, which is ignored here, not of the script's
  if e.type == sdl.EVENT_WINDOW_FOCUS_LOST { return false; }
  true;
}

// The input package's frame begun once a frame, before its first event
fn beginInput(frameNo u64) {
  if inputFrame != frameNo {
    inputState.beginFrame();
    inputFrame = frameNo;
  }
}

// The actions brought up to date once a frame, after every event
fn updateActions(frameNo u64) {
  if ctxFrame != frameNo {
    beginInput(frameNo);
    ctx.update(&inputState);
    ctxFrame = frameNo;
  }
}

pub fn event(host &mut Host, e &imm sdl.Event) {
  if host.hasWindow() and host.window().resized {
    host.window().resized = false;
    imm s = host.window().size();
    mut g = takeGfx();
    match &mut g {
      case mut some &mut Some { some.value.swapchain.resize(u32.from(s.w), u32.from(s.h)); }
      else {}
    }
    gfx = g;
  }
  beginInput(host.frame);
  if watching() { watchEvent(e); }
  if accepted(e) { inputState.handle(e); }
}

// ---- simulate ----

pub fn simulate(host &mut Host, step &imm Step, scratch &mut Arena) {
  updateActions(host.frame);
  // input -> the user's controller -> the possessed being's intents
  cast.step(user.intents(&ctx), step.dt);
  scene.advanceClock(step.ns);
}

// ---- publish: the apply point ----

pub fn publish(host &mut Host) {
  updateActions(host.frame);
  if ctx.pressed(clockKeys.pause) {
    scene.togglePause();
    print <- "Scene time "; if scene.clock.paused { print <- "paused"; } else { print <- "running"; };
    print <- " at "; print <- scene.now(); print <- " s\n";
  }
  if ctx.pressed(clockKeys.fast) {
    scene.toggleFast();
    print <- "Scene time x"; print <- scene.clock.rate(); print <- " at "; print <- scene.now(); print <- " s\n";
  }
  sceneNow = scene.now();
  // The view and possession keys: V first or third person, Tab the next mannequin
  if ctx.pressed(user.actions.view) {
    cast.rig.toggle();
    print <- "View: "; if cast.rig.mode == VIEW_FIRST { print <- "first person"; } else { print <- "third person"; }; print <- "\n";
  }
  if ctx.pressed(user.actions.swap) {
    cast.swap();
    print <- "Possessing being "; print <- cast.possessed; print <- "\n";
  }
  // Hard landings, mailed to the world
  mut landings = cast.takeLandings();
  mut li = 0usize;
  while li < landings.len() {
    imm l = *landings[li];
    scene.post(Message.HardLanding[l.part, l.speed, l.damage]);
    hardLandingsMailed = hardLandingsMailed + 1u64;
    li = li + 1usize;
  }
  if (inputState.buttonsPressed & sdl.BUTTON_MASK_LEFT) != 0u { click(host); }
  // The scene's events, into the world's mail: timers due, and the areas
  // the possessed being is in
  scene.ring();
  imm you = youBody();
  scene.sense(cast.beings[cast.possessed].part, you.position);
  // The world is handed the Door, never the scene
  if world.step(&mut scene.door) and world.done() { worldSentFrame = host.frame; }
  world.tick(&mut scene.door, sceneNow);
  placeBeings();
  placeFigures();
  applyRequests();
  scene.propagate();
  mut last = Snapshot.empty();
  last <=> snapshot;
  snapshot = scene.publish(last, cast.eyesBefore(), cast.eyes());
}

// Each being's part placed where its body is, when it has moved
fn placeBeings() {
  mut i = 0usize;
  while i < cast.beings.len() {
    imm b = &mut cast.beings[i];
    if i >= sentBodies.len() {
      sentBodies.push(b.body);
      scene.send(Request.Place[b.part, b.placement()]);
    } else {
      imm was = *sentBodies[i];
      if was.position.x != b.body.position.x or was.position.y != b.body.position.y
        or was.position.z != b.body.position.z or was.yaw != b.body.yaw {
        sentBodies.set(i, b.body);
        scene.send(Request.Place[b.part, b.placement()]);
      }
    }
    i = i + 1usize;
  }
}

// Each mannequin's bones placed, each in its parent's frame: the pose the
// gait wrote this step, and the scene's tree composes the rest
fn placeFigures() {
  mut i = 0usize;
  while i < cast.beings.len() {
    imm b = &mut cast.beings[i];
    if b.figure.active {
      mut k = 0usize;
      while k < b.figure.parts.len() {
        scene.send(Request.Place[*b.figure.parts[k], *b.figure.pose.locals[k]]);
        k = k + 1usize;
      }
    }
    i = i + 1usize;
  }
}

// The view the mouse's places are in: the window's own units, or a fixed
// size in a headless run
pub fn viewSize(host &mut Host) Vec2 {
  if !host.hasWindow() { return new Vec2(HEADLESS_W, HEADLESS_H); }
  imm r = host.window().windowSize();
  new Vec2(f32.from(r.w), f32.from(r.h));
}

// A click where the pointer is: the part it hits picked, reported and
// highlighted (the one before let go), and, if its sender listens for its
// clicks, posted to the sender's Door. The eye is where the last picture
// was drawn from.
fn click(host &mut Host) {
  imm size = viewSize(host);
  imm eye = snapshot.eyeTo;
  imm ray = rayThrough(eye, FOV, inputState.pointer.x, inputState.pointer.y, size.x, size.y);
  imm t0 = sdl.GetPerformanceCounter();
  imm hit = picks.pick(&scene, ray);
  imm us = f64.from(sdl.GetPerformanceCounter() - t0) / f64.from(sdl.GetPerformanceFrequency()) * 1.0e6d;
  clicks = clicks + 1u64;
  lastPick = hit;
  print <- "Click at ("; print <- inputState.pointer.x; print <- ", "; print <- inputState.pointer.y; print <- "): ";
  if hit.id.isNone() {
    print <- "nothing";
  } else {
    imm name = scene.nameOf(hit.id);
    printStr(name.view()); print <- ", "; print <- hit.distance; print <- " m away";
  }
  print <- " ("; print <- hit.boxesHit; print <- " boxes entered, "; print <- hit.triangles; print <- " triangles tested, ";
  print <- us; print <- " us)\n";
  if !picked.isNone() and !(picked == hit.id) { scene.send(Request.Highlight[picked, false]); }
  if !hit.id.isNone() {
    scene.send(Request.Highlight[hit.id, true]);
    if scene.isListening(hit.id) { scene.post(Message.Clicked[hit.id]); }
  }
  picked = hit.id;
}

// Apply every request waiting, in the order sent, each by the system that
// owns what it changes
fn applyRequests() {
  if scene.waiting() == 0usize { return; }
  mut batch = scene.takeInbox();
  mut g = takeGfx();
  imm requests = batch.viewMut();
  mut i = 0usize;
  while i < requests.len {
    mut r Request = Request.Done[];
    r <=> requests[i];
    match &mut r {
      case mut s &mut Spawn {
        mut name = String.empty();
        name <=> s.name;
        scene.applySpawn(s.id, name);
      }
      case mut p &mut Place { scene.applyPlace(p.id, p.at); }
      case mut pa &mut Parent { scene.applyParent(pa.id, pa.parent); }
      case mut d &mut Despawn {
        // The part and its whole subtree: the scene's rows first, then
        // every other system's for each part that went
        mut gone = List[PartId].empty();
        if scene.applyDespawn(d.id, &mut gone) {
          mut k = 0usize;
          while k < gone.len() {
            imm id = *gone[k];
            match &mut g {
              case mut some &mut Some { some.value.sys.drop(&mut some.value.device, id); }
              else {}
            }
            picks.drop(id);
            k = k + 1usize;
          }
        }
      }
      case mut dm &mut DefineMesh {
        if scene.applyDefine(dm.mesh.id, KIND_MESH) {
          // The picking system keeps its shape; the render system uploads it
          picks.shape(dm.mesh, &dm.shape);
          match &mut g {
            case mut some &mut Some {
              some.value.sys.defineMesh(&mut some.value.renderer, &mut some.value.device, dm.mesh, &dm.shape);
            }
            else { unrendered = unrendered + 1u64; }
          }
        }
      }
      case mut dl &mut DefineMaterial {
        if scene.applyDefine(dl.material.id, KIND_MATERIAL) {
          match &mut g {
            case mut some &mut Some {
              some.value.sys.defineMaterial(&mut some.value.renderer, &mut some.value.device, dl.material, &dl.surface,
                &dl.paint, &dl.maps);
            }
            else { unrendered = unrendered + 1u64; }
          }
        }
      }
      case mut sh &mut Show {
        if !scene.isLive(sh.id) or !scene.isMesh(sh.mesh) or !scene.isMaterial(sh.material) {
          scene.refused = scene.refused + 1u64;
        } else {
          // The picking system keeps which mesh it is (not the ground's: an
          // anchored part is drawn wherever the viewer is)
          if sh.anchor == 0. { picks.show(sh.id, sh.mesh); }
          match &mut g {
            case mut some &mut Some { some.value.sys.show(sh.id, sh.mesh, sh.material, sh.anchor); }
            else { unrendered = unrendered + 1u64; }
          }
          scene.applied = scene.applied + 1u64;
        }
      }
      case mut tm &mut Timer { scene.applyTimer(tm.token, tm.at, tm.every); }
      case mut cn &mut Cancel { scene.applyCancel(cn.token); }
      case mut ar &mut Area { scene.applyArea(ar.id, ar.volume); }
      case mut ef &mut Effect {
        if !scene.isLive(ef.id) {
          scene.refused = scene.refused + 1u64;
        } else {
          match &mut g {
            case mut some &mut Some {
              some.value.sys.effect(&mut some.value.device, ef.id, &ef.layers, ef.seed, ef.start, ef.stop);
            }
            else { unrendered = unrendered + 1u64; }
          }
          scene.applied = scene.applied + 1u64;
        }
      }
      case mut f &mut Fire {
        if !scene.isLive(f.id) {
          scene.refused = scene.refused + 1u64;
        } else {
          match &mut g {
            case mut some &mut Some { some.value.sys.fire(f.id, f.seed, f.start, f.stop); }
            else { unrendered = unrendered + 1u64; }
          }
          fired = fired + 1u64;
          scene.applied = scene.applied + 1u64;
        }
      }
      case mut l &mut Listen { scene.applyListen(l.id); }
      case mut hl &mut Highlight {
        if !scene.isLive(hl.id) {
          scene.refused = scene.refused + 1u64;
        } else {
          match &mut g {
            case mut some &mut Some {
              some.value.sys.highlight(&mut some.value.renderer, &mut some.value.device, hl.id, hl.on);
            }
            else { unrendered = unrendered + 1u64; }
          }
          scene.applied = scene.applied + 1u64;
        }
      }
      case mut k &mut Sky {
        if !scene.isLive(k.id) {
          scene.refused = scene.refused + 1u64;
        } else {
          match &mut g {
            case mut some &mut Some { some.value.sys.sky(k.id, k.look); }
            else { unrendered = unrendered + 1u64; }
          }
          scene.applied = scene.applied + 1u64;
        }
      }
      else {}
    }
    i = i + 1usize;
  }
  gfx = g;
}

// ---- draw ----

pub fn draw(host &mut Host, alpha f32, scratch &mut Arena) {
  updateActions(host.frame);
  mut pose = snapshot.eye(alpha);
  // A scripted close-up looks from where the script says instead
  if scripted and hasView(host.frame) { pose = viewAt(host.frame); }
  mut g = takeGfx();
  match &mut g {
    case mut some &mut Some { drawFrame(&mut some.value, pose, host.frame); }
    else {}
  }
  gfx = g;
}

fn drawFrame(g &mut Gfx, pose Pose, frameNo u64) {
  if !g.target.ok() { return; }
  imm sky = g.sys.currentSky();
  g.camera.origin = pose.origin;
  g.camera.orientation = pose.orientation;
  // A scripted close-up may look through a longer lens
  g.camera.fov = if scripted and hasView(frameNo) { viewFov(frameNo); } else { FOV; };
  g.camera.background = sky.color;
  imm light = Light.directional(new Vec3(0., 0., 0.) - sky.sunDirection, sky.sunColor, sky.ambient);
  g.renderer.exposure = exposureFor(&sky);
  g.sys.build(&snapshot, pose.origin);
  mut encoder = g.device.createCommandEncoder();
  // Into the HDR frame (the size of the target), then bloomed and
  // tone-mapped into the target
  g.post.resize(&mut g.device, g.target.texture.width, g.target.texture.height);
  g.renderer.render(&mut g.device, &mut encoder, &g.post.hdr, &g.target.depth, &g.camera, &light, &g.sys.list);
  if g.sys.hasEffects() {
    g.sys.aimEffects(&mut g.device, &snapshot);
    g.sys.particles.render(&mut g.device, &mut encoder, &g.post.hdr, &g.target.depth, &g.camera);
  }
  g.post.apply(&mut encoder, &g.target.texture);

  // A scripted view to save: copied now, written once presented
  imm shot = shotAt(frameNo);
  if shotsDir.len() > 0usize and shot.len > 0usize {
    imm w = g.target.texture.width;
    imm h = g.target.texture.height;
    g.readback = g.device.createBuffer(u64.from(w) * u64.from(h) * 4u64, BUFFER_USAGE_MAP_READ | BUFFER_USAGE_COPY_DST);
    encoder.copyTextureToBuffer(&g.target.texture, &g.readback);
    mut name = shotsDir.copy();
    name <- "/";
    name <- shot;
    name <- ".bmp";
    g.shotName = name;
  }
  g.device.queue.submit(encoder.finish());
}

// ---- present ----

pub fn present(host &mut Host) {
  mut g = takeGfx();
  match &mut g {
    case mut some &mut Some { showAndAcquire(&mut some.value); }
    else {}
  }
  gfx = g;
  if host.frame == 1u64 {
    print <- "The first frame presented "; print <- millisSinceStart(); print <- " ms after main began\n";
  }
  // The first frame on screen with every object of the world in it
  if world.done() and worldShownAt == 0u64 and host.frame >= worldSentFrame {
    worldShownAt = sdl.GetPerformanceCounter();
    print <- "The world: every object visible at frame "; print <- host.frame; print <- ", ";
    print <- millisSinceStart(); print <- " ms after main began\n";
  }
  if scripted {
    imm you = youBody();
    if !checkScript(host.frame, &you) { scriptOk = false; }
    driveScene(host.frame);
    pushScript(host.frame + 1u64);
    pushClicks(host, host.frame + 1u64, &you);
  }
  if watching() or soaking() { watchSizes(host); }
}

// A watched run's line and probe, or a soak's checks, with the scene's and
// the render system's sizes
fn watchSizes(host &mut Host) {
  mut rows = 0usize;
  mut emitters = 0usize;
  mut g = takeGfx();
  match &mut g {
    case mut some &mut Some {
      rows = some.value.sys.rows.len();
      emitters = some.value.sys.particles.emitterCount();
    }
    else {}
  }
  gfx = g;
  imm you = youBody();
  if watching() { watchTick(host, &you, scene.waiting(), rows, emitters); }
  if soaking() { soakTick(host, world.done(), scene.partCount(), scene.waiting(), rows, emitters); }
}

fn showAndAcquire(g &mut Gfx) {
  imm t0 = sdl.GetTicksNS();
  if g.target.ok() {
    g.swapchain.present(&mut g.device);
    watchPresentNs = watchPresentNs + (sdl.GetTicksNS() - t0);
    if g.shotName.len() > 0usize {
      g.device.waitIdle();
      imm w = g.target.texture.width;
      imm h = g.target.texture.height;
      imm bgra = g.target.texture.format == TEXTURE_FORMAT_BGRA8_UNORM_SRGB
        or g.target.texture.format == TEXTURE_FORMAT_BGRA8_UNORM;
      imm img = Image.fromTexels(g.readback.mappedRange(), i32.from(w), i32.from(h), bgra);
      imm written = img.save(g.shotName.view());
      print <- "Screenshot: "; printStr(g.shotName.view());
      if written { print <- "\n"; } else { print <- " could NOT be written\n"; scriptOk = false; }
      g.shotName = String.empty();
      g.readback = Buffer.none();
    }
  } else {
    sdl.Delay(10u32);
  }
  imm t1 = sdl.GetTicksNS();
  g.target = g.swapchain.getCurrentTexture(&mut g.device);
  watchAcquireNs = watchAcquireNs + (sdl.GetTicksNS() - t1);
  watchTexture(g.target.status);
}

// ---- quit ----

pub fn quit(host &mut Host) i32 {
  print <- "Scene: "; print <- scene.partCount(); print <- " parts; requests applied "; print <- scene.applied;
  print <- ", refused "; print <- scene.refused; print <- "\n";
  imm you = youBody();
  print <- "Walked to ("; print <- you.position.x; print <- ", "; print <- you.position.z;
  print <- "), facing "; print <- you.yaw; print <- " rad\n";
  print <- "Scene time "; print <- scene.now(); print <- " s, the day clock at "; print <- scene.hour();
  print <- " h; timers rung "; print <- scene.rung(); print <- ", armed "; print <- scene.timerCount(); print <- "\n";
  print <- "The baked-in world, object by object:\n";
  world.report();
  mut code = 0i32;
  if scripted and !scriptOk { code = 1i32; }
  if soaking() and soakReport() != 0i32 { code = 1i32; }
  if !host.hasWindow() {
    if unrendered > 0u64 { print <- "Headless: "; print <- unrendered; print <- " render requests had no GPU\n"; }
    if scripted { reportScript(scriptOk); }
    return code;
  }
  mut g = takeGfx();
  match &mut g {
    case mut some &mut Some {
      some.value.device.waitIdle();
      print <- "Parts drawn: "; print <- some.value.sys.drawn; print <- "; draws ";
      print <- u64.from(some.value.renderer.drawCalls); print <- ", triangles "; print <- some.value.renderer.triangles;
      print <- "\n";
    }
    else {}
  }
  g = None[Gfx][];
  print <- "Vulkan failures: "; print <- u64.from(failures());
  print <- "; validation messages: "; print <- u64.from(validationMessages()); print <- "\n";
  if failures() != 0u32 or validationMessages() != 0u32 { code = 1i32; }
  if scripted { reportScript(scriptOk); }
  code;
}

// ---- main ----

fn main(argc i32, argv **u8) i32 {
  initAll();
  startedAt = sdl.GetPerformanceCounter();
  mut config = Config.fromArgs(argc, argv);
  config.setTitle("Pegasus3D in Cone: a baked-in world");
  mut a = 1i32;
  while a < argc {
    imm arg = *(argv + usize.from(a));
    if libc.strcmp(arg, &"--checks" as *u8) == 0i32 {
      // The scene core's headless checks (checks.cone), and nothing else
      imm result = runChecks();
      finalAll();
      return result;
    } elif libc.strcmp(arg, &"--script" as *u8) == 0i32 {
      scripted = true;
    } elif libc.strcmp(arg, &"--shots" as *u8) == 0i32 and a + 1i32 < argc {
      shotsDir = String.fromCStr(*(argv + usize.from(a + 1i32)));
      a = a + 1i32;
    } elif libc.strcmp(arg, &"--watch" as *u8) == 0i32 and a + 1i32 < argc {
      watchSeconds = wholeNumber(*(argv + usize.from(a + 1i32)));
      a = a + 1i32;
    } elif libc.strcmp(arg, &"--soak" as *u8) == 0i32 and a + 1i32 < argc {
      soakFrames = wholeNumber(*(argv + usize.from(a + 1i32)));
      config.frames = soakFrames;
      config.synthetic = true;
      a = a + 1i32;
    }
    a = a + 1i32;
  }
  if scripted {
    if config.frames == 0u64 {
      config.frames = SCRIPT_FRAMES;
      config.synthetic = true;
    }
    if config.frames < SCRIPT_FRAMES {
      print <- "--script wants at least "; print <- SCRIPT_FRAMES; print <- " frames\n";
      finalAll();
      return 2i32;
    }
  }
  imm code = run(config);
  finalAll();
  code;
}
