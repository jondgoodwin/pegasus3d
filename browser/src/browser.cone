// ---- The shell's state (the main thread's alone) ----

mut skyOff bool = false;      // --no-sky: the static sky and light, no birds (to time what the day costs)
mut npcsEnabled bool = true;  // --no-npcs: no villagers (to time what they cost, and to compare a run with and without)
mut automated bool = false;   // a run of a fixed number of frames: real input ignored
mut scripted bool = false;
mut startedAt u64 = 0u64;     // the performance counter when main began
mut worldShownAt u64 = 0u64;  // the counter once the frame that sent the world's last object was presented
// The shared island's modes (server.cone)
mut serveOn bool = false;     // --serve PORT
mut servePort u32 = 0u32;
mut serveLoopback bool = false; // --loopback: the server listens on this machine only (no firewall prompt; tests)
mut runForSeconds u64 = 0u64; // --run-for S
mut autoWalk bool = false;    // --autowalk
mut traceOn bool = false;     // --trace
mut impairOn bool = false;    // --impair LOSS LATENCY JITTER
mut impairLoss u32 = 0u32;
mut impairLatency u32 = 0u32;
mut impairJitter u32 = 0u32;

// The view a headless run picks in (no window to measure)
const HEADLESS_W f32 = 1280.;
const HEADLESS_H f32 = 720.;
const FOV f32 = 1.0471976;    // 60 degrees, vertical

// Where the old flat world's viewer started (8 m back from its origin, facing
// down -z), with the old world shifted onto the island's lowland (island.cone's
// WORLD_DX, WORLD_DZ): the scripted walk's second part begins here. The
// browser's own start is the landing beach.
const START_X f32 = WORLD_DX;
const START_Z f32 = 8. + WORLD_DZ;

// SDL3's scancodes for P and F (the sdl package binds only some letters)
const SCANCODE_F = 9u;
const SCANCODE_P = 19u;
const SCANCODE_T = 23u;

// The scene clock's keys: P pauses scene time (and starts it again), F runs
// it ten times as fast (and back), for testing the day and the timers; T
// changes the weather to the next of its six states, for testing the sky
struct ClockActions {
  pub pause Action;
  pub fast Action;
  pub weather Action;

  pub fn bind(ctx &mut Context) ClockActions {
    imm pause = ctx.action("clock.pause", BUTTON);
    ctx.bind(pause, Binding.key(SCANCODE_P));
    imm fast = ctx.action("clock.fast", BUTTON);
    ctx.bind(fast, Binding.key(SCANCODE_F));
    imm weather = ctx.action("clock.weather", BUTTON);
    ctx.bind(weather, Binding.key(SCANCODE_T));
    new ClockActions(pause, fast, weather);
  }
}

// The HUD's keys (hud.cone): H hides and shows it, F1 to F8 use the hotbar's eight slots
struct HudActions {
  pub hide Action;
  pub s0 Action;
  pub s1 Action;
  pub s2 Action;
  pub s3 Action;
  pub s4 Action;
  pub s5 Action;
  pub s6 Action;
  pub s7 Action;

  fn slot(ctx &mut Context, n u32) Action {
    imm a = ctx.action("hud.slot", BUTTON);
    ctx.bind(a, Binding.key(SCANCODE_F1 + n));
    a;
  }

  pub fn bind(ctx &mut Context) HudActions {
    imm hide = ctx.action("hud.hide", BUTTON);
    ctx.bind(hide, Binding.key(SCANCODE_H));
    imm a0 = HudActions.slot(ctx, 0u32);
    imm a1 = HudActions.slot(ctx, 1u32);
    imm a2 = HudActions.slot(ctx, 2u32);
    imm a3 = HudActions.slot(ctx, 3u32);
    imm a4 = HudActions.slot(ctx, 4u32);
    imm a5 = HudActions.slot(ctx, 5u32);
    imm a6 = HudActions.slot(ctx, 6u32);
    imm a7 = HudActions.slot(ctx, 7u32);
    new HudActions(hide, a0, a1, a2, a3, a4, a5, a6, a7);
  }

  // The slots pressed this frame, as bits
  pub fn pressedSlots(self &, ctx &Context) u32 {
    mut bits = 0u32;
    if ctx.pressed(s0) { bits = bits | 1u32; }
    if ctx.pressed(s1) { bits = bits | 2u32; }
    if ctx.pressed(s2) { bits = bits | 4u32; }
    if ctx.pressed(s3) { bits = bits | 8u32; }
    if ctx.pressed(s4) { bits = bits | 16u32; }
    if ctx.pressed(s5) { bits = bits | 32u32; }
    if ctx.pressed(s6) { bits = bits | 64u32; }
    if ctx.pressed(s7) { bits = bits | 128u32; }
    bits;
  }
}

// How many parts a mannequin is (its own, shown as its skinned body) and
// how many meshes (the body)
const FIGURE_PARTS = 1usize;
const FIGURE_MESHES = 1u64;

fn @initpure init() {
  audioCounts = AudioCounts.make();  // the sound's counters (audioview.cone)
  audioHeap = AudioHeap.make();
  probeFrom = new Vec3(0., 0., 0.);
  // The scripted run's own (script.cone, assembly.cone): touched only from the
  // scene actor's end of frame
  clickAt = new Vec2(0., 0.);
  tempPart = PartId.none();
  ballRest = new Vec3(0., 0., 0.);
  viewEye = new Vec3(0., 0., 0.);
  viewTarget = new Vec3(0., 0., 0.);
  // The ride's (ridescript.cone), the same
  restMouth = new Vec3(0., 0., 0.);
  restFront = new Vec3(0., 0., 1.);
  rideLocal0 = new Vec3(0., 0., 0.);
  leftAt = new Vec3(0., 0., 0.);
}

fn millisSinceStart() f64 {
  f64.from(sdl.GetPerformanceCounter() - startedAt) / f64.from(sdl.GetPerformanceFrequency()) * 1000d;
}

// ---- input ----

// Whether an event may reach the walk: any, when someone is at the
// keyboard; only the script's own in a run of a fixed number of frames
fn accepted(e &sdl.Event) bool {
  if !automated { return true; }
  if e.type == sdl.EVENT_KEY_DOWN or e.type == sdl.EVENT_KEY_UP {
    return (e as &sdl.KeyboardEvent).which == SCRIPT_DEVICE;
  }
  if e.type == sdl.EVENT_MOUSE_MOTION { return (e as &sdl.MouseMotionEvent).which == SCRIPT_DEVICE; }
  if e.type == sdl.EVENT_MOUSE_BUTTON_DOWN or e.type == sdl.EVENT_MOUSE_BUTTON_UP {
    return (e as &sdl.MouseButtonEvent).which == SCRIPT_DEVICE;
  }
  if e.type == sdl.EVENT_MOUSE_WHEEL { return (e as &sdl.MouseWheelEvent).which == SCRIPT_DEVICE; }
  // The window losing focus lets go of every key held: of the real
  // keyboard's, which is ignored here, not of the script's
  if e.type == sdl.EVENT_WINDOW_FOCUS_LOST { return false; }
  true;
}

// The shell's input: the input package's state, the actions bound on it and the controllers over them. The main thread's alone,
// made by shellRun and kept there.
struct ShellInput {
  state Input;
  ctx Context;
  user UserController;        // the user's: the actions into the possessed being's intents
  clockKeys ClockActions;     // the pause and x10 keys
  audioKeys AudioKeys;        // N: mute
  hudKeys HudActions;         // the HUD's: H and F1 to F8
  ctxFrame u64;               // the frame whose actions are in 'ctx'
  inputFrame u64;             // the frame whose events are in 'state'

  fn make() ShellInput {
    mut ctx = Context.empty();
    imm user = UserController.bind(&mut ctx);
    imm clockKeys = ClockActions.bind(&mut ctx);
    imm audioKeys = AudioKeys.bind(&mut ctx);
    imm hudKeys = HudActions.bind(&mut ctx);
    new ShellInput(Input.empty(), ctx, user, clockKeys, audioKeys, hudKeys, 0u64, 0u64);
  }

  // The input package's frame begun once a frame, before its first event
  fn beginInput(self &mut, frameNo u64) {
    if inputFrame != frameNo {
      state.beginFrame();
      inputFrame = frameNo;
    }
  }

  // The actions brought up to date once a frame, after every event
  fn updateActions(self &mut, frameNo u64) {
    if ctxFrame != frameNo {
      self.beginInput(frameNo);
      ctx.update(&state);
      ctxFrame = frameNo;
    }
  }
}

// What the arguments say that the shell and its actors are given: where a scripted run writes its views, the server to join, and
// the sound's options. Made by main, handed to shellRun.
struct Startup {
  shotsDir String;            // --shots DIR
  connectTo String;           // --connect HOST:PORT
  audio AudioOptions;

  fn make() Startup { new Startup(String.empty(), String.empty(), AudioOptions.make()); }
}

// The view the mouse's places are in: the window's own units, or a fixed
// size in a headless run
pub fn viewSize(host &mut Host) Vec2 {
  if !host.hasWindow() { return new Vec2(HEADLESS_W, HEADLESS_H); }
  imm r = host.window().windowSize();
  new Vec2(f32.from(r.w), f32.from(r.h));
}

// ---- the shell's loop ----

// The run: the window and the clock (frame's Host), the actors made, then a
// frame at a time until the run is over, and the actors' reports. Its answer
// is the run's exit code.
fn shellRun(config Config, startup Startup) i32 {
  mut host = Host.open(config);
  if !host.isOpen() { return 1i32; }
  mut shell = ShellInput.make();
  automated = host.config.frames > 0u64 or watching();
  // The flock is made before the island is baked, as it was when the sky rig
  // was a global made by the module's initializer: its home's height and its
  // birds' first heights are read off the ground before there is one (0 m).
  // Making it after the bake would lift the birds (a change to every view
  // with a bird in it), so it is left as it was; the scene actor steps it.
  imm birds = Birds.make();
  // The view flies a flock of its own (cosmetic, and the same as the simulation's: both are made here)
  imm viewBirds = Birds.make();
  // The island's land is baked first (the beings stand on it, the world
  // grows on it), here, before any actor starts: from then on it is only
  // read, by every actor
  imm bakeStart = sdl.GetPerformanceCounter();
  bakeIsland();
  print <- "The island: baked in "; print <- f64.from(sdl.GetPerformanceCounter() - bakeStart) * 1000d
    / f64.from(sdl.GetPerformanceFrequency()); print <- " ms\n";
  // The vegetation's layout is laid out here too, before any actor starts: the scene
  // actor's solids (trunks, rocks) and the world actor's trees read the same list
  vegetationLayout();

  // The shell's three inboxes: render's word that it could make the GPU
  // side, each frame's report, and the run's exit code
  mut readyTx Sender[bool];
  mut readyRx Receiver[bool];
  readyTx, readyRx = Channel[bool].make();
  mut framesTx Sender[FrameReport];
  mut framesRx Receiver[FrameReport];
  framesTx, framesRx = Channel[FrameReport].make();
  mut endTx Sender[i32];
  mut endRx Receiver[i32];
  endTx, endRx = Channel[i32].make();

  // Render first: its initializer makes the device here, on the thread that
  // made the window (the window's handle is handed over as a number)
  mut window = 0usize;
  mut width = 0u32;
  mut height = 0u32;
  if host.hasWindow() {
    window = host.window().sdlHandle() as *u8 as usize;
    imm size = host.window().size();
    width = u32.from(size.w);
    height = u32.from(size.h);
  }
  imm render = new RenderActor(window, width, height, skyOff, scripted, startup.shotsDir.copy(), readyTx);
  mut ready = false;
  match readyRx.recv() {
    case imm r Some { ready = r; }
    case is None[bool] {}
  }
  if !ready { return 1i32; }
  // The connection: single player joins the simulation and the view in this process (netmsg's pairInProcess); connected,
  // the view dials a server's UDP port and its simulation is there. What each end's connection tells comes to its
  // actor as a message (onNet), in the order told
  mut joinedTx Sender[bool];
  mut joinedRx Receiver[bool];
  joinedTx, joinedRx = Channel[bool].make();
  imm connected = startup.connectTo.len() > 0usize;
  mut simOpt Option[SimActor] = None;
  mut simOpt2 Option[SimActor] = None;
  mut endpointOpt Option[Endpoint] = None;
  mut joinsToWait = 1;
  if !connected {
    imm world = new WorldActor(scripted);
    mut servedTx Sender[u64];
    mut servedRx Receiver[u64];
    servedTx, servedRx = Channel[u64].make();
    imm sim = new SimActor(scripted, birds, world, false, joinedTx.clone(), servedTx);
    simOpt = Some[SimActor](sim);
    simOpt2 = Some[SimActor](sim);
    joinsToWait = 2;
  }
  imm view = new ViewActor(simOpt, render, framesTx, endTx, viewBirds, !connected, joinedTx, startup.audio.copy(), automated);
  imm viewHandler = eventHandler(new So[fn(ev NetEvent) + Sendable](fn(ev NetEvent) [view] { view.onNet(ev); }));
  if connected {
    imm addr = parseAddress(startup.connectTo.view());
    imm bound = mustConnect(addr, NetConfig.defaults(), viewHandler);
    // (the other branch hands the same handler on)
    endpointOpt = Some[Endpoint](bound.endpoint);
    print <- "Connecting to "; printStr(startup.connectTo.view()); print <- "\n";
  }
  if !connected {
    // Single player: the simulation joins its connection to the view's
    match &simOpt2 {
      case imm s Some { s.wire(viewHandler); }
      else {}
    }
  }
  // Wait until the connection is open at both ends (the first frame has its client)
  mut allJoined = true;
  mut waited = 0;
  while waited < joinsToWait {
    match joinedRx.recv() {
      case imm j Some { if !j { allJoined = false; } }
      case is None[bool] { allJoined = false; }
    }
    waited = waited + 1;
  }
  if !allJoined {
    print <- "The connection could not be opened\n";
    return 1i32;
  }
  if scripted { pushScript(1u64); }
  imm runStart = sdl.GetTicksNS();

  while host.beginFrame() {
    if runForSeconds > 0u64 and sdl.GetTicksNS() - runStart > runForSeconds * 1000000000u64 { break; }
    // Input: each event waiting into the input package (the window's own
    // already handled by frame's Host: quit, Escape, F11, a resize)
    host.beginPhase(PHASE_INPUT);
    mut resized = false;
    mut e = sdl.Event.empty();
    while host.nextEvent(&mut e) {
      if host.hasWindow() and host.window().resized {
        host.window().resized = false;
        resized = true;
      }
      shell.beginInput(host.frame);
      if watching() { watchEvent(&e); }
      if accepted(&e) { shell.state.handle(&e); }
    }
    host.endPhase(PHASE_INPUT);

    // The frame's steps, the actions brought up to date once, and what the
    // scene is handed: the user's controller's intents, the keys pressed,
    // a click, the window's sizes
    mut steps = List[Step].empty();
    imm firstStep = host.fixed.taken;
    while host.fixed.next() {
      host.stats.steps = host.fixed.taken;
      steps.push(host.step());
    }
    shell.updateActions(host.frame);
    audioKeyFrame(&shell.audioKeys, &shell.ctx);
    imm alpha = host.alpha();
    mut width = 0u32;
    mut height = 0u32;
    if host.hasWindow() {
      imm s = host.window().size();
      width = u32.from(s.w);
      height = u32.from(s.h);
    }
    if audioWalk { audioWalkKeys(host.frame); }
    imm intentsNow = if audioWalk { audioWalkIntents(firstStep); } elif autoWalk { autoIntents(firstStep); } else { shell.user.intents(&shell.ctx); };
    imm input = new FrameInput(host.frame, steps, intentsNow, shell.user.lookKeys(&shell.ctx), shell.user.lookDrag(&shell.ctx),
      shell.ctx.pressed(shell.clockKeys.pause), shell.ctx.pressed(shell.clockKeys.fast), shell.ctx.pressed(shell.clockKeys.weather),
      shell.ctx.pressed(shell.user.actions.view), shell.ctx.pressed(shell.user.actions.swap),
      (shell.state.buttonsPressed & sdl.BUTTON_MASK_LEFT) != 0u, new Vec2(shell.state.pointer.x, shell.state.pointer.y),
      viewSize(&mut host), alpha, resized, width, height, shell.ctx.pressed(shell.hudKeys.hide), shell.hudKeys.pressedSlots(&shell.ctx));
    view.frame(input);

    // The frame comes back presented, with each actor's phases
    mut report = FrameReport.none();
    match framesRx.recv() {
      case imm r Some { report = r; }
      case is None[FrameReport] { break; }
    }
    host.stats.phase(PHASE_SIMULATE).add(report.simulateNs, host.frame);
    host.stats.phase(PHASE_PUBLISH).add(report.publishNs, host.frame);
    host.stats.phase(PHASE_RENDER).add(report.renderNs, host.frame);
    host.stats.phase(PHASE_PRESENT).add(report.presentNs, host.frame);
    if host.frame == 1u64 {
      print <- "The first frame presented "; print <- millisSinceStart(); print <- " ms after main began\n";
    }
    // The first frame on screen with every object of the world in it
    if report.worldDone and worldShownAt == 0u64 and host.frame >= report.worldSentFrame {
      worldShownAt = sdl.GetPerformanceCounter();
      print <- "The world: every object visible at frame "; print <- host.frame; print <- ", ";
      print <- millisSinceStart(); print <- " ms after main began\n";
    }
    if watching() or soaking() {
      if host.hasWindow() {
        watchPresentNs = watchPresentNs + report.swapNs;
        watchAcquireNs = watchAcquireNs + report.acquireNs;
        watchTexture(report.status);
      }
      if watching() { watchTick(&mut host, &report.you, report.waiting, report.rows, report.emitters); }
      if soaking() { soakTick(&mut host, report.worldDone, report.parts, report.waiting, report.rows, report.emitters); }
    }
    // A run with no window on the real clock would spin: it gives the processor back between frames
    if !host.hasWindow() and !host.config.synthetic { thread.sleep(Duration.fromMillis(2i64)); }
  }

  // The end: the scene's, the world's and render's reports, in that order,
  // and the run's exit code
  view.finish(host.hasWindow());
  mut code = 1i32;
  match endRx.recv() {
    case imm c Some { code = c; }
    case is None[i32] {}
  }
  if soaking() and soakReport() != 0i32 { code = 1i32; }
  // A connection closed before the program ends: its socket's thread must stop before the actors' runtime does
  match &endpointOpt {
    case imm e Some { e.shutdown(); }
    else {}
  }
  if connected { thread.sleep(Duration.fromMillis(300i64)); }
  imm st = actors.stats();
  print <- "Actors: "; print <- u64.from(st.workers); print <- " workers, "; print <- st.messages; print <- " messages in ";
  print <- st.activations; print <- " turns, "; print <- st.steals; print <- " steals\n";
  host.finish();
  code;
}

// ---- main ----

fn main(argc i32, argv **u8) i32 {
  initAll();
  startedAt = sdl.GetPerformanceCounter();
  mut config = Config.fromArgs(argc, argv);
  config.setTitle("Pegasus3D in Cone: a baked-in world");
  mut startup = Startup.make();
  mut a = 1i32;
  while a < argc {
    imm arg = cstr.fromPtr(*(argv + usize.from(a)));     // argv's strings each end in a NUL
    if libc.strcmp(arg, "--checks") == 0i32 {
      // The scene core's headless checks (checks.cone), and nothing else
      imm result = runChecks();
      finalAll();
      return result;
    } elif libc.strcmp(arg, "--island") == 0i32 and a + 1i32 < argc {
      // The island's preview picture, as a BMP, and nothing else
      imm path = String.fromCStr(*(argv + usize.from(a + 1i32)));
      imm ok = writePreview(path.view());
      finalAll();
      return if ok { 0i32; } else { 1i32; };
    } elif libc.strcmp(arg, "--navpic") == 0i32 and a + 1i32 < argc {
      // The villagers' navigation mesh drawn top-down (npcchecks.cone), as PNGs named PREFIX-region.png and so on, and nothing else
      imm prefix = String.fromCStr(*(argv + usize.from(a + 1i32)));
      imm ok = writeNavPictures(prefix.view());
      finalAll();
      return if ok { 0i32; } else { 1i32; };
    } elif libc.strcmp(arg, "--script") == 0i32 {
      scripted = true;
    } elif libc.strcmp(arg, "--no-sky") == 0i32 {
      skyOff = true;
    } elif libc.strcmp(arg, "--audio-walk") == 0i32 and a + 1i32 < argc {
      // A scripted walk past the brook and over the bridge, recorded to a WAV (audiowalk.cone)
      audioWalkOn();
      startup.audio.setWavPath(String.fromCStr(*(argv + usize.from(a + 1i32))));
      config.frames = AUDIO_WALK_FRAMES;
      config.synthetic = true;
      a = a + 1i32;
    } elif libc.strcmp(arg, "--no-audio") == 0i32 {
      startup.audio.off = true;
    } elif libc.strcmp(arg, "--audio-muted") == 0i32 {
      startup.audio.startMuted = true;   // the device is opened but starts muted (a press of N un-mutes), for trying the device without a sound
    } elif libc.strcmp(arg, "--audio-device") == 0i32 {
      startup.audio.forceDevice = true;
    } elif libc.strcmp(arg, "--audio-wav") == 0i32 and a + 1i32 < argc {
      startup.audio.setWavPath(String.fromCStr(*(argv + usize.from(a + 1i32))));
      a = a + 1i32;
    } elif libc.strcmp(arg, "--no-vegetation") == 0i32 {
      setVegetation(false);
    } elif libc.strcmp(arg, "--no-npcs") == 0i32 {
      npcsEnabled = false;
    } elif libc.strcmp(arg, "--cull") == 0i32 and a + 1i32 < argc {
      // How the scene is culled: 0 not at all (the draw list, as before), 1 the frustum, 2 and levels of detail and
      // ranges (the default), 3 and the depth pyramid; see cullMode (rendersys.cone)
      cullMode = u32.from(wholeNumber(*(argv + usize.from(a + 1i32))));
      a = a + 1i32;
    } elif libc.strcmp(arg, "--shots") == 0i32 and a + 1i32 < argc {
      startup.shotsDir = String.fromCStr(*(argv + usize.from(a + 1i32)));
      a = a + 1i32;
    } elif libc.strcmp(arg, "--watch") == 0i32 and a + 1i32 < argc {
      watchSeconds = wholeNumber(*(argv + usize.from(a + 1i32)));
      a = a + 1i32;
    } elif libc.strcmp(arg, "--soak") == 0i32 and a + 1i32 < argc {
      soakFrames = wholeNumber(*(argv + usize.from(a + 1i32)));
      config.frames = soakFrames;
      config.synthetic = true;
      a = a + 1i32;
    } elif libc.strcmp(arg, "--serve") == 0i32 and a + 1i32 < argc {
      serveOn = true;
      servePort = u32.from(wholeNumber(*(argv + usize.from(a + 1i32))));
      a = a + 1i32;
    } elif libc.strcmp(arg, "--connect") == 0i32 and a + 1i32 < argc {
      startup.connectTo = String.fromCStr(*(argv + usize.from(a + 1i32)));
      a = a + 1i32;
    } elif libc.strcmp(arg, "--run-for") == 0i32 and a + 1i32 < argc {
      runForSeconds = wholeNumber(*(argv + usize.from(a + 1i32)));
      a = a + 1i32;
    } elif libc.strcmp(arg, "--hud-only") == 0i32 {
      // Only the HUD's part of the scripted run (hudscript.cone), to look at it quickly: the walk to the cottage, then the HUD
      scripted = true;
      hudOnly = true;
    } elif libc.strcmp(arg, "--autowalk") == 0i32 {
      autoWalk = true;
    } elif libc.strcmp(arg, "--loopback") == 0i32 {
      serveLoopback = true;
    } elif libc.strcmp(arg, "--trace") == 0i32 {
      traceOn = true;
    } elif libc.strcmp(arg, "--impair") == 0i32 and a + 3i32 < argc {
      impairOn = true;
      impairLoss = u32.from(wholeNumber(*(argv + usize.from(a + 1i32))));
      impairLatency = u32.from(wholeNumber(*(argv + usize.from(a + 2i32))));
      impairJitter = u32.from(wholeNumber(*(argv + usize.from(a + 3i32))));
      a = a + 3i32;
    }
    a = a + 1i32;
  }
  // A server, and a client that has a window or not, run on the real clock (--headless alone would make it synthetic)
  if serveOn or startup.connectTo.len() > 0usize { config.synthetic = false; }
  if serveOn {
    config.headless = true;
    imm served = serveRun(config);
    finalAll();
    return served;
  }
  if hudOnly and config.frames == 0u64 {
    config.frames = hudScriptEnd();
    config.synthetic = true;
  }
  if scripted and !hudOnly {
    if config.frames == 0u64 {
      config.frames = SCRIPT_FRAMES;
      config.synthetic = true;
    }
    if config.frames < SCRIPT_FRAMES {
      print <- "--script wants at least "; print <- SCRIPT_FRAMES; print <- " frames\n";
      finalAll();
      return 2i32;
    }
  }
  // The actors are made and let go inside shellRun, so that finalAll finds
  // them quiet and stops the workers
  imm code = shellRun(config, startup);
  finalAll();
  code;
}
