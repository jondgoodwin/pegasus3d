  ALARM_AT, Lights, GlowMaterials, nitsAt, FADE_SECONDS, NEAR_GAIN, NEAR_SECONDS, NEAR_RADIUS,
  vegetationParts, vegetationMeshSurplus, setVegetation, vegStats, vegetationLayout, Item, K_SPECIMEN, K_PINE, K_MAPLE, K_ROCK,
  K_EDGING, K_HOSTA, K_FERN, K_FLOWER, nearCottage, MAX_TREES, vegetationLayoutAgain, Flight, OBJECTS, ROCK_REACH,
