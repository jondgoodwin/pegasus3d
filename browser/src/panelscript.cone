// The "Play with others" panel's part of the scripted run (requestpanel.cone): `browser.exe --panel-only --name zz-test --shots DIR`.
// Its events go into SDL's own queue, as the rest of the scripted run's do (never the system's), and it needs a window. It runs the
// first 100 frames of the scripted run (the walk to the cottage, so that there is a picture behind the panel) and then:
//
//   frames +0, +1    H: the HUD shown                                             shot "panel-hint" at +8 (the one-line hint)
//   frames +10, +11  F9: the panel opens                                           shot "panel-open" at +20 (the name is --name's)
//   frames +22, +23  a click on the name field
//   frames +26..+33  Backspace, 8 times: the name is cleared
//   frame  +36       the text "zz-test" typed (a text-input event)
//   frames +40, +41  a click on the message field
//   frame  +44       "hello from the check" typed                                  shot "panel-typed" at +50
//   frames +54, +55  a click on Request to play: the request goes to the server    (PEGASUS_REQUEST_URL, else the address the
//                    of an automated run: a port on this machine nothing listens on, an error answer)
//                                                                                  shot "panel-answer" at +100
//   frames +104, +105 F9: the panel closes                                         shot "panel-closed" at +112
//
// The mouse is aimed where the panel puts its controls (panelTarget), in the window's own units: the panel's logical units times the
// display scale, over the pixels of a window unit. The end of the run says how many requests the panel made and how many were answered.
//
// What the run checks beyond its pictures: the panel ends the run with every request answered (the render actor's report).

pub const PANEL_FROM = 100u64;
pub const PANEL_FRAMES = 120u64;

// --panel-join: after the answer (a stub that approves), the button reads Join and is clicked, and the run goes on until the dial has
// ended one way or the other (a real-time clock: the server is another process). The two views it saves are the view's own
// (viewactor.cone's shotFor), as the simulation's script stops with the switch.
pub const PANEL_JOIN_CLICK = 130u64;     // frames after PANEL_FROM: Join clicked
pub const PANEL_JOIN_SHOT_A = 145u64;    // "panel-joining"
pub const PANEL_JOIN_SHOT_B = 300u64;    // "panel-join-result": online, or the refusal on the panel
pub const PANEL_JOIN_FRAMES = 310u64;

pub fn panelScriptEnd(join bool) u64 { PANEL_FROM + (if join { PANEL_JOIN_FRAMES } else { PANEL_FRAMES }) }

// The view saved at frame 'f' by the simulation's script, or an empty name
pub fn panelShotAt(opts &RunOptions, f u64) &str {
  if !opts.panelOnly || opts.panelJoin != 0u32 || f < PANEL_FROM || f >= panelScriptEnd(false) { return ""; }
  let k = f - PANEL_FROM;
  if k == 8u64 { return "panel-hint"; }
  if k == 20u64 { return "panel-open"; }
  if k == 50u64 { return "panel-typed"; }
  if k == 100u64 { return "panel-answer"; }
  if k == 112u64 { return "panel-closed"; }
  ""
}

// The view saved at frame 'f' by the view itself (--panel-join: on the real clock the simulation's script has frames with no step
// in them, which would lose its shots), or an empty name
pub fn panelJoinShotAt(opts &RunOptions, f u64) &str {
  if opts.panelJoin == 0u32 || f < PANEL_FROM { return ""; }
  let k = f - PANEL_FROM;
  if k == 8u64 { return "panel-hint"; }
  if k == 20u64 { return "panel-open"; }
  if k == 50u64 { return "panel-typed"; }
  if k == 100u64 { return "panel-answer"; }
  if k == PANEL_JOIN_SHOT_A { return "panel-joining"; }
  if k == PANEL_JOIN_SHOT_B { return "panel-join-result"; }
  ""
}

// A text-input event of the script's: the text is a copy made for it (SDL's queue holds the pointer)
fn pushText(s &str) {
  let b &Array[u8] = s;
  let p = libc.malloc(b.len + 1usize) as *u8;
  var i = 0usize;
  while i < b.len {
    *(p + i) = b[i];
    i = i + 1usize;
  }
  *(p + b.len) = 0u8;
  var e = sdl.Event.empty();
  e.type = sdl.EVENT_TEXT_INPUT;
  let t = &mut e as &mut sdl.TextInputEvent;
  t.windowID = SCRIPT_DEVICE;
  t.text = p;
  e.timestamp = 0u64;
  sdl.PushEvent(&mut e);
}

// A click's press or release on a control of the panel, for a window of 'view' units and 'pixels' pixels at 'scale' pixels a logical unit
fn pushPanelButton(which u32, down bool, view Vec2, pixels Vec2, scale f32) {
  let at = panelTarget(which, pixels.x / scale, pixels.y / scale);
  pushButton(at.x * scale * view.x / pixels.x, at.y * scale * view.y / pixels.y, down);
}

// The panel run's events for frame 'f', pushed by the shell at the start of the frame (so that this frame's input has them)
pub fn panelPush(f u64, view Vec2, pixels Vec2, scale f32, join bool) {
  if f < PANEL_FROM || f >= panelScriptEnd(join) { return; }
  let k = f - PANEL_FROM;
  if k == 0u64 { pushKey(SCANCODE_U, true); }
  if k == 1u64 { pushKey(SCANCODE_U, false); }
  if k == 10u64 { pushKey(SCANCODE_F9, true); }
  if k == 11u64 { pushKey(SCANCODE_F9, false); }
  if k == 22u64 { pushPanelButton(T_NAME_FIELD, true, view, pixels, scale); }
  if k == 23u64 { pushPanelButton(T_NAME_FIELD, false, view, pixels, scale); }
  if k >= 26u64 && k < 34u64 {
    pushKey(42u, true);
    pushKey(42u, false);
  }
  if k == 36u64 { pushText("zz-test"); }
  if k == 40u64 { pushPanelButton(T_MESSAGE_FIELD, true, view, pixels, scale); }
  if k == 41u64 { pushPanelButton(T_MESSAGE_FIELD, false, view, pixels, scale); }
  if k == 44u64 { pushText("hello from the check"); }
  if k == 54u64 { pushPanelButton(T_ASK_BUTTON, true, view, pixels, scale); }
  if k == 55u64 { pushPanelButton(T_ASK_BUTTON, false, view, pixels, scale); }
  // W held while the panel is up must not walk the player; held after it has closed, it must
  if k == 60u64 { pushKey(sdl.SCANCODE_W, true); }
  if k == 90u64 { pushKey(sdl.SCANCODE_W, false); }
  if join {
    // The button reads Join now (the stub approved): clicked, and the panel left to show how the dial ends
    if k == PANEL_JOIN_CLICK { pushPanelButton(T_ASK_BUTTON, true, view, pixels, scale); }
    if k == PANEL_JOIN_CLICK + 1u64 { pushPanelButton(T_ASK_BUTTON, false, view, pixels, scale); }
    return;
  }
  if k == 104u64 { pushKey(SCANCODE_F9, true); }
  if k == 105u64 { pushKey(SCANCODE_F9, false); }
  if k == 108u64 { pushKey(sdl.SCANCODE_W, true); }
  if k == 118u64 { pushKey(sdl.SCANCODE_W, false); }
}

// Where the player was before W was held under the panel, after it, and at the end (after W held with the panel closed)
pub struct PanelWatch {
  before Vec3;
  under Vec3;
  after Vec3;

  pub fn make() PanelWatch { new PanelWatch(new Vec3(0., 0., 0.), new Vec3(0., 0., 0.), new Vec3(0., 0., 0.)) }

  // The shell's note of the player's place after frame 'f'
  pub fn note(self &mut, f u64, at Vec3) {
    if f == PANEL_FROM + 58u64 { before = at; }
    if f == PANEL_FROM + 92u64 { under = at; }
    if f == PANEL_FROM + PANEL_FRAMES - 1u64 { after = at; }
  }

  // Whether the keys went where they should, said in two lines
  pub fn verdict(self &, join bool) bool {
    let held = (under - before).length();
    let walked = (after - under).length();
    let okHeld = held < 0.001;
    let okWalk = walked > 0.05;
    print <- "Panel run: W held for 30 frames with the panel up moved the player "; print <- held; print <- " m: "; if okHeld { print <- "yes (none)\n"; } else { print <- "NO\n"; }
    // (the Join run does not close the panel and walk after it: it waits for the dial to end)
    if join { return okHeld; }
    print <- "Panel run: W held after it closed moved the player "; print <- walked; print <- " m: "; if okWalk { print <- "yes (the walk has its keys back)\n"; } else { print <- "NO\n"; }
    okHeld && okWalk
  }
}
