// Walking: a walker's body stands on the ground at eye height, walks forward
// and back along the way it faces, and turns left and right. It is a being's
// body (being.cone): it moves by the intents it is given, never by a device,
// and gives the controls package's Pose for its eyes. The keys below are the
// user's controller's bindings, read through the input package's actions.
//
//   W or Up      walk forward          Down         walk back
//   A or Left    turn left             D or Right   turn right
//   Shift        held, walk faster
//   S            sit down on the seat nearest, or stand up again
//   H            hail (wave, the EverQuest way: it also opens a labyrinth guard's dialogue when one is near)
//   PageUp/Down  look up / down (the view only); so does dragging with the right mouse button held
//
// It moves in the simulation's fixed steps, so a walk is the same at any
// frame rate, and the picture is drawn between the last two steps.

// SDL3's scancodes for the arrow keys (the sdl package binds the letters)
pub const SCANCODE_RIGHT = 79u;
pub const SCANCODE_LEFT = 80u;
pub const SCANCODE_DOWN = 81u;
pub const SCANCODE_UP = 82u;
pub const SCANCODE_V = 25u;
pub const SCANCODE_U = 24u;
pub const SCANCODE_TAB = 43u;
pub const SCANCODE_SPACE = 44u;
pub const SCANCODE_PAGEUP = 75u;
pub const SCANCODE_PAGEDOWN = 78u;

pub struct Walk {
  pub position: Vec3;          // the feet, on the ground (y = 0)
  pub yaw: f32;                // radians: 0 faces -z, positive turns left (about +y)
  pub eyeHeight: f32;          // metres above the feet
  pub speed: f32;              // metres a second, walking
  pub runFactor: f32;          // how many times faster with Shift
  pub turnRate: f32;           // radians a second

  // Standing at 'position' facing 'yaw': eyes 1.7 m up, walking 3 m/s
  // (4 times that, 12 m/s, with Shift), turning a quarter turn in 1.5 s
  pub fn make(position: Vec3, yaw: f32) Walk {
    new Walk(position, yaw, 1.7, 3., 4., 1.0471976)
  }

  // One step of 'dt' seconds: 'ahead' -1 (back) to 1 (forward), 'turn' -1
  // (right) to 1 (left)
  pub fn step(self: &mut, isl: &Island, ahead: f32, turn: f32, run: bool, dt: f32) {
    yaw = yaw + turn * turnRate * dt;
    var v = speed;
    if run { v = v * runFactor; }
    let forward = new Vec3(0. - sin(yaw), 0., 0. - cos(yaw));
    let to = position + forward * (ahead * v * dt);
    // Held by the island's wading limit (the shoreline), and on the ground it stands on
    position = islandConstrain(isl, position, to);
    position.y = groundHeight(isl, position.x, position.z);
  }

  // Where the eyes are and which way they look: level, along the yaw
  pub fn pose(self: &) Pose {
    Pose.look(position + new Vec3(0., eyeHeight, 0.), yaw, 0.)
  }
}

// The actions walking reads
pub struct WalkActions {
  pub move: Action;            // one axis: forward 1, back -1
  pub turn: Action;            // one axis: left 1, right -1
  pub run: Action;             // a button
  pub jump: Action;            // a button (Space): a mannequin jumps
  pub view: Action;            // a button (V): first or third person
  pub swap: Action;            // a button (Tab): possess the next mannequin
  pub look: Action;            // one axis: PageUp looks up 1, PageDown down -1
  pub drag: Action;            // two axes: the pointer's movement while the right button is held (down is +y)
  pub sit: Action;             // a button (S): sit down on the nearest seat, or stand up from it
  pub hail: Action;            // a button (H): hail, the EverQuest way

  pub fn bind(ctx: &mut Context) WalkActions {
    let move = ctx.action("walk.move", AXIS1);
    ctx.bind(move, Binding.keyAxis(sdl.SCANCODE_W, 1., 0.));
    ctx.bind(move, Binding.keyAxis(SCANCODE_UP, 1., 0.));
    ctx.bind(move, Binding.keyAxis(SCANCODE_DOWN, -1., 0.));
    let turn = ctx.action("walk.turn", AXIS1);
    ctx.bind(turn, Binding.keyAxis(sdl.SCANCODE_A, 1., 0.));
    ctx.bind(turn, Binding.keyAxis(SCANCODE_LEFT, 1., 0.));
    ctx.bind(turn, Binding.keyAxis(sdl.SCANCODE_D, -1., 0.));
    ctx.bind(turn, Binding.keyAxis(SCANCODE_RIGHT, -1., 0.));
    let run = ctx.action("walk.run", BUTTON);
    ctx.bind(run, Binding.key(sdl.SCANCODE_LSHIFT));
    let jump = ctx.action("walk.jump", BUTTON);
    ctx.bind(jump, Binding.key(SCANCODE_SPACE));
    let view = ctx.action("view.toggle", BUTTON);
    ctx.bind(view, Binding.key(SCANCODE_V));
    let swap = ctx.action("view.swap", BUTTON);
    ctx.bind(swap, Binding.key(SCANCODE_TAB));
    let look = ctx.action("view.look", AXIS1);
    ctx.bind(look, Binding.keyAxis(SCANCODE_PAGEUP, 1., 0.));
    ctx.bind(look, Binding.keyAxis(SCANCODE_PAGEDOWN, -1., 0.));
    let drag = ctx.action("view.drag", AXIS2);
    ctx.bind(drag, Binding.pointerDelta(1.).whileHeld(sdl.BUTTON_MASK_RIGHT));
    let sit = ctx.action("walk.sit", BUTTON);
    ctx.bind(sit, Binding.key(sdl.SCANCODE_S));
    let hail = ctx.action("walk.hail", BUTTON);
    ctx.bind(hail, Binding.key(SCANCODE_H));
    new WalkActions(move, turn, run, jump, view, swap, look, drag, sit, hail)
  }
}

fn clampUnit(x: f32) f32 {
  if x > 1. { return 1.; }
  if x < -1. { return -1.; }
  x
}
