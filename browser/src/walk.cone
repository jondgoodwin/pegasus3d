// Walking: the viewer stands on the ground at eye height, walks forward and
// back along the way it faces, and turns left and right. It reads the input
// package's actions, never a device, and gives the controls package's Pose,
// as the orbit and fly cameras do, so the camera it moves could later be a
// part's eyes instead.
//
//   W or Up      walk forward          S or Down    walk back
//   A or Left    turn left             D or Right   turn right
//   Shift        held, walk faster
//
// It moves in the simulation's fixed steps, so a walk is the same at any
// frame rate, and the picture is drawn between the last two steps.

// SDL3's scancodes for the arrow keys (the sdl package binds the letters)
pub const SCANCODE_RIGHT = 79u;
pub const SCANCODE_LEFT = 80u;
pub const SCANCODE_DOWN = 81u;
pub const SCANCODE_UP = 82u;

pub struct Walk {
  pub position Vec3;          // the feet, on the ground (y = 0)
  pub yaw f32;                // radians: 0 faces -z, positive turns left (about +y)
  pub eyeHeight f32;          // metres above the feet
  pub speed f32;              // metres a second, walking
  pub runFactor f32;          // how many times faster with Shift
  pub turnRate f32;           // radians a second

  // Standing at 'position' facing 'yaw': eyes 1.7 m up, walking 3 m/s
  // (4 times that, 12 m/s, with Shift), turning a quarter turn in 1.5 s
  pub fn make(position Vec3, yaw f32) Walk {
    new Walk(position, yaw, 1.7, 3., 4., 1.0471976);
  }

  // One step of 'dt' seconds: 'ahead' -1 (back) to 1 (forward), 'turn' -1
  // (right) to 1 (left)
  pub fn step(self &mut, ahead f32, turn f32, run Bool, dt f32) {
    yaw = yaw + turn * turnRate * dt;
    mut v = speed;
    if run { v = v * runFactor; }
    imm forward = new Vec3(0. - sin(yaw), 0., 0. - cos(yaw));
    position = position + forward * (ahead * v * dt);
  }

  // Where the eyes are and which way they look: level, along the yaw
  pub fn pose(self &) Pose {
    Pose.look(position + new Vec3(0., eyeHeight, 0.), yaw, 0.);
  }
}

// The pose 't' of the way from 'a' to 'b' (0 <= t <= 1)
pub fn between(a &Walk, b &Walk, t f32) Pose {
  imm p = a.position + (b.position - a.position) * t;
  imm yaw = a.yaw + (b.yaw - a.yaw) * t;
  Pose.look(p + new Vec3(0., a.eyeHeight, 0.), yaw, 0.);
}

// The actions walking reads
pub struct WalkActions {
  pub move Action;            // one axis: forward 1, back -1
  pub turn Action;            // one axis: left 1, right -1
  pub run Action;             // a button

  pub fn bind(ctx &mut Context) WalkActions {
    imm move = ctx.action("walk.move", AXIS1);
    ctx.bind(move, Binding.keyAxis(sdl.SCANCODE_W, 1., 0.));
    ctx.bind(move, Binding.keyAxis(SCANCODE_UP, 1., 0.));
    ctx.bind(move, Binding.keyAxis(sdl.SCANCODE_S, -1., 0.));
    ctx.bind(move, Binding.keyAxis(SCANCODE_DOWN, -1., 0.));
    imm turn = ctx.action("walk.turn", AXIS1);
    ctx.bind(turn, Binding.keyAxis(sdl.SCANCODE_A, 1., 0.));
    ctx.bind(turn, Binding.keyAxis(SCANCODE_LEFT, 1., 0.));
    ctx.bind(turn, Binding.keyAxis(sdl.SCANCODE_D, -1., 0.));
    ctx.bind(turn, Binding.keyAxis(SCANCODE_RIGHT, -1., 0.));
    imm run = ctx.action("walk.run", BUTTON);
    ctx.bind(run, Binding.key(sdl.SCANCODE_LSHIFT));
    new WalkActions(move, turn, run);
  }
}

fn clampUnit(x f32) f32 {
  if x > 1. { return 1.; }
  if x < -1. { return -1.; }
  x;
}

// One step of 'walk' by this frame's actions
pub fn walkStep(walk &mut Walk, actions &WalkActions, ctx &Context, dt f32) {
  imm ahead = clampUnit(ctx.axis1(actions.move));
  imm turn = clampUnit(ctx.axis1(actions.turn));
  walk.step(ahead, turn, ctx.down(actions.run), dt);
}
