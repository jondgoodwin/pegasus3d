// The HUD's part of the scripted run (hud.cone), after the ragdoll's (frame HUD_FROM): the HUD is off in a
// scripted run until the script turns it on, so that no other view changes. The keys are pushed into SDL's own
// queue, as the rest of the run's are.
//
//   frames +2..+4   H: the HUD shown                                   shot "hud-start" at +10
//   frames +16, +24 F1 and F3: two hotbar slots begin their cooldown   shot "hud-hotbar" at +34
//   frame +60       F2                                                 shot "hud-late" at +68
//   frames +70..+72 H: the HUD hidden again                            shot "hud-hidden" at +76
//
// 'browser.exe --hud-only' runs just this part (frames 100 on), for looking at the HUD without the whole run.

pub const HUD_FRAMES = 90u64;

// Whether this is the HUD-only run, and the first frame of the HUD's part
mut hudOnly bool = false;

pub fn hudFrom() u64 {
  if hudOnly { 100u64; } else { FALL_FROM + FALL_FRAMES; };
}

pub fn hudScriptEnd() u64 { hudFrom() + HUD_FRAMES; }

// The HUD's key events for frame 'f'
pub fn hudPush(f u64) {
  if f < hudFrom() or f >= hudScriptEnd() { return; }
  imm k = f - hudFrom();
  if k == 2u64 or k == 70u64 { pushKey(SCANCODE_H, true); }
  if k == 4u64 or k == 72u64 { pushKey(SCANCODE_H, false); }
  if k == 16u64 { pushKey(SCANCODE_F1, true); }
  if k == 18u64 { pushKey(SCANCODE_F1, false); }
  if k == 24u64 { pushKey(SCANCODE_F1 + 2u, true); }
  if k == 26u64 { pushKey(SCANCODE_F1 + 2u, false); }
  if k == 60u64 { pushKey(SCANCODE_F1 + 1u, true); }
  if k == 62u64 { pushKey(SCANCODE_F1 + 1u, false); }
}

// The view saved at frame 'f', or an empty name
pub fn hudShotAt(f u64) &str {
  if f < hudFrom() or f >= hudScriptEnd() { return ""; }
  imm k = f - hudFrom();
  if k == 10u64 { return "hud-start"; }
  if k == 34u64 { return "hud-hotbar"; }
  if k == 68u64 { return "hud-late"; }
  if k == 76u64 { return "hud-hidden"; }
  "";
}
