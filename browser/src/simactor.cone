// The simulation actor: the truth of the scene, run on the actors package's
// workers. It owns the scene's registry and the tables the simulation needs
// (the placement tree for platforms and areas, listeners, areas, platforms,
// timers and the scene's clock: parts/), the beings and their bodies (the cast
// and possession, being.cone; the mannequins' kinematic capsules,
// mannequin.cone: the physics), the solids and platforms they stand on
// (support.cone), and the world actor and its Door. It holds nothing to draw
// with: no mesh, material, picking table or GPU handle, and no snapshot for
// render. That is the view's (viewactor.cone).
//
// THE SERVER OWNS THE TRUTH. This half is the one that runs on a server
// (--serve): headless, with no window and no GPU, ticking at its own fixed
// rate, taking each client's inputs and sending each client the world's
// requests and its snapshots. In single player it runs in the same process as
// the one view, joined to it by netmsg's in-process connection, with the same
// messages and the same code; the view and it then take turns each frame
// (lockstep) so that a frame is the same every time, which a scripted run's
// exact checks need.
//
// The halves meet only over the connections (netlink.cone), through what
// simview.cone defines and netcodec.cone writes as bytes. The content every
// browser has locally (the island, the baked-in world, the mannequins) is not
// sent: the Object request that names it is (parts.cone); and the beings' gait,
// the camera and the birds are the view's own, from the state.
//
// CLIENTS. Each client that joins is told what has been sent so far (the
// replay log, replaylog.cone), given a being to drive (single player: the
// mannequin it starts as; connected: a mannequin of its own, set down on the
// landing beach), and sent a snapshot of the beings every tick it is due. Its
// inputs arrive as the last INPUT_KEPT ticks of intents with sequence
// numbers, so a lost packet loses nothing. The server applies them in order,
// one a tick: if the next has not come, the being waits for it (a being never
// guesses what its user did), and a backlog is run off two at a time.
//
// ITS FRAME. Single player: the view's Frame message, which follows its inputs on
// the connection (so they have all arrived), and which this half answers, when its
// work is done, with a FrameDone said last (so everything before it has arrived).
// A server: serveTick, from the server's loop, on its own clock. The same work:
//
//   the frame
//        for each fixed step, the intents of the input sequence
//        number due for each client's being, which move it; every being
//        stepped, the birds (single player and scripted only: the harness
//        reads them), the scene's clock (SIMULATE); then the clock's keys, hard
//        landings, the clicks (the listener told), timers and areas posted to
//        the world's mail; the WORLD'S TURN, awaited; THE APPLY POINT: the inbox
//        applied, the requests the clients need kept, in order; the bodies on a
//        platform that moved carried with it (support.cone) (PUBLISH); then
//        what the clients are told: the accepted requests (reliable), a weather
//        change (reliable), and the tick's snapshot (latest-wins)
//   endFrame(facts)
//        once the view has drawn the frame: in a scripted run, the script's
//        checks and its next events, from what the view saw (the picks, what
//        render drew); the shell's report is made from the answer
//   finishScene, verdict
//        the end of the run: the scene's and the world's lines, then the
//        script's verdict and the exit code
//
// The scripted run (script.cone and its sister files) is a test fixture that
// reads and moves the truth directly, so it runs here, beside it; what the
// view saw it is told in endFrame. It also reads the camera and the birds, so
// in single player and scripted runs this half steps its own copies of them
// (the view draws its own).

// What the simulation tells the shell's frame report once a frame is done
pub struct EndFrame {
  pub you Walk;               // the possessed being's body
  pub waiting usize;          // requests waiting after the script's drive
  pub parts usize;            // parts the scene has
  pub worldDone bool;         // every object of the world sent
  pub worldSentFrame u64;     // the frame that sent its last; 0 before
}

// What the view hands back once the frame is drawn: what it saw, for the
// scripted run's checks (and the frame's number)
pub struct ViewFacts {
  pub frame u64;
  pub rendered RenderFacts;   // what render drew
  pub picked PartId;          // the part highlighted: the last click's
  pub lastPick PickHit;       // the last click's answer
  pub clicks u64;
  pub view Vec2;              // the window in its own units, as the shell last said
  pub shotFailed bool;
  pub late bool;              // a frame's state did not arrive with the simulation's answer
}

// What a server's tick is handed: its number and the fixed steps due
pub struct Advance {
  pub frame u64;
  pub steps List[Step];
  pub expectReliable u64;
  pub expectSeq u64;
}

// How many input samples may wait for a being before the server runs two a tick
const BACKLOG = 4usize;

// Players' names: how long, how many at once, how long a connection may stay nameless (10 s of ticks), and how long after
// a refusal the connection is ended (half a second: the refusal has to reach the client first)
const MAX_NAME = 24usize;
const MAX_PLAYERS = 8usize;
const NAME_WAIT_TICKS = 600u64;
const HANGUP_TICKS = 30u64;

// A server's connection that has not said its name yet, and since when (the tick)
struct Pending {
  id u32;
  since u64;
}

// A refused connection, and the tick at which it is ended
struct HangUp {
  id u32;
  at u64;
}

// Whether a name is made only of ASCII letters, digits, spaces and . _ - and has something in it besides spaces
fn nameIsPlain(name &str) bool {
  let b &Array[u8] = name;
  var visible = false;
  var i = 0usize;
  while i < b.len {
    let c = b[i];
    let letter = (c >= 65u8 and c <= 90u8) or (c >= 97u8 and c <= 122u8);
    let digit = c >= 48u8 and c <= 57u8;
    if !(letter or digit or c == 32u8 or c == 46u8 or c == 95u8 or c == 45u8) { return false; }
    if c != 32u8 { visible = true; }
    i = i + 1usize;
  }
  visible
}

fn lowerAscii(c u8) u8 { if c >= 65u8 and c <= 90u8 { c + 32u8 } else { c } }

// Two names the same, ignoring case ("Jon" and "jon" are one player)
fn namesMatch(a &str, b &str) bool {
  let x &Array[u8] = a;
  let y &Array[u8] = b;
  if x.len != y.len { return false; }
  var i = 0usize;
  while i < x.len {
    if lowerAscii(x[i]) != lowerAscii(y[i]) { return false; }
    i = i + 1usize;
  }
  true
}

// A connected client, as the simulation keeps it
pub struct Client {
  pub id u32;                 // the connection's: a server numbers its clients from 1
  pub being usize;            // the being it drives (its index in the cast)
  queue List[InputSample];    // input samples received, not yet applied
  pub nextSeq u64;            // the input sequence number due next
  pub applied u64;            // the last input sequence number applied
  pub cur Intents;            // what its last step used
  pub curLook f32;            // and the pitch keys held then
  pub missed u64;             // steps with no input sequence number due (single player used the last intents)
  pub skipped u64;            // steps a being waited for its input
  pub extra u64;              // steps run off a backlog
  pub told usize;             // the being it was last told is its own
  pub name String;            // the name it plays under (a server's clients; empty in single player)

  pub fn make(id u32, being usize) Client {
    new Client(id, being, List[InputSample].empty(), 1u64, 0u64, Intents.none(), 0., 0u64, 0u64, 0u64, being, String.empty())
  }

  // Samples received, kept if newer than any before
  pub fn receive(self &mut, samples &List[InputSample]) {
    var k = 0usize;
    while k < samples.len() {
      let s = *samples[k];
      if s.seq >= nextSeq and (queue.len() == 0usize or s.seq > queue[queue.len() - 1usize].seq) { queue.push(s); }
      k = k + 1usize;
    }
  }

  // The number of samples waiting
  pub fn waiting(self &) usize { queue.len() }

  fn dropFront(self &mut) {
    var keep = List[InputSample].empty();
    var q = 1usize;
    while q < queue.len() { keep.push(*queue[q]); q = q + 1usize; }
    queue <=> keep;
  }

  // The intents of the next input sequence number due, into 'cur'. If it did not come: single player ('repeat') goes
  // on with the last intents, as a being does that is not told otherwise; a server's being does not step (false)
  pub fn take(self &mut, repeat bool) bool {
    while queue.len() > 0usize and queue[0usize].seq < nextSeq { self.dropFront(); }
    if queue.len() > 0usize and queue[0usize].seq > nextSeq and !repeat {
      // Lost beyond what the redundancy covers: on from what came
      missed = missed + (queue[0usize].seq - nextSeq);
      nextSeq = queue[0usize].seq;
    }
    if queue.len() > 0usize and queue[0usize].seq == nextSeq {
      let s = *queue[0usize];
      self.dropFront();
      nextSeq = nextSeq + 1u64;
      applied = s.seq;
      cur = s.intents;
      curLook = s.lookKeys;
      return true;
    }
    if repeat {
      missed = missed + 1u64;
      nextSeq = nextSeq + 1u64;
      return true;
    }
    skipped = skipped + 1u64;
    false
  }
}

// The simulation actor's state: a struct of its own, so that the scripted
// run's functions (script.cone and its sister files) can be handed it
pub struct SimState {
  pub scene Scene;
  pub cast Cast;              // the beings, and which one the user possesses (single player)
  pub birds Birds;            // the flock, stepped on scene time (single player and scripted: the harness reads it)
  pub picks PickSystem;       // a scripted run's only: each shown part's mesh bounds, for its checks
  pub picked PartId;          // told by the view: the part highlighted, the last click's
  pub lastPick PickHit;       // and the last click's answer, for the script
  pub clicks u64;
  pub fired u64;              // Fire requests applied: an effect's bursts
  pub sceneNow f64;           // the scene's time, seconds, at this frame's publish
  pub hardLandingsMailed u64; // hard landings posted to the world's mail
  pub view Vec2;              // the window in its own units, as the view last said
  pub scripted bool;
  pub scriptOk bool;
  pub world WorldFacts;       // a scripted run's: the world as its last turn left it
  pub rendered RenderFacts;   // a scripted run's: what render last drew
  pub worldDone bool;
  pub worldSentFrame u64;     // the frame whose world turn sent the last object
  pub net NetSide;            // the connections
  pub serve bool;             // a server: no view in this process, clients of its own
  pub lockstep bool;          // single player: the view waits for each frame's answer, and this half for the view's messages
  pub clients List[Client];
  pub missedInput u64;        // steps with no input sequence number due (the last intents were used), all clients
  forView List[Request];      // the requests the clients need, in the order applied
  moves List[PlatformMove];   // how the platforms moved this frame
  platformsNow List[PlatformNow];   // and where they stand now
  pub stepSeconds f32;        // the frame's steps, seconds (the walk's, not scene time)
  looks List[f32];            // pitch changes from the view, not yet applied
  commands List[u32];         // keys from the view, not yet applied
  clicksIn List[PartId];      // clicks from the clients, not yet applied
  pub appliedInput u64;       // the last input sequence number applied (the first client's)
  pub weather Weathering;     // the weather, a closed form of scene time (weather.cone)
  weatherSent Weathering;     // and as the clients were last told
  inObject bool;              // between an ObjectBegin and its Object: the view builds that content itself
  pub tick u64;               // fixed steps taken, ever
  pub log ReplayLog;          // what a client that joins later is told
  given List[Intents];        // each being's intents this step
  stepIt List[bool];          // and whether it steps
  gotReliable u64;            // reliable messages received (single player's one client)
  gotSeq u64;                 // the highest input sequence number received
  pub skippedRequests u64;    // requests of a kind that does not cross, not sent
  clientBeings u32;           // beings made for clients
  lastPublish u64;            // the tick of the last snapshot sent (a server sends them at its own rate)
  pub snapshotsSent u64;
  pub stateBytes u64;
  pub notices u64;            // refusals and surprises heard
  frameAsked bool;            // single player: the view asked for a frame
  frameNo u64;
  frameSteps List[Step];
  joinedNow bool;             // a client joined since the shell was last told
  pub simulateNs u64;         // the last frame's phases
  pub publishNs u64;
  pub village Village;        // the navigation mesh and the villagers' minds (npcs.cone)
  pub route Route;            // the scripted run's: the route being walked (assembly.cone)
  pub rideFrameMs List[f32];  // the scripted run's: the time between the ride's frames, ms (ridescript.cone)
  pub asm Assembly;           // the scripted run's: the assembly's phase, keys and pictures (assembly.cone)
  pub ride Ride;              // the scripted run's: the balloon ride's measurements (ridescript.cone)
  pub run ScriptRun;          // the scripted run's: the first walk's clicks, test cube and clock checks (script.cone)
  pub fall FallRun;           // the scripted run's: the ragdoll's fall (physscript.cone)
  pub npcRunOk bool;          // the scripted run's: the villagers' part has held (npcscript.cone)
  pub wxOk bool;              // the scripted run's: the weather's part has held (weatherscript.cone)
  pub fenceRunOk bool;        // the scripted run's: the roaming views' eyes are on walkable ground (fencescript.cone)
  pub play PlaySim;           // the playground's: the spells in force, the actions received and the bursts to tell (spellsim.cone)
  pending List[Pending];      // a server's connections that have not yet said their name
  hangUps List[HangUp];       // connections refused, to be ended once the refusal has been sent
  pub land Island;  // the baked island, shared by every actor (read it with &land)
  pub opts RunOptions;        // what the arguments say that this actor acts on (--no-npcs, --trace, --hud-only, --audio-walk)
  pub portal PortalSim;       // the looking-glass, the puppet, Ariadne's threads (portalsim.cone)
  pub portalRunOk bool;       // the scripted run's: the portal's part has held (portalscript.cone)
  pub creatures CreatureSim;  // the labyrinth's guards, Worm and Minotaur (creatures.cone)
  pub gallery GalleryPlan;    // a gallery run's shots (gallery.cone)
  pub people People;          // humanbody's people, shared with the views (personasset.cone)

  pub fn make(opts RunOptions, birds Birds, serve bool, land Island) SimState {
    let scripted = opts.scripted;
    new SimState(Scene.empty(), Cast.empty(land.share()), birds, PickSystem.empty(), PartId.none(),
      new PickHit(PartId.none(), 0., 0u32, 0u64), 0u64, 0u64, 0.0, 0u64, new Vec2(HEADLESS_W, HEADLESS_H), scripted,
      true, WorldFacts.empty(), RenderFacts.empty(), false, 0u64, NetSide.make(), serve, !serve, List[Client].empty(), 0u64,
      List[Request].empty(), List[PlatformMove].empty(), List[PlatformNow].empty(), 0., List[f32].empty(), List[u32].empty(), List[PartId].empty(),
      0u64, Weathering.fair(), Weathering.fair(), false, 0u64, ReplayLog.empty(), List[Intents].empty(), List[bool].empty(),
      0u64, 0u64, 0u64, 0u32, 0u64, 0u64, 0u64, 0u64, false, 0u64, List[Step].empty(), false, 0u64, 0u64, Village.empty(),
      Route.make(), List[f32].empty(), Assembly.make(), Ride.make(), ScriptRun.make(), FallRun.make(), true, true, true, PlaySim.empty(),
      List[Pending].empty(), List[HangUp].empty(), land, opts, PortalSim.make(), true, CreatureSim.make(), GalleryPlan.none(), People.empty())
  }

  // The possessed being's body: where the user is (single player)
  pub fn youBody(self &) Walk { cast.beings[cast.possessed].body }

  // The first client's connection number (the scripted run acts as it), or 0
  pub fn firstClient(self &) u32 { if clients.len() > 0usize { clients[0usize].id } else { 0u32 } }

  // Whether this half keeps the camera and the birds for the scripted harness: single player and scripted runs
  fn legacy(self &) bool { !serve }

  // A person of humanbody's cast (the cast's number 'person': PERSON_..., personview.cone) made, shown and added to the cast
  // standing at 'at' facing 'yaw': the index of its being
  fn addMannequin(self &mut, name &str, at Vec3, yaw f32, person usize, seed u32) usize {
    self.addNamedMannequin(name, "", at, yaw, person, seed)
  }

  // The same, for a player: 'player' is the name shown above it ("" for every other person)
  fn addNamedMannequin(self &mut, name &str, player &str, at Vec3, yaw f32, person usize, seed u32) usize {
    let everyone = people.share();
    if !everyone.has() {
      // (no people: a run that has none, the checks' scenes, gets the wooden mannequin)
      let height = 1.75f;
      scene.door.beginObject();
      let root = scene.newPart(name);
      let parts = spawnMannequin(&mut scene.door, height, woodColor(), root);
      let spec = new ObjectSpec(OBJ_MANNEQUIN, u32.from(cast.beings.len()), height, woodColor(), String.from(name));
      scene.door.endObject(spec);
      let index = cast.add(Being.mannequin(root, at, yaw, Figure.make(height, seed, parts)));
      scene.send(Request.BeingAdded(u32.from(index), root, false, height, seed, String.from(player), NO_PERSON));
      return index;
    }
    let asset = everyone.at(person % everyone.count());
    scene.door.beginObject();
    let root = scene.newPart(name);
    let spawned = spawnPerson(&mut scene.door, asset, root);
    let spec = new ObjectSpec(OBJ_PERSON, asset.index, asset.height, new Color(1., 1., 1., 1.), String.from(name));
    scene.door.endObject(spec);
    let index = cast.add(Being.mannequin(root, at, yaw, Figure.makePerson(asset, seed, copyParts(&spawned.extras))));
    scene.send(Request.BeingAdded(u32.from(index), root, false, asset.height, seed, String.from(player), asset.index));
    index
  }

  // A person for a client that joined: the k-th, set down on the landing beach as one of the cast (the first the main avatar in
  // his cape, then the others in turn), and the name it plays under
  fn addClientMannequin(self &mut, k u32, player &str) usize {
    let cast6 Array[usize, 6] = [PERSON_AVATAR, PERSON_TALL_SLIM_MAN, PERSON_TALL_ATHLETE, PERSON_STOCKY_MAN, PERSON_PETITE_WOMAN,
      PERSON_AVERAGE_MAN];
    let which = cast6[usize.from(k % 6u32)];
    let x = BEACH_X + f32.from(i32.from(k % 4u32) - 1i32) * 1.5;
    let z = BEACH_Z - 1.5 * f32.from(k / 4u32);
    // (--lab-spawn: in the labyrinth's antechamber instead, a step in from E, facing +z: the net check's labyrinth run)
    if opts.labSpawn {
      let lx = LAB_E_X + f32.from(i32.from(k % 4u32) - 1i32) * 1.5;
      let lz = LAB_E_Z + 1.5 + 1.5 * f32.from(k / 4u32);
      return self.addNamedMannequin(clientName(k), player, new Vec3(lx, LAB_Y, lz), 3.1415927, which, 3u32 + 8u32 * k);
    }
    self.addNamedMannequin(clientName(k), player, standing(&land, x, z), 0., which, 3u32 + 8u32 * k)
  }

  // The scene before the first frame: the shell's land, sea and sky, and the
  // beings (a scripted run's plain walker and its mannequins, or the user's
  // mannequin and another; a server: the idle mannequin alone)
  fn seed(self &mut) {
    scene.door.beginObject();
    seedScene(&land, &mut scene.door);
    scene.door.endObject(ObjectSpec.of(OBJ_SHELL, 0u32));
    // What a body cannot walk through (trunks, rocks, the cottage), and the porch's deck and steps it can stand on
    let solids = allSolids(&land);
    cast.phys.ensureGround();
    cast.phys.setSolids(&solids);
    // The playground's pins and ball, asleep at home
    propsEnsure(&mut cast.phys, &mut cast.props);
    // (a scripted run opens the glass at its portal part: the mirror's part stands still before it, and must not open it)
    // (and its glass stays open once opened, so that the portal script's shots hold; the closing is tried by --checks and a script part of its own)
    if scripted { portal.auto = false; portal.closes = false; }
    if scripted {
      // The scripted run starts as the plain walker on the landing beach,
      // facing -z up the path's first stretch; its walk is checked there, then
      // it is set down at the old flat world's start (START_X, START_Z) and
      // keeps its exact walk checks from there. It takes the mannequin over by
      // pressing Tab at its end. The mannequins stand off to the right of that start.
      let youPart = scene.newPart("you");
      let youAt = cast.add(Being.make(youPart, Walk.make(new Vec3(BEACH_X, islandHeight(&land, BEACH_X, BEACH_Z),
        BEACH_Z), 0.)));
      scene.send(Request.BeingAdded(u32.from(youAt), youPart, true, 0., 0u32, String.empty(), NO_PERSON));
      cast.possess(youAt);
      self.addMannequin("mannequin", standing(&land, START_X + 5., START_Z), 0., PERSON_AVATAR, 3u32);
      self.addMannequin("second mannequin", standing(&land, START_X + 3.5, START_Z - 3.), 2.356, PERSON_AVERAGE_WOMAN, 11u32);
    } elif serve {
      // A server: the person that stands there for anyone to see; each client brings its own
      self.addMannequin("second mannequin", standing(&land, BEACH_X + 3., BEACH_Z - 4.), 2.356, PERSON_AVERAGE_WOMAN, 11u32);
    } else {
      // The user's own being: the main avatar on the landing beach, facing -z up
      // the path, possessed, seen from behind and above; another stands a few metres off
      let start = userStart(opts.audioWalk);    // the landing beach (the audio walk's own start: audiowalk.cone)
      let youAt = self.addMannequin("mannequin", standing(&land, start.x, start.y), 0., PERSON_AVATAR, 3u32);
      self.addMannequin("second mannequin", standing(&land, BEACH_X + 3., BEACH_Z - 4.), 2.356, PERSON_AVERAGE_WOMAN, 11u32);
      cast.possess(youAt);
    }
    village.keepSolids(&solids);
    // The villagers live here from the start, in every mode but a scripted run, whose pictures (and checks) of the rest
    // of the world they would otherwise stand in; it makes them at the start of its own part (npcscript.cone)
    if !scripted { self.seedVillage(); }
    // The labyrinth's creatures likewise: in a scripted run they are made at the start of their own part (creaturescript.cone)
    if (!scripted or opts.withCreatures) and opts.npcsEnabled { self.seedCreatures(); }
    cast.look(1. / 60.);
    print <- "Scene: "; print <- scene.partCount(); print <- " parts reserved, ";
    print <- scene.waiting(); print <- " requests waiting\n";
  }

  // A creature of the labyrinth: a mannequin with a look of its own (creaturelook.cone) made, shown, added to the cast, and its
  // name plate ('tag') given; the index of its being. It is the simulation's (an ai being), no target of the zap and the jig
  fn addCreatureBeing(self &mut, name &str, tag &str, look u32, at Vec3, yaw f32, height f32, seed u32, color Color) usize {
    let everyone = people.share();
    let guard = look == CL_GUARD_W or look == CL_GUARD_E;
    let which = if look == CL_GUARD_W { PERSON_GUARD_W } else { PERSON_GUARD_E };
    var index = 0usize;
    if guard and everyone.count() > which {
      // A guard is a person (the bare-chested man of humanbody's), in the guard's kit
      let asset = everyone.at(which);
      scene.door.beginObject();
      let root = scene.newPart(name);
      let spawned = spawnGuardPerson(&mut scene.door, look, asset, root);
      let spec = new ObjectSpec(OBJ_CREATURE, look, asset.height, color, String.from(name));
      scene.door.endObject(spec);
      index = cast.add(Being.mannequin(root, at, yaw, Figure.makePerson(asset, seed, copyParts(&spawned.extras))));
      scene.send(Request.BeingAdded(u32.from(index), root, false, asset.height, seed, String.from(tag), asset.index));
    } else {
      scene.door.beginObject();
      let root = scene.newPart(name);
      let extras = spawnCreature(&mut scene.door, look, height, color, root);
      let spec = new ObjectSpec(OBJ_CREATURE, look, height, color, String.from(name));
      scene.door.endObject(spec);
      index = cast.add(Being.mannequin(root, at, yaw, Figure.make(height, seed, List[PartId].empty())));
      scene.send(Request.BeingAdded(u32.from(index), root, false, height, seed, String.from(tag), NO_PERSON));
    }
    cast.beings[index].ai = true;
    cast.beings[index].creature = true;
    index
  }

  // The labyrinth's creatures made: the two guards on their plinths in the Hall of Two Doors, the Minotaur in the Bull Court before the
  // east door, and the lie/truth puzzle drawn (a fixed draw in a scripted run, else from the clock)
  pub fn seedCreatures(self &mut) {
    if creatures.on { return; }
    let guardSkin = new Color(0.2, 0.07, 0.035, 1.);
    let bullSkin = new Color(0.022, 0.012, 0.009, 1.);
    let gw = self.addCreatureBeing("guard west", "Guard", CL_GUARD_W, new Vec3(LAB_GUARD_LEFT_X, LAB_Y + 0.22, LAB_GUARD_Z), 0., 1.82, 71u32, guardSkin);
    let ge = self.addCreatureBeing("guard east", "Guard", CL_GUARD_E, new Vec3(LAB_GUARD_RIGHT_X, LAB_Y + 0.22, LAB_GUARD_Z), 0., 1.78, 73u32, guardSkin);
    let home = bullHome();
    let bull = self.addCreatureBeing("minotaur", "Minotaur", CL_MINOTAUR, home, 1.5707964, BULL_HEIGHT, 79u32, bullSkin);
    creatures.made(gw, ge, bull, if scripted { 128u32 } else { u32.from(sdl.GetPerformanceCounter() & 0xFFFFFFFFu64) });
    creatures.body.pos = new Vec2(home.x, home.z);
    creatures.lastPos = new Vec2(home.x, home.z);
    while given.len() < cast.beings.len() { given.push(Intents.none()); stepIt.push(true); }
    print <- "The creatures: guards "; print <- gw; print <- " and "; print <- ge; print <- ", the Minotaur "; print <- bull; print <- "; the "; print <- if creatures.liar == 0u32 { "west" } else { "east" };
    print <- " guard lies; their navigation mesh has "; print <- creatures.nav.polygons; print <- " polygons, built in "; print <- f64.from(creatures.nav.buildNs) / 1000000.0; print <- " ms\n";
  }

  // The beings the clients drive (and so what the creatures take as visitors)
  fn drivenBeings(self &) List[usize] {
    var driven = List[usize].empty();
    var c = 0usize;
    while c < clients.len() {
      driven.push(clients[c].being);
      c = c + 1usize;
    }
    driven
  }

  // A client's request to talk to guard 'g' with question 'q' (PLAY_TALK): answered, to every view, if the client's being is near the guard
  fn talkFor(self &mut, id u32, g u32, q u32) {
    let k = self.clientAt(id);
    if k == NO_ROW { return; }
    let who = clients[k].being;
    if who >= cast.beings.len() { return; }
    let line = creatures.talk(who, cast.beings[who].body.position, g, q);
    print <- "Talk: being "; print <- who; print <- " asked guard "; print <- g; print <- " question "; print <- q; print <- ": ";
    if line == 0u32 { print <- "not heard\n"; } else { printStr(guardSays(line).view()); print <- "\n"; }
  }

  // The net check's client (--creature-walk) asks for the next set-up of its walk through the creatures' places (creaturethink.cone)
  fn creatureTestFor(self &mut, id u32, stage u32) {
    let k = self.clientAt(id);
    if k == NO_ROW { return; }
    creatureStage(&mut creatures, &mut cast, clients[k].being, stage, tick);
    print <- "The creature test: client "; print <- id; print <- "'s being set up for stage "; print <- stage; print <- "\n";
  }

  // A villager: a mannequin made, shown, added to the cast and given to the village's minds
  fn addVillager(self &mut, npc Npc, person usize, seed u32, yaw f32) {
    let at = npc.body.pos;
    let index = self.addMannequin(npc.name.view(), standing(&land, at.x, at.y), yaw, person, seed);
    let b = &mut cast.beings[index];
    b.ai = true;
    var n = npc;
    n.being = index;
    village.npcs.push(n);
  }

  // The navigation mesh built from the island and the world's solids, and the villagers set down on it: one who walks
  // a round of the cottage, the bridge and the beach, one who idles in the garden, one who keeps its distance from the
  // player, one who keeps away from the player and goes home (npcs.cone). They are the simulation's, so every
  // mode has them: a server's, a user's, a script's (late)
  pub fn seedVillage(self &mut) {
    if !opts.npcsEnabled or village.npcs.len() > 0usize { return; }
    village.world = buildNavWorld(&land, &village.solids);
    let w = &village.world;
    print <- "Navigation: "; print <- w.polygons; print <- " polygons from "; print <- w.triangles; print <- " triangles and ";
    print <- w.obstacles; print <- " obstacles in "; print <- f64.from(w.buildNs) / 1000000.0; print <- " ms\n";
    var list = villagers();
    var v = 0usize;
    while v < list.len() {
      let one = &mut list[v];
      var npc Npc = Npc.shy(0usize, "", new Vec2(0., 0.), 1., 2.);
      npc <=> one.npc;
      self.addVillager(npc, one.person, one.seed, one.yaw);
      v = v + 1usize;
    }
  }

  // ---- the connections ----

  fn clientAt(self &, id u32) usize {
    var i = 0usize;
    while i < clients.len() {
      if clients[i].id == id { return i; }
      i = i + 1usize;
    }
    NO_ROW
  }

  // A client has joined: it is told what has been sent so far and which being is its own. Single player's one client
  // takes the being the user possesses; any other gets a mannequin made for it
  // A server's client is not given a being until it has said its name (ToSim.Hello): it waits in 'pending'.
  fn clientJoined(self &mut, id u32, conn Connection) {
    net.open(id, conn);
    if self.clientAt(id) != NO_ROW { return; }
    if serve {
      if self.pendingAt(id) == NO_ROW { pending.push(new Pending(id, tick)); }
      print <- "Connection "; print <- id; print <- " opened; waiting for its name\n";
      return;
    }
    self.admit(id, "");
  }

  // A client given its being (a server's: once its name has been accepted) and told the world so far
  fn admit(self &mut, id u32, name &str) {
    var being = cast.possessed;
    if serve or clients.len() > 0usize {
      being = self.addClientMannequin(clientBeings, name);
      clientBeings = clientBeings + 1u32;
    }
    var client = Client.make(id, being);
    client.name = String.from(name);
    clients.push(client);
    joinedNow = true;
    print <- "Client "; print <- id; print <- " joined: being "; print <- being;
    if name.len() > 0usize { print <- ", named "; printStr(name); }
    print <- "\n";
    self.sendLog(id);
    net.sendReliable(id, encodePossessed(u32.from(being)));
    net.sendReliable(id, encodeWeather(&weather));
    weatherSent = weather;
    // The looking-glass and the threads as they stand
    var told = List[PortalInfo].empty();
    portal.replay(&mut told);
    var ti = 0usize;
    while ti < told.len() {
      net.sendReliable(id, encodePortal(told[ti]));
      ti = ti + 1usize;
    }
    // The creatures: which beings they are, and the Worm if it is up
    var seen = List[CreatureInfo].empty();
    creatures.replay(&mut seen);
    ti = 0usize;
    while ti < seen.len() {
      net.sendReliable(id, encodeCreature(seen[ti]));
      ti = ti + 1usize;
    }
  }

  fn pendingAt(self &, id u32) usize {
    var i = 0usize;
    while i < pending.len() {
      if pending[i].id == id { return i; }
      i = i + 1usize;
    }
    NO_ROW
  }

  // What is wrong with a name offered, in words for the user; "" if nothing is
  fn nameProblem(self &, name &str) String {
    if name.len() == 0usize { return String.from("A name is needed."); }
    if name.len() > MAX_NAME { return String.from("That name is too long (24 letters at most)."); }
    if !nameIsPlain(name) { return String.from("A name may hold letters, digits, spaces and . _ - only."); }
    var i = 0usize;
    while i < clients.len() {
      if namesMatch(clients[i].name.view(), name) {
        return String.from("That name is already taken. Please choose another.");
      }
      i = i + 1usize;
    }
    if clients.len() >= MAX_PLAYERS { return String.from("The server is full."); }
    String.empty()
  }

  // A server's client says its name: given a being, or refused
  fn hello(self &mut, id u32, name &str, version u32) {
    if !serve or self.clientAt(id) != NO_ROW { return; }
    let k = self.pendingAt(id);
    if k == NO_ROW { return; }
    pending.swap(k, pending.len() - 1usize);
    pending.pop();
    var why = self.nameProblem(name);
    if version != PROTOCOL_VERSION { why = versionRefusal(version, PROTOCOL_VERSION); }
    if why.len() == 0usize {
      self.admit(id, name);
    } else {
      self.refuse(id, why.view());
    }
  }

  // A connection the server will not have: told why, and ended a little later (the message has to get there first)
  fn refuse(self &mut, id u32, why &str) {
    print <- "Connection "; print <- id; print <- " refused: "; printStr(why); print <- "\n";
    net.sendReliable(id, encodeRefused(why));
    hangUps.push(new HangUp(id, tick + HANGUP_TICKS));
  }

  // Once a tick: the refused connections whose message has had time to arrive are ended, and a connection that has not said
  // its name in time is refused
  fn tidyConnections(self &mut) {
    var i = 0usize;
    while i < hangUps.len() {
      if tick >= hangUps[i].at {
        net.hangUp(hangUps[i].id);
        hangUps.swap(i, hangUps.len() - 1usize);
        hangUps.pop();
      } else {
        i = i + 1usize;
      }
    }
    i = 0usize;
    while i < pending.len() {
      if tick - pending[i].since > NAME_WAIT_TICKS {
        let id = pending[i].id;
        pending.swap(i, pending.len() - 1usize);
        pending.pop();
        self.refuse(id, "No name was given (this server needs a client that sends one).");
      } else {
        i = i + 1usize;
      }
    }
  }

  // A client has gone: its being is taken out of the world
  fn clientLeft(self &mut, id u32) {
    let k = self.clientAt(id);
    if k == NO_ROW {
      let p = self.pendingAt(id);
      if p != NO_ROW {
        pending.swap(p, pending.len() - 1usize);
        pending.pop();
      }
      net.close(id);
      return;
    }
    let cb = clients[k].being;
    print <- "Client "; print <- id; print <- " left (being "; print <- cb; print <- ")\n";
    if net.has(id) {
      let p = net.peer(id);
      print <- "  sent it: "; print <- p.reliableSent; print <- " reliable messages, "; print <- p.reliableBytes; print <- " bytes; ";
      print <- p.latestSent; print <- " snapshots, "; print <- p.latestBytes; print <- " bytes\n";
    }
    net.close(id);
    let fb = cast.beings[cb];
    print <- "FINAL "; print <- cb; print <- " "; print <- millimetres(fb.body.position.x); print <- " "; print <- millimetres(fb.body.position.y);
    print <- " "; print <- millimetres(fb.body.position.z); print <- " applied "; print <- clients[k].applied; print <- " waited "; print <- clients[k].skipped;
    print <- " extra "; print <- clients[k].extra; print <- "\n";
    // The playground, for the net check: what was played, and where the ball lay as the client left (millimetres)
    {
      let ball = propPoseOf(&cast.phys, &cast.props, PROP_BALL).pos;
      print <- "PLAY "; print <- play.bowls; print <- " "; print <- play.paintShots; print <- " "; print <- play.paintOnSurfaces + play.paintOnBeings; print <- " ";
      print <- millimetres(ball.x); print <- " "; print <- millimetres(ball.y); print <- " "; print <- millimetres(ball.z); print <- "\n";
      // The portal, for the net check: whether the glass is open, the gates gone through, the points of every thread
      var points = 0usize;
      var th = 0usize;
      while th < portal.threads.len() { points = points + portal.threads[th].pts.len(); th = th + 1usize; }
      print <- "PORTAL "; print <- i64.from(portal.open); print <- " "; print <- portal.crossings; print <- " "; print <- points; print <- "\n";
      // The creatures, for the net check: answers given, charges, staggers, vaults, shoves, the Worm's risings and lines
      print <- "CREATURES "; print <- creatures.said; print <- " "; print <- creatures.charges; print <- " "; print <- creatures.hits; print <- " ";
      print <- creatures.leaps; print <- " "; print <- creatures.shoves; print <- " "; print <- creatures.wormRises; print <- " "; print <- creatures.wormTalks; print <- "\n";
    }
    if serve {
      let b = &mut cast.beings[cb];
      b.gone = true;
      scene.forget(b.part);
      scene.send(Request.Despawn(b.part));
    }
    clients.swap(k, clients.len() - 1usize);
    clients.pop();
  }

  // What the clients have been sent, to a client that has just joined: the log, in messages that fit
  fn sendLog(self &mut, id u32) {
    var items = List[List[u8]].empty();
    var i = 0usize;
    while i < log.len() {
      items.push(log.copyOf(i));
      i = i + 1usize;
    }
    var from = 0usize;
    while from < items.len() {
      var msg = List[u8].empty();
      from = packRequests(&items, from, &mut msg);
      net.sendReliable(id, msg);
    }
  }

  // One event from a connection
  fn onEvent(self &mut, event NetEvent) {
    var ev = event;
    match ev {
      case let j Joined { self.clientJoined(j.id, j.conn); }
      case let l Left { self.clientLeft(l.id); }
      case var m Message {
        var data = List[u8].empty();
        data <=> m.data;
        gotReliable = gotReliable + 1u64;
        var msg = decodeToSim(data);
        match &mut msg {
          case var l &mut Look { looks.push(l.pitch); }
          case var h &mut Hello { self.hello(m.id, h.name.view(), h.version); }
          case var c &mut Command { commands.push(c.kind); }
          case var k &mut Click { clicksIn.push(k.part); }
          case var pl &mut Play {
            if pl.kind == PLAY_PORTAL_TEST { self.portalTestFor(m.id); }
            elif pl.kind == PLAY_TALK { self.talkFor(m.id, pl.target, pl.spell); }
            elif pl.kind == PLAY_CREATURE_TEST { self.creatureTestFor(m.id, pl.spell); }
            else { play.receive(m.id, pl.kind, pl.spell, pl.target, pl.eye, pl.dir); }
          }
          case var f &mut Frame {
            frameAsked = true;
            frameNo = f.frame;
            frameSteps <=> f.steps;
          }
          else {}
        }
      }
      case var u Update {
        if u32.from(u.stream) == STREAM_INPUT {
          var data = List[u8].empty();
          data <=> u.data;
          var samples = List[InputSample].empty();
          if decodeInput(data, &mut samples) {
            let k = self.clientAt(u.id);
            if k != NO_ROW and samples.len() > 0usize {
              let cl = &mut clients[k];
              cl.receive(&samples);
              let last = (*samples[samples.len() - 1usize]).seq;
              if last > gotSeq { gotSeq = last; }
            }
          }
        }
      }
      case let r Refused {
        notices = notices + 1u64;
        print <- "A send was refused: "; print <- r.size; print <- " bytes against "; print <- r.limit; print <- "\n";
      }
    }
  }

  // ---- simulate ----

  // The frame's fixed steps: the pitch changes, then each step by the
  // intents of the input sequence number due for each client's being; every
  // being stepped; the birds on scene time (paused and x10 with the day); the
  // scene's clock moved on
  fn simulate(self &mut, steps &List[Step]) {
    stepSeconds = 0.;
    var p = 0usize;
    while p < looks.len() {
      if self.legacy() { cast.rig.tilt(*looks[p]); }
      p = p + 1usize;
    }
    looks.clear();
    // One entry a being, its intents
    while given.len() < cast.beings.len() { given.push(Intents.none()); stepIt.push(true); }
    // Single player: the user's being is the one possessed (Tab, or the script, changes it)
    if self.legacy() and clients.len() > 0usize {
      let c0 = &mut clients[0usize];
      c0.being = cast.possessed;
    }
    var i = 0usize;
    while i < steps.len() {
      let step = *steps[i];
      stepSeconds = stepSeconds + step.dt;
      var b = 0usize;
      while b < cast.beings.len() {
        given.set(b, Intents.none());
        stepIt.set(b, true);
        b = b + 1usize;
      }
      var c = 0usize;
      while c < clients.len() {
        let cl = &mut clients[c];
        let stepped = cl.take(lockstep);
        stepIt.set(cl.being, stepped);
        given.set(cl.being, cl.cur);
        if c == 0usize {
          appliedInput = cl.applied;
          missedInput = cl.missed;
          if self.legacy() and stepped { cast.rig.tilt(cl.curLook * LOOK_KEY_RATE * step.dt); }
        }
        c = c + 1usize;
      }
      // The villagers decide their intents, from where the players are
      village.players.clear();
      c = 0usize;
      while c < clients.len() {
        village.players.push(cast.beings[clients[c].being].body.position);
        c = c + 1usize;
      }
      village.step(&land, &cast, &mut given, step.dt);
      if opts.gallery { galleryIntents(self); }
      // The reflection that walked off down the corridor decides its steps (portalsim.cone)
      portalIntents(&mut portal, &mut cast, &mut given, tick);
      // The labyrinth's creatures decide theirs (the guards turn to a visitor, the Minotaur patrols and charges); a being in a vault or a
      // shove is carried along its curve, not stepped
      {
        let driven = self.drivenBeings();
        creaturesIntents(&mut creatures, &mut cast, &mut given, &mut stepIt, &driven, &mut play, tick, step.dt);
      }
      // A being under a spell is held: a convulsion or a dance is not steered
      playHold(&mut play, &mut given, tick);
      cast.stepEach(&given, &stepIt, step.dt, self.legacy());
      {
        let driven = self.drivenBeings();
        creaturesAfter(&mut creatures, &mut cast, &driven, &mut play, tick, step.dt);
        var ci = 0usize;
        while ci < creatures.out.len() {
          self.tellAll(encodeCreature(creatures.out[ci]));
          ci = ci + 1usize;
        }
        creatures.out.clear();
      }
      // A backlog of a client's inputs is run off, two a tick
      c = 0usize;
      while !lockstep and c < clients.len() {
        let cl = &mut clients[c];
        if cl.waiting() > BACKLOG {
          var only = 0usize;
          while only < cast.beings.len() { stepIt.set(only, false); only = only + 1usize; }
          if cl.take(false) {
            cl.extra = cl.extra + 1u64;
            stepIt.set(cl.being, true);
            given.set(cl.being, cl.cur);
            cast.stepEach(&given, &stepIt, step.dt, false);
          }
        }
        c = c + 1usize;
      }
      if self.legacy() { birds.step(&land, step.dt * f32.from(scene.clock.rate())); }
      self.portalAfterStep();
      scene.advanceClock(step.ns);
      tick = tick + 1u64;
      if serve { self.tidyConnections(); }
      if opts.traceOn { self.traceTick(); }
      i = i + 1usize;
    }
  }

  // The portal's part of a step (portalsim.cone): the gates gone through counted, the glass opened by a being that stood before it, the
  // reflection made as a puppet if it opened, the threads laid; and what every view is to be told, told
  fn portalAfterStep(self &mut) {
    var driven = List[usize].empty();
    var c = 0usize;
    while c < clients.len() {
      driven.push(clients[c].being);
      c = c + 1usize;
    }
    let ground = groundHeight(&land, COTTAGE_X, COTTAGE_Z);
    portalAfter(&mut portal, &mut cast, &driven, ground, tick);
    if portal.spawnFrom != NO_ROW { self.makePuppet(); }
    if portal.puppetDone { self.removePuppet(); }
    var i = 0usize;
    while i < portal.out.len() {
      self.tellAll(encodePortal(portal.out[i]));
      i = i + 1usize;
    }
    portal.out.clear();
  }

  // The puppet: a mannequin of the height and colour of the being that opened the glass, where its reflection stood, facing as it
  // did; a being of the cast whose intents the portal decides
  fn makePuppet(self &mut) {
    // (the same person as the being that opened the glass: its reflection)
    let of = cast.beings[portal.spawnFrom].figure.person;
    let idx = self.addMannequin("reflection", portal.spawnAt, portal.spawnYaw, if of == NO_PERSON { PERSON_AVATAR } else { usize.from(of) }, 91u32);
    cast.beings[idx].ai = true;
    while given.len() < cast.beings.len() { given.push(Intents.none()); stepIt.push(true); }
    portal.puppetMade(idx);
    print <- "The portal: the looking-glass opened at tick "; print <- tick; print <- "; its reflection (being "; print <- idx;
    print <- ") walks off down the corridor\n";
  }

  // The net check's client (--portal-walk) asks to be put down 3 m before the cottage's glass, facing it, with the glass open: its being is
  // set down there (as a script's hook would), and the glass opened for it (the reflection walks off), so that it can run through and every
  // view sees it cross
  fn portalTestFor(self &mut, id u32) {
    let k = self.clientAt(id);
    if k == NO_ROW { return; }
    let idx = clients[k].being;
    let ground = groundHeight(&land, COTTAGE_X, COTTAGE_Z);
    let at = new Vec3(GLASS_X, groundHeight(&land, GLASS_X, GLASS_Z - 3.), GLASS_Z - 3.);
    cast.beings[idx].setDown(at, 3.1415927);
    portal.openFor(&mut cast, idx, ground, tick);
    print <- "The portal test: client "; print <- id; print <- "'s being "; print <- idx; print <- " set down 3 m before the glass, which is open\n";
  }

  // The reflection reached E (the antechamber's door) and is gone: its being and part taken out of the world, as a client's is
  fn removePuppet(self &mut) {
    let idx = portal.puppet;
    portal.puppetDone = false;
    portal.puppet = NO_ROW;
    if idx >= cast.beings.len() { return; }
    let b = &mut cast.beings[idx];
    b.gone = true;
    scene.forget(b.part);
    scene.send(Request.Despawn(b.part));
    print <- "The portal: the reflection reached E and is gone (tick "; print <- tick; print <- ")\n";
  }

  // What a test reads: each client's being where this tick left it, with the wall clock (the performance counter)
  fn traceTick(self &) {
    if tick == 1u64 { print <- "QPCFREQ "; print <- sdl.GetPerformanceFrequency(); print <- "\n"; }
    var c = 0usize;
    while c < clients.len() {
      let b = cast.beings[clients[c].being];
      print <- "TS "; print <- tick; print <- " "; print <- sdl.GetPerformanceCounter(); print <- " "; print <- clients[c].being; print <- " ";
      print <- millimetres(b.body.position.x); print <- " "; print <- millimetres(b.body.position.y); print <- " ";
      print <- millimetres(b.body.position.z); print <- " "; print <- clients[c].applied; print <- "\n";
      c = c + 1usize;
    }
    // and each villager (a line of its own: TN tick, counter, being, x, y, z)
    c = 0usize;
    while c < village.npcs.len() {
      let b = cast.beings[village.npcs[c].being];
      print <- "TN "; print <- tick; print <- " "; print <- sdl.GetPerformanceCounter(); print <- " "; print <- village.npcs[c].being; print <- " ";
      print <- millimetres(b.body.position.x); print <- " "; print <- millimetres(b.body.position.y); print <- " ";
      print <- millimetres(b.body.position.z); print <- "\n";
      c = c + 1usize;
    }
    // and each of the labyrinth's creatures, the same line
    if creatures.on {
      c = 0usize;
      while c < 3usize {
        let ci = if c < 2usize { *creatures.guards[c] } else { creatures.bull };
        let b = cast.beings[ci];
        print <- "TN "; print <- tick; print <- " "; print <- sdl.GetPerformanceCounter(); print <- " "; print <- ci; print <- " ";
        print <- millimetres(b.body.position.x); print <- " "; print <- millimetres(b.body.position.y); print <- " ";
        print <- millimetres(b.body.position.z); print <- "\n";
        c = c + 1usize;
      }
    }
  }

  // ---- publish: before the world's turn ----

  // The clock's and the view's keys, the hard landings mailed, the clicks
  // told to their listeners, and the scene's events into the world's mail:
  // timers due, and the areas the beings are in
  fn beforeWorld(self &mut) {
    var c = 0usize;
    while c < commands.len() {
      let kind = *commands[c];
      if kind == COMMAND_PAUSE {
        scene.togglePause();
        print <- "Scene time "; if scene.clock.paused { print <- "paused"; } else { print <- "running"; };
        print <- " at "; print <- scene.now(); print <- " s\n";
      } elif kind == COMMAND_FAST {
        scene.toggleFast();
        print <- "Scene time x"; print <- scene.clock.rate(); print <- " at "; print <- scene.now(); print <- " s\n";
      } elif kind == COMMAND_WEATHER {
        weather.cycle(scene.now());
        print <- "Weather: "; printStr(weatherName(weather.target)); print <- " at "; print <- scene.now(); print <- " s\n";
      } elif kind == COMMAND_VIEW and self.legacy() {
        // V: first or third person (the view's own camera is the one drawn from; this is the harness's mirror)
        cast.rig.toggle();
        print <- "View: "; if cast.rig.mode == VIEW_FIRST { print <- "first person"; } else { print <- "third person"; }; print <- "\n";
      } elif kind == COMMAND_SWAP and self.legacy() {
        // Tab: the next mannequin
        cast.swap();
        print <- "Possessing being "; print <- cast.possessed; print <- "\n";
      }
      c = c + 1usize;
    }
    commands.clear();
    sceneNow = scene.now();
    // The playground's actions received are played, and what every view is to show of them told
    if play.pending.len() > 0usize {
      playApply(&mut play, &mut cast, tick, &clients);
      var bi = 0usize;
      while bi < play.bursts.len() {
        self.tellAll(encodeBurst(play.bursts[bi]));
        bi = bi + 1usize;
      }
      play.bursts.clear();
    }
    // Hard landings, mailed to the world
    var landings = cast.takeLandings();
    var li = 0usize;
    while li < landings.len() {
      let l = *landings[li];
      scene.post(Message.HardLanding(l.part, l.speed, l.damage));
      hardLandingsMailed = hardLandingsMailed + 1u64;
      li = li + 1usize;
    }
    // A click on a part its sender listens for is posted to the sender's Door
    var k = 0usize;
    while k < clicksIn.len() {
      let hit = *clicksIn[k];
      if scene.isListening(hit) { scene.post(Message.Clicked(hit)); }
      k = k + 1usize;
    }
    clicksIn.clear();
    scene.ring();
    if serve {
      // Each client's being in turn: an area holds the first to come in until it goes out
      var s = 0usize;
      while s < clients.len() {
        let b = cast.beings[clients[s].being];
        scene.senseWith(b.part, b.body.position, false);
        s = s + 1usize;
      }
    } else {
      let you = self.youBody();
      scene.sense(cast.beings[cast.possessed].part, you.position);
    }
  }

  // The world's turn: the registry lent and the mail moved to it
  fn worldTurn(self &mut) WorldTurn {
    new WorldTurn(scene.door.takeRegistry(), scene.door.takeMail(), sceneNow)
  }

  // ---- publish: after the world's turn ----

  // The registry back, the world's requests after the scene's own; the
  // apply point; the world matrices; the bodies carried by the platforms that
  // moved
  fn afterWorld(self &mut, reply WorldReply, frameNo u64) {
    var r = reply;
    var lent = Registry.empty();
    lent <=> r.registry;
    scene.door.putRegistry(lent);
    var batch = List[Request].empty();
    batch <=> r.requests;
    scene.door.absorb(batch, r.meshes, r.materials);
    if r.sentLast { worldSentFrame = frameNo; }
    worldDone = r.done;
    if scripted {
      var facts = WorldFacts.empty();
      facts <=> r.facts;
      world = facts;
    }
    // The world's requests applied and propagated first, so that the bodies
    // standing on a platform the world moved are carried with it this frame
    // (support.cone). The beings are placed by the view, from the state sent
    self.applyRequests();
    scene.propagate();
    scene.platformMoves(&mut moves);
    carryRiders(&mut cast, &moves, stepSeconds);
    scene.platformsNow(&mut platformsNow);
    cast.phys.syncPlatforms(&platformsNow);
  }

  // What the clients are told this frame: the accepted requests and a weather
  // change (reliable), the snapshot of the tick (latest-wins), and in a scripted
  // run its camera and the view's name (latest-wins, on a stream of its own).
  // A server sends snapshots at its own rate, every other tick (30 a second).
  fn publish(self &mut, frameNo u64) {
    if forView.len() > 0usize {
      var items = List[List[u8]].empty();
      var i = 0usize;
      while i < forView.len() {
        var one = List[u8].empty();
        if encodeRequest(forView[i], &mut one) {
          if one.len() > net.maxItem { net.maxItem = one.len(); }
          log.add(forView[i], copyBytes(&one));
          items.push(one);
        } else {
          skippedRequests = skippedRequests + 1u64;
        }
        i = i + 1usize;
      }
      forView.clear();
      var from = 0usize;
      while from < items.len() {
        var msg = List[u8].empty();
        from = packRequests(&items, from, &mut msg);
        self.tellAll(msg);
      }
    }
    if !weather.same(&weatherSent) {
      self.tellAll(encodeWeather(&weather));
      weatherSent = weather;
    }
    if clients.len() == 0usize { return; }
    // The being a single-player client drives, if it has changed
    if self.legacy() {
      let c0 = &mut clients[0usize];
      c0.being = cast.possessed;
      if c0.told != c0.being {
        c0.told = c0.being;
        net.sendReliable(c0.id, encodePossessed(u32.from(c0.being)));
      }
    }
    // A snapshot says where the beings are after a tick: none is sent twice, and a server sends them at its own rate
    if snapshotsSent > 0u64 and tick == lastPublish { return; }
    if serve and tick < lastPublish + 2u64 { return; }
    lastPublish = tick;
    var beings = List[BeingState].empty();
    var i = 0usize;
    while i < cast.beings.len() {
      let b = cast.beings[i];
      if !b.gone {
        // (sitting is not a mode the snapshot names: the sit is said apart, and the body walks, standing where it sits)
        var bs = new BeingState(u32.from(i), false, b.body.position, b.body.yaw, b.figure.speed, b.figure.vy, b.figure.airVx,
          b.figure.airVz, b.figure.grounded, b.intents, b.figure.on, b.figure.health, b.figure.setDowns, b.figure.landCount,
          b.figure.landSpeed, if b.figure.mode == FIG_SIT { FIG_WALK } else { b.figure.mode }, b.figure.modeT, b.figure.mode == FIG_RAG,
          ragRotations(&mut cast.phys, &b.figure));
        if b.figure.mode == FIG_SIT and b.figure.seat >= 0i32 {
          bs.seat = u32.from(b.figure.seat) + 1u32;
          bs.sitT = b.figure.sitT;
          bs.sitDown = b.figure.sitPhase != SIT_UP;
        }
        bs.hail = b.figure.hailT;
        beings.push(bs);
      }
      i = i + 1usize;
    }
    // The playground's pins and ball, once any has been moved
    var propsNow = List[PropState].empty();
    propsSnapshot(&cast.phys, &cast.props, &mut propsNow);
    // A scripted close-up looks from where the script says instead, through its lens
    var fixedView = scripted and (opts.gallery or hasView(&opts, &asm, frameNo));
    var look = Pose.look(new Vec3(0., 0., 0.), 0., 0.);
    var fov = FOV;
    var shot = String.empty();
    var capW = 0u32;
    var capH = 0u32;
    if opts.gallery {
      // A gallery run: the shot list's camera, lens, size and picture (gallery.cone)
      look = galleryView(self, frameNo);
      fov = galleryFov(&gallery, frameNo);
      shot = galleryShotAt(&gallery, frameNo);
      gallerySize(&gallery, frameNo, &mut capW, &mut capH);
    } else {
      if fixedView {
        look = viewAt(self, frameNo);
        fov = if creaturesIn(&opts, frameNo) { creaturesViewFov(&opts, frameNo) } elif labIn(&opts, frameNo) { labViewFov(&opts, frameNo) } else { viewFov(&asm, frameNo) };
      }
      shot = String.from(shotAt(&opts, &asm, frameNo));
    }
    var test = new TestView(fixedView, look, fov, shot);
    test.width = capW;
    test.height = capH;
    var c = 0usize;
    while c < clients.len() {
      let cl = clients[c];
      var w = new WorldState(tick, scene.now(), u32.from(scene.clock.rate()), cl.applied, copyBeings(&beings), copyProps(&propsNow),
        copyFx(&play.fx));
      // The being the client drives crosses whole: it is compared with the client's own prediction
      var k = 0usize;
      while k < w.beings.len() {
        if u32.from(cl.being) == w.beings[k].being { w.beings.set(k, exactly(*w.beings[k])); }
        k = k + 1usize;
      }
      let bytes = encodeState(&w);
      stateBytes = stateBytes + u64.from(bytes.len());
      snapshotsSent = snapshotsSent + 1u64;
      if scripted { net.sendLatest(cl.id, STREAM_TEST, encodeTest(&test)); }
      net.sendLatest(cl.id, STREAM_STATE, bytes);
      c = c + 1usize;
    }
  }

  // A reliable message to every client
  fn tellAll(self &mut, msg List[u8]) {
    var c = 0usize;
    while c < clients.len() {
      net.sendReliable(clients[c].id, copyBytes(&msg));
      c = c + 1usize;
    }
  }

  // Apply every request waiting, in the order sent: the scene's own here,
  // and, once the scene has checked what each names is live, the ones the
  // view keeps or draws are kept to be sent to it (forView), in the same order
  fn applyRequests(self &mut) {
    if scene.waiting() == 0usize { return; }
    var batch = scene.takeInbox();
    let requests = batch.viewMut();
    var i = 0usize;
    while i < requests.len {
      var r Request = Request.Done;
      r <=> requests[i];
      var toView = false;
      match &mut r {
        case var s &mut Spawn { toView = scene.applySpawn(s.id, s.name.copy()); }
        case var p &mut Place { toView = scene.applyPlace(p.id, p.at); }
        case var pa &mut Parent { toView = scene.applyParent(pa.id, pa.parent); }
        case var d &mut Despawn {
          // The part and its whole subtree: the scene's rows here; the view
          // drops every other system's for each part that went
          var gone = List[PartId].empty();
          if scene.applyDespawn(d.id, &mut gone) {
            toView = true;
            if scripted {
              var k = 0usize;
              while k < gone.len() {
                picks.drop(*gone[k]);
                k = k + 1usize;
              }
            }
          }
        }
        case var dm &mut DefineMesh {
          if scene.applyDefine(dm.mesh.id, KIND_MESH) {
            if scripted { picks.shape(dm.mesh, &dm.shape); }
            toView = true;
          }
        }
        case var ds &mut DefineSkinnedMesh {
          if scene.applyDefine(ds.mesh.id, KIND_MESH) {
            if scripted { picks.shape(ds.mesh, &ds.shape); }
            toView = true;
          }
        }
        case var dd &mut DefineMorphed {
          if scene.applyDefine(dd.mesh.id, KIND_MESH) {
            if scripted { picks.shape(dd.mesh, &dd.shape); }
            toView = true;
          }
        }
        case var sa &mut Seat {
          // A seat the world has (its objects are built in every browser, so none is sent on): the physics world's table of them
          cast.phys.addSeat(sa.id, sa.point, sa.yaw, sa.height, sa.rock, sa.period, sa.rest);
          scene.applied = scene.applied + 1u64;
        }
        case var bn &mut Bones { toView = self.passLive(bn.id); }
        case var dl &mut DefineMaterial { toView = scene.applyDefine(dl.material.id, KIND_MATERIAL); }
        case is ObjectBegin { inObject = true; }
        case is Object { inObject = false; toView = true; }
        case is BeingAdded {
          toView = true;
          scene.applied = scene.applied + 1u64;
        }
        case var sh &mut Show {
          if !scene.isLive(sh.id) or !scene.isMesh(sh.mesh) or !scene.isMaterial(sh.material) {
            scene.refused = scene.refused + 1u64;
          } else {
            if scripted and sh.anchor == 0. { picks.show(sh.id, sh.mesh); }
            scene.applied = scene.applied + 1u64;
            toView = true;
          }
        }
        case var tm &mut Timer { scene.applyTimer(tm.token, tm.at, tm.every); }
        case var cn &mut Cancel { scene.applyCancel(cn.token); }
        case var ar &mut Area { scene.applyArea(ar.id, ar.volume); }
        case var ef &mut Effect { toView = self.passLive(ef.id); }
        case var f &mut Fire {
          toView = self.passLive(f.id);
          if toView { fired = fired + 1u64; }
        }
        case var l &mut Listen { scene.applyListen(l.id); }
        case var pl &mut Platform {
          // The clients keep the platforms too: their own bodies stand on them
          toView = scene.applyPlatform(pl.id, pl.shape);
        }
        case var gl &mut Glow {
          if !scene.isMaterial(gl.material) {
            scene.refused = scene.refused + 1u64;
          } else {
            scene.applied = scene.applied + 1u64;
            toView = true;
          }
        }
        case var tn &mut Tint { toView = self.passLive(tn.id); }
        case var ls &mut LightSource { toView = self.passLive(ls.id); }
        case var cs &mut CastsShadow { toView = self.passLive(cs.id); }
        case var cu &mut Cull { toView = self.passLive(cu.id); }
        case var k &mut Sky { toView = self.passLive(k.id); }
        else {}
      }
      // What the view builds itself, from the Object that closes it, is not sent
      if inObject { toView = false; }
      if toView { forView.push(r); }
      i = i + 1usize;
    }
  }

  // A request naming part 'id' that the view draws: kept (and counted
  // applied) if the part is live, else refused
  fn passLive(self &mut, id PartId) bool {
    if !scene.isLive(id) {
      scene.refused = scene.refused + 1u64;
      return false;
    }
    scene.applied = scene.applied + 1u64;
    true
  }

  // ---- after the frame is drawn ----

  // What the view saw, noted; in a scripted run, the script's checks and its
  // next events; the shell's report
  fn afterDraw(self &mut, facts ViewFacts) EndFrame {
    var f = facts;
    picked = f.picked;
    lastPick = f.lastPick;
    clicks = f.clicks;
    view = f.view;
    if (f.shotFailed or f.late) and scriptOk { print <- "Script: frame "; print <- f.frame; print <- ", a shot failed or the state was late\n"; }
    if f.shotFailed or f.late { scriptOk = false; }
    let you = self.youBody();
    if scripted {
      var seen = RenderFacts.empty();
      seen <=> f.rendered;
      rendered = seen;
      // (the panel-only run checks the script's first 100 frames and none after: what the later ones check is not run)
      // (nor does the labyrinth-only run, from where its part begins: its own checks are run.labOk)
      // (and a gallery run walks no script: its own part is galleryDrive, gallery.cone)
      if !opts.gallery and !(opts.panelOnly and f.frame >= PANEL_FROM) and !(opts.labOnly and f.frame >= labFrom(&opts))
        and !(opts.creaturesOnly and f.frame >= creaturesFrom(&opts)) {
        if !checkScript(self, f.frame, &you) {
          if scriptOk { print <- "Script: the checks of frame "; print <- f.frame; print <- " failed\n"; }
          scriptOk = false;
        }
      }
      if opts.labOnly and !run.labOk { scriptOk = false; }
      if opts.creaturesOnly and !run.creaturesOk { scriptOk = false; }
      if opts.gallery {
        galleryDrive(self, f.frame);
      } else {
        driveScene(self, f.frame);
        pushScript(&opts, f.frame + 1u64);
        pushClicks(self, f.frame + 1u64, &you);
      }
    }
    new EndFrame(self.youBody(), scene.waiting(), scene.partCount(), worldDone, worldSentFrame)
  }

  // The scene's lines at the end of the run
  fn report(self &mut) {
    print <- "Scene: "; print <- scene.partCount(); print <- " parts; requests applied "; print <- scene.applied;
    print <- ", refused "; print <- scene.refused; print <- "\n";
    let you = self.youBody();
    print <- "Walked to ("; print <- you.position.x; print <- ", "; print <- you.position.z;
    print <- "), facing "; print <- you.yaw; print <- " rad\n";
    print <- "Scene time "; print <- scene.now(); print <- " s, the day clock at "; print <- scene.hour();
    print <- " h; timers rung "; print <- scene.rung(); print <- ", armed "; print <- scene.timerCount(); print <- "\n";
    print <- "Input: last sequence number applied "; print <- appliedInput; print <- ", steps with none due "; print <- missedInput;
    print <- "\n";
    if village.npcs.len() > 0usize and village.steps > 0u64 {
      var walked = 0.;
      var stalls = 0u32;
      var v = 0usize;
      while v < village.npcs.len() { walked = walked + village.npcs[v].walked; stalls = stalls + village.npcs[v].stalls; v = v + 1usize; }
      print <- "Villagers: "; print <- village.npcs.len(); print <- " on a navigation mesh of "; print <- village.world.polygons; print <- " polygons (built in ";
      print <- f64.from(village.world.buildNs) / 1000000.0; print <- " ms); their minds took "; print <- f64.from(village.thinkNs) / f64.from(village.steps) / 1000.0;
      print <- " us a step; walked "; print <- walked; print <- " m in all, "; print <- stalls; print <- " stalls, "; print <- village.world.queries;
      print <- " route queries in "; print <- f64.from(village.world.queryNs) / 1000000.0; print <- " ms\n";
      v = 0usize;
      while v < village.npcs.len() {
        let n = village.npcs[v];
        print <- "  "; printStr(n.name.view()); print <- ": walked "; print <- n.walked; print <- " m, "; print <- n.replans; print <- " routes planned, "; print <- n.stalls;
        print <- " stalls, wall touched on "; print <- n.blocked; print <- " steps, "; print <- n.noRoute; print <- " times no route\n";
        v = v + 1usize;
      }
    }
    print <- "The baked-in world, object by object:\n";
  }

  // What the server sent each client, at the end of the run
  fn netReport(self &mut) {
    print <- "Server: "; print <- tick; print <- " ticks, "; print <- snapshotsSent; print <- " snapshots, "; print <- clients.len();
    print <- " clients now; "; print <- skippedRequests; print <- " requests did not cross, "; print <- net.refused; print <- " sends refused\n";
    if snapshotsSent > 0u64 {
      print <- "  a snapshot averages "; print <- stateBytes / snapshotsSent; print <- " bytes\n";
    }
    print <- "  the largest reliable message "; print <- net.maxReliable; print <- " bytes (the limit "; print <- MAX_RELIABLE; print <- "), the largest request ";
    print <- net.maxItem; print <- ", the largest snapshot "; print <- net.maxLatest; print <- " (the limit "; print <- MAX_LATEST; print <- ")\n";
  }
}

// A distance in whole millimetres, for a trace
fn millimetres(v f32) i64 { i64.from(libc.floorf(v * 1000. + 0.5)) }

// The name of the k-th client's mannequin
fn clientName(k u32) &str {
  let names Array[&str, 8] = ["mannequin 1", "mannequin 2", "mannequin 3", "mannequin 4", "mannequin 5", "mannequin 6", "mannequin 7",
    "mannequin 8"];
  names[usize.from(k % 8u32)]
}

// A copy of a list of beings' states
fn copyBeings(src &List[BeingState]) List[BeingState] {
  var out = List[BeingState].withCapacity(src.len());
  var i = 0usize;
  while i < src.len() {
    out.push(*src[i]);
    i = i + 1usize;
  }
  out
}

// A being's state with its numbers whole
fn exactly(b BeingState) BeingState {
  var e = new BeingState(b.being, true, b.position, b.yaw, b.speed, b.vy, b.airVx, b.airVz, b.grounded, b.intents, b.platform, b.health,
    b.respawns, b.landings, b.landSpeed, b.mode, b.modeT, b.hasRots, b.rots);
  e.seat = b.seat;
  e.sitT = b.sitT;
  e.sitDown = b.sitDown;
  e.hail = b.hail;
  e
}

// A copy of some bytes
fn copyBytes(b &List[u8]) List[u8] {
  var out = List[u8].withCapacity(b.len());
  var i = 0usize;
  while i < b.len() {
    out.push(*b[i]);
    i = i + 1usize;
  }
  out
}

// The point at (x, z) on the ground, for a being to stand on
fn standing(isl &Island, x f32, z f32) Vec3 { new Vec3(x, groundHeight(isl, x, z), z) }

actor SimActor {
  st SimState;
  world WorldActor;
  joined Sender[bool];         // the shell's: whether the first client joined
  served Sender[u64];          // the shell's: a server's tick done
  stopped bool;                // single player went online (the view's goOnline): this simulation is over and answers nothing more

  // The scene seeded (the shell's parts and the beings), with the flock the
  // shell made, its world actor named, and the end of the connections
  fn init(self &new, opts RunOptions, birds Birds, world WorldActor, serve bool, joined Sender[bool], served Sender[u64],
      land Island, gallery GalleryPlan, people People) {
    var state = SimState.make(opts, birds, serve, land);
    state.gallery = gallery;
    state.people = people;
    state.seed();
    *self = new Self(state, world, joined, served, false);
  }

  // Single player went online: this simulation is over. Its connections are hung up and what they tell afterwards is ignored
  // (the clients' leaving is not reported: nothing is ending the run), so that nothing more is said or simulated.
  pub async do stop(self) bool {
    stopped = true;
    var i = 0usize;
    while i < st.net.peers.len() {
      st.net.hangUp(st.net.peers[i].id);
      i = i + 1usize;
    }
    true
  }

  // Single player: this simulation's connection joined to the view's (netmsg's in-process pair)
  pub async do wire(self, viewHandler EventHandler) {
    let me = selfactor;
    let mine = eventHandler(new Uni[fn(ev NetEvent) + Sendable](fn(ev NetEvent) [me] { me.onNet(ev); }));
    let pair = pairInProcess(mine, 1u32, viewHandler, 1u32);
  }

  // What a connection tells (the connections' handler sends it here): a client joined or left, a message, a value.
  // In single player the view's frame arrives as a message after its inputs, and the simulation takes it at once
  pub async do onNet(self, ev NetEvent) {
    if stopped { return; }
    st.onEvent(ev);
    if st.joinedNow {
      st.joinedNow = false;
      joined <- true;
    }
    if st.frameAsked {
      st.frameAsked = false;
      let t0 = sdl.GetTicksNS();
      var steps = List[Step].empty();
      steps <=> st.frameSteps;
      st.simulate(&steps);
      let t1 = sdl.GetTicksNS();
      st.beforeWorld();
      let reply = await world.tick(st.worldTurn());
      st.afterWorld(reply, st.frameNo);
      st.publish(st.frameNo);
      let t2 = sdl.GetTicksNS();
      // Said last: when the view hears it, it has heard the rest
      if st.clients.len() > 0usize {
        st.net.sendReliable(st.clients[0usize].id, encodeFrameDone(st.tick, t1 - t0, t2 - t1));
      }
    }
  }

  // A server's tick, answered to the shell's channel (the shell is no actor): the events heard are already taken
  pub async do serveTick(self, turn Advance) {
    var t = turn;
    st.simulate(&t.steps);
    st.beforeWorld();
    let reply = await world.tick(st.worldTurn());
    st.afterWorld(reply, t.frame);
    st.publish(t.frame);
    served <- st.tick;
  }

  // A server's end: the scene's lines, the world's log and what was sent the clients
  pub async do serveEnd(self) {
    st.report();
    let reported = await world.report();
    st.netReport();
    served <- 0u64;
  }

  // The frame drawn: what the view saw, and the answer for the shell's report
  pub async do endFrame(self, facts ViewFacts) EndFrame {
    st.afterDraw(facts)
  }

  // The end of the run (above): the scene's lines and the world's log
  pub async do finishScene(self) bool {
    st.report();
    let reported = await world.report();
    if st.serve { st.netReport(); }
    reported
  }

  // The script's verdict and the exit code, once render has reported 'clean'
  pub async do verdict(self, clean bool) i32 {
    var code = 0i32;
    // (the --panel-join run is on the real clock, which the script's step-counted checks do not hold on; it has checks of its own)
    if st.scripted and !st.scriptOk and st.opts.panelJoin == 0u32 { code = 1i32; }
    if !clean { code = 1i32; }
    if st.scripted { reportScript(st.scriptOk); }
    code
  }
}
