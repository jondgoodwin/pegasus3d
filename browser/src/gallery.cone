// The gallery: stills from a camera that is told where to stand, what to look at, which hour it is and how large to be
// (browser.exe --gallery FILE [--shots DIR]). A shot list is a small text file, a section per shot:
//
//   # comments run from a # to the line's end
//   [defaults]               # optional: what every shot after it starts from
//   size = 2560x1440         # pixels, whatever the window is (a shot is drawn off screen)
//   fov = 60                 # vertical, degrees
//   time = 12                # the hour of the day, 0 to 24 (7 sunrise-ish, 17.2 sunset, 17.9 dusk, 23 night); 17:54 works too
//   weather = fair           # clear, fair, cloudy, overcast, rain or snow
//   settle = 150             # frames the world and the picture are given to settle before the shot is taken
//
//   [cottage-dusk]           # the shot's name: its file is DIR/cottage-dusk.png
//   pos-agl = -4.2, 1.7, 345 # the eye: x, height above the ground there, z (metres; or  pos = x, y, z  with y the world's height)
//   target-agl = -16, 4.5, 330   # a point to look at, the same two ways (target = x, y, z) ...
//                            # ... or  yaw = 20  and  pitch = 3  (degrees; yaw 0 faces -z, positive turns left)
//   time = 17.88
//
// 'day = N' picks which of the day's repeats the sky's clouds are from (they drift with time; the same hour and day always give
// the same sky). The camera printed by G while playing is one of these sections. The labyrinth is 300 m under the island (its
// floor is y = -300 at x -46 to 76, z 299 to 434): an eye down there is lit as the labyrinth is, whatever the time says.

// The frame the first shot's window begins at: the world has arrived and the first frames' uploads are done
pub const GALLERY_START = 300u64;
// The frames a shot is given to settle by default (the temporal anti-aliasing, the auto-exposure's eye, the level-of-detail fades)
pub const GALLERY_SETTLE = 150u32;
// The day the clock is put in, before the shot's own 'day' (the sky's clouds are a closed form of scene time)
const GALLERY_DAY0 = 3u64;

// What a person in a shot does (person = N, x, z, yaw, STATE): stands, walks or runs on (from where it is put, so that it is at x, z at
// the picture: the walk is back-dated), sits on the nearest seat, hails
pub const GP_STAND = 0u32;
pub const GP_WALK = 1u32;
pub const GP_RUN = 2u32;
pub const GP_SIT = 3u32;
pub const GP_HAIL = 4u32;

// A person of humanbody's cast put in a shot, where it is at the picture
pub struct GalleryPerson {
  pub person usize;
  pub at Vec2;                // x, z
  pub yaw f32;                // radians
  pub state u32;              // GP_...
  pub being usize;            // its being, once spawned (0: not)
  pub y f32;                  // the floor's height, if the shot gives it: metres over the island's ground there (the porch's deck 0.6), or below -100 the world's own (the labyrinth's, -300)
  pub hasY bool;
  pub born u64;               // the simulation tick it was spawned at
}

pub struct GalleryShot {
  pub name String;
  pub eye Vec3;
  pub eyeAgl bool;          // the eye's y is metres above the ground at its x, z (pos-agl), else the world's height
  pub byAngles bool;        // look by 'yaw' and 'pitch' (radians), else at 'target'
  pub target Vec3;
  pub targetAgl bool;       // likewise the target's
  pub yaw f32;
  pub pitch f32;
  pub fov f32;              // vertical, radians
  pub hour f64;
  pub weather u32;          // WEATHER_...
  pub day u32;
  pub width u32;
  pub height u32;
  pub settle u32;
  hasEye bool;
  hasLook bool;
  pub people List[GalleryPerson];    // the people in it (person = ...)

  fn blank() GalleryShot {
    new GalleryShot(String.empty(), new Vec3(0., 0., 0.), false, false, new Vec3(0., 0., 0.), false, 0., 0., 1.0471976, 12d, 1u32, 0u32,
      1440u32, 810u32, GALLERY_SETTLE, false, false, List[GalleryPerson].empty())
  }

  fn copy(self &) GalleryShot {
    var folk = List[GalleryPerson].empty();
    var k = 0usize;
    while k < people.len() { folk.push(*people[k]); k = k + 1usize; }
    new GalleryShot(name.copy(), eye, eyeAgl, byAngles, target, targetAgl, yaw, pitch, fov, hour, weather, day, width, height, settle,
      hasEye, hasLook, folk)
  }
}

// The shots of a list, in the order written (a list with no shot, or with a fault, is not one to run: 'ok' says)
pub struct GalleryPlan {
  pub shots List[GalleryShot];
  pub ok bool;
  pub spawned List[GalleryPerson];   // the people of the shot in hand, spawned for it (the run's)

  pub fn none() GalleryPlan { new GalleryPlan(List[GalleryShot].empty(), true, List[GalleryPerson].empty()) }

  pub fn copy(self &) GalleryPlan {
    var out = List[GalleryShot].empty();
    var i = 0usize;
    while i < shots.len() { out.push(shots[i].copy()); i = i + 1usize; }
    new GalleryPlan(out, ok, List[GalleryPerson].empty())
  }

  // Whether a list was given (a run of the gallery)
  pub fn on(self &) bool { shots.len() > 0usize }
}

// ---- reading the list ----

fn isSpaceByte(c u8) bool { c == 32u8 or c == 9u8 or c == 13u8 or c == 10u8 }

// The numbers in 'b', separated by spaces, commas, brackets or an x ("2560x1440"); false at anything else
fn readNumbers(b &Array[u8], out &mut List[f64]) bool {
  var i = 0usize;
  while i < b.len {
    let c = b[i];
    if isSpaceByte(c) or c == ',' or c == '[' or c == ']' or c == 'x' or c == 'X' { i = i + 1usize; continue; }
    var neg = false;
    if c == '-' { neg = true; i = i + 1usize; } elif c == '+' { i = i + 1usize; }
    var digits = 0usize;
    var v = 0d;
    while i < b.len and b[i] >= '0' and b[i] <= '9' {
      v = v * 10d + f64.from(b[i] - '0');
      digits = digits + 1usize;
      i = i + 1usize;
    }
    if i < b.len and b[i] == '.' {
      i = i + 1usize;
      var scale = 0.1d;
      while i < b.len and b[i] >= '0' and b[i] <= '9' {
        v = v + f64.from(b[i] - '0') * scale;
        scale = scale * 0.1d;
        digits = digits + 1usize;
        i = i + 1usize;
      }
    }
    if digits == 0usize { return false; }
    if i < b.len and (b[i] == 'e' or b[i] == 'E') {
      i = i + 1usize;
      var eneg = false;
      if i < b.len and b[i] == '-' { eneg = true; i = i + 1usize; } elif i < b.len and b[i] == '+' { i = i + 1usize; }
      var e = 0u32;
      var edigits = 0usize;
      while i < b.len and b[i] >= '0' and b[i] <= '9' {
        e = e * 10u32 + u32.from(b[i] - '0');
        edigits = edigits + 1usize;
        i = i + 1usize;
      }
      if edigits == 0usize { return false; }
      var k = 0u32;
      while k < e and k < 40u32 { v = if eneg { v / 10d } else { v * 10d }; k = k + 1u32; }
    }
    out.push(if neg { 0d - v } else { v });
  }
  true
}

// The weather named, or WEATHER_STATES
fn weatherNamed(s &str) u32 {
  var k = 0u32;
  while k < WEATHER_STATES {
    if s == weatherName(k) { return k; }
    k = k + 1u32;
  }
  WEATHER_STATES
}

// A shot's name is a file's: letters, digits, '-', '_' and '.'
fn nameOk(s &str) bool {
  if s.len == 0usize { return false; }
  var i = 0usize;
  while i < s.len {
    let c = s[i];
    let ok = (c >= 'a' and c <= 'z') or (c >= 'A' and c <= 'Z') or (c >= '0' and c <= '9') or c == '-' or c == '_' or c == '.';
    if !ok { return false; }
    i = i + 1usize;
  }
  true
}

fn lineFault(line usize, why &str) {
  print <- "gallery: line "; print <- line; print <- ": "; printStr(why); print <- "\n";
}

// 'key = value' applied to 'shot'; false (having said why) if the key is not one or the value is not right
fn applyKey(shot &mut GalleryShot, key &str, value &str, line usize) bool {
  var nums = List[f64].empty();
  // A value in double quotes is the text inside
  var text = String.from(value);
  if text.len() >= 2usize and text.view()[0usize] == '"' and text.view()[text.len() - 1usize] == '"' {
    text = text.sub(1usize, text.len() - 1usize);
  }
  if key == "person" {
    // person = N, x, z, yaw, STATE: a person of humanbody's cast (0 the main avatar, 1 to 6 the others) where it is at the picture, facing
    // 'yaw' degrees, standing, walking, running, sitting or hailing; any number of them in a shot
    let fields = text.split(',');
    if fields.len() < 4usize or fields.len() > 6usize {
      lineFault(line, "person is N, x, z, yaw, a state (stand, walk, run, sit or hail) and the floor's height if not the island's");
      return false;
    }
    var got = List[f64].empty();
    var f = 0usize;
    while f < 4usize {
      var one = List[f64].empty();
      if !readNumbers(fields[f].view(), &mut one) or one.len() != 1usize { lineFault(line, "person is N, x, z, yaw and a state"); return false; }
      got.push(*one[0usize]);
      f = f + 1usize;
    }
    var state = GP_STAND;
    var floorY = 0.;
    var hasFloor = false;
    if fields.len() == 6usize {
      var one = List[f64].empty();
      if !readNumbers(fields[5usize].view(), &mut one) or one.len() != 1usize { lineFault(line, "the floor's height is one number"); return false; }
      floorY = f32.from(*one[0usize]);
      hasFloor = true;
    }
    if fields.len() >= 5usize {
      let word = fields[4usize].trim();
      if word.view() == "stand" { state = GP_STAND; }
      elif word.view() == "walk" { state = GP_WALK; }
      elif word.view() == "run" { state = GP_RUN; }
      elif word.view() == "sit" { state = GP_SIT; }
      elif word.view() == "hail" { state = GP_HAIL; }
      else { lineFault(line, "a person's state is stand, walk, run, sit or hail"); return false; }
    }
    if *got[0usize] < 0d or *got[0usize] > 8d { lineFault(line, "the person is 0 to 6 (humanbody's cast), or 7 and 8, the labyrinth's guards"); return false; }
    shot.people.push(new GalleryPerson(usize.from(*got[0usize]), new Vec2(f32.from(*got[1usize]), f32.from(*got[2usize])),
      f32.from(*got[3usize]) * 0.017453292, state, 0usize, floorY, hasFloor, 0u64));
    return true;
  }
  if key == "weather" {
    let w = weatherNamed(text.view());
    if w >= WEATHER_STATES { lineFault(line, "weather is clear, fair, cloudy, overcast, rain or snow"); return false; }
    shot.weather = w;
    return true;
  }
  if key == "time" {
    // An hour as 17.5 or as 17:30
    var parts = text.split(':');
    var hour = 0d;
    if parts.len() == 2usize {
      var h = List[f64].empty();
      var m = List[f64].empty();
      if !readNumbers(parts[0usize].view(), &mut h) or !readNumbers(parts[1usize].view(), &mut m) or h.len() != 1usize or m.len() != 1usize {
        lineFault(line, "time is an hour (17.5) or hours and minutes (17:30)");
        return false;
      }
      hour = *h[0usize] + *m[0usize] / 60d;
    } else {
      if !readNumbers(text.view(), &mut nums) or nums.len() != 1usize { lineFault(line, "time is an hour (17.5) or hours and minutes (17:30)"); return false; }
      hour = *nums[0usize];
    }
    if hour < 0d or hour > 48d { lineFault(line, "time is an hour from 0 to 24"); return false; }
    shot.hour = hour;
    return true;
  }
  if !readNumbers(text.view(), &mut nums) { lineFault(line, "a number was expected"); return false; }
  if key == "pos" or key == "pos-agl" {
    if nums.len() != 3usize { lineFault(line, "pos is x, y, z (pos-agl: y is the height above the ground there)"); return false; }
    shot.eye = new Vec3(f32.from(*nums[0usize]), f32.from(*nums[1usize]), f32.from(*nums[2usize]));
    shot.eyeAgl = key == "pos-agl";
    shot.hasEye = true;
    return true;
  }
  if key == "target" or key == "target-agl" {
    if nums.len() != 3usize { lineFault(line, "target is x, y, z (target-agl: y is the height above the ground there)"); return false; }
    shot.target = new Vec3(f32.from(*nums[0usize]), f32.from(*nums[1usize]), f32.from(*nums[2usize]));
    shot.targetAgl = key == "target-agl";
    shot.byAngles = false;
    shot.hasLook = true;
    return true;
  }
  if key == "yaw" or key == "pitch" {
    if nums.len() != 1usize { lineFault(line, "yaw and pitch are one number each, degrees"); return false; }
    let radians = f32.from(*nums[0usize]) * 0.017453292;
    if key == "yaw" { shot.yaw = radians; } else { shot.pitch = radians; }
    shot.byAngles = true;
    shot.hasLook = true;
    return true;
  }
  if key == "fov" {
    if nums.len() != 1usize or *nums[0usize] < 5d or *nums[0usize] > 150d { lineFault(line, "fov is the vertical angle, 5 to 150 degrees"); return false; }
    shot.fov = f32.from(*nums[0usize]) * 0.017453292;
    return true;
  }
  if key == "size" {
    if nums.len() != 2usize or *nums[0usize] < 64d or *nums[0usize] > 7680d or *nums[1usize] < 64d or *nums[1usize] > 4320d {
      lineFault(line, "size is WIDTHxHEIGHT in pixels, from 64 to 7680 by 4320");
      return false;
    }
    shot.width = u32.from(*nums[0usize]);
    shot.height = u32.from(*nums[1usize]);
    return true;
  }
  if key == "settle" {
    if nums.len() != 1usize or *nums[0usize] < 2d or *nums[0usize] > 3000d { lineFault(line, "settle is a number of frames, 2 to 3000"); return false; }
    shot.settle = u32.from(*nums[0usize]);
    return true;
  }
  if key == "day" {
    if nums.len() != 1usize or *nums[0usize] < 0d or *nums[0usize] > 1000d { lineFault(line, "day is a whole number, 0 to 1000"); return false; }
    shot.day = u32.from(*nums[0usize]);
    return true;
  }
  lineFault(line, "unknown key (pos, pos-agl, target, target-agl, yaw, pitch, fov, time, weather, size, settle, day)");
  false
}

// The shot list in 'text', read; any fault is said, with its line, and the plan is not ok
pub fn readGallery(text &str) GalleryPlan {
  var plan = GalleryPlan.none();
  var defaults = GalleryShot.blank();
  var cur = GalleryShot.blank();
  var inShot = false;
  var inDefaults = false;
  var ok = true;
  var curLine = 0usize;
  let lines = String.from(text).lines();
  var n = 0usize;
  while n <= lines.len() {
    // (one more turn after the last line, to close the last shot)
    var raw = String.empty();
    if n < lines.len() { raw = lines[n].copy(); }
    let lineNo = n + 1usize;
    n = n + 1usize;
    // The comment cut off, the rest trimmed
    var cut = raw.len();
    var c = 0usize;
    while c < raw.len() { if raw.view()[c] == '#' { cut = c; c = raw.len(); } else { c = c + 1usize; } }
    let body = raw.sub(0usize, cut).trim();
    let last = lineNo > lines.len();
    if body.len() == 0usize and !last { continue; }
    if last or body.view()[0usize] == '[' {
      // The shot before is done: it needs an eye and a look
      if inShot {
        if !cur.hasEye or !cur.hasLook {
          lineFault(curLine, "a shot needs pos and a look (target, or yaw and pitch)");
          ok = false;
        } else {
          plan.shots.push(cur.copy());
        }
        inShot = false;
      }
      inDefaults = false;
      if last { break; }
      let bv = body.view();
      if bv[bv.len - 1usize] != ']' { lineFault(lineNo, "a section is [name]"); ok = false; continue; }
      let name = body.sub(1usize, bv.len - 1usize).trim();
      if name.view() == "defaults" {
        inDefaults = true;
        continue;
      }
      if !nameOk(name.view()) { lineFault(lineNo, "a shot's name is letters, digits, - _ and ."); ok = false; continue; }
      var k = 0usize;
      while k < plan.shots.len() {
        if plan.shots[k].name.view() == name.view() { lineFault(lineNo, "a shot's name is used once"); ok = false; }
        k = k + 1usize;
      }
      cur = defaults.copy();
      cur.name = name.copy();
      // (what the defaults gave is a look and an eye only if they were given)
      inShot = true;
      curLine = lineNo;
      continue;
    }
    if !inShot and !inDefaults { lineFault(lineNo, "a key before any [section]"); ok = false; continue; }
    let bytes = body.view();
    var eq = bytes.len;
    var q = 0usize;
    while q < bytes.len { if bytes[q] == '=' { eq = q; q = bytes.len; } else { q = q + 1usize; } }
    if eq >= bytes.len { lineFault(lineNo, "key = value was expected"); ok = false; continue; }
    let key = body.sub(0usize, eq).trim();
    let value = body.sub(eq + 1usize, bytes.len).trim();
    if inDefaults {
      if !applyKey(&mut defaults, key.view(), value.view(), lineNo) { ok = false; }
    } else {
      if !applyKey(&mut cur, key.view(), value.view(), lineNo) { ok = false; }
    }
  }
  if plan.shots.len() == 0usize and ok {
    print <- "gallery: the shot list holds no shot\n";
    ok = false;
  }
  plan.ok = ok;
  plan
}

// ---- the schedule ----
//
// Shot i has a window of frames: it begins at start(i), the camera, the hour and the weather are put as they are for it (the
// frame before), and the picture is taken 'settle' frames in; the next window begins two frames on. Frames before the first
// window are the first shot's, so that the sky, the clouds and the fades settle from the start.

pub fn galleryStart(plan &GalleryPlan, i usize) u64 {
  var at = GALLERY_START;
  var k = 0usize;
  while k < i {
    at = at + u64.from(plan.shots[k].settle) + 2u64;
    k = k + 1usize;
  }
  at
}

// The run's length in frames
pub fn galleryEnd(plan &GalleryPlan) u64 {
  let n = plan.shots.len();
  if n == 0usize { return GALLERY_START; }
  galleryStart(plan, n - 1usize) + u64.from(plan.shots[n - 1usize].settle) + 3u64
}

// The shot whose window frame 'f' is in
pub fn galleryIndex(plan &GalleryPlan, f u64) usize {
  var i = 0usize;
  while i + 1usize < plan.shots.len() and f >= galleryStart(plan, i + 1usize) { i = i + 1usize; }
  i
}

// The picture taken at frame 'f', or an empty name
pub fn galleryShotAt(plan &GalleryPlan, f u64) String {
  if !plan.on() { return String.empty(); }
  let i = galleryIndex(plan, f);
  if f == galleryStart(plan, i) + u64.from(plan.shots[i].settle) { return plan.shots[i].name.copy(); }
  String.empty()
}

// The eye and the way it looks for the shot of frame 'f'
pub fn galleryView(st &SimState, f u64) Pose {
  let s = st.gallery.shots[galleryIndex(&st.gallery, f)];
  var eye = s.eye;
  if s.eyeAgl { eye = new Vec3(eye.x, groundHeight(&st.land, eye.x, eye.z) + eye.y, eye.z); }
  if s.byAngles { return Pose.look(eye, s.yaw, s.pitch); }
  var at = s.target;
  if s.targetAgl { at = new Vec3(at.x, groundHeight(&st.land, at.x, at.z) + at.y, at.z); }
  lookFrom(eye, at)
}

pub fn galleryFov(plan &GalleryPlan, f u64) f32 { plan.shots[galleryIndex(plan, f)].fov }

// The size the frame is drawn at
pub fn gallerySize(plan &GalleryPlan, f u64, w &mut u32, h &mut u32) {
  let s = plan.shots[galleryIndex(plan, f)];
  *w = s.width;
  *h = s.height;
}

// The people of the shot in hand taken away
fn galleryClear(st &mut SimState) {
  var k = 0usize;
  while k < st.gallery.spawned.len() {
    let being = &mut st.cast.beings[st.gallery.spawned[k].being];
    if !being.gone {
      being.gone = true;
      st.scene.forget(being.part);
      st.scene.send(Request.Despawn(being.part));
    }
    k = k + 1usize;
  }
  st.gallery.spawned.clear();
}

// The people of shot 'i' made and set down: each a being of the cast, put where it is to be at the picture (a walker or a runner back
// along its way by what it covers while the shot settles, a sitter on the seat nearest the place it is put)
fn gallerySpawn(st &mut SimState, i usize) {
  let shot = st.gallery.shots[i].copy();
  print <- "Gallery: shot "; printStr(shot.name.view()); print <- ": "; print <- shot.people.len(); print <- " people; the world has "; print <- st.cast.phys.seats.len(); print <- " seats\n";
  var k = 0usize;
  while k < shot.people.len() {
    var p = *shot.people[k];
    let covered = if p.state == GP_WALK { WALK_SPEED } elif p.state == GP_RUN { RUN_SPEED } else { 0. };
    // (it speeds up over the first second or so: the distance of the rest of the time)
    let dist = covered * (f32.from(shot.settle) - 14.) / 60.;
    let fx = 0. - sin(p.yaw);
    let fz = 0. - cos(p.yaw);
    let from = new Vec2(p.at.x - fx * dist, p.at.y - fz * dist);
    // (a floor's height the shot gives: metres over the island's ground there, or, under it, the world's own: the labyrinth's -300)
    let base = if p.hasY and p.y < -100. { new Vec3(from.x, p.y, from.y) }
      elif p.hasY { new Vec3(from.x, groundHeight(&st.land, from.x, from.y) + p.y, from.y) } else { standing(&st.land, from.x, from.y) };
    // (persons 7 and 8 are the labyrinth's guards, in their kit: the west guard in blue, the east in red)
    let idx = if p.person >= PERSON_GUARD_W {
      st.addCreatureBeing("gallery guard", "Guard", if p.person == PERSON_GUARD_W { CL_GUARD_W } else { CL_GUARD_E }, base, p.yaw, 1.8,
        100u32 + u32.from(k), new Color(0.2, 0.07, 0.035, 1.))
    } else {
      st.addMannequin("gallery person", base, p.yaw, p.person, 100u32 + u32.from(k))
    };
    st.cast.beings[idx].ai = true;
    p.being = idx;
    p.born = st.tick;
    st.gallery.spawned.push(p);
    k = k + 1usize;
  }
  while st.given.len() < st.cast.beings.len() { st.given.push(Intents.none()); st.stepIt.push(true); }
}

// The intents of the gallery's walkers and runners, each step (the others stand)
pub fn galleryIntents(st &mut SimState) {
  var k = 0usize;
  while k < st.gallery.spawned.len() {
    let p = st.gallery.spawned[k];
    if p.being < st.given.len() {
      let age = st.tick - p.born;
      var it = if p.state == GP_WALK or p.state == GP_RUN { new Intents(1., 0., p.state == GP_RUN, false) } else { Intents.none() };
      // (S pressed for a moment once it has settled; H pressed a second in, its wave in full at the picture)
      if p.state == GP_SIT { it.sit = age >= 10u64 and age < 13u64; }
      if p.state == GP_HAIL { it.hail = age >= 40u64 and age < 43u64; }
      st.given.set(p.being, it);
    }
    k = k + 1usize;
  }
}

// The scene's requests of the gallery run, after frame 'f' is presented: at the frame before a window begins, the day clock is
// set to the shot's hour (a closed form: the sky, the clouds, the smoke and the water all follow) and the weather settled on
// its state; at the first, the mannequins that stand on the lawn are taken away (a shot is of the island)
pub fn galleryDrive(st &mut SimState, f u64) {
  let n = st.gallery.shots.len();
  if n == 0usize { return; }
  if f == 1u64 {
    var b = 1usize;
    while b < st.cast.beings.len() {
      let being = &mut st.cast.beings[b];
      if !being.gone {
        being.gone = true;
        st.scene.forget(being.part);
        st.scene.send(Request.Despawn(being.part));
      }
      b = b + 1usize;
    }
  }
  var i = 0usize;
  while i < n {
    let begin = galleryStart(&st.gallery, i);
    if f + 1u64 == begin {
      // The people of the shot before go; this shot's come (they have the shot's settling frames to arrive and settle)
      galleryClear(st);
      gallerySpawn(st, i);
    }
    if f + 1u64 == begin or (i == 0usize and f == 1u64) {
      let s = st.gallery.shots[i];
      // 60 s of scene time an hour, from the clock's start hour, 7
      var away = s.hour - 7d;
      if away < 0d { away = away + 24d; }
      let seconds = (away + 24d * f64.from(GALLERY_DAY0 + u64.from(s.day))) * 60d;
      st.scene.clock.ns = u64.from(nanosOf(seconds));
      st.weather.setNow(s.weather);
    }
    i = i + 1usize;
  }
}

// ---- the pictures ----

// A number to two places, for the camera G prints
pub fn round2(v f32) f32 { libc.floorf(v * 100. + 0.5) / 100. }

// A frame read back from the GPU ('texels': 4 bytes each, rows from the top, blue first if 'bgra'; sRGB-coded as the swapchain
// holds it) saved as a PNG at 'path'; false if it could not be written
pub fn writePng(texels *u8, width i32, height i32, bgra bool, path &str) bool {
  let n = usize.from(width) * usize.from(height);
  var samples = List[u16].withCapacity(n * 3usize);
  var p = 0usize;
  while p < n {
    let t = texels + p * 4usize;
    if bgra {
      samples.push(u16.from(*(t + 2usize)));
      samples.push(u16.from(*(t + 1usize)));
      samples.push(u16.from(*t));
    } else {
      samples.push(u16.from(*t));
      samples.push(u16.from(*(t + 1usize)));
      samples.push(u16.from(*(t + 2usize)));
    }
    p = p + 1usize;
  }
  var o = PngWrite.make(2u8, 8u8);
  o.srgb = true;
  o.level = 1;
  let bytes = encodePngSamples(width, height, samples.view(), &o);
  let v = bytes.view();
  var cpath = String.from(path);
  let f = libc.fopen(cpath.cstr(), "wb");
  if !f { return false; }
  let written = libc.fwrite(&v[0] as *u8, 1usize, v.len, f);
  libc.fclose(f);
  written == v.len
}
