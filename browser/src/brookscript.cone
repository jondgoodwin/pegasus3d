// The brook's part of the scripted run, last of all (after the assembly's walk, balloon rides and night):
// the day clock is set to noon and the brook and its bridge are looked at, a window of ten frames each
// (the clock set at the first window's first frame, each picture saved at its fifth). Every eye and
// target is worked out from the brook's course and the bridge's numbers, so the views follow them.
//
//   window  what is looked at
//     0     the bridge from the lawn route, at the walker's eye, coming up from the south
//     1     the brook running across the back yard, from the bridge's crest, looking west along it
//     2     the brook from the lawn, three-quarter, the yard's bank and the lip stones
//     3     the dingle's cascade, from the walker's height on the bank above it, looking down it
//     4     the brook's mouth on the beach, from the sea's edge
//     5     the whole yard from above: the cottage, the bridge, the brook and the balloon's field
//     6     the bridge and the brook at dusk (the sun low: its sparkle and the stream's dark thread)

pub const BROOK_FROM = ASM_FROM + ASM_FRAMES;
pub const BROOK_WINDOW = 10u64;
pub const BROOK_WINDOWS = 7u64;

// The frames the whole scripted run needs: the weather's part (weatherscript.cone) follows the brook's, and the ragdoll's
// (physscript.cone) the weather's, the HUD's (hudscript.cone) the ragdoll's, the villagers' (npcscript.cone) the HUD's, the roaming
// views' (fencescript.cone) the villagers', the playground's (playscript.cone) the roaming views', and the mirror's
// (mirrorscript.cone) the playground's
pub const SCRIPT_FRAMES = MIRROR_FROM_FULL + MIRROR_FRAMES;

fn brookWindow(f u64) u64 { (f - BROOK_FROM) / BROOK_WINDOW; }

pub fn brookShotAt(f u64) &str {
  if f < BROOK_FROM or f >= BROOK_FROM + BROOK_WINDOW * BROOK_WINDOWS { return ""; }
  // (the cascade's window has a second picture, close on the steps, at its last frame)
  if brookWindow(f) == 3u64 and (f - BROOK_FROM) % BROOK_WINDOW == 9u64 { return "brook-steps"; }
  if (f - BROOK_FROM) % BROOK_WINDOW != 4u64 { return ""; }
  imm w = brookWindow(f);
  if w == 0u64 { return "brook-bridge"; }
  if w == 1u64 { return "brook-yard"; }
  if w == 2u64 { return "brook-arch"; }
  if w == 3u64 { return "brook-dingle"; }
  if w == 4u64 { return "brook-mouth"; }
  if w == 5u64 { return "brook-above"; }
  "brook-dusk";
}

// The clock: noon at the first frame, and a low evening sun for the last window
pub fn brookDrive(st &mut SimState, f u64) {
  if f == BROOK_FROM { st.scene.clock.ns = u64.from(nanosOf(f64.from(12. - 7.) * 60d)); }
  if f == BROOK_FROM + 6u64 * BROOK_WINDOW { st.scene.clock.ns = u64.from(nanosOf(f64.from(17.3 - 7.) * 60d)); }
}

// The course's point at 'metres' from the spring: (x, water level, z)
fn brookAt(isl &Island, metres f32) Vec3 {
  imm pts = brookPoints(isl);
  mut k = 0usize;
  while k + 2usize < pts.len() and pts[k + 1usize].s < metres { k = k + 1usize; }
  imm p = pts[k];
  imm q = pts[k + 1usize];
  imm t = (metres - p.s) / (q.s - p.s + 0.0001);
  new Vec3(p.x + (q.x - p.x) * t, p.w + (q.w - p.w) * t, p.z + (q.z - p.z) * t);
}

// The course's s where its control point 'ctl' begins
fn brookControlS(isl &Island, ctl usize) f32 {
  imm pts = brookPoints(isl);
  mut k = 0usize;
  while k + 1usize < pts.len() and pts[k].ctl < ctl { k = k + 1usize; }
  pts[k].s;
}

pub fn brookView(isl &Island, f u64) Pose {
  imm w = brookWindow(f);
  imm bank = bridgeBank(isl);
  if w == 0u64 {
    // On the lawn route, 8 m short of the bridge, at 1.7 m, a little to its east, looking at the road's crest
    // (a little to its east, so the arch's face is seen)
    return lookFrom(world3(isl, BRIDGE_X + 3.6, 1.7, BRIDGE_Z + 7.5), new Vec3(BRIDGE_X, bank + 0.45, BRIDGE_Z));
  }
  if w == 1u64 {
    // From the crest at the eye's height, down the brook to the west across the yard
    return lookFrom(new Vec3(BRIDGE_X + 0.4, bank + 0.58 + 1.7, BRIDGE_Z + 0.2), new Vec3(BRIDGE_X - 30., bank - 0.4, BRIDGE_Z - 0.5));
  }
  if w == 2u64 {
    // The arch from the south-west bank at the walker's eye, three-quarter, 7 m off: the brook passing under it
    return lookFrom(world3(isl, BRIDGE_X - 5., 1.7, BRIDGE_Z + 5.), new Vec3(BRIDGE_X, bank + 0.2, BRIDGE_Z));
  }
  if w == 3u64 {
    // The cascade: from 8 m upstream of the fourth step, a metre over the lip, looking down its flight
    imm s = brookControlS(isl, 21usize);
    imm eye = brookAt(isl, s - 7.);
    imm at = brookAt(isl, s + 8.);
    if (f - BROOK_FROM) % BROOK_WINDOW >= 6u64 {
      // Close on the steps: 2 m upstream of the fourth control's lip, a step to the side, at a standing child's height
      imm lip = brookAt(isl, s + 1.);
      imm below = brookAt(isl, s + 6.);
      return lookFrom(new Vec3(lip.x + 2.2, groundHeight(isl, lip.x + 2.2, lip.z) + 1.1, lip.z - 3.2), new Vec3(below.x, below.y + 0.1, below.z));
    }
    return lookFrom(new Vec3(eye.x + 1.6, groundHeight(isl, eye.x + 1.6, eye.z) + 1.7, eye.z), new Vec3(at.x, at.y + 0.1, at.z));
  }
  if w == 4u64 {
    // The mouth: from the sand 7 m up the beach and to the east, at the walker's eye, looking at where the water meets the sea
    imm end = brookAt(isl, brookLength(isl) - 2.);
    return lookFrom(world3(isl, end.x + 5., 1.7, end.z - 7.), new Vec3(end.x - 1., end.y, end.z + 3.));
  }
  if w == 5u64 {
    // The yard from 40 m up, a little south of the cottage, looking north-west over the bridge
    return lookFrom(world3(isl, BRIDGE_X + 22., 36., BRIDGE_Z + 34.), new Vec3(BRIDGE_X - 8., bank, BRIDGE_Z - 2.));
  }
  // Dusk: the bridge from the lawn again, lower
  lookFrom(world3(isl, BRIDGE_X + 1.6, 1.4, BRIDGE_Z + 7.), new Vec3(BRIDGE_X - 1., bank + 0.3, BRIDGE_Z));
}

pub fn brookFov(f u64) f32 { FOV; }
