// The people's headless checks (part of 'browser.exe --checks'): sitting down on a seat of the world and standing up (the S key's
// Intents.sit), a hail (the H key's), the file a person is kept in (personasset.cone's codec, on a person made by hand), and the
// rocking of a seat. They use the humanoid's skeleton as a mannequin has it (the people themselves are made from humanbody's blend sets, 16 s
// each, and kept in files: they are not part of the checks), so the state machine is the one every person has.

// A being 'name' standing at 'at' facing -z, in the cast 'c'
fn pcBeing(c: &mut Cast, s: &mut Scene, name: &str, at: Vec3) usize {
  c.add(mannequinBeing(s, name, at, 1.8, 7u32))
}

// 'n' steps of the cast, the being 'who' given 'it', the others nothing
fn pcRun(c: &mut Cast, who: usize, it: Intents, n: i32) {
  var k = 0;
  while k < n {
    var given = List[Intents].empty();
    var stepIt = List[bool].empty();
    var b = 0usize;
    while b < c.beings.len() {
      given.push(if b == who { it } else { Intents.none() });
      stepIt.push(true);
      b = b + 1usize;
    }
    c.stepEach(&given, &stepIt, 1. / 60., false);
    k = k + 1;
  }
}

fn pcPress(sit: bool, hail: bool) Intents {
  var it = Intents(0., 0., false, false);
  it.sit = sit;
  it.hail = hail;
  it
}

// Whether the pose has the hand above the shoulder (the hail's arm up)
fn pcHandUp(f: &Figure) bool {
  if f.models.len() < 19usize { return false; }
  (*f.models[bonepose.HAND_R]).translation.y > (*f.models[bonepose.UPPER_ARM_R]).translation.y + 0.05
}

// Whether the bytes are a person
fn pcReads(b: &List[u8]) bool {
  match decodePerson(b.view()) {
    case let Some(p) { return true; }
    else {}
  }
  false
}

// A person made by hand (one triangle of a body, a face target, a piece of clothing), for the codec
fn pcPerson() PersonAsset {
  var body = Mesh.empty();
  body.positions.push(Vec3(0., 0., 0.));
  body.positions.push(Vec3(1., 0., 0.));
  body.positions.push(Vec3(0., 1., 0.));
  body.normals.push(Vec3(0., 0., 1.));
  body.normals.push(Vec3(0., 0., 1.));
  body.normals.push(Vec3(0., 0., 1.));
  body.uvs.push(Vec2(0., 0.));
  body.uvs.push(Vec2(1., 0.));
  body.uvs.push(Vec2(0., 1.));
  body.indices.push(0u32);
  body.indices.push(1u32);
  body.indices.push(2u32);
  var skin = Skin.empty();
  skin.push(1u32, 2u32, 0u32, 0u32, 0.6, 0.4, 0., 0.);
  skin.push(3u32, 3u32, 3u32, 3u32, 1., 0., 0., 0.);
  skin.push(21u32, 20u32, 0u32, 0u32, 0.5, 0.5, 0., 0.);
  var morph = MorphTargets.empty(3usize);
  var idx = List[u32].empty();
  idx.push(1u32);
  idx.push(2u32);
  var dp = List[Vec3].empty();
  dp.push(Vec3(0.01, 0.02, 0.03));
  dp.push(Vec3(-0.01, 0., 0.5));
  morph.addSparse(&idx, &dp, &List[Vec3].empty(), &List[Vec3].empty());
  var spec = facerig.FaceSpec.empty();
  spec.add("eyeCenterL", Vec3(-0.03, 0.01, 0.1));
  spec.add("eyeCenterR", Vec3(0.03, 0.01, 0.1));
  var unitTarget = List[i32].empty();
  unitTarget.push(0i32);
  unitTarget.push(-1i32);
  var pieces = List[PieceAsset].empty();
  var shirt = Mesh.empty();
  shirt.positions.push(Vec3(0.5, 0.5, 0.5));
  shirt.positions.push(Vec3(0.6, 0.5, 0.5));
  shirt.positions.push(Vec3(0.5, 0.6, 0.5));
  shirt.indices.push(0u32);
  shirt.indices.push(1u32);
  shirt.indices.push(2u32);
  var shirtSkin = Skin.empty();
  shirtSkin.push(1u32, 0u32, 0u32, 0u32, 1., 0., 0., 0.);
  shirtSkin.push(1u32, 0u32, 0u32, 0u32, 1., 0., 0., 0.);
  shirtSkin.push(1u32, 0u32, 0u32, 0u32, 1., 0., 0., 0.);
  pieces.push(PieceAsset(String.from("shirt"), shirt, shirtSkin, Vec3(96., 24., 32.), 1u32));
  var pixels = List[u8].empty();
  var p = 0;
  while p < 16 { pixels.push(u8.from(p * 16)); p = p + 1; }
  PersonAsset(3u32, String.from("a person by hand"), 1u32, 1.7, 0.055, bonepose.humanoid(1.7), body, skin, morph, spec, unitTarget, 2usize,
    19u32, 20u32, 21u32, 22u32, Vec3(0.01, -1.6, 0.), SkinnedAsset.empty(), SkinnedAsset.empty(), SkinnedAsset.empty(), SkinnedAsset.empty(),
    SkinnedAsset.empty(), pieces, SkinnedAsset.empty(), Image(2, 2, 4, pixels), Image(2, 2, 4, List[u8].empty()), Vec3(66., 44., 30.))
}

pub fn checkPeople() bool {
  print <- "The people (sitting, hailing, their files):\n";
  var ok = true;
  // ---- a seat: a chair 3 m ahead (-z), facing -z, its seat 0.45 m up
  var s = Scene.empty();
  var c = Cast.empty(Island.empty());
  c.phys.ensureGround();
  c.phys.addSeat(PartId.none(), Vec3(0., 0.45, -3.), 0., 0.45, 0., 1., Transform3.identity());
  let a = pcBeing(&mut c, &mut s, "sitter", Vec3(0., 0., -1.5));
  let b = pcBeing(&mut c, &mut s, "second", Vec3(0.5, 0., -1.2));
  let far = pcBeing(&mut c, &mut s, "far", Vec3(0., 0., 6.));
  // S pressed (the key down for three steps, then up) far from any seat does nothing
  pcRun(&mut c, far, pcPress(true, false), 3);
  pcRun(&mut c, far, pcPress(false, false), 120);
  ok = expect("S far from a seat (6 m past it, beyond 2.8 m) does nothing: it stands, no seat", c.beings[far].figure.seat < 0i32
    && c.beings[far].figure.mode == FIG_WALK) && ok;
  // S near it sends the being to the place before the seat (a thigh's length ahead of the sitting bones), turns it to the seat's way and sits it down
  pcRun(&mut c, a, pcPress(true, false), 3);
  ok = expect("S near a seat chooses it: the being goes to it (its sit's phase is the approach)",
    c.beings[a].figure.seat == 0i32 && c.beings[a].figure.sitPhase == SIT_APPROACH) && ok;
  // (another being pressing S for the same seat while it is taken gets none)
  pcRun(&mut c, b, pcPress(true, false), 3);
  ok = expect("a seat that is taken is not another's: the second being, pressing S for it, gets none", c.beings[b].figure.seat < 0i32) && ok;
  pcRun(&mut c, a, pcPress(false, false), 420);
  let fa = &c.beings[a].figure;
  let feet = humanbody.seatFeet(&c.phys.seats[0usize].seat, &fa.skeleton);
  ok = expect("it walks to the place before the seat and sits: seated, the figure's mode FIG_SIT", fa.mode == FIG_SIT && fa.sitPhase == SIT_SEATED && fa.sitT >= 1.) && ok;
  ok = expect("its feet stand where the seat says (seatFeet: a thigh's length ahead of the sit point), facing the seat's way",
    (c.beings[a].body.position - feet).length() < 0.02 && libc.fabsf(c.beings[a].body.yaw) < 0.01) && ok;
  // The pose: the pelvis on the seat's height (plus the bones' half-thickness), the feet on the floor, the knees forward
  let pelvisY = (*fa.models[bonepose.PELVIS]).translation.y;
  let ankleY = (*fa.models[bonepose.FOOT_L]).translation.y;
  ok = expect("seated, the pelvis is at the seat's height, 0.45 m, and a little over it (0.45 to 0.57)", pelvisY > 0.45 && pelvisY < 0.57) && ok;
  ok = expect("and the ankle is on the floor, under 0.15 m up", ankleY < 0.15) && ok;
  print <- "  (seated: pelvis "; print <- pelvisY; print <- " m up, ankle "; print <- ankleY; print <- " m; the feet's place "; print <- feet.x; print <- ", "; print <- feet.z; print <- ")\n";
  // S again stands it up (the same path the other way), and it is free to walk
  pcRun(&mut c, a, pcPress(true, false), 3);
  pcRun(&mut c, a, pcPress(false, false), 150);
  ok = expect("S again stands it up: walking mode again, no seat, where it sat", c.beings[a].figure.mode == FIG_WALK && c.beings[a].figure.seat < 0i32
    && (c.beings[a].body.position - feet).length() < 0.1) && ok;
  // The seat is free again
  pcRun(&mut c, b, pcPress(true, false), 3);
  ok = expect("the seat is free once it has stood up: the second being can have it", c.beings[b].figure.seat == 0i32) && ok;
  // A jump cancels the walk to a seat
  var c2 = Cast.empty(Island.empty());
  c2.phys.ensureGround();
  c2.phys.addSeat(PartId.none(), Vec3(0., 0.45, -3.), 0., 0.45, 0., 1., Transform3.identity());
  let j = pcBeing(&mut c2, &mut s, "jumper", Vec3(0., 0., -1.5));
  pcRun(&mut c2, j, pcPress(true, false), 3);
  let chose = c2.beings[j].figure.sitPhase == SIT_APPROACH;
  var jump = Intents(0., 0., false, true);
  pcRun(&mut c2, j, jump, 2);
  ok = expect("a jump on the way gives the seat up", chose && c2.beings[j].figure.sitPhase == SIT_NONE && c2.beings[j].figure.seat < 0i32) && ok;
  // ---- the hail
  var c3 = Cast.empty(Island.empty());
  c3.phys.ensureGround();
  let h = pcBeing(&mut c3, &mut s, "hailer", Vec3(0., 0., 0.));
  pcRun(&mut c3, h, pcPress(false, true), 3);
  pcRun(&mut c3, h, pcPress(false, false), 57);
  ok = expect("H hails: it begins and, a second on, the right hand is above the shoulder (the arm up)", c3.beings[h].figure.hailT > 0.9 && pcHandUp(&c3.beings[h].figure)) && ok;
  pcRun(&mut c3, h, pcPress(false, false), 150);
  ok = expect("and it is over after HAIL_SECONDS (3 s): no hail, the arm down", c3.beings[h].figure.hailT < 0. && !pcHandUp(&c3.beings[h].figure)) && ok;
  // a hail while walking: the arm is up while it walks
  pcRun(&mut c3, h, pcPress(false, true), 3);
  var walkHail = Intents(1., 0., false, false);
  walkHail.hail = false;
  pcRun(&mut c3, h, walkHail, 60);
  ok = expect("a hail while walking: it walks on (moved) with the arm up", c3.beings[h].body.position.z < -0.5 && pcHandUp(&c3.beings[h].figure)) && ok;
  // ---- the rocking seat's file: the seat's own numbers
  c.phys.addSeat(PartId.none(), Vec3(1., 0.45, 1.), 3.1415927, 0.45, 0.09, 3.2, Transform3.identity());
  ok = expect("a rocking seat has its rock (0.09 rad) and period (3.2 s)", c.phys.seats.len() == 2usize && c.phys.seats[1usize].seat.rock == 0.09
    && c.phys.seats[1usize].seat.period == 3.2) && ok;
  // ---- a person's file
  let want = pcPerson();
  let bytes = encodePerson(&want);
  match decodePerson(bytes.view()) {
    case let Some(got) {
      var same = got.index == 3u32 && got.name.view() == "a person by hand" && got.sex == 1u32 && got.height == 1.7 && got.hipSpan == 0.055;
      same = same && got.skeleton.boneCount() == want.skeleton.boneCount() && got.skeleton.sockets.len() == want.skeleton.sockets.len();
      same = same && got.body.positions.len() == 3usize && got.body.positions[1usize].x == 1. && got.body.uvs[2usize].y == 1. && got.body.indices.len() == 3usize;
      same = same && got.bodySkin.joints.len() == 3usize && *got.bodySkin.joints[2usize] == *want.bodySkin.joints[2usize]
        && *got.bodySkin.weights[0usize] == *want.bodySkin.weights[0usize];
      same = same && got.morph.count() == 1usize && got.morph.entryCount() == 2usize && got.morph.dPos[1usize].z == 0.5;
      same = same && got.spec.names.len() == 2usize && got.spec.names[1usize].view() == "eyeCenterR" && got.spec.point("eyeCenterL").x == -0.03;
      same = same && got.unitTarget.len() == 2usize && *got.unitTarget[1usize] == -1i32 && got.targetCount == 2usize;
      same = same && got.faceHead == 19u32 && got.faceEyeR == 22u32 && got.faceOrigin.y == -1.6;
      same = same && got.pieces.len() == 1usize && got.pieces[0usize].name.view() == "shirt" && got.pieces[0usize].kind == 1u32
        && got.pieces[0usize].color.x == 96. && got.pieces[0usize].mesh.positions.len() == 3usize;
      same = same && got.albedo.width == 2 && got.albedo.pixels.len() == 16usize && *got.albedo.pixels[5usize] == 80u8 && got.rough.pixels.len() == 0usize;
      same = same && !got.hasCape() && got.iris.z == 30.;
      ok = expect("a person kept as bytes and read back is the same (the body, skin, face targets and spec, bones, clothes, images)", same) && ok;
      // a byte lost, or one added, is no person
      var shorter = List[u8].empty();
      var q = 0usize;
      while q + 1usize < bytes.len() { shorter.push(*bytes[q]); q = q + 1usize; }
      ok = expect("one byte short is no person", !pcReads(&shorter)) && ok;
      var longer = List[u8].empty();
      q = 0usize;
      while q < bytes.len() { longer.push(*bytes[q]); q = q + 1usize; }
      longer.push(0u8);
      ok = expect("and one byte more is none either", !pcReads(&longer)) && ok;
    }
    else { ok = expect("a person kept as bytes is read back", false) && ok; }
  }
  // the file's name follows the person (and the revision), the guards' variants have names of their own
  ok = expect("a person's file is named for its number and name (and the humanbody revision it came from)",
    personFileName(3u32, "a").view() != personFileName(4u32, "a").view() && personFileName(3u32, "a").view() != personFileName(3u32, "b").view()
    && personFileName(3u32, "a").view() == personFileName(3u32, "a").view()) && ok;
  ok
}
