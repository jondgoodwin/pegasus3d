// What the browser itself puts in every scene before any world arrives: the
// ground and the sky. Each goes in as requests through the scene's inbox,
// exactly as a world's parts do, so neither is special to the renderer.
// (Step 1's post at the origin is gone: the baked-in world's objects show
// the walk well enough.)
//
// Units are metres, y up, the ground at y = 0.

// The ground's half-width, in metres: it is drawn this far each way from
// the viewer (in steps of GROUND_PERIOD), past the far plane, so its edge
// is never seen
pub const GROUND_HALF f32 = 2000.;

// The checkerboard's squares, in metres; a light and a dark square side by
// side are one period, the step the ground moves in to follow the viewer
pub const GROUND_SQUARE f32 = 2.;
pub const GROUND_PERIOD f32 = 4.;

// sRGB brown (139, 90, 43) and sky blue (135, 206, 235), as linear colours
pub fn groundBrown() Color { new Color(0.258, 0.102, 0.024, 1.); }
pub fn skyBlue() Color { new Color(0.242, 0.617, 0.831, 1.); }

// The sky seen by day, a radiance in nits (about 25 000): what AgX shows as
// that sky blue at the noon exposure (look.cone). AgX desaturates bright
// colours, so the radiance is bluer than the colour it shows.
pub fn skyRadiance() Color { new Color(500., 28000., 72000., 1.); }

// The parts the shell made
pub struct ShellParts {
  pub ground PartId;
  pub sky PartId;
}

// The parts the shell makes: the ground and the sky, and the user's own
// being (the walker the browser starts in, made by 'start')
pub const SHELL_PARTS = 3usize;

// Send the shell's parts into 'scene'
pub fn seedScene(scene &mut Scene) ShellParts {
  // The ground: a square 2 * GROUND_HALF across, its checkerboard repeating
  // every GROUND_PERIOD, anchored under the viewer
  imm ground = scene.newPart("ground");
  imm plane = scene.door.defineMesh(Mesh.plane(8, 2. * GROUND_HALF / GROUND_PERIOD));
  imm brown = scene.door.defineMaterial(Look.checkered(groundBrown(), 0.85), Image.empty(), Maps.none());
  scene.send(Request.Place[ground, new Transform3(new Vec3(0., 0., 0.), Quat.identity(),
    new Vec3(GROUND_HALF, 1., GROUND_HALF))]);
  scene.send(Request.Show[ground, plane, brown, GROUND_PERIOD]);

  // The sky: sky blue, a sun high in the south-west
  imm sky = scene.newPart("sky");
  imm sun = new Vec3(-0.4, 0.8, 0.45).normalize();
  // In physical units (look.cone): the sun's irradiance 100 000 lux, a
  // little warm; the sky seen, a clear sky's radiance in nits, sky blue
  // (about 25 000 nits); the ambient light, the even sky's radiance lighting
  // what the sun does not, bluish (a horizontal surface about 34 000 lux)
  scene.send(Request.Sky[sky, new SkyLook(skyRadiance(), sun, new Color(100000., 96500., 88200., 1.),
    new Color(10000., 10800., 12800., 1.))]);

  new ShellParts(ground, sky);
}
