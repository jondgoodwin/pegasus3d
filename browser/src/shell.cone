// What the browser itself puts in every scene before any world arrives: the
// land and the sea (the island, src/island/island.cone, drawn by terrain.slang
// and water.slang), and the sky. Each goes in as requests through the scene's
// inbox, exactly as a world's parts do, so none is special to the renderer.
//
// Units are metres, y up, sea level y = 0.

// The sky seen by day, a radiance in nits (about 25 000): what AgX shows as
// that sky blue at the noon exposure (look.cone). AgX desaturates bright
// colours, so the radiance is bluer than the colour it shows.
pub fn skyRadiance() Color { new Color(500., 28000., 72000., 1.); }
pub fn skyBlue() Color { new Color(0.242, 0.617, 0.831, 1.); }

// The parts the shell made
pub struct ShellParts {
  pub ground PartId;          // the fine mesh of the island's land
  pub coarse PartId;          // its coarse mesh, beyond the fine one
  pub water PartId;
  pub sky PartId;
}

// The parts the shell makes: the land (two meshes) and the sea, the sky, and
// the user's own being (the walker the browser starts in, made by 'start')
pub const SHELL_PARTS = 5usize;

// The height field the island's shaders read: the island's heights, one f32 a sample
fn islandField() Field { new Field(u32.from(N), u32.from(N), heightGrid()); }

// Send the shell's parts into 'scene'. The island must be baked (bakeIsland)
pub fn seedScene(scene &mut Scene) ShellParts {
  // The land: one terrain material (the heights, and the mask painted over
  // them), the fine mesh and the coarse one. 'anchor' -1: placed where it is
  // and not pickable (its meshes are flat; the shader lifts them)
  imm ground = scene.newPart("ground");
  imm coarse = scene.newPart("ground, beyond");
  imm fineId = scene.door.defineMesh(fineMesh());
  imm coarseId = scene.door.defineMesh(coarseMesh());
  imm terrainMaps = new Maps(Image.empty(), Image.empty(), islandField(), new Field(u32.from(N), u32.from(N), pathGrid()));
  imm terrain = scene.door.defineMaterial(
    Look.shaded(SHADER_TERRAIN, [0. - HALF, 0. - HALF, CELL, 1., f32.from(FINE_I0), f32.from(FINE_J0), f32.from(FINE_I1),
      f32.from(FINE_J1)]),
    maskImage(), terrainMaps);
  scene.send(Request.Place[ground, Transform3.identity()]);
  scene.send(Request.Show[ground, fineId, terrain, -1.]);
  scene.send(Request.Place[coarse, Transform3.identity()]);
  scene.send(Request.Show[coarse, coarseId, terrain, -1.]);

  // The sea: a grid at sea level over the island's extent, and a ring out to the horizon
  imm water = scene.newPart("sea");
  imm waterId = scene.door.defineMesh(waterMesh());
  imm sea = scene.door.defineMaterial(
    Look.shaded(SHADER_WATER, [0. - HALF, 0. - HALF, CELL, 0., skyRadiance().red, skyRadiance().green,
      skyRadiance().blue, 0.]),
    Image.empty(), Maps.fielded(islandField()));
  scene.send(Request.Place[water, Transform3.identity()]);
  scene.send(Request.Show[water, waterId, sea, -1.]);

  // The sky: sky blue, a sun high in the south-west
  imm sky = scene.newPart("sky");
  imm sun = new Vec3(-0.4, 0.8, 0.45).normalize();
  // In physical units (look.cone): the sun's irradiance 100 000 lux, a
  // little warm; the sky seen, a clear sky's radiance in nits, sky blue
  // (about 25 000 nits); the ambient light, the even sky's radiance lighting
  // what the sun does not, bluish (a horizontal surface about 34 000 lux)
  scene.send(Request.Sky[sky, new SkyLook(skyRadiance(), sun, new Color(100000., 96500., 88200., 1.),
    new Color(10000., 10800., 12800., 1.))]);

  new ShellParts(ground, coarse, water, sky);
}
