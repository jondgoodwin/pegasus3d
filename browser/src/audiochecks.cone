// The sound's headless checks (part of 'browser.exe --checks'): no device and no GPU. The mixer is rendered offline
// (audioview.cone's null sink), so every number below is a measurement of the signal that would go to the speakers.
//
//   the surfaces under a foot: grass, stone, the porch's wood, the basket's, the bridge
//   the wind's strength follows the weather's numbers, and the rendered wind grows with it
//   the brook is louder at the bridge than far away, and louder over its bed stones
//   a burner to the right is heard on the right, only while the world's burst lasts
//   the mute key silences the mix and brings it back
//   the same frames render the same samples, bit for bit
//   a walking mannequin's feet come down as often as its stride says, and the bridge's steps are counted as the bridge's
//   a mixer render allocates nothing (the heap region counted, as audiomixer's own test counts it)
//   far from everything, almost no voice plays (voices out of range are not run)

// ---- helpers ----

// The mean power in dB of the offline mix from frame 'from' to 'to' (1: the left channel, 2: the right, 0: both)
fn auLevel(v: &AudioView, from: usize, to: usize, which: u32) f32 {
  var sum: f32 = 0.;
  var i = from;
  while i < to {
    let l = *v.record[i * 2usize];
    let r = *v.record[i * 2usize + 1usize];
    if which == 0u32 { sum = sum + l * l + r * r; }
    elif which == 1u32 { sum = sum + l * l; }
    else { sum = sum + r * r; }
    i = i + 1usize;
  }
  let n = f32.from(to - from) * (if which == 0u32 { 2. } else { 1. });
  4.3429448 * libc.logf(sum / n + 1.0e-12)
}

// The offline mix so far, in frames
fn auFrames(v: &AudioView) usize { v.record.len() / 2usize }

// A frame for the listener at 'eye' facing -z, with the wind at 'wind'
fn auFrame(eye: Vec3, wind: f32, now: f64) AudioFrame {
  var f = AudioFrame.empty();
  f.dt = 1. / 60.;
  f.now = now;
  f.eye = eye;
  f.wind = wind;
  f.aboveGround = 1.7;
  f
}

// 'n' frames of that, the listener standing still
fn auStand(isl: &Island, v: &mut AudioView, eye: Vec3, wind: f32, now: f64, n: usize) {
  var k = 0usize;
  while k < n {
    let f = auFrame(eye, wind, now);
    v.update(isl, &f);
    k = k + 1usize;
  }
}

// The quiet place: on the hill at the origin, far from the brook (the spring is 130 m off), the cottage and the balloon
fn auQuiet(isl: &Island) Vec3 { new Vec3(0., islandHeight(isl, 0., 0.) + 1.7, 0.) }

fn auFresh() AudioView { AudioView.offline(true, String.empty()) }

// ---- the checks ----

fn checkAudio(isl: &Island) bool {
  print <- "The sound:\n";
  var ok = true;
  ok = checkAudioSurfaces(isl) && ok;
  ok = checkAudioWind(isl) && ok;
  ok = checkAudioUnderground(isl) && ok;
  ok = checkAudioBrook(isl) && ok;
  ok = checkAudioBurner(isl) && ok;
  ok = checkAudioMute(isl) && ok;
  ok = checkAudioDeterminism(isl) && ok;
  ok = checkAudioSteps(isl) && ok;
  ok = checkAudioNoAllocation(isl) && ok;
  ok
}

fn checkAudioSurfaces(isl: &Island) bool {
  // The cottage's porch: its deck is 0.6 m up, 0.3 m right of the door and 0.8 m out from the wall
  let c = placeXZ(COTTAGE);
  let deckX = c.x + 0.3;
  let deckZ = c.y + 0.8;
  let deck = new Vec3(deckX, islandHeight(isl, deckX, deckZ) + 0.6, deckZ);
  var ok = expect("on the porch's deck a foot lands on wood", surfaceAt(isl, deck, false) == SURF_WOOD);
  ok = expect("on the basket (a platform) a foot lands on wood", surfaceAt(isl, new Vec3(0., 0., 0.), true) == SURF_WOOD) && ok;
  ok = expect("on the bridge's crest it lands on the bridge", surfaceAt(isl, new Vec3(BRIDGE_X, 1., BRIDGE_Z), false) == SURF_BRIDGE) && ok;
  ok = expect("and on its ramp, 3 m from the crest", surfaceAt(isl, new Vec3(BRIDGE_X + 0.4, 1., BRIDGE_Z + 3.), false) == SURF_BRIDGE) && ok;
  ok = expect("and 4.1 m out, on the lawn, it is grass", surfaceAt(isl, new Vec3(BRIDGE_X, 1., BRIDGE_Z + 4.1), false) == SURF_GRASS) && ok;
  let start = new Vec3(BEACH_X, islandHeight(isl, BEACH_X, BEACH_Z), BEACH_Z);
  ok = expect("on the landing beach it is grass", surfaceAt(isl, start, false) == SURF_GRASS) && ok;
  // A bed stone and an edging stone: found in the layout, and stood on
  let items = vegetationLayout(isl);
  var rock = false;
  var edging = false;
  var i = 0usize;
  while i < items.len() {
    let it = items[i];
    // (a rock beside the bridge or the cottage is the bridge's or the porch's surface first, so the first rock elsewhere)
    let byBridge = auAbs(it.x - BRIDGE_X) < 4. && auAbs(it.z - BRIDGE_Z) < 6.;
    let byCottage = (it.x - c.x) * (it.x - c.x) + (it.z - c.y) * (it.z - c.y) < 64.;
    if it.kind == K_ROCK && !rock && !byBridge && !byCottage {
      rock = surfaceAt(isl, new Vec3(it.x, it.y, it.z), false) == SURF_STONE;
    }
    if it.kind == K_EDGING && !edging && !byBridge && !byCottage { edging = surfaceAt(isl, new Vec3(it.x, it.y, it.z), false) == SURF_STONE; }
    i = i + 1usize;
  }
  ok = expect("a rock of the layout is stone underfoot", rock) && ok;
  ok = expect("an edging stone is stone underfoot", edging) && ok;
  ok
}

fn checkAudioWind(isl: &Island) bool {
  let clear = windStrength(&WeatherParams.state(WEATHER_CLEAR));
  let fair = windStrength(&WeatherParams.state(WEATHER_FAIR));
  let cloudy = windStrength(&WeatherParams.state(WEATHER_CLOUDY));
  let overcast = windStrength(&WeatherParams.state(WEATHER_OVERCAST));
  let rain = windStrength(&WeatherParams.state(WEATHER_RAIN));
  let snow = windStrength(&WeatherParams.state(WEATHER_SNOW));
  var ok = expect("the wind's strength rises clear < fair < cloudy < overcast < rain", clear < fair && fair < cloudy && cloudy < overcast && overcast < rain);
  ok = expect("snow falls stiller than rain", snow < rain) && ok;
  let half = WeatherParams.state(WEATHER_FAIR).blend(&WeatherParams.state(WEATHER_RAIN), 0.5);
  let mid = windStrength(&half);
  ok = expect("halfway through a change of weather the strength is halfway (it follows the weather's own crossfade)",
    mid > fair && mid < rain && nearly(mid, (fair + rain) * 0.5, 0.02)) && ok;
  ok = expect("it rises with height over the land, and stays within 0 to 1", windAtHeight(0.4, 0.) < windAtHeight(0.4, 100.) && windAtHeight(0.95, 500.) <= 1.) && ok;
  // The rendered wind, far from everything: the same listener under each weather
  var levels = List[f32].empty();
  var s = 0u32;
  while s < 5u32 {
    var v = auFresh();
    let w = windStrength(&WeatherParams.state(s));
    auStand(isl, &mut v, auQuiet(isl), w, 100., 240usize);
    levels.push(auLevel(&v, auFrames(&v) - 48000usize, auFrames(&v), 0u32));
    s = s + 1u32;
  }
  print <- "    (dB: clear "; print <- *levels[0usize]; print <- ", fair "; print <- *levels[1usize]; print <- ", cloudy "; print <- *levels[2usize];
  print <- ", overcast "; print <- *levels[3usize]; print <- ", rain "; print <- *levels[4usize]; print <- ")\n";
  ok = expect("the rendered wind grows louder with the weather, clear to rain",
    *levels[0usize] < *levels[1usize] && *levels[1usize] < *levels[2usize] && *levels[2usize] < *levels[3usize] && *levels[3usize] < *levels[4usize]) && ok;
  ok = expect("and rain is at least 9 dB louder than clear", *levels[4usize] - *levels[0usize] > 9.) && ok;
  ok
}

// Below the island (the labyrinth): the wind and the brook fade out (over about 1.5 s), a room tone fades in, the steps are stone
fn checkAudioUnderground(isl: &Island) bool {
  let rain = windStrength(&WeatherParams.state(WEATHER_RAIN));
  var over = auFresh();
  auStand(isl, &mut over, auQuiet(isl), rain, 100., 420usize);
  let overLevel = auLevel(&over, auFrames(&over) - 48000usize, auFrames(&over), 0u32);
  // Under the island, in the antechamber, the same rain above
  let below = new Vec3(0., LAB_Y + 1.7, 310.);
  var under = auFresh();
  auStand(isl, &mut under, below, rain, 100., 420usize);
  let underLevel = auLevel(&under, auFrames(&under) - 48000usize, auFrames(&under), 0u32);
  // ... and right under the brook's cascade, 300 m down: no water either
  let cascade = brookAtControl(isl, 22usize);
  var beneath = auFresh();
  auStand(isl, &mut beneath, new Vec3(cascade.x, LAB_Y + 1.7, cascade.z), rain, 100., 420usize);
  let beneathLevel = auLevel(&beneath, auFrames(&beneath) - 48000usize, auFrames(&beneath), 0u32);
  print <- "    (dB: the rain's wind over the island "; print <- overLevel; print <- ", in the antechamber "; print <- underLevel;
  print <- ", under the cascade "; print <- beneathLevel; print <- "; wind strength used "; print <- under.windNow; print <- ", shelter "; print <- under.shelter; print <- ")\n";
  var ok = expect("below the island the wind is shut out: its strength is 0 and the mix is at least 20 dB below the open air's", under.windNow < 0.001 && underLevel < overLevel - 20.);
  ok = expect("but there is a room tone: not silence (above -80 dB)", underLevel > -80.) && ok;
  ok = expect("under the brook's cascade there is no water: the mix is the room tone's, within 2 dB", auAbs(beneathLevel - underLevel) < 2.) && ok;
  // The way back up: the shelter lifts and the room tone ends, the wind comes back
  auStand(isl, &mut under, auQuiet(isl), rain, 100., 420usize);
  let backLevel = auLevel(&under, auFrames(&under) - 48000usize, auFrames(&under), 0u32);
  ok = expect("back on the island the wind is back within 7 s (the open air's level, within 3 dB) and the shelter is gone", under.shelter == 0. && auAbs(backLevel - overLevel) < 3.) && ok;
  ok = expect("a foot under the island comes down on stone", surfaceAt(isl, new Vec3(0., LAB_Y, 310.), false) == SURF_STONE) && ok;
  ok
}

fn checkAudioBrook(isl: &Island) bool {
  var v = auFresh();
  let atBridge = v.nearestCourse(isl, BRIDGE_X, BRIDGE_Z);
  var ok = expect("the course passes under the bridge (within 0.6 m of its middle)", atBridge.dist < 0.6);
  ok = expect("the water there is slow (the yard's 0.4 m/s, under 0.8)", atBridge.speed < 0.8) && ok;
  let cascade = v.nearestCourse(isl, brookAtControl(isl, 22usize).x, brookAtControl(isl, 22usize).z);
  ok = expect("and fast in the cascade (over 1 m/s)", cascade.speed > 1.) && ok;
  let quiet = auQuiet(isl);
  let farHit = v.nearestCourse(isl, quiet.x, quiet.z);
  ok = expect("the quiet place is more than 100 m from the brook", farHit.dist > 100.) && ok;
  // The same weather, the listener on the bridge's crest and at the quiet place
  let crest = new Vec3(BRIDGE_X, islandHeight(isl, BRIDGE_X, BRIDGE_Z) + 0.85 + 1.7, BRIDGE_Z);
  var near = auFresh();
  auStand(isl, &mut near, crest, 0.25, 100., 300usize);
  let nearDb = auLevel(&near, auFrames(&near) - 48000usize, auFrames(&near), 0u32);
  var far = auFresh();
  auStand(isl, &mut far, quiet, 0.25, 100., 300usize);
  let farDb = auLevel(&far, auFrames(&far) - 48000usize, auFrames(&far), 0u32);
  print <- "    (fair weather, dB: on the bridge "; print <- nearDb; print <- ", at the quiet place "; print <- farDb; print <- ")\n";
  ok = expect("the brook adds at least 6 dB on the bridge over the quiet place's wind alone", nearDb - farDb > 6.) && ok;
  // Along the yard: 30 m from the course against 2 m from it, away from the stones
  let yard = new Vec3(BRIDGE_X - 18., islandHeight(isl, BRIDGE_X - 18., BRIDGE_Z) + 1.7, BRIDGE_Z);
  let yardHit = near.nearestCourse(isl, yard.x, yard.z);
  ok = expect("the course runs west from the bridge through the yard (within 1.5 m at 18 m)", yardHit.dist < 1.5) && ok;
  // The brook is placed along its course, not at the bridge: 25 m west of the bridge, 1.5 m off the water, it is as loud as it is
  // beside the bridge's crest, and 30 m south of that place (nothing but the wind) it is not
  let along = new Vec3(BRIDGE_X - 25., islandHeight(isl, BRIDGE_X - 25., BRIDGE_Z - 1.5) + 1.7, BRIDGE_Z - 1.5);
  let alongHit = near.nearestCourse(isl, along.x, along.z);
  var va = auFresh();
  auStand(isl, &mut va, along, 0.25, 100., 300usize);
  let alongDb = auLevel(&va, auFrames(&va) - 48000usize, auFrames(&va), 0u32);
  let away = new Vec3(along.x, islandHeight(isl, along.x, along.z + 31.5) + 1.7, along.z + 31.5);
  var vw = auFresh();
  auStand(isl, &mut vw, away, 0.25, 100., 300usize);
  let awayDb = auLevel(&vw, auFrames(&vw) - 48000usize, auFrames(&vw), 0u32);
  print <- "    (25 m west of the bridge, "; print <- alongHit.dist; print <- " m from the course: "; print <- alongDb; print <- " dB; 30 m further from it: ";
  print <- awayDb; print <- " dB)\n";
  ok = expect("25 m along the yard the brook is still there: 6 dB over the same weather 30 m from it", alongDb - awayDb > 6.) && ok;
  ok = expect("and within 6 dB of its level on the bridge's crest (the water follows the listener along the course)", nearDb - alongDb < 6.) && ok;
  // A bed stone: found, and listened to from a metre off it, against a stretch of the course 12 m or more from every stone
  let stones = near.stonesOfBrook(isl);
  ok = expect("the brook has bed stones", stones.len() > 0usize) && ok;
  if stones.len() > 0usize {
    let s0 = *stones[0usize];
    let onStone = new Vec3(s0.x + 1., islandHeight(isl, s0.x + 1., s0.y) + 1.7, s0.y);
    var vs = auFresh();
    auStand(isl, &mut vs, onStone, 0.25, 100., 300usize);
    ok = expect("a bed stone has a voice while the listener stands by it", vs.stoneVoicesPlaying() >= 1usize) && ok;
    let stoneDb = auLevel(&vs, auFrames(&vs) - 48000usize, auFrames(&vs), 0u32);
    // The same place with the bed stones silenced: what they add
    var vp = auFresh();
    vp.setStones(false);
    auStand(isl, &mut vp, onStone, 0.25, 100., 300usize);
    let plainDb = auLevel(&vp, auFrames(&vp) - 48000usize, auFrames(&vp), 0u32);
    print <- "    (a metre from a bed stone, dB: with the stones "; print <- stoneDb; print <- ", without "; print <- plainDb;
    print <- "; stone voices "; print <- vs.stoneVoicesPlaying(); print <- " and "; print <- vp.stoneVoicesPlaying(); print <- ")\n";
    ok = expect("the bed stones make the water louder where they are (by at least 1.5 dB with the others of the course the same)",
      stoneDb - plainDb > 1.5 && vp.stoneVoicesPlaying() == 0usize) && ok;
  }
  ok
}

// The course where its control 'ctl' begins (x, water, z)
fn brookAtControl(isl: &Island, ctl: usize) Vec3 {
  let pts = brookPoints(isl);
  var k = 0usize;
  while k + 1usize < pts.len() && pts[k].ctl < ctl { k = k + 1usize; }
  new Vec3(pts[k].x, pts[k].w, pts[k].z)
}

fn checkAudioBurner(isl: &Island) bool {
  var v = auFresh();
  let burner = PartId.none();
  v.noteBurst(burner, 0.0, 3.0);
  let at = auQuiet(isl);
  let right = at + new Vec3(6., 0.5, 0.);
  // Frames: the listener faces -z, so +x is on its right. Lit at scene time 1 s.
  var k = 0usize;
  while k < 180usize {
    var f = auFrame(at, 0.25, 1.);
    f.burnerAt.push(right);
    v.update(isl, &f);
    k = k + 1usize;
  }
  let n = auFrames(&v);
  let l = auLevel(&v, n - 24000usize, n, 1u32);
  let r = auLevel(&v, n - 24000usize, n, 2u32);
  print <- "    (the burner 6 m to the right: left "; print <- l; print <- " dB, right "; print <- r; print <- " dB)\n";
  var ok = expect("a burner to the right is louder in the right ear (by at least 3 dB)", r - l > 3.);
  // The burst over: scene time 5 s, past its stop
  k = 0usize;
  while k < 240usize {
    var f = auFrame(at, 0.25, 5.);
    f.burnerAt.push(right);
    v.update(isl, &f);
    k = k + 1usize;
  }
  let m = auFrames(&v);
  let after = auLevel(&v, m - 24000usize, m, 0u32);
  let during = auLevel(&v, n - 24000usize, n, 0u32);
  print <- "    (while it burns "; print <- during; print <- " dB, after the burst "; print <- after; print <- " dB)\n";
  ok = expect("after the burst's end the burner is silent again (at least 9 dB down, back to the wind alone)", during - after > 9.) && ok;
  ok = expect("the burner is a voice only while it burns", v.voicesNow() <= 3usize) && ok;
  ok
}

fn checkAudioMute(isl: &Island) bool {
  var v = auFresh();
  let at = auQuiet(isl);
  auStand(isl, &mut v, at, 0.6, 100., 180usize);
  let n0 = auFrames(&v);
  let loud = auLevel(&v, n0 - 24000usize, n0, 0u32);
  audioToggleMute();
  auStand(isl, &mut v, at, 0.6, 100., 120usize);
  let n1 = auFrames(&v);
  let muted = auLevel(&v, n1 - 24000usize, n1, 0u32);
  audioToggleMute();
  auStand(isl, &mut v, at, 0.6, 100., 120usize);
  let n2 = auFrames(&v);
  let back = auLevel(&v, n2 - 24000usize, n2, 0u32);
  print <- "    (dB: "; print <- loud; print <- ", muted "; print <- muted; print <- ", unmuted "; print <- back; print <- ")\n";
  var ok = expect("the mute key silences the mix (below -100 dB after its 80 ms fade)", muted < -100.);
  ok = expect("a second press brings it back to within 1.5 dB", nearly(back, loud, 1.5)) && ok;
  ok = expect("and after the second press it reports itself unmuted", !v.isMuted()) && ok;
  ok
}

// A scripted walk of frames for the determinism and allocation checks: the listener goes north over the bridge from the lawn,
// the burner is lit now and then
fn auWalkFrames(isl: &Island, v: &mut AudioView, n: usize) {
  var k = 0usize;
  while k < n {
    let z = 330. - 0.03 * f32.from(k);
    var f = auFrame(new Vec3(BRIDGE_X, islandHeight(isl, BRIDGE_X, z) + 1.7, z), 0.3 + 0.0002 * f32.from(k), 10.0 + f64.from(k) / 60.0);
    f.burnerAt.push(new Vec3(-10., 3., 300.));
    v.update(isl, &f);
    k = k + 1usize;
  }
}

fn checkAudioDeterminism(isl: &Island) bool {
  var a = auFresh();
  a.noteBurst(PartId.none(), 12.0, 20.0);
  auWalkFrames(isl, &mut a, 900usize);
  var b = auFresh();
  b.noteBurst(PartId.none(), 12.0, 20.0);
  auWalkFrames(isl, &mut b, 900usize);
  var same = a.record.len() == b.record.len() && a.record.len() > 0usize;
  var i = 0usize;
  while same && i < a.record.len() {
    if *a.record[i] != *b.record[i] { same = false; }
    i = i + 1usize;
  }
  var ok = expect("the same frames render the same samples, bit for bit", same);
  ok = expect("and the mix is not silent (above -60 dB)", auLevel(&a, 0usize, auFrames(&a), 0u32) > -60.) && ok;
  ok = expect("48000 / 60 frames of audio to each fixed step (900 steps, 720000 frames)", auFrames(&a) == 720000usize) && ok;
  ok
}

fn checkAudioSteps(isl: &Island) bool {
  // A real mannequin walks the lawn route over the bridge, 360 steps (6 s); the audio is fed the figure each step
  var s = Scene.empty();
  var c = Cast.empty(isl.share());
  let solids = worldSolids(isl);
  c.phys.ensureGround();
  c.phys.setSolids(&solids);
  let a = c.add(mannequinBeing(&mut s, "walker", new Vec3(BRIDGE_X, islandHeight(isl, BRIDGE_X, BRIDGE_Z + 8.), BRIDGE_Z + 8.), 1.75, 3u32));
  c.possess(a);
  var v = auFresh();
  let walk = new Intents(1., 0., false, false);
  let startZ = c.beings[a].body.position.z;
  var k = 0;
  while k < 480 {
    c.step(walk, 1. / 60.);
    var f = auFrame(c.beings[a].eyes().origin, 0.25, 10.);
    f.beings.push(audioBeingOf(a, c.beings[a]));
    v.update(isl, &f);
    k = k + 1;
  }
  let walked = startZ - c.beings[a].body.position.z;
  let speed = c.beings[a].figure.speed;
  let stride = walkgait.strideLength(1.75, speed);
  let expected = walked * 2. / stride;
  print <- "    (walked "; print <- walked; print <- " m at "; print <- speed; print <- " m/s, stride "; print <- stride; print <- " m: about ";
  print <- expected; print <- " steps; "; print <- v.stepsPlayed; print <- " played)\n";
  var ok = expect("a step is played for each foot that comes down: within 3 of the distance over half the stride",
    nearly(f32.from(v.stepsPlayed), expected, 3.));
  ok = expect("the steps on the bridge are the bridge's (7 to 12 of them over its 7.8 m)", v.stepsOn[3usize] >= 7u32 && v.stepsOn[3usize] <= 12u32) && ok;
  ok = expect("those on the lawn are grass", v.stepsOn[0usize] >= 8u32 && v.stepsOn[1usize] == 0u32 && v.stepsOn[2usize] == 0u32) && ok;
  ok
}

fn checkAudioNoAllocation(isl: &Island) bool {
  var v = auFresh();
  v.noteBurst(PartId.none(), 12.0, 20.0);
  // Warm: every voice made, every list the game side grows grown
  auWalkFrames(isl, &mut v, 300usize);
  auCountAllocations();
  let before = auAllocationsCounted();
  auWalkFrames(isl, &mut v, 900usize);
  let after = auAllocationsCounted();
  // The counter works: an allocation while 'in a render' is seen
  audioCounts.inRender.store(1u64);
  var probe = List[f32].empty();
  probe.push(1.);
  audioCounts.inRender.store(0u64);
  let seen = auAllocationsCounted();
  auStopCounting();
  print <- "    (900 steps = 90 s of mixer, "; print <- v.voicesNow(); print <- " voices playing, "; print <- v.stolen(); print <- " stolen, ";
  print <- v.refused(); print <- " commands refused)\n";
  var ok = expect("rendering the mixer allocated nothing in 900 steps (heap allocations counted: 0)", after - before == 0u64);
  ok = expect("and the counter does see an allocation made inside a render", seen > after) && ok;
  ok = expect("with more than 4 voices playing, none refused", v.voicesNow() > 4usize && v.refused() == 0u32) && ok;
  // Out of range: the listener on the hill hears almost nothing, and runs almost nothing
  var q = auFresh();
  auStand(isl, &mut q, auQuiet(isl), 0.25, 100., 240usize);
  ok = expect("far from everything only the wind plays (at most 3 voices)", q.voicesNow() <= 3usize) && ok;
  ok
}
