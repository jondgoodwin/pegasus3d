// The playground, on the simulation's side: the actions a client sent (bowl the ball, cast a spell) played out in the truth, and
// what every view is told of them. Nothing here is drawn; the view draws the props from the snapshot, the splats from the bursts
// told, and a spell's pose from the snapshot's list of spells in force (spells.cone is that pose).
//
// THE PAINTBALL (F1): a ray from the caster's eye along the camera's direction, PAINT_RANGE metres, through the physics world (the
// ground, the solids, the platforms: trees, rocks, walls and the balloon's basket stop it) and through the beings (each a stack of
// four spheres, the caster's own left out); the nearest wins. A splat on a surface is told in the world's coordinates; one on a
// being in the being's own frame, so that the view draws it where that being has walked to. THE ZAP (F2) and THE JIG (F3) need a
// target: a being other than the caster, within SPELL_RANGE and in the open (a ray from the eye to its chest meets no solid first).
// The spell is a state of that being (FxState) for its length; while it lasts the being's own intents are ignored (it is a
// convulsion or a dance), and every view lays the pose over its gait (spells.cone). THE BOWL: the ball bowled from the caster's feet
// at the spot the eye's ray meets (props.cone).
//
// The caster is the being of the connection the action came from, so a client cannot act for another. The eye the view sends is
// believed only if it is within EYE_SLACK metres of the caster's head; else the head is used.

// How far a paintball flies, and how far a zap or a jig reaches (metres)
pub const PAINT_RANGE f32 = 30.;
pub const SPELL_RANGE f32 = 25.;
// How far from the caster's head the eye it sends may be (metres)
const EYE_SLACK f32 = 5.;
// A being as the rays see it: four spheres up its axis, as fractions of its height (centre, then radius)
imm BODY_SPHERES Array[f32, 8] = [0.20, 0.125, 0.45, 0.14, 0.70, 0.14, 0.93, 0.075];

pub struct PlayCmd {
  pub client u32;
  pub kind u32;
  pub spell u32;
  pub target u32;
  pub eye Vec3;
  pub dir Vec3;
}

pub struct PlaySim {
  pub fx List[FxState];       // the spells in force
  pub pending List[PlayCmd];  // actions received, not yet played
  pub bursts List[BurstInfo]; // to tell every client
  pub bowls u32;              // counted
  pub paintShots u32;
  pub paintOnBeings u32;
  pub paintOnSurfaces u32;
  pub zaps u32;
  pub jigs u32;
  pub refused u32;            // a spell with no valid target, or from a client with no being

  pub fn empty() PlaySim {
    new PlaySim(List[FxState].empty(), List[PlayCmd].empty(), List[BurstInfo].empty(), 0u32, 0u32, 0u32, 0u32, 0u32, 0u32, 0u32);
  }

  // An action received from client connection 'client'
  pub fn receive(self &mut, client u32, kind u32, spell u32, target u32, eye Vec3, dir Vec3) {
    pending.push(new PlayCmd(client, kind, spell, target, eye, dir));
  }

  // The kind of spell in force on being 'b' (FX_NONE: none)
  pub fn fxOf(self &, b u32) u32 {
    mut i = 0usize;
    while i < fx.len() {
      if fx[i].being == b { return fx[i].kind; }
      i = i + 1usize;
    }
    FX_NONE;
  }
}

pub fn copyProps(src &List[PropState]) List[PropState] {
  mut out = List[PropState].withCapacity(src.len());
  mut i = 0usize;
  while i < src.len() { out.push(*src[i]); i = i + 1usize; }
  out;
}

pub fn copyFx(src &List[FxState]) List[FxState] {
  mut out = List[FxState].withCapacity(src.len());
  mut i = 0usize;
  while i < src.len() { out.push(*src[i]); i = i + 1usize; }
  out;
}

fn unitOf(v Vec3) Vec3 {
  imm l = libc.sqrtf(v.x * v.x + v.y * v.y + v.z * v.z);
  if l < 0.00001 { return new Vec3(0., 0., 0. - 1.); }
  new Vec3(v.x / l, v.y / l, v.z / l);
}

// The nearest the ray (unit 'dir') meets of the beings' spheres within 'maxT', the being left out ('skip'); the being, the distance
// and the point and the surface's normal there. false if none
fn rayBeings(cast &Cast, from Vec3, dir Vec3, maxT f32, skip usize, being &mut usize, dist &mut f32, point &mut Vec3, normal &mut Vec3) bool {
  mut best = maxT;
  mut found = false;
  mut i = 0usize;
  while i < cast.beings.len() {
    imm b = cast.beings[i];
    if i != skip and !b.gone and b.figure.active and b.figure.mode == FIG_WALK {
      mut s = 0usize;
      while s < 4usize {
        imm c = b.body.position + new Vec3(0., BODY_SPHERES[s * 2usize] * b.figure.height, 0.);
        imm r = BODY_SPHERES[s * 2usize + 1usize] * b.figure.height;
        imm oc = from - c;
        imm bq = oc.x * dir.x + oc.y * dir.y + oc.z * dir.z;
        imm cq = oc.x * oc.x + oc.y * oc.y + oc.z * oc.z - r * r;
        imm disc = bq * bq - cq;
        if disc >= 0. {
          imm t = 0. - bq - libc.sqrtf(disc);
          if t > 0. and t < best {
            best = t;
            found = true;
            *being = i;
            *dist = t;
            *point = from + dir * t;
            *normal = unitOf(*point - c);
          }
        }
        s = s + 1usize;
      }
    }
    i = i + 1usize;
  }
  found;
}

// Where the caster's eye is taken to be: the one sent if near its head, else its head
fn eyeOf(b &Being, sent Vec3) Vec3 {
  imm head = b.body.position + new Vec3(0., 0.936 * b.figure.height, 0.);
  imm d = sent - head;
  if d.x * d.x + d.y * d.y + d.z * d.z <= EYE_SLACK * EYE_SLACK { sent; } else { head; };
}

// The world's first hit by a ray (the ground, the solids and the platforms): the distance, or -1
fn rayWorld(cast &mut Cast, from Vec3, dir Vec3, maxT f32, point &mut Vec3, normal &mut Vec3) f32 {
  cast.phys.ensureGround();
  imm h = cast.phys.w.castRay(from, dir, maxT, rigiddynamics.QueryFilter.layers(LAYER_GROUND | LAYER_WORLD));
  if !h.hit { return -1.; }
  *point = h.point;
  *normal = h.normal;
  h.t;
}

// Whether being 'target' may be the target of a spell from 'caster' with its eye at 'eye': in range, and a clear line to its chest
fn targetable(cast &mut Cast, caster usize, target u32, eye Vec3) bool {
  imm ti = usize.from(target);
  if ti >= cast.beings.len() or ti == caster { return false; }
  imm tb = cast.beings[ti];
  if tb.gone or !tb.figure.active or tb.figure.mode != FIG_WALK { return false; }
  imm chest = tb.body.position + new Vec3(0., 0.7 * tb.figure.height, 0.);
  imm d = chest - eye;
  imm dist = libc.sqrtf(d.x * d.x + d.y * d.y + d.z * d.z);
  if dist > SPELL_RANGE { return false; }
  mut p = new Vec3(0., 0., 0.);
  mut n = new Vec3(0., 0., 0.);
  imm hit = rayWorld(cast, eye, new Vec3(d.x / dist, d.y / dist, d.z / dist), dist - 0.3, &mut p, &mut n);
  hit < 0.;
}

// The actions received, played: in the order they came
pub fn playApply(play &mut PlaySim, cast &mut Cast, tick u64, clients &List[Client]) {
  mut i = 0usize;
  while i < play.pending.len() {
    imm cmd = *play.pending[i];
    i = i + 1usize;
    mut who = NO_ROW;
    mut c = 0usize;
    while c < clients.len() { if clients[c].id == cmd.client { who = clients[c].being; } c = c + 1usize; }
    if who == NO_ROW or who >= cast.beings.len() { play.refused = play.refused + 1u32; continue; }
    imm caster = cast.beings[who];
    if caster.gone or !caster.figure.active or caster.figure.mode != FIG_WALK { play.refused = play.refused + 1u32; continue; }
    imm eye = eyeOf(caster, cmd.eye);
    imm dir = unitOf(cmd.dir);
    if cmd.kind == PLAY_BOWL {
      mut p = new Vec3(0., 0., 0.);
      mut n = new Vec3(0., 0., 0.);
      imm t = rayWorld(cast, eye, dir, 60., &mut p, &mut n);
      imm aim = if t > 0. { p; } else { eye + dir * 30.; };
      propsBowl(&mut cast.phys, &mut cast.props, caster.body.position, aim);
      play.bowls = play.bowls + 1u32;
    } elif cmd.kind == PLAY_SPELL and cmd.spell == SPELL_PAINT {
      play.paintShots = play.paintShots + 1u32;
      mut wp = new Vec3(0., 0., 0.);
      mut wn = new Vec3(0., 0., 0.);
      imm tw = rayWorld(cast, eye, dir, PAINT_RANGE, &mut wp, &mut wn);
      mut bi = 0usize;
      mut bt = 0.;
      mut bp = new Vec3(0., 0., 0.);
      mut bn = new Vec3(0., 0., 0.);
      imm limit = if tw > 0. { tw; } else { PAINT_RANGE; };
      imm onBeing = rayBeings(cast, eye, dir, limit, who, &mut bi, &mut bt, &mut bp, &mut bn);
      imm color = play.paintShots % 4u32;
      if onBeing {
        // On a being: in its own frame, so the view draws it where that being is
        imm b = cast.beings[bi];
        imm back = Quat.angleAxis(0. - b.body.yaw, new Vec3(0., 1., 0.));
        play.bursts.push(new BurstInfo(BURST_PAINT, u32.from(bi), back * (bp - b.body.position), back * bn, color, tick));
        play.paintOnBeings = play.paintOnBeings + 1u32;
      } elif tw > 0. {
        play.bursts.push(new BurstInfo(BURST_PAINT, NO_TARGET, wp, wn, color, tick));
        play.paintOnSurfaces = play.paintOnSurfaces + 1u32;
      }
    } elif cmd.kind == PLAY_SPELL and (cmd.spell == SPELL_ZAP or cmd.spell == SPELL_JIG) {
      if !targetable(cast, who, cmd.target, eye) { play.refused = play.refused + 1u32; continue; }
      imm kind = if cmd.spell == SPELL_ZAP { FX_ZAP; } else { FX_JIG; };
      // One spell on a being at a time: a new one replaces the old
      mut keep = List[FxState].empty();
      mut k = 0usize;
      while k < play.fx.len() { if play.fx[k].being != cmd.target { keep.push(*play.fx[k]); } k = k + 1usize; }
      keep.push(new FxState(cmd.target, kind, tick));
      play.fx <=> keep;
      cast.beings[usize.from(cmd.target)].figure.setFx(kind, tick, 0.);
      if kind == FX_ZAP {
        play.zaps = play.zaps + 1u32;
        imm tb = cast.beings[usize.from(cmd.target)];
        play.bursts.push(new BurstInfo(BURST_ZAP, cmd.target, new Vec3(0., 0.7 * tb.figure.height, 0.), new Vec3(0., 1., 0.), 0u32, tick));
      } else {
        play.jigs = play.jigs + 1u32;
      }
    }
  }
  play.pending.clear();
}

// Each step: spells that have run their length are lifted, and a being under one is held (its intents none)
pub fn playHold(play &mut PlaySim, given &mut List[Intents], tick u64) {
  mut keep = List[FxState].empty();
  mut i = 0usize;
  while i < play.fx.len() {
    imm f = *play.fx[i];
    if f32.from(tick - f.start) / 60. <= fxSeconds(f.kind) {
      keep.push(f);
      if usize.from(f.being) < given.len() { given.set(usize.from(f.being), Intents.none()); }
    }
    i = i + 1usize;
  }
  if keep.len() != play.fx.len() { play.fx <=> keep; }
}
