// The "Play with others" panel's headless checks (part of 'browser.exe --checks', called by the HUD's): what the shell's route takes
// and what it makes of it, the panel in the HUD's Ui (opened, typed into, clicked, closed), where its controls are against where
// panelTarget says, and that a request is sent off the frame's thread and its answer shown. No GPU, no window, no server: the request
// goes to a port on this machine that nothing listens on, which is the answer of an automated run, an error.

// Offers a key of the keyboard to the route
fn routeKey(route: &mut PanelRoute, scancode: u32, down: bool) u32 {
  var e = sdl.Event.empty();
  e.type = if down { sdl.EVENT_KEY_DOWN } else { sdl.EVENT_KEY_UP };
  let k = &mut e as &mut sdl.KeyboardEvent;
  k.scancode = scancode;
  k.down = down;
  route.offer(&e, 1280., 720.)
}

// Offers a mouse event (motion, or button down or up when 'kind' says) at the middle of the window
fn routeMouse(route: &mut PanelRoute, kind: u32) u32 {
  var e = sdl.Event.empty();
  e.type = kind;
  if kind == sdl.EVENT_MOUSE_MOTION {
    let m = &mut e as &mut sdl.MouseMotionEvent;
    m.x = 640.;
    m.y = 180.;
  } else {
    let b = &mut e as &mut sdl.MouseButtonEvent;
    b.button = sdl.BUTTON_LEFT;
    b.x = 320.;
    b.y = 360.;
  }
  route.offer(&e, 1280., 720.)
}

fn routeFocusLost(route: &mut PanelRoute) u32 {
  var e = sdl.Event.empty();
  e.type = sdl.EVENT_WINDOW_FOCUS_LOST;
  route.offer(&e, 1280., 720.)
}

// A frame for the HUD with 'events' for the panel
fn panelFrame(events: List[PanelEvent]) HudFrame {
  var f = hudFrameAt(BEACH_X, BEACH_Z, 0., 0u32);
  f.events = events;
  f
}

fn panelOne(kind: u32, a: f32, b: f32, code: u32, mods: u32) List[PanelEvent] {
  var l = List[PanelEvent].empty();
  l.push(PanelEvent.of(kind, a, b, code, mods));
  l
}

fn panelOpenEvent(name: &str, code: u32) List[PanelEvent] {
  var ev = PanelEvent.of(PE_OPEN, 0., 0., code, 0u32);
  ev.text = String.from(name);
  var l = List[PanelEvent].empty();
  l.push(ev);
  l
}

// A click on control 'which', as the shell would send it from a window of 1280 x 720 at 100 %
fn panelClick(model: &mut HudModel, which: u32) {
  let at = panelTarget(which, 1280., 720.);
  var l = List[PanelEvent].empty();
  l.push(PanelEvent.of(PE_DOWN, at.x / 1280., at.y / 720., 0u32, 0u32));
  l.push(PanelEvent.of(PE_UP, at.x / 1280., at.y / 720., 0u32, 0u32));
  model.update(&panelFrame(l), 1280., 720.);
}

fn panelType(model: &mut HudModel, s: &str) {
  var l = List[PanelEvent].empty();
  let b: &Array[u8] = s;
  var i = 0usize;
  while i < b.len {
    l.push(PanelEvent.of(PE_TEXT, 0., 0., u32.from(b[i]), 0u32));
    i = i + 1usize;
  }
  model.update(&panelFrame(l), 1280., 720.);
}

fn fieldIs(model: &HudModel, which: u32, want: &str) bool {
  uilayout.fieldText(&model.ui, model.rp.nodeOf(which)) == want
}

fn checkPanel() bool {
  print <- "The \"Play with others\" panel:\n";
  var ok = true;

  // The shell's route: closed, it takes only the opening keys
  var route = PanelRoute.make(String.from("Ann"), false, true);
  ok = yesNo("closed, W is the game's", routeKey(&mut route, 26u32, true) == OFFER_PASS) && ok;
  ok = yesNo("closed, the mouse is the game's", routeMouse(&mut route, sdl.EVENT_MOUSE_MOTION) == OFFER_PASS
    && routeMouse(&mut route, sdl.EVENT_MOUSE_BUTTON_DOWN) == OFFER_PASS) && ok;
  ok = yesNo("F9 opens it (and the keys held are to be let go)", routeKey(&mut route, SCANCODE_F9, true) == OFFER_OPENED && route.open) && ok;
  let first = route.take();
  ok = yesNo("and says so with one event, carrying the name", first.len() == 1usize && first[0].kind == PE_OPEN && first[0].text == "Ann"
    && first[0].code == 2u32) && ok;
  ok = yesNo("open, W is the panel's and nothing is made of it", routeKey(&mut route, 26u32, true) == OFFER_TAKEN && route.take().len() == 0usize) && ok;
  ok = yesNo("Backspace becomes a key event", routeKey(&mut route, 42u32, true) == OFFER_TAKEN) && ok;
  let keys = route.take();
  ok = yesNo("(KEY_BACKSPACE)", keys.len() == 1usize && keys[0].kind == PE_KEY && keys[0].code == uilayout.KEY_BACKSPACE) && ok;
  ok = yesNo("open, the mouse is the panel's: motion and press, as fractions of the window", routeMouse(&mut route, sdl.EVENT_MOUSE_MOTION) == OFFER_TAKEN
    && routeMouse(&mut route, sdl.EVENT_MOUSE_BUTTON_DOWN) == OFFER_TAKEN) && ok;
  let mouse = route.take();
  ok = yesNo("(0.5, 0.25 and 0.25, 0.5)", mouse.len() == 2usize && mouse[0].kind == PE_MOVE && mouse[0].a == 0.5 && mouse[0].b == 0.25
    && mouse[1].kind == PE_DOWN && mouse[1].a == 0.25 && mouse[1].b == 0.5) && ok;
  var typed = sdl.Event.empty();
  typed.type = sdl.EVENT_TEXT_INPUT;
  // "a" and "é" (U+00E9, two bytes) and "€" (U+20AC, three)
  let bytes = libc.malloc(8usize) as *u8;
  *bytes = 97u8; *(bytes + 1usize) = 0xC3u8; *(bytes + 2usize) = 0xA9u8;
  *(bytes + 3usize) = 0xE2u8; *(bytes + 4usize) = 0x82u8; *(bytes + 5usize) = 0xACu8; *(bytes + 6usize) = 0u8;
  (&mut typed as &mut sdl.TextInputEvent).text = bytes;
  ok = yesNo("text input is the panel's", route.offer(&typed, 1280., 720.) == OFFER_TAKEN) && ok;
  let text = route.take();
  ok = yesNo("and comes as code points: 'a', U+00E9, U+20AC", text.len() == 3usize && text[0].code == 97u32 && text[1].code == 0xE9u32
    && text[2].code == 0x20ACu32) && ok;
  libc.free(bytes);
  ok = yesNo("the window losing focus is not the panel's (it lets the keys go)", routeFocusLost(&mut route) == OFFER_PASS) && ok;
  ok = yesNo("a key up is taken", routeKey(&mut route, 26u32, false) == OFFER_TAKEN) && ok;
  ok = yesNo("F9 again closes it, as an event", routeKey(&mut route, SCANCODE_F9, true) == OFFER_TAKEN && route.take().len() == 1usize) && ok;
  ok = yesNo("Escape, with it open, closes it as an event (and is not a quit)", route.escape() && route.take().len() == 1usize) && ok;
  route.told(0u32, 0usize, true);
  ok = yesNo("Escape, with it closed, is a quit (the caller's)", !route.escape() && route.take().len() == 0usize) && ok;
  ok = yesNo("render's word that it is closed gives the game its keys back", !route.open && routeKey(&mut route, 26u32, true) == OFFER_PASS) && ok;
  ok = yesNo("J opens it as well", routeKey(&mut route, SCANCODE_J, true) == OFFER_OPENED) && ok;

  // The panel in the Ui
  var model = HudModel.make(1280., 720., 1.);
  model.update(&hudFrameAt(BEACH_X, BEACH_Z, 0., 0u32), 1280., 720.);
  ok = yesNo("before it opens it is hidden and takes nothing", !model.rp.open && model.rp.bits(&model.ui) == 0u32
    && !model.ui.nodes[model.rp.scrim].visible) && ok;
  model.update(&panelFrame(panelOpenEvent("Ann", 2u32)), 1280., 720.);
  ok = yesNo("an open event shows it: modal, the name field with the name, focused, and the word for the shell is open and typing",
    model.rp.open && model.ui.nodes[model.rp.scrim].visible && model.ui.input.modal == model.rp.scrim
    && fieldIs(&model, T_NAME_FIELD, "Ann") && model.ui.input.focus == model.rp.nodeOf(T_NAME_FIELD)
    && model.rp.bits(&model.ui) == (PANEL_OPEN | PANEL_TEXT)) && ok;
  ok = yesNo("the HUD's own parts give way to it (status, minimap, hotbar hidden)", !model.ui.nodes[model.status].visible
    && !model.ui.nodes[model.mapFrame].visible && !model.ui.nodes[model.bar].visible) && ok;
  let dialog = model.ui.nodes[model.rp.dialog];
  ok = near("the dialog is 380 across", dialog.w, DIALOG_W, 1.) && ok;
  ok = near("and 342 tall", dialog.h, DIALOG_H, 1.) && ok;
  ok = near("and centred: its middle x", dialog.gx + dialog.w * 0.5, 640., 1.) && ok;
  ok = near("and y", dialog.gy + dialog.h * 0.5, 360., 1.) && ok;
  // Where the controls are against where the scripted run aims
  var aim = true;
  var which = 0u32;
  while which < 4u32 {
    let n = model.ui.nodes[model.rp.nodeOf(which)];
    let at = panelTarget(which, 1280., 720.);
    let dx = n.gx + n.w * 0.5 - at.x;
    let dy = n.gy + n.h * 0.5 - at.y;
    if dx > 1. || dx < -1. || dy > 1. || dy < -1. { aim = false; }
    which = which + 1u32;
  }
  ok = yesNo("the name field, the message field and the two buttons are where panelTarget says (within 1 unit)", aim) && ok;

  // Typing: Backspace edits, a name takes only the letters a name has
  model.update(&panelFrame(panelOne(PE_KEY, 0., 0., uilayout.KEY_BACKSPACE, 0u32)), 1280., 720.);
  ok = yesNo("Backspace deletes a letter: \"An\"", fieldIs(&model, T_NAME_FIELD, "An")) && ok;
  panelType(&mut model, "n!<x y_z");
  ok = yesNo("typing \"n!<x y_z\" adds the letters, the space and the underscore, and not ! or <: \"Annx y_z\"", fieldIs(&model, T_NAME_FIELD, "Annx y_z")) && ok;
  panelType(&mut model, "abcdefghijklmnopqrstuvwxyz");
  ok = yesNo("a name stops at 24", String.from(uilayout.fieldText(&model.ui, model.rp.nodeOf(T_NAME_FIELD))).len() == 24usize) && ok;
  // Tab goes to the message, where any printable character is taken
  model.update(&panelFrame(panelOne(PE_KEY, 0., 0., uilayout.KEY_TAB, 0u32)), 1280., 720.);
  ok = yesNo("Tab moves the focus to the message field", model.ui.input.focus == model.rp.nodeOf(T_MESSAGE_FIELD)) && ok;
  panelType(&mut model, "hi! <ok>");
  ok = yesNo("the message takes any printable character", fieldIs(&model, T_MESSAGE_FIELD, "hi! <ok>")) && ok;

  // The mouse: a click is the Ui's (a hit test through the controls)
  panelClick(&mut model, T_NAME_FIELD);
  ok = yesNo("a click on the name field focuses it", model.ui.input.focus == model.rp.nodeOf(T_NAME_FIELD)) && ok;
  panelClick(&mut model, T_MESSAGE_FIELD);
  ok = yesNo("a click on the message field focuses that", model.ui.input.focus == model.rp.nodeOf(T_MESSAGE_FIELD)) && ok;

  // A name the server would refuse is said, and nothing is sent
  model.update(&panelFrame(panelOpenEvent("bad!name", 2u32)), 1280., 720.);
  panelClick(&mut model, T_ASK_BUTTON);
  ok = yesNo("a bad name is told, not sent", model.rp.requests == 0u32 && model.ui.text(model.rp.line0).len() > 0usize) && ok;

  // A request: sent from a thread of its own, the answer shown when it comes
  model.update(&panelFrame(panelOpenEvent("zz-check", 2u32)), 1280., 720.);
  let t0 = sdl.GetTicksNS();
  panelClick(&mut model, T_ASK_BUTTON);
  let clickMs = f64.from(sdl.GetTicksNS() - t0) / 1000000.0;
  ok = yesNo("Request to play sends one request, and the frame that sent it did not wait for the server (under 100 ms)",
    model.rp.requests == 1u32 && clickMs < 100.0) && ok;
  print <- "  (the click's frame took "; print <- clickMs; print <- " ms)\n";
  ok = yesNo("while it is out the button is off and the panel says so", model.ui.text(model.rp.line0) == "Sending..."
    && (model.ui.nodes[model.rp.ask].state & uilayout.ST_DISABLED) != 0u32) && ok;
  panelClick(&mut model, T_ASK_BUTTON);
  ok = yesNo("a second press while one is out sends nothing", model.rp.requests == 1u32) && ok;
  var waited = 0;
  while model.rp.answers == 0u32 && waited < 400 {
    thread.sleep(Duration.fromMillis(50i64));
    model.update(&panelFrame(List[PanelEvent].empty()), 1280., 720.);
    waited = waited + 1;
  }
  ok = yesNo("the answer comes: an error (nothing listens where an automated run asks), shown in the panel, and the button is on again",
    model.rp.answers == 1u32 && model.rp.lastKind == ANS_ERROR && model.ui.text(model.rp.line0).len() > 0usize
    && (model.ui.nodes[model.rp.ask].state & uilayout.ST_DISABLED) == 0u32) && ok;
  print <- "  (answered after "; print <- waited * 50; print <- " ms: \""; printStr(model.rp.lastLine.view()); print <- "\")\n";

  // Close: the button, and the HUD's own parts come back
  panelClick(&mut model, T_CLOSE_BUTTON);
  ok = yesNo("Close shuts it: not open, no longer modal, the word for the shell is closed", !model.rp.open && model.ui.input.modal == uilayout.NIL
    && model.rp.bits(&model.ui) == 0u32 && !model.ui.nodes[model.rp.scrim].visible) && ok;
  let shownAgain = HudFrame(true, 12.5, WEATHER_RAIN, 6.4, false, 0i64, Vec3(BEACH_X, 0., BEACH_Z), 0., List[Vec3].empty(), 0u32, 0.016,
    List[HudTag].empty(), Pose.look(Vec3(BEACH_X, 1.7, BEACH_Z), 0., 0.), 1., List[PanelEvent].empty(), true, String.empty());
  model.update(&shownAgain, 1280., 720.);
  ok = yesNo("the HUD's parts are back, and the hint line shows (it names F9)", model.ui.nodes[model.status].visible
    && model.ui.nodes[model.bar].visible && model.ui.nodes[model.hintLabel].visible) && ok;
  // A closed panel ignores the events it is sent
  model.update(&panelFrame(panelOne(PE_TEXT, 0., 0., 97u32, 0u32)), 1280., 720.);
  ok = yesNo("closed, it ignores stray events", !model.rp.open && model.rp.bits(&model.ui) == 0u32) && ok;

  // Join (single player going online, viewactor.cone's goOnline): once an answer has said "approved" the button reads Join; pressing it
  // makes no request but hands the shell the name, once, and waits for the view's word; a refusal is shown and the button comes back;
  // being connected closes the panel
  model.update(&panelFrame(panelOpenEvent("zz-join", 2u32)), 1280., 720.);
  model.rp.approved = true;           // (what an "approved" answer sets)
  panelClick(&mut model, T_CLOSE_BUTTON);
  model.update(&panelFrame(panelOpenEvent("zz-join", 2u32)), 1280., 720.);
  ok = yesNo("once approved, the panel opens with its button reading Join", model.rp.open && model.ui.text(model.rp.ask) == "Join"
    && (model.ui.nodes[model.rp.ask].state & uilayout.ST_DISABLED) == 0u32) && ok;
  let asked = model.rp.requests;
  panelClick(&mut model, T_ASK_BUTTON);
  let joinName = model.rp.takeJoin();
  ok = yesNo("pressing it makes no request, hands the shell the name (once), and the panel says it is connecting", model.rp.requests == asked
    && joinName == "zz-join" && model.rp.takeJoin().len() == 0usize && model.ui.text(model.rp.line0) == "Connecting to the island..."
    && (model.ui.nodes[model.rp.ask].state & uilayout.ST_DISABLED) != 0u32) && ok;
  panelClick(&mut model, T_ASK_BUTTON);
  ok = yesNo("a second press while it dials does nothing", model.rp.takeJoin().len() == 0usize) && ok;
  var refusal = panelFrame(List[PanelEvent].empty());
  refusal.joinFailed = String.from("The name zz-join is already in use.");
  model.update(&refusal, 1280., 720.);
  ok = yesNo("a refusal is shown, and the button is on again", model.ui.text(model.rp.line0) == "The name zz-join is already in use."
    && (model.ui.nodes[model.rp.ask].state & uilayout.ST_DISABLED) == 0u32 && model.rp.open) && ok;
  panelClick(&mut model, T_ASK_BUTTON);
  let again = model.rp.takeJoin();
  var online = panelFrame(List[PanelEvent].empty());
  online.connected = true;
  model.update(&online, 1280., 720.);
  ok = yesNo("pressed again and the browser then online, the panel closes", again == "zz-join" && !model.rp.open
    && model.ui.input.modal == uilayout.NIL) && ok;
  var reopen = panelFrame(panelOpenEvent("zz-join", 2u32));
  reopen.connected = true;
  model.update(&reopen, 1280., 720.);
  ok = yesNo("opened while online, it says so and offers nothing", model.ui.text(model.rp.line0) == "You are playing with others."
    && (model.ui.nodes[model.rp.ask].state & uilayout.ST_DISABLED) != 0u32) && ok;
  ok
}
