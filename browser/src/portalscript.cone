// The portal's part of the scripted run (portal.cone, portalsim.cone, viewsurface.cone), after the mirror's (frame PORTAL_FROM_FULL).
// The wooden mannequin (being 1) is possessed and driven by keys through SDL's queue, as the first walk is (no real key is pressed).
// Time is noon of the same day in fair weather. It has five phases ('k' is the frame in the part):
//
//   k    what happens, and what is shot
//   0    set down 2.2 m before the cottage's glass, facing it, still: the mirror (shot portal-mirror). 3 s on the glass opens: the
//        reflection stands where it was and faces the glass (portal-opening), turns (portal-turning), and walks off down the
//        corridor (portal-walks), to E, where it is gone. Camera: 4 m behind the mannequin, a little to one side
//   520  set down 3 m before the glass, and run at it (Shift and W): through the glass, down the corridor to E and into the room. The
//        camera goes to first person (V) and is the real one, the rig's, round the crossing: seven frames (portal-seam-N) show it is not
//        seen; and the mannequin's eyes are shot as it nears the pane (portal-approach), just through it (portal-through) and in the
//        room (portal-room)
//   820  the way it was laid, from the room: Ariadne's thread, from E to the mannequin (portal-thread)
//   850  set down in the corridor 3 m from its mouth facing it, and run at it: the mouth's pane shows the island (portal-back), through
//        it the mannequin is back on the lawn (portal-out); the camera back to the third person for this crossing, the rig's again,
//        three metres behind it (portal-third-N)
//   960  the corridor that will not end: pictures from a tenth of a metre short of the gate and from the same place 12 m back (loop-a,
//        loop-b: they are the same but for the filter's blur), and half a metre short of it (loop-a-near); then the mannequin run
//        forward through its gate (it is sent back: loop-forward, loop-forward-after: it sees its own back far ahead) and, from
//        another place, walked backwards through it (it goes through: loop-backward)
//   1260 THE WALK (walkscript.cone): the whole way in one go, first person, the mannequin set down on the lawn and run at the open glass:
//        through it, down the entrance corridor, E and the antechamber, the nav mesh's route to the corridor that will not end, forward
//        in it until it is sent back, then turned about and walked backwards through the gate, the court, the route to the staircase's
//        top, and out through the doorway to the spring (shots walk-N)
//
// Checked: the glass opens near 3 s after the mannequin stands before it; the puppet is made; the mannequin crosses the glass and
// is in the labyrinth, then comes back to the island; the forward run is sent back and the backward one is not; the thread has
// points from E; the walk reaches the spring, its thread cleared. The gates are counted by the simulation; the pictures are in the shot folder.
//
// 'browser.exe --portal-only' runs just this part (frames 300 on), for looking at the portal without the whole run.

pub const PORTAL_FROM_FULL = MIRROR_FROM_FULL + MIRROR_FRAMES;
// The part before the walk, and the walk's
const PK_WALK = 1260u64;
pub const PORTAL_FRAMES = PK_WALK + WALK_FRAMES;

// Frames (k) of each phase
const PK_CROSS = 520u64;
const PK_THREAD = 820u64;
const PK_BACK = 850u64;
const PK_LOOP = 960u64;
// The frames, from PK_CROSS, round the one the crossing is in (it is found by the log), shot one a frame with the real camera
const PK_SEAM = 53u64;
const PK_SEAMS = 7u64;

// The first frame of the portal's part: frame 300 in the portal-only run, else after the mirror's
pub fn portalFrom(opts: &RunOptions) u64 {
  if opts.portalOnly { 300u64 } else { PORTAL_FROM_FULL }
}

pub fn portalScriptEnd(opts: &RunOptions) u64 { portalFrom(opts) + PORTAL_FRAMES }

// Whether frame 'f' is in the portal's part
pub fn portalIn(opts: &RunOptions, f: u64) bool {
  if opts.portalOnly { f >= portalFrom(opts) } else { f >= portalFrom(opts) && f < portalScriptEnd(opts) }
}

// The first frame of the walk
pub fn labWalkStart(opts: &RunOptions) u64 { portalFrom(opts) + PK_WALK }

// The keys: Shift and W (or S, back) held for a stretch, through SDL's queue
pub fn portalPush(opts: &RunOptions, f: u64) {
  if !portalIn(opts, f) || opts.mirrorHold > 0u32 { return; }
  let k = f - portalFrom(opts);
  // The camera to first person (V), for the run through the glass
  if k == PK_CROSS + 2u64 { pushKey(SCANCODE_V, true); }
  if k == PK_CROSS + 4u64 { pushKey(SCANCODE_V, false); }
  // Through the glass and on into the room
  if k == PK_CROSS + 6u64 { pushKey(sdl.SCANCODE_LSHIFT, true); pushKey(sdl.SCANCODE_W, true); }
  if k == PK_CROSS + 276u64 { pushKey(sdl.SCANCODE_W, false); pushKey(sdl.SCANCODE_LSHIFT, false); }
  // Back out through the mouth's pane (3 m, and on)
  // (back to the third person, the rig's default, for this crossing: the camera 3.2 m behind it goes through too)
  if k == PK_BACK + 2u64 { pushKey(SCANCODE_V, true); }
  if k == PK_BACK + 4u64 { pushKey(SCANCODE_V, false); }
  if k == PK_BACK + 6u64 { pushKey(sdl.SCANCODE_LSHIFT, true); pushKey(sdl.SCANCODE_W, true); }
  if k == PK_BACK + 76u64 { pushKey(sdl.SCANCODE_W, false); pushKey(sdl.SCANCODE_LSHIFT, false); }
  // The loop: forward, facing forward; then backwards, facing back
  if k == PK_LOOP + 16u64 { pushKey(sdl.SCANCODE_LSHIFT, true); pushKey(sdl.SCANCODE_W, true); }
  if k == PK_LOOP + 106u64 { pushKey(sdl.SCANCODE_W, false); pushKey(sdl.SCANCODE_LSHIFT, false); }
  if k == PK_LOOP + 136u64 { pushKey(sdl.SCANCODE_LSHIFT, true); pushKey(SCANCODE_DOWN, true); }
  if k == PK_LOOP + 246u64 { pushKey(SCANCODE_DOWN, false); pushKey(sdl.SCANCODE_LSHIFT, false); }
  // The walk: the camera to first person (V); the rest of its keys are walkscript.cone's (they depend on where it has got to)
  if k == PK_WALK + 2u64 { pushKey(SCANCODE_V, true); }
  if k == PK_WALK + 4u64 { pushKey(SCANCODE_V, false); }
}

// (the frames round the crossing are drawn from the real camera, the rig's, which is carried through the glass with the body; the rest
// from a camera the script says)
pub fn portalHasView(opts: &RunOptions, f: u64) bool {
  if !portalIn(opts, f) { return false; }
  if opts.mirrorHold > 0u32 { return true; }
  let k = f - portalFrom(opts);
  !((k >= PK_CROSS + 30u64 && k < PK_CROSS + 80u64) || (k >= PK_BACK + 30u64 && k < PK_BACK + 80u64) || k >= PK_WALK)
}

pub fn portalShotAt(opts: &RunOptions, asm: &Assembly, f: u64) &str {
  if !portalIn(opts, f) || f >= portalScriptEnd(opts) || opts.mirrorHold > 0u32 { return ""; }
  let k = f - portalFrom(opts);
  if k >= PK_WALK { return walkShotAt(asm, f); }
  if k == 60u64 { return "portal-mirror"; }
  if k == 205u64 { return "portal-opening"; }
  if k == 250u64 { return "portal-turning"; }
  if k == 380u64 { return "portal-walks"; }
  if k == PK_CROSS + 41u64 { return "portal-approach"; }
  if k >= PK_CROSS + PK_SEAM && k < PK_CROSS + PK_SEAM + PK_SEAMS {
    let n = k - PK_CROSS - PK_SEAM;
    if n == 0u64 { return "portal-seam-0"; }
    if n == 1u64 { return "portal-seam-1"; }
    if n == 2u64 { return "portal-seam-2"; }
    if n == 3u64 { return "portal-seam-3"; }
    if n == 4u64 { return "portal-seam-4"; }
    if n == 5u64 { return "portal-seam-5"; }
    return "portal-seam-6";
  }
  if k == PK_CROSS + 100u64 { return "portal-through"; }
  if k == PK_CROSS + 195u64 { return "portal-room"; }
  if k == PK_THREAD + 8u64 { return "portal-thread"; }
  if k == PK_BACK + 22u64 { return "portal-back"; }
  if k >= PK_BACK + 52u64 && k < PK_BACK + 57u64 {
    let n = k - PK_BACK - 52u64;
    if n == 0u64 { return "portal-third-0"; }
    if n == 1u64 { return "portal-third-1"; }
    if n == 2u64 { return "portal-third-2"; }
    if n == 3u64 { return "portal-third-3"; }
    return "portal-third-4";
  }
  if k == PK_BACK + 90u64 { return "portal-out"; }
  if k == PK_LOOP + 1u64 { return "loop-a1"; }
  if k == PK_LOOP + 3u64 { return "loop-a"; }
  if k == PK_LOOP + 5u64 { return "loop-b"; }
  if k == PK_LOOP + 11u64 { return "loop-a-near"; }
  if k == PK_LOOP + 60u64 { return "loop-forward"; }
  if k == PK_LOOP + 100u64 { return "loop-forward-after"; }
  if k == PK_LOOP + 200u64 { return "loop-backward"; }
  ""
}

// The camera for frame 'f'
pub fn portalView(st: &mut SimState, f: u64) Pose {
  let isl = &st.land;
  let k = f - portalFrom(&st.opts);
  let eyeY = LAB_FLOOR + 1.6;
  // Held (timing): the mannequin's eyes with the glass in front of them, or turned the other way
  if st.opts.mirrorHold > 0u32 {
    let m = &mut st.cast.beings[1usize];
    if st.opts.mirrorHold == 2u32 { return Pose.look(m.eyes().origin, m.body.yaw + 3.1415927, 0.); }
    return m.eyes();
  }
  if k < PK_CROSS {
    // 4 m behind the mannequin, a little to one side, as the mirror's own first window
    return lookFrom(mirrorAt(isl, 2.6, 1.9, -12.), mirrorAt(isl, 1.5, 1.4, -6.034));
  }
  if k >= PK_THREAD && k < PK_BACK {
    // From the room's far side, looking back along the thread to the door
    return lookFrom(new Vec3(0.7, eyeY, 311.5), new Vec3(0., LAB_FLOOR + 0.3, 300.));
  }
  if k >= PK_LOOP && k < PK_LOOP + 14u64 {
    // Two places 12 m apart in the corridor that will not end, looking along it
    // (a tenth of a metre short of the gate, and the same 12 m back: the second is what the first is shown to be when it is moved;
    // and half a metre short of it, later)
    let z = if k < PK_LOOP + 4u64 { LOOP_GATE_Z - 0.1 } elif k < PK_LOOP + 8u64 { LOOP_GATE_Z - 0.1 - LOOP_BACK } else { LOOP_GATE_Z - 0.5 };
    return lookFrom(new Vec3(LOOP_X, eyeY, z), new Vec3(LOOP_X, eyeY, LOOP_Z1));
  }
  st.cast.beings[1usize].eyes()
}

// A line of the mannequin's whereabouts, for the log
fn portalWhere(st: &SimState, k: u64) {
  let p = st.cast.beings[1usize].body.position;
  print <- "  portal k "; print <- k; print <- ": the mannequin at ("; print <- p.x; print <- ", "; print <- p.y;
  print <- ", "; print <- p.z; print <- ") yaw "; print <- st.cast.beings[1usize].body.yaw; print <- " turn "; print <- st.cast.beings[1usize].intents.turn;
  print <- " crossings "; print <- st.portal.crossings; print <- ", loops "; print <- st.portal.loops;
  print <- ", escapes "; print <- st.portal.escapes; print <- "\n";
}

// The portal's part of frame 'f', after it is presented
pub fn portalDrive(st: &mut SimState, f: u64) {
  let from = portalFrom(&st.opts);
  if f < from || f >= from + PORTAL_FRAMES { return; }
  let k = f - from;
  let ground = groundHeight(&st.land, COTTAGE_X, COTTAGE_Z);
  // Held (timing, '--portal-only --soak N --mirror-hold 1|2'): the glass opened at once, the mannequin before it, its eyes held
  if st.opts.mirrorHold > 0u32 {
    if k == 0u64 {
      st.cast.possess(1usize);
      st.scene.clock.ns = u64.from(nanosOf(MIRROR_NOON));
      st.weather.setNow(st.opts.holdWeather);
      let at = new Vec3(MIRROR_STAND_X, groundHeight(&st.land, MIRROR_STAND_X, MIRROR_STAND_Z), MIRROR_STAND_Z);
      st.cast.beings[1usize].setDown(at, 3.1415927);
      st.portal.openFor(&mut st.cast, 1usize, ground, st.tick);
      // (hold 3: the mannequin in the labyrinth's entrance corridor, facing along it: the frame's cost under the island)
      if st.opts.mirrorHold == 3u32 { st.cast.beings[1usize].setDown(new Vec3(E_X, LAB_FLOOR, MOUTH_Z + 1.5), 3.1415927); }
    }
    return;
  }
  if k == 0u64 {
    st.cast.possess(1usize);
    st.scene.clock.ns = u64.from(nanosOf(MIRROR_NOON));
    st.weather.setNow(st.opts.holdWeather);   // fair, unless '--hold-weather N' (the pictures' fog, looked at in rain)
    st.portal.auto = true;
    let at = new Vec3(MIRROR_STAND_X, groundHeight(&st.land, MIRROR_STAND_X, MIRROR_STAND_Z), MIRROR_STAND_Z);
    st.cast.beings[1usize].setDown(at, 3.1415927);
    print <- "The portal's part: the mannequin set down at ("; print <- at.x; print <- ", "; print <- at.y; print <- ", "; print <- at.z;
    print <- ") facing the glass, still\n";
    return;
  }
  // Phase 0: the glass opens near 3 s after it stands before it
  if k == 215u64 {
    let ok = st.portal.open && st.portal.puppet != NO_ROW;
    print <- "Frame "; print <- f; print <- ", the glass ";
    if st.portal.open { print <- "has opened ("; print <- st.tick - st.portal.openedAt; print <- " ticks ago)"; } else { print <- "is still shut"; }
    print <- ", the reflection is being "; print <- st.portal.puppet;
    if ok { print <- "\n"; } else { print <- " WRONG\n"; st.portalRunOk = false; }
    // (it opened at about the 180th still tick, 3 s after the set-down: 215 less about 182)
    let ago = st.tick - st.portal.openedAt;
    if st.portal.open && (ago > 60u64 || ago < 5u64) {
      print <- "  (opened "; print <- ago; print <- " ticks ago: not near 3 s after) WRONG\n";
      st.portalRunOk = false;
    }
  }
  if k == 380u64 && st.portal.puppet != NO_ROW {
    let p = st.cast.beings[st.portal.puppet].body;
    print <- "Frame "; print <- f; print <- ", the reflection at ("; print <- p.position.x; print <- ", "; print <- p.position.y; print <- ", ";
    print <- p.position.z; print <- "), facing "; print <- p.yaw;
    // It has turned about (its heading near pi) and walked down the corridor (z past the mouth)
    let ok = p.position.z > MOUTH_Z + 2.5 && libc.fabsf(wrapPi(p.yaw - 3.1415927)) < 0.2 && underground(p.position.y);
    if ok { print <- ": it has turned and walked off down the corridor\n"; } else { print <- " WRONG\n"; st.portalRunOk = false; }
  }
  // Phase 1: through the glass
  if k == PK_CROSS {
    let at = new Vec3(GLASS_X, groundHeight(&st.land, GLASS_X, GLASS_Z - 3.), GLASS_Z - 3.);
    st.cast.beings[1usize].setDown(at, 3.1415927);
    print <- "The reflection has gone from the corridor: "; if st.portal.puppet == NO_ROW { print <- "yes\n"; } else { print <- "no WRONG\n"; st.portalRunOk = false; }
    print <- "The mannequin set down 3 m before the glass, to run through it\n";
  }
  // The frame the crossing is in, for the seam's shots
  if k >= PK_CROSS && st.cast.beings[1usize].crossed {
    print <- "  the mannequin went through a gate in frame k = "; print <- k; print <- " (the seam's shots are k = "; print <- PK_CROSS + PK_SEAM;
    print <- " to "; print <- PK_CROSS + PK_SEAM + PK_SEAMS - 1u64; print <- ")\n";
  }
  if k >= PK_CROSS && k < PK_THREAD && (k - PK_CROSS) % 20u64 == 0u64 { portalWhere(st, k); }
  if k == PK_CROSS + 120u64 {
    let inside = underground(st.cast.beings[1usize].body.position.y);
    print <- "Frame "; print <- f; print <- ", the mannequin is ";
    if inside { print <- "in the labyrinth"; } else { print <- "still on the island WRONG"; st.portalRunOk = false; }
    print <- ", through the glass "; print <- st.portal.crossings; print <- " time(s)\n";
    if st.portal.crossings != 1u64 { st.portalRunOk = false; }
  }
  if k == PK_THREAD {
    // The thread: from E to the mannequin
    let n = if st.portal.threads.len() > 0usize { st.portal.threads[0usize].pts.len() } else { 0usize };
    var first = new Vec3(0., 0., 0.);
    if n > 0usize { first = *st.portal.threads[0usize].pts[0usize]; }
    print <- "Ariadne's thread: "; print <- n; print <- " points, from ("; print <- first.x; print <- ", "; print <- first.y; print <- ", ";
    print <- first.z; print <- ")";
    let ok = n >= 2usize && libc.fabsf(first.z - E_Z) < 0.01 && libc.fabsf(first.x - E_X) < 0.01;
    if ok { print <- " from E\n"; } else { print <- " (want some, the first at E) WRONG\n"; st.portalRunOk = false; }
  }
  // Phase 2: back out
  if k == PK_BACK {
    let at = new Vec3(E_X, LAB_FLOOR, MOUTH_Z + 3.);
    st.cast.beings[1usize].setDown(at, 0.);
    print <- "The mannequin set down in the corridor 3 m from its mouth, to run out through it\n";
  }
  if k == PK_BACK + 110u64 {
    let p = st.cast.beings[1usize].body.position;
    let back = !underground(p.y);
    print <- "Frame "; print <- f; print <- ", the mannequin is ";
    if back { print <- "back on the island"; } else { print <- "still in the labyrinth WRONG"; st.portalRunOk = false; }
    print <- " at ("; print <- p.x; print <- ", "; print <- p.y; print <- ", "; print <- p.z; print <- "), through the gates "; print <- st.portal.crossings;
    print <- " time(s)\n";
    if st.portal.crossings != 2u64 { st.portalRunOk = false; }
    // (it stands in front of the pane: at the cottage's back wall, a stride out, facing away from it)
    if !(p.z < GLASS_Z && p.z > GLASS_Z - 4.) { st.portalRunOk = false; print <- "  (not where the glass puts it) WRONG\n"; }
  }
  // Phase 3: the corridor that will not end
  if k == PK_LOOP + 8u64 {
    let at = new Vec3(LOOP_X, LAB_FLOOR, LOOP_GATE_Z - 5.);
    st.cast.beings[1usize].setDown(at, 3.1415927);
    print <- "The mannequin set down in the corridor that will not end, 5 m before its gate, facing it\n";
  }
  if k >= PK_LOOP + 8u64 && k < PK_LOOP + 260u64 && (k - PK_LOOP) % 15u64 == 0u64 { portalWhere(st, k); }
  if k == PK_LOOP + 130u64 {
    print <- "Forward through the gate: sent back "; print <- st.portal.loops; print <- " time(s)";
    if st.portal.loops >= 1u64 { print <- "\n"; } else { print <- " (want 1 or more) WRONG\n"; st.portalRunOk = false; }
    st.portal.mark = st.portal.loops;
  }
  if k == PK_LOOP + 132u64 {
    let at = new Vec3(LOOP_X, LAB_FLOOR, LOOP_GATE_Z - 3.);
    st.cast.beings[1usize].setDown(at, 0.);
    st.portal.escapes = 0u64;
    print <- "The mannequin set down 3 m before the gate, facing back, to walk backwards through it\n";
  }
  if k == PK_LOOP + 250u64 {
    print <- "Backwards through the gate: through "; print <- st.portal.escapes; print <- " time(s), sent back "; print <- st.portal.loops;
    print <- " in all";
    if st.portal.escapes >= 1u64 && st.portal.loops == st.portal.mark { print <- "\n"; }
    else { print <- " (want it through, and none more sent back) WRONG\n"; st.portalRunOk = false; }
  }
  // The walk
  if k >= PK_WALK { walkDrive(st, f, k - PK_WALK); }
}

// Whether the portal's part has held (the script's verdict)
pub fn checkPortalRun(st: &SimState) bool { st.portalRunOk }
