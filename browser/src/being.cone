// Beings and possession: the seam between the user and what the user moves.
//
//   input --> a controller --> a being's intents --> the being steps
//                                                     \--> the view rig, if it is possessed
//
// A BEING is something in the scene that acts: a plain walker (eyes 1.7 m up
// and nothing to see of it) or a mannequin. It is a part (so the scene places
// it and areas sense it) with a body that moves (a Walk: the feet's ground
// point and a yaw; for a mannequin, in addition, a Figure: the skeleton and
// its gait, the kinematic capsule and its parts, mannequin.cone) and, each
// fixed step, the INTENTS it is given: what it means to do this step (walk
// ahead or back, turn, run, jump), not which key was pressed. A being never
// reads input.
//
// A CONTROLLER decides a being's intents. The user's controller reads the
// input package's actions (walk.cone's bindings) and gives intents; later an
// AI controller gives them from the world's logic, a network one from a
// server. Nothing here knows which kind drove a being.
//
// POSSESSION is which being the user's controller drives and the view
// follows: the Cast's 'possessed'. Tab takes the next mannequin over.
//
// THE VIEW RIG is the viewer's, not the being's: it reads the possessed
// being (its eye socket, its place) and makes the camera's pose, in FIRST
// person (at the eyes socket, level with the heading, a half-bobbed height)
// or THIRD (3.2 m behind the heading and above, looking at the chest, pulled
// up out of the ground, smoothed at 9 rad/s). V switches between them; the
// being and the controller are the same either way. The camera draws between
// the rig's last two steps (the scene publishes them in its snapshot).
// A plain walker has only first person.

// How long a being whose health a fall emptied lies before it gets up again
// on the landing beach, seconds
pub const RESPAWN_AFTER: f32 = 2.;
// How high above the ground the shoreline still holds a being (a jump's height,
// and more): above it, a body falling from a platform is not held
const SHORE_REACH: f32 = 2.;

// What a being means to do this step, whoever decided it
pub struct Intents {
  pub ahead: f32;              // -1 (back) to 1 (forward)
  pub turn: f32;               // -1 (right) to 1 (left)
  pub run: bool;
  pub jump: bool;
  pub sit: bool = false;       // the S key is down: sit down on the nearest seat, or stand up from it (a press is the key going down)
  pub hail: bool = false;      // the H key is down: hail

  pub fn none() Intents { Intents(0., 0., false, false) }
}

// A being: its part in the scene, its body after the last step and the one
// before (the picture is drawn between them), the intents it was last given,
// and its figure if it is a mannequin
pub struct Being {
  pub part: PartId;
  pub body: Walk;
  pub before: Walk;
  pub intents: Intents;
  pub figure: Figure;
  pub respawned: bool;         // its last step got it up again on the landing beach
  pub gone: bool;              // its client left: it is not stepped or published
  pub ai: bool;                // a villager (npcs.cone) decides its intents: the user does not possess it
  pub crossed: bool = false;   // its last step took it through a gate (portal.cone) ...
  pub crossShift: Vec3 = Vec3(0., 0., 0.);   // ... and moved it by this
  pub crossGate: u32 = NO_GATE;                  // ... which gate (portal.cone's GATE_...)
  pub crossings: u32 = 0u32;   // gates gone through, counted
  pub creature: bool = false;  // a guard or the Minotaur of the labyrinth (creatures.cone): no target of the zap and the jig

  pub fn make(part: PartId, body: Walk) Being { Being(part, body, body, Intents.none(), Figure.none(), false, false, false) }

  // A mannequin standing at 'at' facing 'yaw', shown by 'figure'
  pub fn mannequin(part: PartId, at: Vec3, yaw: f32, figure: Figure) Being {
    let body = Walk.make(at, yaw);
    Being(part, body, body, Intents.none(), figure, false, false, false)
  }

  // One fixed step of 'dt' seconds, by 'given'
  pub fn step(self: &mut, phys: &mut Phys, given: Intents, dt: f32) {
    intents = given;
    before = body;
    respawned = false;
    crossed = false;
    if figure.active {
      // (A fall that empties its health is a ragdoll's: it lies, then is set down on the landing beach, ragdoll.cone)
      figure.step(phys, &mut body, if figure.health <= 0. { Intents.none() } else { given }, dt);
      // Held by the island's wading limit, the shoreline (it slides along it),
      // but only on or near the ground (walking, or a jump): a body a platform
      // carries is not stopped by it, and one that falls from high up lands
      // where it falls, in the water or not (and walks out from there). (Not under the island: the labyrinth has no shore.)
      if figure.on.isNone() && !underground(body.position.y)
        && body.position.y - groundHeight(&phys.island, body.position.x, body.position.z) < SHORE_REACH {
        body.position = islandConstrain(&phys.island, before.position, body.position);
      }
      body.eyeHeight = figure.eyeModel().y;
      self.throughGate(phys);
    } else {
      body.step(&phys.island, intents.ahead, intents.turn, intents.run, dt);
    }
  }

  // After a step: if the eye went through a gate (portal.cone) the being is moved by the gate's shift, its gait's planted feet and the
  // drawn place with it (so that nothing is drawn across the move), and the step is noted for the camera ('crossed')
  fn throughGate(self: &mut, phys: &mut Phys) {
    if phys.portals.gates.len() == 0usize { return; }
    // The eye is the figure's eye socket (the first-person camera's place: a little ahead of the body's middle), so the camera and the
    // crossing agree
    let eye = figure.eyeModel();
    let g = phys.portals.crossing(before.position + Quat.angleAxis(before.yaw, Vec3(0., 1., 0.)) * eye,
      body.position + Quat.angleAxis(body.yaw, Vec3(0., 1., 0.)) * eye, body.yaw);
    if g == NO_GATE { return; }
    let shift = phys.portals.gates[usize.from(g)].shift;
    let c = Carry(body.position, body.position + shift, Mat4.identity());
    body.position = body.position + shift;
    before = body;
    figure.carried(&c, 0.);
    figure.anchored = false;
    figure.ch.teleport(body.position);
    crossed = true;
    crossShift = shift;
    crossGate = g;
    crossings = crossings + 1u32;
  }

  // After the physics world's step (the simulation's alone): a limp or getting-up figure's pose from the ragdoll,
  // what its landing cost, its lying and getting up, and its setting down on the beach if it is dead
  pub fn afterWorld(self: &mut, phys: &mut Phys, dt: f32) {
    if !figure.active || figure.mode == FIG_WALK || !phys.authority { return; }
    let was = body;
    figure.landed = false;
    if ragdollTurn(phys, &mut figure, &mut body, dt) { respawned = true; }
    before = if respawned { body } else { was };
    body.eyeHeight = figure.eyeModel().y;
  }

  // A mannequin set down standing at 'at' facing 'yaw' (a script's hook):
  // its gait started afresh, the picture not drawn from where it was
  pub fn setDown(self: &mut, at: Vec3, yaw: f32) {
    if figure.active {
      figure.setDown(&mut body, at, yaw);
    } else {
      // A plain walker has no figure to reset: put there, and counted, so the view can tell a set-down from a misprediction
      figure.setDowns = figure.setDowns + 1u32;
      body.position = at;
      body.yaw = yaw;
    }
    before = body;
  }

  // Where its eyes are after the last step: a plain walker's, or the
  // figure's eye socket, level and facing its heading
  pub fn eyes(self: &) Pose {
    if !figure.active { return body.pose(); }
    let yq = Quat.angleAxis(body.yaw, Vec3(0., 1., 0.));
    Pose.look(body.position + yq * figure.eyeModel(), body.yaw, 0.)
  }

  // Where its feet are, as a placement in the world (facing its yaw)
  pub fn placement(self: &) Transform3 {
    bodyPlacement(body.position, body.yaw)
  }
}

// The user's controller: the input package's actions turned into intents
pub struct UserController {
  pub actions: WalkActions;

  pub fn bind(ctx: &mut Context) UserController { UserController(WalkActions.bind(ctx)) }

  // This frame's intents, from the actions
  // The view's pitch keys this frame: PageUp 1 (look up) to PageDown -1
  pub fn lookKeys(self: &, ctx: &Context) f32 { clampUnit(ctx.axis1(actions.look)) }

  // The view's pitch change this frame from the mouse, in radians: a drag
  // upward with the right button held looks up
  pub fn lookDrag(self: &, ctx: &Context) f32 { 0. - ctx.axis2(actions.drag).y * LOOK_PER_UNIT }

  pub fn intents(self: &, ctx: &Context) Intents {
    var it = Intents(clampUnit(ctx.axis1(actions.move)), clampUnit(ctx.axis1(actions.turn)), ctx.down(actions.run),
      ctx.down(actions.jump));
    it.sit = ctx.down(actions.sit);
    it.hail = ctx.down(actions.hail);
    it
  }
}

// First person: the camera at the eyes socket
pub const VIEW_FIRST = 0u32;
// Third person: behind and above
pub const VIEW_THIRD = 1u32;

// The view's pitch: radians a window unit of mouse drag turns it, how fast
// PageUp/PageDown turn it (rad/s), and how far from level it may go (80 degrees)
pub const LOOK_PER_UNIT = 0.004f;
pub const LOOK_KEY_RATE = 1.2f;
pub const LOOK_LIMIT = 1.3962634f;

// How far behind the third-person camera is, and how far above the chest: high enough to look down
// about 20 degrees, so the person being hailed is in view over the avatar's shoulder (EverQuest's follow camera)
pub const THIRD_BEHIND = 3.2f;
pub const THIRD_ABOVE = 1.15f;
// The radius of the sphere the camera is swept as (the near plane's reach and a margin)
pub const CAMERA_RADIUS = 0.25f;

// The viewer: first or third person on whichever being is possessed
pub struct ViewRig {
  pub mode: u32;
  pub before: Pose;            // the camera at the step before the last
  pub now: Pose;               // and at the last
  cam: Vec3;                   // the third-person camera's smoothed place
  eyeY: f32;                   // the first-person eye's smoothed height
  fresh: bool;                 // the next update snaps to its target
  pub pitch: f32;              // the user's look up (+) or down (-), radians, added to the view's own; 0 is as it was

  pub fn make(mode: u32) ViewRig {
    let still = Pose.look(Vec3(0., 0., 0.), 0., 0.);
    ViewRig(mode, still, still, Vec3(0., 0., 0.), 0., true, 0.)
  }

  // Look up (+) or down (-) by 'd' radians, held short of straight up or down
  pub fn tilt(self: &mut, d: f32) {
    pitch = clampPitch(pitch + d);
  }

  pub fn toggle(self: &mut) { mode = if mode == VIEW_FIRST { VIEW_THIRD } else { VIEW_FIRST }; fresh = true; }

  // Forget the smoothing: the next update puts the camera where it belongs
  pub fn snap(self: &mut) { fresh = true; }

  // Carried with the being it follows by a platform's move (support.cone):
  // both poses and the third person's smoothed place moved and turned with
  // it, the first person's smoothed height raised with it, so the camera
  // keeps its place on the ride instead of trailing behind it
  pub fn carried(self: &mut, c: &Carry, yaw: f32) {
    let q = Quat.angleAxis(yaw, Vec3(0., 1., 0.));
    before = Pose(c.point(before.origin), q * before.orientation);
    now = Pose(c.point(now.origin), q * now.orientation);
    cam = c.point(cam);
    eyeY = eyeY + (c.now.y - c.was.y);
  }

  // The camera for being 'b' after its step of 'dt' seconds
  pub fn update(self: &mut, phys: &mut Phys, b: &Being, dt: f32) {
    let isl = &phys.island;
    var target = b.eyes();
    if b.figure.active {
      let yaw = b.body.yaw;
      let k = 1. - libc.expf(-9. * dt);
      if mode == VIEW_FIRST {
        // Level with the heading; the height follows the head at 18 Hz,
        // so the walk's bob is half what the head does
        let eye = target.origin;
        eyeY = if fresh { eye.y } else { eyeY + (eye.y - eyeY) * (1. - libc.expf(-18. * dt)) };
        target = Pose.look(Vec3(eye.x, eyeY, eye.z), yaw, clampPitch(pitch));
      } else {
        let h = b.figure.height;
        let chest = b.body.position + Vec3(0., 0.80 * h, 0.);
        let fx = 0. - sin(yaw);
        let fz = 0. - cos(yaw);
        var want = Vec3(chest.x - fx * THIRD_BEHIND, chest.y + THIRD_ABOVE, chest.z - fz * THIRD_BEHIND);
        // (pulled up out of the ground; under the island the ground is 300 m overhead and the labyrinth's floor is the level)
        let floor = if underground(chest.y) { LAB_Y + 0.35 } else { groundHeight(isl, want.x, want.z) + 0.35 };
        if want.y < floor { want = Vec3(want.x, floor, want.z); }
        cam = if fresh { want } else { cam + (want - cam) * k };
        // The wall clamp: a sphere cast from the head to the camera's smoothed place; the camera is put where the sphere stops, at once
        // (and eases out again at the smoothing's rate once the way is clear), so it is never in a wall, including after a crossing
        // has carried it (the looking-glass's) to a place behind the cottage's wall
        cam = phys.clampCamera(b.body.position + Vec3(0., h * 0.92, 0.), cam, CAMERA_RADIUS);
        let d = chest - cam;
        let flat = libc.sqrtf(d.x * d.x + d.z * d.z);
        target = Pose.look(cam, libc.atan2f(0. - d.x, 0. - d.z), clampPitch(libc.atan2f(d.y, flat) + pitch));
      }
    } elif pitch != 0. {
      // The plain walker's eyes, tilted
      target = Pose.look(target.origin, b.body.yaw, clampPitch(pitch));
    }
    before = if fresh { target } else { now };
    now = target;
    fresh = false;
  }
}

// The view rig carried through the gate that being 'b' just went through (portal.cone): its poses and its smoothed place moved by
// the gate's shift, as a platform carries it (a translation: no turn), so the camera goes through with the body and nothing is
// drawn across the move
fn carryRigThrough(rig: &mut ViewRig, b: &Being) {
  let c = Carry(b.body.position - b.crossShift, b.body.position, Mat4.identity());
  rig.carried(&c, 0.);
}

fn clampPitch(p: f32) f32 {
  if p > LOOK_LIMIT { return LOOK_LIMIT; }
  if p < 0. - LOOK_LIMIT { return 0. - LOOK_LIMIT; }
  p
}

// A hard landing reported by a step: whose, how fast, what it cost
pub struct Landing {
  pub part: PartId;
  pub speed: f32;
  pub damage: f32;
}

// The beings, which one the user possesses, and the view
pub struct Cast {
  pub beings: List[Being];
  pub possessed: usize;
  pub rig: ViewRig;
  pub landings: List[Landing];
  pub phys: Phys;              // the physics world the beings walk in (physics.cone): this half's own
  pub props: Props;            // the bowling pins and ball in that world (props.cone): the simulation's alone, a view's is never made

  // The simulation's cast (it makes the ragdolls)
  pub fn empty(island: Island) Cast {
    Cast(List[Being].empty(), 0usize, ViewRig.make(VIEW_THIRD), List[Landing].empty(), Phys.make(true, island), Props.empty())
  }
  // A view's cast: its physics world is a read-only copy for predicting the being it drives
  pub fn client(island: Island) Cast {
    Cast(List[Being].empty(), 0usize, ViewRig.make(VIEW_THIRD), List[Landing].empty(), Phys.make(false, island), Props.empty())
  }

  // A being added: its index
  pub fn add(self: &mut, b: Being) usize {
    beings.push(b);
    beings.len() - 1usize
  }

  // The user takes being 'i' over: its intents are the user's controller's
  // from the next step, and the view follows it
  pub fn possess(self: &mut, i: usize) {
    if i < beings.len() { possessed = i; rig.snap(); }
  }

  // The user takes the next mannequin over (the first after the possessed
  // one, wrapping round); the same one if there is no other
  pub fn swap(self: &mut) {
    var k = 1usize;
    while k <= beings.len() {
      let j = (possessed + k) % beings.len();
      if beings[j].figure.active && !beings[j].ai { self.possess(j); return; }
      k = k + 1usize;
    }
  }

  // The possessed being
  pub fn you(self: &) &Being { beings[possessed] }

  // One fixed step of every being: the possessed one by the user's
  // 'intents', the others standing (no controller of their own yet); then
  // the view; hard landings noted
  pub fn step(self: &mut, user: Intents, dt: f32) {
    var moved = false;
    self.markSeats();
    var i = 0usize;
    while i < beings.len() {
      let b = &mut beings[i];
      b.step(&mut phys, if i == possessed { user } else { Intents.none() }, dt);
      if b.crossed && i == possessed { carryRigThrough(&mut rig, b); }
      if b.figure.active && b.figure.landed && b.figure.landSpeed >= HARD_LANDING_SPEED {
        landings.push(Landing(b.part, b.figure.landSpeed, b.figure.damageOf(b.figure.landSpeed)));
      }
      if b.respawned && i == possessed { moved = true; }
      i = i + 1usize;
    }
    if self.worldTurn(dt, possessed) { moved = true; }
    // The camera goes with a possessed being that got up somewhere else
    if moved { rig.snap(); }
    self.look(dt);
  }

  // The physics world's step for the ragdolls, and each limp figure's turn after it; hard landings noted. True if the
  // possessed being was set down somewhere else
  fn worldTurn(self: &mut, dt: f32, snapFor: usize) bool {
    if !phys.authority { return false; }
    phys.stepRagdolls(dt, propsAwake(&phys, &props));
    propsStep(&mut phys, &mut props, dt);
    var moved = false;
    var i = 0usize;
    while i < beings.len() {
      let b = &mut beings[i];
      if !b.gone && b.figure.active {
        // One that stands again (set down by a script, say) lets its ragdoll go
        if b.figure.mode == FIG_WALK && b.figure.rag >= 0i32 && phys.rigs[usize.from(u32.from(b.figure.rag))].active {
          parkSlot(&mut phys, usize.from(u32.from(b.figure.rag)));
        }
        b.respawned = false;
        b.afterWorld(&mut phys, dt);
        if b.figure.mode != FIG_WALK && b.figure.landed && b.figure.landSpeed >= HARD_LANDING_SPEED {
          landings.push(Landing(b.part, b.figure.landSpeed, b.figure.damageOf(b.figure.landSpeed)));
        }
        if b.respawned && i == snapFor { moved = true; }
      }
      i = i + 1usize;
    }
    moved
  }

  // One fixed step of every being by the intents of its own: 'given[i]' for being i. A being whose 'stepIt[i]'
  // is false stays as it is this step (its client's input has not arrived), and one that has gone is not
  // stepped. The view follows the possessed one if 'withView'; hard landings noted
  pub fn stepEach(self: &mut, given: &List[Intents], stepIt: &List[bool], dt: f32, withView: bool) {
    var moved = false;
    self.markSeats();
    var i = 0usize;
    while i < beings.len() {
      let b = &mut beings[i];
      if !b.gone && *stepIt[i] {
        b.step(&mut phys, *given[i], dt);
        if b.crossed && i == possessed { carryRigThrough(&mut rig, b); }
        if b.figure.active && b.figure.landed && b.figure.landSpeed >= HARD_LANDING_SPEED {
          landings.push(Landing(b.part, b.figure.landSpeed, b.figure.damageOf(b.figure.landSpeed)));
        }
        if b.respawned && i == possessed { moved = true; }
      }
      i = i + 1usize;
    }
    if self.worldTurn(dt, possessed) { moved = true; }
    if withView {
      if moved { rig.snap(); }
      self.look(dt);
    }
  }

  // The world's seats marked taken by the beings that are going to or on one (found afresh before each step: a being that has gone, or
  // stood up, frees its seat)
  fn markSeats(self: &mut) {
    if phys.seats.len() == 0usize { return; }
    var s = 0usize;
    while s < phys.seats.len() { phys.seats[s].taken = false; s = s + 1usize; }
    var i = 0usize;
    while i < beings.len() {
      let f = &beings[i].figure;
      if !beings[i].gone && f.active && f.seat >= 0i32 { phys.takeSeat(usize.from(u32.from(f.seat))); }
      i = i + 1usize;
    }
  }

  // The view brought to the possessed being as it stands (also before any step)
  pub fn look(self: &mut, dt: f32) {
    if beings.len() > 0usize {
      let y = &mut beings[possessed];
      rig.update(&mut phys, y, dt);
    }
  }

  // The hard landings since the last call; the list is left empty
  pub fn takeLandings(self: &mut) List[Landing] {
    var out = List[Landing].empty();
    out <=> landings;
    out
  }

  // The camera after the last step, and after the one before
  pub fn eyes(self: &) Pose { rig.now }
  pub fn eyesBefore(self: &) Pose { rig.before }
}
