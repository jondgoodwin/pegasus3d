// The --checks of the solids (support.cone: trunks, rocks, the cottage's walls and
// chimney that stop a body; its porch deck and steps and a low rock that it
// climbs): a capsule walked into each on flat ground, and the world's own
// solids read off the baked island.

// What the capsule's skin and the heightfield's triangles (not the drawn mesh's) let a stop or a height differ by, metres
const SKIN_SLACK f32 = 0.01;

// A being 'w' walked 'seconds' by 'it' in fixed steps
fn walkFor(c &mut Cast, seconds f32, it Intents) {
  mut k = 0;
  imm n = i32.from(seconds * 60.);
  while k < n { c.step(it, 1. / 60.); k = k + 1; }
}

// A walker put down at 'at' facing 'yaw', possessed
fn putWalker(s &mut Scene, c &mut Cast, at Vec3, yaw f32) usize {
  imm w = c.add(mannequinBeing(s, "walker", at, 1.75, 9u32));
  c.possess(w);
  c.beings[w].body.yaw = yaw;
  c.beings[w].before = c.beings[w].body;
  w;
}

fn checkSolids() bool {
  print <- "Solids (flat ground):\n";
  imm go = new Intents(1., 0., false, false);
  imm still = Intents.none();
  mut ok = true;
  mut s = Scene.empty();
  mut c = Cast.empty();
  imm w = putWalker(&mut s, &mut c, new Vec3(0., 0., 0.), 0.);
  imm r = c.beings[w].figure.radius();

  // A trunk 0.3 m in radius, 5 m ahead: walked into head on, and off centre (it slides round, never in)
  mut list = List[Solid].empty();
  list.push(Solid.circle(0., -5., 0.3, -6., 40.));
  c.phys.setSolids(&list);
  walkFor(&mut c, 4., go);
  imm atTrunk = c.beings[w].body.position;
  print <- "  (walked at a trunk: stopped at z "; print <- atTrunk.z; print <- ", its face at -4.7, the radius "; print <- r; print <- ")\n";
  ok = expect("a tree trunk stops it, its radius off the trunk's face (and the capsule's skin), on the ground",
    nearly(atTrunk.z, -5. + 0.3 + r, SKIN_SLACK) and nearly(atTrunk.y, 0., SKIN_SLACK) and c.beings[w].figure.grounded) and ok;
  c.beings[w].setDown(new Vec3(0.12, 0., 0.), 0.);
  mut nearest = 1000.;
  mut k = 0;
  while k < 360 {
    c.step(go, 1. / 60.);
    imm p = c.beings[w].body.position;
    imm d = ((p.x * p.x) + (p.z + 5.) * (p.z + 5.)).sqrt();
    if d < nearest { nearest = d; }
    k = k + 1;
  }
  ok = expect("walked into off its centre it slides along the trunk and never gets closer than the trunk and its radius",
    nearest > 0.3 + r - 0.003 and c.beings[w].body.position.z < -5.) and ok;

  // A tall rock (0.55 m: more than a step) is a wall; a low one (0.3 m) is a step to climb onto and cross
  list.clear();
  list.push(Solid.circle(3., -5., 0.5, -6., 0.55));
  list.push(Solid.circle(-3., -5., 0.5, -6., 0.3));
  c.phys.setSolids(&list);
  c.beings[w].setDown(new Vec3(3., 0., 0.), 0.);
  walkFor(&mut c, 4., go);
  imm atRock = c.beings[w].body.position;
  ok = expect("a tall rock stops it at its footprint's edge and its radius",
    nearly(atRock.z, -5. + 0.5 + r, SKIN_SLACK) and nearly(atRock.y, 0., SKIN_SLACK)) and ok;
  c.beings[w].setDown(new Vec3(-3., 0., 0.), 0.);
  mut onTop = 0.;
  k = 0;
  while k < 400 {
    c.step(go, 1. / 60.);
    if c.beings[w].body.position.y > onTop { onTop = c.beings[w].body.position.y; }
    k = k + 1;
  }
  ok = expect("a low rock is climbed (stood on at its height) and crossed, and it ends on the ground beyond",
    nearly(onTop, 0.3, SKIN_SLACK) and c.beings[w].body.position.z < -5.6 and nearly(c.beings[w].body.position.y, 0., SKIN_SLACK)) and ok;

  // The cottage at the origin: its front wall on z = 0, the main block 5.4 m wide to z = -6, the chimney
  // up its right wall at z = -3, the porch deck 0.6 m up from z = 0 to 1.6 (x -2.4 to 2.7), and two steps
  list.clear();
  cottageSolids(new Vec3(0., 0., 0.), &mut list);
  c.phys.setSolids(&list);
  // A wall: walked at from the east at z = -5, facing -x
  c.beings[w].setDown(new Vec3(6., 0., -5.), 0.5 * pi);
  c.beings[w].before = c.beings[w].body;
  walkFor(&mut c, 4., go);
  imm atWall = c.beings[w].body.position;
  print <- "  (walked at the east wall: stopped at x "; print <- atWall.x; print <- ", the wall at 2.7)\n";
  ok = expect("the cottage's wall stops it, its radius outside the wall", nearly(atWall.x, 2.7 + r, SKIN_SLACK) and nearly(atWall.y, 0., SKIN_SLACK)) and ok;
  c.beings[w].setDown(new Vec3(6., 0., -3.), 0.5 * pi);
  c.beings[w].before = c.beings[w].body;
  walkFor(&mut c, 4., go);
  imm atChimney = c.beings[w].body.position;
  ok = expect("so does the chimney, further out (3.36)", nearly(atChimney.x, 3.3625 + r, SKIN_SLACK) and nearly(atChimney.y, 0., SKIN_SLACK)) and ok;
  // The back wall, from behind, and the wing's far end
  c.beings[w].setDown(new Vec3(0., 0., -10.), pi);
  c.beings[w].before = c.beings[w].body;
  walkFor(&mut c, 4., go);
  ok = expect("and the back wall (z = -6)", nearly(c.beings[w].body.position.z, -6. - r, SKIN_SLACK)) and ok;
  c.beings[w].setDown(new Vec3(-9., 0., -3.), 0. - 0.5 * pi);
  c.beings[w].before = c.beings[w].body;
  walkFor(&mut c, 4., go);
  ok = expect("and the wing's far end (x = -5.3)", nearly(c.beings[w].body.position.x, -5.3 - r, SKIN_SLACK)) and ok;

  // The steps: walked up from the lawn, facing the door
  c.beings[w].setDown(new Vec3(0.05, 0., 6.), 0.);
  c.beings[w].before = c.beings[w].body;
  mut climbed = 0.;
  mut levels Array[bool, 3] = [false, false, false];
  k = 0;
  while k < 600 {
    c.step(go, 1. / 60.);
    imm y = c.beings[w].body.position.y;
    if y > climbed { climbed = y; }
    if nearly(y, 0.2, SKIN_SLACK) { levels[0usize] = true; }
    if nearly(y, 0.4, SKIN_SLACK) { levels[1usize] = true; }
    if nearly(y, 0.6, SKIN_SLACK) { levels[2usize] = true; }
    k = k + 1;
  }
  imm onDeck = c.beings[w].body.position;
  print <- "  (walked up the steps and across the deck to z "; print <- onDeck.z; print <- ", at "; print <- onDeck.y; print <- " m)\n";
  ok = expect("walking up the steps it stands on each in turn (0.2, 0.4 m) and then on the deck at 0.6 m",
    levels[0usize] and levels[1usize] and levels[2usize]) and ok;
  ok = expect("and crosses the deck to the front wall and stops there, at deck height, on its feet",
    nearly(onDeck.z, r, SKIN_SLACK) and nearly(onDeck.y, 0.6, SKIN_SLACK) and c.beings[w].figure.grounded and nearly(climbed, 0.6, SKIN_SLACK)) and ok;
  // Walked off the deck's east end (open): it falls 0.6 m to the ground and goes on
  c.beings[w].setDown(new Vec3(0., 0.6, 0.8), 0. - 0.5 * pi);
  c.beings[w].before = c.beings[w].body;
  mut leftDeck = false;
  k = 0;
  while k < 360 {
    c.step(go, 1. / 60.);
    if !c.beings[w].figure.grounded { leftDeck = true; }
    k = k + 1;
  }
  imm past = c.beings[w].body.position;
  ok = expect("walked off the deck's open end it leaves the deck, falls and walks on the ground beyond",
    leftDeck and past.x > 2.7 + r and nearly(past.y, 0., SKIN_SLACK) and c.beings[w].figure.grounded) and ok;
  // Seen from the ground the deck is a wall (0.6 m is more than a step): walked at from the east at z = 1
  c.beings[w].setDown(new Vec3(6., 0., 1.), 0.5 * pi);
  c.beings[w].before = c.beings[w].body;
  walkFor(&mut c, 4., go);
  ok = expect("the deck's end seen from the ground is a wall: it stops there, on the ground",
    nearly(c.beings[w].body.position.x, 2.7 + r, SKIN_SLACK) and nearly(c.beings[w].body.position.y, 0., SKIN_SLACK)) and ok;
  ok = expect("the cottage is six solids, no more (the posts, the pots and the lantern stakes are passable)", list.len() == 6usize) and ok;
  list.clear();
  c.phys.setSolids(&list);
  ok;
}

// The world's own solids on the baked island: one for each trunk and rock, built from the
// layout's own numbers, trunk radii that match grown trees, and none across the path or the lawn route
fn checkWorldSolids() bool {
  print <- "The world's solids:\n";
  bakeIsland();
  imm items = vegetationLayout();
  imm solids = worldSolids();
  mut trees = 0usize;
  mut rocks = 0usize;
  mut i = 0usize;
  while i < items.len() {
    if items[i].kind == K_SPECIMEN or items[i].kind == K_MAPLE or items[i].kind == K_PINE { trees = trees + 1usize; }
    if items[i].kind == K_ROCK { rocks = rocks + 1usize; }
    i = i + 1usize;
  }
  print <- "  ("; print <- trees; print <- " trees and "; print <- rocks; print <- " rocks laid out, "; print <- solids.len(); print <- " solids)\n";
  mut ok = expect("one solid for each tree and each rock, the cottage's six (its block, wing, chimney, deck and two steps) and the bridge's nine",
    solids.len() == trees + rocks + 6usize + BRIDGE_SOLIDS);
  // Each trunk's radius against a tree grown in full
  mut worst = 0.;
  mut kind = 0u32;
  while kind < 3u32 {
    imm k = if kind == 0u32 { K_SPECIMEN; } elif kind == 1u32 { K_MAPLE; } else { K_PINE; };
    imm n = if kind == 0u32 { SPECIMEN_VARIANTS; } elif kind == 1u32 { MAPLE_VARIANTS; } else { PINE_VARIANTS; };
    mut v = 0u32;
    while v < n {
      imm formula = trunkRadiusAt1(k, v);
      imm grown = grownTrunkRadius(k, v);
      print <- "  (kind "; print <- k; print <- " variant "; print <- v; print <- ": trunk radius "; print <- formula; print <- " m by the parameters, ";
      print <- grown; print <- " m grown, 1 m up)\n";
      imm off = libc.fabsf(formula - grown) / grown;
      if off > worst { worst = off; }
      v = v + 1u32;
    }
    kind = kind + 1u32;
  }
  ok = expect("the trunk radius worked out from the parameters is within 3 percent of a grown tree's", worst < 0.03) and ok;
  ok;
}

// How far (x, z) is from the solid's shape, metres (negative inside it)
fn clearanceFrom(s Solid, x f32, z f32) f32 {
  if s.kind == SOLID_CIRCLE {
    imm dx = x - s.x0;
    imm dz = z - s.z0;
    return (dx * dx + dz * dz).sqrt() - s.x1;
  }
  imm nx = if x < s.x0 { s.x0; } elif x > s.x1 { s.x1; } else { x; };
  imm nz = if z < s.z0 { s.z0; } elif z > s.z1 { s.z1; } else { z; };
  imm dx = x - nx;
  imm dz = z - nz;
  (dx * dx + dz * dz).sqrt();
}

// The scripted route's ground stays open: the path's centreline from the beach to the steps and the lawn
// route round the cottage's east end, each point at least a capsule's radius (0.2625 m for 1.75 m) clear of every
// solid that is not a step (the porch's deck and steps are the way in, not an obstacle)
fn checkRoutesClear() bool {
  print <- "The routes against the solids:\n";
  bakeIsland();
  imm solids = worldSolids();
  imm line = pathCentreline();
  mut worst = 1000.;
  mut worstAt = new Vec2(0., 0.);
  mut at = 0usize;
  mut k = 0usize;
  while k < line.len() {
    imm p = *line[k];
    mut i = 0usize;
    while i < solids.len() {
      imm c = clearanceFrom(*solids[i], p.x, p.z);
      // The steps' own end: the path comes to them
      if c < worst and solids[i].y1 - groundHeight(p.x, p.z) > STEP_UP { worst = c; worstAt = new Vec2(p.x, p.z); at = i; }
      i = i + 1usize;
    }
    k = k + 1usize;
  }
  print <- "  (the path's nearest solid: "; print <- worst; print <- " m from its centreline, at ("; print <- worstAt.x; print <- ", ";
  print <- worstAt.y; print <- "), solid "; print <- at; print <- ")\n";
  mut ok = expect("no solid within a capsule's radius of the path's centreline", worst > 0.2625) and true;
  mut lawn = 1000.;
  mut j = 0usize;
  while j < LAWN_ROUTE_N {
    imm q = lawnRouteAt(j);
    mut i = 0usize;
    // (the bridge's solids are the last: the lawn route crosses them on its deck)
    while i + BRIDGE_SOLIDS < solids.len() {
      imm c = clearanceFrom(*solids[i], q.x, q.y);
      if c < lawn and solids[i].y1 - groundHeight(q.x, q.y) > STEP_UP { lawn = c; }
      i = i + 1usize;
    }
    j = j + 1usize;
  }
  print <- "  (the lawn route's nearest solid: "; print <- lawn; print <- " m)\n";
  ok = expect("and none within a capsule's radius of the lawn route's points", lawn > 0.2625) and ok;
  ok;
}

// The ground's rise over run at (x, z), by differences either side (as island.cone's groundSlope)
fn slopeAt(x f32, z f32) f32 {
  imm dx = (groundHeight(x + 1., z) - groundHeight(x - 1., z)) * 0.5;
  imm dz = (groundHeight(x, z + 1.) - groundHeight(x, z - 1.)) * 0.5;
  (dx * dx + dz * dz).sqrt();
}

// The maximum walkable slope (45 degrees): a mannequin put at the foot of the island's steepest hillside and walked
// straight up it climbs no ground steeper than that, where the old support code walked up any slope
fn checkSlopeLimit() bool {
  print <- "The slope limit:\n";
  bakeIsland();
  // The steepest ground in the hill's flank (the walkable island is flatter; the hill beyond the fence is out of bounds
  // to walkers but not to a fall)
  mut best = 0.;
  mut bx = 0.;
  mut bz = 0.;
  mut x = -180.;
  while x <= 180. {
    mut z = 20.;
    while z <= 280. {
      imm sl = slopeAt(x, z);
      if sl > best { best = sl; bx = x; bz = z; }
      z = z + 4.;
    }
    x = x + 4.;
  }
  print <- "  (the steepest ground in the hill's flank: "; print <- best; print <- " rise over run at ("; print <- bx; print <- ", "; print <- bz; print <- "))\n";
  mut ok = expect("the hill has ground steeper than 45 degrees (rise over run 1), so the limit is tested", best > 1.05);
  if best <= 1.05 { return ok; }
  // Uphill there, and a start 14 m down it
  imm gx = (groundHeight(bx + 1., bz) - groundHeight(bx - 1., bz)) * 0.5;
  imm gz = (groundHeight(bx, bz + 1.) - groundHeight(bx, bz - 1.)) * 0.5;
  imm gl = (gx * gx + gz * gz).sqrt();
  imm ux = gx / gl;
  imm uz = gz / gl;
  mut s = Scene.empty();
  mut c = Cast.empty();
  c.phys.ensureGround();
  imm start = new Vec3(bx - ux * 14., groundHeight(bx - ux * 14., bz - uz * 14.), bz - uz * 14.);
  imm w = putWalker(&mut s, &mut c, start, libc.atan2f(0. - ux, 0. - uz));
  imm go = new Intents(1., 0., true, false);
  mut steepest = 0.;
  mut climbedSteep = 0.;
  mut last = c.beings[w].body.position;
  mut k = 0;
  while k < 1200 {
    c.step(go, 1. / 60.);
    imm p = c.beings[w].body.position;
    imm sl = slopeAt(p.x, p.z);
    if sl > steepest and c.beings[w].figure.grounded { steepest = sl; }
    // Height gained on ground steeper than 49 degrees
    if sl > 1.15 and p.y > last.y { climbedSteep = climbedSteep + (p.y - last.y); }
    last = p;
    k = k + 1;
  }
  imm end = c.beings[w].body.position;
  imm along = (end.x - start.x) * ux + (end.z - start.z) * uz;
  print <- "  (ran 20 s at the steep face from 14 m below it: "; print <- along; print <- " m along it, at "; print <- end.y - start.y;
  print <- " m up; stood on ground at most "; print <- steepest; print <- " steep; climbed "; print <- climbedSteep; print <- " m of ground steeper than 1.15)\n";
  ok = expect("it never stood on ground steeper than 45 degrees (1.0 rise over run, within the heightfield's triangles: 1.1)", steepest < 1.1) and ok;
  ok = expect("and gained no more than a step (0.4 m) of height on ground steeper than 49 degrees", climbedSteep < 0.4) and ok;
  ok;
}

// What the solids cost: the world's own 211 solids tested for a body at a spot on the path and at the cottage,
// timed (information; no verdict)
fn timeSolids() {
  bakeIsland();
  imm list = worldSolids();
  imm hz = f64.from(sdl.GetPerformanceFrequency());
  imm n = 6000;
  imm line = pathCentreline();
  mut s = Scene.empty();
  mut c = Cast.empty();
  c.phys.ensureGround();
  c.phys.setSolids(&list);
  // A walker put on the path's first point and walked up the path, the character controller's step timed
  imm p0 = *line[0usize];
  imm w = putWalker(&mut s, &mut c, p0, 0.);
  imm go = new Intents(1., 0., false, false);
  mut k = 0;
  imm t0 = sdl.GetPerformanceCounter();
  while k < n {
    c.beings[w].figure.step(&mut c.phys, &mut c.beings[w].body, go, 1. / 60.);
    k = k + 1;
  }
  imm t1 = sdl.GetPerformanceCounter();
  print <- "  (cost of a mannequin's step with the world's "; print <- list.len(); print <- " solids and the island: ";
  print <- f64.from(t1 - t0) / hz / f64.from(n) * 1000000d; print <- " us a step, walking "; print <- n; print <- " steps)\n";
  mut none = List[Solid].empty();
  c.phys.setSolids(&none);
  c.beings[w].setDown(p0, 0.);
  imm t3 = sdl.GetPerformanceCounter();
  k = 0;
  while k < n {
    c.beings[w].figure.step(&mut c.phys, &mut c.beings[w].body, go, 1. / 60.);
    k = k + 1;
  }
  imm t4 = sdl.GetPerformanceCounter();
  print <- "  (the same walk with no solids: "; print <- f64.from(t4 - t3) / hz / f64.from(n) * 1000000d; print <- " us a step)\n";
  // The character controller's own step (what replaced hitWalls, hitSolids and the footprint's five height queries), with the solids
  c.phys.setSolids(&list);
  c.beings[w].setDown(p0, 0.);
  c.beings[w].figure.ch.pos = p0;
  imm wish = new Vec3(0., 0., -1.8);
  imm t5 = sdl.GetPerformanceCounter();
  k = 0;
  while k < n {
    rigiddynamics.updateCharacter(&mut c.phys.w, &mut c.beings[w].figure.ch, wish, 0., 1. / 60.);
    k = k + 1;
  }
  imm t6 = sdl.GetPerformanceCounter();
  print <- "  (updateCharacter alone, walking the path with the solids: "; print <- f64.from(t6 - t5) / hz / f64.from(n) * 1000000d; print <- " us a step)\n";
}

// The real porch on the real ground: a walker set down on the lawn 6 m in front of the door walks up the steps
// and onto the deck (the ground there is not level, so the steps' heights are met as built)
fn checkRealPorch() bool {
  print <- "The real porch:\n";
  bakeIsland();
  imm list = worldSolids();
  imm at = placeXZ(COTTAGE);
  imm base = groundHeight(at.x, at.y);
  mut s = Scene.empty();
  mut c = Cast.empty();
  c.phys.ensureGround();
  c.phys.setSolids(&list);
  imm w = putWalker(&mut s, &mut c, new Vec3(at.x + 0.05, groundHeight(at.x + 0.05, at.y + 6.), at.y + 6.), 0.);
  walkFor(&mut c, 10., new Intents(1., 0., false, false));
  imm p = c.beings[w].body.position;
  print <- "  (walked from 6 m out to z "; print <- p.z - at.y; print <- " in the cottage's frame, at "; print <- p.y - base; print <- " m above its ground)\n";
  mut ok = expect("on the real ground the walker climbs the steps and stands on the deck at 0.6 m, at the front wall",
    nearly(p.y, base + PORCH_FLOOR, SKIN_SLACK) and c.beings[w].figure.grounded and nearly(p.z, at.y + c.beings[w].figure.radius(), SKIN_SLACK)) and true;
  ok;
}
