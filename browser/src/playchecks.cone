// The playground's checks (run by --checks): the site is clear, a being set down is not drawn stretched, the bowl scatters pins and they
// come back, the spells do what they say, and the wire carries them.

fn cap1(x f32) f32 { if x > 1. { 1. } else { x } }

// The distance from (x, z) to the nearest solid's edge (0 inside one)
fn solidGap(solids &List[Solid], x f32, z f32) f32 {
  var best = 1000.;
  var i = 0usize;
  while i < solids.len() {
    let s = *solids[i];
    var d = 1000.;
    if s.kind == SOLID_CIRCLE {
      let dx = x - s.x0;
      let dz = z - s.z0;
      d = libc.sqrtf(dx * dx + dz * dz) - s.x1;
    } else {
      let cx = if x < s.x0 { s.x0 } elif x > s.x1 { s.x1 } else { x };
      let cz = if z < s.z0 { s.z0 } elif z > s.z1 { s.z1 } else { z };
      let dx = x - cx;
      let dz = z - cz;
      d = libc.sqrtf(dx * dx + dz * dz);
    }
    if d < best { best = d; }
    i = i + 1usize;
  }
  if best < 0. { 0. } else { best }
}

// A rack at (rx, rz) with the lane running in direction yaw 'yaw': how clear the lane's strip and the rack are. The height range over
// the strip (metres) and the least gap to any solid, with the balloon's spot's distance
fn siteScore(isl &Island, solids &List[Solid], rx f32, rz f32, yaw f32, range &mut f32, gap &mut f32) {
  let dx = 0. - libc.sinf(yaw);
  let dz = 0. - libc.cosf(yaw);
  let rxv = 0. - dz;
  let rzv = dx;
  var lo = 1000.;
  var hi = -1000.;
  var g = 1000.;
  var along = 0. - 12.;
  while along <= 4. {
    var across = -2.;
    while across <= 2. {
      let x = rx + dx * along + rxv * across;
      let z = rz + dz * along + rzv * across;
      let h = groundHeight(isl, x, z);
      if h < lo { lo = h; }
      if h > hi { hi = h; }
      let sg = solidGap(solids, x, z);
      if sg < g { g = sg; }
      across = across + 0.5;
    }
    along = along + 0.5;
  }
  *range = hi - lo;
  *gap = g;
}

// The lawn the lane and the rack stand on is flat and clear
fn checkSite(isl &Island) bool {
  print <- "The playground's site:\n";
  let solids = worldSolids(isl);
  var range = 0.;
  var gap = 0.;
  siteScore(isl, &solids, RACK_X, RACK_Z, LANE_YAW, &mut range, &mut gap);
  let balloon = placeXZ(BALLOON);
  let bx = RACK_X - balloon.x;
  let bz = RACK_Z - balloon.y;
  let away = libc.sqrtf(bx * bx + bz * bz);
  print <- "  (the lane and rack: ground varying "; print <- range; print <- " m, "; print <- gap; print <- " m from the nearest solid, ";
  print <- away; print <- " m from the balloon)\n";
  var ok = expect("the lane (12 m before the apex to 4 m past it, 4 m across) is flat to 45 cm", range < 0.45);
  ok = expect("and 3 m clear of every solid", gap > 3.) and ok;
  ok = expect("the rack is more than 12 m from the balloon, so it rises clear", away > 12.) and ok;
  // The navigation window of the villagers starts at z 290: the lane is inside it, so a villager can be brought here
  ok = expect("the lane's head and the pins are inside the villagers' navigation window", ballHomeSpot().y > 291. and pinSpot(9usize).y > 291.) and ok;
  ok
}

// The most any bone of the being's pose is from its origin, over the next 'steps' steps of walking
fn worstReach(c &mut Cast, w usize, steps i32) f32 {
  let go = new Intents(1., 0., false, false);
  var worst = 0.;
  var k = 0;
  while k < steps {
    c.step(go, 1. / 60.);
    let r = c.beings[w].figure.reach();
    if r > worst { worst = r; }
    k = k + 1;
  }
  worst
}

// A being set down far away is not drawn stretched: the gait's feet are made where it stands (walkgait's stand), not at the world's origin
fn checkSetDownPose(isl &Island) bool {
  print <- "A being set down:\n";
  var s = Scene.empty();
  var c = Cast.empty(isl.share());
  c.phys.ensureGround();
  let start = new Vec3(BEACH_X, groundHeight(isl, BEACH_X, BEACH_Z), BEACH_Z);
  let w = putWalker(&mut s, &mut c, start, 0.);
  let before = worstReach(&mut c, w, 240);
  // Up on the lawn by the cottage, 150 m away and 4 m higher, mid-stride
  let there = new Vec3(-9., groundHeight(isl, -9., 342.), 342.);
  c.beings[w].setDown(there, 1.);
  let after = worstReach(&mut c, w, 240);
  print <- "  (walking: no bone farther than "; print <- before; print <- " m from the figure's origin; for 4 s after the set-down "; print <- after; print <- " m)\n";
  var ok = expect("walking, no bone is farther from the figure than 1.9 m", before < 1.9);
  ok = expect("for four seconds after it is set down 150 m away, still none (it was 3 to 4 m, walking, before the gait began its feet at their places)", after < 1.9) and ok;
  // A figure made late and walking at once (a villager is) is the same
  var s2 = Scene.empty();
  var c2 = Cast.empty(isl.share());
  c2.phys.ensureGround();
  let w2 = putWalker(&mut s2, &mut c2, there, 0.);
  let fresh = worstReach(&mut c2, w2, 240);
  ok = expect("and a figure made on the lawn and walking at once", fresh < 1.9) and ok;
  ok
}

// The ball bowled down the lane scatters the pins; they come back a few seconds after they settle
fn checkBowling(isl &Island) bool {
  print <- "Bowling:\n";
  var c = Cast.empty(isl.share());
  let solids = worldSolids(isl);
  c.phys.ensureGround();
  c.phys.setSolids(&solids);
  propsEnsure(&mut c.phys, &mut c.props);
  var ok = expect("ten pins and a ball, asleep at home: nothing in the snapshot", c.props.made and !c.props.moved);
  var k = 0;
  while k < 120 { c.step(Intents.none(), 1. / 60.); k = k + 1; }
  var snap = List[PropState].empty();
  propsSnapshot(&c.phys, &c.props, &mut snap);
  ok = expect("two seconds on, still asleep and still not in the snapshot", snap.len() == 0usize) and ok;
  // Bowled from the lane's head at the apex pin
  let headSpot = ballHomeSpot();
  let apex = pinSpot(0usize);
  let feet = new Vec3(headSpot.x - 1., groundHeight(isl, headSpot.x - 1., headSpot.y), headSpot.y);
  let aim = new Vec3(apex.x, groundHeight(isl, apex.x, apex.y), apex.y);
  propsBowl(&mut c.phys, &mut c.props, feet, aim);
  var fallen = 0u32;
  var farthest = 0.;
  var contactAt = -1.;
  var glideAt = -1.;
  var homeAt = -1.;
  var maxSpeed = 0.;
  var snapshotAlways = true;
  var lastLive = -1.;
  var ballRest = new Vec3(0., 0., 0.);
  k = 0;
  while k < 60 * 40 {
    c.step(Intents.none(), 1. / 60.);
    let t = f32.from(k + 1) / 60.;
    var f = 0u32;
    let far = pinsDisturbed(&c.phys, &c.props, &mut f);
    if far > 0.05 and contactAt < 0. { contactAt = t; }
    if f > fallen { fallen = f; }
    if far > farthest { farthest = far; }
    let sp = propSpeedOf(&c.phys, &c.props, PROP_BALL);
    if sp > maxSpeed { maxSpeed = sp; }
    if propsAwake(&c.phys, &c.props) { lastLive = t; }
    if propsGliding(&c.props) and glideAt < 0. {
      glideAt = t;
      ballRest = propPoseOf(&c.phys, &c.props, PROP_BALL).pos;
    }
    if glideAt > 0. and homeAt < 0. and propsAllHome(&c.props) { homeAt = t; }
    // Once any has moved, all eleven are in every snapshot
    var sn = List[PropState].empty();
    propsSnapshot(&c.phys, &c.props, &mut sn);
    if sn.len() != PROP_COUNT { snapshotAlways = false; }
    k = k + 1;
  }
  print <- "  (the ball rolled at up to "; print <- maxSpeed; print <- " m/s; the first pin moved at "; print <- contactAt; print <- " s; "; print <- fallen;
  print <- " pins fell, the farthest "; print <- farthest; print <- " m from its place; the last body slept at "; print <- lastLive; print <- " s, the glide home began at ";
  print <- glideAt; print <- " s and ended at "; print <- homeAt; print <- " s; the ball lay at ("; print <- ballRest.x; print <- ", "; print <- ballRest.y;
  print <- ", "; print <- ballRest.z; print <- "), "; print <- ballRest.y - groundHeight(isl, ballRest.x, ballRest.z); print <- " m above the ground there)\n";
  ok = expect("the ball came to rest on the ground, west of the pins, within 40 m of the apex", ballRest.x < apex.x and ballRest.x > apex.x - 40.
    and libc.fabsf(ballRest.y - groundHeight(isl, ballRest.x, ballRest.z) - BALL_RADIUS) < 0.3) and ok;
  ok = expect("the ball is bowled at 13 m/s", maxSpeed > 12. and maxSpeed < 14.) and ok;
  ok = expect("it scatters the pins: at least four fall over and one is thrown 2 m or more", fallen >= 4u32 and farthest > 2.) and ok;
  ok = expect("every prop is in every snapshot once one has moved", snapshotAlways) and ok;
  ok = expect("the pins are put back after the last body has slept for 5 s (and not before)", glideAt > lastLive + 4.9 and glideAt < lastLive + 5.5) and ok;
  ok = expect("they glide for 1.4 s and are home, asleep", homeAt > glideAt + 1.39 and homeAt < glideAt + 1.6 and c.props.resets == 1u32) and ok;
  var fell = 0u32;
  let leftover = pinsDisturbed(&c.phys, &c.props, &mut fell);
  ok = expect("each pin is upright on its spot again, and the ball waits at the lane's head", leftover < 0.002 and fell == 0u32) and ok;
  let ballPose = propPoseOf(&c.phys, &c.props, PROP_BALL);
  let ballHome = propHomeOf(&c.props, PROP_BALL);
  ok = expect("the ball is at its home", (ballPose.pos - ballHome).length() < 0.002) and ok;
  // Bowled again at once, it is taken back and bowled: a second reset follows
  propsBowl(&mut c.phys, &mut c.props, feet, aim);
  k = 0;
  while k < 60 * 30 { c.step(Intents.none(), 1. / 60.); k = k + 1; }
  ok = expect("a second bowl is reset the same way", c.props.resets == 2u32 and c.props.bowls == 2u32 and propsAllHome(&c.props)) and ok;
  ok
}

// The spells, played in the simulation: the paintball's ray stops at what is in its way, and a zap and a jig need a target in the open
fn checkSpells(isl &Island) bool {
  print <- "The spells:\n";
  var s = Scene.empty();
  var c = Cast.empty(isl.share());
  c.phys.ensureGround();
  // A wall of a solid between the caster and a third being, nothing between it and the second
  let gx = -24.;
  let gz = 310.;
  let a = putWalker(&mut s, &mut c, new Vec3(gx, groundHeight(isl, gx, gz), gz), 0.);
  let b = c.add(mannequinBeing(&mut s, "target", new Vec3(gx - 6., groundHeight(isl, gx - 6., gz), gz), 1.75, 4u32));
  let far = c.add(mannequinBeing(&mut s, "far", new Vec3(gx, groundHeight(isl, gx, gz + 31.), gz + 31.), 1.75, 5u32));
  let hidden = c.add(mannequinBeing(&mut s, "hidden", new Vec3(gx + 8., groundHeight(isl, gx + 8., gz), gz), 1.75, 6u32));
  var walls = List[Solid].empty();
  walls.push(Solid.circle(gx + 4., gz, 0.5, groundHeight(isl, gx + 4., gz) - 2., groundHeight(isl, gx + 4., gz) + 5.));
  c.phys.setSolids(&walls);
  var clients = List[Client].empty();
  clients.push(Client.make(1u32, a));
  var play = PlaySim.empty();
  let head = c.beings[a].body.position + new Vec3(0., 1.64, 0.);
  var ok = true;
  // Paint at the target's chest from 6 m: on the being, in its own frame
  let chest = c.beings[b].body.position + new Vec3(0., 1.2, 0.);
  let toB = (chest - head).normalize();
  play.receive(1u32, PLAY_SPELL, SPELL_PAINT, NO_TARGET, head, toB);
  playApply(&mut play, &mut c, 100u64, &clients);
  ok = expect("paint at a being's chest is a burst on that being", play.bursts.len() == 1usize and play.bursts[0usize].kind == BURST_PAINT
    and play.bursts[0usize].being == u32.from(b)) and ok;
  if play.bursts.len() == 1usize {
    let bu = play.bursts[0usize];
    print <- "  (the splat at ("; print <- bu.position.x; print <- ", "; print <- bu.position.y; print <- ", "; print <- bu.position.z; print <- ") in its frame, normal (";
    print <- bu.normal.x; print <- ", "; print <- bu.normal.y; print <- ", "; print <- bu.normal.z; print <- "))\n";
    ok = expect("in the being's own frame (within its body: a hand of its middle, 1 m up), facing the caster", libc.fabsf(bu.position.x) < 0.4
      and libc.fabsf(bu.position.z) < 0.4 and bu.position.y > 0.8 and bu.position.y < 1.5 and bu.normal.dot(new Vec3(1., 0., 0.)) > 0.5) and ok;
  }
  play.bursts.clear();
  // Paint at the ground ahead: a world splat on the ground
  let toGround = new Vec3(0.6, -0.8, 0.).normalize();
  play.receive(1u32, PLAY_SPELL, SPELL_PAINT, NO_TARGET, head, toGround);
  playApply(&mut play, &mut c, 101u64, &clients);
  ok = expect("paint at the ground is a burst on the world, on the ground, facing up", play.bursts.len() == 1usize and play.bursts[0usize].being == NO_TARGET
    and libc.fabsf(play.bursts[0usize].position.y - groundHeight(isl, play.bursts[0usize].position.x, play.bursts[0usize].position.z)) < 0.2
    and play.bursts[0usize].normal.y > 0.6) and ok;
  play.bursts.clear();
  // Paint at the being behind the wall (+x): stopped by the solid, on the world, not on that being
  let toHidden = (c.beings[hidden].body.position + new Vec3(0., 1.2, 0.) - head).normalize();
  play.receive(1u32, PLAY_SPELL, SPELL_PAINT, NO_TARGET, head, toHidden);
  playApply(&mut play, &mut c, 102u64, &clients);
  ok = expect("paint at a being behind a trunk is stopped by the trunk (a world splat 4 m away, not on that being)", play.bursts.len() == 1usize
    and play.bursts[0usize].being == NO_TARGET and libc.fabsf(play.bursts[0usize].position.x - (gx + 3.5)) < 0.6) and ok;
  play.bursts.clear();
  // Beyond its range: 30 m, no splat
  let toFar = (c.beings[far].body.position + new Vec3(0., 1.2, 0.) - head).normalize();
  play.receive(1u32, PLAY_SPELL, SPELL_PAINT, NO_TARGET, head, toFar);
  playApply(&mut play, &mut c, 103u64, &clients);
  ok = expect("paint at a being 31 m off does not reach it (30 m): no splat", play.bursts.len() == 0usize) and ok;
  // A client that is nobody's cannot act
  play.receive(9u32, PLAY_SPELL, SPELL_PAINT, NO_TARGET, head, toB);
  playApply(&mut play, &mut c, 104u64, &clients);
  ok = expect("an action from a connection with no being is refused", play.bursts.len() == 0usize and play.refused == 1u32) and ok;
  // The zap: needs a target in the open
  play.receive(1u32, PLAY_SPELL, SPELL_ZAP, u32.from(hidden), head, toHidden);
  playApply(&mut play, &mut c, 105u64, &clients);
  ok = expect("a zap at a being behind a trunk is refused (no clear line)", play.fx.len() == 0usize and play.refused == 2u32) and ok;
  play.receive(1u32, PLAY_SPELL, SPELL_ZAP, u32.from(far), head, toFar);
  playApply(&mut play, &mut c, 106u64, &clients);
  ok = expect("and at one 31 m away is refused (25 m)", play.fx.len() == 0usize and play.refused == 3u32) and ok;
  play.receive(1u32, PLAY_SPELL, SPELL_ZAP, u32.from(a), head, toB);
  playApply(&mut play, &mut c, 106u64, &clients);
  ok = expect("and at oneself", play.fx.len() == 0usize and play.refused == 4u32) and ok;
  play.receive(1u32, PLAY_SPELL, SPELL_ZAP, u32.from(b), head, toB);
  playApply(&mut play, &mut c, 120u64, &clients);
  ok = expect("a zap at the being in the open is in force on it, with a crack for every view", play.fx.len() == 1usize and play.fxOf(u32.from(b)) == FX_ZAP
    and c.beings[b].figure.fxKind == FX_ZAP and play.bursts.len() == 1usize and play.bursts[0usize].kind == BURST_ZAP) and ok;
  // It lasts a second: the being is held, its pose jerks, and it lapses
  var given = List[Intents].empty();
  var g = 0usize;
  while g < c.beings.len() { given.push(new Intents(1., 0., false, false)); g = g + 1usize; }
  playHold(&mut play, &mut given, 121u64);
  ok = expect("while it lasts the being's intents are none (the others' are not)", given[b].ahead == 0. and given[a].ahead == 1.) and ok;
  var jerked = 0.;
  var base = c.beings[b].figure.pose.locals[bonepose.UPPER_ARM_L].rotation;
  var k = 0;
  while k < 90 {
    c.step(Intents.none(), 1. / 60.);
    let r = c.beings[b].figure.pose.locals[bonepose.UPPER_ARM_L].rotation;
    let d = 1. - libc.fabsf(r.x * base.x + r.y * base.y + r.z * base.z + r.w * base.w);
    if k < 40 and d > jerked { jerked = d; }
    k = k + 1;
  }
  ok = expect("its arm is thrown about by 20 degrees or more in the first 0.7 s", jerked > 0.015) and ok;
  ok = expect("and after a second the pose is the gait's again", c.beings[b].figure.fxKind == FX_NONE) and ok;
  playHold(&mut play, &mut given, 120u64 + 61u64);
  ok = expect("the spell is lifted from the list after its second", play.fx.len() == 0usize) and ok;
  // The jig
  play.receive(1u32, PLAY_SPELL, SPELL_JIG, u32.from(b), head, toB);
  playApply(&mut play, &mut c, 300u64, &clients);
  ok = expect("a jig at the being is in force on it", play.fxOf(u32.from(b)) == FX_JIG and c.beings[b].figure.fxKind == FX_JIG) and ok;
  var lift = 0.;
  var pelvisMax = 0.;
  var kneeMax = 0.;
  k = 0;
  while k < 150 {
    c.step(Intents.none(), 1. / 60.);
    {
      let th = c.beings[b].figure.pose.locals[bonepose.THIGH_L].rotation;
      let tr = c.beings[b].figure.pose.locals[bonepose.THIGH_R].rotation;
      let ang = 2. * libc.acosf(cap1(libc.fabsf(th.w)));
      let angR = 2. * libc.acosf(cap1(libc.fabsf(tr.w)));
      if ang > kneeMax { kneeMax = ang; }
      if angR > kneeMax { kneeMax = angR; }
    }
    let arm = c.beings[b].figure.pose.locals[bonepose.UPPER_ARM_L].rotation;
    let armAng = 2. * libc.acosf(cap1(libc.fabsf(arm.w)));
    if armAng > lift { lift = armAng; }
    k = k + 1;
  }
  print <- "  (the jig: arm raised up to "; print <- lift; print <- " rad, a knee lifted up to "; print <- kneeMax; print <- " rad)\n";
  ok = expect("the arms swing up (more than 1 rad) and a knee comes up (more than 0.5 rad)", lift > 1. and kneeMax > 0.5) and ok;
  ok
}

pub fn checkPlayground(isl &Island) bool {
  var ok = checkSite(isl);
  ok = checkSetDownPose(isl) and ok;
  ok = checkBowling(isl) and ok;
  ok = checkSpells(isl) and ok;
  ok
}
