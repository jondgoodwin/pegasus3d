// Request to play: asking the island's owner to let this machine join. Two ways in, one piece of code:
//   `browser --request-play [--name NAME] [--message TEXT]` asks, prints the answer and ends, and
//   the "Play with others" panel in the browser (requestpanel.cone, key F9 or J) asks from a thread of its own.
// Either sends one HTTPS POST to https://cone.jondgoodwin.com/play/request (name, an optional one-line message, and the token
// this machine was given when it was approved, if any). See SERVER.md.
//
//   The body is text/plain, at most 1 KB: line 1 the name, line 2 the message, line 3 the token (empty: none).
//   The answer is text: "sent" (waiting for approval), "approved", or "approved" and a line "token HEX" (the first request
//   from the approved address: the token is kept in the per-user app data folder, in play-token.txt as "name" and "token"
//   lines, and sent with every later request under that name, which is how an approved player's new address is let in).
//   A request with no token is never approved by itself: the owner approves it by hand.
//
// Method: httpclient's fetchWhole (one fetch, the loop driven until it ends), the OS's own certificate check (tls).
//
// For tests only, two environment variables: PEGASUS_REQUEST_URL (another address to post to: a stub on this machine) and
// PEGASUS_PLAY_DIR (another folder for play-token.txt, so that a test never touches the user's own token).

const REQUEST_URL = "https://cone.jondgoodwin.com/play/request";

// The island server's address, as `--connect` takes it (a dotted address and the game's UDP port)
pub const JOIN_ADDRESS = "40.87.21.70:40000";

// Where the panel's Join dials: JOIN_ADDRESS; for a test, PEGASUS_JOIN_ADDRESS (a server on this machine). An automated run
// with no such variable dials a port on this machine that nothing listens on, so that no script ever joins the live server.
pub fn joinAddress(automated: bool) String {
  let raw = libc.getenv("PEGASUS_JOIN_ADDRESS");
  if (raw as usize) != 0usize {
    let own = String.fromCStr(cstr.fromPtr(raw));
    if own.len() > 0usize { return own; }
  }
  String.from(if automated { "127.0.0.1:9" } else { JOIN_ADDRESS })
}

// How an ask ended
pub const ANS_SENT = 0u32;          // waiting for the owner's approval
pub const ANS_APPROVED = 1u32;
pub const ANS_ERROR = 2u32;

// The answer to one request, ready to show: 'text' is the line to tell the user, 'note' what happened to a token (or empty)
pub struct PlayAnswer is Sendable {
  pub kind: u32;
  pub text: String;
  pub note: String;
}

// The address to post to
fn requestUrl() String {
  let raw = libc.getenv("PEGASUS_REQUEST_URL");
  if (raw as usize) != 0usize {
    let own = String.fromCStr(cstr.fromPtr(raw));
    if own.len() > 0usize { return own; }
  }
  String.from(REQUEST_URL)
}

// The folder the token lives in: %LOCALAPPDATA%\pegasus3d on Windows, else ~/.local/share/pegasus3d. Empty: none to be had.
fn tokenFolder() Path {
  var base = String.empty();
  let own = libc.getenv("PEGASUS_PLAY_DIR");
  if (own as usize) != 0usize {
    let dir = String.fromCStr(cstr.fromPtr(own));
    if dir.len() > 0usize { return Path.from(dir.view()); }
  }
  var raw = libc.getenv("LOCALAPPDATA");
  if (raw as usize) != 0usize {
    base = String.fromCStr(cstr.fromPtr(raw));
  } else {
    raw = libc.getenv("HOME");
    if (raw as usize) != 0usize {
      base = String.fromCStr(cstr.fromPtr(raw));
      base.append("/.local/share");
    }
  }
  if base.len() == 0usize { return Path.from(""); }
  Path.from(base.view()).join("pegasus3d")
}

// The name stored with the token (the name this machine was approved under), or an empty string
pub fn storedName() String {
  let dir = tokenFolder();
  if dir.isEmpty() { return String.empty(); }
  let file = dir.join("play-token.txt");
  match fs.readFile(&file) {
    case let Ok(text) {
      let lines = text.split(10u8);
      if lines.len() >= 2usize { return lines[0].trim(); }
    }
    else {}
  }
  String.empty()
}

// The token stored for 'name' (letters' case ignored), or an empty string
fn storedToken(name: &str) String {
  let dir = tokenFolder();
  if dir.isEmpty() { return String.empty(); }
  let file = dir.join("play-token.txt");
  match fs.readFile(&file) {
    case let Ok(text) {
      let lines = text.split(10u8);
      if lines.len() >= 2usize && lines[0].trim().equalsIgnoreAsciiCase(name) { return lines[1].trim(); }
    }
    else {}
  }
  String.empty()
}

// Whether a token is stored for any name (this machine has been approved at some time)
pub fn hasStoredToken() bool {
  let name = storedName();
  name.len() > 0usize && storedToken(name.view()).len() > 0usize
}

// Whether the text starts with 'prefix'
fn hasPrefix(s: &String, prefix: &str) bool {
  let a: &Array[u8] = s.view();
  let p: &Array[u8] = prefix;
  if a.len < p.len { return false; }
  var i = 0usize;
  while i < p.len {
    if a[i] != p[i] { return false; }
    i = i + 1usize;
  }
  true
}

fn saveToken(name: &str, token: &str) bool {
  let dir = tokenFolder();
  if dir.isEmpty() { return false; }
  match fs.makeDirAll(&dir) { else {} }
  let file = dir.join("play-token.txt");
  var text = String.from(name);
  text.append("\n");
  text.append(token);
  text.append("\n");
  match fs.writeFile(&file, text.view()) {
    case is Ok { return true; }
    else {}
  }
  false
}

// A line of text with its control characters (a newline above all) made spaces, so that it stays one line
fn oneLine(s: &str) String {
  var out = String.empty();
  let b: &Array[u8] = s;
  var i = 0usize;
  while i < b.len && out.len() < 200usize {
    let c = b[i];
    out.appendByte(if c < 32u8 { 32u8 } else { c });
    i = i + 1usize;
  }
  out.trim()
}

fn failed(text: String) PlayAnswer { PlayAnswer(ANS_ERROR, text, String.empty()) }

// Sends the request and answers what happened. It waits for the server (a second or two, a long time when the server does
// not answer): never call it from a frame, but from a thread of its own, or from the command line.
pub fn askToPlay(name: &str, message: &str, address: &str) PlayAnswer {
  let token = storedToken(name);
  var body = String.from(name);
  body.append("\n");
  body.append(oneLine(message).view());
  body.append("\n");
  body.append(token.view());
  let url = if address.len() > 0usize { String.from(address) } else { requestUrl() };
  var req = httpclient.Request.make("POST", url.view());
  req.body = body;
  var lp = Loop.mustMake();
  var client = httpclient.Client.make(httpclient.Config.make());
  var resp = client.fetchWhole(&mut lp, req, 2048usize);
  client.abortAll(&mut lp);
  if !resp.isOk() {
    var t = String.from("Could not reach the server: ");
    t.append(resp.failure.message().view());
    return failed(t);
  }
  let status = u32.from(resp.status);
  let answer = resp.body.split(10u8);
  if status == 429u32 { return failed(String.from("Too many requests from this address; try again in a minute.")); }
  if status != 200u32 {
    var t = String.from("The server said ");
    t.appendUInt(u64.from(status));
    return failed(t);
  }
  var approved = false;
  var note = String.empty();
  var i = 0usize;
  while i < answer.len() {
    let line = answer[i].trim();
    if hasPrefix(&line, "approved") { approved = true; }
    if hasPrefix(&line, "token ") {
      let t = line.sub(6usize, line.len());
      note = String.from(if saveToken(name, t.view()) { "Token saved." } else { "Could not save the token." });
    }
    i = i + 1usize;
  }
  if approved { return PlayAnswer(ANS_APPROVED, String.from("You are approved. You can join now."), note); }
  PlayAnswer(ANS_SENT, String.from("Request sent; you'll be able to join once it's approved."), note)
}

// Sends the request and prints what happened; the process's exit code (0: the answer was sent or approved)
fn requestPlay(name: &str, message: &str) i32 {
  let a = askToPlay(name, message, "");
  if a.note.len() > 0usize { print <- a.note.view(); print <- "\n"; }
  print <- a.text.view(); print <- "\n";
  if a.kind == ANS_ERROR { 1i32 } else { 0i32 }
}
