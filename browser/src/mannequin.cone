// The mannequin: an artist's wooden figure, one smooth skinned body.
//
// THE BODY is one mesh lofted along the bones of the bonepose humanoid as it
// stands in its rest pose (sculpt's loftAlong): the trunk, neck and head one
// tube of elliptical rings from the crotch to the crown; each leg one tube
// from inside the pelvis through the knee to the ankle; each arm one tube
// from inside the shoulder through the elbow to the wrist; a flat-soled foot
// and a mitten hand; a small nose to show which way the head faces. The
// limbs' tops are buried in the trunk, so the figure reads as one surface.
// It is SKINNED (render's linear blend skinning, on the GPU): every vertex's
// weights are written once, at build time, from where it is along its
// piece's chain of bones (its nearest point on the bone segments): wholly
// its bone's along a bone, blended by a smoothstep across a zone either
// side of a joint (the knee, the elbow, the waist), so a joint bends as one
// smooth surface. The upper chest blends towards each clavicle, the head,
// hands and feet are wholly their bones'. The head is part of the skin
// (wholly the head bone's, so it moves as a rigid piece would) rather than
// a part of its own on the head socket: one part, one draw.
//
// The being's own part is shown as the body; each step the figure's pose
// becomes its skinning matrices (each bone's posed model transform times
// the inverse of its rest one), sent as a Bones request. The skeleton, the
// gait, the capsule, the view rig, possession and the sockets are as they
// were with one rigid piece a bone.
//
// A FIGURE is what a mannequin being is made of besides its place in the
// world (Being.body, a Walk: the feet's ground point and the yaw):
//   - the skeleton, its pose and the model-space transforms of the pose;
//   - the inverse of each bone's rest (bind) transform, for skinning;
//   - the Walker (gait state: phase, feet, pelvis, idle layer, crouch);
//   - the kinematic capsule: vertical speed, gravity, grounded or falling,
//     the landing and what it cost;
//   - rigid attachments, parts of their own (none yet).
//
// THE CAPSULE is rigiddynamics' character controller (a kinematic capsule, not a
// rigid body) walking the physics world (physics.cone): the island's ground as a
// heightfield, the solids, and the platforms' floors and walls (the balloon's
// basket). It slides along walls, climbs steps of 0.4 m, will not walk up
// ground steeper than 45 degrees (it slides down it), stays stuck to the
// ground going down within 0.35 m, and otherwise falls under gravity (9.81
// m/s^2, at most 55 m/s) until the ground is reached, which is a landing at
// the impact speed. Standing on a platform it is carried by it (support.cone),
// held up only by the floor. A landing of 7 m/s or more is HARD: the pelvis
// crouches (the Walker's impact) and the cast reports it to the scene, which
// mails it. Its cost is a number in the being's own state, health, by
// (speed - 10) / (24 - 10) clamped to 0 to 1 of it: harmless to 10 m/s (a 5 m
// drop), fatal at 24 m/s (a 30 m drop). A fall faster than 5 m/s down (a drop
// of 1.3 m) goes limp instead: a ragdoll (ragdoll.cone), whose landing is
// what hurts.

fn clamp01(x: f32) f32 {
  if x < 0. { return 0.; }
  if x > 1. { return 1.; }
  x
}

// The capsule's radius is 0.15 H; its height is H
pub const CAPSULE_RADIUS_OVER_H = 0.15f;

pub const GRAVITY = 9.81f;
pub const TERMINAL_SPEED = 55.f;
pub const HARD_LANDING_SPEED = 7.f;
pub const STEP_UP = 0.4f;
pub const CAPSULE_SKIN = 0.004f;       // the gap the capsule keeps from what it stands on and walks against, m
pub const SNAP_DOWN = 0.35f;
pub const WALK_SPEED = 1.8f;           // m/s: a purposeful walk, under the walk-run change at 2.1
pub const RUN_SPEED = 4.5f;
pub const GROUND_ACCEL = 12.f;         // m/s^2
pub const JUMP_SPEED = 4.2f;           // m/s up: a jump to 0.9 m
pub const TURN_RATE = 1.0471976f;      // rad/s: the same quarter turn in 1.5 s as the walker

// A figure's mode: walking (the capsule), a ragdoll falling or lying, getting up from one (ragdoll.cone)
pub const FIG_WALK = 0u32;
pub const FIG_RAG = 1u32;
pub const FIG_GETUP = 2u32;
// Sitting down on a seat, seated, or getting up from it (the simulation's and a view's own: it is not a mode the snapshot names: its
// BeingState says the seat and how far the sit is)
pub const FIG_SIT = 3u32;

// The phases of going to a seat and sitting on it (Figure.sitPhase)
pub const SIT_NONE = 0u32;
pub const SIT_APPROACH = 1u32;        // walking to where the feet stand before the seat, then turning to the seat's way
pub const SIT_DOWN = 2u32;
pub const SIT_SEATED = 3u32;
pub const SIT_UP = 4u32;
// How long sitting down, and standing up, take (humanbody's sit-to-stand: about 1.7 s), and how long a hail lasts
pub const SIT_SECONDS = 1.7f;
pub const HAIL_SECONDS = 3.0f;
// How far from the place in front of a seat a being may press S and be taken to it, metres; and how long it is given to get there
pub const SEAT_REACH = 2.8f;
pub const SEAT_APPROACH_SECONDS = 7.f;

// The kinematic capsule of a figure 'h' tall: 0.15 h round, climbing steps of STEP_UP and following the ground
// down within SNAP_DOWN; it collides with the solids, the platforms and the ground, never a ragdoll
fn characterOf(h: f32) rigiddynamics.Character {
  var s = rigiddynamics.CharacterSettings.person(CAPSULE_RADIUS_OVER_H * h, h);
  s.mask = LAYER_WALK;
  s.stepHeight = STEP_UP;
  s.stickDistance = SNAP_DOWN;
  s.skin = CAPSULE_SKIN;
  s.gravity = GRAVITY;
  s.maxFallSpeed = TERMINAL_SPEED;
  s.pushStrength = 0.;
  rigiddynamics.Character.make(s, Vec3(0., 0., 0.))
}

pub struct Figure {
  pub active: bool;                   // false: this being is a plain walker, with no figure
  pub height: f32;
  pub skeleton: bonepose.Skeleton;
  pub pose: bonepose.Pose;
  pub models: List[Transform3];
  pub walker: walkgait.Walker;
  pub parts: List[PartId];             // its rigid attachments' parts (none yet)
  pub bind: List[Mat4];                // each bone's rest transform in model space, inverted
  pub speed: f32;                      // along its heading, m/s
  pub vy: f32;                         // vertical speed, m/s
  pub airVx: f32;                      // horizontal velocity while falling
  pub airVz: f32;
  pub grounded: bool;
  pub health: f32;                     // 1 whole
  pub landed: bool;                    // the last step ended in a landing
  pub landSpeed: f32;                  // at this speed
  pub hardLandings: u32;
  pub on: PartId;                      // the platform it stands on (support.cone); none: the ground, or the air
  pub platformVel: Vec3;               // that platform's velocity where it stands, m/s, the last frame
  pub downFor: f32;                    // seconds since a fall emptied its health (it gets up again: Being.step)
  pub respawns: u32;                   // times it has got up again at the landing
  pub anchor: Vec3;                    // where it stands on its platform, in the platform's frame (support.cone)
  pub anchorAt: Vec3;                  // and where that put it in the world, the last carry
  pub anchored: bool;
  pub landCount: u32;                  // landings (of any speed), counted
  pub setDowns: u32;                   // times it has been set down somewhere (setDown: a respawn, or a script's hook), counted
  pub ch: rigiddynamics.Character;     // the kinematic capsule that walks the physics world (physics.cone)
  pub mode: u32;                       // FIG_WALK, FIG_RAG (a ragdoll), FIG_GETUP (getting up from one): ragdoll.cone
  pub rag: i32;                        // its ragdoll in the physics world (a slot of Phys.rigs), or -1
  pub modeT: f32;                      // seconds in this mode
  pub lieT: f32;                       // seconds the ragdoll has been settled
  pub hurtSpeed: f32;                  // the landing speed its health has been charged for, this fall
  pub fxKind: u32;                     // a spell in force on it (FX_ZAP, FX_JIG), or FX_NONE (spells.cone)
  pub fxT: f32;                        // seconds since it began
  pub fxStart: u64;                    // and the simulation tick it began at (a view sees a new spell by this)
  pub person: u32 = 0xFFFFFFFFu32;     // the person of humanbody's cast it is (personasset.cone), or NO_PERSON: a mannequin
  // Sitting: the S key walks to the nearest seat of the world (Phys.seats: data on parts), turns to its way and sits down on it; S
  // again stands up. 'sitPhase' is SIT_APPROACH (walking to the place in front of the seat, 'sitT' the seconds of it), SIT_DOWN and
  // SIT_UP (the movement, 'sitT' its progress, 0 standing before the seat to 1 seated) or SIT_SEATED. In the three that are
  // the movement, the figure's mode is FIG_SIT and nothing else moves it
  pub seat: i32 = -1;                  // the seat (a Phys.seats row) it goes to or sits on, or -1
  pub sitPhase: u32 = 0u32;
  pub sitT: f32 = 0.;
  pub sitWas: bool = false;            // the S key was down at the last step (a press is the key going down)
  // Hailing: H waves the right arm, the EverQuest way, for HAIL_SECONDS; the face smiles (the view's)
  pub hailT: f32 = -1.;                // seconds since it began, or -1
  pub hailWas: bool = false;

  pub fn none() Figure {
    Figure(false, 0., bonepose.Skeleton.empty(), bonepose.Pose.empty(), List[Transform3].empty(), walkgait.Walker.make(1., 0u32),
      List[PartId].empty(), List[Mat4].empty(), 0., 0., 0., 0., true, 1., false, 0., 0u32, PartId.none(), Vec3(0., 0., 0.), 0., 0u32,
      Vec3(0., 0., 0.), Vec3(0., 0., 0.), false, 0u32, 0u32, characterOf(1.), FIG_WALK, -1i32, 0., 0., 0., FX_NONE, 0., 0u64)
  }

  // A standing figure of 'height' metres, with the rigid attachments 'parts'
  pub fn make(height: f32, seed: u32, parts: List[PartId]) Figure {
    Figure.from(height, bonepose.humanoid(height), 0., seed, parts, 0xFFFFFFFFu32)
  }

  // A standing figure of person 'a' of humanbody's cast: its height, its own 22-bone skeleton (the hips and shoulders where the
  // measures put them) and its hips for the gait
  pub fn makePerson(a: &PersonAsset, seed: u32, parts: List[PartId]) Figure {
    Figure.from(a.height, humanbody.copySkeleton(&a.skeleton), a.hipSpan, seed, parts, a.index)
  }

  fn from(height: f32, skel: bonepose.Skeleton, hipSpan: f32, seed: u32, parts: List[PartId], person: u32) Figure {
    let pose = skel.restPose();
    var rest = List[Transform3].empty();
    skel.modelTransforms(&pose, &mut rest);
    var bind = List[Mat4].empty();
    var i = 0usize;
    while i < rest.len() {
      bind.push((*rest[i]).toMat4().inverse());
      i = i + 1usize;
    }
    var walker = walkgait.Walker.make(height, seed);
    if hipSpan > 0. { walker.hipSpan = hipSpan; }
    var f = Figure(true, height, skel, pose, List[Transform3].empty(), walker, parts, bind,
      0., 0., 0., 0., true, 1., false, 0., 0u32, PartId.none(), Vec3(0., 0., 0.), 0., 0u32,
      Vec3(0., 0., 0.), Vec3(0., 0., 0.), false, 0u32, 0u32, characterOf(height), FIG_WALK, -1i32, 0., 0., 0., FX_NONE, 0., 0u64);
    f.person = person;
    f
  }

  // A spell of 'kind' (FX_...) begun at simulation tick 'start', 'age' seconds ago (0: now); FX_NONE ends one
  pub fn setFx(self: &mut, kind: u32, start: u64, age: f32) {
    fxKind = kind;
    fxStart = start;
    fxT = age;
  }

  // One step of the spell in force: its clock on by 'dt', and its pose laid over the gait's; it lapses by itself
  fn stepFx(self: &mut, dt: f32) {
    if fxKind == FX_NONE { return; }
    fxT = fxT + dt;
    if fxT > fxSeconds(fxKind) { fxKind = FX_NONE; return; }
    applyFx(self);
  }

  // Posed where the state of a body the figure does not move says it is (a being driven by another process, drawn
  // from its snapshots): the gait animated from its heading, speed and turn, with no physics of its own
  pub fn poseFrom(self: &mut, phys: &mut Phys, pos: Vec3, yaw: f32, spd: f32, turnRate: f32, onGround: bool, dt: f32) {
    phys.ensureGround();
    let feet = pos.y;
    let floor = fn(x: f32, z: f32) f32 { phys.floorAt(x, z, feet) };
    walker.update(&skeleton, &mut pose, &mut models, pos, yaw, if onGround { spd } else { 0. }, turnRate, onGround, &floor, dt);
    if hailT >= 0. { hailT = hailT + dt; }
    self.applyHail();
    self.stepFx(dt);
  }

  // A landing at 'impact' m/s that a snapshot told of: the gait takes it as a step of its own would
  pub fn landedAt(self: &mut, impact: f32) {
    if impact >= HARD_LANDING_SPEED {
      walker.impact(impact);
    } elif impact > 1.5 {
      walker.impact(impact * 0.4);
    }
  }

  // Carried by a platform's move (support.cone's carryRiders): the gait's
  // feet, which are held at points of the world, moved and turned with it,
  // so a planted foot stays where it stood on the floor
  pub fn carried(self: &mut, c: &Carry, yaw: f32) {
    carryFoot(&mut walker.left, c, yaw);
    carryFoot(&mut walker.right, c, yaw);
  }

  // Its skinning matrices for the pose of its last step, one a bone: each
  // bone's model transform times the inverse of its rest one (the identity
  // for every bone before its first step: the body as modelled)
  pub fn skinning(self: &) List[Mat4] {
    var out = List[Mat4].withCapacity(bind.len());
    var i = 0usize;
    while i < bind.len() {
      if models.len() == bind.len() {
        out.push((*models[i]).toMat4() * *bind[i]);
      } else {
        out.push(Mat4.identity());
      }
      i = i + 1usize;
    }
    out
  }

  pub fn radius(self: &) f32 { CAPSULE_RADIUS_OVER_H * height }

  // The farthest any bone of its last pose is from the model's origin (the feet's ground point), metres: a standing or walking
  // figure's is under its height; a pose stretched across a teleport is metres more
  // The face rig's frame laid on the pose: the jaw's opening and the eyes' turn (a person's, 22 bones), the model transforms made again
  pub fn applyFace(self: &mut, bones: &facerig.FaceBones, frame: &facerig.FaceFrame, spec: &facerig.FaceSpec) {
    if models.len() == 0usize || skeleton.boneCount() < 22usize { return; }
    facerig.applyFace(&mut pose, bones, frame, spec, false);
    skeleton.modelTransforms(&pose, &mut models);
  }

  pub fn reach(self: &) f32 {
    var worst = 0.f;
    var i = 0usize;
    while i < models.len() {
      let t = (*models[i]).translation;
      let d = libc.sqrtf(t.x * t.x + t.y * t.y + t.z * t.z);
      if d > worst { worst = d; }
      i = i + 1usize;
    }
    worst
  }

  // The eye, in the figure's model space (the feet's ground point, facing yaw 0)
  pub fn eyeModel(self: &) Vec3 {
    if models.len() == 0usize { return Vec3(0., 0.936 * height, 0.); }
    skeleton.socketModel(&models, bonepose.SOCKET_EYE).translation
  }

  // One fixed step of 'dt' seconds by 'it' for the body 'body' (its feet's
  // ground point and yaw): turn, accelerate, jump or fall, land, and pose.
  // What it stands on is the ground or a platform's floor (support.cone),
  // and a platform's walls stop it.
  pub fn step(self: &mut, phys: &mut Phys, body: &mut Walk, given: Intents, dt: f32) {
    landed = false;
    // The S key and the H key are presses: the key going down
    let sitPress = given.sit && !sitWas;
    sitWas = given.sit;
    let hailPress = given.hail && !hailWas;
    hailWas = given.hail;
    if mode == FIG_RAG || mode == FIG_GETUP {
      // A ragdoll or a get-up: the physics world's turn moves it (ragdoll.cone), not an intent
      hailT = -1.;
      return;
    }
    if hailPress && hailT < 0. { hailT = 0.; }
    if hailT >= 0. {
      hailT = hailT + dt;
      if hailT >= HAIL_SECONDS { hailT = -1.; }
    }
    if mode == FIG_SIT {
      self.stepSit(phys, body, sitPress, dt);
      return;
    }
    // Pressing S near a seat sends it there (and again, back); on its way to one it is steered, not driven
    let it = self.steered(phys, body, given, sitPress, dt);
    if mode == FIG_SIT {
      self.stepSit(phys, body, false, dt);
      return;
    }
    phys.ensureGround();
    let wasOn = on;
    body.yaw = body.yaw + it.turn * TURN_RATE * dt;
    let fx = 0. - sin(body.yaw);
    let fz = 0. - cos(body.yaw);
    let was = body.position;
    // Leaving a platform, it goes on at the platform's velocity as well as its own
    let carry = if on.isNone() { Vec3(0., 0., 0.) } else { platformVel };
    var wish = Vec3(0., 0., 0.);
    var jump = 0.f;
    if grounded {
      let target = it.ahead * (if it.run { RUN_SPEED } else { WALK_SPEED });
      let dv = GROUND_ACCEL * dt;
      if target > speed + dv { speed = speed + dv; }
      elif target < speed - dv { speed = speed - dv; }
      else { speed = target; }
      wish = Vec3(fx * speed, 0., fz * speed);
      if it.jump {
        jump = JUMP_SPEED + carry.y;
        wish = Vec3(fx * speed + carry.x, 0., fz * speed + carry.z);
      }
    } else {
      wish = Vec3(airVx, 0., airVz);
    }
    // The capsule is where the body is, and as grounded as the figure says (a script or a correction may have moved it)
    ch.pos = was;
    if ch.grounded != grounded {
      ch.grounded = grounded;
      if !grounded { ch.groundBody = rigiddynamics.NoBody; }
    }
    ch.vel = Vec3(0., vy, 0.);
    rigiddynamics.updateCharacter(&mut phys.w, &mut ch, wish, jump, dt);
    let pos = ch.pos;
    if ch.grounded {
      if !grounded {
        // Landed
        landSpeed = ch.landSpeed;
        landed = true;
        landCount = landCount + 1u32;
        // On the ground it goes on at the speed along its heading it had
        speed = airVx * fx + airVz * fz;
        if landSpeed >= HARD_LANDING_SPEED {
          hardLandings = hardLandings + 1u32;
          health = health - self.damageOf(landSpeed);
          if health < 0. { health = 0.; }
          walker.impact(landSpeed);
        } elif landSpeed > 1.5 {
          walker.impact(landSpeed * 0.4);
        }
      }
      grounded = true;
      vy = 0.;
      on = phys.partOf(ch.groundBody);
    } else {
      if grounded {
        // Left the ground (a jump, or off an edge): on, keeping its way (and its platform's)
        if jump > 0. {
          vy = ch.vel.y;
          airVx = wish.x;
          airVz = wish.z;
        } else {
          vy = carry.y;
          airVx = fx * speed + carry.x;
          airVz = fz * speed + carry.z;
        }
      } else {
        vy = ch.vel.y;
      }
      grounded = false;
      on = PartId.none();
    }
    body.position = pos;
    // On another floor (or none): where it stands on it is found afresh
    if !(on == wasOn) { anchored = false; }
    let feet = pos.y;
    let floor = fn(x: f32, z: f32) f32 { phys.floorAt(x, z, feet) };
    walker.update(&skeleton, &mut pose, &mut models, pos, body.yaw, if grounded { speed } else { 0. },
      it.turn * TURN_RATE, grounded, &floor, dt);
    self.applyHail();
    self.stepFx(dt);
    // Falling fast: limp (the simulation's alone; a browser waits for the snapshot to say so)
    if !grounded && vy < 0. - RAGDOLL_FALL_SPEED && phys.authority {
      startRagdoll(phys, self, body);
    }
  }

  // The hail laid on the pose: the right arm up and waving, the head turned and the chest leaning (humanbody's hailPose), blended in over
  // the first third of a second and out over the last half, whatever else the pose is (walking, standing, sitting). The model
  // transforms are made again
  pub fn applyHail(self: &mut) {
    if hailT < 0. || models.len() == 0usize || skeleton.boneCount() < 19usize { return; }
    let inW = clamp01(hailT / 0.33);
    let outW = clamp01((HAIL_SECONDS - hailT) / 0.5);
    let w = inW * inW * (3. - 2. * inW) * outW * outW * (3. - 2. * outW);
    let h = humanbody.hailPose(&skeleton, hailT);
    let bones: Array[usize, 5] = [bonepose.UPPER_ARM_R, bonepose.FOREARM_R, bonepose.HAND_R, bonepose.NECK, bonepose.CHEST];
    var k = 0usize;
    while k < 5usize {
      let b = bones[k];
      let a = *pose.locals[b];
      let c = *h.locals[b];
      pose.locals.set(b, Transform3(a.translation, a.rotation.slerp(c.rotation, w), a.scale));
      k = k + 1usize;
    }
    skeleton.modelTransforms(&pose, &mut models);
  }

  // The yaw whose forward (-sin, -cos) points along (dx, dz)
  fn headingOf(dx: f32, dz: f32) f32 { libc.atan2f(0. - dx, 0. - dz) }

  // 'a' as an angle within half a turn of 0
  fn wrapAngle(a: f32) f32 {
    var r = a;
    while r > 3.1415927 { r = r - 6.2831855; }
    while r < -3.1415927 { r = r + 6.2831855; }
    r
  }

  // The intents of a being walking to a seat it chose with the S key: the intents it was given, or, on the way to a seat, the walk that
  // takes it to the place in front of it (the thigh's length ahead of the sitting bones, humanbody's seatFeet) and the turn to the
  // seat's way, until it arrives and sits down (the mode FIG_SIT). S again, or a jump, gives it up.
  fn steered(self: &mut, phys: &mut Phys, body: &mut Walk, given: Intents, press: bool, dt: f32) Intents {
    if sitPhase == SIT_NONE {
      if press && grounded {
        let s = phys.seatNear(body.position, &skeleton);
        if s >= 0i32 {
          seat = s;
          sitPhase = SIT_APPROACH;
          sitT = 0.;
          phys.takeSeat(usize.from(u32.from(s)));
        }
      }
      return given;
    }
    // On the way
    sitT = sitT + dt;
    if press || given.jump || sitT > SEAT_APPROACH_SECONDS || seat < 0i32 || usize.from(u32.from(seat)) >= phys.seats.len() {
      sitPhase = SIT_NONE;
      seat = -1i32;
      sitT = 0.;
      return given;
    }
    let sp = phys.seats[usize.from(u32.from(seat))];
    let feet = humanbody.seatFeet(&sp.seat, &skeleton);
    let dx = feet.x - body.position.x;
    let dz = feet.z - body.position.z;
    let d = libc.sqrtf(dx * dx + dz * dz);
    if d < 0.07 {
      // There: turned to the seat's way, it sits
      let diff = Figure.wrapAngle(sp.seat.yaw - body.yaw);
      if libc.fabsf(diff) < 0.06 {
        body.position = Vec3(feet.x, feet.y, feet.z);
        body.yaw = sp.seat.yaw;
        speed = 0.;
        mode = FIG_SIT;
        sitPhase = SIT_DOWN;
        sitT = 0.;
        return Intents.none();
      }
      return Intents(0., clampUnit(diff / (TURN_RATE * dt)), false, false);
    }
    let diff = Figure.wrapAngle(Figure.headingOf(dx, dz) - body.yaw);
    let ahead = if libc.fabsf(diff) < 0.5 { clamp01(d / 0.5 + 0.2) } else { 0. };
    Intents(ahead, clampUnit(diff / (TURN_RATE * dt)), false, false)
  }

  // One step of sitting down, being seated and standing up: the body is where the feet stand before the seat, facing its way, and the
  // pose is humanbody's sitPose at the sit's progress; S while seated stands up
  fn stepSit(self: &mut, phys: &mut Phys, body: &mut Walk, press: bool, dt: f32) {
    if seat < 0i32 || usize.from(u32.from(seat)) >= phys.seats.len() {
      self.endSit(body);
      return;
    }
    let sp = phys.seats[usize.from(u32.from(seat))];
    body.position = humanbody.seatFeet(&sp.seat, &skeleton);
    body.yaw = sp.seat.yaw;
    speed = 0.;
    vy = 0.;
    grounded = true;
    if sitPhase == SIT_DOWN {
      sitT = sitT + dt / SIT_SECONDS;
      if sitT >= 1. { sitT = 1.; sitPhase = SIT_SEATED; }
      if press { sitPhase = SIT_UP; }
    } elif sitPhase == SIT_SEATED {
      if press { sitPhase = SIT_UP; }
    } else {
      sitT = sitT - dt / SIT_SECONDS;
      if sitT <= 0. {
        self.endSit(body);
        return;
      }
    }
    self.poseSitting(&sp.seat);
    self.applyHail();
    self.stepFx(dt);
  }

  // The pose of a sit in 'sitT', sitting down or standing up
  fn poseSitting(self: &mut, s: &humanbody.Seat) {
    pose = humanbody.sitPose(&skeleton, s, sitT, sitPhase != SIT_UP);
    skeleton.modelTransforms(&pose, &mut models);
  }

  // Standing on its feet again where the sit left it, its gait started afresh
  pub fn endSit(self: &mut, body: &Walk) {
    mode = FIG_WALK;
    seat = -1i32;
    sitPhase = SIT_NONE;
    sitT = 0.;
    speed = 0.;
    vy = 0.;
    airVx = 0.;
    airVz = 0.;
    grounded = true;
    anchored = false;
    walker.started = false;
    walker.crouchDepth = 0.;
    ch.teleport(body.position);
    ch.grounded = true;
  }

  // Posed as the snapshot of a being sitting says (a view drawing another's sit, or its own after a correction): on seat 'slot' of the
  // physics world, 'progress' of the way from standing to seated, sitting down or standing up. 'slot' -1: not sitting
  pub fn poseSeated(self: &mut, phys: &mut Phys, slot: i32, progress: f32, down: bool, dt: f32) {
    if slot < 0i32 || usize.from(u32.from(slot)) >= phys.seats.len() {
      if seat >= 0i32 {
        seat = -1i32;
        sitPhase = SIT_NONE;
        mode = FIG_WALK;
        walker.started = false;
        walker.crouchDepth = 0.;
      }
      return;
    }
    seat = slot;
    mode = FIG_SIT;
    sitT = progress;
    sitPhase = if progress >= 1. { SIT_SEATED } elif down { SIT_DOWN } else { SIT_UP };
    let sp = phys.seats[usize.from(u32.from(slot))];
    self.poseSitting(&sp.seat);
    self.applyHail();
    self.stepFx(dt);
  }

  // Standing again where the body is, whole as it is, after a ragdoll's get-up: its gait started afresh
  pub fn standUp(self: &mut, body: &Walk) {
    mode = FIG_WALK;
    modeT = 0.;
    lieT = 0.;
    hurtSpeed = 0.;
    speed = 0.;
    vy = 0.;
    airVx = 0.;
    airVz = 0.;
    grounded = true;
    on = PartId.none();
    anchored = false;
    walker.started = false;
    walker.crouchDepth = 0.;
    ch.teleport(body.position);
    ch.grounded = true;
  }

  // Set down standing at 'at' facing 'yaw' (getting up again after a fall
  // emptied its health, or a script putting it somewhere): whole, still,
  // its gait started afresh
  pub fn setDown(self: &mut, body: &mut Walk, at: Vec3, yaw: f32) {
    setDowns = setDowns + 1u32;
    body.position = at;
    body.yaw = yaw;
    health = 1.;
    speed = 0.;
    vy = 0.;
    airVx = 0.;
    airVz = 0.;
    grounded = true;
    landed = false;
    on = PartId.none();
    anchored = false;
    downFor = 0.;
    walker.started = false;
    walker.crouchDepth = 0.;
    mode = FIG_WALK;
    modeT = 0.;
    lieT = 0.;
    hurtSpeed = 0.;
    ch.teleport(at);
    ch.grounded = true;
  }

  // What a landing at 'impact' m/s costs, as a fraction of health: nothing
  // to 10 m/s, all of it at 24 (a gameplay number, in the being's state,
  // not the locomotor's)
  pub fn damageOf(self: &, impact: f32) f32 {
    let d = (impact - 10.) / (24. - 10.);
    if d < 0. { return 0.; }
    if d > 1. { return 1.; }
    d
  }
}

// A gait's foot carried by a platform's move: every point it keeps in the
// world moved with the floor, every heading turned with it
fn carryFoot(f: &mut walkgait.Foot, c: &Carry, yaw: f32) {
  f.heel = c.point(f.heel);
  f.landHeel = c.point(f.landHeel);
  f.liftAnkle = c.point(f.liftAnkle);
  f.ankle = c.point(f.ankle);
  f.yaw = f.yaw + yaw;
  f.liftYaw = f.liftYaw + yaw;
  f.landYaw = f.landYaw + yaw;
}

// ---- The body: one mesh lofted along the bones, and its skin ----

// Points round a ring: the trunk's, a limb's, a hand's or a foot's
const TRUNK_POINTS = 24usize;
const LIMB_POINTS = 16usize;
const HAND_POINTS = 12usize;
// Rings lofted between two stations (sculpt's 'between')
const BETWEEN = 2u32;

fn smooth01(a: f32, b: f32, x: f32) f32 {
  if x <= a { return 0.; }
  if x >= b { return 1.; }
  let u = (x - a) / (b - a);
  u * u * (3. - 2. * u)
}

// An ellipse 'a' across its profile's x and 'b' across its y, its middle at
// (cx, cy), 'n' points counterclockwise
fn ellipse(n: usize, a: f32, b: f32, cx: f32, cy: f32) sculpt.Profile {
  var pts = List[Vec2].withCapacity(n);
  var k = 0usize;
  while k < n {
    let t = 2. * pi * f32.from(k) / f32.from(n);
    pts.push(Vec2(cx + a * cos(t), cy + b * sin(t)));
    k = k + 1usize;
  }
  sculpt.Profile.fromPoints(pts.view(), true)
}

// A foot's ring: 'hw' half wide, 'top' high above a flat sole at y 0 (an
// ellipse whose lowest part is cut flat)
fn soleRing(n: usize, hw: f32, top: f32) sculpt.Profile {
  var pts = List[Vec2].withCapacity(n);
  let half = top * 0.5;
  let mid = half * 0.8;
  var k = 0usize;
  while k < n {
    let t = 2. * pi * f32.from(k) / f32.from(n);
    let y = mid + half * sin(t);
    pts.push(Vec2(hw * cos(t), if y < 0. { 0. } else { y }));
    k = k + 1usize;
  }
  sculpt.Profile.fromPoints(pts.view(), true)
}

// A tube lofted from 'from' to 'to' through 'profiles', placed at the
// fractions 'at' of the way (smooth between them, the ends closed), its
// profiles' y along 'up' (made square to the way it runs)
fn loftPiece(from: Vec3, to: Vec3, up: Vec3, profiles: &List[sculpt.Profile], at: &Array[f32]) Mesh {
  let ends = [from, to];
  var path = sculpt.Path.fromPoints(&ends, false);
  path.up = up;
  let pm = sculpt.loftAlong(profiles, &path, at, 0u32, BETWEEN, true, true);
  pm.triangulate(true)
}

// Where a vertex is between two bones of its piece: 'lo' and 'hi', and 't'
// of the way from all 'lo' to all 'hi'
struct Blend {
  lo: usize;
  hi: usize;
  t: f32;
}

// The blend of a vertex at 'p' along a piece's chain of bones: 'joints'
// the joints in order along the piece (at least two), 'bones' the bone
// before the first joint, between each two and after the last (one more
// than the joints), 'zones' how far either side of each joint the two
// bones blend. Its place along the chain is its nearest point on the
// segments between the joints (past the ends, on the end segments carried
// on); within a joint's zone it is smoothstep blended, elsewhere wholly the
// bone of the segment it is on.
fn chainBlend(p: Vec3, joints: &Array[Vec3], bones: &Array[usize], zones: &Array[f32]) Blend {
  let m = joints.len;
  var best: f32 = 1.0e30;
  var s: f32 = 0.;
  var acc: f32 = 0.;
  var along = List[f32].withCapacity(m);
  along.push(0.);
  var k = 0usize;
  while k + 1usize < m {
    let a = joints[k];
    let d = joints[k + 1usize] - a;
    let len = d.length();
    let u = (p - a).dot(d) / (len * len);
    let c = if u < 0. { 0. } elif u > 1. { 1. } else { u };
    let dist = p.distance(a + d * c);
    let su = if (k == 0usize && u < 0.) || (k + 2usize == m && u > 1.) { u } else { c };
    if dist < best {
      best = dist;
      s = acc + su * len;
    }
    acc = acc + len;
    along.push(acc);
    k = k + 1usize;
  }
  // The nearest joint along the chain
  var j = 0usize;
  k = 1usize;
  while k < m {
    let dk = s - *along[k];
    let dj = s - *along[j];
    if dk * dk < dj * dj { j = k; }
    k = k + 1usize;
  }
  let off = s - *along[j];
  let z = zones[j];
  if off > 0. - z && off < z {
    return Blend(bones[j], bones[j + 1usize], smooth01(0. - z, z, off));
  }
  let after = if off >= z { j + 1usize } else { j };
  Blend(bones[after], bones[after], 0.)
}

// 'piece' appended to 'body', its vertices weighted along the chain
// 'joints', 'bones', 'zones' (chainBlend)
fn addChained(body: &mut Mesh, skin: &mut Skin, piece: &Mesh, joints: &Array[Vec3], bones: &Array[usize], zones: &Array[f32]) {
  var v = 0usize;
  while v < piece.positions.len() {
    let b = chainBlend(*piece.positions[v], joints, bones, zones);
    skin.push(u32.from(b.lo), u32.from(b.hi), u32.from(b.lo), u32.from(b.lo), 1. - b.t, b.t, 0., 0.);
    v = v + 1usize;
  }
  body.append(piece);
}

// 'piece' appended to 'body', every vertex wholly bone 'bone''s
fn addRigid(body: &mut Mesh, skin: &mut Skin, piece: &Mesh, bone: usize) {
  var v = 0usize;
  while v < piece.positions.len() {
    skin.push(u32.from(bone), u32.from(bone), u32.from(bone), u32.from(bone), 1., 0., 0., 0.);
    v = v + 1usize;
  }
  body.append(piece);
}

// The trunk's rings, bottom to top: height, half width (x), half depth (z)
// and the ring's middle's z (+z is behind: the figure faces -z), in H
const TRUNK_RINGS = 18usize;
const TRUNK: Array[f32, 72] = [
  0.445, 0.040, 0.030, 0.000,     // the crotch, closed
  0.465, 0.105, 0.066, 0.006,
  0.500, 0.136, 0.076, 0.009,     // the seat
  0.545, 0.140, 0.072, 0.005,     // the hips, round the tops of the thighs
  0.600, 0.110, 0.062, 0.001,     // the waist
  0.660, 0.110, 0.064, -0.003,
  0.720, 0.120, 0.070, -0.006,    // the chest
  0.775, 0.130, 0.065, -0.002,
  0.812, 0.124, 0.056, 0.004,     // the line of the shoulders
  0.835, 0.098, 0.048, 0.006,     // sloping to the neck
  0.850, 0.050, 0.038, 0.005,
  0.862, 0.034, 0.034, 0.004,     // the neck
  0.878, 0.031, 0.034, 0.001,
  0.896, 0.040, 0.050, -0.006,    // the jaw
  0.930, 0.046, 0.058, -0.004,    // the head
  0.966, 0.044, 0.054, 0.000,
  0.991, 0.030, 0.038, 0.002,
  1.002, 0.008, 0.010, 0.000];    // the crown, closed

// A leg's rings from its top (buried in the pelvis, 0.05 H above the hip)
// to just past the ankle: distance from the top and radius, in H, and the
// ring's middle's z (+z behind: the calf)
const LEG_RINGS = 10usize;
const LEG: Array[f32, 30] = [
  0.000, 0.020, 0.000,
  0.020, 0.041, 0.000,
  0.050, 0.050, 0.000,            // the hip
  0.140, 0.050, -0.003,
  0.220, 0.044, 0.000,
  0.295, 0.037, 0.000,            // the knee
  0.355, 0.040, 0.006,            // the calf
  0.445, 0.031, 0.003,
  0.541, 0.023, 0.000,            // the ankle
  0.556, 0.013, 0.000];

// An arm's rings from its top (ARM_TOP above the shoulder joint, along the
// arm, inside the shoulder) to just past the wrist: distance from the top
// and radius, in H
const ARM_TOP: f32 = 0.022;
const ARM_RINGS = 10usize;
const ARM: Array[f32, 20] = [
  0.000, 0.010,
  0.010, 0.027,
  0.022, 0.035,                   // the shoulder
  0.082, 0.033,
  0.162, 0.030,
  0.210, 0.026,                   // the elbow
  0.246, 0.029,                   // the forearm
  0.310, 0.024,
  0.355, 0.018,                   // the wrist
  0.365, 0.013];

// A hand's rings from the wrist along the hand: fraction of its 0.108 H,
// half width (forward and back) and half thickness (across the palm), in H
const HAND_RINGS = 5usize;
const HAND: Array[f32, 15] = [
  0.00, 0.016, 0.012,
  0.25, 0.024, 0.013,
  0.60, 0.025, 0.011,
  0.90, 0.018, 0.008,
  1.00, 0.006, 0.004];

// A foot's rings from behind the heel (0.045 H behind the ankle) to the toe
// (0.115 H ahead): fraction of its 0.16 H, half width and height, in H
const FOOT_RINGS = 6usize;
const FOOT: Array[f32, 18] = [
  0.00, 0.009, 0.018,
  0.07, 0.021, 0.044,
  0.28, 0.024, 0.058,             // under the ankle
  0.55, 0.029, 0.040,
  0.85, 0.027, 0.026,
  1.00, 0.010, 0.012];

// The mannequin's body for a figure 'h' metres tall, in its model space as
// the skeleton 'skel' stands at rest (the feet's ground point at the origin,
// facing -z), and its skin, one entry a vertex
pub fn bodyMesh(skel: &bonepose.Skeleton, h: f32, skin: &mut Skin) Mesh {
  var rest = List[Transform3].empty();
  skel.modelTransforms(&skel.restPose(), &mut rest);
  var body = Mesh.empty();

  // The trunk, neck and head: pelvis, spine, chest, neck and head blended
  // at the waist, the chest, the base of the neck and the skull
  {
    var profiles = List[sculpt.Profile].empty();
    var at = List[f32].empty();
    let y0 = TRUNK[0] * h;
    let y1 = TRUNK[(TRUNK_RINGS - 1usize) * 4usize] * h;
    var r = 0usize;
    while r < TRUNK_RINGS {
      let e = r * 4usize;
      // The path runs up +y with the profiles' y on +z: their x is on -x
      profiles.push(ellipse(TRUNK_POINTS, TRUNK[e + 1usize] * h, TRUNK[e + 2usize] * h, 0., TRUNK[e + 3usize] * h));
      at.push((TRUNK[e] * h - y0) / (y1 - y0));
      r = r + 1usize;
    }
    let piece = loftPiece(Vec3(0., y0, 0.), Vec3(0., y1, 0.), Vec3(0., 0., 1.), &profiles, at.view());
    let joints = [(*rest[bonepose.SPINE]).translation, (*rest[bonepose.CHEST]).translation,
      (*rest[bonepose.NECK]).translation, (*rest[bonepose.HEAD]).translation];
    let bones = [bonepose.PELVIS, bonepose.SPINE, bonepose.CHEST, bonepose.NECK, bonepose.HEAD];
    let zones = [0.035 * h, 0.045 * h, 0.030 * h, 0.020 * h];
    var v = 0usize;
    while v < piece.positions.len() {
      let p = *piece.positions[v];
      let b = chainBlend(p, &joints, &bones, &zones);
      // The shoulders' tops lean towards the clavicle of their side
      let ax = if p.x < 0. { 0. - p.x } else { p.x };
      let c = 0.5 * smooth01(0.05 * h, 0.10 * h, ax) * smooth01(0.74 * h, 0.80 * h, p.y);
      let clavicle = if p.x < 0. { bonepose.CLAVICLE_L } else { bonepose.CLAVICLE_R };
      skin.push(u32.from(b.lo), u32.from(b.hi), u32.from(clavicle), u32.from(b.lo), (1. - b.t) * (1. - c), b.t * (1. - c),
        c, 0.);
      v = v + 1usize;
    }
    body.append(&piece);
    // The nose, to show which way the head faces
    var nose = Mesh.sphere(1., 10);
    nose.transform(Mat4.fromTrs(Vec3(0., 0.925 * h, -0.058 * h), Quat.identity(),
      Vec3(0.009 * h, 0.013 * h, 0.012 * h)));
    addRigid(&mut body, skin, &nose, bonepose.HEAD);
  }

  // The legs: pelvis, thigh, shin and foot blended at the hip, the knee and the ankle
  var side = 0usize;
  while side < 2usize {
    let thigh = if side == 0usize { bonepose.THIGH_L } else { bonepose.THIGH_R };
    let shin = thigh + 2usize;
    let foot = thigh + 4usize;
    let hip = (*rest[thigh]).translation;
    let knee = (*rest[shin]).translation;
    let ankle = (*rest[foot]).translation;
    let down = (ankle - hip).normalize();
    let top = hip - down * (0.05 * h);
    let length = LEG[(LEG_RINGS - 1usize) * 3usize] * h;
    var profiles = List[sculpt.Profile].empty();
    var at = List[f32].empty();
    var r = 0usize;
    while r < LEG_RINGS {
      let e = r * 3usize;
      let radius = LEG[e + 1usize] * h;
      profiles.push(ellipse(LIMB_POINTS, radius, radius, 0., LEG[e + 2usize] * h));
      at.push(LEG[e] * h / length);
      r = r + 1usize;
    }
    let piece = loftPiece(top, top + down * length, Vec3(0., 0., 1.), &profiles, at.view());
    let joints = [hip, knee, ankle];
    let bones = [bonepose.PELVIS, thigh, shin, foot];
    let zones = [0.040 * h, 0.045 * h, 0.018 * h];
    addChained(&mut body, skin, &piece, &joints, &bones, &zones);

    // The foot, flat soled at the ground, wholly the foot's
    var feet = List[sculpt.Profile].empty();
    var fat = List[f32].empty();
    r = 0usize;
    while r < FOOT_RINGS {
      let e = r * 3usize;
      feet.push(soleRing(LIMB_POINTS, FOOT[e + 1usize] * h, FOOT[e + 2usize] * h));
      fat.push(FOOT[e]);
      r = r + 1usize;
    }
    let heel = Vec3(ankle.x, 0., ankle.z + 0.045 * h);
    let toe = Vec3(ankle.x, 0., ankle.z - 0.115 * h);
    let footPiece = loftPiece(heel, toe, Vec3(0., 1., 0.), &feet, fat.view());
    addRigid(&mut body, skin, &footPiece, foot);
    side = side + 1usize;
  }

  // The arms: clavicle, upper arm, forearm and hand blended at the
  // shoulder, the elbow and the wrist; the hands wholly their own
  side = 0usize;
  while side < 2usize {
    let upper = if side == 0usize { bonepose.UPPER_ARM_L } else { bonepose.UPPER_ARM_R };
    let clavicle = upper - 2usize;
    let fore = upper + 2usize;
    let hand = upper + 4usize;
    let shoulder = (*rest[upper]).translation;
    let elbow = (*rest[fore]).translation;
    let wrist = (*rest[hand]).translation;
    let down = (wrist - shoulder).normalize();
    let top = shoulder - down * (ARM_TOP * h);
    let length = ARM[(ARM_RINGS - 1usize) * 2usize] * h;
    var profiles = List[sculpt.Profile].empty();
    var at = List[f32].empty();
    var r = 0usize;
    while r < ARM_RINGS {
      let e = r * 2usize;
      let radius = ARM[e + 1usize] * h;
      profiles.push(ellipse(LIMB_POINTS, radius, radius, 0., 0.));
      at.push(ARM[e] * h / length);
      r = r + 1usize;
    }
    let piece = loftPiece(top, top + down * length, Vec3(0., 0., 1.), &profiles, at.view());
    let joints = [shoulder, elbow, wrist];
    let bones = [clavicle, upper, fore, hand];
    let zones = [0.035 * h, 0.035 * h, 0.014 * h];
    addChained(&mut body, skin, &piece, &joints, &bones, &zones);

    // The hand: a mitten along the hand bone, flat across the palm (its
    // profiles' y out from the body, across the palm)
    var rings = List[sculpt.Profile].empty();
    var hat = List[f32].empty();
    r = 0usize;
    while r < HAND_RINGS {
      let e = r * 3usize;
      rings.push(ellipse(HAND_POINTS, HAND[e + 1usize] * h, HAND[e + 2usize] * h, 0., 0.));
      hat.push(HAND[e]);
      r = r + 1usize;
    }
    let out = if side == 0usize { Vec3(-1., 0., 0.) } else { Vec3(1., 0., 0.) };
    let handPiece = loftPiece(wrist, wrist + down * (0.108 * h), out, &rings, hat.view());
    addRigid(&mut body, skin, &handPiece, hand);
    side = side + 1usize;
  }
  body
}

// The colour of the wood: a pale natural beech, sRGB (214, 176, 128), linear
pub fn woodColor() Color { Color(0.672, 0.434, 0.216, 1.) }
// A second figure painted a muted clay red, sRGB (170, 92, 70)
pub fn clayColor() Color { Color(0.402, 0.107, 0.061, 1.) }

// Send a mannequin of 'height' metres into the scene: its body (bodyMesh),
// a skinned mesh, defined, in one material of 'color', and shown as 'root'
// (the being's own part), standing as modelled until its first Bones.
// Answers its rigid attachments' parts (none yet).
pub fn spawnMannequin(door: &mut Door, height: f32, color: Color, root: PartId) List[PartId] {
  let skel = bonepose.humanoid(height);
  var skin = Skin.empty();
  let body = bodyMesh(&skel, height, &mut skin);
  let wood = door.defineMaterial(Look.shiny(color, 0.25, 18.), Image.empty(), Maps.none());
  let mesh = door.defineSkinnedMesh(body, skin);
  door.send(Request.Show(root, mesh, wood, 0.));
  List[PartId].empty()
}
