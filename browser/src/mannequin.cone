// The mannequin: an artist's wooden figure, one smooth skinned body.
//
// THE BODY is one mesh lofted along the bones of the bonepose humanoid as it
// stands in its rest pose (sculpt's loftAlong): the trunk, neck and head one
// tube of elliptical rings from the crotch to the crown; each leg one tube
// from inside the pelvis through the knee to the ankle; each arm one tube
// from inside the shoulder through the elbow to the wrist; a flat-soled foot
// and a mitten hand; a small nose to show which way the head faces. The
// limbs' tops are buried in the trunk, so the figure reads as one surface.
// It is SKINNED (render's linear blend skinning, on the GPU): every vertex's
// weights are written once, at build time, from where it is along its
// piece's chain of bones (its nearest point on the bone segments): wholly
// its bone's along a bone, blended by a smoothstep across a zone either
// side of a joint (the knee, the elbow, the waist), so a joint bends as one
// smooth surface. The upper chest blends towards each clavicle, the head,
// hands and feet are wholly their bones'. The head is part of the skin
// (wholly the head bone's, so it moves as a rigid piece would) rather than
// a part of its own on the head socket: one part, one draw.
//
// The being's own part is shown as the body; each step the figure's pose
// becomes its skinning matrices (each bone's posed model transform times
// the inverse of its rest one), sent as a Bones request. The skeleton, the
// gait, the capsule, the view rig, possession and the sockets are as they
// were with one rigid piece a bone.
//
// A FIGURE is what a mannequin being is made of besides its place in the
// world (Being.body, a Walk: the feet's ground point and the yaw):
//   - the skeleton, its pose and the model-space transforms of the pose;
//   - the inverse of each bone's rest (bind) transform, for skinning;
//   - the Walker (gait state: phase, feet, pelvis, idle layer, crouch);
//   - the kinematic capsule: vertical speed, gravity, grounded or falling,
//     the landing and what it cost;
//   - rigid attachments, parts of their own (none yet).
//
// THE CAPSULE is kinematic, not a rigid body: the body's feet are on the
// ground's height under it (groundHeight, ground.cone: the highest of its
// footprint, flat today, the terrain's when T1 lands) when it stands; it
// follows the ground up and down within a step of 0.4 m, stays stuck to it
// going down within 0.35 m, and otherwise falls under gravity (9.81 m/s^2,
// at most 55 m/s) until the ground is reached, which is a landing at the
// impact speed. A landing of 7 m/s or more (a drop of 2.5 m: v = sqrt(2 g h))
// is HARD: the pelvis crouches (the Walker's impact) and the cast reports it
// to the scene, which mails it. Its cost is a number in the being's own
// state, health, by (speed - 10) / (24 - 10) clamped to 0 to 1 of it:
// harmless to 10 m/s (a 5 m drop), fatal at 24 m/s (a 30 m drop).

// The capsule's radius is 0.15 H; its height is H
pub const CAPSULE_RADIUS_OVER_H = 0.15;

pub const GRAVITY = 9.81;
pub const TERMINAL_SPEED = 55.;
pub const HARD_LANDING_SPEED = 7.;
pub const STEP_UP = 0.4;
pub const SNAP_DOWN = 0.35;
pub const WALK_SPEED = 1.8;           // m/s: a purposeful walk, under the walk-run change at 2.1
pub const RUN_SPEED = 4.5;
pub const GROUND_ACCEL = 12.;         // m/s^2
pub const JUMP_SPEED = 4.2;           // m/s up: a jump to 0.9 m
pub const TURN_RATE = 1.0471976;      // rad/s: the same quarter turn in 1.5 s as the walker

pub struct Figure {
  pub active bool;                    // false: this being is a plain walker, with no figure
  pub height f32;
  pub skeleton bonepose.Skeleton;
  pub pose bonepose.Pose;
  pub models List[Transform3];
  pub walker walkgait.Walker;
  pub parts List[PartId];             // its rigid attachments' parts (none yet)
  pub bind List[Mat4];                // each bone's rest transform in model space, inverted
  pub speed f32;                      // along its heading, m/s
  pub vy f32;                         // vertical speed, m/s
  pub airVx f32;                      // horizontal velocity while falling
  pub airVz f32;
  pub grounded bool;
  pub health f32;                     // 1 whole
  pub landed bool;                    // the last step ended in a landing
  pub landSpeed f32;                  // at this speed
  pub hardLandings u32;

  pub fn none() Figure {
    new Figure(false, 0., bonepose.Skeleton.empty(), bonepose.Pose.empty(), List[Transform3].empty(), walkgait.Walker.make(1., 0u32),
      List[PartId].empty(), List[Mat4].empty(), 0., 0., 0., 0., true, 1., false, 0., 0u32);
  }

  // A standing figure of 'height' metres, with the rigid attachments 'parts'
  pub fn make(height f32, seed u32, parts List[PartId]) Figure {
    imm skel = bonepose.humanoid(height);
    imm pose = skel.restPose();
    mut rest = List[Transform3].empty();
    skel.modelTransforms(&pose, &mut rest);
    mut bind = List[Mat4].empty();
    mut i = 0usize;
    while i < rest.len() {
      bind.push((*rest[i]).toMat4().inverse());
      i = i + 1usize;
    }
    new Figure(true, height, skel, pose, List[Transform3].empty(), walkgait.Walker.make(height, seed), parts, bind,
      0., 0., 0., 0., true, 1., false, 0., 0u32);
  }

  // Its skinning matrices for the pose of its last step, one a bone: each
  // bone's model transform times the inverse of its rest one (the identity
  // for every bone before its first step: the body as modelled)
  pub fn skinning(self &) List[Mat4] {
    mut out = List[Mat4].withCapacity(bind.len());
    mut i = 0usize;
    while i < bind.len() {
      if models.len() == bind.len() {
        out.push((*models[i]).toMat4() * *bind[i]);
      } else {
        out.push(Mat4.identity());
      }
      i = i + 1usize;
    }
    out;
  }

  pub fn radius(self &) f32 { CAPSULE_RADIUS_OVER_H * height; }

  // The eye, in the figure's model space (the feet's ground point, facing yaw 0)
  pub fn eyeModel(self &) Vec3 {
    if models.len() == 0usize { return new Vec3(0., 0.936 * height, 0.); }
    skeleton.socketModel(&models, bonepose.SOCKET_EYE).translation;
  }

  // One fixed step of 'dt' seconds by 'it' for the body 'body' (its feet's
  // ground point and yaw): turn, accelerate, jump or fall, land, and pose
  pub fn step(self &mut, body &mut Walk, it Intents, dt f32) {
    landed = false;
    body.yaw = body.yaw + it.turn * TURN_RATE * dt;
    imm fx = 0. - sin(body.yaw);
    imm fz = 0. - cos(body.yaw);
    mut pos = body.position;
    imm was = pos;
    if grounded {
      imm target = it.ahead * (if it.run { RUN_SPEED; } else { WALK_SPEED; });
      imm dv = GROUND_ACCEL * dt;
      if target > speed + dv { speed = speed + dv; }
      elif target < speed - dv { speed = speed - dv; }
      else { speed = target; }
      pos = new Vec3(pos.x + fx * speed * dt, pos.y, pos.z + fz * speed * dt);
      if it.jump {
        grounded = false;
        vy = JUMP_SPEED;
        airVx = fx * speed;
        airVz = fz * speed;
      }
    } else {
      vy = vy - GRAVITY * dt;
      if vy < 0. - TERMINAL_SPEED { vy = 0. - TERMINAL_SPEED; }
      pos = new Vec3(pos.x + airVx * dt, pos.y, pos.z + airVz * dt);
    }
    imm ground = footprintHeight(pos.x, pos.z, self.radius());
    if grounded {
      if ground > pos.y + STEP_UP {
        // Too high a step: blocked, stopped
        pos = new Vec3(was.x, pos.y, was.z);
        speed = 0.;
      } elif pos.y - ground <= SNAP_DOWN {
        pos = new Vec3(pos.x, ground, pos.z);
      } else {
        // Walked off an edge: falling, keeping its way
        grounded = false;
        vy = 0.;
        airVx = fx * speed;
        airVz = fz * speed;
      }
    }
    if !grounded {
      pos = new Vec3(pos.x, pos.y + vy * dt, pos.z);
      if pos.y <= ground and vy <= 0. {
        landSpeed = 0. - vy;
        pos = new Vec3(pos.x, ground, pos.z);
        vy = 0.;
        grounded = true;
        landed = true;
        // On the ground it goes on at the speed along its heading it had
        speed = airVx * fx + airVz * fz;
        if landSpeed >= HARD_LANDING_SPEED {
          hardLandings = hardLandings + 1u32;
          health = health - self.damageOf(landSpeed);
          if health < 0. { health = 0.; }
          walker.impact(landSpeed);
        } elif landSpeed > 1.5 {
          walker.impact(landSpeed * 0.4);
        }
      }
    }
    body.position = pos;
    walker.update(&skeleton, &mut pose, &mut models, pos, body.yaw, if grounded { speed; } else { 0.; },
      it.turn * TURN_RATE, grounded, &groundHeight, dt);
  }

  // What a landing at 'impact' m/s costs, as a fraction of health: nothing
  // to 10 m/s, all of it at 24 (a gameplay number, in the being's state,
  // not the locomotor's)
  pub fn damageOf(self &, impact f32) f32 {
    imm d = (impact - 10.) / (24. - 10.);
    if d < 0. { return 0.; }
    if d > 1. { return 1.; }
    d;
  }
}

// ---- The body: one mesh lofted along the bones, and its skin ----

// Points round a ring: the trunk's, a limb's, a hand's or a foot's
const TRUNK_POINTS = 24usize;
const LIMB_POINTS = 16usize;
const HAND_POINTS = 12usize;
// Rings lofted between two stations (sculpt's 'between')
const BETWEEN = 2u32;

fn smooth01(a f32, b f32, x f32) f32 {
  if x <= a { return 0.; }
  if x >= b { return 1.; }
  imm u = (x - a) / (b - a);
  u * u * (3. - 2. * u);
}

// An ellipse 'a' across its profile's x and 'b' across its y, its middle at
// (cx, cy), 'n' points counterclockwise
fn ellipse(n usize, a f32, b f32, cx f32, cy f32) sculpt.Profile {
  mut pts = List[Vec2].withCapacity(n);
  mut k = 0usize;
  while k < n {
    imm t = 2. * pi * f32.from(k) / f32.from(n);
    pts.push(new Vec2(cx + a * cos(t), cy + b * sin(t)));
    k = k + 1usize;
  }
  sculpt.Profile.fromPoints(pts.view(), true);
}

// A foot's ring: 'hw' half wide, 'top' high above a flat sole at y 0 (an
// ellipse whose lowest part is cut flat)
fn soleRing(n usize, hw f32, top f32) sculpt.Profile {
  mut pts = List[Vec2].withCapacity(n);
  imm half = top * 0.5;
  imm mid = half * 0.8;
  mut k = 0usize;
  while k < n {
    imm t = 2. * pi * f32.from(k) / f32.from(n);
    imm y = mid + half * sin(t);
    pts.push(new Vec2(hw * cos(t), if y < 0. { 0.; } else { y; }));
    k = k + 1usize;
  }
  sculpt.Profile.fromPoints(pts.view(), true);
}

// A tube lofted from 'from' to 'to' through 'profiles', placed at the
// fractions 'at' of the way (smooth between them, the ends closed), its
// profiles' y along 'up' (made square to the way it runs)
fn loftPiece(from Vec3, to Vec3, up Vec3, profiles &List[sculpt.Profile], at &[]f32) Mesh {
  imm ends = [from, to];
  mut path = sculpt.Path.fromPoints(&ends, false);
  path.up = up;
  imm pm = sculpt.loftAlong(profiles, &path, at, 0u32, BETWEEN, true, true);
  pm.triangulate(true);
}

// Where a vertex is between two bones of its piece: 'lo' and 'hi', and 't'
// of the way from all 'lo' to all 'hi'
struct Blend {
  lo usize;
  hi usize;
  t f32;
}

// The blend of a vertex at 'p' along a piece's chain of bones: 'joints'
// the joints in order along the piece (at least two), 'bones' the bone
// before the first joint, between each two and after the last (one more
// than the joints), 'zones' how far either side of each joint the two
// bones blend. Its place along the chain is its nearest point on the
// segments between the joints (past the ends, on the end segments carried
// on); within a joint's zone it is smoothstep blended, elsewhere wholly the
// bone of the segment it is on.
fn chainBlend(p Vec3, joints &[]Vec3, bones &[]usize, zones &[]f32) Blend {
  imm m = joints.len;
  mut best f32 = 1.0e30;
  mut s f32 = 0.;
  mut acc f32 = 0.;
  mut along = List[f32].withCapacity(m);
  along.push(0.);
  mut k = 0usize;
  while k + 1usize < m {
    imm a = joints[k];
    imm d = joints[k + 1usize] - a;
    imm len = d.length();
    imm u = (p - a).dot(d) / (len * len);
    imm c = if u < 0. { 0.; } elif u > 1. { 1.; } else { u; };
    imm dist = p.distance(a + d * c);
    imm su = if (k == 0usize and u < 0.) or (k + 2usize == m and u > 1.) { u; } else { c; };
    if dist < best {
      best = dist;
      s = acc + su * len;
    }
    acc = acc + len;
    along.push(acc);
    k = k + 1usize;
  }
  // The nearest joint along the chain
  mut j = 0usize;
  k = 1usize;
  while k < m {
    imm dk = s - *along[k];
    imm dj = s - *along[j];
    if dk * dk < dj * dj { j = k; }
    k = k + 1usize;
  }
  imm off = s - *along[j];
  imm z = zones[j];
  if off > 0. - z and off < z {
    return new Blend(bones[j], bones[j + 1usize], smooth01(0. - z, z, off));
  }
  imm after = if off >= z { j + 1usize; } else { j; };
  new Blend(bones[after], bones[after], 0.);
}

// 'piece' appended to 'body', its vertices weighted along the chain
// 'joints', 'bones', 'zones' (chainBlend)
fn addChained(body &mut Mesh, skin &mut Skin, piece &Mesh, joints &[]Vec3, bones &[]usize, zones &[]f32) {
  mut v = 0usize;
  while v < piece.positions.len() {
    imm b = chainBlend(*piece.positions[v], joints, bones, zones);
    skin.push(u32.from(b.lo), u32.from(b.hi), u32.from(b.lo), u32.from(b.lo), 1. - b.t, b.t, 0., 0.);
    v = v + 1usize;
  }
  body.append(piece);
}

// 'piece' appended to 'body', every vertex wholly bone 'bone''s
fn addRigid(body &mut Mesh, skin &mut Skin, piece &Mesh, bone usize) {
  mut v = 0usize;
  while v < piece.positions.len() {
    skin.push(u32.from(bone), u32.from(bone), u32.from(bone), u32.from(bone), 1., 0., 0., 0.);
    v = v + 1usize;
  }
  body.append(piece);
}

// The trunk's rings, bottom to top: height, half width (x), half depth (z)
// and the ring's middle's z (+z is behind: the figure faces -z), in H
const TRUNK_RINGS = 18usize;
const TRUNK Array[f32, 72] = [
  0.445, 0.040, 0.030, 0.000,     // the crotch, closed
  0.465, 0.105, 0.066, 0.006,
  0.500, 0.136, 0.076, 0.009,     // the seat
  0.545, 0.140, 0.072, 0.005,     // the hips, round the tops of the thighs
  0.600, 0.110, 0.062, 0.001,     // the waist
  0.660, 0.110, 0.064, -0.003,
  0.720, 0.120, 0.070, -0.006,    // the chest
  0.775, 0.130, 0.065, -0.002,
  0.812, 0.124, 0.056, 0.004,     // the line of the shoulders
  0.835, 0.098, 0.048, 0.006,     // sloping to the neck
  0.850, 0.050, 0.038, 0.005,
  0.862, 0.034, 0.034, 0.004,     // the neck
  0.878, 0.031, 0.034, 0.001,
  0.896, 0.040, 0.050, -0.006,    // the jaw
  0.930, 0.046, 0.058, -0.004,    // the head
  0.966, 0.044, 0.054, 0.000,
  0.991, 0.030, 0.038, 0.002,
  1.002, 0.008, 0.010, 0.000];    // the crown, closed

// A leg's rings from its top (buried in the pelvis, 0.05 H above the hip)
// to just past the ankle: distance from the top and radius, in H, and the
// ring's middle's z (+z behind: the calf)
const LEG_RINGS = 10usize;
const LEG Array[f32, 30] = [
  0.000, 0.020, 0.000,
  0.020, 0.041, 0.000,
  0.050, 0.050, 0.000,            // the hip
  0.140, 0.050, -0.003,
  0.220, 0.044, 0.000,
  0.295, 0.037, 0.000,            // the knee
  0.355, 0.040, 0.006,            // the calf
  0.445, 0.031, 0.003,
  0.541, 0.023, 0.000,            // the ankle
  0.556, 0.013, 0.000];

// An arm's rings from its top (ARM_TOP above the shoulder joint, along the
// arm, inside the shoulder) to just past the wrist: distance from the top
// and radius, in H
const ARM_TOP f32 = 0.022;
const ARM_RINGS = 10usize;
const ARM Array[f32, 20] = [
  0.000, 0.010,
  0.010, 0.027,
  0.022, 0.035,                   // the shoulder
  0.082, 0.033,
  0.162, 0.030,
  0.210, 0.026,                   // the elbow
  0.246, 0.029,                   // the forearm
  0.310, 0.024,
  0.355, 0.018,                   // the wrist
  0.365, 0.013];

// A hand's rings from the wrist along the hand: fraction of its 0.108 H,
// half width (forward and back) and half thickness (across the palm), in H
const HAND_RINGS = 5usize;
const HAND Array[f32, 15] = [
  0.00, 0.016, 0.012,
  0.25, 0.024, 0.013,
  0.60, 0.025, 0.011,
  0.90, 0.018, 0.008,
  1.00, 0.006, 0.004];

// A foot's rings from behind the heel (0.045 H behind the ankle) to the toe
// (0.115 H ahead): fraction of its 0.16 H, half width and height, in H
const FOOT_RINGS = 6usize;
const FOOT Array[f32, 18] = [
  0.00, 0.009, 0.018,
  0.07, 0.021, 0.044,
  0.28, 0.024, 0.058,             // under the ankle
  0.55, 0.029, 0.040,
  0.85, 0.027, 0.026,
  1.00, 0.010, 0.012];

// The mannequin's body for a figure 'h' metres tall, in its model space as
// the skeleton 'skel' stands at rest (the feet's ground point at the origin,
// facing -z), and its skin, one entry a vertex
pub fn bodyMesh(skel &bonepose.Skeleton, h f32, skin &mut Skin) Mesh {
  mut rest = List[Transform3].empty();
  skel.modelTransforms(&skel.restPose(), &mut rest);
  mut body = Mesh.empty();

  // The trunk, neck and head: pelvis, spine, chest, neck and head blended
  // at the waist, the chest, the base of the neck and the skull
  {
    mut profiles = List[sculpt.Profile].empty();
    mut at = List[f32].empty();
    imm y0 = TRUNK[0] * h;
    imm y1 = TRUNK[(TRUNK_RINGS - 1usize) * 4usize] * h;
    mut r = 0usize;
    while r < TRUNK_RINGS {
      imm e = r * 4usize;
      // The path runs up +y with the profiles' y on +z: their x is on -x
      profiles.push(ellipse(TRUNK_POINTS, TRUNK[e + 1usize] * h, TRUNK[e + 2usize] * h, 0., TRUNK[e + 3usize] * h));
      at.push((TRUNK[e] * h - y0) / (y1 - y0));
      r = r + 1usize;
    }
    imm piece = loftPiece(new Vec3(0., y0, 0.), new Vec3(0., y1, 0.), new Vec3(0., 0., 1.), &profiles, at.view());
    imm joints = [(*rest[bonepose.SPINE]).translation, (*rest[bonepose.CHEST]).translation,
      (*rest[bonepose.NECK]).translation, (*rest[bonepose.HEAD]).translation];
    imm bones = [bonepose.PELVIS, bonepose.SPINE, bonepose.CHEST, bonepose.NECK, bonepose.HEAD];
    imm zones = [0.035 * h, 0.045 * h, 0.030 * h, 0.020 * h];
    mut v = 0usize;
    while v < piece.positions.len() {
      imm p = *piece.positions[v];
      imm b = chainBlend(p, &joints, &bones, &zones);
      // The shoulders' tops lean towards the clavicle of their side
      imm ax = if p.x < 0. { 0. - p.x; } else { p.x; };
      imm c = 0.5 * smooth01(0.05 * h, 0.10 * h, ax) * smooth01(0.74 * h, 0.80 * h, p.y);
      imm clavicle = if p.x < 0. { bonepose.CLAVICLE_L; } else { bonepose.CLAVICLE_R; };
      skin.push(u32.from(b.lo), u32.from(b.hi), u32.from(clavicle), u32.from(b.lo), (1. - b.t) * (1. - c), b.t * (1. - c),
        c, 0.);
      v = v + 1usize;
    }
    body.append(&piece);
    // The nose, to show which way the head faces
    mut nose = Mesh.sphere(1., 10);
    nose.transform(Mat4.fromTrs(new Vec3(0., 0.925 * h, -0.058 * h), Quat.identity(),
      new Vec3(0.009 * h, 0.013 * h, 0.012 * h)));
    addRigid(&mut body, skin, &nose, bonepose.HEAD);
  }

  // The legs: pelvis, thigh, shin and foot blended at the hip, the knee and the ankle
  mut side = 0usize;
  while side < 2usize {
    imm thigh = if side == 0usize { bonepose.THIGH_L; } else { bonepose.THIGH_R; };
    imm shin = thigh + 2usize;
    imm foot = thigh + 4usize;
    imm hip = (*rest[thigh]).translation;
    imm knee = (*rest[shin]).translation;
    imm ankle = (*rest[foot]).translation;
    imm down = (ankle - hip).normalize();
    imm top = hip - down * (0.05 * h);
    imm length = LEG[(LEG_RINGS - 1usize) * 3usize] * h;
    mut profiles = List[sculpt.Profile].empty();
    mut at = List[f32].empty();
    mut r = 0usize;
    while r < LEG_RINGS {
      imm e = r * 3usize;
      imm radius = LEG[e + 1usize] * h;
      profiles.push(ellipse(LIMB_POINTS, radius, radius, 0., LEG[e + 2usize] * h));
      at.push(LEG[e] * h / length);
      r = r + 1usize;
    }
    imm piece = loftPiece(top, top + down * length, new Vec3(0., 0., 1.), &profiles, at.view());
    imm joints = [hip, knee, ankle];
    imm bones = [bonepose.PELVIS, thigh, shin, foot];
    imm zones = [0.040 * h, 0.045 * h, 0.018 * h];
    addChained(&mut body, skin, &piece, &joints, &bones, &zones);

    // The foot, flat soled at the ground, wholly the foot's
    mut feet = List[sculpt.Profile].empty();
    mut fat = List[f32].empty();
    r = 0usize;
    while r < FOOT_RINGS {
      imm e = r * 3usize;
      feet.push(soleRing(LIMB_POINTS, FOOT[e + 1usize] * h, FOOT[e + 2usize] * h));
      fat.push(FOOT[e]);
      r = r + 1usize;
    }
    imm heel = new Vec3(ankle.x, 0., ankle.z + 0.045 * h);
    imm toe = new Vec3(ankle.x, 0., ankle.z - 0.115 * h);
    imm footPiece = loftPiece(heel, toe, new Vec3(0., 1., 0.), &feet, fat.view());
    addRigid(&mut body, skin, &footPiece, foot);
    side = side + 1usize;
  }

  // The arms: clavicle, upper arm, forearm and hand blended at the
  // shoulder, the elbow and the wrist; the hands wholly their own
  side = 0usize;
  while side < 2usize {
    imm upper = if side == 0usize { bonepose.UPPER_ARM_L; } else { bonepose.UPPER_ARM_R; };
    imm clavicle = upper - 2usize;
    imm fore = upper + 2usize;
    imm hand = upper + 4usize;
    imm shoulder = (*rest[upper]).translation;
    imm elbow = (*rest[fore]).translation;
    imm wrist = (*rest[hand]).translation;
    imm down = (wrist - shoulder).normalize();
    imm top = shoulder - down * (ARM_TOP * h);
    imm length = ARM[(ARM_RINGS - 1usize) * 2usize] * h;
    mut profiles = List[sculpt.Profile].empty();
    mut at = List[f32].empty();
    mut r = 0usize;
    while r < ARM_RINGS {
      imm e = r * 2usize;
      imm radius = ARM[e + 1usize] * h;
      profiles.push(ellipse(LIMB_POINTS, radius, radius, 0., 0.));
      at.push(ARM[e] * h / length);
      r = r + 1usize;
    }
    imm piece = loftPiece(top, top + down * length, new Vec3(0., 0., 1.), &profiles, at.view());
    imm joints = [shoulder, elbow, wrist];
    imm bones = [clavicle, upper, fore, hand];
    imm zones = [0.035 * h, 0.035 * h, 0.014 * h];
    addChained(&mut body, skin, &piece, &joints, &bones, &zones);

    // The hand: a mitten along the hand bone, flat across the palm (its
    // profiles' y out from the body, across the palm)
    mut rings = List[sculpt.Profile].empty();
    mut hat = List[f32].empty();
    r = 0usize;
    while r < HAND_RINGS {
      imm e = r * 3usize;
      rings.push(ellipse(HAND_POINTS, HAND[e + 1usize] * h, HAND[e + 2usize] * h, 0., 0.));
      hat.push(HAND[e]);
      r = r + 1usize;
    }
    imm out = if side == 0usize { new Vec3(-1., 0., 0.); } else { new Vec3(1., 0., 0.); };
    imm handPiece = loftPiece(wrist, wrist + down * (0.108 * h), out, &rings, hat.view());
    addRigid(&mut body, skin, &handPiece, hand);
    side = side + 1usize;
  }
  body;
}

// The colour of the wood: a pale natural beech, sRGB (214, 176, 128), linear
pub fn woodColor() Color { new Color(0.672, 0.434, 0.216, 1.); }
// A second figure painted a muted clay red, sRGB (170, 92, 70)
pub fn clayColor() Color { new Color(0.402, 0.107, 0.061, 1.); }

// Send a mannequin of 'height' metres into the scene: its body (bodyMesh),
// a skinned mesh, defined, in one material of 'color', and shown as 'root'
// (the being's own part), standing as modelled until its first Bones.
// Answers its rigid attachments' parts (none yet).
pub fn spawnMannequin(scene &mut Scene, height f32, color Color, root PartId) List[PartId] {
  imm skel = bonepose.humanoid(height);
  mut skin = Skin.empty();
  imm body = bodyMesh(&skel, height, &mut skin);
  imm wood = scene.door.defineMaterial(Look.shiny(color, 0.25, 18.), Image.empty(), Maps.none());
  imm mesh = scene.door.defineSkinnedMesh(body, skin);
  scene.send(Request.Show[root, mesh, wood, 0.]);
  List[PartId].empty();
}
