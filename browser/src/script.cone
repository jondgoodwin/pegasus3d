// The scripted walk: with no one at the keyboard, key events are pushed into
// SDL's own queue (sdl.PushEvent), never the system's, so nothing reaches any
// other window. Each is pushed just after a frame is presented, to be drained
// at the top of the next. On frame's synthetic clock (one 1/60 s step a
// frame, none on the first), the walk they give is exact, and is checked.
//
//   frames 1-29     standing 8 m back from the origin, facing -z  shot "start" at 20
//                   (the world arrives an object a frame, frames 1 to 7)
//   frames 30-89    W held: 60 steps at 3 m/s, 3 m forward,
//                   up to the rooks and the horn-flower
//   frame 120       a click on the (boolean) rook: picked and highlighted
//                                                                 shot "picked" at 130
//   frame 145       a click on the sky: nothing picked, the rook let go
//                                                                 shot "walked" at 160
//   frames 170-199  D held: 30 steps, a twelfth of a turn right   shot "turned" at 210
//   frames 220-249  Shift and W held: 30 steps at 12 m/s, 6 m on that heading
//   frame 182       the world's alarm (a timer for 3 s of scene time) rings
//   frames 256-270  P pressed: scene time paused (the walker stands anyway)
//   frames 276-286  F pressed: scene time x10, then F again, x1: checked at 290
//   frames 300-434  Shift and W held: 135 steps, 27 m on, to 13 m from the
//                   balloon's basket and beside its launch button, coming
//                   into the button's area on the way (the world is told)
//   frame 450       a click on the launch button: the world is told, and the
//                   balloon rises                                 shot "balloon" at 580
//   all along       the ball bounces and spins, the burner fires in bursts:
//                   checked against their formulas at frames 200 and 590
//   frames 600-659  close-ups, drawn from the script's own eyes (the walk
//                   is not moved): the two rooks at 602 ("rooks"), the
//                   chimney with the sun raking its face at 612
//                   ("chimney"), the starship at 622 ("starship"), the
//                   balloon rising, from where the walk ended, at 632
//                   ("rising"), the amphora straight on through a 20
//                   degree lens, as the photograph it was traced from
//                   shows it, at 642 ("amphora"), the horn-flower at 652
//                   ("hornflower")

// The device the script's events claim (no real keyboard has it)
pub const SCRIPT_DEVICE = 0x5C1u;

// The frames a scripted run needs
pub const SCRIPT_FRAMES = 940u64;

// The mannequins' part of the run: the first frame, and the figures in it
// (the plain walker is being 0, the mannequin the user takes over 1, the
// other 2)
pub const MANNEQUIN_FROM = 660u64;
pub const SCRIPT_FIGURES = 2usize;

// A pose at 'eye' looking at 'target' (level of roll)
fn lookFrom(eye Vec3, target Vec3) Pose {
  imm d = target - eye;
  imm flat = libc.sqrtf(d.x * d.x + d.z * d.z);
  Pose.look(eye, libc.atan2f(0. - d.x, 0. - d.z), libc.atan2f(d.y, flat));
}

// Whether frame 'f' is drawn from a close-up's eye
pub fn hasView(f u64) bool { (f >= 600u64 and f < MANNEQUIN_FROM) or (f >= 700u64 and f < 730u64) or (f >= 892u64 and f < 920u64); }

// The close-up's eye for frame 'f'
pub fn viewAt(f u64) Pose {
  if f >= 700u64 {
    // From the first mannequin's right side, square to the way it goes,
    // level with its chest, 3 m off; or the second's left, 3.2 m off, as it
    // falls and lands
    imm at = cast.beings[1usize].body.position;
    if f >= 892u64 {
      imm lp = cast.beings[2usize].body.position;
      return lookFrom(new Vec3(lp.x - 3.2, 1.0, lp.z), new Vec3(lp.x, 0.8, lp.z));
    }
    return lookFrom(new Vec3(at.x + 3.0, 1.05, at.z), new Vec3(at.x, 0.95, at.z));
  }
  if f < 610u64 { return lookFrom(new Vec3(-2.15, 1.55, 3.1), new Vec3(-2.15, 0.75, 0.6)); }
  // The chimney (at (-10, -17), turned 0.6 rad) from half way between its
  // front face, which the sun rakes, and its sunlit left face
  if f < 620u64 { return lookFrom(new Vec3(-10.57, 2.2, -13.94), new Vec3(-10., 2.25, -17.)); }
  if f < 630u64 { return lookFrom(new Vec3(40., 20., -60.), new Vec3(-60., 42., -170.)); }
  // Where the walk ended, looking up at the balloon rising
  if f < 640u64 { return lookFrom(new Vec3(16.5, 1.7, -23.58), new Vec3(23., 15., -34.84)); }
  // The amphora (at (-7.4, -17)) straight on, its panel towards the eye,
  // its handles left and right, from 4.8 m at half its height
  if f < 650u64 { return lookFrom(new Vec3(-7.4, AMPHORA_EYE_Y, -17. + AMPHORA_EYE_DISTANCE), new Vec3(-7.4, AMPHORA_EYE_Y, -17.)); }
  // The horn-flower from half way between its side (square to the plane it
  // bends in) and the way its bloom faces, from above the bloom
  lookFrom(new Vec3(0., 3.3, 4.8), new Vec3(-0.25, 1.2, 2.2));
}

// The amphora's eye: level, at half its height, 4.8 m away, through 20 degrees
pub const AMPHORA_EYE_Y f32 = 0.742;
pub const AMPHORA_EYE_DISTANCE f32 = 4.8;
pub const AMPHORA_FOV f32 = 0.34906585;

// The close-up's vertical field of view: the amphora's longer lens, or the walk's
pub fn viewFov(f u64) f32 { if f >= 640u64 and f < 650u64 { AMPHORA_FOV; } else { FOV; }; }

fn pushKey(scancode u32, down bool) {
  mut e = sdl.Event.empty();
  e.type = if down {sdl.EVENT_KEY_DOWN;} else {sdl.EVENT_KEY_UP;};
  imm k = &mut e as &mut sdl.KeyboardEvent;
  k.which = SCRIPT_DEVICE;
  k.scancode = scancode;
  k.key = 0u;
  k.down = down;
  e.timestamp = 0u64;
  sdl.PushEvent(&mut e);
}

// The script's events for frame 'f'
pub fn pushScript(f u64) {
  if f == 30u64 { pushKey(sdl.SCANCODE_W, true); }
  if f == 90u64 { pushKey(sdl.SCANCODE_W, false); }
  if f == 170u64 { pushKey(sdl.SCANCODE_D, true); }
  if f == 200u64 { pushKey(sdl.SCANCODE_D, false); }
  // The mannequin: Tab takes it over (third person), W walks it from 665 to
  // 740, V to first person at 770 and back at 782, Tab to the other at 790
  if f == 660u64 or f == 820u64 { pushKey(SCANCODE_TAB, true); }
  if f == 662u64 or f == 822u64 { pushKey(SCANCODE_TAB, false); }
  if f == 665u64 { pushKey(sdl.SCANCODE_W, true); }
  if f == 725u64 { pushKey(sdl.SCANCODE_W, false); }
  if f == 790u64 or f == 805u64 { pushKey(SCANCODE_V, true); }
  if f == 792u64 or f == 807u64 { pushKey(SCANCODE_V, false); }
  if f == 220u64 or f == 300u64 {
    pushKey(sdl.SCANCODE_LSHIFT, true);
    pushKey(sdl.SCANCODE_W, true);
  }
  if f == 250u64 or f == 435u64 {
    pushKey(sdl.SCANCODE_W, false);
    pushKey(sdl.SCANCODE_LSHIFT, false);
  }
  // The scene clock's keys, while the walker stands: P pauses at 256 and
  // starts again at 271; F runs it x10 from 276 until 286
  if f == 256u64 or f == 271u64 { pushKey(SCANCODE_P, true); }
  if f == 258u64 or f == 273u64 { pushKey(SCANCODE_P, false); }
  if f == 276u64 or f == 286u64 { pushKey(SCANCODE_F, true); }
  if f == 278u64 or f == 288u64 { pushKey(SCANCODE_F, false); }
}

fn pushButton(x f32, y f32, down bool) {
  mut e = sdl.Event.empty();
  e.type = if down {sdl.EVENT_MOUSE_BUTTON_DOWN;} else {sdl.EVENT_MOUSE_BUTTON_UP;};
  imm b = &mut e as &mut sdl.MouseButtonEvent;
  b.which = SCRIPT_DEVICE;
  b.button = sdl.BUTTON_LEFT;
  b.down = down;
  b.clicks = 1u8;
  b.x = x;
  b.y = y;
  e.timestamp = 0u64;
  sdl.PushEvent(&mut e);
}

// Where the script clicks, and on what
mut clickAt Vec2;             // set by the module's init
mut rookClick bool = false;   // the click on the rook landed where the rook is drawn

// Where world point 'p' is drawn for a viewer at 'w' (the walk is still
// when the script clicks)
fn seen(host &mut Host, w &Walk, p Vec3) Vec2 {
  imm size = viewSize(host);
  placeOnView(w.pose(), FOV, p, size.x, size.y);
}

// The world point at part 'id''s placement, 'up' metres above it
fn partPoint(id PartId, up f32) Vec3 {
  imm m = scene.worldMatrix(id);
  new Vec3(m.m[12], m.m[13] + up, m.m[14]);
}

// The script's clicks for frame 'f': pressed then let go two frames later
pub fn pushClicks(host &mut Host, f u64, w &Walk) {
  if f == 120u64 {
    // The boolean rook, 0.7 m up its 1.4
    clickAt = seen(host, w, partPoint(world.partOf(ROOK, 0usize), 0.7));
    pushButton(clickAt.x, clickAt.y, true);
  }
  if f == 145u64 {
    // The sky, high in the middle
    clickAt = new Vec2(viewSize(host).x * 0.5, viewSize(host).y * 0.1);
    pushButton(clickAt.x, clickAt.y, true);
  }
  if f == 450u64 {
    // The launch button's cap, at its middle
    clickAt = seen(host, w, partPoint(world.buttonCap(), 0.03));
    pushButton(clickAt.x, clickAt.y, true);
  }
  if f == 122u64 or f == 147u64 or f == 452u64 { pushButton(clickAt.x, clickAt.y, false); }
}

// The ball's height, as its formula has it, at the scene's time 'now'
fn ballHeight(now f64) f32 {
  imm t = f32.from(now);
  0.5 + 1.6 * libc.fabsf(sin(pi * t / 1.1));
}

// The script's checks of the clicks and the motions at frame 'f'
fn checkMotions(f u64) bool {
  mut ok = true;
  if f == 125u64 {
    print <- "Frame 125, after a click on the rook:\n";
    imm want = world.partOf(ROOK, 0usize);
    print <- "  picked: "; printStr(scene.nameOf(lastPick.id).view());
    if !(lastPick.id == want) { print <- " WRONG (want the rook)"; ok = false; }
    if !(picked == want) { print <- ", NOT highlighted"; ok = false; }
    print <- "\n";
  }
  if f == 150u64 {
    print <- "Frame 150, after a click on the sky: ";
    if lastPick.id.isNone() and picked.isNone() { print <- "nothing picked, nothing highlighted\n"; }
    else { print <- "something picked: WRONG\n"; ok = false; }
    print <- "  clicks: "; print <- clicks; print <- " (want 2)\n";
    if clicks != 2u64 { ok = false; }
  }
  if f == 200u64 or f == 590u64 {
    print <- "Frame "; print <- f; print <- ", the ball at "; print <- sceneNow; print <- " s:\n";
    ok = near("height", scene.worldMatrix(world.partOf(BALL, 0usize)).m[13], ballHeight(sceneNow), 0.0005) and ok;
  }
  if f == 455u64 {
    print <- "Frame 455, after a click on the launch button: the world read "; print <- world.presses;
    print <- " press (want 1)";
    if world.presses != 1u64 or !world.flight.rising() { print <- ", NOT rising"; ok = false; }
    print <- "\n";
  }
  if f == 590u64 {
    // Rising at 2.5 m/s since the press, every part with it
    imm alt = 2.5 * f32.from(sceneNow - world.pressedAt);
    print <- "Frame 590, the balloon "; print <- sceneNow - world.pressedAt; print <- " s after the press:\n";
    imm from = world.partsOf(BALLOON);
    ok = near("envelope's rise", scene.worldMatrix(world.partOf(BALLOON, 0usize)).m[13] - balloonBaseY, alt, 0.002) and ok;
    // Every part of it (meshes, flame, pilot) risen as far
    mut j = 1usize;
    mut together = true;
    while j < from {
      imm rise = scene.worldMatrix(world.partOf(BALLOON, j)).m[13] - balloonPartY(j);
      if rise - alt > 0.002 or alt - rise > 0.002 { together = false; }
      j = j + 1usize;
    }
    print <- "  its "; print <- from; print <- " parts risen together: ";
    if together { print <- "yes\n"; } else { print <- "NO\n"; ok = false; }
    print <- "  the burner: "; print <- world.fires; print <- " bursts sent, "; print <- fired; print <- " applied (want as many, 2 or more)\n";
    if world.fires != fired or fired < 2u64 { ok = false; }
  }
  ok;
}

// The balloon's parts' heights before any press (taken at frame 29)
mut balloonBaseY f32 = 0.;
mut balloonYs Array[f32, 8] = [0., 0., 0., 0., 0., 0., 0., 0.];
fn balloonPartY(j usize) f32 { balloonYs[j]; }
fn takeBalloonBase() {
  mut j = 0usize;
  while j < world.partsOf(BALLOON) and j < 8usize {
    balloonYs[j] = scene.worldMatrix(world.partOf(BALLOON, j)).m[13];
    j = j + 1usize;
  }
  balloonBaseY = balloonYs[0usize];
}

// A part made and taken away again through the scene's requests, and a
// request sent afterwards to its stale id, which must be refused
mut tempPart PartId;          // set by the module's init
mut tempApplied u64 = 0u64;   // the scene's counts just before it was made
mut tempRefused u64 = 0u64;
mut tempSent u64 = 0u64;

// The script's scene requests, sent after frame 'f' is presented
pub fn driveScene(f u64) {
  if f == 3u64 {
    tempApplied = scene.applied;
    tempRefused = scene.refused;
    tempSent = scene.door.sent;
    tempPart = scene.newPart("temporary cube");
    imm cube = scene.door.defineMesh(Mesh.cube(0.5));
    imm red = scene.door.defineMaterial(Look.plain(new Color(1., 0., 0., 1.)), Image.empty(), Maps.none());
    scene.send(Request.Show[tempPart, cube, red, 0.]);
  }
  if f == 5u64 { scene.send(Request.Despawn[tempPart]); }
  if f == 7u64 { scene.send(Request.Place[tempPart, Transform3.identity()]); }
  // The second mannequin lifted 6 m into the air, to fall and land hard
  // (a test hook: the ground is flat, so nothing else drops anyone)
  if f == 840u64 {
    imm b = &mut cast.beings[2usize];
    b.figure.grounded = false;
    b.body.position = b.body.position + new Vec3(0., 6., 0.);
  }
}

// The view saved at frame 'f', or an empty name
pub fn shotAt(f u64) &[]u8 {
  if f == 20u64 { return "start"; }
  if f == 160u64 { return "walked"; }
  if f == 210u64 { return "turned"; }
  if f == 580u64 { return "balloon"; }
  if f == 602u64 { return "rooks"; }
  if f == 130u64 { return "picked"; }
  if f == 612u64 { return "chimney"; }
  if f == 622u64 { return "starship"; }
  if f == 632u64 { return "rising"; }
  if f == 642u64 { return "amphora"; }
  if f == 652u64 { return "hornflower"; }
  if f == 690u64 { return "mannequin-third"; }
  if f == 708u64 { return "mannequin-side"; }
  if f == 718u64 { return "mannequin-side2"; }
  if f == 800u64 { return "mannequin-first"; }
  if f == 830u64 { return "mannequin-second"; }
  if f == 896u64 { return "mannequin-falling"; }
  if f == 911u64 { return "mannequin-landing"; }
  "";
}

fn near(name &[]u8, got f32, want f32, within f32) bool {
  print <- "  "; printStr(name); print <- ": "; print <- got; print <- " (want "; print <- want; print <- ")";
  imm ok = got - want <= within and want - got <= within;
  if ok { print <- "\n"; } else { print <- " WRONG\n"; }
  ok;
}

// The world's parts each the scene's: live, placed, and (with a GPU) drawn
// or giving off particles. The world was handed only the Door, which holds
// no table: that is the compiler's to check (scene's tables are private to
// the scene module), and this checks what the world sent arrived.
fn checkWorld() bool {
  mut ok = world.done();
  print <- "The world: "; print <- world.ids.len(); print <- " parts sent (want "; print <- WORLD_PARTS; print <- ")";
  if !world.done() { print <- ", NOT every object sent"; }
  if world.ids.len() != WORLD_PARTS { ok = false; }
  mut live = 0usize;
  mut placed = 0usize;
  mut drawn = 0usize;
  mut i = 0usize;
  while i < world.ids.len() {
    imm id = *world.ids[i];
    if scene.isLive(id) { live = live + 1usize; }
    if scene.isPlaced(id) { placed = placed + 1usize; }
    if isDrawn(id) { drawn = drawn + 1usize; }
    i = i + 1usize;
  }
  print <- "; live "; print <- live; print <- ", placed "; print <- placed;
  if hasGpu() { print <- ", drawn or emitting "; print <- drawn; }
  print <- "\n";
  if live != WORLD_PARTS or placed != WORLD_PARTS { ok = false; }
  if hasGpu() and drawn != WORLD_PARTS { ok = false; }
  print <- "  the scene: "; print <- scene.partCount(); print <- " parts (want "; print <- SHELL_PARTS + WORLD_PARTS + SCRIPT_FIGURES * FIGURE_PARTS;
  print <- "); sent "; print <- scene.door.sent; print <- " = applied "; print <- scene.applied; print <- " + refused ";
  print <- scene.refused; print <- " (want 1), waiting "; print <- scene.waiting(); print <- "\n";
  if scene.partCount() != SHELL_PARTS + WORLD_PARTS + SCRIPT_FIGURES * FIGURE_PARTS or scene.door.sent != scene.applied + scene.refused
    or scene.refused != 1u64 or scene.waiting() != 0usize { ok = false; }
  if !ok { print <- "  the world's injection is WRONG\n"; }
  ok;
}

// The parts the world sends: the rooks, the amphora, the boulder and the
// horn, one each; the horn-flower's four (stalk, leaves, petals, heart);
// the chimney's three (the brick stack, its flaunching, its pot); the
// balloon's six and its flame and pilot light, the starship's six, the
// launch button's two, the ball, the mound
const WORLD_PARTS = 30usize;

// Part 'id''s shape's bounds in its own frame, as the picking system keeps them
fn boundsOf(id PartId) Aabb3 {
  picks.boundsOf(id);
}

fn nearBox(name &[]u8, b Aabb3, lo Vec3, hi Vec3) bool {
  mut ok = near(name, b.max.y, hi.y, 0.001);
  ok = near("    its x from", b.min.x, lo.x, 0.001) and ok;
  ok = near("    to", b.max.x, hi.x, 0.001) and ok;
  ok = near("    its z from", b.min.z, lo.z, 0.001) and ok;
  ok = near("    to", b.max.z, hi.z, 0.001) and ok;
  ok = near("    its foot", b.min.y, lo.y, 0.001) and ok;
  ok;
}

// The parts step 4 made, as built: the amphora's height the trace's (1.484
// m to the bud's tip) and its widest the trace's (0.3368 at 0.7148 m; the
// handles reach 0.2431); the stack whole courses (47 of 75 mm: 3.525 m)
// and, at its top oversailing course, 5 x 4 bricks (1.125 x 0.9 m); both
// drawn physically based, with a GPU; the horn-flower's and the chimney's
// parts all there
fn checkStep4() bool {
  print <- "The amphora, the chimney, the horn-flower:\n";
  imm amphora = world.partOf(AMPHORA, 0usize);
  mut ok = nearBox("  the amphora's height", boundsOf(amphora), new Vec3(-0.3368, 0., -0.3368), new Vec3(0.3368, 1.484, 0.3368));
  imm stack = world.partOf(CHIMNEY, 0usize);
  ok = nearBox("  the chimney stack's height", boundsOf(stack), new Vec3(-0.5625, 0., -0.45), new Vec3(0.5625, 3.525, 0.45)) and ok;
  print <- "  parts: horn-flower "; print <- world.partsOf(HORNFLOWER); print <- " (want 4), chimney ";
  print <- world.partsOf(CHIMNEY); print <- " (want 3)\n";
  if world.partsOf(HORNFLOWER) != 4usize or world.partsOf(CHIMNEY) != 3usize { ok = false; }
  if hasGpu() {
    imm both = isPhysical(amphora) and isPhysical(stack);
    print <- "  the amphora and the stack drawn physically based: ";
    if both { print <- "yes\n"; } else { print <- "NO\n"; ok = false; }
  }
  ok;
}

// The scene's time when the script's P and F keys took effect
mut pausedAt f64 = 0d;
mut fastFrom f64 = 0d;

// The scene clock's keys, and the events on the scene's clock, at frame 'f'
fn checkClock(f u64) bool {
  mut ok = true;
  imm step = 1d / 60d;
  if f == 256u64 {
    pausedAt = sceneNow;
    if !scene.clock.paused { print <- "Frame 256: P did NOT pause scene time\n"; ok = false; }
  }
  if f == 270u64 {
    // Paused since frame 256's publish: 14 frames of steps, no scene time
    print <- "Frame 270, scene time paused since frame 256:\n";
    ok = near("scene time", f32.from(sceneNow), f32.from(pausedAt), 0.) and ok;
  }
  if f == 276u64 {
    fastFrom = sceneNow;
    if scene.clock.rate() != 10u64 { print <- "Frame 276: F did NOT run scene time x10\n"; ok = false; }
  }
  if f == 290u64 {
    // From frame 276: frames 277 to 286 at x10, 287 to 290 at x1
    print <- "Frame 290, after 10 frames at x10 and 4 at x1:\n";
    ok = near("scene time run", f32.from(sceneNow - fastFrom), f32.from(104d * step), 0.00001) and ok;
    if scene.clock.paused or scene.clock.rate() != 1u64 { print <- "  the clock NOT back to x1\n"; ok = false; }
  }
  if f == 200u64 {
    // The world's alarm, set for 3 s, read at the first apply point at or after
    print <- "Frame 200, the world's alarm: rung "; print <- world.alarms; print <- " (want 1), heard at ";
    print <- world.alarmHeardAt; print <- " s (want 3 to "; print <- 3d + step; print <- ")\n";
    if world.alarms != 1u64 or world.alarmHeardAt < ALARM_AT or world.alarmHeardAt >= ALARM_AT + step + 0.000001d {
      ok = false;
    }
  }
  if f == 590u64 {
    // The walker came up to the launch button and is still beside it
    imm area = world.partOf(LAUNCH_BUTTON, 0usize);
    imm inside = scene.isInside(area, cast.beings[cast.possessed].part);
    print <- "Frame 590, the button's area: entered "; print <- world.arrivals; print <- " (want 1), left ";
    print <- world.departures; print <- " (want 0), the walker inside: ";
    if inside { print <- "yes\n"; } else { print <- "NO\n"; }
    if world.arrivals != 1u64 or world.departures != 0u64 or !inside { ok = false; }
    print <- "  the day clock: "; print <- scene.hour(); print <- " h (want "; print <- START_HOUR + sceneNow / 60d; print <- ")\n";
    imm h = scene.hour() - (START_HOUR + sceneNow / 60d);
    if h > 0.000001d or h < -0.000001d { ok = false; }
  }
  ok;
}

// The scene's tree and its shared resources, once the world is in: the
// balloon one tree under its envelope (the flame and pilot light under the
// burner frame, the passengers under the basket); the two rooks drawn in one
// material; every mesh but one with a material of its own
fn checkSharing() bool {
  mut ok = true;
  print <- "The balloon's tree:";
  imm envelope = world.partOf(BALLOON, 0usize);
  imm frame = world.partOf(BALLOON, 2usize);
  imm basket = world.partOf(BALLOON, 4usize);
  imm tree = scene.parentOf(envelope).isNone() and scene.parentOf(world.partOf(BALLOON, 1usize)) == envelope
    and scene.parentOf(frame) == envelope and scene.parentOf(world.partOf(BALLOON, 3usize)) == envelope
    and scene.parentOf(basket) == envelope and scene.parentOf(world.partOf(BALLOON, 5usize)) == basket
    and scene.parentOf(world.partOf(BALLOON, 6usize)) == frame and scene.parentOf(world.partOf(BALLOON, 7usize)) == frame;
  if tree { print <- " as built\n"; } else { print <- " WRONG\n"; ok = false; }
  print <- "Resources: "; print <- scene.door.meshes; print <- " meshes, "; print <- scene.door.materials;
  print <- " materials (want one fewer: the rooks share theirs, and each mannequin is "; print <- FIGURE_MESHES;
  print <- " meshes in one material), "; print <- scene.resourceCount(); print <- " defined\n";
  if scene.door.meshes != scene.door.materials + 1u64 + u64.from(SCRIPT_FIGURES) * (FIGURE_MESHES - 1u64)
    or u64.from(scene.resourceCount()) != scene.door.meshes + scene.door.materials {
    ok = false;
  }
  if hasGpu() {
    imm a = drawnMaterial(world.partOf(ROOK, 0usize));
    imm b = drawnMaterial(world.partOf(LATHED_ROOK, 0usize));
    print <- "  the two rooks drawn in one material: ";
    if !a.isNone() and a == b { print <- "yes\n"; } else { print <- "NO\n"; ok = false; }
  }
  ok;
}

fn yesNo(what &[]u8, cond bool) bool {
  print <- "  "; printStr(what); if cond { print <- ": yes\n"; } else { print <- ": NO\n"; }
  cond;
}

// The mannequins' part of the run: Tab takes the first over (third person),
// W walks it 75 steps, V to first person and back, Tab to the second, which
// is lifted 6 m and falls: a hard landing, mailed to the world
fn checkMannequinRun(f u64) bool {
  mut ok = true;
  if f == 665u64 {
    print <- "Frame 665, after Tab:\n";
    ok = yesNo("the user possesses the first mannequin, in third person",
      cast.possessed == 1usize and cast.rig.mode == VIEW_THIRD) and ok;
  }
  if f == 720u64 {
    imm eye = cast.eyes().origin;
    imm b = &mut cast.beings[1usize];
    print <- "Frame 720, W held for 55 steps:\n";
    ok = near("the gait's speed followed the intent (m/s)", b.figure.walker.speed, WALK_SPEED, 0.02) and ok;
    ok = yesNo("the figure is not frozen: it is walking", !b.figure.walker.frozen) and ok;
    ok = near("the third-person camera behind it (m)", eye.z - b.body.position.z, THIRD_BEHIND, 0.5) and ok;
    ok = yesNo("and above its head", eye.y > 1.8 and eye.y < 2.6) and ok;
  }
  if f == 735u64 {
    imm b = &mut cast.beings[1usize];
    print <- "Frame 735, 60 steps of W and the stop after:\n";
    // 60 steps at 1.8 m/s is 1.8 m; the ramp up loses 0.12 m and the stop coasts 0.12 m
    ok = near("z", b.body.position.z, START_Z - WALK_SPEED, 0.02) and ok;
    ok = near("x", b.body.position.x, 5., 0.0001) and ok;
    ok = near("on the ground, y", b.body.position.y, 0., 0.0001) and ok;
    ok = yesNo("the second mannequin stood, idle and breathing", cast.beings[2usize].figure.walker.frozen
      and cast.beings[2usize].body.position.x == 3.5) and ok;
  }
  if f == 800u64 {
    imm eye = cast.eyes().origin;
    imm mode = cast.rig.mode;
    imm b = &mut cast.beings[1usize];
    print <- "Frame 800, after V:\n";
    ok = yesNo("first person", mode == VIEW_FIRST) and ok;
    ok = near("the camera at the eyes socket, m up (1.638 less the pelvis' 2.6 cm of bent knee, and the walk's bob)", eye.y, 1.61, 0.05) and ok;
    ok = near("and 0.1 m ahead of the body's middle (z)", eye.z - b.body.position.z, -0.105, 0.04) and ok;
  }
  if f == 830u64 {
    print <- "Frame 830, after V back and Tab:\n";
    ok = yesNo("the user possesses the second mannequin, in third person", cast.possessed == 2usize
      and cast.rig.mode == VIEW_THIRD) and ok;
  }
  if f == 925u64 {
    imm b = &mut cast.beings[2usize];
    print <- "Frame 925, 6 m up at frame 840 and fallen:\n";
    ok = yesNo("it has landed and stands on the ground", b.figure.grounded and b.body.position.y == 0.) and ok;
    ok = near("the impact speed (m/s), v = sqrt(2 g h)", b.figure.landSpeed, 10.85, 0.3) and ok;
    ok = yesNo("one hard landing, mailed to the world and read by it", b.figure.hardLandings == 1u32
      and hardLandingsMailed == 1u64 and world.hardLandings == 1u64) and ok;
    ok = near("it hurt: health (1 less (speed - 10) / 14)", b.figure.health, 1. - (b.figure.landSpeed - 10.) / 14., 0.001) and ok;
  }
  ok;
}

// What the script's events must have done by the end of frame 'f'
pub fn checkScript(f u64, w &Walk) bool {
  mut ok = checkMannequinRun(f);
  if f == 2u64 {
    // The shell's requests and the world's first object's, applied at
    // frame 1's apply point
    print <- "Frame 2: requests applied "; print <- scene.applied; print <- " (want "; print <- scene.door.sent;
    print <- "), refused "; print <- scene.refused; print <- " (want 0), waiting "; print <- scene.waiting(); print <- "\n";
    if scene.applied != scene.door.sent or scene.refused != 0u64 or scene.waiting() != 0usize { ok = false; }
  }
  if f == 9u64 {
    // Since frame 3: the temporary cube spawned and shown, despawned, the
    // Place to its stale id refused; the world's requests all applied
    imm sent = scene.door.sent - tempSent;
    print <- "Frame 9: since frame 3, sent "; print <- sent; print <- ", applied "; print <- scene.applied - tempApplied;
    print <- " (want "; print <- sent - 1u64; print <- "), refused "; print <- scene.refused - tempRefused;
    print <- " (want 1)";
    if scene.isReserved(tempPart) { print <- ", the stale id still RESERVED"; ok = false; }
    print <- "\n";
    if scene.applied - tempApplied != sent - 1u64 or scene.refused - tempRefused != 1u64 { ok = false; }
  }
  if f == 29u64 {
    ok = checkWorld() and ok;
    ok = checkStep4() and ok;
    ok = checkSharing() and ok;
    print <- "Frame 29, standing:\n";
    ok = near("x", w.position.x, 0., 0.) and ok;
    ok = near("z", w.position.z, 8., 0.) and ok;
    ok = near("yaw", w.yaw, 0., 0.) and ok;
    takeBalloonBase();
  }
  ok = checkMotions(f) and ok;
  if f == 165u64 {
    print <- "Frame 165, after 60 steps of W at 3 m/s:\n";
    ok = near("x", w.position.x, 0., 0.0001) and ok;
    ok = near("z", w.position.z, 5., 0.001) and ok;
    ok = near("eye height", w.pose().origin.y, 1.7, 0.0001) and ok;
  }
  if f == 205u64 {
    print <- "Frame 205, after 30 steps of D:\n";
    ok = near("yaw", w.yaw, -0.5235988, 0.00001) and ok;
    ok = near("z", w.position.z, 5., 0.001) and ok;
  }
  ok = checkClock(f) and ok;
  if f == 290u64 {
    // 6 m along the heading -30 degrees from -z: (6 sin 30, -6 cos 30)
    print <- "Frame 290, after 30 steps of Shift and W at 12 m/s:\n";
    ok = near("x", w.position.x, 3., 0.002) and ok;
    ok = near("z", w.position.z, 5. - 5.196152, 0.002) and ok;
  }
  if f == 590u64 {
    // 27 m more on that heading: 33 m in all from (0, 5)
    print <- "Frame 590, after 135 more steps of Shift and W:\n";
    ok = near("x", w.position.x, 16.5, 0.01) and ok;
    ok = near("z", w.position.z, 5. - 28.578838, 0.01) and ok;
    ok = checkWorld() and ok;
  }
  ok;
}

pub fn reportScript(ok bool) {
  if ok { print <- "Script: OK\n"; } else { print <- "Script: FAILED\n"; }
}
