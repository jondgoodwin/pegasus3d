// The --checks of the labyrinth's creatures (creatures.cone, creaturethink.cone, creaturelook.cone, netcodec.cone's Creature): the puzzle's
// logic, the guards' answers, the Worm, and the Minotaur's whole behaviour in the labyrinth's own solids: the stagger, the shove, the
// bull-leap. They run on the real physics (the rooms' solids, mannequins walked by the character controller), stepped as the simulation
// steps them.

// The visitor's and the creatures' world, stepped as simactor.cone steps it
struct CrRig {
  s: Scene;
  c: Cast;
  cs: CreatureSim;
  play: PlaySim;
  given: List[Intents];
  stepIt: List[bool];
  tick: u64;
  you: usize;
  jumpNear: bool;              // the visitor jumps when the Minotaur is between 1.4 and 4 m off

  fn make(liar: u32) CrRig {
    var s = Scene.empty();
    var c = Cast.empty(Island.empty());
    var list = List[Solid].empty();
    labSolids(&mut list);
    c.phys.setSolids(&list);
    let gw = c.add(mannequinBeing(&mut s, "guard west", Vec3(LAB_GUARD_LEFT_X, LAB_Y + 0.22, LAB_GUARD_Z), 1.82, 71u32));
    let ge = c.add(mannequinBeing(&mut s, "guard east", Vec3(LAB_GUARD_RIGHT_X, LAB_Y + 0.22, LAB_GUARD_Z), 1.78, 73u32));
    let bull = c.add(mannequinBeing(&mut s, "minotaur", bullHome(), BULL_HEIGHT, 79u32));
    c.beings[bull].body.yaw = 1.5707964;
    c.beings[gw].ai = true; c.beings[gw].creature = true;
    c.beings[ge].ai = true; c.beings[ge].creature = true;
    c.beings[bull].ai = true; c.beings[bull].creature = true;
    let you = c.add(mannequinBeing(&mut s, "visitor", Vec3(2., LAB_Y, 379.), 1.75, 9u32));
    c.possess(you);
    var cs = CreatureSim.make();
    // (the seed's bit 7 says which lies)
    cs.made(gw, ge, bull, liar << 7u32);
    cs.body.pos = Vec2(bullHome().x, bullHome().z);
    cs.lastPos = cs.body.pos;
    CrRig(s, c, cs, PlaySim.empty(), List[Intents].empty(), List[bool].empty(), 0u64, you, false)
  }

  // The visitor put down at 'at' facing 'yaw'
  fn put(self: &mut, at: Vec3, yaw: f32) { c.beings[you].setDown(at, yaw); }

  // 'n' fixed steps
  fn step(self: &mut, n: i32) {
    let dt = 1.f / 60.;
    var k = 0;
    while k < n {
      while given.len() < c.beings.len() { given.push(Intents.none()); stepIt.push(true); }
      var b = 0usize;
      while b < c.beings.len() { given.set(b, Intents.none()); stepIt.set(b, true); b = b + 1usize; }
      if jumpNear && cs.bull < c.beings.len() {
        let d = crFlat(c.beings[you].body.position, c.beings[cs.bull].body.position);
        if d > 1.4 && d < 4. { given.set(you, Intents(0., 0., false, true)); }
      }
      var driven = List[usize].empty();
      driven.push(you);
      creaturesIntents(&mut cs, &mut c, &mut given, &mut stepIt, &driven, &mut play, tick, dt);
      playHold(&mut play, &mut given, tick);
      c.stepEach(&given, &stepIt, dt, false);
      creaturesAfter(&mut cs, &mut c, &driven, &mut play, tick, dt);
      tick = tick + 1u64;
      k = k + 1;
    }
  }

  fn bullAt(self: &) Vec3 { c.beings[cs.bull].body.position }
  fn youAt(self: &) Vec3 { c.beings[you].body.position }
}

// The door a line names, as the guard 'g' who said it means it
fn namedDoor(code: u32, g: u32) u32 {
  if code % 16u32 == A_MINE_DOOR { g } else { 1u32 - g }
}

fn checkPuzzle() bool {
  print <- "The guards' puzzle:\n";
  var ok = true;
  var allOther = true;
  var honestMiddle = true;
  var liarMiddle = true;
  var honestSays = true;
  var mineOk = true;
  var liar = 0u32;
  while liar < 2u32 {
    var g = 0u32;
    while g < 2u32 {
      let other = answerCode(Q_OTHER, g, liar);
      // both name the west door (the honest one reports the liar's lie, the liar lies about the honest one's truth): take the other
      if !(namedDoor(other, g) == DOOR_WEST && doorToTake(other, g) == DOOR_EAST) { allOther = false; }
      let mid = answerCode(Q_MIDDLE, g, liar);
      if g != liar { if namedDoor(mid, g) != DOOR_EAST { honestMiddle = false; } }
      else { if namedDoor(mid, g) != DOOR_WEST { liarMiddle = false; } }
      if answerCode(Q_HONEST, g, liar) != Q_HONEST * 16u32 + A_YES { honestSays = false; }
      // "Does the door beside you lead there?": the east guard's door does; the honest one says what is so, the liar the opposite
      let mine = answerCode(Q_MINE, g, liar);
      let doorLeads = g == DOOR_EAST;
      let saidYes = mine % 16u32 == A_YES;
      if saidYes != (if g != liar { doorLeads } else { !doorLeads }) { mineOk = false; }
      g = g + 1u32;
    }
    liar = liar + 1u32;
  }
  ok = expect("\"Which door would your fellow name?\" is answered by both guards with the west door, whichever of them lies: take the other (the east, the corridor's)", allOther) && ok;
  ok = expect("\"Which door leads to the middle?\" is answered by the honest guard with the east door and by the liar with the west", honestMiddle && liarMiddle) && ok;
  ok = expect("\"Do you always tell the truth?\" is answered yes by both", honestSays) && ok;
  ok = expect("\"Does the door beside you lead there?\" is answered as each guard's kind makes it", mineOk) && ok;
  var words = true;
  var q = 1u32;
  while q <= 4u32 {
    if questionText(q).len() < 10usize { words = false; }
    var a = 1u32;
    while a <= 4u32 {
      if guardSays(q * 16u32 + a).len() < 3usize { words = false; }
      a = a + 1u32;
    }
    q = q + 1u32;
  }
  ok = expect("every question and every answer has words", words && guardSays(A_ASKED).len() > 5usize && wormSays(1u32).len() > 5usize && wormSays(4u32).len() > 5usize) && ok;
  // The same through the simulation: a visitor near a guard is answered, once
  var rig = CrRig.make(1u32);
  rig.put(Vec3(4.6, LAB_Y, 335.6), 0.);
  let far = rig.cs.talk(rig.you, Vec3(0., LAB_Y, 322.), CR_GUARD_E, Q_OTHER);
  ok = expect("a visitor 17 m from the guard is not heard", far == 0u32 && rig.cs.said == 0u32) && ok;
  let first = rig.cs.talk(rig.you, rig.youAt(), CR_GUARD_E, Q_OTHER);
  ok = expect("one within reach is answered by the puzzle's own answer (the liar being the east guard)", first == answerCode(Q_OTHER, CR_GUARD_E, 1u32) && first != 0u32) && ok;
  let second = rig.cs.talk(rig.you, rig.youAt(), CR_GUARD_E, Q_MIDDLE);
  ok = expect("and, having had its question, is told so when it asks again", second == A_ASKED && rig.cs.said == 2u32) && ok;
  var told = 0u32;
  var firstTold = false;
  var ti = 0usize;
  while ti < rig.cs.out.len() {
    if rig.cs.out[ti].kind == CM_SAID {
      if told == 0u32 && rig.cs.out[ti].extra == first && rig.cs.out[ti].a == CR_GUARD_E && usize.from(rig.cs.out[ti].b) == rig.you { firstTold = true; }
      told = told + 1u32;
    }
    ti = ti + 1usize;
  }
  ok = expect("each answer is told to every view (two CM_SAID messages: the guard, who asked, the line)", told == 2u32 && firstTold) && ok;
  ok = expect("a question out of range is not heard", rig.cs.talk(rig.you, rig.youAt(), CR_GUARD_E, 9u32) == 0u32) && ok;
  // Out of the labyrinth, the question may be asked afresh
  rig.c.beings[rig.you].body.position = Vec3(0., 10., 0.);
  rig.step(2);
  ok = expect("a visitor that goes up out of the labyrinth has its question back", !rig.cs.hasAsked(rig.you)) && ok;
  ok
}

fn checkGuards() bool {
  print <- "The guards:\n";
  var ok = true;
  var rig = CrRig.make(0u32);
  rig.put(Vec3(0., LAB_Y, 335.), 3.1415927);
  rig.step(150);
  let gw = &rig.c.beings[*rig.cs.guards[0usize]];
  let want = headingTo(gw.body.position.x, gw.body.position.z, 0., 335.);
  ok = expect("a guard turns to face a visitor within 7 m of it", libc.fabsf(wrapPi(gw.body.yaw - want)) < 0.1) && ok;
  ok = expect("and stays on its plinth, upright (no creature walks off or falls)", libc.fabsf(gw.body.position.x - LAB_GUARD_LEFT_X) < 0.05 && libc.fabsf(gw.body.position.y - (LAB_Y + 0.22)) < 0.03) && ok;
  rig.put(Vec3(0., LAB_Y, 322.), 3.1415927);
  rig.step(200);
  ok = expect("it turns back to face the hall's south when the visitor has gone off", libc.fabsf(wrapPi(rig.c.beings[*rig.cs.guards[0usize]].body.yaw)) < 0.1) && ok;
  ok
}

fn checkWorm() bool {
  print <- "The Worm:\n";
  var ok = true;
  var rig = CrRig.make(0u32);
  rig.put(Vec3(LAB_WORM_X, LAB_Y, 345.), 3.1415927);
  rig.step(3);
  ok = expect("a visitor in the Worm's chamber makes it rise (told to every view)", rig.cs.wormUp && rig.cs.wormRises == 1u32 && rig.cs.out.len() > 0usize) && ok;
  rig.step(300);
  ok = expect("it has said two lines by five seconds, in order", rig.cs.wormSaid == 2u32 && rig.cs.wormTalks == 2u32) && ok;
  rig.step(280);
  ok = expect("and all four by ten", rig.cs.wormSaid == 4u32) && ok;
  var lines = 0u32;
  var k = 0usize;
  while k < rig.cs.out.len() { if rig.cs.out[k].kind == CM_WORM_SAYS { lines = lines + 1u32; } k = k + 1usize; }
  ok = expect("each was told as CM_WORM_SAYS", lines == 4u32) && ok;
  rig.put(Vec3(LAB_WORM_X, LAB_Y, 335.), 3.1415927);
  rig.step(200);
  ok = expect("it stays up for a few seconds after the visitor has gone", rig.cs.wormUp) && ok;
  rig.step(220);
  ok = expect("and sinks when the chamber has been empty six seconds", !rig.cs.wormUp) && ok;
  rig.put(Vec3(LAB_WORM_X, LAB_Y, 344.), 3.1415927);
  rig.step(3);
  ok = expect("it rises again for the next visitor, and begins its lines again", rig.cs.wormUp && rig.cs.wormRises == 2u32 && rig.cs.wormSaid == 0u32) && ok;
  ok
}

fn checkBull() bool {
  print <- "The Minotaur:\n";
  var ok = true;
  // PATROL: with nobody about it walks its round (the routes keep to the mesh) and never leaves the court's east side
  var rig = CrRig.make(0u32);
  var minX = 99.f;
  var maxX = -99.f;
  var moved = 0.;
  var last = rig.bullAt();
  var k = 0;
  while k < 20 {
    rig.step(60);
    let p = rig.bullAt();
    if p.x < minX { minX = p.x; }
    if p.x > maxX { maxX = p.x; }
    moved = moved + crFlat(p, last);
    last = p;
    k = k + 1;
  }
  print <- "  (20 s of patrol: "; print <- moved; print <- " m walked, x from "; print <- minX; print <- " to "; print <- maxX; print <- ")\n";
  ok = expect("with nobody near it patrols: it walks (more than 10 m in 20 s), stays before the east door, and keeps its feet", moved > 10. && minX > 21. && maxX < 38.5
    && libc.fabsf(rig.bullAt().y - LAB_Y) < 0.05 && rig.cs.mode == BM_PATROL && rig.cs.winds == 0u32) && ok;

  // THE STAGGER: paint heard from the pillar it has a clear run to
  rig = CrRig.make(0u32);
  rig.put(Vec3(2., LAB_Y, 379.), 0.);
  // (where the paint lands: the near face of the pillar at 292.5 degrees on the ring, as seen from the west; the Minotaur's run from the east
  // to that point has the pillar in its way)
  rig.play.splats.push(SplatNote(rig.you, Vec3(17.3, LAB_Y + 1.4, 383.3), NO_ROW));
  rig.step(2);
  ok = expect("paint splattered in the court rouses it: it winds up towards the splat", rig.cs.mode == BM_WINDUP && rig.cs.winds == 1u32 && rig.play.splats.len() == 0usize) && ok;
  var charged = false;
  var staggered = false;
  var hitAt = Vec3(0., 0., 0.);
  var windFrames = 0;
  k = 0;
  while k < 700 && !staggered {
    rig.step(1);
    if rig.cs.mode == BM_WINDUP { windFrames = windFrames + 1; }
    if rig.cs.mode == BM_CHARGE { charged = true; }
    if rig.cs.mode == BM_STAGGER { staggered = true; hitAt = rig.bullAt(); }
    k = k + 1;
  }
  let pillar = Vec3(18.04, LAB_Y, 383.6);
  print <- "  (wound up "; print <- windFrames; print <- " steps, charged, ran into something at ("; print <- hitAt.x; print <- ", "; print <- hitAt.z; print <- "), "; print <- crFlat(hitAt, pillar); print <- " m from the pillar's middle)\n";
  ok = expect("it winds up (pawing at least a second), charges, and the pillar in its way staggers it", windFrames >= 60 && charged && staggered && rig.cs.hits == 1u32) && ok;
  ok = expect("the run ended against the pillar (within 1.7 m of its middle: the pillar's half width 0.73, the Minotaur's radius 0.36)", crFlat(hitAt, pillar) < 1.7) && ok;
  ok = expect("the stagger is a spell in force on it (FX_STAGGER, told to every view in the snapshot's list)", rig.play.fxOf(u32.from(rig.cs.bull)) == FX_STAGGER
    && rig.c.beings[rig.cs.bull].figure.fxKind == FX_STAGGER) && ok;
  rig.step(120);
  let during = rig.bullAt();
  ok = expect("while it staggers it stays where it fell and notices nobody", crFlat(during, hitAt) < 0.3 && rig.cs.mode == BM_STAGGER) && ok;
  // a visitor beside it is not shoved while it is dazed
  rig.put(Vec3(hitAt.x + 2., LAB_Y, hitAt.z + 2.), 0.);
  rig.step(120);
  ok = expect("a visitor beside it is neither roused on nor shoved (it is dazed)", rig.cs.winds == 1u32 && rig.cs.shoves == 0u32 && rig.cs.mode == BM_STAGGER) && ok;
  rig.put(Vec3(2., LAB_Y, 379.), 0.);
  rig.step(260);
  ok = expect("after seven seconds it gets up and goes back to its round", rig.cs.mode == BM_RECOVER || rig.cs.mode == BM_PATROL) && ok;
  rig.step(200);
  ok = expect("... and patrols again", rig.cs.mode == BM_PATROL && rig.c.beings[rig.cs.bull].figure.fxKind == FX_NONE) && ok;
  var stood = false;
  var kk = 0usize;
  while kk < rig.cs.out.len() { if rig.cs.out[kk].kind == CM_BULL && rig.cs.out[kk].a == BE_STAND { stood = true; } kk = kk + 1usize; }
  ok = expect("the events told: wound up, charged, ran into something, got up", stood && rig.cs.charges == 1u32) && ok;

  // THE SHOVE: it charges a visitor who does not jump and sends it to the west side
  rig = CrRig.make(0u32);
  rig.put(Vec3(20., LAB_Y, 391.), 0. - 1.5707964);
  rig.step(500);
  let shoved = rig.youAt();
  print <- "  (a visitor that did not jump was shoved to ("; print <- shoved.x; print <- ", "; print <- shoved.y - LAB_Y; print <- " up, "; print <- shoved.z; print <- "), "; print <- rig.cs.shoves; print <- " shove(s))\n";
  ok = expect("a visitor within 14 m is charged; one that does not jump is shoved back to the court's west side (x within 1 m of -14), on its feet", rig.cs.charges == 1u32 && rig.cs.shoves == 1u32
    && libc.fabsf(shoved.x - SHOVE_X) < 1. && libc.fabsf(shoved.y - LAB_Y) < 0.05 && rig.c.beings[rig.you].figure.grounded) && ok;
  ok = expect("it never hurt: the visitor's health is whole", rig.c.beings[rig.you].figure.health > 0.99) && ok;

  // THE BULL-LEAP: the visitor jumps when it is 4 m off
  rig = CrRig.make(0u32);
  rig.jumpNear = true;
  rig.put(Vec3(20., LAB_Y, 391.), 0. - 1.5707964);
  var peak = 0.f;
  var leapAt = Vec3(0., 0., 0.);
  var overBull = false;
  k = 0;
  while k < 400 {
    rig.step(1);
    let yy = rig.youAt().y - LAB_Y;
    if yy > peak { peak = yy; }
    if rig.cs.leaps == 1u32 && leapAt.x == 0. { leapAt = rig.bullAt(); }
    k = k + 1;
  }
  let landed = rig.youAt();
  let bullNow = rig.bullAt();
  print <- "  (vaulted: apex "; print <- peak; print <- " m, landed at ("; print <- landed.x; print <- ", "; print <- landed.z; print <- "), the Minotaur then at ("; print <- bullNow.x; print <- ", "; print <- bullNow.z; print <- "))\n";
  ok = expect("a visitor that jumps as it arrives (1.4 to 4 m off) is vaulted over it: one leap, no shove", rig.cs.leaps == 1u32 && rig.cs.shoves == 0u32) && ok;
  ok = expect("the arc clears its horns (an apex over 2.5 m) and lands on the far side (east of where the Minotaur met it), on its feet and unhurt", peak > 2.5 && landed.x > leapAt.x
    && libc.fabsf(landed.y - LAB_Y) < 0.05 && rig.c.beings[rig.you].figure.grounded && rig.c.beings[rig.you].figure.health > 0.99) && ok;
  ok = expect("the Minotaur has been outwitted by that visitor: it is not roused by it again however near (no second charge in 600 steps with the visitor beside it)", rig.cs.hasPassed(rig.you)) && ok;
  rig.put(Vec3(bullNow.x + 3., LAB_Y, bullNow.z), 0.);
  let windsBefore = rig.cs.winds;
  rig.step(600);
  ok = expect("... and it does not charge it, nor shove it", rig.cs.winds == windsBefore && rig.cs.shoves == 0u32) && ok;
  // out of the labyrinth, its respect is lost
  rig.c.beings[rig.you].body.position = Vec3(0., 10., 0.);
  rig.step(2);
  ok = expect("a visitor that goes up out of the labyrinth must win it afresh", !rig.cs.hasPassed(rig.you)) && ok;
  ok
}

fn checkCreatureWire() bool {
  print <- "The creatures on the wire:\n";
  var ok = true;
  let info = CreatureInfo(CM_BULL, BE_LEAP, 7u32, Vec3(12.5, -300., 391.25), 123456u32);
  match decodeToView(encodeCreature(&info)) {
    case let Creature(c) {
      ok = expect("a ToView.Creature crosses as bytes and comes back whole", c.kind == CM_BULL && c.a == BE_LEAP && c.b == 7u32 && c.extra == 123456u32
        && nearly(c.position.x, 12.5, 0.002) && nearly(c.position.y, -300., 0.002) && nearly(c.position.z, 391.25, 0.002)) && ok;
    }
    else { ok = expect("a ToView.Creature crosses as bytes", false) && ok; }
  }
  ok = expect("the wire format's version was raised for it (2: an older server or client is refused by the Hello)", PROTOCOL_VERSION >= 2u32) && ok;
  // The creatures' looks are made, with parts of their own, for the same ids on both sides
  var door = Door.empty();
  let root = door.newPart("creature");
  let extras = spawnCreature(&mut door, CL_GUARD_W, 1.82, Color(0.36, 0.14, 0.07, 1.), root);
  let bullRoot = door.newPart("bull");
  let bullExtras = spawnCreature(&mut door, CL_MINOTAUR, BULL_HEIGHT, Color(0.08, 0.04, 0.03, 1.), bullRoot);
  ok = expect("a guard is a body and four extra parts (cloth, bronze, hide, dark); the Minotaur a body and three (ivory, cloth, bronze)", extras.len() == 4usize && bullExtras.len() == 3usize) && ok;
  ok
}

fn checkCreatures() bool {
  var ok = checkPuzzle();
  ok = checkGuards() && ok;
  ok = checkWorm() && ok;
  ok = checkBull() && ok;
  ok = checkCreatureWire() && ok;
  ok
}
