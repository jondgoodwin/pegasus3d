// The messages as bytes: what simview.cone's values become on the wire, and
// back. Every number is written most significant byte first (as netmsg's are).
//
// THE LIMITS. A message that must arrive (reliable) holds at most
// MAX_RELIABLE bytes, a latest-wins value at most MAX_LATEST: one packet of
// netmsg's, whose default is 1,200 bytes (a reliable message 1,173, a value
// 1,171; fragmentation is not built). Nothing here may be bigger, and the
// writers that can be (a batch of requests) cut their output into messages
// that fit.
//
// QUANTISED STATE. A being's state crosses with positions in millimetres
// against the island's bounds (a 24-bit number a coordinate, from
// POS_ORIGIN_XZ and POS_ORIGIN_Y), the heading in 16 bits, and the speeds in
// fixed point; the being the client drives crosses whole (32-bit floats), as
// it is compared with the client's own prediction.
//
// A reader that is handed too few bytes, or nonsense, says so (ok is false)
// and the message is dropped whole: no message from outside is trusted.

// The most a reliable message, and a latest-wins value, may hold (netmsg's, for its default 1,200-byte packet)
pub const MAX_RELIABLE = 1173usize;
pub const MAX_LATEST = 1171usize;
// Requests are cut into messages of at most this many bytes (a little under the limit, for an Object's tail)
const REQUESTS_BYTES = 1100usize;

// Where each coordinate's millimetres count from (metres), and how many millimetres make a metre
// The wire-format version. Bump it whenever anything on the wire changes (see SERVER.md). A client sends it after its name in
// ToSim.Hello; a server sends its own after the being in ToView.Possessed. A build from before versions existed sends neither
// (it is read as version 0).
// (2: ToView.Creature, the labyrinth's creatures; PLAY_TALK and PLAY_CREATURE_TEST in ToSim.Play; the object kind OBJ_CREATURE; FX_STAGGER)
// (3: people: BeingAdded's person and the object kind OBJ_PERSON; the input's sit and hail bits; a byte a being in the snapshot, and its
// seat and sit, its hail, when there are some)
pub const PROTOCOL_VERSION = 3u32;

pub const POS_ORIGIN_XZ f32 = -2048.;
pub const POS_ORIGIN_Y f32 = -512.;    // (was -256: the labyrinth's floor at -300 would have been clamped to -256 for every other player)
const POS_MAX = 16777215.;

// Message tags
const TOSIM_CLICK = 1u32;
const TOSIM_COMMAND = 2u32;
const TOSIM_LOOK = 3u32;
const TOSIM_FRAME = 4u32;
const TOSIM_PLAY = 5u32;
const TOSIM_HELLO = 6u32;
const TOVIEW_REFUSED = 6u32;
const TOVIEW_FRAMEDONE = 4u32;
const TOVIEW_BURST = 5u32;
const TOVIEW_PORTAL = 7u32;
const TOVIEW_CREATURE = 8u32;
const TOVIEW_REQUESTS = 1u32;
const TOVIEW_POSSESSED = 2u32;
const TOVIEW_WEATHER = 3u32;

// Request tags
const R_SPAWN = 1u32;
const R_PLACE = 2u32;
const R_PARENT = 3u32;
const R_DESPAWN = 4u32;
const R_SHOW = 5u32;
const R_FIRE = 6u32;
const R_GLOW = 7u32;
const R_TINT = 8u32;
const R_PLATFORM = 9u32;
const R_OBJECT = 10u32;
const R_BEING = 11u32;
const R_LIGHT = 12u32;
const R_SHADOW = 13u32;

// ---- Writing ----

pub fn w8(out &mut List[u8], v u32) { out.push(u8.from(v & 255u32)); }

pub fn w16(out &mut List[u8], v u32) {
  w8(out, v >> 8u32);
  w8(out, v);
}

pub fn w24(out &mut List[u8], v u32) {
  w8(out, v >> 16u32);
  w8(out, v >> 8u32);
  w8(out, v);
}

pub fn w32(out &mut List[u8], v u32) {
  w8(out, v >> 24u32);
  w8(out, v >> 16u32);
  w8(out, v >> 8u32);
  w8(out, v);
}

pub fn w64(out &mut List[u8], v u64) {
  w32(out, u32.from(v >> 32u64));
  w32(out, u32.from(v & 0xFFFFFFFFu64));
}

pub fn wF32(out &mut List[u8], f f32) { w32(out, f as u32); }

pub fn wF64(out &mut List[u8], f f64) { w64(out, f as u64); }

// A number of any size, 7 bits a byte, the least significant first, the top bit set on all but the last
pub fn wVar(out &mut List[u8], v u32) {
  var x = v;
  while x >= 128u32 {
    w8(out, (x & 127u32) | 128u32);
    x = x >> 7u32;
  }
  w8(out, x);
}

// A signed number in 'bytes' bytes (two's complement), clamped to what they hold
fn wSigned(out &mut List[u8], n i32, bytes u32) {
  let u = n as u32;
  if bytes == 1u32 { w8(out, u); } else { w16(out, u); }
}

// A number from -1 to 1 in one signed byte
pub fn wUnit(out &mut List[u8], x f32) {
  wSigned(out, clampInt(rounded(x * 127.), -127, 127), 1u32);
}

// A string: its length, then its bytes
pub fn wStr(out &mut List[u8], s &str) {
  let b &Array[u8] = s;
  wVar(out, u32.from(b.len));
  var i = 0usize;
  while i < b.len {
    out.push(b[i]);
    i = i + 1usize;
  }
}

pub fn wId(out &mut List[u8], id PartId) {
  wVar(out, id.key.slot());
  wVar(out, id.key.generation());
}

pub fn wVec3(out &mut List[u8], v Vec3) {
  wF32(out, v.x);
  wF32(out, v.y);
  wF32(out, v.z);
}

pub fn wColor(out &mut List[u8], c Color) {
  wF32(out, c.red);
  wF32(out, c.green);
  wF32(out, c.blue);
  wF32(out, c.alpha);
}

// A list of ids as runs of consecutive slots in one generation: how many runs, then each run's first slot, generation and length
pub fn wIds(out &mut List[u8], ids &List[PartId]) {
  var runs = List[u32].empty();                // slot, generation, length for each
  var i = 0usize;
  while i < ids.len() {
    let id = *ids[i];
    let n = runs.len();
    if n >= 3usize and *runs[n - 2usize] == id.key.generation() and *runs[n - 3usize] + *runs[n - 1usize] == id.key.slot() {
      runs.set(n - 1usize, *runs[n - 1usize] + 1u32);
    } else {
      runs.push(id.key.slot());
      runs.push(id.key.generation());
      runs.push(1u32);
    }
    i = i + 1usize;
  }
  wVar(out, u32.from(runs.len() / 3usize));
  var k = 0usize;
  while k < runs.len() {
    wVar(out, *runs[k]);
    wVar(out, *runs[k + 1usize]);
    wVar(out, *runs[k + 2usize]);
    k = k + 3usize;
  }
}

fn rounded(x f32) f32 { libc.floorf(x + 0.5) }

fn clampInt(n f32, lo i32, hi i32) i32 {
  if n < f32.from(lo) { return lo; }
  if n > f32.from(hi) { return hi; }
  i32.from(n)
}

// A coordinate in millimetres from 'origin', in 24 bits
fn wMillimetres(out &mut List[u8], v f32, origin f32) {
  // (in doubles: a coordinate a thousand metres from the origin, in single precision, has already lost a tenth of a millimetre)
  var mm = libc.floor((f64.from(v) - f64.from(origin)) * 1000d + 0.5d);
  if mm < 0d { mm = 0d; }
  if mm > f64.from(POS_MAX) { mm = f64.from(POS_MAX); }
  w24(out, u32.from(mm));
}

// ---- Reading ----

// A message being read: its bytes, where it is, and whether every read so far stayed inside it
pub struct Rd {
  pub data List[u8];
  pub pos usize;
  pub ok bool;

  pub fn make(d List[u8]) Rd { new Rd(d, 0usize, true) }

  pub fn left(self &) usize { if pos >= data.len() { 0usize } else { data.len() - pos } }

  pub fn r8(self &mut) u32 {
    if !ok or pos >= data.len() {
      ok = false;
      return 0u32;
    }
    let v = u32.from(*data[pos]);
    pos = pos + 1usize;
    v
  }

  pub fn r16(self &mut) u32 {
    let a = self.r8();
    (a << 8u32) | self.r8()
  }

  pub fn r24(self &mut) u32 {
    let a = self.r8();
    let b = self.r8();
    (a << 16u32) | (b << 8u32) | self.r8()
  }

  pub fn r32(self &mut) u32 {
    let a = self.r8();
    let b = self.r8();
    let c = self.r8();
    (a << 24u32) | (b << 16u32) | (c << 8u32) | self.r8()
  }

  pub fn r64(self &mut) u64 {
    let hi = u64.from(self.r32());
    (hi << 32u64) | u64.from(self.r32())
  }

  pub fn rF32(self &mut) f32 { self.r32() as f32 }

  pub fn rF64(self &mut) f64 { self.r64() as f64 }

  pub fn rVar(self &mut) u32 {
    var v = 0u32;
    var shift = 0u32;
    var more = true;
    while more {
      let b = self.r8();
      if !ok { return 0u32; }
      v = v | ((b & 127u32) << shift);
      more = (b & 128u32) != 0u32;
      shift = shift + 7u32;
      if shift > 28u32 and more {
        ok = false;
        return 0u32;
      }
    }
    v
  }

  // A signed byte, or two bytes
  pub fn rS8(self &mut) i32 {
    let u = self.r8();
    if u > 127u32 { (u as i32) - 256 } else { u as i32 }
  }

  pub fn rS16(self &mut) i32 {
    let u = self.r16();
    if u > 32767u32 { (u as i32) - 65536 } else { u as i32 }
  }

  pub fn rUnit(self &mut) f32 { f32.from(self.rS8()) / 127. }

  pub fn rStr(self &mut) String {
    let n = usize.from(self.rVar());
    if !ok or n > self.left() {
      ok = false;
      return String.empty();
    }
    var bytes = List[u8].withCapacity(n);
    var i = 0usize;
    while i < n {
      bytes.push(*data[pos + i]);
      i = i + 1usize;
    }
    pos = pos + n;
    String.fromBytes(bytes.view())
  }

  pub fn rId(self &mut) PartId {
    let slot = self.rVar();
    let gen = self.rVar();
    if gen == 0u32 { return PartId.none(); }
    new PartId(Ref[PartRecord].of(slot, gen))
  }

  pub fn rVec3(self &mut) Vec3 {
    let x = self.rF32();
    let y = self.rF32();
    new Vec3(x, y, self.rF32())
  }

  pub fn rColor(self &mut) Color {
    let r = self.rF32();
    let g = self.rF32();
    let b = self.rF32();
    new Color(r, g, b, self.rF32())
  }

  // A list of ids written by wIds. A run longer than the message could hold is refused
  pub fn rIds(self &mut, out &mut List[PartId]) {
    let runs = usize.from(self.rVar());
    var r = 0usize;
    while r < runs and ok {
      let slot = self.rVar();
      let gen = self.rVar();
      let n = self.rVar();
      if n > 100000u32 {
        ok = false;
        return;
      }
      var k = 0u32;
      while k < n {
        out.push(new PartId(Ref[PartRecord].of(slot + k, gen)));
        k = k + 1u32;
      }
      r = r + 1usize;
    }
  }

  // A millimetre coordinate
  pub fn rMillimetres(self &mut, origin f32) f32 { f32.from(f64.from(self.r24()) / 1000d + f64.from(origin)) }
}

// ---- view -> simulation ----

// A reliable message from the view
pub fn encodeToSim(msg ToSim) List[u8] {
  var out = List[u8].empty();
  var m = msg;
  match &m {
    case let k Click {
      w8(&mut out, TOSIM_CLICK);
      wId(&mut out, k.part);
    }
    case let c Command {
      w8(&mut out, TOSIM_COMMAND);
      w8(&mut out, c.kind);
    }
    case let l Look {
      w8(&mut out, TOSIM_LOOK);
      wF32(&mut out, l.pitch);
    }
    case let h Hello {
      w8(&mut out, TOSIM_HELLO);
      wStr(&mut out, h.name.view());
      w8(&mut out, h.version);
    }
    case let p Play {
      w8(&mut out, TOSIM_PLAY);
      w8(&mut out, p.kind);
      w8(&mut out, p.spell);
      w32(&mut out, p.target);
      wVec3(&mut out, p.eye);
      wVec3(&mut out, p.dir);
    }
    case let f Frame {
      w8(&mut out, TOSIM_FRAME);
      w64(&mut out, f.frame);
      w8(&mut out, u32.from(f.steps.len()));
      var i = 0usize;
      while i < f.steps.len() {
        let s = *f.steps[i];
        w64(&mut out, s.index);
        w64(&mut out, s.ns);
        wF32(&mut out, s.dt);
        w64(&mut out, s.startNs);
        w32(&mut out, s.substeps);
        i = i + 1usize;
      }
    }
    else {}
  }
  out
}

pub fn decodeToSim(bytes List[u8]) ToSim {
  var r = Rd.make(bytes);
  let tag = r.r8();
  var out ToSim = ToSim.Nothing;
  if tag == TOSIM_CLICK {
    let part = r.rId();
    if r.ok { out = ToSim.Click(part); }
  } elif tag == TOSIM_COMMAND {
    let kind = r.r8();
    if r.ok { out = ToSim.Command(kind); }
  } elif tag == TOSIM_LOOK {
    let pitch = r.rF32();
    if r.ok { out = ToSim.Look(pitch); }
  } elif tag == TOSIM_HELLO {
    let name = r.rStr();
    // (an older client's Hello ends after the name: version 0)
    let version = if r.ok and r.left() > 0usize { r.r8() } else { 0u32 };
    if r.ok { out = ToSim.Hello(name, version); }
  } elif tag == TOSIM_PLAY {
    let kind = r.r8();
    let spell = r.r8();
    let target = r.r32();
    let eye = r.rVec3();
    let dir = r.rVec3();
    if r.ok { out = ToSim.Play(kind, spell, target, eye, dir); }
  } elif tag == TOSIM_FRAME {
    let frame = r.r64();
    let n = usize.from(r.r8());
    var steps = List[Step].empty();
    var i = 0usize;
    while i < n and r.ok {
      let index = r.r64();
      let ns = r.r64();
      let dt = r.rF32();
      let startNs = r.r64();
      let substeps = r.r32();
      steps.push(new Step(index, ns, dt, startNs, substeps));
      i = i + 1usize;
    }
    if r.ok { out = ToSim.Frame(frame, steps); }
  }
  out
}

// The input batch: how many samples, the first's sequence number, then each sample: ahead, turn, flags, look keys
pub fn encodeInput(samples &List[InputSample]) List[u8] {
  var out = List[u8].empty();
  let n = samples.len();
  w8(&mut out, u32.from(n));
  if n == 0usize { return out; }
  w32(&mut out, u32.from((*samples[0usize]).seq));
  var i = 0usize;
  while i < n {
    let s = *samples[i];
    wUnit(&mut out, s.intents.ahead);
    wUnit(&mut out, s.intents.turn);
    w8(&mut out, (if s.intents.run { 1u32 } else { 0u32 }) | (if s.intents.jump { 2u32 } else { 0u32 })
      | (if s.intents.sit { 4u32 } else { 0u32 }) | (if s.intents.hail { 8u32 } else { 0u32 }));
    wUnit(&mut out, s.lookKeys);
    i = i + 1usize;
  }
  out
}

// The samples of a batch, oldest first; none (and 'ok' false) if it was malformed
pub fn decodeInput(bytes List[u8], samples &mut List[InputSample]) bool {
  var r = Rd.make(bytes);
  let n = usize.from(r.r8());
  if n == 0usize { return r.ok; }
  let first = u64.from(r.r32());
  var found = List[InputSample].empty();
  var i = 0usize;
  while i < n and r.ok {
    let ahead = r.rUnit();
    let turn = r.rUnit();
    let flags = r.r8();
    let look = r.rUnit();
    var it = new Intents(ahead, turn, (flags & 1u32) != 0u32, (flags & 2u32) != 0u32);
    it.sit = (flags & 4u32) != 0u32;
    it.hail = (flags & 8u32) != 0u32;
    found.push(new InputSample(first + u64.from(u32.from(i)), it, look));
    i = i + 1usize;
  }
  if !r.ok { return false; }
  i = 0usize;
  while i < found.len() {
    samples.push(*found[i]);
    i = i + 1usize;
  }
  true
}

// ---- simulation -> view: requests ----

fn wTransform(out &mut List[u8], t Transform3) {
  wVec3(out, t.translation);
  wF32(out, t.rotation.x);
  wF32(out, t.rotation.y);
  wF32(out, t.rotation.z);
  wF32(out, t.rotation.w);
  wVec3(out, t.scale);
}

fn rTransform(r &mut Rd) Transform3 {
  let t = r.rVec3();
  let qx = r.rF32();
  let qy = r.rF32();
  let qz = r.rF32();
  let qw = r.rF32();
  new Transform3(t, new Quat(qx, qy, qz, qw), r.rVec3())
}

// Request 'q' written into 'out'; false (and nothing written) if it is not a kind that crosses (the others stay in
// the simulation, or are made by the view itself)
pub fn encodeRequest(q &Request, out &mut List[u8]) bool {
  match q {
    case let s Spawn {
      w8(out, R_SPAWN);
      wId(out, s.id);
      wStr(out, s.name.view());
    }
    case let p Place {
      w8(out, R_PLACE);
      wId(out, p.id);
      wTransform(out, p.at);
    }
    case let pa Parent {
      w8(out, R_PARENT);
      wId(out, pa.id);
      wId(out, pa.parent);
    }
    case let d Despawn {
      w8(out, R_DESPAWN);
      wId(out, d.id);
    }
    case let sh Show {
      w8(out, R_SHOW);
      wId(out, sh.id);
      wId(out, sh.mesh.id);
      wId(out, sh.material.id);
      wF32(out, sh.anchor);
    }
    case let f Fire {
      w8(out, R_FIRE);
      wId(out, f.id);
      w32(out, f.seed);
      wF64(out, f.start);
      wF64(out, f.stop);
    }
    case let g Glow {
      w8(out, R_GLOW);
      wId(out, g.material.id);
      wColor(out, g.glow);
    }
    case let t Tint {
      w8(out, R_TINT);
      wId(out, t.id);
      wColor(out, t.tint);
    }
    case let pl Platform {
      w8(out, R_PLATFORM);
      wId(out, pl.id);
      wF32(out, pl.shape.floorY);
      wF32(out, pl.shape.min.x);
      wF32(out, pl.shape.min.y);
      wF32(out, pl.shape.max.x);
      wF32(out, pl.shape.max.y);
      wF32(out, pl.shape.wallHeight);
      w32(out, pl.shape.walls);
    }
    case let ls LightSource {
      w8(out, R_LIGHT);
      wId(out, ls.id);
      w8(out, ls.light.kind);
      wVec3(out, ls.light.at);
      wVec3(out, ls.light.direction);
      wColor(out, ls.light.color);
      wF32(out, ls.light.candela);
      wF32(out, ls.light.range);
      wF32(out, ls.light.radius);
      wF32(out, ls.light.inner);
      wF32(out, ls.light.outer);
      w32(out, ls.light.layers);
      w8(out, if ls.light.shadow { 1u32 } else { 0u32 });
    }
    case let cs CastsShadow {
      w8(out, R_SHADOW);
      wId(out, cs.id);
      w8(out, if cs.casts { 1u32 } else { 0u32 });
    }
    case let o Object {
      w8(out, R_OBJECT);
      w8(out, o.spec.kind);
      wVar(out, o.spec.index);
      wF32(out, o.spec.height);
      wColor(out, o.spec.color);
      wStr(out, o.spec.name.view());
      wIds(out, &o.ids);
    }
    case let b BeingAdded {
      w8(out, R_BEING);
      wVar(out, b.being);
      wId(out, b.part);
      w8(out, if b.plain { 1u32 } else { 0u32 });
      wF32(out, b.height);
      w32(out, b.seed);
      wStr(out, b.name.view());
      wVar(out, if b.person == NO_PERSON { 0u32 } else { b.person + 1u32 });   // (0: a mannequin; else the cast's number plus one)
    }
    else { return false; }
  }
  true
}

// One request read; false if it was malformed (or a tag this version does not know)
pub fn decodeRequest(r &mut Rd, out &mut List[Request]) bool {
  let tag = r.r8();
  if tag == R_SPAWN {
    let id = r.rId();
    let name = r.rStr();
    if r.ok { out.push(Request.Spawn(id, name)); }
  } elif tag == R_PLACE {
    let id = r.rId();
    let at = rTransform(r);
    if r.ok { out.push(Request.Place(id, at)); }
  } elif tag == R_PARENT {
    let id = r.rId();
    let parent = r.rId();
    if r.ok { out.push(Request.Parent(id, parent)); }
  } elif tag == R_DESPAWN {
    let id = r.rId();
    if r.ok { out.push(Request.Despawn(id)); }
  } elif tag == R_SHOW {
    let id = r.rId();
    let mesh = r.rId();
    let material = r.rId();
    let anchor = r.rF32();
    if r.ok { out.push(Request.Show(id, new MeshId(mesh), new MaterialId(material), anchor)); }
  } elif tag == R_FIRE {
    let id = r.rId();
    let seed = r.r32();
    let start = r.rF64();
    let stop = r.rF64();
    if r.ok { out.push(Request.Fire(id, seed, start, stop)); }
  } elif tag == R_GLOW {
    let material = r.rId();
    let glow = r.rColor();
    if r.ok { out.push(Request.Glow(new MaterialId(material), glow)); }
  } elif tag == R_TINT {
    let id = r.rId();
    let tint = r.rColor();
    if r.ok { out.push(Request.Tint(id, tint)); }
  } elif tag == R_PLATFORM {
    let id = r.rId();
    let floorY = r.rF32();
    let minx = r.rF32();
    let miny = r.rF32();
    let maxx = r.rF32();
    let maxy = r.rF32();
    let wallHeight = r.rF32();
    let walls = r.r32();
    if r.ok { out.push(Request.Platform(id, new PlatformShape(floorY, new Vec2(minx, miny), new Vec2(maxx, maxy), wallHeight, walls))); }
  } elif tag == R_LIGHT {
    let id = r.rId();
    let kind = r.r8();
    let at = r.rVec3();
    let direction = r.rVec3();
    let color = r.rColor();
    let candela = r.rF32();
    let range = r.rF32();
    let radius = r.rF32();
    let inner = r.rF32();
    let outer = r.rF32();
    let layers = r.r32();
    let shadow = r.r8();
    if r.ok { out.push(Request.LightSource(id, new LightLook(kind, at, direction, color, candela, range, radius, inner, outer, layers, shadow != 0u32))); }
  } elif tag == R_SHADOW {
    let id = r.rId();
    let casts = r.r8();
    if r.ok { out.push(Request.CastsShadow(id, casts != 0u32)); }
  } elif tag == R_OBJECT {
    let kind = r.r8();
    let index = r.rVar();
    let height = r.rF32();
    let color = r.rColor();
    let name = r.rStr();
    var ids = List[PartId].empty();
    r.rIds(&mut ids);
    if r.ok { out.push(Request.Object(new ObjectSpec(kind, index, height, color, name), ids)); }
  } elif tag == R_BEING {
    let being = r.rVar();
    let part = r.rId();
    let plain = r.r8();
    let height = r.rF32();
    let seed = r.r32();
    let name = r.rStr();
    let personPlus = r.rVar();
    if r.ok { out.push(Request.BeingAdded(being, part, plain != 0u32, height, seed, name, if personPlus == 0u32 { NO_PERSON } else { personPlus - 1u32 })); }
  } else {
    r.ok = false;
  }
  r.ok
}

// The requests 'items' (each already encoded by encodeRequest) from index 'from', as one reliable message of at most
// REQUESTS_BYTES bytes (at least one goes in, so a single one over the size is refused whole by the connection and
// reported by whoever sends it): the index after the last that went in.
pub fn packRequests(items &List[List[u8]], from usize, out &mut List[u8]) usize {
  w8(out, TOVIEW_REQUESTS);
  let countAt = out.len();
  w16(out, 0u32);
  var n = 0u32;
  var i = from;
  while i < items.len() {
    let one = items[i];
    if n > 0u32 and out.len() + one.len() > REQUESTS_BYTES { break; }
    var k = 0usize;
    while k < one.len() {
      out.push(*one[k]);
      k = k + 1usize;
    }
    n = n + 1u32;
    i = i + 1usize;
  }
  out.set(countAt, u8.from((n >> 8u32) & 255u32));
  out.set(countAt + 1usize, u8.from(n & 255u32));
  i
}

// What a refusal for mismatched versions says to the user
pub fn versionRefusal(client u32, server u32) String {
  if client < server { String.from("Your browser is out of date. Please download the latest from cone.jondgoodwin.com.") }
  else { String.from("The server is being updated. Please try again shortly.") }
}

pub fn encodeRefused(reason &str) List[u8] {
  var out = List[u8].empty();
  w8(&mut out, TOVIEW_REFUSED);
  wStr(&mut out, reason);
  out
}

pub fn encodePossessed(being u32) List[u8] {
  var out = List[u8].empty();
  w8(&mut out, TOVIEW_POSSESSED);
  wVar(&mut out, being);
  w8(&mut out, PROTOCOL_VERSION);
  out
}

pub fn encodeFrameDone(tick u64, simulateNs u64, publishNs u64) List[u8] {
  var out = List[u8].empty();
  w8(&mut out, TOVIEW_FRAMEDONE);
  w64(&mut out, tick);
  w64(&mut out, simulateNs);
  w64(&mut out, publishNs);
  out
}

pub fn encodeBurst(b &BurstInfo) List[u8] {
  var out = List[u8].empty();
  w8(&mut out, TOVIEW_BURST);
  w8(&mut out, b.kind);
  w32(&mut out, b.being);
  wVec3(&mut out, b.position);
  wVec3(&mut out, b.normal);
  w8(&mut out, b.color);
  w64(&mut out, b.tick);
  out
}

pub fn encodePortal(p &PortalInfo) List[u8] {
  var out = List[u8].empty();
  w8(&mut out, TOVIEW_PORTAL);
  w8(&mut out, p.kind);
  w32(&mut out, p.being);
  wVec3(&mut out, p.position);
  w32(&mut out, p.extra);
  out
}

pub fn encodeCreature(c &CreatureInfo) List[u8] {
  var out = List[u8].empty();
  w8(&mut out, TOVIEW_CREATURE);
  w8(&mut out, c.kind);
  w32(&mut out, c.a);
  w32(&mut out, c.b);
  wVec3(&mut out, c.position);
  w32(&mut out, c.extra);
  out
}

pub fn encodeWeather(w &Weathering) List[u8] {
  var out = List[u8].empty();
  w8(&mut out, TOVIEW_WEATHER);
  wWeatherParams(&mut out, &w.from);
  w32(&mut out, w.target);
  wF64(&mut out, w.start);
  wF32(&mut out, w.duration);
  out
}

fn wWeatherParams(out &mut List[u8], p &WeatherParams) {
  wF32(out, p.cloudLow);
  wF32(out, p.cloudHigh);
  wF32(out, p.density);
  wF32(out, p.cloudLight);
  wF32(out, p.skyGrey);
  wF32(out, p.skyDim);
  wF32(out, p.sunDim);
  wF32(out, p.fog);
  wF32(out, p.ambient);
  wF32(out, p.tintRed);
  wF32(out, p.tintGreen);
  wF32(out, p.tintBlue);
  wF32(out, p.ev);
  wF32(out, p.rain);
  wF32(out, p.snow);
}

fn rWeatherParams(r &mut Rd) WeatherParams {
  let a = r.rF32();
  let b = r.rF32();
  let c = r.rF32();
  let d = r.rF32();
  let e = r.rF32();
  let f = r.rF32();
  let g = r.rF32();
  let h = r.rF32();
  let i = r.rF32();
  let j = r.rF32();
  let k = r.rF32();
  let l = r.rF32();
  let m = r.rF32();
  let n = r.rF32();
  new WeatherParams(a, b, c, d, e, f, g, h, i, j, k, l, m, n, r.rF32())
}

// A reliable message from the simulation, decoded; Nothing if it was malformed
pub fn decodeToView(bytes List[u8]) ToView {
  var r = Rd.make(bytes);
  let tag = r.r8();
  if tag == TOVIEW_REQUESTS {
    let n = r.r16();
    var batch = List[Request].empty();
    var i = 0u32;
    while i < n and r.ok {
      decodeRequest(&mut r, &mut batch);
      i = i + 1u32;
    }
    if r.ok { return ToView.Requests(batch); }
  } elif tag == TOVIEW_POSSESSED {
    let being = r.rVar();
    // (an older server's Possessed ends after the being: version 0)
    let version = if r.ok and r.left() > 0usize { r.r8() } else { 0u32 };
    if r.ok { return ToView.Possessed(being, version); }
  } elif tag == TOVIEW_REFUSED {
    let reason = r.rStr();
    if r.ok { return ToView.Refused(reason); }
  } elif tag == TOVIEW_WEATHER {
    let from = rWeatherParams(&mut r);
    let target = r.r32();
    let start = r.rF64();
    let duration = r.rF32();
    if r.ok { return ToView.Weather(new Weathering(from, target, start, duration)); }
  } elif tag == TOVIEW_FRAMEDONE {
    let tick = r.r64();
    let simulateNs = r.r64();
    let publishNs = r.r64();
    if r.ok { return ToView.FrameDone(tick, simulateNs, publishNs); }
  } elif tag == TOVIEW_BURST {
    let kind = r.r8();
    let being = r.r32();
    let position = r.rVec3();
    let normal = r.rVec3();
    let color = r.r8();
    let tick = r.r64();
    if r.ok { return ToView.Burst(kind, being, position, normal, color, tick); }
  } elif tag == TOVIEW_PORTAL {
    let kind = r.r8();
    let being = r.r32();
    let position = r.rVec3();
    let extra = r.r32();
    if r.ok { return ToView.Portal(kind, being, position, extra); }
  } elif tag == TOVIEW_CREATURE {
    let kind = r.r8();
    let a = r.r32();
    let b = r.r32();
    let position = r.rVec3();
    let extra = r.r32();
    if r.ok { return ToView.Creature(kind, a, b, position, extra); }
  }
  ToView.Nothing
}

// ---- simulation -> view: the state ----

// The state of a tick for one client: the same bodies for every client, with this client's last input applied
pub fn encodeState(w &WorldState) List[u8] {
  var out = List[u8].empty();
  w32(&mut out, u32.from(w.tick & 0xFFFFFFFFu64));
  wF64(&mut out, w.now);
  w8(&mut out, w.rate);
  w32(&mut out, u32.from(w.appliedInput & 0xFFFFFFFFu64));
  w8(&mut out, u32.from(w.beings.len()));
  // The props and spells after the beings take their room first
  let tail = 2usize + 14usize * w.props.len() + 9usize * w.fx.len();
  var i = 0usize;
  while i < w.beings.len() {
    // A ragdoll's rotations go in while the beings still to come keep room for the least a being takes
    let fits = out.len() + 32usize + RAG_BYTES + 30usize * (w.beings.len() - i - 1usize) + 16usize + tail <= MAX_LATEST;
    wBeing(&mut out, w.beings[i], fits);
    i = i + 1usize;
  }
  // The playground's props: slot, place in millimetres, rotation
  w8(&mut out, u32.from(w.props.len()));
  i = 0usize;
  while i < w.props.len() {
    let p = w.props[i];
    w8(&mut out, p.slot);
    wMillimetres(&mut out, p.position.x, POS_ORIGIN_XZ);
    wMillimetres(&mut out, p.position.y, POS_ORIGIN_Y);
    wMillimetres(&mut out, p.position.z, POS_ORIGIN_XZ);
    wQuat(&mut out, p.rotation);
    i = i + 1usize;
  }
  // The spells in force: the being, the kind and the tick it began
  w8(&mut out, u32.from(w.fx.len()));
  i = 0usize;
  while i < w.fx.len() {
    let f = w.fx[i];
    w8(&mut out, f.being);
    w8(&mut out, f.kind);
    w32(&mut out, u32.from(f.start & 0xFFFFFFFFu64));
    i = i + 1usize;
  }
  out
}

// A quaternion in 32 bits: which component is largest (2 bits) and the other three to 10 bits each, within
// 1/724 of 0.7071 (a rotation within about 0.1 degree)
fn wQuat(out &mut List[u8], q Quat) {
  var c Array[f32, 4] = [q.x, q.y, q.z, q.w];
  var big = 0usize;
  var k = 1usize;
  while k < 4usize {
    if libc.fabsf(c[k]) > libc.fabsf(c[big]) { big = k; }
    k = k + 1usize;
  }
  let sign = if c[big] < 0. { -1. } else { 1. };
  var word = u32.from(big);
  k = 0usize;
  while k < 4usize {
    if k != big {
      let v = c[k] * sign;
      let n = clampInt(rounded((v * 1.4142135 + 1.) * 0.5 * 1023.), 0, 1023);
      word = (word << 10u32) | u32.from(n);
    }
    k = k + 1usize;
  }
  w32(out, word);
}

fn rQuat(r &mut Rd) Quat {
  let word = r.r32();
  let big = usize.from((word >> 30u32) & 3u32);
  var c Array[f32, 4] = [0., 0., 0., 0.];
  var rest = word;
  var sum = 0.;
  // The three smaller, written in index order, so the highest index is in the lowest bits
  var n = 3;
  while n >= 0 {
    if usize.from(n) != big {
      let v = (f32.from(rest & 1023u32) / 1023. * 2. - 1.) * 0.70710677;
      c[usize.from(n)] = v;
      sum = sum + v * v;
      rest = rest >> 10u32;
    }
    n = n - 1;
  }
  c[big] = libc.sqrtf(if sum < 1. { 1. - sum } else { 0. });
  new Quat(c[0usize], c[1usize], c[2usize], c[3usize])
}

// What a ragdoll's rotations take on the wire
const RAG_BYTES = 56usize;

fn wBeing(out &mut List[u8], b &BeingState, rotsFit bool) {
  wVar(out, b.being);
  let hasPlatform = !b.platform.isNone();
  let sendRots = b.mode == FIG_RAG and b.hasRots and rotsFit;
  // A person sitting or hailing (the one that is not limp or getting up) has a pose byte after what the rest says: the two mode
  // bits both set (32 and 64), which no being has otherwise, say so; a being doing neither is not a byte the larger
  let posed = b.mode == FIG_WALK and (b.seat > 0u32 or b.hail >= 0.);
  w8(out, (if b.exact { 1u32 } else { 0u32 }) | (if b.grounded { 2u32 } else { 0u32 })
    | (if b.intents.run { 4u32 } else { 0u32 }) | (if b.intents.jump { 8u32 } else { 0u32 })
    | (if hasPlatform { 16u32 } else { 0u32 }) | (if b.mode == FIG_RAG { 32u32 } else { 0u32 })
    | (if b.mode == FIG_GETUP { 64u32 } else { 0u32 }) | (if posed { 96u32 } else { 0u32 }) | (if sendRots { 128u32 } else { 0u32 }));
  wUnit(out, b.intents.ahead);
  wUnit(out, b.intents.turn);
  if b.exact {
    wVec3(out, b.position);
    wF32(out, b.yaw);
    wF32(out, b.speed);
    wF32(out, b.vy);
    wF32(out, b.airVx);
    wF32(out, b.airVz);
  } else {
    wMillimetres(out, b.position.x, POS_ORIGIN_XZ);
    wMillimetres(out, b.position.y, POS_ORIGIN_Y);
    wMillimetres(out, b.position.z, POS_ORIGIN_XZ);
    w16(out, u32.from(headingBits(b.yaw)));
    wSigned(out, clampInt(rounded(b.speed * 1024.), -32767, 32767), 2u32);
    wSigned(out, clampInt(rounded(b.vy * 512.), -32767, 32767), 2u32);
    wSigned(out, clampInt(rounded(b.airVx * 512.), -32767, 32767), 2u32);
    wSigned(out, clampInt(rounded(b.airVz * 512.), -32767, 32767), 2u32);
  }
  if hasPlatform { wId(out, b.platform); }
  w8(out, u32.from(clampInt(rounded(b.health * 255.), 0, 255)));
  w8(out, b.respawns);
  w8(out, b.landings);
  w16(out, u32.from(clampInt(rounded(b.landSpeed * 1024.), 0, 65535)));
  if sendRots {
    var k = 0usize;
    while k < RAG_BODIES { wQuat(out, b.rots[k]); k = k + 1usize; }
  }
  if b.mode == FIG_GETUP { w16(out, u32.from(clampInt(rounded(b.modeT * 1000.), 0, 65535))); }
  // What a person is doing besides walking, one byte: sitting (bit 0, then the seat and how far the sit is, a byte each), sitting down
  // rather than getting up (bit 1), hailing (bit 2, then the seconds since it began in fiftieths)
  if posed {
    let sitting = b.seat > 0u32;
    let hailing = b.hail >= 0.;
    w8(out, (if sitting { 1u32 } else { 0u32 }) | (if b.sitDown { 2u32 } else { 0u32 }) | (if hailing { 4u32 } else { 0u32 }));
    if sitting {
      w8(out, if b.seat > 256u32 { 255u32 } else { b.seat - 1u32 });
      w8(out, u32.from(clampInt(rounded(b.sitT * 255.), 0, 255)));
    }
    if hailing { w8(out, u32.from(clampInt(rounded(b.hail * 50.), 0, 255))); }
  }
}

// The heading in 16 bits: its turns, 0 to 65535 of a whole one
fn headingBits(yaw f32) i32 {
  let turns = yaw / 6.2831855;
  let frac = turns - libc.floorf(turns);
  let n = i32.from(rounded(frac * 65536.));
  n & 65535
}

fn rBeing(r &mut Rd) BeingState {
  let being = r.rVar();
  let flags = r.r8();
  let ahead = r.rUnit();
  let turn = r.rUnit();
  let exact = (flags & 1u32) != 0u32;
  var position = new Vec3(0., 0., 0.);
  var yaw = 0.;
  var speed = 0.;
  var vy = 0.;
  var airVx = 0.;
  var airVz = 0.;
  if exact {
    position = r.rVec3();
    yaw = r.rF32();
    speed = r.rF32();
    vy = r.rF32();
    airVx = r.rF32();
    airVz = r.rF32();
  } else {
    let x = r.rMillimetres(POS_ORIGIN_XZ);
    let y = r.rMillimetres(POS_ORIGIN_Y);
    let z = r.rMillimetres(POS_ORIGIN_XZ);
    position = new Vec3(x, y, z);
    yaw = f32.from(r.r16()) * 6.2831855 / 65536.;
    speed = f32.from(r.rS16()) / 1024.;
    vy = f32.from(r.rS16()) / 512.;
    airVx = f32.from(r.rS16()) / 512.;
    airVz = f32.from(r.rS16()) / 512.;
  }
  var platform = PartId.none();
  if (flags & 16u32) != 0u32 { platform = r.rId(); }
  let health = f32.from(r.r8()) / 255.;
  let respawns = r.r8();
  let landings = r.r8();
  let landSpeed = f32.from(r.r16()) / 1024.;
  var rots = noRots();
  let hasRots = (flags & 128u32) != 0u32;
  if hasRots {
    var k = 0usize;
    while k < RAG_BODIES and r.ok { rots[k] = rQuat(r); k = k + 1usize; }
  }
  var mode = FIG_WALK;
  var modeT = 0.;
  let posed = (flags & 96u32) == 96u32;
  if !posed and (flags & 32u32) != 0u32 { mode = FIG_RAG; }
  if !posed and (flags & 64u32) != 0u32 { mode = FIG_GETUP; modeT = f32.from(r.r16()) / 1000.; }
  // What a person is doing besides walking (both mode bits set): sitting (which seat, how far the sit is) and hailing (how long since
  // it began)
  var pose = 0u32;
  if posed { pose = r.r8(); }
  var seat = 0u32;
  var sitT = 0.;
  var hail = -1.;
  if (pose & 1u32) != 0u32 {
    seat = r.r8() + 1u32;
    sitT = f32.from(r.r8()) / 255.;
  }
  if (pose & 4u32) != 0u32 { hail = f32.from(r.r8()) / 50.; }
  var bs = new BeingState(being, exact, position, yaw, speed, vy, airVx, airVz, (flags & 2u32) != 0u32,
    new Intents(ahead, turn, (flags & 4u32) != 0u32, (flags & 8u32) != 0u32), platform, health, respawns, landings, landSpeed,
    mode, modeT, hasRots, rots);
  bs.seat = seat;
  bs.sitT = sitT;
  bs.sitDown = (pose & 2u32) != 0u32;
  bs.hail = hail;
  bs
}

// A snapshot decoded into 'out' (whose beings are added to); false if malformed
pub fn decodeState(bytes List[u8], out &mut WorldState) bool {
  var r = Rd.make(bytes);
  let tick = u64.from(r.r32());
  let now = r.rF64();
  let rate = r.r8();
  let applied = u64.from(r.r32());
  let n = usize.from(r.r8());
  var beings = List[BeingState].empty();
  var i = 0usize;
  while i < n and r.ok {
    beings.push(rBeing(&mut r));
    i = i + 1usize;
  }
  // The props, then the spells in force
  let np = usize.from(r.r8());
  var props = List[PropState].empty();
  i = 0usize;
  while i < np and r.ok {
    let slot = r.r8();
    let x = r.rMillimetres(POS_ORIGIN_XZ);
    let y = r.rMillimetres(POS_ORIGIN_Y);
    let z = r.rMillimetres(POS_ORIGIN_XZ);
    let q = rQuat(&mut r);
    props.push(new PropState(slot, new Vec3(x, y, z), q));
    i = i + 1usize;
  }
  let nf = usize.from(r.r8());
  var fx = List[FxState].empty();
  i = 0usize;
  while i < nf and r.ok {
    let being = r.r8();
    let kind = r.r8();
    let start = u64.from(r.r32());
    fx.push(new FxState(being, kind, start));
    i = i + 1usize;
  }
  if !r.ok { return false; }
  out.tick = tick;
  out.now = now;
  out.rate = rate;
  out.appliedInput = applied;
  out.beings <=> beings;
  out.props <=> props;
  out.fx <=> fx;
  true
}

// ---- a scripted run's own ----

pub fn encodeTest(t &TestView) List[u8] {
  var out = List[u8].empty();
  w8(&mut out, if t.fixedView { 1u32 } else { 0u32 });
  wVec3(&mut out, t.view.origin);
  wF32(&mut out, t.view.orientation.x);
  wF32(&mut out, t.view.orientation.y);
  wF32(&mut out, t.view.orientation.z);
  wF32(&mut out, t.view.orientation.w);
  wF32(&mut out, t.fov);
  wStr(&mut out, t.shot.view());
  w32(&mut out, t.width);
  w32(&mut out, t.height);
  out
}

pub fn decodeTest(bytes List[u8], out &mut TestView) bool {
  var r = Rd.make(bytes);
  let fixed = r.r8();
  let origin = r.rVec3();
  let qx = r.rF32();
  let qy = r.rF32();
  let qz = r.rF32();
  let qw = r.rF32();
  let fov = r.rF32();
  let shot = r.rStr();
  let width = r.r32();
  let height = r.r32();
  if !r.ok { return false; }
  out.width = width;
  out.height = height;
  out.fixedView = fixed != 0u32;
  out.view = new Pose(origin, new Quat(qx, qy, qz, qw));
  out.fov = fov;
  out.shot = shot;
  true
}
