// The villagers' part of the scripted run, last of all (after the ragdoll's and the HUD's, frame NPC_FROM). A scripted run has no
// villagers until here: the pictures and checks of everything before are of the world alone (so that a run's shots are
// the same whether or not there are villagers, and one lane's changes are not mixed up with theirs). At NPC_FROM the
// villagers are made (npcs.cone: the navigation mesh, four mannequins, their minds) and walk for NPC_SETTLE frames;
// then the day clock is set to noon of a fifth day in fair weather, and each villager in turn is looked at from the
// side, 3.6 m away, wherever its own walking has taken it (a villager is not moved for the picture), a window of ten
// frames each, the picture saved at the fifth:
//
//   window  what is looked at
//     0     the villager (blue), on its round
//     1     the gardener (green), in the garden
//     2     the follower (ochre), trailing the player
//     3     the shy villager (purple), at home
//
// The villagers' own walking is checked in --checks (npcchecks.cone), by a long run; this part is the pictures, and
// checks that each villager was upright (not fallen), on the ground, within the mesh's reach and drawn.
//
// (A villager moved far in one step, by Being.setDown, is drawn stretched for about a second afterwards in the
// view: its gait's smoothed state is not reset by the teleport. Villagers are never moved so; it is why this part
// looks at them where they are.)

pub const NPC_FROM = FALL_FROM + FALL_FRAMES + HUD_FRAMES;
pub const NPC_SETTLE = 600u64;
pub const NPC_WINDOW = 10u64;
pub const NPC_WINDOWS = 4u64;
pub const NPC_FRAMES = NPC_SETTLE + NPC_WINDOW * NPC_WINDOWS;

// Noon of the fifth day (the clock's hour 108), in seconds of scene time
const NPC_NOON f64 = 6060d;


// The window frame 'f' is in (0 to NPC_WINDOWS - 1), or a number past the last before the windows begin
fn npcWindow(f u64) u64 { (f - NPC_FROM - NPC_SETTLE) / NPC_WINDOW; }

fn npcInWindows(opts &RunOptions, f u64) bool { opts.npcsEnabled and f >= NPC_FROM + NPC_SETTLE and f < NPC_FROM + NPC_FRAMES; }

pub fn npcShotAt(opts &RunOptions, f u64) &str {
  if !npcInWindows(opts, f) or (f - NPC_FROM - NPC_SETTLE) % NPC_WINDOW != 5u64 { return ""; }
  let w = npcWindow(f);
  if w == 0u64 { return "npc-villager"; }
  if w == 1u64 { return "npc-gardener"; }
  if w == 2u64 { return "npc-follower"; }
  "npc-shy";
}

pub fn npcHasView(opts &RunOptions, f u64) bool { npcInWindows(opts, f); }

// The eye: 3.6 m to the villager's right, a little ahead of it and 1.4 m above its feet, looking at its chest
pub fn npcView(st &mut SimState, f u64) Pose {
  let w = npcWindow(f);
  let b = st.cast.beings[st.village.npcs[usize.from(w)].being];
  let p = b.body.position;
  let fx = 0. - sin(b.body.yaw);
  let fz = 0. - cos(b.body.yaw);
  lookFrom(new Vec3(p.x + cos(b.body.yaw) * 3.6 + fx * 0.4, p.y + 1.4, p.z - sin(b.body.yaw) * 3.6 + fz * 0.4),
    new Vec3(p.x, p.y + 0.95, p.z));
}

// The villagers' part of frame 'f', after it is presented
pub fn npcDrive(st &mut SimState, f u64) {
  if !st.opts.npcsEnabled or f < NPC_FROM or f >= NPC_FROM + NPC_FRAMES { return; }
  if f == NPC_FROM {
    st.seedVillage();
    st.scene.clock.ns = u64.from(nanosOf(NPC_NOON));
    st.weather.setNow(WEATHER_FAIR);
    return;
  }
  if !npcInWindows(&st.opts, f) { return; }
  let w = npcWindow(f);
  let k = (f - NPC_FROM - NPC_SETTLE) % NPC_WINDOW;
  if k == 5u64 {
    let n = st.village.npcs[usize.from(w)];
    let b = st.cast.beings[n.being];
    let stray = st.village.world.strayOf(b.body.position);
    let drawn = !st.rendered.gpu or st.rendered.isDrawn(b.part);
    print <- "Frame "; print <- f; print <- ", "; printStr(n.name.view()); print <- " at ("; print <- b.body.position.x; print <- ", "; print <- b.body.position.z;
    print <- "), "; print <- stray; print <- " m from the mesh, walked "; print <- n.walked; print <- " m so far, ";
    if b.figure.mode == FIG_WALK and b.figure.grounded { print <- "upright and on the ground"; } else { print <- "NOT upright"; };
    print <- ", "; if drawn { print <- "drawn"; } else { print <- "NOT drawn"; };
    print <- "\n";
    if stray > NAV_STRAY or b.figure.mode != FIG_WALK or !b.figure.grounded or !drawn {
      st.npcRunOk = false;
      print <- "  the villager is WRONG\n";
    }
  }
}

// Whether the villagers' part has held
pub fn checkNpcRun(st &SimState) bool { st.npcRunOk; }
