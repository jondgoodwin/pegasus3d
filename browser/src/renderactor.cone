// The render actor: the GPU side, run on the actors package's workers. It
// owns the device and everything made on it (the swapchain, the renderer,
// the HDR frame and its Post, the render system's meshes, materials, rows
// and effects, and the sky rig's pipelines), and it draws from nothing but
// what the scene actor moves to it:
//
//   draw(order)   once a frame, awaited by the scene actor: the requests the
//                 scene has passed on to render (applied in the order sent),
//                 then the frame drawn from the snapshot alone, presented,
//                 and the next image acquired; answered with the snapshot
//                 handed back (so the scene publishes the next one into the
//                 same lists), the phases' times, and, in a scripted run,
//                 what it drew for the script's checks
//   finish()      at the end of the run: what it drew, the Vulkan failures
//                 and the validation layer's messages; the device let go
//
// Its device is made by its initializer, which runs on the shell's thread
// (the one that made the window, as SDL wants); from then on only this
// actor's messages reach it, on whichever worker runs them.

// The GPU side, made by the initializer; the device outlives what it made
struct Gfx {
  pub readback Buffer;
  pub shotName String;        // the file the frame read back goes to; empty: none
  pub target SurfaceTexture;
  pub off SurfaceTexture;     // a gallery run's frame (gallery.cone): drawn off screen at the shot's size, swapped with 'target' while it is drawn
  pub post Post;            // the HDR frame drawn into, bloomed and tone-mapped into the target
  pub fx ImageFx;             // image quality (TAA or FXAA, auto-exposure, ambient occlusion, froxel fog) around it
  pub fxTier u32;             // 0 off (the plain path), 1 low (an integrated GPU), 2 high
  pub fxMeter bool;           // PEGASUS_DBG=meter: print what the auto-exposure measured at each shot
  pub splatMaterial u32;      // the paint splats' decal material (playview.cone's splatImage), or SPLAT_NONE with the image quality off
  pub lastEye Vec3;           // the camera last frame, to tell a cut (a teleport) from a move
  pub lastForward Vec3;
  pub haveLast bool;
  pub hud Hud;                // the overlay (hud.cone), drawn last; before the device, which ends after what was made on it
  pub timer FrameTimer;       // PEGASUS_CPU_TIMING / PEGASUS_GPU_TIMING: the frame's time by stage (frametimer.cone); before the device, too
  pub sys RenderSystem;
  pub renderer Renderer;
  pub swapchain SwapChain;
  pub device Device;
  pub adapter Adapter;
  pub surface Surface;
  pub instance Instance;
  pub camera Camera;
  pub sunShadows bool;        // the tier's sun shadows are on (they are switched off underground: bakedworld/labyrinth.cone)
  pub offscreen bool;         // the frame being drawn is the gallery's, off screen: no overlay, and its shot is a PNG
  pub shotW u32;              // the size, and the texel order, of the frame read back
  pub shotH u32;
  pub shotBgra bool;
  pub shotPng bool;
  pub skyScale f32 = 1.;      // how bright the environment's sky is baked (fitEnvironmentSky), the share of rendersys.cone's daylight
}

// The environment's sky is one fixed daylight (rendersys.cone's environmentSky), which the day dims by the renderer's
// 'environmentStrength' where the image-based light reads the cubes made from it. Ray-traced glass also reads that sky directly, for
// a ray that leaves a ball or a pane into the air, and the strength does not reach it: left alone, a glass ball at night would
// refract a noon sky. So the sky is baked as bright as the hour's strength says, in steps of 6% (the cubes are made again only when a
// step is crossed: a few passes, a few times in a dusk), and the strength that is left (a few percent either side of 1) is the
// ratio, so what the image-based light gives is the strength exactly as before. Zero (underground) keeps the sky as it was.
// Answers the strength to give the renderer.
fn fitEnvironmentSky(g &mut Gfx, strength f32) f32 {
  if strength < 0.0001 { return strength; }
  imm scale = libc.expf(libc.floorf(libc.logf(strength) / 0.06 + 0.5) * 0.06);
  if !(scale > g.skyScale * 0.9999 and scale < g.skyScale * 1.0001) {
    mut s = environmentSky();
    s.sunColor = scaled(s.sunColor, scale);
    s.zenith = scaled(s.zenith, scale);
    s.horizon = scaled(s.horizon, scale);
    s.glow = scaled(s.glow, scale);
    s.ground = scaled(s.ground, scale);
    s.line = scaled(s.line, scale);
    s.cloud = scaled(s.cloud, scale);
    g.renderer.setSky(&mut g.device, &s);
    g.renderer.drawSky = false;       // (setSky turns render's own sky pass on; the browser's is its own)
    g.skyScale = scale;
  }
  strength / g.skyScale;
}

fn scaled(c Color, k f32) Color { new Color(c.red * k, c.green * k, c.blue * k, c.alpha); }

// The labyrinth's auto-exposure trim (stops): its rooms are dim, and the auto-exposure must not lift them to a middle grey
const LAB_TRIM_EV f32 = -1.;

// What the scene actor moves to render each frame
pub struct DrawOrder {
  pub snapshot Snapshot;
  pub requests List[Request]; // render's share of the frame's requests, in the order sent
  pub alpha f32;              // the picture this far from the step before the last to the last
  pub frame u64;
  pub resized bool;           // the window changed size: the swapchain is made 'width' by 'height'
  pub width u32;
  pub height u32;
  pub shot String;            // a scripted run's view to save from this frame, by name; empty: none
  pub hud HudFrame;           // what the overlay shows
  pub capW u32 = 0u32;        // a gallery run: draw this frame off screen at 'capW' by 'capH' pixels, no overlay (0: the window's)
  pub capH u32 = 0u32;
}

// What render hands back once the frame is presented
pub struct Presented {
  pub snapshot Snapshot;      // the one drawn, handed back to be published into again
  pub renderNs u64;           // recording the frame: the render phase
  pub presentNs u64;          // presenting it and acquiring the next image: the present phase
  pub swapNs u64;             // of which the swapchain's present
  pub acquireNs u64;          // and acquiring
  pub status u32;             // the image acquired's status
  pub rows usize;             // rows the render system draws, and particle emitters
  pub emitters usize;
  pub shotFailed bool;        // a scripted view could not be written
  pub facts RenderFacts;      // a scripted run's: what it drew
  pub join String;            // the panel's Join was pressed this frame: the name to play under (else empty)
  pub panel u32 = 0u32;       // the "Play with others" panel after the frame (requestpanel.cone: PANEL_OPEN, PANEL_TEXT)
  pub talk u32 = 0u32;        // the question chosen on a guard's panel this frame ((guard * 256 + question) + 1; talkpanel.cone), or 0
}

// How a part is drawn, as the scripted run's checks read it
pub struct DrawnFact {
  pub material MaterialId;
  pub physical bool;
  pub tint Color;
}

// What render drew, copied out for the scripted run's checks (script.cone):
// whether a part is drawn or gives off particles, its material, whether it
// is physically based, and its tint
pub struct RenderFacts {
  pub gpu bool;               // the run has the GPU side
  drawn Table[DrawnFact];
  emitting Table[u32];        // the particles it drew at the last frame
  lighting Table[u32];        // the parts that are lights
  pub pictures u64 = 0u64;    // the frames that drew a view surface's picture (a mirror's), ever

  pub fn empty() RenderFacts { new RenderFacts(false, Table[DrawnFact].empty(), Table[u32].empty(), Table[u32].empty()); }

  // The render system's tables now, into 'dest' (its lists reused)
  fn take(sys &RenderSystem, dest &mut RenderFacts) {
    dest.gpu = true;
    dest.pictures = sys.surfaces.frames;
    dest.drawn.clear();
    dest.emitting.clear();
    dest.lighting.clear();
    mut i = 0usize;
    while i < sys.lamps.ids.len() {
      dest.lighting.put(*sys.lamps.ids[i], 1u32);
      i = i + 1usize;
    }
    i = 0usize;
    while i < sys.rows.ids.len() {
      imm id = *sys.rows.ids[i];
      dest.drawn.put(id, new DrawnFact(sys.materialOf(id), sys.isPhysical(id), sys.tintOf(id)));
      i = i + 1usize;
    }
    i = 0usize;
    while i < sys.effects.ids.len() {
      dest.emitting.put(*sys.effects.ids[i], sys.effectParticles(*sys.effects.ids[i]));
      i = i + 1usize;
    }
  }

  // How many particles part 'id''s effect drew at the last frame (0: none, or no effect)
  pub fn particlesOf(self &, id PartId) u32 {
    imm row = emitting.find(id);
    if row == NO_ROW { 0u32; } else { *emitting.rows[row]; };
  }

  // Whether part 'id' is drawn, gives off particles, or is a light
  pub fn isDrawn(self &, id PartId) bool {
    drawn.find(id) != NO_ROW or emitting.find(id) != NO_ROW or lighting.find(id) != NO_ROW;
  }

  // How many parts are lights
  pub fn lightCount(self &) usize { lighting.len(); }

  // Whether part 'id' is drawn physically based
  pub fn isPhysical(self &, id PartId) bool {
    imm row = drawn.find(id);
    row != NO_ROW and drawn.rows[row].physical;
  }

  // The material part 'id' is drawn in (none if it is not drawn)
  pub fn materialOf(self &, id PartId) MaterialId {
    imm row = drawn.find(id);
    if row == NO_ROW { MaterialId.none(); } else { drawn.rows[row].material; };
  }

  // Part 'id''s tint (white if it is not drawn)
  pub fn tintOf(self &, id PartId) Color {
    imm row = drawn.find(id);
    if row == NO_ROW { new Color(1., 1., 1., 1.); } else { drawn.rows[row].tint; };
  }
}

// What render tells the scene at the end of the run
pub struct RenderEnd {
  pub clean bool;             // no Vulkan call failed and the validation layer said nothing
}

actor RenderActor {
  gfx Option[Gfx];
  rig SkyRig;                 // the day's sky and light (skyrig.cone); the birds come in the snapshot
  skyOff bool;                // --no-sky: the static sky and light, no birds
  scripted bool;
  shotsDir String;            // where a scripted run's views are written; empty: nowhere
  unrendered u64;             // render requests a headless run had no GPU for
  renderCallTicks u64;        // the CPU time spent in render's own call (the scene's culling, batching and recording), summed
  renderCalls u64;            // and its count

  // The GPU side made for the window (its SDL handle as a number, since a
  // raw pointer is not Sendable; 0 for a headless run, which has none),
  // 'width' by 'height' pixels. 'ready' is told whether it could be made.
  fn init(self &new, window usize, width u32, height u32, opts RunOptions, shotsDir String,
    ready Sender[bool], land Island) {
    imm skyOff = opts.skyOff;
    imm scripted = opts.scripted;
    mut rig = SkyRig.make();
    mut made Option[Gfx] = None;
    mut ok = true;
    if window != 0usize {
      validationPolicy(scripted);
      made = makeGfx(window as *u8 as *sdl.Window, width, height, skyOff, opts.cullMode, &mut rig, &land);
      ok = false;
      match &mut made {
        case mut some &mut Some { ok = true; }
        else {}
      }
    }
    *self = new Self(made, rig, skyOff, scripted, shotsDir, 0u64, 0u64, 0u64);
    mut told = ready;
    told <- ok;
  }

  // The frame (above)
  pub async do draw(self, order DrawOrder) Presented {
    mut o = order;
    imm t0 = sdl.GetTicksNS();
    mut g Option[Gfx] = None;
    g <=> gfx;
    mut rows = 0usize;
    mut emitters = 0usize;
    mut swapNs = 0u64;
    mut acquireNs = 0u64;
    mut status = SURFACE_TEXTURE_SUCCESS_OPTIMAL;
    mut shotFailed = false;
    mut facts = RenderFacts.empty();
    mut panel = 0u32;
    mut talk = 0u32;
    mut join = String.empty();
    mut t1 = t0;
    match &mut g {
      case mut some &mut Some {
        some.timer.begin();
        if o.resized { some.swapchain.resize(o.width, o.height); }
        // A gallery run's frame is drawn off screen, at the size its shot says, whatever the window is: the offscreen target
        // takes the swapchain's place while it is drawn, and the swapchain's image is presented as it was
        // (not in the first frames: what was made with the device is still being uploaded, and a texture or frame made again in the
        // device frame that made it would leave the upload's commands invalid)
        imm offscreen = o.capW > 0u32 and o.capH > 0u32 and some.target.ok() and o.frame > 3u64;
        some.offscreen = offscreen;
        if offscreen {
          if some.off.texture.width != o.capW or some.off.texture.height != o.capH {
            some.device.waitIdle();
            some.off = makeOffscreen(&mut some.device, o.capW, o.capH, some.target.texture.format);
          }
          some.target <=> some.off;
        }
        some.sys.surfaces.width = some.target.texture.width;
        some.sys.surfaces.height = some.target.texture.height;
        self.apply(some, &mut o.requests);
        some.timer.mark(0usize);
        self.drawFrame(some, &o.snapshot, o.shot.view(), o.alpha, &o.hud);
        if offscreen { some.target <=> some.off; }
        panel = some.hud.panelBits();
        join = some.hud.takeJoin();
        talk = some.hud.takeTalk();
        t1 = sdl.GetTicksNS();
        imm s0 = sdl.GetTicksNS();
        if some.target.ok() {
          some.swapchain.present(&mut some.device);
          swapNs = sdl.GetTicksNS() - s0;
          if !self.writeShot(some) { shotFailed = true; }
        } else {
          sdl.Delay(10u32);
        }
        imm a0 = sdl.GetTicksNS();
        some.target = some.swapchain.getCurrentTexture(&mut some.device);
        acquireNs = sdl.GetTicksNS() - a0;
        some.timer.mark(9usize);
        some.timer.frameDone();
        status = some.target.status;
        rows = some.sys.rows.len();
        emitters = some.sys.particles.emitterCount();
        if scripted { RenderFacts.take(&some.sys, &mut facts); }
      }
      else {
        self.countUnrendered(&mut o.requests);
        t1 = sdl.GetTicksNS();
      }
    }
    gfx = g;
    imm t2 = sdl.GetTicksNS();
    mut snap = Snapshot.empty();
    snap <=> o.snapshot;
    mut presented = new Presented(snap, t1 - t0, t2 - t1, swapNs, acquireNs, status, rows, emitters, shotFailed, facts, join);
    presented.panel = panel;
    presented.talk = talk;
    presented;
  }

  // The switch from single player to a server (viewactor.cone, goOnline): 'requests' are a Despawn of every part the view
  // held, applied now (the rows, batches, lights, scene items and effects go by the same code a Despawn always takes); then
  // every mesh the old world defined is let go (its buffers are destroyed once the GPU has finished with them), and so is
  // every material, with the textures it was made with (render keeps no list of which: the row holds them, and 'shadedTextures'
  // those of the browser's own shaders' materials) and every view surface's picture; the mesh and material tables are emptied,
  // so that the server's world is defined into tables with no stale id in them. render destroys what is given back once the
  // GPU has finished with the frames that may have used it, so none of this waits.
  pub async do reset(self, requests List[Request]) bool {
    mut reqs = requests;
    mut g Option[Gfx] = None;
    g <=> gfx;
    match &mut g {
      case mut some &mut Some {
        imm before = some.sys.rows.len();
        self.apply(some, &mut reqs);
        // Nothing keyed by an old part's id may be left (a stale id would meet the server's, which are numbered again)
        print <- "Render reset: "; print <- before; print <- " rows drawn before; after the despawns "; print <- some.sys.rows.len(); print <- " rows, ";
        print <- some.sys.lamps.len(); print <- " lights, "; print <- some.sys.effects.len(); print <- " effects, "; print <- some.sys.scenery.len();
        print <- " scene items, "; print <- some.sys.poses.len(); print <- " poses, "; print <- some.sys.skies.len(); print <- " skies; ";
        print <- some.sys.meshes.len(); print <- " meshes and "; print <- some.sys.materials.len(); print <- " materials let go\n";
        mut i = 0usize;
        while i < some.sys.meshes.len() {
          imm freed = some.renderer.removeMesh(&mut some.device, some.sys.meshes.rows[i].handle);
          i = i + 1usize;
        }
        some.sys.meshes.clear();
        i = 0usize;
        while i < some.sys.materials.len() {
          imm row = *some.sys.materials.rows[i];
          some.renderer.removeMaterial(&mut some.device, row.handle);
          some.renderer.removeMaterial(&mut some.device, row.lit);
          some.renderer.removeTexture(&mut some.device, row.base.texture);
          some.renderer.removeTexture(&mut some.device, row.pbr.texture);
          some.renderer.removeTexture(&mut some.device, row.pbr.metallicRoughnessTexture);
          some.renderer.removeTexture(&mut some.device, row.pbr.normalTexture);
          some.renderer.removeTexture(&mut some.device, row.pbr.occlusionTexture);
          i = i + 1usize;
        }
        i = 0usize;
        while i < some.sys.shadedTextures.len() {
          some.renderer.removeTexture(&mut some.device, *some.sys.shadedTextures[i]);
          i = i + 1usize;
        }
        some.sys.shadedTextures.clear();
        i = 0usize;
        while i < some.sys.surfaces.rows.len() {
          some.sys.surfaces.rows.rows[i].view.release(&mut some.renderer, &mut some.device);
          i = i + 1usize;
        }
        some.sys.surfaces.rows.clear();
        some.sys.materials.clear();
        some.sys.batches.clear();
      }
      else { self.countUnrendered(&mut reqs); }
    }
    gfx = g;
    true;
  }

  // The end of the run (above), printed as the browser always has
  pub async do finish(self, hasWindow bool) RenderEnd {
    if !hasWindow {
      if unrendered > 0u64 { print <- "Headless: "; print <- unrendered; print <- " render requests had no GPU\n"; }
      return new RenderEnd(true);
    }
    mut g Option[Gfx] = None;
    g <=> gfx;
    mut panelClean = true;
    match &mut g {
      case mut some &mut Some {
        some.device.waitIdle();
        some.timer.report();
        // (a run that asked to play, as the panel's scripted run does: every request must have been answered; the answer comes on the
        // real clock, so it is waited for, up to 6 s: a refusal from a closed port takes 2.05 s on Windows)
        some.hud.model.rp.waitForAnswers(&mut some.hud.model.ui, 6000i64);
        some.hud.report();
        if some.hud.model.rp.answers != some.hud.model.rp.requests { panelClean = false; }
        print <- "Parts drawn: "; print <- some.sys.drawn; print <- "; draws ";
        print <- u64.from(some.renderer.drawCalls); print <- ", triangles "; print <- some.renderer.triangles;
        print <- "\n";
        if renderCalls > 0u64 {
          print <- "Render call: "; print <- f64.from(renderCallTicks) / f64.from(sdl.GetPerformanceFrequency()) * 1000d / f64.from(renderCalls);
          print <- " ms CPU a frame, mean of "; print <- renderCalls; print <- " frames\n";
        }
        if some.sys.surfaces.frames > 0u64 {
          print <- "View surfaces: "; print <- some.sys.surfaces.frames; print <- " frames drew a picture, "; print <- f64.from(some.sys.surfaces.ticks) /
            f64.from(sdl.GetPerformanceFrequency()) * 1000d / f64.from(some.sys.surfaces.frames); print <- " ms CPU a frame recording them\n";
        }
        if some.sys.surfaces.gpuPictures > 0u64 {
          print <- "View surfaces: "; print <- some.sys.surfaces.gpuNs / f64.from(some.sys.surfaces.gpuPictures) / 1000000d;
          print <- " ms on the GPU a picture, mean of "; print <- some.sys.surfaces.gpuPictures; print <- "; the last picture "; print <- u64.from(some.sys.surfaces.lastCalls);
          print <- " draws, "; print <- some.sys.surfaces.lastTriangles; print <- " triangles\n";
        }
      }
      else {}
    }
    g = None;
    print <- "Vulkan failures: "; print <- u64.from(failures());
    print <- "; validation messages: "; print <- u64.from(validationMessages()); print <- "\n";
    new RenderEnd(failures() == 0u32 and validationMessages() == 0u32 and panelClean);
  }

  // The render requests a headless run has no GPU for, counted as the
  // browser always has (a part's despawn is not one)
  fn countUnrendered(self, requests &mut List[Request]) {
    imm rs = requests.viewMut();
    mut i = 0usize;
    while i < rs.len {
      mut r Request = Request.Done;
      r <=> rs[i];
      match &mut r {
        case mut d &mut Despawn {}
        else { unrendered = unrendered + 1u64; }
      }
      i = i + 1usize;
    }
  }

  // The scene's requests for render, applied in the order sent; the scene
  // has already refused any naming a part or resource that is not live
  fn apply(self, g &mut Gfx, requests &mut List[Request]) {
    imm rs = requests.viewMut();
    mut i = 0usize;
    while i < rs.len {
      mut r Request = Request.Done;
      r <=> rs[i];
      match &mut r {
        // The scene's Despawn has taken the subtree; each part that went
        // comes as one Despawn of its own
        case mut d &mut Despawn {
          g.sys.dropLamp(&mut g.renderer, d.id);
          g.sys.dropScene(&mut g.renderer, d.id);
          g.sys.drop(&mut g.device, d.id);
        }
        case mut dm &mut DefineMesh { g.sys.defineMesh(&mut g.renderer, &mut g.device, dm.mesh, &dm.shape); }
        case mut ds &mut DefineSkinnedMesh {
          g.sys.defineSkinnedMesh(&mut g.renderer, &mut g.device, ds.mesh, &ds.shape, &ds.skin);
        }
        case mut bn &mut Bones { g.sys.pose(bn.id, &bn.bones); }
        case mut dl &mut DefineMaterial {
          g.sys.defineMaterial(&mut g.renderer, &mut g.device, dl.material, &dl.surface, &dl.paint, &mut dl.maps);
        }
        case mut sh &mut Show { g.sys.show(sh.id, sh.mesh, sh.material, sh.anchor); }
        case mut ef &mut Effect { g.sys.effect(&mut g.device, ef.id, &ef.layers, ef.seed, ef.start, ef.stop); }
        case mut f &mut Fire { g.sys.fire(f.id, f.seed, f.start, f.stop); }
        case mut gl &mut Glow { g.sys.glow(&mut g.renderer, &mut g.device, gl.material, gl.glow); }
        case mut tn &mut Tint { g.sys.tint(tn.id, tn.tint); }
        case mut ls &mut LightSource { g.sys.lightSource(&mut g.renderer, ls.id, &ls.light); }
        case mut cs &mut CastsShadow { g.sys.castsShadow(cs.id, cs.casts); }
        case mut cu &mut Cull { g.sys.cull(cu.id, &cu.levels, &cu.sizes, cu.rangeMax, cu.margin); }
        case mut hl &mut Highlight { g.sys.highlight(&mut g.renderer, &mut g.device, hl.id, hl.on); }
        case mut k &mut Sky { g.sys.sky(k.id, k.look); }
        else {}
      }
      i = i + 1usize;
    }
  }

  // The frame drawn from the snapshot alone: the camera at its eye, the
  // render system's draw list, the sky and the birds, then the effects'
  // particles at the snapshot's time
  fn drawFrame(self, g &mut Gfx, snapshot &Snapshot, shot &str, alpha f32, hud &HudFrame) {
    if !g.target.ok() { return; }
    imm pose = snapshot.eye(alpha);
    mut sky = g.sys.currentSky();
    // UNDERGROUND (the labyrinth, 300 m under the island: bakedworld/labyrinth.cone) is told by the eye's height alone, underground()
    // (parts/portal.cone), the one test for the labyrinth's light, its layer, its ground and its navigation. The day's rig keeps
    // running underground (a portal's picture of the island needs its sky, sun and weather); what changes is the frame's own light:
    // the labyrinth's (no sun, a dim warm ambient, a fixed exposure, LAB_EV), with no sky, birds, fog, rain, sun shadows or
    // image-based light; the rooms are lit by their own lamps. A picture of the other world carries that world's light (PictureEnv).
    imm under = underground(pose.origin.y);
    // Once the world has sent a sky, the day's: the sun, moon and ambient from
    // the day clock (skyrig.cone), and the exposure from the sun's height
    imm dayLit = g.sys.skies.len() > 0usize and rig.made;
    // The weather at this moment of scene time: a closed form, so a paused
    // clock holds it and a scrubbed one finds it (parts/weather.cone)
    mut weather = snapshot.weather.at(snapshot.now);
    rig.setWeather(weather);
    if dayLit {
      rig.setHour(f32.from(snapshot.hour));
      sky = rig.look();
      g.renderer.environmentStrength = fitEnvironmentSky(g, rig.environmentStrength());
    }
    g.renderer.shadow.settings.enabled = g.sunShadows;
    g.camera.origin = pose.origin;
    g.camera.orientation = pose.orientation;
    // A scripted close-up may look through a longer lens
    g.camera.fov = snapshot.fov;
    // Under the island the island's terrain is 300 m overhead: the camera sees 120 m, and nothing of the sky is drawn
    g.camera.far = if under { UNDER_FAR; } else { DAY_FAR; };
    g.camera.background = if under { new Color(0., 0., 0., 1.); } else { sky.color; };
    // The shaders' clock: the scene's time (the sea's waves, the swash), stopped when it is
    g.renderer.time = f32.from(snapshot.now);
    imm dayLight = Light.directional(new Vec3(0., 0., 0.) - sky.sunDirection, sky.sunColor, sky.ambient);
    // (under a dull sky the exposure opens up by the weather's stops)
    imm dayExposure = if dayLit { exposureForElevation(rig.sunSine()) * rig.exposureScale(); } else { exposureFor(&sky); };
    imm dayEnvironment = g.renderer.environmentStrength;
    imm underLight = Light.directional(new Vec3(0., -1., 0.), new Color(0., 0., 0., 1.), labAmbient());
    imm underExposure = exposureFromEv100(LAB_EV);
    // (a picture of the labyrinth seen from the island, in a pane: the eye there is in daylight, so a lit room beyond a doorway is dim,
    // LAB_DAY_VIEW_STOPS under the exposure its own lamps are set for, not blown out white; seen from inside, its own)
    imm underSeenExposure = exposureFromEv100(LAB_EV + LAB_DAY_VIEW_STOPS);
    imm light = if under { underLight; } else { dayLight; };
    g.renderer.exposure = if under { underExposure; } else { dayExposure; };
    if under { g.renderer.environmentStrength = 0.; }
    g.sys.surfaces.open = snapshot.glassOpen;
    // Smoke is lit by the sky: white radiance under the ambient light and the
    // sun's (or the moon's) share on a surface turned to it, times the exposure
    imm sunUp = sky.sunDirection.normalize().y;
    imm sunShare = if sunUp > 0. { sunUp; } else { 0.; };
    g.sys.smokeLight = g.renderer.exposure * (luma(sky.ambient) + luma(sky.sunColor) * sunShare * 0.3183);
    g.sys.syncScene(&mut g.renderer, snapshot, pose.origin);
    g.sys.fitSurfaces(&mut g.renderer, &mut g.device, &g.camera, g.target.texture.width, g.target.texture.height);
    g.timer.mark(1usize);
    // (under the island, the island is left out unless a picture of it is wanted: the corridor's mouth shows it)
    imm islandOut = under and !g.sys.surfaces.dayWanted;
    // (and on the island the labyrinth is left out unless a picture of it is wanted: the glass is open and seen)
    imm labOut = !under and !g.sys.surfaces.labWanted;
    g.sys.build(snapshot, pose.origin, islandOut, labOut);
    g.timer.mark(2usize);
    g.sys.threads.draw(&mut g.renderer, &mut g.device, &mut g.sys.list, &snapshot.thread);
    g.sys.creatures.draw(&mut g.renderer, &mut g.device, &mut g.sys.list, &snapshot.bits);
    g.sys.aimLights(&mut g.renderer, snapshot);
    g.timer.mark(3usize);
    if dayLit and !islandOut {
      rig.draw(&mut g.renderer, &mut g.device, &mut g.sys.list, f32.from(snapshot.now), alpha, &snapshot.birds);
      // The fog after the sky: depth slabs over what lies beyond them (with image quality on, the froxel
      // fog of ImageFx does it, from the same weather)
      if g.fxTier == 0u32 {
        imm aspect = f32.from(g.target.texture.width) / f32.from(g.target.texture.height);
        rig.drawFog(&mut g.sys.list, pose.origin, pose.orientation, snapshot.fov, aspect, g.renderer.exposure);
      }
    }
    // The pictures of the view surfaces (mirrors) in sight, drawn before the frame's own pass, each in a submission
    // of its own (viewsurface.cone)
    // (The effects and the weather are aimed first, for the pictures' particles as well as the frame's own: viewsurface.cone)
    g.timer.mark(4usize);
    imm effectsOn = g.sys.hasEffects() and !under;
    if effectsOn {
      g.sys.aimEffects(&mut g.device, snapshot);
      g.sys.aimWeather(&mut g.device, snapshot, pose.origin, &weather);
    }
    g.timer.mark(5usize);
    if g.sys.surfaces.anySeen() {
      // (the jitter temporal AA is about to move this frame by, so the pictures are of its sequence: see drawSurfaceViews)
      mut jitterX = 0.;
      mut jitterY = 0.;
      if g.fxTier != 0u32 and g.fx.settings.aa == AA_TAA {
        mut jx = 0.;
        mut jy = 0.;
        imm taa = &g.fx.settings.taa;
        jitterOf(g.fx.frameNumber, if taa.samples < 2u32 { 2u32; } else { taa.samples; }, taa.jitterScale, &mut jx, &mut jy);
        jitterX = 2. * jx / f32.from(g.target.texture.width);
        jitterY = -2. * jy / f32.from(g.target.texture.height);
      }
      // The air a picture shows (render's RenderView.fog, Cone #613): the island's weather, whatever world the viewer is in (a
      // portal's picture of the island seen from the labyrinth is fogged); the labyrinth has none
      imm dayFog = pictureFog(g.fxTier, weather.fog);
      imm noFog = pictureFog(g.fxTier, 0.);
      // Has the camera cut? (the same test as the frame's own history, below)
      imm pictureCut = cameraCut(g, pose.origin, pose.orientation * new Vec3(0., 0., -1.));
      // The worlds a picture can show: the viewer's own (a mirror's), the island's day, and the labyrinth
      imm env = new PictureEnv(new PictureWorld(light, g.renderer.exposure, !under, g.camera.far, g.renderer.environmentStrength, if under { LAB_LAYER; } else { 1u32; },
          if under { noFog; } else { dayFog; }),
        new PictureWorld(dayLight, dayExposure, true, DAY_FAR, dayEnvironment, 1u32, dayFog),
        new PictureWorld(underLight, if under { underExposure; } else { underSeenExposure; }, false, UNDER_FAR, 0., LAB_LAYER, noFog));
      drawSurfaceViews(&mut g.sys.surfaces, &mut g.renderer, &mut g.device, &g.camera, &env, &g.sys.list,
        &mut g.sys.particles, effectsOn, pictureCut, jitterX, jitterY, g.target.texture.width, g.target.texture.height);
    } else {
      g.sys.surfaces.pictures = 0u32;
    }
    g.timer.mark(6usize);
    mut encoder = g.device.createCommandEncoder();
    g.timer.stamp(&mut encoder, 0u32);
    // (Under the island the sun is not there: no cascades are drawn for it)
    imm shadowsOn = g.renderer.shadow.settings.enabled;
    if under { g.renderer.shadow.settings.enabled = false; }
    // Into the HDR frame (the size of the target), then bloomed and
    // tone-mapped into the target
    g.post.resize(&mut g.device, g.target.texture.width, g.target.texture.height);
    if g.fxTier == 0u32 {
      g.sys.motion.clear();
      imm callFrom = sdl.GetPerformanceCounter();
      g.renderer.render(&mut g.device, &mut encoder, &g.post.hdr, &g.target.depth, &g.camera, &light, &g.sys.list);
      renderCallTicks = renderCallTicks + (sdl.GetPerformanceCounter() - callFrom);
      renderCalls = renderCalls + 1u64;
      if effectsOn {
        g.sys.particles.render(&mut g.device, &mut encoder, &g.post.hdr, &g.target.depth, &g.camera);
      }
      g.timer.stamp(&mut encoder, 1u32);
      g.post.apply(&mut encoder, &g.target.texture);
    } else {
      // The passes' settings this frame: the tier's, the exposure's trim from the day clock, and the fog from
      // the weather (the froxel fog is made only while there is some: switching it makes its textures)
      mut fxs = fxBase(g.fxTier);
      fxs.exposure.compensationEv = if under { LAB_TRIM_EV; } else { autoExposureTrim(rig.sunSine(), weather.ev); };
      fxs.exposure.minEv = AUTO_EXPOSURE_MIN;
      fxs.exposure.maxEv = AUTO_EXPOSURE_MAX;
      if weather.fog > FOG_THIN and !under {
        fxs.fog.enabled = true;
        fxs.fog.density = weather.fog;
        fxs.fog.anisotropy = 0.3;
      }
      g.fx.configure(&fxs);
      // A cut (a teleport or a snap round) has no history to reproject
      imm forward = pose.orientation * new Vec3(0., 0., -1.);
      if cameraCut(g, pose.origin, forward) { g.fx.cutHistory(); }
      g.lastEye = pose.origin;
      g.lastForward = forward;
      g.haveLast = true;
      // What moved since last frame, for temporal AA
      g.fx.motion <=> g.sys.motion;
      // The paint splats, as decals over what they lie on
      if g.splatMaterial != SPLAT_NONE {
        mut sp = 0usize;
        while sp < snapshot.splats.len() {
          imm s = snapshot.splats[sp];
          mut d = Decal.at(g.splatMaterial, s.model);
          d.tint = s.tint;
          d.fade = s.fade;
          d.roughness = 0.35;
          d.maxAngle = 1.45;
          g.fx.decals.add(d);
          sp = sp + 1usize;
        }
      }
      imm callFrom = sdl.GetPerformanceCounter();
      g.fx.renderScene(&mut g.device, &mut encoder, &mut g.renderer, &mut g.post, &g.camera, &light, &g.sys.list);
      renderCallTicks = renderCallTicks + (sdl.GetPerformanceCounter() - callFrom);
      renderCalls = renderCalls + 1u64;
      // The particles, into the frame before the passes that resolve it, through the camera the scene was drawn with
      if effectsOn {
        g.sys.particles.render(&mut g.device, &mut encoder, &g.post.hdr, &g.fx.depth, &g.fx.sceneCamera);
      }
      g.timer.stamp(&mut encoder, 1u32);
      g.fx.renderFinish(&mut g.device, &mut encoder, &mut g.renderer, &mut g.post, &g.sys.list, &g.target.texture);
    }
    g.renderer.shadow.settings.enabled = shadowsOn;
    g.timer.mark(7usize);

    // The overlay, over the finished picture (after tone mapping)
    g.timer.stamp(&mut encoder, 2u32);
    if !g.offscreen { g.hud.draw(&mut g.device, &mut encoder, &g.target.texture, hud); }
    g.timer.stamp(&mut encoder, 3u32);
    g.timer.resolve(&mut encoder);

    // A scripted view to save: copied now, written once presented
    if shotsDir.len() > 0usize and shot.len > 0usize {
      imm w = g.target.texture.width;
      imm h = g.target.texture.height;
      g.readback = g.device.createBuffer(u64.from(w) * u64.from(h) * 4u64, BUFFER_USAGE_MAP_READ | BUFFER_USAGE_COPY_DST);
      encoder.copyTextureToBuffer(&g.target.texture, &g.readback);
      mut name = shotsDir.copy();
      name <- "/";
      name <- shot;
      name <- if g.offscreen { ".png"; } else { ".bmp"; };
      g.shotName = name;
      g.shotW = w;
      g.shotH = h;
      g.shotBgra = g.target.texture.format == TEXTURE_FORMAT_BGRA8_UNORM_SRGB
        or g.target.texture.format == TEXTURE_FORMAT_BGRA8_UNORM;
      g.shotPng = g.offscreen;
    }
    // (a measuring run: what the auto-exposure metered, at each scripted view)
    mut meter = Buffer.none();
    if g.fxMeter and g.fxTier != 0u32 and shot.len > 0usize {
      meter = g.device.createBuffer(16u64, BUFFER_USAGE_MAP_READ | BUFFER_USAGE_COPY_DST);
      encoder.copyBufferToBuffer(&g.post.exposureBuffer, 0u64, &meter, 0u64, 16u64);
    }
    g.device.queue.submit(encoder.finish());
    g.timer.collect(&mut g.device);
    g.timer.mark(8usize);
    if shot.len > 0usize {
      // What this view cost to draw, for comparing the culling's modes (--cull N): draw calls and triangles, then
      // the scene's items: in it, past the frustum, put to draw (a cross-fade is two), dropped by range, level switches
      imm vs = g.renderer.vis.stats;
      print <- "Draws "; printStr(shot); print <- ": calls "; print <- u64.from(g.renderer.drawCalls); print <- ", triangles ";
      print <- g.renderer.triangles; print <- "; scene items "; print <- u64.from(vs.items); print <- ", past frustum ";
      print <- u64.from(vs.candidates); print <- ", drawn "; print <- u64.from(vs.drawn); print <- ", range-culled ";
      print <- u64.from(vs.rangeCulled); print <- ", level switches "; print <- u64.from(vs.lodSwitches); print <- ", fading ";
      print <- u64.from(vs.fading); print <- "\n";
    }
    if meter.isValid() {
      g.device.waitIdle();
      imm f = meter.mappedRange() as *f32;
      print <- "Meter "; printStr(shot); print <- ": exposure "; print <- *f; print <- ", mean log2 luminance ";
      print <- *(f + 1usize); print <- ", target "; print <- *(f + 2usize); print <- ", sun sine ";
      print <- rig.sunSine(); print <- ", weather ev "; print <- weather.ev; print <- "\n";
    }
  }

  // The scripted view copied this frame, written once presented; false if it
  // could not be
  fn writeShot(self, g &mut Gfx) bool {
    if g.shotName.len() == 0usize { return true; }
    g.device.waitIdle();
    imm w = g.shotW;
    imm h = g.shotH;
    imm bgra = g.shotBgra;
    mut written = false;
    if g.shotPng {
      written = writePng(g.readback.mappedRange(), i32.from(w), i32.from(h), bgra, g.shotName.view());
    } else {
      imm img = Image.fromTexels(g.readback.mappedRange(), i32.from(w), i32.from(h), bgra);
      written = img.save(&Path.from(g.shotName.view()));
    }
    print <- "Screenshot: "; printStr(g.shotName.view());
    if g.shotPng { print <- " ("; print <- w; print <- "x"; print <- h; print <- ")"; }
    if written { print <- "\n"; } else { print <- " could NOT be written\n"; }
    g.shotName = String.empty();
    g.readback = Buffer.none();
    written;
  }
}

// THE VALIDATION LAYER. Where the Vulkan SDK is installed, Cone's gpu package turns on the Khronos validation layer with its
// synchronization checks, and they cost ~12 ms of CPU a frame here (render's recording 14.6 ms with the layer, 1.9 ms without;
// the frame 21 ms against 6 ms: measured 13 Oct on the RTX, same build, same run, only the layer differing). That, not the
// image quality, is what took the frame from 6.4 to 11.8 ms on 12 Oct. So the layer is on only where its verdict is wanted:
// in the scripted runs, which end by saying "validation messages: 0" (the tests), or when PEGASUS_VALIDATION=1; PEGASUS_VALIDATION=0
// turns it off even there. Otherwise the loader is told to leave it out (VK_LOADER_LAYERS_DISABLE) before the instance is made,
// unless the environment already set that variable itself.
fn validationPolicy(scripted bool) {
  imm e = libc.getenv("PEGASUS_VALIDATION");
  mut forcedOn = false;
  mut forcedOff = false;
  if (e as usize) != 0usize {
    forcedOn = libc.strcmp(cstr.fromPtr(e), "1") == 0i32;
    forcedOff = libc.strcmp(cstr.fromPtr(e), "0") == 0i32;
  }
  if forcedOn or (scripted and !forcedOff) { return; }
  imm result = posix.setenv("VK_LOADER_LAYERS_DISABLE", "VK_LAYER_KHRONOS_validation", 0i32);
}

// The GPU side for 'window', 'width' by 'height': the instance, the surface,
// the adapter (GPU_POWER_PREFERENCE=low-power picks the integrated GPU where
// there are two), the device, the swapchain, the renderer and its Post, the
// render system, and the sky rig's pipelines (unless 'skyOff'). None if no
// GPU can draw to the window.
fn makeGfx(window *sdl.Window, width u32, height u32, skyOff bool, cullMode u32, rig &mut SkyRig, isl &Island) Option[Gfx] {
  mut instance = Instance.create("browser");
  mut surface = instance.createSurface(window);
  mut preference = POWER_PREFERENCE_HIGH_PERFORMANCE;
  imm env = libc.getenv("GPU_POWER_PREFERENCE");
  if (env as usize) != 0usize {
    if libc.strcmp(cstr.fromPtr(env), "low-power") == 0i32 { preference = POWER_PREFERENCE_LOW_POWER; }
  }
  mut adapter = instance.requestAdapter(&surface, preference);
  if !adapter.isValid() {
    print <- "No GPU can draw to the window\n";
    return None;
  }
  print <- "Adapter: "; printStr(adapter.name.view());
  if instance.validation { print <- "; validation layer on\n"; } else { print <- "; validation layer off\n"; }
  mut device = adapter.requestDevice();
  mut swapchain = device.createSwapChain(&surface, width, height, TEXTURE_FORMAT_DEPTH32_FLOAT);
  // The scene is drawn into a half-float frame, which the Post blooms and
  // tone-maps into the swapchain's texture (lookPost says how)
  mut renderer = Renderer.create(&mut device, TEXTURE_FORMAT_RGBA16_FLOAT, TEXTURE_FORMAT_DEPTH32_FLOAT);
  // Glass by rays where the card has ray queries (the RTX), else the raster glass over the captured frame (the Intel): chosen by
  // the device's capability, the same material description either way. PEGASUS_RT=off keeps the raster glass on a card that
  // has rays, to compare the two
  mut rayWanted = true;
  imm rtEnv = libc.getenv("PEGASUS_RT");
  if (rtEnv as usize) != 0usize { rayWanted = libc.strcmp(cstr.fromPtr(rtEnv), "off") != 0i32; }
  imm rayTraced = renderer.setRayTracing(&mut device, rayWanted);
  print <- "Glass: "; print <- if rayTraced { "ray-traced"; } elif device.rayTracing { "raster (PEGASUS_RT=off)"; } else { "raster (no ray tracing on this device)"; }; print <- "\n";
  mut post = Post.create(&mut device, swapchain.format, width, height);
  lookPost(&mut post);
  // The depth kept after the scene's pass, for the particles' pass to test against
  renderer.keepDepth = true;
  // The environment the physical parts are lit by besides the sun; the sky
  // drawn stays the clear colour
  imm environment = environmentSky();
  renderer.setSky(&mut device, &environment);
  renderer.drawSky = false;
  // The shadows by the GPU's tier (shadows.cone, lightshadow.cone): the sun's at
  // high on a discrete GPU, low on an integrated one; the lanterns' at medium
  // on a discrete GPU (the nearest four of the point lights get cube maps),
  // none on an integrated one. PEGASUS_SHADOWS and PEGASUS_LIGHT_SHADOWS
  // (off, low, medium, high) override them, to measure what each costs.
  setShadowTiers(&mut renderer, &mut device, adapter.adapterType == ADAPTER_TYPE_INTEGRATED_GPU);
  mut sys = RenderSystem.make(&mut device, TEXTURE_FORMAT_RGBA16_FLOAT, cullMode);
  sys.surfaces.tier(adapter.adapterType == ADAPTER_TYPE_INTEGRATED_GPU);
  imm fxTier = fxTierFor(adapter.adapterType == ADAPTER_TYPE_INTEGRATED_GPU);
  // The pictures carry the froxel fog while image quality is on (set before any picture is made: its volumes are made with it)
  sys.surfaces.fogOn = fxTier > 0u32 and sys.surfaces.fogAllowed;
  sys.surfaces.fogBase = pictureFog(fxTier, 0.);
  mut fx = ImageFx.create(&mut device, &renderer, &mut post);
  imm fxStart = fxBase(fxTier);
  fx.configure(&fxStart);
  mut fxMeter = false;
  imm dbgEnv = libc.getenv("PEGASUS_DBG");
  if (dbgEnv as usize) != 0usize { fxMeter = libc.strcmp(cstr.fromPtr(dbgEnv), "meter") == 0i32; }
  if !renderer.isValid() or !sys.particles.isValid() or !post.isValid() {
    print <- "The renderer could not be made\n";
    return None;
  }
  if !skyOff { rig.makeGpu(&mut renderer, &mut device); }
  sys.makeWeather(&mut device);
  mut camera = Camera.make();
  camera.fov = FOV;
  camera.near = 0.1;
  camera.far = 6000.;           // the island is 1.3 km across, the sea runs to the horizon
  imm target = swapchain.getCurrentTexture(&mut device);
  imm hud = Hud.make(&mut device, window as *u8 as usize, swapchain.format, width, height, isl);
  // The decals (the paint splats of the spells) are drawn by the image quality passes: with it off they are not
  mut splatMaterial = SPLAT_NONE;
  if fxTier > 0u32 {
    imm splatTex = renderer.addTexture(&mut device, &splatImage());
    splatMaterial = fx.addDecalMaterial(&mut device, &renderer, splatTex, TextureHandle.none(), TextureHandle.none());
  }
  imm sunShadows = renderer.shadow.settings.enabled;
  imm timer = FrameTimer.make(&mut device);
  imm off = makeOffscreen(&mut device, 16u32, 16u32, swapchain.format);
  Some[Gfx](new Gfx(Buffer.none(), String.empty(), target, off, post, fx, fxTier, fxMeter, splatMaterial, new Vec3(0., 0., 0.),
    new Vec3(0., 0., -1.), false, hud, timer, sys, renderer, swapchain, device, adapter, surface, instance, camera, sunShadows,
    false, 0u32, 0u32, false, false));
}

// A frame off screen, 'width' by 'height' in the swapchain's format, with a depth texture of its size: what a gallery shot is
// drawn into (gallery.cone) and read back from
fn makeOffscreen(device &mut Device, width u32, height u32, format u32) SurfaceTexture {
  imm colorDesc = new TextureDescriptor(width, height, format, TEXTURE_USAGE_RENDER_ATTACHMENT | TEXTURE_USAGE_COPY_SRC);
  imm color = device.createTexture(&colorDesc);
  imm depthDesc = new TextureDescriptor(width, height, TEXTURE_FORMAT_DEPTH32_FLOAT, TEXTURE_USAGE_RENDER_ATTACHMENT);
  imm depth = device.createTexture(&depthDesc);
  new SurfaceTexture(color, depth, SURFACE_TEXTURE_SUCCESS_OPTIMAL);
}

// Image quality by the GPU's tier: 2 high on a discrete GPU (temporal AA, auto-exposure, ambient occlusion),
// 1 low on an integrated one (FXAA and a cheap auto-exposure); 0 off. PEGASUS_FX (off, low, medium, high)
// overrides it, to measure what it costs.
fn fxTierFor(integrated bool) u32 {
  mut tier = if integrated { 1u32; } else { 2u32; };
  imm e = libc.getenv("PEGASUS_FX");
  if (e as usize) != 0usize {
    imm t = cstr.fromPtr(e);
    if libc.strcmp(t, "off") == 0i32 { tier = 0u32; }
    elif libc.strcmp(t, "low") == 0i32 { tier = 1u32; }
    elif libc.strcmp(t, "high") == 0i32 { tier = 2u32; }
  }
  tier;
}

// The tier's settings, with the froxel fog set to reach the horizon as the slabs did and left off until
// the weather has some
fn fxBase(tier u32) FxSettings {
  mut s = if tier == 1u32 { FxSettings.low(); } else { FxSettings.high(); };
  s.fog = if tier == 1u32 { FogSettings.low(); } else { FogSettings.high(); };
  s.fog.enabled = false;
  s.fog.maxDistance = FOG_REACH;
  s.exposure.enabled = true;
  s;
}

// The froxel fog of a picture, for the weather's extinction 'density': the tier's grid, reaching the horizon, drawn while there is some
fn pictureFog(tier u32, density f32) FogSettings {
  mut f = if tier == 1u32 { FogSettings.low(); } else { FogSettings.high(); };
  f.maxDistance = FOG_REACH;
  f.anisotropy = 0.3;
  f.density = density;
  f.enabled = density > FOG_THIN;
  f;
}

// Has the camera cut since the last frame (a teleport, a snap round)? Then there is no history to reproject: the frame's, and
// the pictures' fog volumes
fn cameraCut(g &Gfx, eye Vec3, forward Vec3) bool {
  if !g.haveLast { return true; }
  imm moved = (eye - g.lastEye).length();
  moved > 3. or forward.dot(g.lastForward) < 0.9;
}

// The farthest the froxel fog reaches, metres: the slabs' (skyrig.cone's FOG_FAR)
const FOG_REACH f32 = 2400.;
// The weather's fog below this extinction is none (skyrig's FOG_MIN)
const FOG_THIN f32 = 0.00001;

// The sun's shadows and the point lights' by the tier of the GPU
fn setShadowTiers(renderer &mut Renderer, device &mut Device, integrated bool) {
  mut sun = if integrated { ShadowSettings.low(); } else { ShadowSettings.high(); };
  mut lamplit = if integrated { LightShadowSettings.off(); } else { LightShadowSettings.medium(); };
  // (the lanterns' tracery casts fine shadows: a wider filter keeps them soft)
  // and a shadow fades with its light's rank against the best light left unshadowed (four lanterns get
  // maps), so that a pool does not change as you walk
  if !integrated { lamplit.pcfTaps = 12u32; lamplit.pcfRadius = 3.5; lamplit.fade = 2.; }
  imm s = libc.getenv("PEGASUS_SHADOWS");
  if (s as usize) != 0usize {
    imm t = cstr.fromPtr(s);
    if libc.strcmp(t, "off") == 0i32 { sun = ShadowSettings.off(); }
    elif libc.strcmp(t, "low") == 0i32 { sun = ShadowSettings.low(); }
    elif libc.strcmp(t, "medium") == 0i32 { sun = ShadowSettings.medium(); }
    elif libc.strcmp(t, "high") == 0i32 { sun = ShadowSettings.high(); }
  }
  imm ls = libc.getenv("PEGASUS_LIGHT_SHADOWS");
  if (ls as usize) != 0usize {
    imm t = cstr.fromPtr(ls);
    if libc.strcmp(t, "off") == 0i32 { lamplit = LightShadowSettings.off(); }
    elif libc.strcmp(t, "low") == 0i32 { lamplit = LightShadowSettings.low(); }
    elif libc.strcmp(t, "medium") == 0i32 { lamplit = LightShadowSettings.medium(); }
    elif libc.strcmp(t, "high") == 0i32 { lamplit = LightShadowSettings.high(); }
  }
  renderer.setShadows(device, &sun);
  renderer.setLightShadows(device, &lamplit);
}

// A colour's luminance (Rec. 709 weights, linear)
fn luma(c Color) f32 { 0.2126 * c.red + 0.7152 * c.green + 0.0722 * c.blue; }
