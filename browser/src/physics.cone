// The island's bodies, in one rigid-body World that the simulation owns (rigiddynamics),
// and what the mannequins walk on.
//
// A PHYS is one World with no module globals behind it, so a server and its clients in one
// process cannot race on it: the simulation makes one (authority: it makes the ragdolls, and
// steps them), and each view makes one of its own (a read-only copy of the same statics, for
// predicting the mannequin it drives; it never makes a ragdoll, it shows the server's).
// Both are built from the same numbers, so the same step gives the same answer in both.
//
// WHAT IS IN IT
//   the ground       the island's heights as a heightfield (the island's own samples, one every
//                    CELL metres), or, before the island is baked (a unit check), a flat floor
//   the solids       worldSolids(): trunks and rocks (cylinders), the cottage, the deck, steps,
//                    parapets (boxes) and the bridge's ramps (hulls), each a static body
//   the platforms    each platform of the scene (the balloon's basket) a kinematic body of the
//                    floor and the walls, put where the scene has it each frame (syncPlatforms)
//   ragdolls         dynamic bodies of ragdollrig, made when a mannequin falls (ragdoll.cone)
//
// LAYERS. LAYER_GROUND is the heightfield, LAYER_WORLD everything else that stands still or is
// carried (solids, platforms), LAYER_RAGDOLL (ragdollrig's) the falling figures. A character
// collides with the first two and never with a ragdoll or another character.

pub const LAYER_GROUND = 4u32;
pub const LAYER_WORLD = 1u32;
pub const LAYER_WALK = 5u32;          // what a mannequin's capsule collides with
const NO_BODY = 0xffffffffu32;

// How far a mannequin on the ground may stand from the drawn ground's height, metres: the heightfield cuts each cell
// along one diagonal and the island's triangles alternate (island.cone), so on a curved patch the two surfaces differ
pub const GROUND_SLACK f32 = 0.05;
// The thickness of a platform's wall slab, outside the floor's edge (metres): a body inside meets the edge, one outside meets this beyond it
pub const PLATFORM_WALL f32 = 0.08;

// A platform's body
struct PlatBody {
  part PartId;
  body u32;
  scale f32;                          // the part's size when the shape was made
  seen bool;                          // in the last sync
}

// A seat of the world: the part that has it, humanbody's Seat (a sit point, a facing, a height, how it rocks), and whether a being has
// it (found afresh at each step of the cast)
pub struct SeatSlot {
  pub part PartId;
  pub seat humanbody.Seat;
  pub taken bool;
  pub rest Transform3;        // where the part stands when the seat is still
}

pub struct Phys {
  pub w rigiddynamics.World;
  pub authority bool;                 // the simulation's: it makes the ragdolls
  groundMade bool;
  groundBody u32;
  solidBodies List[u32];
  plats List[PlatBody];
  pub rigs List[RigSlot];             // the ragdolls (ragdoll.cone)
  pub steps u64;                      // worlds stepped
  solidList List[Solid];              // the numbers the solid bodies were made from, and the platforms as last synced,
  platsNow List[PlatformNow];         // for the gait's foot query (floorAt)
  pub island Island;                  // the ground this world stands on (its own owner of the shared island); an empty one is a flat floor
  pub portals Portals;                // the gates a being crosses by (portal.cone), and whether the looking-glass is open
  houseAt usize;                      // the cottage's main block among the solids, if there is one: the wall the looking-glass is in
  notched bool;                       // the glass is open and its notch is cut in that wall
  glassBodies List[u32];              // the three boxes the wall is in while it is notched
  pub seats List[SeatSlot];           // the world's seats: data on parts (a chair, a throne, a parapet), in the order the world sent them

  pub fn make(authority bool, island Island) Phys {
    var w = rigiddynamics.World.make();
    ragdollrig.tuneWorld(&mut w);
    new Phys(w, authority, false, NO_BODY, List[u32].empty(), List[PlatBody].empty(), List[RigSlot].empty(), 0u64,
      List[Solid].empty(), List[PlatformNow].empty(), island, Portals.none(), NO_ROW, false, List[u32].empty(), List[SeatSlot].empty())
  }

  // A seat the world sent (Request.Seat): part 'part' has it, at 'point' (the sit point: where the sitting bones rest, on the seat's
  // surface), the sitter facing 'yaw', the surface 'height' above the floor the feet are on, and moving by 'rock' radians each way
  // with a period of 'period' seconds (a rocking chair; 0: still). Its row is its number (BeingState.seat is it plus one)
  pub fn addSeat(self &mut, part PartId, point Vec3, yaw f32, height f32, rock f32, period f32, rest Transform3) {
    seats.push(new SeatSlot(part, humanbody.Seat.chair(point, yaw, height), false, rest));
    let s = &mut seats[seats.len() - 1usize];
    s.seat.rock = rock;
    s.seat.period = if period > 0.1 { period } else { 1. };
  }

  // The free seat whose standing place (humanbody's seatFeet for the skeleton 'skel') is nearest 'pos' and within SEAT_REACH of it
  // and about a step's height of it, or -1
  pub fn seatNear(self &, pos Vec3, skel &bonepose.Skeleton) i32 {
    var best = -1i32;
    var bestD = SEAT_REACH;
    var i = 0usize;
    while i < seats.len() {
      let s = seats[i];
      if !s.taken {
        let feet = humanbody.seatFeet(&s.seat, skel);
        let dx = feet.x - pos.x;
        let dz = feet.z - pos.z;
        let d = libc.sqrtf(dx * dx + dz * dz);
        let dy = feet.y - pos.y;
        // (a seat the feet would have to climb more than a step to is not one a walk gets to; one a little lower is)
        if d < bestD and dy < STEP_UP + 0.05 and dy > -0.75 {
          bestD = d;
          best = i32.from(i);
        }
      }
      i = i + 1usize;
    }
    best
  }

  // Seat 'i' taken by a being (until the cast's next step finds who is on which seat)
  pub fn takeSeat(self &mut, i usize) {
    if i < seats.len() { seats[i].taken = true; }
  }

  // The ground made (once): the island's heights, or a flat floor if the island is not baked
  pub fn ensureGround(self &mut) {
    if groundMade { return; }
    groundMade = true;
    var heights = heightGrid(&island);
    // (the gates are made for the ground at the cottage, once there is one; the glass keeps its state)
    let wasOpen = portals.open;
    portals = Portals.make(if heights.len() > 0usize { groundHeight(&island, COTTAGE_X, COTTAGE_Z) } else { 0. },
      if heights.len() > 0usize { groundHeight(&island, SPRING_X, SPRING_Z) } else { 0. });
    portals.open = wasOpen;
    if heights.len() > 0usize {
      let prim = rigidcollide.Prim.heightfield(heights, u32.from(N), u32.from(N), CELL, CELL, new Vec3(0. - HALF, 0., 0. - HALF));
      let shape = w.addShape(rigidcollide.Shape.single(prim));
      var def = rigiddynamics.BodyDef.staticAt(shape, new Vec3(0., 0., 0.));
      def.layer = LAYER_GROUND;
      groundBody = w.createBody(def);
    } else {
      let shape = w.addShape(rigidcollide.Shape.single(rigidcollide.Prim.box(new Vec3(4000., 5., 4000.))));
      var def = rigiddynamics.BodyDef.staticAt(shape, new Vec3(0., -5., 0.));
      def.layer = LAYER_GROUND;
      groundBody = w.createBody(def);
    }
  }

  // The static solids replaced by 'list': a cylinder for a circle, a box, or a hull for a sloped top
  pub fn setSolids(self &mut, list &List[Solid]) {
    if notched { self.closeNotch(); }
    var i = 0usize;
    while i < solidBodies.len() { let id = *solidBodies[i]; w.destroyBody(id); i = i + 1usize; }
    solidBodies.clear();
    solidList.clear();
    i = 0usize;
    while i < list.len() { solidList.push(*list[i]); i = i + 1usize; }
    i = 0usize;
    while i < list.len() {
      let s = *list[i];
      let cy = (s.y0 + s.y1) * 0.5;
      if s.kind == SOLID_CIRCLE {
        let half = atLeast((s.y1 - s.y0) * 0.5, 0.01);
        let shape = w.addShape(rigidcollide.Shape.single(rigidcollide.Prim.cylinder(s.x1, half)));
        var def = rigiddynamics.BodyDef.staticAt(shape, new Vec3(s.x0, cy, s.z0));
        def.layer = LAYER_WORLD;
        solidBodies.push(w.createBody(def));
      } elif s.axis == 0u32 {
        let half = new Vec3((s.x1 - s.x0) * 0.5, atLeast((s.y1 - s.y0) * 0.5, 0.01), (s.z1 - s.z0) * 0.5);
        let shape = w.addShape(rigidcollide.Shape.single(rigidcollide.Prim.box(half)));
        var def = rigiddynamics.BodyDef.staticAt(shape, new Vec3((s.x0 + s.x1) * 0.5, cy, (s.z0 + s.z1) * 0.5));
        def.layer = LAYER_WORLD;
        solidBodies.push(w.createBody(def));
      } else {
        // A ramp: the bottom flat, the top a line from y1 to y2 along x (axis 1) or z (axis 2)
        let ax = s.axis == 1u32;
        let ta = s.y1;
        let tb = s.y2;
        let pts = [new Vec3(s.x0, s.y0, s.z0), new Vec3(s.x1, s.y0, s.z0), new Vec3(s.x0, s.y0, s.z1), new Vec3(s.x1, s.y0, s.z1),
          new Vec3(s.x0, if ax { ta } else { ta }, s.z0), new Vec3(s.x1, if ax { tb } else { ta }, s.z0),
          new Vec3(s.x0, if ax { ta } else { tb }, s.z1), new Vec3(s.x1, if ax { tb } else { tb }, s.z1)];
        let hull = rigidcollide.convexHull(&pts);
        let shape = w.addShape(rigidcollide.Shape.single(hull));
        var def = rigiddynamics.BodyDef.staticAt(shape, new Vec3(0., 0., 0.));
        def.layer = LAYER_WORLD;
        solidBodies.push(w.createBody(def));
      }
      i = i + 1usize;
    }
    // The cottage's main block, the wall the looking-glass is in (portal.cone); if the glass is open already, notched
    houseAt = NO_ROW;
    notched = false;
    glassBodies.clear();
    i = 0usize;
    while i < solidList.len() and houseAt == NO_ROW {
      let s = solidList[i];
      if s.kind == SOLID_BOX and s.axis == 0u32 and libc.fabsf(s.z0 - (GLASS_Z + 0.034)) < 0.01 and s.x0 < GLASS_X - NOTCH_HALF
        and s.x1 > GLASS_X + NOTCH_HALF and s.y1 - s.y0 > 6. {
        houseAt = i;
      }
      i = i + 1usize;
    }
    if portals.open { self.cutNotch(); }
  }

  // More solids, boxes (the labyrinth's rooms: portal stub, rooms), added to those set; their tops are walkable as any box's
  pub fn addSolids(self &mut, list &List[Solid]) {
    var i = 0usize;
    while i < list.len() {
      let s = *list[i];
      solidList.push(s);
      solidBodies.push(self.boxBody(s.x0, s.z0, s.x1, s.z1, s.y0, s.y1));
      i = i + 1usize;
    }
  }

  // A static box body over x0..x1, z0..z1, y0..y1
  fn boxBody(self &mut, x0 f32, z0 f32, x1 f32, z1 f32, y0 f32, y1 f32) u32 {
    let half = new Vec3((x1 - x0) * 0.5, atLeast((y1 - y0) * 0.5, 0.01), (z1 - z0) * 0.5);
    let shape = w.addShape(rigidcollide.Shape.single(rigidcollide.Prim.box(half)));
    var def = rigiddynamics.BodyDef.staticAt(shape, new Vec3((x0 + x1) * 0.5, (y0 + y1) * 0.5, (z0 + z1) * 0.5));
    def.layer = LAYER_WORLD;
    w.createBody(def)
  }

  // The looking-glass opened or closed: its gates work, and the cottage's back wall has a notch where the pane is (so that a body
  // can reach the pane and be moved through it), or is whole again
  pub fn setGlassOpen(self &mut, open bool) {
    portals.open = open;
    if open == notched or houseAt == NO_ROW { return; }
    if open { self.cutNotch(); } else { self.closeNotch(); }
  }

  fn cutNotch(self &mut) {
    if houseAt == NO_ROW or notched { return; }
    let s = solidList[houseAt];
    w.destroyBody(*solidBodies[houseAt]);
    glassBodies.clear();
    glassBodies.push(self.boxBody(s.x0, s.z0, GLASS_X - NOTCH_HALF, s.z1, s.y0, s.y1));
    glassBodies.push(self.boxBody(GLASS_X + NOTCH_HALF, s.z0, s.x1, s.z1, s.y0, s.y1));
    glassBodies.push(self.boxBody(GLASS_X - NOTCH_HALF, s.z0 + NOTCH_DEPTH, GLASS_X + NOTCH_HALF, s.z1, s.y0, s.y1));
    notched = true;
  }

  fn closeNotch(self &mut) {
    if houseAt == NO_ROW or !notched { return; }
    var i = 0usize;
    while i < glassBodies.len() { let id = *glassBodies[i]; w.destroyBody(id); i = i + 1usize; }
    glassBodies.clear();
    let s = solidList[houseAt];
    solidBodies.set(houseAt, self.boxBody(s.x0, s.z0, s.x1, s.z1, s.y0, s.y1));
    notched = false;
  }

  // ---- platforms ----

  // The platforms as the scene has them now: a body for each (made when first seen, its shape
  // the floor and the walls in the part's own frame at the part's size), put where the part is;
  // a platform that has gone loses its body. The carrying of what stands on one is
  // support.cone's, so the bodies are placed, not moved by a velocity.
  pub fn syncPlatforms(self &mut, list &List[PlatformNow]) {
    platsNow.clear();
    var i = 0usize;
    while i < list.len() { platsNow.push(*list[i]); i = i + 1usize; }
    i = 0usize;
    while i < plats.len() { plats.set(i, withSeen(*plats[i], false)); i = i + 1usize; }
    i = 0usize;
    while i < list.len() {
      let p = *list[i];
      let k = frameScale(&p);
      var at = NO_ROW;
      var j = 0usize;
      while j < plats.len() { if plats[j].part == p.id { at = j; } j = j + 1usize; }
      if at != NO_ROW and libc.fabsf(plats[at].scale - k) > 0.0001 {
        w.destroyBody(plats[at].body);
        plats.swap(at, plats.len() - 1usize);
        plats.pop();
        at = NO_ROW;
      }
      let at0 = p.world * new Vec3(0., 0., 0.);
      let yaw = libc.atan2f(p.world.m[8], p.world.m[10]);
      let rot = Quat.angleAxis(yaw, new Vec3(0., 1., 0.));
      if at == NO_ROW {
        let shape = w.addShape(platformShape(&p.shape, k));
        var def = rigiddynamics.BodyDef.kinematicAt(shape, at0);
        def.rot = rot;
        def.layer = LAYER_WORLD;
        plats.push(new PlatBody(p.id, w.createBody(def), k, true));
      } else {
        w.setTransform(plats[at].body, at0, rot);
        plats.set(at, withSeen(*plats[at], true));
      }
      i = i + 1usize;
    }
    // Gone
    i = 0usize;
    while i < plats.len() {
      if !plats[i].seen {
        w.destroyBody(plats[i].body);
        plats.swap(i, plats.len() - 1usize);
        plats.pop();
      } else {
        i = i + 1usize;
      }
    }
  }

  // The platform part a body is (none: not a platform's)
  pub fn partOf(self &, body u32) PartId {
    var i = 0usize;
    while i < plats.len() {
      if plats[i].body == body { return plats[i].part; }
      i = i + 1usize;
    }
    PartId.none()
  }

  // ---- ragdolls ----

  // The world stepped once for the ragdolls that are loose, each with its passes around the step (ragdollrig's
  // prepareStep and endStep); nothing happens, and nothing is spent, when there are none
  pub fn stepRagdolls(self &mut, dt f32, propsAwake bool) {
    var any = propsAwake;
    var i = 0usize;
    while i < rigs.len() {
      if rigs[i].active {
        let s = &mut rigs[i];
        ragdollrig.prepareStep(&mut s.rig, &mut w, dt);
        any = true;
      }
      i = i + 1usize;
    }
    if !any { return; }
    w.step(dt);
    steps = steps + 1u64;
    let events = w.takeEvents();
    i = 0usize;
    while i < rigs.len() {
      if rigs[i].active {
        let s = &mut rigs[i];
        ragdollrig.endStep(&mut s.rig, &w, &events, dt);
      }
      i = i + 1usize;
    }
  }

  // ---- what a foot stands on ----

  // Whether the line from 'from' to 'to' meets none of the world's statics (the ground, the solids, the platforms): a ray (the standard
  // line-of-sight test) cast through this world, stopping 0.3 m short of 'to' so that a surface a point sits against does not hide it.
  // A name plate uses it: hud.cone fades a plate whose line from the eye is blocked.
  pub fn lineClear(self &mut, from Vec3, to Vec3) bool {
    let d = to - from;
    let dist = d.length();
    if dist < 0.6 { return true; }
    self.ensureGround();
    let h = w.castRay(from, d * (1. / dist), dist - 0.3, rigiddynamics.QueryFilter.layers(LAYER_GROUND | LAYER_WORLD));
    !h.hit
  }

  // The third-person camera's clamp: a sphere of 'radius' swept from the head 'from' towards the camera's wanted place 'to'
  // (sphere cast, the standard spring-arm test: Unreal's SpringArm and Unity's Cinemachine collider do the same); where it meets the
  // ground, a solid or a platform, the camera is put where the sphere stopped, else at 'to'. A swept body that starts touching
  // something is ignored by the query unless the sweep goes into it, so a head against a wall does not pin the camera on the head.
  pub fn clampCamera(self &mut, from Vec3, to Vec3, radius f32) Vec3 {
    let disp = to - from;
    if disp.length() < 0.01 { return to; }
    self.ensureGround();
    let ball = rigidcollide.Shape.single(rigidcollide.Prim.sphere(radius));
    let hit = w.castShape(&ball, rigidcollide.Rigid.at(from), disp, rigiddynamics.QueryFilter.layers(LAYER_GROUND | LAYER_WORLD));
    if !hit.hit { return to; }
    from + disp * hit.fraction
  }

  // The height of the highest support under (x, z) for feet at 'from': the ground, or the top of a
  // solid or a platform's floor that is no higher than a step above the feet. This is the gait's question
  // (where does this foot go down), asked through walkgait's plain-function hook, which cannot change the
  // world; so it reads the numbers the bodies were made from (the solids, the platforms as last synced),
  // not the World, and the ground as the island draws it (the feet meet the picture).
  pub fn floorAt(self &, x f32, z f32, from f32) f32 {
    // (under the island the ground is 300 m overhead and only the labyrinth's own floors, and the void under them)
    var top = if underground(from) { LAB_VOID } else { groundHeight(&island, x, z) };
    let reach = from + STEP_UP;
    var i = 0usize;
    while i < platsNow.len() {
      let p = *platsNow[i];
      let there = p.inverse * new Vec3(x, from, z);
      if p.shape.over(there.x, there.z) {
        let floor = (p.world * new Vec3(there.x, p.shape.floorY, there.z)).y;
        if floor <= reach and floor > top { top = floor; }
      }
      i = i + 1usize;
    }
    i = 0usize;
    while i < solidList.len() {
      let so = solidList[i];
      if so.over(x, z) {
        let t = so.topAt(x, z);
        if t > top and t <= reach { top = t; }
      }
      i = i + 1usize;
    }
    top
  }
}

fn atLeast(v f32, lo f32) f32 { if v < lo { lo } else { v } }

fn withSeen(p PlatBody, seen bool) PlatBody { new PlatBody(p.part, p.body, p.scale, seen) }

// Platforms are taken as level and scaled alike every way: a world length in the part's frame is the world
// length times this
fn frameScale(p &PlatformNow) f32 {
  let c = p.inverse.transformVector(new Vec3(1., 0., 0.));
  1. / c.length()
}

// A platform's shape as one compound of boxes in the part's frame at its size 'k': the floor, a slab under
// its top; and, on each edge that has a wall, a slab outside the edge (its inner face on the edge) from the
// floor to the wall's height
fn platformShape(sh &PlatformShape, k f32) rigidcollide.Shape {
  var out = rigidcollide.Shape.compound();
  let thick = 0.25f;
  let x0 = sh.min.x * k;
  let x1 = sh.max.x * k;
  let z0 = sh.min.y * k;
  let z1 = sh.max.y * k;
  let top = sh.floorY * k;
  out.add(rigidcollide.Prim.box(new Vec3((x1 - x0) * 0.5, thick * 0.5, (z1 - z0) * 0.5)),
    rigidcollide.Rigid.at(new Vec3((x0 + x1) * 0.5, top - thick * 0.5, (z0 + z1) * 0.5)));
  let wh = atLeast(sh.wallHeight * k, 0.05);
  let wt = PLATFORM_WALL;
  if (sh.walls & WALL_MIN_X) != 0u32 {
    out.add(rigidcollide.Prim.box(new Vec3(wt * 0.5, wh * 0.5, (z1 - z0) * 0.5 + wt)),
      rigidcollide.Rigid.at(new Vec3(x0 - wt * 0.5, top + wh * 0.5, (z0 + z1) * 0.5)));
  }
  if (sh.walls & WALL_MAX_X) != 0u32 {
    out.add(rigidcollide.Prim.box(new Vec3(wt * 0.5, wh * 0.5, (z1 - z0) * 0.5 + wt)),
      rigidcollide.Rigid.at(new Vec3(x1 + wt * 0.5, top + wh * 0.5, (z0 + z1) * 0.5)));
  }
  if (sh.walls & WALL_MIN_Z) != 0u32 {
    out.add(rigidcollide.Prim.box(new Vec3((x1 - x0) * 0.5 + wt, wh * 0.5, wt * 0.5)),
      rigidcollide.Rigid.at(new Vec3((x0 + x1) * 0.5, top + wh * 0.5, z0 - wt * 0.5)));
  }
  if (sh.walls & WALL_MAX_Z) != 0u32 {
    out.add(rigidcollide.Prim.box(new Vec3((x1 - x0) * 0.5 + wt, wh * 0.5, wt * 0.5)),
      rigidcollide.Rigid.at(new Vec3((x0 + x1) * 0.5, top + wh * 0.5, z1 + wt * 0.5)));
  }
  out
}
