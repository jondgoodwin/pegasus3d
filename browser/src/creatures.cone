// The labyrinth's creatures: the two guards of the Hall of Two Doors and the lie/truth puzzle they pose, the Worm behind the wrong door,
// and the Minotaur of the Bull Court. The simulation's part (the truth; a view only draws and listens, shared-island.md); creatureview.cone
// is the view's, creaturelook.cone how they look, talkpanel.cone the dialogue's buttons.
//
// WHAT THEY ARE IN THE SCENE. The guards and the Minotaur are beings of the cast like a villager (npcs.cone): a mannequin each, walked by the
// character controller and posed by walkgait, whose intents are decided here; they cross in the snapshot like every being, and a view
// draws them from the Object (spawnCreature, creaturelook.cone) that names their look. The Worm is not a being: it is a closed-form wriggle
// the view draws from one fact the simulation tells (it is up, since tick T).
//
// THE PUZZLE (Labyrinth, the film's two guards). The Hall of Two Doors has a guard on a plinth beside each door; the west door leads to the
// Worm's chamber, the east to the corridor. One guard always lies and one always tells the truth, and WHICH is drawn at random for each run, here
// (CreatureSim.liar). A visitor walks up, presses E, and may ask ONE question (the buttons of talkpanel.cone); the guard answers by the rule
// of its kind, computed below by the same logic whoever asks (answerCode). Of the four questions only "Which door would your fellow name?" always
// leads right: take the other door than the one named. The rest are traps or half-answers, as in the film:
//   Which door leads to the middle?          the honest guard names the east door, the liar the west: a visitor who does not know which is
//                                            which learns nothing;
//   Which door would your fellow name?       both name the WEST door (the honest one reports the liar's lie, the liar lies about the truth);
//   Do you always tell the truth?            both say yes;
//   Does the door beside you lead there?     the honest guard says what is so, the liar the opposite: again it depends on who is who.
// One question to a visitor, kept until it leaves the labyrinth (a visitor who comes back from the Worm may not ask again, but needs not).
//
// THE WORM. A visitor who walks into the Worm's chamber makes the Worm rise from the floor; it chats (four lines on a timeline) and tells
// him the other way would have taken him straight to the middle. It sinks when the chamber has been empty for six seconds, and rises again for
// the next visitor.
//
// THE MINOTAUR (npcbehave's path following on labnav.cone's mesh, a state machine of its own):
//   PATROL    walks a round of four places before the east door, pausing at each, along routes round the pillars;
//   WINDUP    it has been roused: it turns to face its target, pawing (the telegraph), a second or more;
//   CHARGE    it runs straight at the target's place. It is roused by paint (the playground's F1) splattered anywhere in the court: it charges the
//             splat; one splattered on the Minotaur itself makes it charge the one who threw it; and by any visitor within 14 m of it
//             that it has not been outwitted by. A charge that runs into something (a pillar in the way, a wall) STAGGERS it; one that gets to its
//             target pulls up;
//   STAGGER   FX_STAGGER on the being (spells.cone's pose), held for 7 seconds, in which it notices nobody: the way to the east door is open;
//   RECOVER   a pause, then the patrol again.
//   It never hurts. If it reaches a visitor it SHOVES them to the court's west side (a forced move of about a second and a half).
//   THE BULL-LEAP: a visitor whose jump comes while the charging Minotaur is 1.2 to 4.5 m from them, and heading for them, is VAULTED over it:
//   a forced move (below) that lands them 3 m beyond it. The Minotaur has then been outwitted by that visitor for as long as they stay
//   underground: it notices them no more, and the east door counts as passed.
//
// A FORCED MOVE is how the vault and the shove carry a being: not physics, a scripted arc. Each step the being's feet are put on a curve from
// where it was to where it lands (a parabola in height, an apex over the horns) and its intents are none; the figure is held airborne and given
// no vertical speed (so the fall that would make a ragdoll of it does not), then set on the floor at the end. The simulation's alone: the
// predicting client takes the exact state of its own being each snapshot (the playHold of a zap is the same arrangement) and a few ticks
// of its replay is the difference.

// ---- roles, messages, questions ----

pub const CR_GUARD_W = 0u32;       // beside the west door (the Worm's)
pub const CR_GUARD_E = 1u32;       // beside the east door (the corridor)
pub const CR_MINOTAUR = 2u32;
pub const CR_NONE = 0xFFFFFFFFu32;

// What ToView.Creature says (kind): its 'a', 'b', 'position' and 'extra'
pub const CM_ROSTER = 1u32;        // being a is a creature of role b
pub const CM_SAID = 2u32;          // guard a answered being b's question: line code 'extra'
pub const CM_WORM = 3u32;          // the Worm is up (a = 1) or sinks (a = 0), at tick 'extra'
pub const CM_WORM_SAYS = 4u32;     // the Worm's line a, at tick 'extra'
pub const CM_BULL = 5u32;          // the Minotaur's BE_ event a, involving being b, at 'position', tick 'extra'

pub const BE_WINDUP = 1u32;        // roused: turning to face its target
pub const BE_CHARGE = 2u32;
pub const BE_HIT = 3u32;           // ran into something: it staggers
pub const BE_PULLUP = 4u32;        // reached its target
pub const BE_SHOVE = 5u32;         // reached a visitor: they are shoved to the west side
pub const BE_LEAP = 6u32;          // a visitor vaulted over it
pub const BE_STAND = 7u32;         // got over a stagger

// The doors, by their guard: guard g stands beside door g
pub const DOOR_WEST = 0u32;
pub const DOOR_EAST = 1u32;

// The questions (Play.spell of a PLAY_TALK)
pub const Q_NONE = 0u32;
pub const Q_MIDDLE = 1u32;
pub const Q_OTHER = 2u32;
pub const Q_HONEST = 3u32;
pub const Q_MINE = 4u32;

// The kinds of answer; a line code is the question times 16 plus the kind
pub const A_MINE_DOOR = 1u32;      // names the door beside the one who speaks
pub const A_FELLOW_DOOR = 2u32;    // names the door beside the other guard
pub const A_YES = 3u32;
pub const A_NO = 4u32;
pub const A_ASKED = 5u32;          // "You have had your question."

// Where the guards stand and how near a visitor must be to be spoken to
pub const TALK_RANGE f32 = 4.;

// ---- the puzzle's logic (pure: the checks test it) ----

// Whether guard 'g' tells the truth when guard 'liar' is the one who lies
pub fn guardHonest(g u32, liar u32) bool { g != liar }

// The door guard 'g' names for "Which door leads to the middle?": the true one (the east door) if honest, the other if it lies
pub fn doorNamedBy(g u32, liar u32) u32 { if guardHonest(g, liar) { DOOR_EAST } else { DOOR_WEST }; }

// The line code of an answer that names door 'door' to question 'q' from guard 'g'
fn doorLine(q u32, g u32, door u32) u32 { q * 16u32 + (if door == g { A_MINE_DOOR } else { A_FELLOW_DOOR }) }

// The line code of guard 'g''s answer to question 'q', when guard 'liar' lies
pub fn answerCode(q u32, g u32, liar u32) u32 {
  if q == Q_MIDDLE { return doorLine(q, g, doorNamedBy(g, liar)); }
  if q == Q_OTHER {
    // what the other would name, as this one reports it: faithfully, or the other door
    let other = 1u32 - g;
    let named = doorNamedBy(other, liar);
    let said = if guardHonest(g, liar) { named } else { 1u32 - named };
    return doorLine(q, g, said);
  }
  if q == Q_HONEST {
    // the honest one says yes because it is so, the liar because it is not
    return q * 16u32 + A_YES;
  }
  if q == Q_MINE {
    // the door beside guard g is the true one if g stands by the east door
    let truth = g == DOOR_EAST;
    let said = if guardHonest(g, liar) { truth } else { !truth };
    return q * 16u32 + (if said { A_YES } else { A_NO });
  }
  0u32
}

// The door a visitor should take after hearing line code 'code' from guard 'g', if the line is of a kind that settles it (the fellow's
// question: take the one not named); else CR_NONE
pub fn doorToTake(code u32, g u32) u32 {
  let q = code / 16u32;
  let a = code % 16u32;
  if q != Q_OTHER { return CR_NONE; }
  let named = if a == A_MINE_DOOR { g } else { 1u32 - g };
  1u32 - named
}

// ---- the words ----

// What a guard says for line code 'code', short enough for a name plate
pub fn guardSays(code u32) String {
  let q = code / 16u32;
  let a = code % 16u32;
  if a == A_ASKED { return String.from("You have had your question."); }
  if q == Q_MIDDLE { return String.from(if a == A_MINE_DOOR { "The door beside me." } else { "The door beside my fellow." }); }
  if q == Q_OTHER { return String.from(if a == A_MINE_DOOR { "He would say: the door beside me." } else { "He would say: the door beside him." }); }
  if q == Q_HONEST { return String.from("Yes. I always tell the truth."); }
  if q == Q_MINE { return String.from(if a == A_YES { "Yes. My door leads there." } else { "No. My door does not lead there." }); }
  String.from("...")
}

// The question as the button reads
pub fn questionText(q u32) String {
  if q == Q_MIDDLE { return String.from("Which door leads to the middle?"); }
  if q == Q_OTHER { return String.from("Which door would your fellow name?"); }
  if q == Q_HONEST { return String.from("Do you always tell the truth?"); }
  String.from("Does the door beside you lead there?")
}

// The Worm's lines, and the ticks after it rises at which it says them
pub const WORM_LINES = 4u32;
pub fn wormSays(k u32) String {
  if k == 1u32 { return String.from("Oh! A visitor! Hello, hello!"); }
  if k == 2u32 { return String.from("You chose this door? Lovely. And wrong."); }
  if k == 3u32 { return String.from("The other way went straight to the middle."); }
  String.from("Well, off you go. Mind the guards.")
}
pub fn wormLineAt(k u32) u64 {
  if k == 1u32 { return 45u64; }
  if k == 2u32 { return 200u64; }
  if k == 3u32 { return 370u64; }
  560u64
}

// ---- where ----

// The Worm's place (the middle of its chamber, a little before the middle), facing the door
pub const WORM_X f32 = LAB_WORM_X;
pub const WORM_Z f32 = 349.;
// The chamber (walking in makes it rise), and how many ticks empty before it sinks
pub const WORM_ROOM_X0 f32 = -13.5;
pub const WORM_ROOM_X1 f32 = -2.5;
pub const WORM_ROOM_Z0 f32 = 342.6;
pub const WORM_ROOM_Z1 f32 = 357.5;
pub const WORM_SINK_TICKS = 360u64;

// The Minotaur's size, speeds and the like
pub const BULL_HEIGHT f32 = 2.4;
pub const BULL_PATROL_SPEED f32 = 1.5;
pub const BULL_ACCEL f32 = 3.;
pub const BULL_NOTICE f32 = 14.;            // a visitor this near that it has not been outwitted by rouses it
pub const BULL_TURN_EXTRA f32 = 1.4;        // radians a second more than a figure's own turn: a bull wheels faster than a man
pub const BULL_WINDUP_MIN = 66u64;          // ticks pawing the ground at least
pub const BULL_CHARGE_MAX = 420u64;         // a charge that has run this long without end pulls up
pub const BULL_COOL = 240u64;               // ticks after a charge before it notices anyone again
pub const BULL_STAGGER_TICKS = 420u64;      // 7 s
pub const BULL_RECOVER_TICKS = 90u64;
pub const SHOVE_RADIUS f32 = 1.15;
pub const LEAP_NEAR f32 = 1.2;
pub const LEAP_FAR f32 = 4.5;
pub const LEAP_TICKS = 78u32;               // the vault lasts 1.3 s
pub const LEAP_APEX f32 = 3.1;              // over the horns
pub const LEAP_LAND f32 = 3.;               // the landing, beyond the Minotaur
pub const SHOVE_TICKS = 84u32;
pub const SHOVE_APEX f32 = 0.7;
// The court's walls (for the vault's landing) and the west side a shove sends to
pub const COURT_X0 f32 = -18.5;
pub const COURT_X1 f32 = 38.5;
pub const COURT_Z0 f32 = 374.5;
pub const COURT_Z1 f32 = 431.5;
pub const SHOVE_X f32 = -14.;

// The Minotaur's modes
pub const BM_PATROL = 0u32;
pub const BM_WINDUP = 1u32;
pub const BM_CHARGE = 2u32;
pub const BM_STAGGER = 3u32;
pub const BM_RECOVER = 4u32;

// A forced move's kinds
pub const FM_VAULT = 1u32;
pub const FM_SHOVE = 2u32;

// ---- the simulation's state ----

// What the simulation tells of the creatures, as a value of its own (it keeps the messages it is to tell in a list of these)
pub struct CreatureInfo {
  pub kind u32;
  pub a u32;
  pub b u32;
  pub position Vec3;
  pub extra u32;
}

// A splat of paint, as the Minotaur hears of it: where it is (the world's), who threw it, and the being it struck (NO_ROW: a surface)
pub struct SplatNote {
  pub caster usize;
  pub point Vec3;
  pub onBeing usize;
}

// A being carried along a scripted curve
pub struct Forced {
  pub being usize;
  pub from Vec3;
  pub to Vec3;
  pub start u64;
  pub ticks u32;
  pub apex f32;
  pub kind u32;
}

pub struct CreatureSim {
  pub on bool;                 // the creatures have been made
  pub liar u32;                // which guard lies: 0 the west, 1 the east
  pub guards List[usize];      // the cast index of each guard
  pub bull usize;              // the Minotaur's, or NO_ROW
  pub asked List[usize];       // the beings that have had their question
  pub passed List[usize];      // the beings the Minotaur has been outwitted by
  pub out List[CreatureInfo];  // to tell every view
  // the Worm
  pub wormUp bool;
  pub wormSince u64;
  pub wormSaid u32;
  pub wormEmpty u64;           // ticks the chamber has been empty
  // the Minotaur
  pub nav NavWorld;
  pub mode u32;
  pub modeSince u64;
  pub target Vec2;
  pub targetBeing usize;       // the being it is charging, or NO_ROW for a place
  pub patrolK usize;
  pub dwell f32;
  pub path List[Vec2];
  pub havePath bool;
  pub follower npcbehave.PathFollower;
  pub body npcbehave.Body2;
  pub cool u64;                // before this tick it notices nobody
  pub low u32;                 // steps of a charge walking slower than it ran
  pub lastPos Vec2;
  pub moves List[Forced];
  // what happened, for the checks and the report
  pub said u32;
  pub charges u32;
  pub hits u32;
  pub pullups u32;
  pub shoves u32;
  pub leaps u32;
  pub wormRises u32;
  pub wormTalks u32;
  pub winds u32;
  pub mark u64;                // a count a script keeps

  pub fn make() CreatureSim {
    new CreatureSim(false, 0u32, List[usize].empty(), NO_ROW, List[usize].empty(), List[usize].empty(), List[CreatureInfo].empty(),
      false, 0u64, 0u32, 0u64, NavWorld.empty(), BM_PATROL, 0u64, new Vec2(0., 0.), NO_ROW, 0usize, 0., List[Vec2].empty(), false,
      npcbehave.PathFollower.make(), npcbehave.Body2.make(new Vec2(0., 0.), 0.4, BULL_PATROL_SPEED, BULL_ACCEL), 0u64, 0u32,
      new Vec2(0., 0.), List[Forced].empty(), 0u32, 0u32, 0u32, 0u32, 0u32, 0u32, 0u32, 0u32, 0u32, 0u64)
  }

  fn tell(self &mut, kind u32, a u32, b u32, position Vec3, extra u32) {
    out.push(new CreatureInfo(kind, a, b, position, extra));
  }

  // The roster, for a view that has just joined (and when the creatures are made): which being is which creature; the Worm if it is up
  pub fn replay(self &, dest &mut List[CreatureInfo]) {
    if !on { return; }
    var g = 0usize;
    while g < guards.len() {
      dest.push(new CreatureInfo(CM_ROSTER, u32.from(*guards[g]), u32.from(g), new Vec3(0., 0., 0.), 0u32));
      g = g + 1usize;
    }
    if bull != NO_ROW { dest.push(new CreatureInfo(CM_ROSTER, u32.from(bull), CR_MINOTAUR, new Vec3(0., 0., 0.), 0u32)); }
    if wormUp { dest.push(new CreatureInfo(CM_WORM, 1u32, 0u32, new Vec3(0., 0., 0.), u32.from(wormSince & 0xFFFFFFFFu64))); }
  }

  pub fn hasAsked(self &, being usize) bool {
    var i = 0usize;
    while i < asked.len() { if *asked[i] == being { return true; } i = i + 1usize; }
    false
  }

  pub fn hasPassed(self &, being usize) bool {
    var i = 0usize;
    while i < passed.len() { if *passed[i] == being { return true; } i = i + 1usize; }
    false
  }

  pub fn forcedOf(self &, being usize) bool {
    var i = 0usize;
    while i < moves.len() { if moves[i].being == being { return true; } i = i + 1usize; }
    false
  }

  // The creatures made: the guards (cast indices), the Minotaur (or NO_ROW); the navigation mesh built; 'seed' drawn for who lies
  pub fn made(self &mut, guardW usize, guardE usize, minotaur usize, seed u32) {
    on = true;
    guards.clear();
    guards.push(guardW);
    guards.push(guardE);
    bull = minotaur;
    liar = (seed >> 7u32) & 1u32;
    nav = buildLabNav();
    mode = BM_PATROL;
    patrolK = 0usize;
    dwell = 1.;
    self.replay(&mut out);
  }

  // ---- the guards ----

  // Visitor 'being' (at 'at') asks guard 'g' question 'q': the line code of the answer, told to every view; 0 if it was not heard
  // (too far from the guard, or no such question). Once asked, a visitor who asks again is told it has had its question.
  pub fn talk(self &mut, being usize, at Vec3, g u32, q u32) u32 {
    if !on or g > 1u32 or q < Q_MIDDLE or q > Q_MINE { return 0u32; }
    if !underground(at.y) { return 0u32; }
    let gx = if g == CR_GUARD_W { LAB_GUARD_LEFT_X } else { LAB_GUARD_RIGHT_X };
    let dx = at.x - gx;
    let dz = at.z - LAB_GUARD_Z;
    if dx * dx + dz * dz > TALK_RANGE * TALK_RANGE { return 0u32; }
    var code = 0u32;
    if self.hasAsked(being) {
      code = A_ASKED;
    } else {
      code = answerCode(q, g, liar);
      asked.push(being);
    }
    said = said + 1u32;
    self.tell(CM_SAID, g, u32.from(being), new Vec3(0., 0., 0.), code);
    code
  }
}
