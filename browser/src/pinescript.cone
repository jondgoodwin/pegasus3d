// The conifers' part of the scripted run: after the balloon's (assembly.cone),
// ten windows of ten frames each, a picture at each window's fifth frame, of
// the white pines, the hemlock and the fir. Every eye and target is worked out
// from the layout (the conifers' variants, where they stand) and the island,
// so the views follow the scene's rules, not fixed numbers.
//
//   window  what is looked at                                          picture
//     0     a young white pine from the path, close, from 7 m          pines-white-close
//     1     the forest from the path, a quarter of the way up it       pines-forest
//     2     the forest from the path, two fifths of the way up         pines-forest-b
//     3     a hemlock from the path, from 7 m                          pines-hemlock
//     4     a balsam fir from the path, from 7 m                       pines-fir
//     5     the pines round the back of the cottage                    pines-ring
//     6     a wind-shaped shore white pine                             pines-shore
//     7     a tall forest-grown white pine, trunk and crown            pines-mature
//     8     a white pine against a low sun (16:40), seen from the east pines-backlit
//     9     the ring pines at night, from the lantern path (23:00)     pines-night
//
// The first seven are at noon (the clock is set at the first frame).

pub const PINES_FROM = ASM_FROM + ASM_FRAMES;
pub const PINES_WINDOW = 10u64;
pub const PINES_WINDOWS = 10u64;
pub const PINES_FRAMES = PINES_WINDOW * PINES_WINDOWS;

fn pinesWindow(f u64) u64 { (f - PINES_FROM) / PINES_WINDOW; }

pub fn pinesActive(f u64) bool { f >= PINES_FROM and f < PINES_FROM + PINES_FRAMES; }

pub fn pinesShotAt(f u64) &[]u8 {
  if !pinesActive(f) or (f - PINES_FROM) % PINES_WINDOW != 4u64 { return ""; }
  imm w = pinesWindow(f);
  if w == 0u64 { return "pines-white-close"; }
  if w == 1u64 { return "pines-forest"; }
  if w == 2u64 { return "pines-forest-b"; }
  if w == 3u64 { return "pines-hemlock"; }
  if w == 4u64 { return "pines-fir"; }
  if w == 5u64 { return "pines-ring"; }
  if w == 6u64 { return "pines-shore"; }
  if w == 7u64 { return "pines-mature"; }
  if w == 8u64 { return "pines-backlit"; }
  "pines-night";
}

// The clock: noon at the first frame, 16:40 for the sun low in the west, 23:00 for the night
pub fn pinesDrive(st &mut SceneState, f u64) {
  if !pinesActive(f) { return; }
  imm at = f - PINES_FROM;
  if at == 0u64 { st.scene.clock.ns = u64.from(nanosOf(f64.from(12. - 7.) * 60d)); }
  if at == 8u64 * PINES_WINDOW { st.scene.clock.ns = u64.from(nanosOf(f64.from(16.67 - 7.) * 60d)); }
  if at == 9u64 * PINES_WINDOW { st.scene.clock.ns = u64.from(nanosOf(f64.from(23. - 7.) * 60d)); }
}

// The conifer of variants 'lo' up to (not including) 'hi' that stands nearest the path, 6 m off it at
// the least; the first conifer if none
fn pinesItem(lo u32, hi u32) Item {
  imm items = vegetationLayout();
  mut best = vegItem(K_PINE, 0usize);
  mut bestD = 1.0e9;
  mut i = 0usize;
  while i < items.len() {
    imm it = items[i];
    if it.kind == K_PINE and it.variant >= lo and it.variant < hi {
      imm d = pathDistanceAt(it.x, it.z);
      if d > 6. and d < bestD { bestD = d; best = *it; }
    }
    i = i + 1usize;
  }
  best;
}

// The unit direction (x, z) from 'it' to the nearest point of the path's centre
fn towardPath(it &Item) Vec2 {
  imm line = pathCentreline();
  mut best = 1.0e9;
  mut dx = 1.;
  mut dz = 0.;
  mut k = 0usize;
  while k < line.len() {
    imm p = *line[k];
    imm d = (p.x - it.x) * (p.x - it.x) + (p.z - it.z) * (p.z - it.z);
    if d < best { best = d; dx = p.x - it.x; dz = p.z - it.z; }
    k = k + 1usize;
  }
  imm l = (dx * dx + dz * dz).sqrt() + 0.0001;
  new Vec2(dx / l, dz / l);
}

// An eye 'dist' metres from conifer 'it' towards the path, at the walker's height, looking at its
// crown 'up' of its height up
fn pinesLookAt(it &Item, dist f32, up f32) Pose {
  imm d = towardPath(it);
  imm ex = it.x + d.x * dist;
  imm ez = it.z + d.y * dist;
  imm height = PINES_HEIGHTS[usize.from(it.variant)] * it.scale;
  lookFrom(new Vec3(ex, groundHeight(ex, ez) + 1.7, ez), new Vec3(it.x, it.y + up * height, it.z));
}

// The conifers' nominal heights (vegetation.cone's table, the same numbers)
imm PINES_HEIGHTS Array[f32, 12] = [9., 11., 12.5, 22.5, 25.5, 27.5, 15.5, 18.5, 9.5, 13., 9., 12.5];

// The walker's eye 'fraction' of the way up the path, looking on 8 m ahead and a little up
fn pathWalkView(fraction f32) Pose {
  imm line = pathCentreline();
  imm k = usize.from(u32.from(f32.from(line.len()) * fraction));
  imm a = *line[k];
  imm b = *line[k + 8usize];
  lookFrom(new Vec3(a.x, a.y + 1.7, a.z), new Vec3(b.x, b.y + 4., b.z));
}

pub fn pinesView(f u64) Pose {
  imm w = pinesWindow(f);
  if w == 0u64 {
    imm it = pinesItem(PINE_YOUNG_FIRST, PINE_FOREST_FIRST);
    return pinesLookAt(&it, 7., 0.45);
  }
  if w == 1u64 { return pathWalkView(0.26); }
  if w == 2u64 { return pathWalkView(0.40); }
  if w == 3u64 {
    imm it = pinesItem(HEMLOCK_FIRST, FIR_FIRST);
    return pinesLookAt(&it, 7., 0.4);
  }
  if w == 4u64 {
    imm it = pinesItem(FIR_FIRST, PINE_VARIANTS);
    return pinesLookAt(&it, 7., 0.4);
  }
  // the ring's back three (x -24 to 4, z 303 to 306), from the east at the cottage's level
  if w == 5u64 {
    return lookFrom(new Vec3(26., groundHeight(26., 320.) + 3., 320.), new Vec3(-10., groundHeight(-10., 305.) + 9., 305.));
  }
  if w == 6u64 {
    imm it = pinesItem(PINE_SHORE_FIRST, HEMLOCK_FIRST);
    return pinesLookAt(&it, 11., 0.45);
  }
  if w == 7u64 {
    imm it = pinesItem(PINE_FOREST_FIRST, PINE_SHORE_FIRST);
    return pinesLookAt(&it, 16., 0.5);
  }
  if w == 8u64 {
    // looking west, the sun behind the tree
    imm it = pinesItem(PINE_YOUNG_FIRST, PINE_SHORE_FIRST);
    imm height = PINES_HEIGHTS[usize.from(it.variant)] * it.scale;
    imm ex = it.x + 9.;
    return lookFrom(new Vec3(ex, groundHeight(ex, it.z) + 1.7, it.z), new Vec3(it.x, it.y + 0.55 * height, it.z));
  }
  lookFrom(cot(3., 1.7, 25.), cot(-0.5, 7., 0.));
}

pub fn pinesFov(f u64) f32 {
  imm w = pinesWindow(f);
  if w == 7u64 { return 1.2; }
  FOV;
}
