// The mirror's part of the scripted run (viewsurface.cone, the cottage's back wall), last of all (after the villagers',
// frame MIRROR_FROM_FULL). The wooden mannequin (being 1) is set down 2.2 m in front of the mirror, facing it, and left to
// settle (a being moved by Being.setDown is drawn stretched for about a second: a known defect), the day clock at noon of a
// sixth day in fair weather. Then the mirror is looked at from several places, a window of ten frames each, the picture
// saved at the window's fifth (window 3's at its ninth):
//
//   window  what is looked at
//     0     from 4 m behind the mannequin and a little to one side: the mannequin faces its reflection
//     1     from 4.5 m out and 4.5 m to one side, three-quarter: the frame, the wall, the angle of the picture
//     2     the mannequin's own eyes (first person): what it sees, the balloon behind in the pane
//     3     the camera sliding sideways 5 cm a frame (temporal AA while the picture moves)
//     4     the same view as 0, in the rain
//     5     the same view as 0, in the evening
//     6     the mannequin's eyes turned away from the mirror: no picture may be drawn (checked), no shot
//
// Checked: the mirror drew a picture while it was in sight (window 0) and drew none while it was not (window 6). The
// frames' pictures are in the shot folder.
//
// 'browser.exe --mirror-only' runs just this part (frames 300 on), for looking at the mirror without the whole run;
// '--mirror-only --soak N --mirror-hold 1' (or 2) holds the mannequin's eyes on the mirror (or turned away) for the rest of
// N frames, to time what the mirror costs.

pub const MIRROR_FROM_FULL = PLAY_FROM + PLAY_FRAMES;
pub const MIRROR_SETTLE = 120u64;
pub const MIRROR_WINDOW = 10u64;
pub const MIRROR_WINDOWS = 7u64;
pub const MIRROR_FRAMES = MIRROR_SETTLE + MIRROR_WINDOW * MIRROR_WINDOWS;

// The first frame of the mirror's part: frame 300 in the mirror-only run (the first walk's keys end at 290), else after the
// villagers'
pub fn mirrorFrom(opts: &RunOptions) u64 {
  if opts.mirrorOnly { 300u64 } else { MIRROR_FROM_FULL }
}

pub fn mirrorScriptEnd(opts: &RunOptions) u64 { mirrorFrom(opts) + MIRROR_FRAMES }

// Whether frame 'f' is in the mirror's part
pub fn mirrorIn(opts: &RunOptions, f: u64) bool { f >= mirrorFrom(opts) }

// The cottage's frame in the world (the same numbers as script.cone's cot()): the middle of the front wall, on the ground
const MIR_COT_X: f32 = -16.;
const MIR_COT_Z: f32 = 330.;

// Noon of the sixth day (the clock's seconds: 300 into a day of 1440, five days on), and 17.3 hours of it
const MIRROR_NOON: f64 = 7500.0;
const MIRROR_DUSK: f64 = 7500.0 + 5.3 * 60.0;

// Where the mannequin stands: 2.2 m from the back wall, in line with the mirror's middle
const MIRROR_STAND_X: f32 = MIR_COT_X + 1.5;
const MIRROR_STAND_Z: f32 = MIR_COT_Z - 6. - 2.2;

fn mirrorWindow(f: u64, from: u64) u64 { (f - from - MIRROR_SETTLE) / MIRROR_WINDOW }

fn mirrorInWindows(opts: &RunOptions, f: u64) bool { f >= mirrorFrom(opts) + MIRROR_SETTLE && f < mirrorScriptEnd(opts) }

pub fn mirrorHasView(opts: &RunOptions, f: u64) bool { mirrorIn(opts, f) }

pub fn mirrorShotAt(opts: &RunOptions, f: u64) &str {
  if !mirrorInWindows(opts, f) || opts.mirrorHold > 0u32 { return ""; }
  let k = (f - mirrorFrom(opts) - MIRROR_SETTLE) % MIRROR_WINDOW;
  let w = mirrorWindow(f, mirrorFrom(opts));
  if w == 3u64 { return if k == 9u64 { "mirror-moving" } else { "" }; }
  if k != 5u64 { return ""; }
  if w == 0u64 { return "mirror-self"; }
  if w == 1u64 { return "mirror-angle"; }
  if w == 2u64 { return "mirror-eyes"; }
  if w == 4u64 { return "mirror-rain"; }
  if w == 5u64 { return "mirror-evening"; }
  ""
}

// A point in the cottage's frame (x along the wall, z out from the front: the back wall is at -6), y above the ground there
fn mirrorAt(isl: &Island, x: f32, y: f32, z: f32) Vec3 {
  Vec3(MIR_COT_X + x, y + groundHeight(isl, MIR_COT_X + x, MIR_COT_Z + z), MIR_COT_Z + z)
}

// The close-up's eye for frame 'f'
pub fn mirrorView(st: &mut SimState, f: u64) Pose {
  let isl = &st.land;
  let from = mirrorFrom(&st.opts);
  // (before the windows: as window 0)
  let w = if f < from + MIRROR_SETTLE { 0u64 } else { mirrorWindow(f, from) };
  let mirrorMiddle = mirrorAt(isl, 1.5, 1.4, -6.034);
  let mannequin = &mut st.cast.beings[1usize];
  // Held (timing): the mannequin's eyes looking at the mirror, or turned the other way
  if st.opts.mirrorHold > 0u32 {
    if st.opts.mirrorHold == 2u32 { return Pose.look(mannequin.eyes().origin, mannequin.body.yaw + 3.1415927, 0.); }
    return mannequin.eyes();
  }
  if w == 1u64 { return lookFrom(mirrorAt(isl, 6., 1.7, -10.5), mirrorMiddle); }
  if w == 2u64 { return mannequin.eyes(); }
  if w == 6u64 { return Pose.look(mannequin.eyes().origin, mannequin.body.yaw + 3.1415927, 0.); }
  if w == 3u64 {
    let k = f - from - MIRROR_SETTLE - MIRROR_WINDOW * 3u64;
    let slide = f32.from(k) * 0.05;
    return lookFrom(mirrorAt(isl, 2.6 + slide, 1.9, -12.), mirrorMiddle);
  }
  // Windows 0, 4 and 5: 4 m behind the mannequin, 1.1 m to one side, 1.9 m up
  lookFrom(mirrorAt(isl, 2.6, 1.9, -12.), mirrorMiddle)
}

// The mirror's part of frame 'f', after it is presented
pub fn mirrorDrive(st: &mut SimState, f: u64) {
  let from = mirrorFrom(&st.opts);
  if f < from || (f >= from + MIRROR_FRAMES && st.opts.mirrorHold == 0u32) { return; }
  let k = f - from;
  if st.opts.mirrorHold > 0u32 && k > 0u64 {
    if k % 300u64 == 0u64 {
      let m = &st.cast.beings[1usize].body;
      print <- "Mirror hold, frame "; print <- f; print <- ": the mannequin at ("; print <- m.position.x; print <- ", "; print <- m.position.y; print <- ", ";
      print <- m.position.z; print <- ") facing "; print <- m.yaw; print <- ", pictures "; print <- st.rendered.pictures; print <- "\n";
    }
    return;
  }
  if k == 0u64 {
    st.scene.clock.ns = u64.from(nanosOf(MIRROR_NOON));
    st.weather.setNow(if st.opts.mirrorHold > 0u32 { st.opts.holdWeather } else { WEATHER_FAIR });
    let b =&mut st.cast.beings[1usize];
    let at = Vec3(MIRROR_STAND_X, groundHeight(&st.land, MIRROR_STAND_X, MIRROR_STAND_Z), MIRROR_STAND_Z);
    // Facing +z, at the wall (a being's heading 0 faces -z)
    b.setDown(at, 3.1415927);
    print <- "The mirror's part: the mannequin set down at ("; print <- at.x; print <- ", "; print <- at.y; print <- ", "; print <- at.z; print <- ")\n";
    return;
  }
  let window = MIRROR_SETTLE + MIRROR_WINDOW * 4u64;
  if k == window { st.weather.setNow(WEATHER_RAIN); }
  if k == window + MIRROR_WINDOW {
    st.weather.setNow(WEATHER_FAIR);
    st.scene.clock.ns = u64.from(nanosOf(MIRROR_DUSK));
  }
  // The pictures the mirror's view has drawn: while the mirror is in sight (window 0, from its third frame on, the view
  // being a frame behind the script) more are drawn; while the eyes are turned away (window 6) none
  if !st.rendered.gpu { return; }
  let seenWindow = MIRROR_SETTLE;
  let awayWindow = MIRROR_SETTLE + MIRROR_WINDOW * 6u64;
  if k == seenWindow + 2u64 || k == awayWindow + 2u64 { st.run.mirrorMark = st.rendered.pictures; }
  if k == seenWindow + 9u64 {
    let ok = st.rendered.pictures > st.run.mirrorMark;
    print <- "Frame "; print <- f; print <- ", the mirror in sight: "; print <- st.rendered.pictures - st.run.mirrorMark; print <- " pictures drawn in 7 frames";
    if ok { print <- "\n"; } else { print <- " (want some) WRONG\n"; st.run.mirrorOk = false; }
  }
  if k == awayWindow + 9u64 {
    let ok = st.rendered.pictures == st.run.mirrorMark;
    print <- "Frame "; print <- f; print <- ", the eyes turned away: "; print <- st.rendered.pictures - st.run.mirrorMark; print <- " pictures drawn in 7 frames";
    if ok { print <- " (want 0)\n"; } else { print <- " (want 0) WRONG\n"; st.run.mirrorOk = false; }
  }
}
