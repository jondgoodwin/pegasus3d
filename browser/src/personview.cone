// How a person is put in the scene, and how a view animates one.
//
// SPAWNING. A person (personasset.cone) is shown as a part of the being (its root, the body) and parts under it for what is not
// the skin's material: the eyes (a wet gloss over an iris painted from the person's), the ears (the skin's), the teeth, the tongue
// and the mouth's dark inside, each piece of clothing in its cloth, and the cape. Every part is a skinned mesh bound to the same 22 bones,
// posed by the same skinning matrices (the view sends the one list to each part: Request.Bones), as the creatures' extras are.
// The body is a MORPHED mesh (Request.DefineMorphed): its 50 face targets move the lids, the brows and the mouth, and render's
// compute pre-pass applies them before the skin. Skin is render's subsurface material with the person's painted albedo and roughness.
//
// ANIMATING (the view's alone; the simulation draws nothing). A PersonLook holds the person's face rig (facerig's blinking, gaze and
// idle) and what the view last sent: each frame the rig is stepped, its jaw and eye bones are laid on the figure's pose, and its
// target weights go to the body as a Morph. A person far from the eye is not stepped (its face is not seen); a hail smiles.

// The people's parts a being's body has under its root, and the morphed mesh that is its face
pub struct PersonParts {
  pub root PartId;                   // the being's own part (the body)
  pub extras List[PartId];           // the parts under it
  pub face MeshId;                   // the body's morphable mesh
  pub person u32;                    // its number in the cast
}

// A person's face as a view animates it
pub struct PersonLook {
  pub root PartId;
  pub face MeshId;
  pub rig facerig.FaceRig;
  pub frame facerig.FaceFrame;
  pub bones facerig.FaceBones;
  pub spec facerig.FaceSpec;
  pub smile f32;                     // how much of a hail's smile is on: 0 to 1
  pub open f32;                      // and the mouth's "ah"
  pub seen bool;                     // it was in range of the eye at the last step
}

pub const NO_PERSON = 0xFFFFFFFFu32;

// A copy of a list of matrices (each Bones request owns its list)
pub fn copyMats(l &List[Mat4]) List[Mat4] {
  mut o = List[Mat4].withCapacity(l.len());
  mut i = 0usize;
  while i < l.len() { o.push(*l[i]); i = i + 1usize; }
  o;
}

pub fn copyParts(l &List[PartId]) List[PartId] {
  mut o = List[PartId].withCapacity(l.len());
  mut i = 0usize;
  while i < l.len() { o.push(*l[i]); i = i + 1usize; }
  o;
}

pub fn copyF32s(l &List[f32]) List[f32] {
  mut o = List[f32].withCapacity(l.len());
  mut i = 0usize;
  while i < l.len() { o.push(*l[i]); i = i + 1usize; }
  o;
}

// The cast of humanbody's people (cast() in measures.cone), by number: who plays whom on the island
pub const PERSON_AVATAR = 0usize;           // the main avatar, in his black cape: the user's own being
pub const PERSON_TALL_SLIM_MAN = 1usize;
pub const PERSON_STOCKY_MAN = 2usize;
pub const PERSON_AVERAGE_MAN = 3usize;
pub const PERSON_PETITE_WOMAN = 4usize;
pub const PERSON_TALL_ATHLETE = 5usize;
pub const PERSON_AVERAGE_WOMAN = 6usize;
pub const PERSON_GUARD_W = 7usize;          // the labyrinth's guards: bare-chested variants of two of the men (personasset.cone's GUARD_SOURCES)
pub const PERSON_GUARD_E = 8usize;

// How far from the eye (metres) a face is stepped and sent
pub const FACE_RANGE f32 = 40.;

fn pvCloneMesh(m &Mesh) Mesh {
  mut o = Mesh.empty();
  o.append(m);
  o;
}

fn pvCloneImage(im &Image) Image {
  mut pixels = List[u8].withCapacity(im.pixels.len());
  mut i = 0usize;
  while i < im.pixels.len() { pixels.push(*im.pixels[i]); i = i + 1usize; }
  new Image(im.width, im.height, im.channels, pixels);
}

fn pvCloneU32s(l &List[u32]) List[u32] {
  mut o = List[u32].withCapacity(l.len());
  mut i = 0usize;
  while i < l.len() { o.push(*l[i]); i = i + 1usize; }
  o;
}

fn pvCloneVec3s(l &List[Vec3]) List[Vec3] {
  mut o = List[Vec3].withCapacity(l.len());
  mut i = 0usize;
  while i < l.len() { o.push(*l[i]); i = i + 1usize; }
  o;
}

fn pvCloneF32s(l &List[f32]) List[f32] {
  mut o = List[f32].withCapacity(l.len());
  mut i = 0usize;
  while i < l.len() { o.push(*l[i]); i = i + 1usize; }
  o;
}

fn pvCloneMorph(m &MorphTargets) MorphTargets {
  mut o = MorphTargets.empty(m.vertexCount);
  o.targetStart = pvCloneU32s(&m.targetStart);
  o.vertex = pvCloneU32s(&m.vertex);
  o.dPos = pvCloneVec3s(&m.dPos);
  o.dNor = pvCloneVec3s(&m.dNor);
  o.dTan = pvCloneVec3s(&m.dTan);
  o.maxMove = pvCloneF32s(&m.maxMove);
  o;
}

// sRGB 0 to 255 as a linear colour
fn pvLinear(c Vec3) Color {
  new Color(libc.powf(c.x / 255., 2.2), libc.powf(c.y / 255., 2.2), libc.powf(c.z / 255., 2.2), 1.);
}

// The cloth's look by kind: cotton and linen matte, wool rougher, leather glossier, silk smooth
fn pvCloth(c Vec3, kind u32) Look {
  mut rough = 0.78;
  if kind == humanbody.CLOTH_WOOL { rough = 0.9; }
  elif kind == humanbody.CLOTH_LEATHER { rough = 0.5; }
  elif kind == humanbody.CLOTH_SILK { rough = 0.35; }
  Look.physicallyBased(pvLinear(c), rough, 0.);
}

fn pvPart(door &mut Door, name &str, root PartId, a &SkinnedAsset, mat MaterialId, parts &mut List[PartId]) {
  if a.mesh.triangleCount() == 0usize { return; }
  imm part = door.newChild(name, root);
  door.send(Request.Show(part, door.defineSkinnedMesh(pvCloneMesh(&a.mesh), humanbody.copySkin(&a.skin)), mat, 0.));
  parts.push(part);
}

// Person 'a' sent into the scene as 'root' (the being's own part): the body, a morphed skinned mesh in the skin's material, and its
// other parts under it. Answers them, whose skinning the view sets with the body's, and the body's morphable mesh.
pub fn spawnPerson(door &mut Door, a &PersonAsset, root PartId) PersonParts {
  mut parts = List[PartId].empty();
  // the skin
  mut skinLook = Look.physicallyBased(new Color(1., 1., 1., 1.), 1., 0.);
  skinLook.skin = true;
  imm skinMat = door.defineMaterial(skinLook, pvCloneImage(&a.albedo), Maps.images(Image.empty(), pvCloneImage(&a.rough)));
  imm face = door.defineMorphed(pvCloneMesh(&a.body), humanbody.copySkin(&a.bodySkin), pvCloneMorph(&a.morph));
  door.send(Request.Show(root, face, skinMat, 0.));
  // the face's rigid parts
  mut eyeLook = Look.physicallyBased(new Color(1., 1., 1., 1.), 0.3, 0.);
  eyeLook.clearcoat = 1.;
  eyeLook.clearcoatRoughness = 0.02;
  imm eyeMat = door.defineMaterial(eyeLook, humanbody.paintEye(a.iris), Maps.none());
  imm teethMat = door.defineMaterial(Look.physicallyBased(new Color(0.78, 0.74, 0.64, 1.), 0.3, 0.), Image.empty(), Maps.none());
  imm tongueMat = door.defineMaterial(Look.physicallyBased(new Color(0.24, 0.07, 0.08, 1.), 0.4, 0.), Image.empty(), Maps.none());
  imm cavityMat = door.defineMaterial(Look.physicallyBased(new Color(0.045, 0.012, 0.012, 1.), 0.9, 0.), Image.empty(), Maps.none());
  pvPart(door, "eyes", root, &a.eyes, eyeMat, &mut parts);
  pvPart(door, "ears", root, &a.ears, skinMat, &mut parts);
  pvPart(door, "teeth", root, &a.teeth, teethMat, &mut parts);
  pvPart(door, "tongue", root, &a.tongue, tongueMat, &mut parts);
  pvPart(door, "mouth", root, &a.cavity, cavityMat, &mut parts);
  // the clothes
  mut i = 0usize;
  while i < a.pieces.len() {
    imm p = a.pieces[i];
    imm part = door.newChild(p.name.view(), root);
    imm mat = door.defineMaterial(pvCloth(p.color, p.kind), Image.empty(), Maps.none());
    door.send(Request.Show(part, door.defineSkinnedMesh(pvCloneMesh(&p.mesh), humanbody.copySkin(&p.skin)), mat, 0.));
    parts.push(part);
    i = i + 1usize;
  }
  // the cape: black velvet, a cool sheen
  if a.hasCape() {
    imm capeMat = door.defineMaterial(Look.physicallyBased(new Color(0.016, 0.016, 0.019, 1.), 0.6, 0.), Image.empty(), Maps.none());
    pvPart(door, "cape", root, &a.cape, capeMat, &mut parts);
  }
  new PersonParts(root, parts, face, a.index);
}

// The face of person 'a' as a view animates it, for the body part 'root' whose morphable mesh is 'face'
pub fn personLook(a &PersonAsset, root PartId, face MeshId, seed u32) PersonLook {
  mut ut = List[i32].empty();
  mut u = 0usize;
  while u < a.unitTarget.len() { ut.push(*a.unitTarget[u]); u = u + 1usize; }
  mut names = List[String].empty();
  mut n = 0usize;
  while n < a.targetCount { names.push(String.empty()); n = n + 1usize; }
  imm targets = new facerig.FaceTargets(0usize, ut, names, List[u32].empty(), List[u32].empty(), List[Vec3].empty(),
    List[Vec3].empty(), List[f32].empty());
  imm units = facerig.standardUnits();
  mut spec = facerig.FaceSpec.empty();
  spec.names = copyStrings(&a.spec.names);
  spec.points = copyVec3s(&a.spec.points);
  spec.scale = a.spec.scale;
  spec.eyeRadius = a.spec.eyeRadius;
  spec.upperLidEdge = a.spec.upperLidEdge;
  spec.lowerLidEdge = a.spec.lowerLidEdge;
  spec.closingLine = a.spec.closingLine;
  spec.jawPivot = a.spec.jawPivot;
  spec.jawOpenMax = a.spec.jawOpenMax;
  spec.eyeLimit = a.spec.eyeLimit;
  mut rig = facerig.FaceRig.make(&spec, &units, &targets, 20261015u32 + seed);
  rig.idleAmount = 1.;
  rig.blinking = true;
  imm frame = rig.newFrame();
  new PersonLook(root, face, rig, frame, a.faceBones(), spec, 0., 0., true);
}
