// The sky rig: the day's sky and light, and the birds, drawn by two custom
// pipelines of render. It is the browser's exemplar of what two general
// packages give a scene:
//
//   analyticdaylight   where the sun and the moon are at an hour, the sky's
//                      colour in every direction (Preetham's, a twilight
//                      patch, the night), the sun's, moon's and sky's light
//   boidflock          forty birds flocking over a home point, and how each
//                      beats its wings
//
// WHAT THE RIG DECIDES (the browser's choices; the packages decide none):
// the place and the day (45 degrees north, 15 October, so the clock's dawn at
// 6:31 and dusk at 17:28 are the sun's centre at the horizon), the
// turbidity (2.5, clean sea air), the moon's phase (waxing gibbous), the
// clouds' cover, the birds' number, size, colour, home and wings.
//
// THE SKY is one full-screen draw (skyshader.slang), its numbers written each
// frame by 'DaySky.pack' from the scene's day clock (Snapshot.hour). THE
// LIGHT the scene is lit by comes from the same DaySky on the CPU: the
// directional light is the sun while its light is the greater, else the moon;
// the ambient is the sky's average; and the exposure follows the sun's
// height (look.cone). THE BIRDS are one mesh drawn once for every bird
// (birdshader.slang): the flock (Birds) is stepped in the simulation, by the
// scene actor (scene time: paused and fast with the day), and carried to the
// render actor in the snapshot; each frame every bird is one instance in the
// draw list, its wings flapped in the vertex stage at the phase and amplitude
// the flock gives it.
//
// WHERE IT HANGS: the render system's draw list takes the sky and the
// birds' instances after it has built the parts' (renderactor.cone's
// drawFrame); the Sky request's part says a sky is wanted (the rig draws only
// if one was sent), its SkyLook the static fallback otherwise.

// The cottage's frame and so the birds' home: the flocks keep within 90 m of it
pub const BIRD_HOME_X f32 = -10. + WORLD_DX;   // (the old flat world's cottage, on the island's lowland)
pub const BIRD_HOME_Z f32 = -24. + WORLD_DZ;
// The birds in the air
pub const BIRD_COUNT = 40usize;
// Each bird's size: the mesh's wingspan is 0.49 m, drawn 1.1 times that,
// 0.54 m (a large starling's or a small pigeon's; a real finch's is 0.25),
// so a bird is 14 pixels across at 40 m
pub const BIRD_SCALE f32 = 1.1;
// The fixed step the flock is stepped in
const FLOCK_STEP f32 = 0.0333333;

// The day's numbers: 'standard' (45 degrees north, turbidity 2.5, the moon
// 85 per cent lit) on day 288, 15 October (the package's standard is day 140)
fn dayConfig() DayConfig {
  mut c = DayConfig.standard();
  c.dayOfYear = 288.;
  c;
}

// The low and high clouds' cover, 0 to 1 (partly cloudy)
const CLOUD_LOW f32 = 0.42;
const CLOUD_HIGH f32 = 0.5;

// The birds: the flock, which the scene actor steps in the simulation (scene
// time), and each bird's place and wings' phase before the last step, which
// the snapshot carries to the render actor to draw between. Kept apart from
// the sky because the flock is simulated (the scene's) and the sky is drawn
// (render's).
pub struct Birds {
  pub flock Flock;
  pub prevPos List[Vec3];          // each bird's place before the last step, to draw between
  pub prevPhase List[f32];

  // The flock over the cottage
  pub fn make() Birds {
    imm home = new Vec3(BIRD_HOME_X, groundHeight(BIRD_HOME_X, BIRD_HOME_Z), BIRD_HOME_Z);
    imm flock = Flock.make(BIRD_COUNT, FlockParams.standard(home), 7u32, &groundHeight);
    mut birds = new Birds(flock, List[Vec3].empty(), List[f32].empty());
    birds.rememberPositions();
    birds;
  }

  fn rememberPositions(self &mut) {
    prevPos.clear();
    prevPhase.clear();
    mut i = 0usize;
    while i < flock.birds.len() {
      imm b = *flock.birds[i];
      prevPos.push(b.pos);
      prevPhase.push(b.phase);
      i = i + 1usize;
    }
  }

  // The flock stepped on by 'dt' seconds of scene time (in steps of at most
  // 1/30 s)
  pub fn step(self &mut, dt f32) {
    if dt <= 0. { return; }
    self.rememberPositions();
    mut left = dt;
    while left > 0.0001 {
      imm h = if left > FLOCK_STEP { FLOCK_STEP; } else { left; };
      flock.step(h, &groundHeight);
      left = left - h;
    }
  }

  // Every bird as the snapshot carries it, into 'dest' (emptied first)
  pub fn publish(self &, dest &mut List[BirdFrame]) {
    dest.clear();
    mut i = 0usize;
    while i < flock.birds.len() {
      imm pose = flock.pose(i);
      dest.push(new BirdFrame(*prevPos[i], *prevPhase[i], pose.position, pose.forward, pose.up, pose.right, pose.phase,
        pose.amp));
      i = i + 1usize;
    }
  }
}

pub struct SkyRig {
  pub config DayConfig;
  pub sky DaySky;                  // at the hour last asked for
  pub lighting DayLighting;
  pub skyMesh MeshHandle;
  pub skyMaterial MaterialHandle;
  pub birdMesh MeshHandle;
  pub birdMaterial MaterialHandle;
  pub made bool;                   // the GPU side made
  pub packed List[f32];
  pub birdsDrawn usize;
  pub sceneTime f32;

  // The rig, before any GPU
  pub fn make() SkyRig {
    imm cfg = dayConfig();
    imm sky = DaySky.at(&cfg, 7.);
    new SkyRig(cfg, sky, sky.lighting(), MeshHandle.none(), MaterialHandle.none(), MeshHandle.none(),
      MaterialHandle.none(), false, List[f32].empty(), 0usize, 0.);
  }

  // The sky and its light at the day clock's hour 'hour'
  pub fn setHour(self &mut, hour f32) {
    sky = DaySky.at(&config, hour);
    lighting = sky.lighting();
  }

  // The SkyLook the frame is lit by: the light the DaySky gives, the clear
  // colour the sky's horizon (the sky pass covers it)
  pub fn look(self &) SkyLook {
    imm h = sky.radiance(new Vec3(0., 0.02, 1.).normalize());
    new SkyLook(new Color(h.x, h.y, h.z, 1.), lighting.lightDir,
      new Color(lighting.lightColor.x, lighting.lightColor.y, lighting.lightColor.z, 1.),
      new Color(lighting.ambient.x, lighting.ambient.y, lighting.ambient.z, 1.));
  }

  // The sun's sine of height, which the exposure follows
  pub fn sunSine(self &) f32 { sky.sunDir.y; }

  // How strongly the physically based material's environment lights, as the
  // ambient is to the noon's (about 11 000 nits, what environmentSky is made
  // to match)
  pub fn environmentStrength(self &) f32 {
    imm r = lumaOf(lighting.ambient) / 11000.;
    if r > 1.5 { 1.5; } elif r < 0.00005 { 0.00005; } else { r; };
  }

  // Make the GPU side: the sky's and the birds' pipelines, mesh and materials
  pub fn makeGpu(self &mut, renderer &mut Renderer, device &mut Device) {
    // Neither binds a texture
    imm skyDesc = new CustomPipeline(spirv: &SKY_SPIRV, textures: noTextures(), paramBytes: 160u64, streams: 1u32,
      cullMode: CULL_MODE_NONE, depthWrite: false);
    imm skyPipe = renderer.addPipeline(device, &skyDesc);
    imm birdDesc = new CustomPipeline(spirv: &BIRD_SPIRV, textures: noTextures(), paramBytes: 16u64, streams: 3u32,
      cullMode: CULL_MODE_NONE, depthWrite: true);
    imm birdPipe = renderer.addPipeline(device, &birdDesc);
    if !renderer.hasPipeline(skyPipe) or !renderer.hasPipeline(birdPipe) { return; }
    imm plane = Mesh.plane(1, 1.);
    skyMesh = renderer.addMesh(device, &plane);
    imm none = List[f32].empty();
    imm noMaps = List[TextureHandle].empty();
    skyMaterial = renderer.addCustomMaterial(device, skyPipe, none.view(), noMaps.view());
    imm bird = birdMeshOf();
    birdMesh = renderer.addMesh(device, &bird);
    birdMaterial = renderer.addCustomMaterial(device, birdPipe, none.view(), noMaps.view());
    made = true;
  }

  // The sky's parameters for scene time 'now' written, and the draw list
  // given the sky and the birds (the snapshot's), at 'alpha' of the way from
  // the flock's last step to this one
  pub fn draw(self &mut, renderer &mut Renderer, device &mut Device, list &mut DrawList, now f32, alpha f32,
    birds &List[BirdFrame]) {
    if !made { return; }
    sceneTime = now;
    packed.clear();
    sky.pack(&mut packed);
    // The clouds: covers and the scene's time; then the light a white cloud
    // takes (the sun's through the high air, and the moon's), as radiance
    packed.push(CLOUD_LOW); packed.push(CLOUD_HIGH); packed.push(now); packed.push(0.);
    imm cloudSun = sky.cloudIrradiance();
    imm moon = sky.moonIrradiance();
    packed.push((cloudSun.x + moon.x) / pi); packed.push((cloudSun.y + moon.y) / pi);
    packed.push((cloudSun.z + moon.z) / pi); packed.push(0.);
    renderer.setCustomParams(device, skyMaterial, packed.view());
    list.add(skyMesh, skyMaterial, Mat4.identity());
    // The birds
    mut i = 0usize;
    mut drawn = 0usize;
    while i < birds.len() {
      imm pose = *birds[i];
      imm p0 = pose.before;
      imm pos = p0 + (pose.position - p0) * alpha;
      mut dphase = pose.phase - pose.phaseBefore;
      if dphase < 0. { dphase = dphase + 2. * pi; }
      imm phase = pose.phaseBefore + dphase * alpha;
      imm s = BIRD_SCALE;
      // Columns: right, up, back (-forward), each times the scale, then the place;
      // the fourth row's x is the wings' amplitude (birdshader.slang)
      mut m = Mat4.identity();
      m.m[0] = pose.right.x * s;   m.m[1] = pose.right.y * s;   m.m[2] = pose.right.z * s;
      m.m[4] = pose.up.x * s;      m.m[5] = pose.up.y * s;      m.m[6] = pose.up.z * s;
      m.m[8] = 0. - pose.forward.x * s; m.m[9] = 0. - pose.forward.y * s; m.m[10] = 0. - pose.forward.z * s;
      m.m[12] = pos.x; m.m[13] = pos.y; m.m[14] = pos.z;
      m.m[3] = pose.amp;
      // A little difference each: brightness 0.8 to 1.2 and warmth, from the bird's number
      imm k = f32.from(i);
      imm shade = 0.8 + 0.4 * fract(k * 0.618034);
      imm warm = 0.95 + 0.1 * fract(k * 0.381966);
      list.addTinted(birdMesh, birdMaterial, m, new Color(shade * warm, shade, shade / warm, phase));
      drawn = drawn + 1usize;
      i = i + 1usize;
    }
    birdsDrawn = drawn;
  }
}

fn fract(x f32) f32 { x - libc.floorf(x); }

// ---- the bird mesh ----

// A vertex's index after it is added: a position, a normal, and the two
// flags (uv.x: a wing's; uv.y: the beak's)
fn addVertex(m &mut Mesh, p Vec3, n Vec3, wing f32, beak f32) u32 {
  m.positions.push(p);
  m.normals.push(n);
  m.uvs.push(new Vec2(wing, beak));
  u32.from(m.positions.len() - 1usize);
}

fn addTriangle(m &mut Mesh, a u32, b u32, c u32) {
  m.indices.push(a);
  m.indices.push(b);
  m.indices.push(c);
}

// One small bird at rest, forward -z, wings flat in y = 0 (birdshader.slang
// flaps them): a body of eight rings of six, the beak its first two; a
// forked tail; a wing to each side of ten stations from shoulder to tip, its
// trailing edge cut into three primaries. Wing span 0.49 m, body 0.175 m,
// tail to 0.17 m behind the middle.
fn birdMeshOf() Mesh {
  mut m = Mesh.empty();
  // Body rings: z, half width, half height
  imm rings = [-0.090, -0.066, -0.054, -0.034, -0.004, 0.028, 0.058, 0.085];
  imm rxs = [0.0008, 0.0065, 0.0135, 0.0185, 0.0215, 0.0185, 0.0105, 0.0030];
  imm rys = [0.0008, 0.0065, 0.0145, 0.0205, 0.0245, 0.0205, 0.0120, 0.0035];
  mut first = new Array[u32, 8] <- fill 0u32;
  mut r = 0usize;
  while r < 8usize {
    first[r] = u32.from(m.positions.len());
    mut k = 0;
    while k < 6 {
      imm a = f32.from(k) * (pi / 3.);
      imm n = new Vec3(cos(a), sin(a) * 1.2, 0.).normalize();
      imm beak = if r < 2usize { 1.; } else { 0.; };
      addVertex(&mut m, new Vec3(rxs[r] * cos(a), rys[r] * sin(a), rings[r]), n, 0., beak);
      k = k + 1;
    }
    r = r + 1usize;
  }
  r = 0usize;
  while r < 7usize {
    mut k = 0u32;
    while k < 6u32 {
      imm k2 = (k + 1u32) % 6u32;
      imm a = first[r] + k;
      imm b = first[r] + k2;
      imm c = first[r + 1usize] + k;
      imm d = first[r + 1usize] + k2;
      addTriangle(&mut m, a, c, b);
      addTriangle(&mut m, b, c, d);
      k = k + 1u32;
    }
    r = r + 1usize;
  }
  // The tail: a fork of three triangles from the body's back
  imm up = new Vec3(0., 1., 0.);
  imm tl = addVertex(&mut m, new Vec3(-0.008, 0.002, 0.056), up, 0., 0.);
  imm tr = addVertex(&mut m, new Vec3(0.008, 0.002, 0.056), up, 0., 0.);
  imm ol = addVertex(&mut m, new Vec3(-0.040, 0., 0.172), up, 0., 0.);
  imm nt = addVertex(&mut m, new Vec3(0., 0., 0.140), up, 0., 0.);
  imm outerR = addVertex(&mut m, new Vec3(0.040, 0., 0.172), up, 0., 0.);
  addTriangle(&mut m, tl, ol, nt);
  addTriangle(&mut m, tl, nt, tr);
  addTriangle(&mut m, tr, nt, outerR);
  // The wings: stations at x (leading edge z, trailing edge z); the last is the tip's point
  // Ten stations: the arm to the wrist (x 0.080), then the hand, whose
  // trailing edge is cut into three primaries (stations 5, 7, 9 their tips)
  imm sx = [0.018, 0.050, 0.080, 0.115, 0.145, 0.165, 0.175, 0.192, 0.202, 0.222];
  imm sl = [-0.020, -0.026, -0.030, -0.030, -0.025, -0.019, -0.016, -0.009, -0.005, 0.004];
  imm st = [0.036, 0.040, 0.040, 0.038, 0.036, 0.044, 0.031, 0.040, 0.028, 0.030];
  mut side = 0;
  while side < 2 {
    imm sign = if side == 0 { 1.; } else { -1.; };
    mut lead = new Array[u32, 10] <- fill 0u32;
    mut trail = new Array[u32, 10] <- fill 0u32;
    mut s = 0usize;
    while s < 10usize {
      lead[s] = addVertex(&mut m, new Vec3(sign * sx[s], 0., sl[s]), up, 1., 0.);
      trail[s] = addVertex(&mut m, new Vec3(sign * sx[s], 0., st[s]), up, 1., 0.);
      s = s + 1usize;
    }
    imm tip = addVertex(&mut m, new Vec3(sign * 0.245, 0., 0.014), up, 1., 0.);
    s = 0usize;
    while s < 9usize {
      addTriangle(&mut m, lead[s], trail[s], trail[s + 1usize]);
      addTriangle(&mut m, lead[s], trail[s + 1usize], lead[s + 1usize]);
      s = s + 1usize;
    }
    addTriangle(&mut m, lead[9], trail[9], tip);
    side = side + 1;
  }
  m.addGroup(0u32, u32.from(m.indices.len()), 0u32);
  m;
}

