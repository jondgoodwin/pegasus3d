// The browser's own shaders: the pipelines a shaded Look (Look.shaded) is
// drawn by, through render's custom pipelines. A world names one by its
// SHADER_ number (parts.cone) and hands it parameters and a Field; it
// never sends code. Each is a Slang file beside this one, compiled ahead of
// time by Cone's tools/shaders/shaders.py run over this folder:
//
//   python C:\src\cone\tools\shaders\shaders.py src
//
// which writes its SPIR-V between the markers below. Terrain, water, the sky
// and the birds will each add one here.

// The custom pipeline that draws 'shader' (SHADER_...), made now; none for
// SHADER_STANDARD or a number not known
pub fn makeShaderPipeline(renderer &mut Renderer, device &mut Device, shader u32) PipelineHandle {
  if shader == SHADER_HEIGHTFIELD {
    // Its material: 32 bytes of parameters and one r32float texture, read
    // texel by texel in the vertex stage; the position stream alone
    imm textures = [TEXTURE_SAMPLE_TYPE_UNFILTERABLE_FLOAT];
    imm desc = new CustomPipeline(spirv: &HEIGHTFIELD_SPIRV, textures: &textures, paramBytes: 32u64, streams: 1u32);
    return renderer.addPipeline(device, &desc);
  }
  // The island's: islandshaders.cone
  if shader == SHADER_TERRAIN { return makeTerrainPipeline(renderer, device); }
  if shader == SHADER_WATER { return makeWaterPipeline(renderer, device); }
  if shader == SHADER_LIGHT_POOL {
    // Light painted on the ground (lightpool.slang): no textures, 32 bytes
    // of parameters, see-through (added after everything opaque), both
    // faces (a pool on a steep bank may be seen from either side)
    imm desc = new CustomPipeline(spirv: &LIGHTPOOL_SPIRV, textures: noTextures(), paramBytes: 32u64,
      cullMode: CULL_MODE_NONE, alphaMode: ALPHA_BLEND);
    return renderer.addPipeline(device, &desc);
  }
  if shader == SHADER_INTERIOR {
    // A lit room behind a window (interior.slang): no textures, opaque
    imm desc = new CustomPipeline(spirv: &INTERIOR_SPIRV, textures: noTextures(), paramBytes: 32u64);
    return renderer.addPipeline(device, &desc);
  }
  if shader == SHADER_BROOK {
    // The brook's water (brook.slang): no textures, 32 bytes of parameters, see-through, both
    // faces (a bank may hide one side of a ribbon laid over a slope)
    imm desc = new CustomPipeline(spirv: &BROOK_SPIRV, textures: noTextures(), paramBytes: 32u64,
      cullMode: CULL_MODE_NONE, alphaMode: ALPHA_BLEND);
    return renderer.addPipeline(device, &desc);
  }
  PipelineHandle.none();
}

