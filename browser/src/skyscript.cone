// The sky's part of the scripted run: after the cottage close-ups (frame
// 960), the day clock is set to a series of hours and the sky, the light and
// the birds are saved from the walker's place beside the cottage, a window of
// ten frames each (the clock set at the window's first frame, the picture
// saved at its fifth). The hours run forward, noon first, to the next dawn,
// so the timers only ever see time pass.
//
//   window  hour   what is looked at
//     0     12.0   the cottage, under noon (the ground and the sky together)
//    1-4    12.0   four birds close up, from beside them (their wings)
//     5     12.0   the flock from the ground, over the cottage
//     6     15.5   the cottage in mid-afternoon
//     7     17.18  the cottage at sunset (15 October)
//     8     17.18  the sunset itself: towards the sun, level
//     9     17.88  the cottage at dusk
//    10     17.88  dusk's west
//    11     18.58  the deep dusk's west
//    12     23.0   the cottage by moonlight
//    13     23.0   the moon
//    14     25.5   the stars, high, away from the moon
//    15     30.43  dawn in the east
//    16     31.0   the cottage in the morning

pub const SKY_FROM = 1000u64;   // (after the island's views, 960 to 999)
pub const SKY_WINDOW = 10u64;
pub const SKY_WINDOWS = 17u64;

// The window frame 'f' is in
fn skyWindow(f u64) u64 { (f - SKY_FROM) / SKY_WINDOW; }

// The hour the day clock is set to for window 'w' (24 and over: the next day)
fn skyHour(w u64) f32 {
  if w <= 5u64 { return 12.; }
  if w == 6u64 { return 15.5; }
  // (the evening's hours were 19.2, 19.9 and 20.6 and the morning's 28.4 and 29 in May; dusk is now 17.475, dawn 30.525)
  if w <= 8u64 { return 17.175; }
  if w <= 10u64 { return 17.875; }
  if w == 11u64 { return 18.575; }
  if w <= 13u64 { return 23.; }
  if w == 14u64 { return 25.5; }
  if w == 15u64 { return 30.425; }
  31.;
}

// The picture's name for window 'w'
fn skyName(w u64) &Array[u8] {
  if w == 0u64 { return "sky-noon"; }
  if w == 1u64 { return "sky-bird-1"; }
  if w == 2u64 { return "sky-bird-2"; }
  if w == 3u64 { return "sky-bird-3"; }
  if w == 4u64 { return "sky-bird-4"; }
  if w == 5u64 { return "sky-flock"; }
  if w == 6u64 { return "sky-afternoon"; }
  if w == 7u64 { return "sky-sunset-cottage"; }
  if w == 8u64 { return "sky-sunset-sun"; }
  if w == 9u64 { return "sky-dusk-cottage"; }
  if w == 10u64 { return "sky-dusk-west"; }
  if w == 11u64 { return "sky-deepdusk"; }
  if w == 12u64 { return "sky-night-cottage"; }
  if w == 13u64 { return "sky-night-moon"; }
  if w == 14u64 { return "sky-night-stars"; }
  if w == 15u64 { return "sky-dawn"; }
  "sky-morning-cottage";
}

// The sky pictures saved at frame 'f', or an empty name
pub fn skyShotAt(f u64) &Array[u8] {
  if f < SKY_FROM or f >= SKY_FROM + SKY_WINDOW * SKY_WINDOWS { return ""; }
  if (f - SKY_FROM) % SKY_WINDOW != 4u64 { return ""; }
  skyName(skyWindow(f));
}

// The sky's requests of the scene at frame 'f': the day clock set at the
// first frame of each window whose hour is not the last's
pub fn skyDrive(st &mut SceneState, f u64) {
  if f < SKY_FROM or f >= SKY_FROM + SKY_WINDOW * SKY_WINDOWS { return; }
  if (f - SKY_FROM) % SKY_WINDOW != 0u64 { return; }
  imm w = skyWindow(f);
  if w > 0u64 and skyHour(w) == skyHour(w - 1u64) { return; }
  // 60 s of scene time an hour, from the clock's start hour
  imm seconds = f64.from(skyHour(w) - 7.) * 60d;
  st.scene.clock.ns = u64.from(nanosOf(seconds));
}

// The walker's place beside the cottage: 15 m out, 3 m to the right of the door, at eye height
fn skyEye() Vec3 { ow(-10. + 3., 1.7, -24. + 15.); }

// A point 50 m from the eye towards 'sun's compass bearing at 'pitch' radians up
fn skyToward(dir Vec3, pitch f32) Vec3 {
  imm h = new Vec3(dir.x, 0., dir.z);
  imm flat = if h.length() < 0.0001 { new Vec3(0., 0., -1.); } else { h.normalize(); };
  skyEye() + new Vec3(flat.x * cos(pitch), sin(pitch), flat.z * cos(pitch)) * 50.;
}

// The eye for window 'w' (frame 'f' is in it)
pub fn skyView(st &mut SceneState, f u64) Pose {
  imm w = skyWindow(f);
  imm eye = skyEye();
  // The day the render actor's rig is set to (skyrig.cone), and the scene actor's flock
  imm cfg = dayConfig();
  imm flock = &st.birds.flock;
  imm day = DaySky.at(&cfg, skyHour(w));
  // The cottage: its middle, from the walker's eye, tilted up to take in the sky
  imm cottage = ow(-10. + 0.3, 4.5, -24.);
  if w == 0u64 or w == 6u64 or w == 7u64 or w == 9u64 or w == 12u64 or w == 16u64 { return lookFrom(eye, cottage); }
  if w >= 1u64 and w <= 4u64 {
    // A bird, from beside it, a little behind, level with it
    imm which = if w == 1u64 { 0usize; } elif w == 2u64 { 5usize; } elif w == 3u64 { 12usize; } else { 20usize; };
    imm pose = flock.pose(which);
    imm at = pose.position;
    // Window 2 from above and behind, window 3 from ahead, the others from the side
    if w == 2u64 { return lookFrom(at + pose.up * 2.4 - pose.forward * 1.6, at); }
    if w == 3u64 { return lookFrom(at + pose.forward * 3.4 + pose.up * 0.4, at); }
    return lookFrom(at + pose.right * 3.0 - pose.forward * 1.0 + pose.up * 0.5, at);
  }
  if w == 5u64 {
    imm home = flock.params.home;
    return lookFrom(eye, new Vec3(home.x, home.y + 26., home.z));
  }
  // Towards the sun, level with its bearing, low
  if w == 8u64 { return lookFrom(eye, skyToward(day.sunDir, 0.09)); }
  if w == 10u64 { return lookFrom(eye, skyToward(day.sunDir, 0.2)); }
  if w == 11u64 { return lookFrom(eye, skyToward(day.sunDir, 0.2)); }
  if w == 15u64 { return lookFrom(eye, skyToward(day.sunDir, 0.14)); }
  // The moon: at its bearing, its height less 10 degrees, so it sits in the upper picture
  if w == 13u64 {
    imm el = asin(day.moonDir.y);
    return lookFrom(eye, skyToward(day.moonDir, el - 0.17));
  }
  // The stars: away from the moon and high
  imm away = new Vec3(0. - day.moonDir.x, 0., 0. - day.moonDir.z);
  lookFrom(eye, skyToward(away, 0.95));
}

// The lens for window 'w': 23 degrees for a bird, else the walk's
pub fn skyFov(f u64) f32 {
  imm w = skyWindow(f);
  if w >= 1u64 and w <= 4u64 { return 0.4; }
  FOV;
}
