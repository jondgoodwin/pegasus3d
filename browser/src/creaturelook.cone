// How the creatures look: the labyrinth's guards and the Minotaur, made from the mannequin kit (mannequin.cone's body, skinned to the same
// humanoid skeleton and walked by the same gait) with procedural additions. Nothing is a texture and nothing is copied from the reference
// photos; the proportions are looked at, not traced.
//
// THE METHOD. A creature is a mannequin whose body mesh gets rigid pieces added, each wholly one bone's (addRigid), exactly as the
// mannequin's nose and hands are; and, for the pieces that are another colour, extra parts under the being's own part, each a skinned
// mesh of pieces on bones with a material of its own, posed by the same skinning matrices as the body (the view sends the one
// list of matrices to each part: creatureview.cone). One part, one material: a guard is a body part (the skin) and four more (the cloth
// of the kilt and the plume, the bronze of the helmet, belt and spear point, the cream hide of the shield, the dark of the shield's spots
// and the spear's shaft); the Minotaur a body part that includes the bull's head, and three more (the horns and eyes in ivory, the
// loincloth, the bronze of the nose ring and bracelets).
//
// THE GUARDS (looked at: the Shield frieze of Knossos, a fresco of Minoan figure-of-eight shields in cream hide spotted dark; the
// kilt and the belted wasp waist of Minoan men; the film's guards in their tall helmets and shields). A kilt hanging from a belt that
// pinches the waist, a bronze helmet with a long plume, a spear held upright in the right hand, and on the left forearm a
// figure-of-eight shield: two flat lobes, pinched at the waist, of cream hide with dark spots. The two guards differ in the cloth
// (the west one's blue, the east one's red), so a guard can be named by its colour.
//
// THE MINOTAUR (looked at: the bull-leaping fresco's bull, long-headed, deep-chested, with a high shoulder and horns that sweep
// out and up): taller than a man (2.4 m), a broad hump of shoulder, a bull's head instead of a man's (a long skull, a muzzle with a
// bronze ring through it, ears, eyes, and two horns that curve out and up), a dark red loincloth.

// The looks (ObjectSpec.index of an OBJ_CREATURE)
pub const CL_GUARD_W = 1u32;
pub const CL_GUARD_E = 2u32;
pub const CL_MINOTAUR = 3u32;

// sRGB 0-255 as a linear colour
fn crSrgb(r f32, g f32, b f32) Color {
  new Color(libc.powf(r / 255., 2.2), libc.powf(g / 255., 2.2), libc.powf(b / 255., 2.2), 1.);
}

// An ellipsoid of radii 'r' at 'c', turned by 'turn': a sphere of 'seg' segments stretched
fn crEllipsoid(c Vec3, r Vec3, turn Quat, seg i32) Mesh {
  mut m = Mesh.sphere(1., seg);
  m.transform(Mat4.fromTrs(c, turn, r));
  m;
}

// The same with the triangles whose middle is below the height 'cut' left out: a dome open underneath
fn crDome(c Vec3, r Vec3, cut f32, seg i32) Mesh {
  imm full = crEllipsoid(c, r, Quat.identity(), seg);
  mut m = Mesh.empty();
  m.append(&full);
  m.indices.clear();
  mut t = 0usize;
  while t + 2usize < full.indices.len() {
    imm a = *full.indices[t];
    imm b = *full.indices[t + 1usize];
    imm d = *full.indices[t + 2usize];
    imm y = (full.positions[usize.from(a)].y + full.positions[usize.from(b)].y + full.positions[usize.from(d)].y) / 3.;
    if y >= cut {
      m.indices.push(a);
      m.indices.push(b);
      m.indices.push(d);
    }
    t = t + 3usize;
  }
  m;
}

// A tube along the points 'pts' with a radius at each, 'seg' sides: the rings' frames are made from the line's own turns
fn crTube(pts &List[Vec3], radii &List[f32], seg usize) Mesh {
  mut m = Mesh.empty();
  imm n = pts.len();
  if n < 2usize { return m; }
  mut i = 0usize;
  while i < n {
    imm prev = if i == 0usize { *pts[0usize]; } else { *pts[i - 1usize]; };
    imm next = if i + 1usize == n { *pts[n - 1usize]; } else { *pts[i + 1usize]; };
    imm t = (next - prev).normalize();
    imm ref = if libc.fabsf(t.y) > 0.9 { new Vec3(1., 0., 0.); } else { new Vec3(0., 1., 0.); };
    imm nn = ref.cross(t).normalize();
    imm bb = t.cross(nn);
    mut a = 0usize;
    while a < seg {
      imm ang = 2. * pi * f32.from(a) / f32.from(seg);
      imm dir = nn * libc.cosf(ang) + bb * libc.sinf(ang);
      m.positions.push(*pts[i] + dir * *radii[i]);
      a = a + 1usize;
    }
    i = i + 1usize;
  }
  i = 0usize;
  while i + 1usize < n {
    mut a = 0usize;
    while a < seg {
      imm a1 = (a + 1usize) % seg;
      imm v00 = u32.from(i * seg + a);
      imm v01 = u32.from(i * seg + a1);
      imm v10 = u32.from((i + 1usize) * seg + a);
      imm v11 = u32.from((i + 1usize) * seg + a1);
      m.indices.push(v00);
      m.indices.push(v01);
      m.indices.push(v10);
      m.indices.push(v01);
      m.indices.push(v11);
      m.indices.push(v10);
      a = a + 1usize;
    }
    i = i + 1usize;
  }
  m.computeSmoothNormals();
  m;
}

// An elliptical band from height y0 (radii rx0, rz0) to y1 (rx1, rz1), centred at (cx, cz): a kilt, a belt
fn crBand(cx f32, cz f32, y0 f32, y1 f32, rx0 f32, rz0 f32, rx1 f32, rz1 f32, seg usize) Mesh {
  mut m = Mesh.empty();
  mut a = 0usize;
  while a < seg {
    imm ang = 2. * pi * f32.from(a) / f32.from(seg);
    m.positions.push(new Vec3(cx + libc.cosf(ang) * rx0, y0, cz + libc.sinf(ang) * rz0));
    a = a + 1usize;
  }
  a = 0usize;
  while a < seg {
    imm ang = 2. * pi * f32.from(a) / f32.from(seg);
    m.positions.push(new Vec3(cx + libc.cosf(ang) * rx1, y1, cz + libc.sinf(ang) * rz1));
    a = a + 1usize;
  }
  a = 0usize;
  while a < seg {
    imm a1 = (a + 1usize) % seg;
    imm b0 = u32.from(a);
    imm b1 = u32.from(a1);
    imm t0 = u32.from(seg + a);
    imm t1 = u32.from(seg + a1);
    // (outward: the ring runs counterclockwise seen from above, the lower ring first)
    m.indices.push(b0);
    m.indices.push(t0);
    m.indices.push(b1);
    m.indices.push(b1);
    m.indices.push(t0);
    m.indices.push(t1);
    a = a + 1usize;
  }
  m.computeSmoothNormals();
  m;
}

// A piece wholly bone 'bone''s, added to the mesh 'dest' and its skin
fn crRigid(dest &mut Mesh, skin &mut Skin, piece &Mesh, bone usize) {
  mut v = 0usize;
  while v < piece.positions.len() {
    skin.push(u32.from(bone), u32.from(bone), u32.from(bone), u32.from(bone), 1., 0., 0., 0.);
    v = v + 1usize;
  }
  dest.append(piece);
}

fn crPoint(x f32, y f32, z f32) Vec3 { new Vec3(x, y, z); }

// One guard's extra pieces, in the parts' meshes (cloth, bronze, hide, dark), by the skeleton at rest
fn guardPieces(rest &List[Transform3], h f32, cloth &mut Mesh, clothSkin &mut Skin, bronze &mut Mesh, bronzeSkin &mut Skin, hide &mut Mesh,
    hideSkin &mut Skin, dark &mut Mesh, darkSkin &mut Skin) {
  // the kilt from the belt to the thigh, and the belt that pinches the waist
  crRigid(cloth, clothSkin, &crBand(0., 0.004 * h, 0.395 * h, 0.575 * h, 0.195 * h, 0.120 * h, 0.150 * h, 0.088 * h, 20usize), bonepose.PELVIS);
  crRigid(bronze, bronzeSkin, &crBand(0., 0., 0.572 * h, 0.625 * h, 0.121 * h, 0.073 * h, 0.117 * h, 0.069 * h, 20usize), bonepose.PELVIS);
  // the helmet, a dome with a plume that runs from the crown down the back
  crRigid(bronze, bronzeSkin, &crDome(crPoint(0., 0.962 * h, 0.), crPoint(0.056 * h, 0.052 * h, 0.066 * h), 0.947 * h, 14), bonepose.HEAD);
  mut plume = List[Vec3].empty();
  plume.push(crPoint(0., 1.002 * h, -0.045 * h));
  plume.push(crPoint(0., 1.050 * h, -0.012 * h));
  plume.push(crPoint(0., 1.064 * h, 0.038 * h));
  plume.push(crPoint(0., 1.030 * h, 0.088 * h));
  plume.push(crPoint(0., 0.968 * h, 0.108 * h));
  mut plumeR = List[f32].empty();
  plumeR.push(0.010 * h); plumeR.push(0.016 * h); plumeR.push(0.017 * h); plumeR.push(0.013 * h); plumeR.push(0.005 * h);
  crRigid(cloth, clothSkin, &crTube(&plume, &plumeR, 8usize), bonepose.HEAD);
  // the spear in the right hand: a shaft from the ground to above the head, a bronze leaf at its tip
  imm hand = (*rest[bonepose.HAND_R]).translation;
  mut shaft = List[Vec3].empty();
  shaft.push(crPoint(hand.x, 0.02 * h, hand.z - 0.02 * h));
  shaft.push(crPoint(hand.x, 0.72 * h, hand.z - 0.02 * h));
  shaft.push(crPoint(hand.x, 1.34 * h, hand.z - 0.02 * h));
  mut shaftR = List[f32].empty();
  shaftR.push(0.0075 * h); shaftR.push(0.0075 * h); shaftR.push(0.0065 * h);
  crRigid(dark, darkSkin, &crTube(&shaft, &shaftR, 8usize), bonepose.HAND_R);
  crRigid(bronze, bronzeSkin, &crEllipsoid(crPoint(hand.x, 1.395 * h, hand.z - 0.02 * h), crPoint(0.007 * h, 0.060 * h, 0.020 * h), Quat.identity(), 10), bonepose.HAND_R);
  crRigid(bronze, bronzeSkin, &crEllipsoid(crPoint(hand.x, 1.335 * h, hand.z - 0.02 * h), crPoint(0.013 * h, 0.012 * h, 0.013 * h), Quat.identity(), 8), bonepose.HAND_R);
  // the figure-of-eight shield on the left forearm: two flat lobes, pinched where they meet, spotted
  imm elbow = (*rest[bonepose.FOREARM_L]).translation;
  imm wrist = (*rest[bonepose.HAND_L]).translation;
  imm sx = -1.;
  imm cx = (elbow.x + wrist.x) * 0.5 + sx * 0.065 * h;
  imm cy = (elbow.y + wrist.y) * 0.5;
  imm cz = (elbow.z + wrist.z) * 0.5 - 0.01 * h;
  crRigid(hide, hideSkin, &crEllipsoid(crPoint(cx, cy + 0.138 * h, cz), crPoint(0.013 * h, 0.158 * h, 0.165 * h), Quat.identity(), 14), bonepose.FOREARM_L);
  crRigid(hide, hideSkin, &crEllipsoid(crPoint(cx, cy - 0.138 * h, cz), crPoint(0.013 * h, 0.158 * h, 0.165 * h), Quat.identity(), 14), bonepose.FOREARM_L);
  // (the spots on its outer face, dark flat ovals; the boss in bronze)
  imm spots Array[f32, 16] = [0.14, 0.05, 0.19, -0.06, 0.21, 0.09, 0.11, -0.11, -0.12, 0.06, -0.17, -0.07, -0.20, 0.10, -0.10, -0.12];
  mut s = 0usize;
  while s < 8usize {
    imm dy = spots[s * 2usize] * h;
    imm dz = spots[s * 2usize + 1usize] * h;
    crRigid(dark, darkSkin, &crEllipsoid(crPoint(cx + sx * 0.0125 * h, cy + dy, cz + dz), crPoint(0.004 * h, 0.026 * h, 0.021 * h), Quat.identity(), 8), bonepose.FOREARM_L);
    s = s + 1usize;
  }
  // (the spindle down its middle that the frieze's shields have, in the guard's own colour, with a small bronze boss at the waist)
  crRigid(cloth, clothSkin, &crEllipsoid(crPoint(cx + sx * 0.0125 * h, cy, cz), crPoint(0.005 * h, 0.285 * h, 0.030 * h), Quat.identity(), 10), bonepose.FOREARM_L);
  crRigid(bronze, bronzeSkin, &crEllipsoid(crPoint(cx + sx * 0.013 * h, cy, cz), crPoint(0.010 * h, 0.022 * h, 0.022 * h), Quat.identity(), 8), bonepose.FOREARM_L);
}

// The Minotaur's pieces: onto the body itself (hide: the skull, muzzle, ears and shoulders), and the ivory (horns, eyes), the cloth
// (loincloth) and the bronze (nose ring, bracelets) parts
fn bullPieces(rest &List[Transform3], h f32, body &mut Mesh, bodySkin &mut Skin, ivory &mut Mesh, ivorySkin &mut Skin, cloth &mut Mesh,
    clothSkin &mut Skin, bronze &mut Mesh, bronzeSkin &mut Skin) {
  // the skull, wider and longer than a man's, and the muzzle running forward and down from it
  crRigid(body, bodySkin, &crEllipsoid(crPoint(0., 0.948 * h, -0.010 * h), crPoint(0.062 * h, 0.058 * h, 0.078 * h), Quat.identity(), 14), bonepose.HEAD);
  mut snout = List[Vec3].empty();
  snout.push(crPoint(0., 0.940 * h, -0.045 * h));
  snout.push(crPoint(0., 0.926 * h, -0.098 * h));
  snout.push(crPoint(0., 0.910 * h, -0.145 * h));
  mut snoutR = List[f32].empty();
  snoutR.push(0.046 * h); snoutR.push(0.038 * h); snoutR.push(0.033 * h);
  crRigid(body, bodySkin, &crTube(&snout, &snoutR, 12usize), bonepose.HEAD);
  crRigid(body, bodySkin, &crEllipsoid(crPoint(0., 0.907 * h, -0.150 * h), crPoint(0.036 * h, 0.030 * h, 0.030 * h), Quat.identity(), 10), bonepose.HEAD);
  // the brow over the eyes
  crRigid(body, bodySkin, &crEllipsoid(crPoint(0., 0.972 * h, -0.052 * h), crPoint(0.056 * h, 0.014 * h, 0.030 * h), Quat.identity(), 10), bonepose.HEAD);
  // the ears, out to each side and a little up
  crRigid(body, bodySkin, &crEllipsoid(crPoint(0.082 * h, 0.964 * h, 0.006 * h), crPoint(0.030 * h, 0.012 * h, 0.016 * h), Quat.angleAxis(0.5, crPoint(0., 0., 1.)), 8), bonepose.HEAD);
  crRigid(body, bodySkin, &crEllipsoid(crPoint(-0.082 * h, 0.964 * h, 0.006 * h), crPoint(0.030 * h, 0.012 * h, 0.016 * h), Quat.angleAxis(-0.5, crPoint(0., 0., 1.)), 8), bonepose.HEAD);
  // the hump of the shoulders, high and broad
  crRigid(body, bodySkin, &crEllipsoid(crPoint(0., 0.805 * h, 0.012 * h), crPoint(0.150 * h, 0.075 * h, 0.082 * h), Quat.identity(), 14), bonepose.CHEST);
  crRigid(body, bodySkin, &crEllipsoid(crPoint(0.118 * h, 0.800 * h, -0.004 * h), crPoint(0.048 * h, 0.050 * h, 0.050 * h), Quat.identity(), 10), bonepose.CLAVICLE_R);
  crRigid(body, bodySkin, &crEllipsoid(crPoint(-0.118 * h, 0.800 * h, -0.004 * h), crPoint(0.048 * h, 0.050 * h, 0.050 * h), Quat.identity(), 10), bonepose.CLAVICLE_L);
  // the horns, curving out and then up and forward, ivory
  mut s = 0usize;
  while s < 2usize {
    imm sg = if s == 0usize { 1.; } else { -1.; };
    mut horn = List[Vec3].empty();
    horn.push(crPoint(sg * 0.044 * h, 0.984 * h, -0.010 * h));
    horn.push(crPoint(sg * 0.094 * h, 0.992 * h, -0.016 * h));
    horn.push(crPoint(sg * 0.136 * h, 1.020 * h, -0.030 * h));
    horn.push(crPoint(sg * 0.150 * h, 1.062 * h, -0.048 * h));
    horn.push(crPoint(sg * 0.146 * h, 1.098 * h, -0.066 * h));
    mut hornR = List[f32].empty();
    hornR.push(0.017 * h); hornR.push(0.014 * h); hornR.push(0.010 * h); hornR.push(0.006 * h); hornR.push(0.0015 * h);
    crRigid(ivory, ivorySkin, &crTube(&horn, &hornR, 8usize), bonepose.HEAD);
    // the eye
    crRigid(ivory, ivorySkin, &crEllipsoid(crPoint(sg * 0.034 * h, 0.958 * h, -0.062 * h), crPoint(0.010 * h, 0.009 * h, 0.008 * h), Quat.identity(), 8), bonepose.HEAD);
    s = s + 1usize;
  }
  // the loincloth, a dark red kilt a little longer than a man's
  crRigid(cloth, clothSkin, &crBand(0., 0.004 * h, 0.385 * h, 0.585 * h, 0.205 * h, 0.128 * h, 0.155 * h, 0.092 * h, 20usize), bonepose.PELVIS);
  // the ring through the muzzle: a circle of bronze hanging below the nose, and a bronze belt
  mut ring = List[Vec3].empty();
  mut ringR = List[f32].empty();
  mut k = 0usize;
  while k <= 12usize {
    imm ang = 2. * pi * f32.from(k) / 12.;
    ring.push(crPoint(0.024 * h * libc.sinf(ang), 0.880 * h + 0.024 * h * (1. - libc.cosf(ang)) * 0.6 - 0.002 * h, -0.162 * h + 0.014 * h * libc.cosf(ang)));
    ringR.push(0.0042 * h);
    k = k + 1usize;
  }
  crRigid(bronze, bronzeSkin, &crTube(&ring, &ringR, 6usize), bonepose.HEAD);
  crRigid(bronze, bronzeSkin, &crBand(0., 0., 0.572 * h, 0.628 * h, 0.124 * h, 0.076 * h, 0.120 * h, 0.072 * h, 20usize), bonepose.PELVIS);
}

// The materials of a look, by part: skin (the body), cloth, bronze, hide, dark / ivory
fn crLookCloth(look u32) Color {
  if look == CL_GUARD_W { return crSrgb(46., 82., 168.); }
  if look == CL_GUARD_E { return crSrgb(176., 44., 36.); }
  crSrgb(98., 28., 24.);
}

// A creature of look 'look' and 'height' metres sent into the scene as 'root' (the being's own part): the body, a skinned mesh in
// 'color', and its extra parts under it. Answers the extra parts, whose skinning the view sets with the body's.
pub fn spawnCreature(door &mut Door, look u32, height f32, color Color, root PartId) List[PartId] {
  imm skel = bonepose.humanoid(height);
  mut rest = List[Transform3].empty();
  skel.modelTransforms(&skel.restPose(), &mut rest);
  mut bodySkin = Skin.empty();
  mut body = bodyMesh(&skel, height, &mut bodySkin);
  mut cloth = Mesh.empty();
  mut clothSkin = Skin.empty();
  mut bronze = Mesh.empty();
  mut bronzeSkin = Skin.empty();
  mut hide = Mesh.empty();
  mut hideSkin = Skin.empty();
  mut dark = Mesh.empty();
  mut darkSkin = Skin.empty();
  mut ivory = Mesh.empty();
  mut ivorySkin = Skin.empty();
  if look == CL_MINOTAUR {
    bullPieces(&rest, height, &mut body, &mut bodySkin, &mut ivory, &mut ivorySkin, &mut cloth, &mut clothSkin, &mut bronze, &mut bronzeSkin);
  } else {
    guardPieces(&rest, height, &mut cloth, &mut clothSkin, &mut bronze, &mut bronzeSkin, &mut hide, &mut hideSkin, &mut dark, &mut darkSkin);
  }
  mut parts = List[PartId].empty();
  // (the hide of the Minotaur is dull; a guard's skin has a little sheen)
  imm skinMat = door.defineMaterial(Look.shiny(color, if look == CL_MINOTAUR { 0.07; } else { 0.18; }, if look == CL_MINOTAUR { 6.; } else { 10.; }), Image.empty(), Maps.none());
  imm bodyMesh2 = door.defineSkinnedMesh(body, bodySkin);
  door.send(Request.Show(root, bodyMesh2, skinMat, 0.));
  // each extra part: its material, its skinned mesh, shown under the body's part
  if cloth.triangleCount() > 0usize {
    imm part = door.newChild("cloth", root);
    imm mat = door.defineMaterial(Look.physicallyBased(crLookCloth(look), 0.85, 0.), Image.empty(), Maps.none());
    door.send(Request.Show(part, door.defineSkinnedMesh(cloth, clothSkin), mat, 0.));
    parts.push(part);
  }
  if bronze.triangleCount() > 0usize {
    imm part = door.newChild("bronze", root);
    imm mat = door.defineMaterial(Look.physicallyBased(crSrgb(184., 130., 58.), 0.35, 0.7), Image.empty(), Maps.none());
    door.send(Request.Show(part, door.defineSkinnedMesh(bronze, bronzeSkin), mat, 0.));
    parts.push(part);
  }
  if hide.triangleCount() > 0usize {
    imm part = door.newChild("hide", root);
    imm mat = door.defineMaterial(Look.physicallyBased(crSrgb(226., 196., 146.), 0.7, 0.), Image.empty(), Maps.none());
    door.send(Request.Show(part, door.defineSkinnedMesh(hide, hideSkin), mat, 0.));
    parts.push(part);
  }
  if dark.triangleCount() > 0usize {
    imm part = door.newChild("dark", root);
    imm mat = door.defineMaterial(Look.physicallyBased(crSrgb(56., 34., 22.), 0.6, 0.), Image.empty(), Maps.none());
    door.send(Request.Show(part, door.defineSkinnedMesh(dark, darkSkin), mat, 0.));
    parts.push(part);
  }
  if ivory.triangleCount() > 0usize {
    imm part = door.newChild("ivory", root);
    imm mat = door.defineMaterial(Look.physicallyBased(crSrgb(238., 228., 200.), 0.45, 0.), Image.empty(), Maps.none());
    door.send(Request.Show(part, door.defineSkinnedMesh(ivory, ivorySkin), mat, 0.));
    parts.push(part);
  }
  parts;
}
