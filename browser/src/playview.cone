// The playground in the view: what each browser does with the props, the spells and the paint the simulation tells it of
// (props.cone, spells.cone and spellsim.cone are the truth; this only draws and listens).
//
//   THE PROPS. The snapshot lists the pins and the ball once any has been moved (WorldState.props). The view keeps the last three
//   and places each prop's part by them: single player, where nothing is late, by the newest; connected, interpolated at the tick
//   everything else is drawn at (the beings' draw delay), between the two samples either side of it. The parts are the world's
//   (bakedworld/pins.cone and the ball): the view learns their ids when it builds those objects (buildObject), slot 0 the ball and
//   slots 1 to 10 the pins in order.
//
//   THE SPELLS' POSE. The snapshot lists the spells in force (WorldState.fx); a figure whose spell began at a tick it has not seen
//   is told (Figure.setFx), and lays the pose over its own gait (spells.cone) every step, as the simulation's copy does.
//
//   THE PAINT. A burst of paint the simulation tells (ToView.Burst) is a splat kept for SPLAT_SECONDS, drawn as a decal on whatever
//   is in its box: a surface's in the world's coordinates, a being's in the being's own frame, so it goes where that being goes
//   (only its place and heading: the arm that swings does not carry the splat on it; the honest version without a paint layer on the
//   mannequin's skin). It fades over its last SPLAT_FADE seconds, and at most MAX_SPLATS are kept (the oldest goes first).
//
//   THE KEYS. B bowls the ball, F1 throws paint, F2 zaps and F3 jigs the being aimed at. The aim is the camera's own ray (its eye and
//   direction as last drawn); the being aimed at is chosen by worldinteract's targeting (the cone in front of the eye, nearest to its
//   middle and then nearest) and kept by its lock-on for a grace time, highlighted while locked. Line of sight is the simulation's
//   to judge (a spell with the way blocked is refused there), so the view's targeting asks for none.

// (worldinteract is imported by browser.cone)

// (the render actor's decal material when there is none)
pub const SPLAT_NONE = 0xFFFFFFFFu32;
// How long a splat lasts, and how much of that it fades over (seconds), and the most kept
pub const SPLAT_SECONDS f32 = 20.;
pub const SPLAT_FADE f32 = 6.;
pub const MAX_SPLATS = 48usize;
// A splat's box: across and deep (metres); the depth reaches this far each side of the surface
const SPLAT_SIZE f32 = 0.7;
const SPLAT_DEPTH f32 = 0.5;
// How long the lock-on holds a target that is out of view or out of range (seconds), and the lock-on's reach (metres)
const LOCK_GRACE f32 = 1.5;
const LOCK_RANGE f32 = 22.;

pub struct PropSample {
  pub tick u64;
  pub list List[PropState];
}

pub struct SplatView {
  pub being u32;              // the being it is on (its own frame), or NO_TARGET: the world's
  pub position Vec3;
  pub normal Vec3;
  pub color u32;
  pub tick u64;               // the simulation tick it happened at
}

pub struct PlayView {
  pub older PropSample;       // the last two snapshots' props
  pub newer PropSample;
  pub have u32;               // how many of them there are (0, 1, 2)
  pub parts List[PartId];     // the props' parts, by slot: the ball, then the ten pins
  pub splats List[SplatView];
  pub lock worldinteract.LockOn;
  pub locked usize;           // the being highlighted as locked, or NO_ROW
  pub sent u32;               // actions sent, counted
  pub bursts u32;             // bursts of paint received
  pub cracks u32;             // zap cracks received (the sound is audioview's)
  pub autoStage u32;          // --autowalk's client: 0 before its bowl, 1 before its paint, 2 done (the net check)

  pub fn make() PlayView {
    new PlayView(new PropSample(0u64, List[PropState].empty()), new PropSample(0u64, List[PropState].empty()), 0u32, List[PartId].empty(), List[SplatView].empty(), worldinteract.LockOn.make(LOCK_GRACE), NO_ROW, 0u32,
      0u32, 0u32, 0u32)
  }
}

// The splat's picture, white with an alpha: a ragged blot with a ring of droplets round it (RGBA, 128 square, rows from the bottom;
// the paint's colour is the decal's tint). The blot's edge is a circle of 0.28 of the width pushed in and out by a few sine lobes, and
// the droplets are small discs at fixed bearings, so every splat is the same picture, turned about the surface's normal by its own angle
pub fn splatImage() Image {
  let n = 128;
  var img = new Image(n, n, 4, List[u8].withCapacity(usize.from(n * n * 4)));
  var y = 0;
  while y < n {
    var x = 0;
    while x < n {
      let u = (f32.from(x) + 0.5) / f32.from(n) - 0.5;
      let v = (f32.from(y) + 0.5) / f32.from(n) - 0.5;
      let r = libc.sqrtf(u * u + v * v);
      let a = libc.atan2f(v, u);
      let edge = 0.25 + 0.035 * libc.sinf(5. * a + 1.) + 0.025 * libc.sinf(9. * a + 2.) + 0.015 * libc.sinf(17. * a);
      var alpha = 1. - (r - edge) / 0.02;
      // The droplets: eight discs between 0.33 and 0.45 from the middle
      var k = 0;
      while k < 8 {
        let da = 6.2831855 * f32.from(k) / 8. + 0.3 * f32.from(k % 3);
        let dr = 0.34 + 0.045 * f32.from((k * 5) % 3);
        let dx = u - dr * libc.cosf(da);
        let dy = v - dr * libc.sinf(da);
        let rad = 0.018 + 0.008 * f32.from(k % 4);
        let dd = 1. - (libc.sqrtf(dx * dx + dy * dy) - rad) / 0.01;
        if dd > alpha { alpha = dd; }
        k = k + 1;
      }
      if alpha < 0. { alpha = 0.; }
      if alpha > 1. { alpha = 1.; }
      img.pixels.push(255u8);
      img.pixels.push(255u8);
      img.pixels.push(255u8);
      img.pixels.push(u8.from(u32.from(alpha * 255.)));
      x = x + 1;
    }
    y = y + 1;
  }
  img
}

// The colours of the paint, by number
pub fn paintColor(n u32) Color {
  if n == 0u32 { return new Color(0.95, 0.10, 0.55, 1.); }
  if n == 1u32 { return new Color(0.10, 0.75, 0.95, 1.); }
  if n == 2u32 { return new Color(0.98, 0.85, 0.10, 1.); }
  new Color(0.35, 0.85, 0.20, 1.)
}

// The parts of the world's objects the view has just built: the ball's, and the pins'
pub fn playNoteObject(pv &mut PlayView, index u32, parts &List[PartId]) {
  if index == PINS {
    // (the ball is slot 0; it is noted when its object is built, and a pin object may be built first)
    while pv.parts.len() < 1usize + PIN_COUNT { pv.parts.push(PartId.none()); }
    var k = 0usize;
    while k < PIN_COUNT and k < parts.len() { pv.parts.set(1usize + k, *parts[k]); k = k + 1usize; }
  } elif index == BALL {
    while pv.parts.len() < 1usize + PIN_COUNT { pv.parts.push(PartId.none()); }
    if parts.len() > 0usize { pv.parts.set(PROP_BALL, *parts[0usize]); }
  }
}

// A snapshot's props and spells taken: the props kept for placing, a spell not seen before given to its figure
pub fn playTakeState(pv &mut PlayView, tick u64, props &mut List[PropState], fx &List[FxState], cast &mut Cast) {
  if props.len() > 0usize {
    // The newer becomes the older, and this snapshot's props the newer
    pv.older.list <=> pv.newer.list;
    pv.older.tick = pv.newer.tick;
    pv.newer.list <=> *props;
    pv.newer.tick = tick;
    if pv.have < 2u32 { pv.have = pv.have + 1u32; }
  }
  var i = 0usize;
  while i < fx.len() {
    let f = *fx[i];
    let idx = usize.from(f.being);
    if idx < cast.beings.len() and cast.beings[idx].figure.active and cast.beings[idx].figure.fxStart != f.start {
      let age = f32.from(tick - f.start) / 60.;
      cast.beings[idx].figure.setFx(f.kind, f.start, age);
    }
    i = i + 1usize;
  }
}

// The props' parts placed: by the newest sample, or, if 'at' is a tick (connected), between the two either side of it
pub fn playPlaceProps(pv &mut PlayView, scene &mut ViewScene, at f64, newest bool) {
  if pv.have == 0u32 or pv.parts.len() < 1usize + PIN_COUNT { return; }
  var t = 1.f;
  if !newest and pv.have >= 2u32 {
    // Between the last two samples, where 'at' falls (held at either end)
    let span = f64.from(pv.newer.tick - pv.older.tick);
    t = if span > 0.0 { f32.from((at - f64.from(pv.older.tick)) / span) } else { 1. };
    if t < 0. { t = 0.; }
    if t > 1. { t = 1.; }
  }
  placeSample(pv, scene, t);
}

fn placeSample(pv &mut PlayView, scene &mut ViewScene, t f32) {
  let a = &pv.older;
  let b = &pv.newer;
  var i = 0usize;
  while i < b.list.len() {
    let pb = b.list[i];
    let slot = usize.from(pb.slot);
    if slot < pv.parts.len() and !pv.parts[slot].isNone() {
      var pos = pb.position;
      var rot = pb.rotation;
      // The same slot in the earlier sample
      var k = 0usize;
      while k < a.list.len() {
        if a.list[k].slot == pb.slot {
          pos = a.list[k].position.lerp(pb.position, t);
          rot = a.list[k].rotation.slerp(pb.rotation, t);
        }
        k = k + 1usize;
      }
      let s = if slot == PROP_BALL { 1. } else { PIN_SCALE };
      scene.applyPlace(*pv.parts[slot], new Transform3(pos, rot, new Vec3(s, s, s)));
    }
    i = i + 1usize;
  }
}

// A burst the simulation told: a splat kept, a crack counted
pub fn playBurst(pv &mut PlayView, kind u32, being u32, position Vec3, normal Vec3, color u32, tick u64) {
  if kind == BURST_PAINT {
    pv.bursts = pv.bursts + 1u32;
    pv.splats.push(new SplatView(being, position, normal, color, tick));
    while pv.splats.len() > MAX_SPLATS {
      var keep = List[SplatView].empty();
      var q = 1usize;
      while q < pv.splats.len() { keep.push(*pv.splats[q]); q = q + 1usize; }
      pv.splats <=> keep;
    }
  } elif kind == BURST_ZAP {
    pv.cracks = pv.cracks + 1u32;
  }
}

// The rotation that takes +y to the unit vector 'n'
fn upTo(n Vec3) Quat {
  let up = new Vec3(0., 1., 0.);
  let c = up.dot(n);
  if c > 0.99999 { return Quat.identity(); }
  if c < -0.99999 { return Quat.angleAxis(pi, new Vec3(1., 0., 0.)); }
  let axis = up.cross(n);
  let len = libc.sqrtf(axis.x * axis.x + axis.y * axis.y + axis.z * axis.z);
  Quat.angleAxis(libc.acosf(c), new Vec3(axis.x / len, axis.y / len, axis.z / len))
}

// The splats as this frame's decals; the old ones dropped. 'now' is the simulation's tick as the view has it (the newest snapshot's)
pub fn playSplats(pv &mut PlayView, cast &Cast, now u64, out &mut List[SplatDraw]) {
  out.clear();
  var keep = List[SplatView].empty();
  var i = 0usize;
  while i < pv.splats.len() {
    let s = *pv.splats[i];
    let age = f32.from(now - s.tick) / 60.;
    if age > SPLAT_SECONDS { i = i + 1usize; continue; }
    keep.push(s);
    var pos = s.position;
    var normal = s.normal;
    var visible = true;
    if s.being != NO_TARGET {
      let bi = usize.from(s.being);
      if bi < cast.beings.len() and !cast.beings[bi].gone {
        let b = cast.beings[bi];
        let turn = Quat.angleAxis(b.body.yaw, new Vec3(0., 1., 0.));
        pos = b.body.position + turn * s.position;
        normal = turn * s.normal;
      } else {
        visible = false;
      }
    }
    if visible {
      let spin = Quat.angleAxis(6.2831855 * f32.from((s.tick * 2654435761u64 + u64.from(s.color) * 40503u64) % 1000u64) / 1000., new Vec3(0., 1., 0.));
      let rot = upTo(normal) * spin;
      let fade = if age > SPLAT_SECONDS - SPLAT_FADE { (SPLAT_SECONDS - age) / SPLAT_FADE } else { 1. };
      let c = paintColor(s.color);
      out.push(new SplatDraw(Mat4.fromTrs(pos, rot, new Vec3(SPLAT_SIZE, SPLAT_DEPTH * 2., SPLAT_SIZE)), c, fade));
    }
    i = i + 1usize;
  }
  pv.splats <=> keep;
}

// The net check's client plays too (--autowalk): at tick 600 it bowls along its heading, at 900 it throws paint along it; the other client and the
// server then report where the ball lay and how much paint there was. The messages for the simulation, or none
pub fn playAuto(pv &mut PlayView, tick u64, cast &Cast, own usize) List[List[u8]] {
  var out = List[List[u8]].empty();
  if own >= cast.beings.len() { return out; }
  if (pv.autoStage == 0u32 and tick >= 600u64) or (pv.autoStage == 1u32 and tick >= 900u64) {
    let b = cast.beings[own];
    let eye = b.body.position + new Vec3(0., 0.936 * b.figure.height, 0.);
    let dir = new Vec3(0. - libc.sinf(b.body.yaw) * 0.97, 0. - 0.25, 0. - libc.cosf(b.body.yaw) * 0.97);
    out.push(encodeToSim(ToSim.Play(if pv.autoStage == 0u32 { PLAY_BOWL } else { PLAY_SPELL }, SPELL_PAINT, NO_TARGET, eye, dir)));
    pv.autoStage = pv.autoStage + 1u32;
  }
  out
}

// What this view knows of the playground at the end, for the net check: the props it has (the ball's place, in millimetres), the paint it was told of
pub fn playReport(pv &PlayView) {
  var ball = new Vec3(0., 0., 0.);
  var k = 0usize;
  while k < pv.newer.list.len() {
    if pv.newer.list[k].slot == 0u32 { ball = pv.newer.list[k].position; }
    k = k + 1usize;
  }
  print <- "PLAY "; print <- pv.newer.list.len(); print <- " "; print <- pv.bursts; print <- " "; print <- pv.cracks; print <- " ";
  print <- i64.from(libc.floorf(ball.x * 1000. + 0.5)); print <- " "; print <- i64.from(libc.floorf(ball.y * 1000. + 0.5)); print <- " ";
  print <- i64.from(libc.floorf(ball.z * 1000. + 0.5)); print <- "\n";
}

// The being the lock-on holds, as a being number, or NO_ROW
fn lockedBeing(pv &PlayView) usize {
  if pv.lock.target == 0u32 { return NO_ROW; }
  usize.from(pv.lock.target - 1u32)
}

// The keys of this frame ('slots': bit n F(n+1), bit 8 B) turned into the messages for the simulation, and the lock-on kept and
// shown: the eye and direction are the camera's as last drawn
pub fn playInput(pv &mut PlayView, slots u32, cast &Cast, own usize, snap &Snapshot, scene &ViewScene, dt f32, shown &mut List[Request]) List[List[u8]] {
  var out = List[List[u8]].empty();
  let eye = snap.eyeTo.origin;
  let dir = snap.eyeTo.orientation * new Vec3(0., 0., 0. - 1.);
  // The candidates: every other mannequin in the open
  var cands = List[worldinteract.Candidate].empty();
  var i = 0usize;
  while i < cast.beings.len() {
    let b = cast.beings[i];
    if i != own and !b.gone and b.figure.active and b.figure.mode == FIG_WALK and !b.creature {
      cands.push(new worldinteract.Candidate(u32.from(i) + 1u32, b.body.position + new Vec3(0., 0.7 * b.figure.height, 0.), 0.35));
    }
    i = i + 1usize;
  }
  var params = worldinteract.TargetParams.standard();
  params.range = LOCK_RANGE;
  params.useSight = false;
  let noSight = fn(o Vec3, d Vec3, m f32) worldinteract.RayHit { new worldinteract.RayHit(false, 0., 0u32) };
  let before = lockedBeing(pv);
  if pv.lock.isLocked() { pv.lock.update(dt, eye, &cands, &params, &noSight); }
  if slots != 0u32 and own != NO_ROW {
    if (slots & 256u32) != 0u32 {
      out.push(encodeToSim(ToSim.Play(PLAY_BOWL, 0u32, NO_TARGET, eye, dir)));
      pv.sent = pv.sent + 1u32;
    }
    var n = 0u32;
    while n < 3u32 {
      if (slots & (1u32 << n)) != 0u32 {
        if n == SPELL_PAINT {
          out.push(encodeToSim(ToSim.Play(PLAY_SPELL, n, NO_TARGET, eye, dir)));
          pv.sent = pv.sent + 1u32;
        } else {
          if !pv.lock.isLocked() { let got = pv.lock.acquire(eye, dir, &cands, &params, &noSight); }
          if pv.lock.isLocked() {
            out.push(encodeToSim(ToSim.Play(PLAY_SPELL, n, pv.lock.target - 1u32, eye, dir)));
            pv.sent = pv.sent + 1u32;
          }
        }
      }
      n = n + 1u32;
    }
  }
  // The lock shown: the being locked is highlighted, the one let go of is not
  let after = lockedBeing(pv);
  if after != before {
    if before != NO_ROW and before < cast.beings.len() and scene.isLive(cast.beings[before].part) {
      shown.push(Request.Highlight(cast.beings[before].part, false));
    }
    if after != NO_ROW and after < cast.beings.len() and scene.isLive(cast.beings[after].part) {
      shown.push(Request.Highlight(cast.beings[after].part, true));
    }
    pv.locked = after;
  }
  out
}
