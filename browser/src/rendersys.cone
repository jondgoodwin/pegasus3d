// The render system: the owner of how parts look. It keeps its own tables,
// keyed by id: the meshes and materials defined (shared resources, each
// uploaded once however many parts use it), what each part is drawn as (a
// mesh id and a material id), the effects parts give off, and the sky; and
// the GPU resources behind them, made when a DefineMesh, DefineMaterial or
// Effect request is applied. Each frame it turns its rows, with the scene's
// published snapshot (snapshot.cone in parts/), into the render package's
// draw list, and fires each effect's emitters where its part is, as they
// are at the scene's time. It never sees the placement tree: the snapshot
// holds world matrices, already composed. A material is drawn with render's
// Blinn-Phong material, or, if it is physical, its physically based one, with
// its paint, normal and ORM maps; that one is lit by the sun and by an
// environment made to match the Blinn-Phong ambient (environmentSky). Both
// keep render's one lighting convention (look.cone): the sun's colour is
// irradiance, the ambient light and the environment are radiance, so they
// light both kinds alike.
//
// SKINNED PARTS. A part shown as a skinned mesh (DefineSkinnedMesh: render's
// addSkinnedMesh) is drawn posed by its last Bones: its skinning matrices,
// kept side by side in one list ('poseBones', a row a part saying where its
// run is), handed to render's DrawList with the part's world matrix; render
// blends them on the GPU. Before its first Bones it is drawn as modelled.
//
// BATCHES. The parts shown are kept grouped by (mesh, material): one batch
// per pair, its members the parts drawn with it, and the draw list is built
// batch by batch. Today each member is still one draw; instancing (one draw
// per batch, the members' world matrices in a buffer: render's, F2) takes
// the batches as they are.

// A mesh resource uploaded
pub struct MeshRow {
  pub handle MeshHandle;
  pub midY f32 = 0.;          // the height of the middle of its bounds in its own frame: which world an item of it is in (the labyrinth's meshes are
                              // modelled where they stand, under the island, and placed at the origin or at their floor)
}

// A material resource made
pub struct MaterialRow {
  pub handle MaterialHandle;
  pub base Material;          // the material's parameters, to make its highlight from
  pub physical bool;          // drawn physically based: 'pbr' its parameters, not 'base'
  pub pbr PbrMaterial;
  pub lit MaterialHandle;     // the highlighted material, made the first time it is asked for
  pub shaded bool = false;    // drawn by a shader of the browser's own: 'params' its parameters
  pub params Array[f32, 8] = [0., 0., 0., 0., 0., 0., 0., 0.];
  pub surface bool = false;   // a view surface (viewsurface.cone): its item is on the surface layer, its picture drawn before the frame
}

// What one part is drawn as
pub struct Renderable {
  pub mesh MeshId;
  pub material MaterialId;
  pub anchor f32;             // 0: where the part is placed; else under the viewer, in steps of this
  pub highlighted bool;
  pub batch u32;              // its batch
  pub member u32;             // and its place among the batch's members
  pub tint Color = new Color(1., 1., 1., 1.);   // its colour and glow multiplied by this (Tint)
  pub scenic bool = false;    // a thing of render's scene (Cull): in 'scenery', not in the draw list
}

// How the scene's culling is used (--cull N): 0 not at all (every part is a draw list item, as before),
// 1 parts that are Culled are scene items, culled by the camera's frustum and drawn instanced from the visible
// set, 2 and drawn as the coarser levels by projected size and not beyond their range, 3 and culled by the
// hierarchical-Z depth pyramid. The default is 2: in this scene (an open island of trees one behind another,
// ~1,000 items) the pyramid costs about 4 ms of CPU a frame for no visible gain (measured, vegcull lane).
// (RenderSystem.cullMode, set from the arguments when the system is made.)

// A part that is a scene item (Request.Cull): what the request said, the item once it is made (on the first
// frame the snapshot places the part), and what it was last given
pub struct SceneRow {
  pub levels List[MeshId];
  pub sizes List[f32];
  pub rangeMax f32;
  pub margin f32;
  pub handle SceneHandle;
  pub model Mat4;
  pub tint Color;
  pub lit bool;               // drawn in its material's highlighted version
}

// Where a skinned part's skinning matrices are in 'poseBones'
pub struct PoseRow {
  pub first u32;
  pub count u32;
}

// What a part was drawn as last frame, for temporal AA's motion list: its world matrix, and where its
// skinning matrices are in the system's 'prevBones' (count 0: it is not skinned)
pub struct PrevRow {
  pub model Mat4;
  pub first u32;
  pub count u32;
}

// The parts drawn with one mesh and one material
pub struct Batch {
  pub mesh MeshId;
  pub material MaterialId;
  pub members List[PartId];
}

// The environment the physically based material is lit by: a sky of even
// radiance (nits), about the Blinn-Phong ambient the shell's sky gives
// (10 000, 10 800, 12 800), a little bluer overhead and browner below; no sun
// in it (the directional light is the sun), no glow, line or clouds. Never
// drawn: the sky seen is the clear colour.
pub fn environmentSky() render.Sky {
  mut s = render.Sky.dusk(0.9, 0.);
  s.zenith = new Color(10300., 11200., 13900., 1.);
  s.horizon = new Color(10800., 11200., 12600., 1.);
  s.horizonSharpness = 2.;
  s.glow = new Color(0., 0., 0., 1.);
  s.ground = new Color(6700., 4500., 3100., 1.);
  s.groundFade = 4.;
  s;
}

// What one part gives off: its emitters, 'count' of them from 'first' in the
// system's lists, fired with 'seed' from 'start' until 'stop' on the
// scene's clock
pub struct EffectRow {
  pub first u32;
  pub count u32;
  pub seed u32;
  pub start f64;
  pub stop f64;
}

// Whether two matrices are the same, to the last bit
fn matricesEqual(a &Mat4, b &Mat4) bool {
  mut k = 0usize;
  while k < 16usize {
    if a.m[k] != b.m[k] { return false; }
    k = k + 1usize;
  }
  true;
}

// A highlighted part's material: its colour half way to a warm yellow,
// with a highlight
fn highlightOf(m &Material) Material {
  mut out = *m;
  out.baseColor = new Color(m.baseColor.red * 0.5 + 0.5, m.baseColor.green * 0.5 + 0.42, m.baseColor.blue * 0.5 + 0.05,
    m.baseColor.alpha);
  out.specular = new Color(0.6, 0.6, 0.6, 1.);
  out.shininess = 24.;
  out;
}

// A highlighted physical part's: its colour (which multiplies its paint)
// turned towards a warm yellow
fn highlightOfPhysical(m &PbrMaterial) PbrMaterial {
  mut out = *m;
  out.baseColor = new Color(m.baseColor.red * 1.6, m.baseColor.green * 1.4, m.baseColor.blue * 0.45, m.baseColor.alpha);
  out;
}

// A Field's r32float texture. Its values are lent from a list of this
// function's own, swapped out of the field and back without a copy: a view
// of the field's list, reached through a reference, would be handed to
// render beside the renderer's own lists, which nothing shows are not that one
fn fieldTexture(renderer &mut Renderer, device &mut Device, field &mut Field) TextureHandle {
  mut values = List[f32].empty();
  values <=> field.values;
  imm texture = renderer.addFieldTexture(device, field.width, field.height, values.view());
  values <=> field.values;
  texture;
}

// A part that is a light: its handle in render's light set, what it is (in
// its part's frame), and where it was last put in the world
pub struct LampRow {
  pub handle LightHandle;
  pub look LightLook;
  pub position Vec3;
  pub direction Vec3;
}

pub struct RenderSystem {
  pub meshes Table[MeshRow];          // keyed by a mesh's id
  pub materials Table[MaterialRow];   // keyed by a material's id
  pub rows Table[Renderable];         // keyed by a part's id
  pub batches List[Batch];
  pub effects Table[EffectRow];
  pub skies Table[SkyLook];
  pub list DrawList;
  pub particles ParticleRenderer;
  emitters List[Emitter];     // every effect's layers, in the order their slots were added
  handles List[EmitterHandle];
  pub drawn usize;            // parts in the last draw list
  pub painted usize;          // materials defined with a painted image
  pub now f64;                // the scene's time the effects were last drawn at
  pipelines List[PipelineHandle];   // the browser's shaders' pipelines, by SHADER_ number, made when first asked for
  pub shaded usize;           // materials defined drawn by a shader of the browser's own
  pub poses Table[PoseRow];   // keyed by a skinned part's id: where its skinning matrices are
  pub poseBones List[Mat4];   // every skinned part's skinning matrices, a run a part
  pub skinned usize;          // skinned parts in the last draw list
  styles List[u32];           // each emitter's style (EFFECT_...), by the same index as 'emitters'
  counts List[u32];           // and how many particles it drew at the last aimEffects
  weatherHandles List[EmitterHandle];   // the rain's and the snow's particle slots (made by 'makeWeather')
  // The point and spot lights parts are (LightSource), in render's light set,
  // and the parts drawn without casting shadows (CastsShadow false)
  pub lamps Table[LampRow];
  pub quiet Table[u32];
  // Temporal AA's motion: what each part was drawn as last frame, and the draw items that are not where
  // they were (handed to ImageFx each frame: see build)
  pub motion MotionList;
  prevRows Table[PrevRow];
  prevBones List[Mat4];
  nextBones List[Mat4];
  pub scenery Table[SceneRow];   // the parts that are scene items, keyed by part (Cull)
  pub surfaces ViewSurfaces;     // the mirrors and portals (viewsurface.cone)
  pub threads ThreadDraw;        // Ariadne's threads (portalview.cone)
  pub sceneEye Vec3 = new Vec3(0., 0., 0.);   // the eye at the last 'syncScene': a jump of it is a cut, with no fade
  pub sceneNow f64 = 0d;    // the snapshot time of the last 'syncScene', for the fades' step
  pub sceneMade u64 = 0u64;   // scene items made, ever
  pub sceneMoved u64 = 0u64;  // scene items moved because their part did, ever
  pub glows u64 = 0u64;       // Glow requests applied, ever
  // The sky's light on smoke, in the frame's units (the pre-exposed frame):
  // smoke's colours are albedos, scaled by this as they are drawn, so smoke is
  // pale grey by day and dim at night (renderactor sets it every frame)
  pub smokeLight f32 = 1.;
  pub lampsMoved u64 = 0u64;   // lights moved because their part did, ever
  pub cullMode u32 = 2u32;     // how the scene's culling is used (--cull N); see above

  // Drawing particles into targets of 'colorFormat' (the swapchain's), culling as 'cullMode' says
  pub fn make(device &mut Device, colorFormat u32, cullMode u32) RenderSystem {
    mut sys = new RenderSystem(Table[MeshRow].empty(), Table[MaterialRow].empty(), Table[Renderable].empty(), List[Batch].empty(),
      Table[EffectRow].empty(), Table[SkyLook].empty(), DrawList.empty(),
      ParticleRenderer.create(device, colorFormat, TEXTURE_FORMAT_DEPTH32_FLOAT), List[Emitter].empty(),
      List[EmitterHandle].empty(), 0usize, 0usize, 0d, List[PipelineHandle].empty(), 0usize, Table[PoseRow].empty(),
      List[Mat4].empty(), 0usize, List[u32].empty(), List[u32].empty(), List[EmitterHandle].empty(),
      Table[LampRow].empty(), Table[u32].empty(), MotionList.empty(), Table[PrevRow].empty(), List[Mat4].empty(),
      List[Mat4].empty(), Table[SceneRow].empty(), ViewSurfaces.make(), ThreadDraw.make());
    sys.cullMode = cullMode;
    sys;
  }

  // The rain's and the snow's particle slots (once, with the device)
  pub fn makeWeather(self &mut, device &mut Device) {
    if weatherHandles.len() > 0usize { return; }
    weatherHandles.push(particles.addEmitter(device, EFFECT_SMOKE));
    weatherHandles.push(particles.addEmitter(device, EFFECT_SMOKE));
  }

  // The rain and snow field aimed at an eye at 'eye', as the weather 'w' has
  // it at the snapshot's scene time: each emitter's rate follows its strength
  // (and none is drawn below a fiftieth of it); their colours are albedos,
  // lit by the sky as the smoke is
  pub fn aimWeather(self &mut, device &mut Device, snap &Snapshot, eye Vec3, w &WeatherParams) {
    if weatherHandles.len() < 2usize { return; }
    imm frame = weatherFieldFrame(eye);
    mut k = 0usize;
    while k < 2usize {
      imm strength = if k == 0usize { w.rain; } else { w.snow; };
      mut e = if k == 0usize { rainEmitter(); } else { snowEmitter(); };
      imm seed = if k == 0usize { 7101u32; } else { 7102u32; };
      if strength > 0.02 {
        e.rate = e.rate * strength;
        mut c = 0usize;
        while c < 4usize {
          e.colors[c].red = e.colors[c].red * smokeLight;
          e.colors[c].green = e.colors[c].green * smokeLight;
          e.colors[c].blue = e.colors[c].blue * smokeLight;
          c = c + 1usize;
        }
        imm ev = Event.at(seed, 0d, frame);
        particles.update(device, *weatherHandles[k], &e, &ev, snap.now);
      } else {
        imm never = Event.at(seed, 1000000000d, frame);
        particles.update(device, *weatherHandles[k], &e, &never, 0d);
      }
      k = k + 1usize;
    }
  }

  // Apply a DefineMesh: upload it
  pub fn defineMesh(self &mut, renderer &mut Renderer, device &mut Device, id MeshId, m &Mesh) {
    imm handle = renderer.addMesh(device, m);
    imm b = m.bounds();
    mut row = new MeshRow(handle);
    row.midY = (b.min.y + b.max.y) * 0.5;
    meshes.put(id.id, row);
  }

  // Apply a DefineSkinnedMesh: upload it with its skin
  pub fn defineSkinnedMesh(self &mut, renderer &mut Renderer, device &mut Device, id MeshId, m &Mesh, skin &Skin) {
    imm handle = renderer.addSkinnedMesh(device, m, skin);
    imm b = m.bounds();
    mut row = new MeshRow(handle);
    row.midY = (b.min.y + b.max.y) * 0.5;
    meshes.put(id.id, row);
  }

  // Apply a Bones: part 'id' posed by 'bones' from now on (its run in
  // 'poseBones' written over in place when it has as many as before)
  pub fn pose(self &mut, id PartId, bones &List[Mat4]) {
    imm n = u32.from(bones.len());
    imm row = poses.find(id);
    mut first = u32.from(poseBones.len());
    if row != NO_ROW and poses.rows[row].count == n {
      first = poses.rows[row].first;
    } else {
      mut k = 0usize;
      while k < bones.len() { poseBones.push(*bones[k]); k = k + 1usize; }
    }
    mut k = 0usize;
    while k < bones.len() {
      poseBones.set(usize.from(first) + k, *bones[k]);
      k = k + 1usize;
    }
    poses.put(id, new PoseRow(first, n));
  }

  // Apply a DefineMaterial: make its material, Blinn-Phong or physical
  pub fn defineMaterial(self &mut, renderer &mut Renderer, device &mut Device, id MaterialId, surface &Look,
      paint &Image, maps &mut Maps) {
    if surface.shader == SHADER_MIRROR {
      self.defineSurface(renderer, device, id, surface);
      return;
    }
    if surface.shader != SHADER_STANDARD {
      self.defineShaded(renderer, device, id, surface, paint, maps);
      return;
    }
    if surface.physical {
      self.definePhysical(renderer, device, id, surface, paint, maps);
      return;
    }
    mut material = Material.plain(surface.color);
    if surface.specular > 0. {
      material = Material.shiny(surface.color, surface.specular, surface.shininess);
    }
    material.emissive = surface.glow;
    material.lightLayers = surface.lightLayers;
    material.alphaMode = surface.alphaMode;
    material.alphaCutoff = surface.alphaCutoff;
    if !paint.isEmpty() {
      // The painted image, multiplying the colour (its bytes are sRGB)
      material.texture = renderer.addTexture(device, paint);
      painted = painted + 1usize;
    } elif surface.checker {
      // Two squares by two: the light ones white, the dark ones the shade,
      // both multiplying the colour
      imm s = surface.checkerShade;
      imm checks = Image.checker(64, 64, 2, 2, new Color(1., 1., 1., 1.), new Color(s, s, s, 1.));
      material.texture = renderer.addTexture(device, &checks);
    }
    imm mh = renderer.addMaterial(device, &material);
    materials.put(id.id, new MaterialRow(mh, material, false, PbrMaterial.standard(surface.color, 0., 1.),
      MaterialHandle.none()));
  }

  // A view surface's material (viewsurface.cone): the look's params are its tint (rgb) and its kind; it shows the
  // scene drawn again from another camera, which the render actor draws each frame the surface is seen
  fn defineSurface(self &mut, renderer &mut Renderer, device &mut Device, id MaterialId, surface &Look) {
    imm tint = new Color(surface.params[0usize], surface.params[1usize], surface.params[2usize], 1.);
    imm link = new Vec3(surface.params[4usize], surface.params[5usize], surface.params[6usize]);
    imm mh = surfaces.define(renderer, device, id, u32.from(surface.params[3usize]), tint, link, u32.from(surface.params[7usize]));
    mut row = new MaterialRow(mh, Material.plain(surface.color), false, PbrMaterial.standard(surface.color, 0., 1.),
      MaterialHandle.none());
    row.surface = true;
    materials.put(id.id, row);
  }

  // The surfaces' pictures sized to what they show of the frame (before 'build', which hands their materials to the draw list)
  pub fn fitSurfaces(self &mut, renderer &mut Renderer, device &mut Device, camera &Camera, width u32, height u32) {
    if !surfaces.plan(renderer, device, camera, width, height) { return; }
    mut i = 0usize;
    while i < surfaces.rows.len() {
      imm mrow = materials.find(*surfaces.rows.ids[i]);
      if mrow != NO_ROW { materials.rows[mrow].handle = surfaces.materialOf(i); }
      i = i + 1usize;
    }
  }

  // A shaded look's material: drawn by the browser's shader it names
  // (shaders.cone), whose pipeline is made the first time a material asks
  // for it, given the look's parameters and its Field as an r32float
  // texture. A shader not known falls back to a plain white material.
  fn defineShaded(self &mut, renderer &mut Renderer, device &mut Device, id MaterialId, surface &Look,
      paint &Image, maps &mut Maps) {
    imm s = usize.from(surface.shader);
    while pipelines.len() <= s { pipelines.push(PipelineHandle.none()); }
    if pipelines[s].isNone() { pipelines.set(s, makeShaderPipeline(renderer, device, surface.shader)); }
    imm pipeline = *pipelines[s];
    mut mh = MaterialHandle.none();
    if renderer.hasPipeline(pipeline) {
      mut textures = List[TextureHandle].empty();
      if !maps.field.isEmpty() {
        textures.push(fieldTexture(renderer, device, &mut maps.field));
      }
      if !maps.field2.isEmpty() {
        textures.push(fieldTexture(renderer, device, &mut maps.field2));
      }
      // A painted image is a shader's last texture, as it is (linear): the terrain's mask
      if !paint.isEmpty() { textures.push(renderer.addLinearTexture(device, paint)); }
      mh = renderer.addCustomMaterial(device, pipeline, &surface.params, textures.view());
    } else {
      imm plain = Material.plain(new Color(1., 1., 1., 1.));
      mh = renderer.addMaterial(device, &plain);
    }
    materials.put(id.id, new MaterialRow(mh, Material.plain(surface.color), false,
      PbrMaterial.standard(surface.color, 0., 1.), MaterialHandle.none(), renderer.hasPipeline(pipeline), surface.params));
    shaded = shaded + 1usize;
  }

  // A physical look's material: render's physically based one, its colour
  // the base colour, the paint its base colour map, the maps its normal
  // map and its ORM map (as roughness and metallic, and as occlusion of the
  // environment's light)
  fn definePhysical(self &mut, renderer &mut Renderer, device &mut Device, id MaterialId, surface &Look,
      paint &Image, maps &Maps) {
    imm c = surface.color;
    mut pbr = PbrMaterial.standard(c, surface.metallic, surface.roughness).glowing(surface.glow, 1.);
    pbr.alphaMode = surface.alphaMode;
    pbr.alphaCutoff = surface.alphaCutoff;
    pbr.lightLayers = surface.lightLayers;
    pbr.transmission = surface.translucency;
    pbr.flutter = surface.flutter;
    if !paint.isEmpty() {
      pbr.texture = renderer.addTexture(device, paint);
      painted = painted + 1usize;
    }
    if !maps.normal.isEmpty() {
      pbr.normalTexture = renderer.addNormalTexture(device, &maps.normal);
    }
    if !maps.orm.isEmpty() {
      imm orm = renderer.addLinearTexture(device, &maps.orm);
      pbr.metallicRoughnessTexture = orm;
      pbr.occlusionTexture = orm;
    }
    imm mh = renderer.addPbrMaterial(device, &pbr);
    materials.put(id.id, new MaterialRow(mh, Material.plain(c), true, pbr, MaterialHandle.none()));
  }

  // Apply a Show: part 'id' drawn as mesh 'mesh' in material 'material',
  // into their batch (out of the one it was in). False if either is not
  // defined here.
  pub fn show(self &mut, id PartId, mesh MeshId, material MaterialId, anchor f32) bool {
    if meshes.find(mesh.id) == NO_ROW or materials.find(material.id) == NO_ROW { return false; }
    mut highlighted = false;
    mut tint = new Color(1., 1., 1., 1.);
    imm row = rows.find(id);
    if row != NO_ROW {
      highlighted = rows.rows[row].highlighted;
      tint = rows.rows[row].tint;
      self.leaveBatch(id);
    }
    imm b = self.batchOf(mesh, material);
    imm batch = &mut batches[b];
    imm member = u32.from(batch.members.len());
    batch.members.push(id);
    rows.put(id, new Renderable(mesh, material, anchor, highlighted, u32.from(b), member, tint));
    true;
  }

  // Apply a Glow: material 'id' gives off 'glow' (nits) from now on: its
  // emissive colour, or a shaded look's first three parameters. False if it
  // is not defined here.
  pub fn glow(self &mut, renderer &mut Renderer, device &mut Device, id MaterialId, glow Color) bool {
    imm mrow = materials.find(id.id);
    if mrow == NO_ROW { return false; }
    mut m = *materials.rows[mrow];
    if m.shaded {
      m.params[0usize] = glow.red;
      m.params[1usize] = glow.green;
      m.params[2usize] = glow.blue;
      renderer.setCustomParams(device, m.handle, &m.params);
    } elif m.physical {
      m.pbr.emissive = glow;
      m.pbr.emissiveStrength = 1.;
      renderer.setPbrMaterial(device, m.handle, &m.pbr);
    } else {
      m.base.emissive = glow;
      renderer.setMaterial(device, m.handle, &m.base);
    }
    materials.rows.set(mrow, m);
    glows = glows + 1u64;
    true;
  }

  // Apply a Tint: part 'id' drawn with its colour and glow times 'tint'.
  // False if it is not drawn.
  pub fn tint(self &mut, id PartId, tint Color) bool {
    imm row = rows.find(id);
    if row == NO_ROW { return false; }
    mut r = *rows.rows[row];
    r.tint = tint;
    rows.rows.set(row, r);
    true;
  }

  // Apply a LightSource: part 'id' is the light 'look' says, made in render's
  // light set if it is not one yet, otherwise changed to it (only what differs
  // is written, so a steady light costs nothing). It is put where its part is
  // by 'aimLights'.
  pub fn lightSource(self &mut, renderer &mut Renderer, id PartId, look &LightLook) {
    imm row = lamps.find(id);
    if row == NO_ROW {
      imm far = new Vec3(1.0e30, 1.0e30, 1.0e30);
      mut h = LightHandle.none();
      if look.kind == LIGHT_SPOT {
        h = renderer.lights.addSpot(far, look.direction, look.color, look.candela, look.range, look.inner, look.outer);
      } else {
        h = renderer.lights.addPoint(far, look.color, look.candela, look.range);
      }
      renderer.lights.setSourceRadius(h, look.radius);
      renderer.lights.setLayers(h, look.layers);
      renderer.lights.setCastsShadow(h, look.shadow);
      lamps.put(id, new LampRow(h, *look, far, far));
      return;
    }
    mut r = *lamps.rows[row];
    imm was = r.look;
    imm h = r.handle;
    if look.color.red != was.color.red or look.color.green != was.color.green or look.color.blue != was.color.blue
      or look.candela != was.candela {
      renderer.lights.setLight(h, look.color, look.candela);
    }
    if look.range != was.range { renderer.lights.setRange(h, look.range); }
    if look.radius != was.radius { renderer.lights.setSourceRadius(h, look.radius); }
    if look.kind == LIGHT_SPOT and (look.inner != was.inner or look.outer != was.outer) {
      renderer.lights.setCone(h, look.inner, look.outer);
    }
    if look.layers != was.layers { renderer.lights.setLayers(h, look.layers); }
    if look.shadow != was.shadow { renderer.lights.setCastsShadow(h, look.shadow); }
    r.look = *look;
    lamps.rows.set(row, r);
  }

  // Apply a CastsShadow: part 'id' drawn casting shadows, or not
  pub fn castsShadow(self &mut, id PartId, casts bool) {
    if casts { quiet.remove(id); return; }
    if quiet.find(id) == NO_ROW { quiet.put(id, 1u32); }
  }

  // Every light put where its part is, aimed where its part turns it, from
  // the snapshot's world matrices; written only where it moved
  pub fn aimLights(self &mut, renderer &mut Renderer, snap &Snapshot) {
    mut i = 0usize;
    while i < lamps.len() {
      imm world = snap.worldOf(*lamps.ids[i]);
      imm r = *lamps.rows[i];
      imm at = world * r.look.at;
      mut moved = false;
      if at.x != r.position.x or at.y != r.position.y or at.z != r.position.z {
        renderer.lights.move(r.handle, at);
        moved = true;
      }
      mut dir = r.direction;
      if r.look.kind == LIGHT_SPOT {
        dir = world.transformVector(r.look.direction).normalize();
        if dir.x != r.direction.x or dir.y != r.direction.y or dir.z != r.direction.z {
          renderer.lights.aim(r.handle, dir);
          moved = true;
        }
      }
      if moved {
        mut n = r;
        n.position = at;
        n.direction = dir;
        lamps.rows.set(i, n);
        lampsMoved = lampsMoved + 1u64;
      }
      i = i + 1usize;
    }
  }

  // Part 'id''s tint (white if it is not drawn)
  pub fn tintOf(self &, id PartId) Color {
    imm row = rows.find(id);
    if row == NO_ROW { return new Color(1., 1., 1., 1.); }
    rows.rows[row].tint;
  }

  // Apply a Cull: part 'id' (already shown) becomes a thing of render's scene, made on the first frame the
  // snapshot places it (syncScene), drawn as the coarser meshes 'levels' (those defined here) by projected
  // size ('sizes': level 0's first) and not beyond 'rangeMax' (0: no limit). Nothing at cullMode 0. False if
  // it is not drawn here, or anchored (drawn under the viewer: not a static thing).
  pub fn cull(self &mut, id PartId, levels &List[MeshId], sizes &List[f32], rangeMax f32, margin f32) bool {
    if cullMode == 0u32 { return false; }
    imm row = rows.find(id);
    if row == NO_ROW { return false; }
    mut r = *rows.rows[row];
    if r.anchor > 0. { return false; }
    mut lv = List[MeshId].empty();
    mut sz = List[f32].empty();
    sz.push(if sizes.len() > 0usize { *sizes[0usize]; } else { 0.; });
    mut k = 0usize;
    while k < levels.len() {
      if meshes.find(levels[k].id) != NO_ROW {
        lv.push(*levels[k]);
        sz.push(if k + 1usize < sizes.len() { *sizes[k + 1usize]; } else { 0.; });
      }
      k = k + 1usize;
    }
    r.scenic = true;
    rows.rows.set(row, r);
    scenery.put(id, new SceneRow(lv, sz, rangeMax, margin, SceneHandle.none(), Mat4.identity(), new Color(1., 1., 1., 1.), false));
    true;
  }

  // The scene's items brought up to date with the snapshot, before the frame is drawn: a part's item made the
  // first frame the snapshot places it (with its levels and range), moved when the part's world matrix is not
  // what it was, its tint and highlight followed; and the visibility system's settings for the mode
  // (cullMode) and its fades stepped by the scene time that passed.
  pub fn syncScene(self &mut, renderer &mut Renderer, snap &Snapshot, eye Vec3) {
    // A cut (a teleport): the levels change at once, as nothing seen before is still in view
    renderer.vis.settings.crossFade = (eye - sceneEye).length() < 3.;
    sceneEye = eye;
    renderer.vis.settings.frustumCulling = cullMode >= 1u32;
    renderer.vis.settings.lod = cullMode >= 2u32;
    renderer.vis.settings.ranges = cullMode >= 2u32;
    renderer.vis.settings.occlusion = cullMode >= 3u32;
    renderer.vis.settings.occlusionStats = false;
    mut dt = snap.now - sceneNow;
    sceneNow = snap.now;
    if dt <= 0d or dt > 0.25d { dt = 0.0166667d; }
    renderer.vis.settings.timeStep = f32.from(dt);
    mut failed = List[PartId].empty();
    mut i = 0usize;
    while i < scenery.len() {
      imm id = *scenery.ids[i];
      imm rrow = rows.find(id);
      if rrow != NO_ROW and snap.worlds.find(id) != NO_ROW {
        imm r = *rows.rows[rrow];
        imm model = snap.worldOf(id);
        imm mrow = materials.find(r.material.id);
        imm sr = &mut scenery.rows[i];
        if sr.handle.isNone() {
          imm meshH = meshes.rows[meshes.find(r.mesh.id)].handle;
          imm matH = materials.rows[mrow].handle;
          imm h = renderer.addSceneItem(meshH, matH, model, r.tint);
          if h.isNone() {
            failed.push(id);
          } else {
            if sr.levels.len() > 0usize {
              mut chain = LodChain.empty(0.1);
              chain.add(meshH, *sr.sizes[0usize]);
              mut k = 0usize;
              while k < sr.levels.len() {
                chain.add(meshes.rows[meshes.find(sr.levels[k].id)].handle, *sr.sizes[k + 1usize]);
                k = k + 1usize;
              }
              renderer.setSceneLod(h, &chain);
            }
            if sr.rangeMax > 0. { renderer.setSceneRange(h, 0., sr.rangeMax, sr.margin); }
            if quiet.len() > 0usize and quiet.find(id) != NO_ROW { renderer.setSceneCastsShadow(h, false); }
            sr.handle = h;
            sr.model = model;
            sr.tint = r.tint;
            sceneMade = sceneMade + 1u64;
          }
        } else {
          if !matricesEqual(&sr.model, &model) {
            renderer.moveSceneItem(sr.handle, model);
            sr.model = model;
            sceneMoved = sceneMoved + 1u64;
          }
          if r.tint.red != sr.tint.red or r.tint.green != sr.tint.green or r.tint.blue != sr.tint.blue
            or r.tint.alpha != sr.tint.alpha {
            renderer.setSceneTint(sr.handle, r.tint);
            sr.tint = r.tint;
          }
          if r.highlighted != sr.lit {
            imm lit = materials.rows[mrow].lit;
            renderer.setSceneMaterial(sr.handle, if r.highlighted and !lit.isNone() { lit; } else { materials.rows[mrow].handle; });
            sr.lit = r.highlighted;
          }
        }
      }
      i = i + 1usize;
    }
    // Parts the scene cannot hold are drawn from the draw list after all
    i = 0usize;
    while i < failed.len() {
      imm id = *failed[i];
      imm rrow = rows.find(id);
      if rrow != NO_ROW {
        mut r = *rows.rows[rrow];
        r.scenic = false;
        rows.rows.set(rrow, r);
      }
      scenery.remove(id);
      i = i + 1usize;
    }
  }

  // A despawned part that is a scene item: the item goes from render's scene
  pub fn dropScene(self &mut, renderer &mut Renderer, id PartId) {
    imm row = scenery.find(id);
    if row == NO_ROW { return; }
    imm h = scenery.rows[row].handle;
    if !h.isNone() { renderer.removeSceneItem(h); }
    scenery.remove(id);
  }

  // The batch for (mesh, material), made if there is none
  fn batchOf(self &mut, mesh MeshId, material MaterialId) usize {
    mut b = 0usize;
    while b < batches.len() {
      imm batch = batches[b];
      if batch.mesh == mesh and batch.material == material { return b; }
      b = b + 1usize;
    }
    batches.push(new Batch(mesh, material, List[PartId].empty()));
    batches.len() - 1usize;
  }

  // Part 'id' taken out of its batch (the batch's last member moves into its place)
  fn leaveBatch(self &mut, id PartId) {
    imm row = rows.find(id);
    if row == NO_ROW { return; }
    imm r = *rows.rows[row];
    imm batch = &mut batches[usize.from(r.batch)];
    imm last = batch.members.len() - 1usize;
    imm m = usize.from(r.member);
    if m != last {
      batch.members.swap(m, last);
      imm moved = *batch.members[m];
      imm mrow = rows.find(moved);
      mut mr = *rows.rows[mrow];
      mr.member = r.member;
      rows.rows.set(mrow, mr);
    }
    batch.members.pop();
  }

  // Apply a Highlight: part 'id' drawn in its material's highlighted
  // version, or in its own
  pub fn highlight(self &mut, renderer &mut Renderer, device &mut Device, id PartId, on bool) {
    imm row = rows.find(id);
    if row == NO_ROW { return; }
    mut r = *rows.rows[row];
    imm mrow = materials.find(r.material.id);
    mut m = *materials.rows[mrow];
    if on and m.lit.isNone() {
      if m.physical {
        imm lit = highlightOfPhysical(&m.pbr);
        m.lit = renderer.addPbrMaterial(device, &lit);
      } else {
        imm lit = highlightOf(&m.base);
        m.lit = renderer.addMaterial(device, &lit);
      }
      materials.rows.set(mrow, m);
    }
    r.highlighted = on;
    rows.rows.set(row, r);
  }

  // Whether part 'id' is drawn in a physical material
  pub fn isPhysical(self &, id PartId) bool {
    imm row = rows.find(id);
    if row == NO_ROW { return false; }
    imm mrow = materials.find(rows.rows[row].material.id);
    mrow != NO_ROW and materials.rows[mrow].physical;
  }

  // Part 'id''s material, or none
  pub fn materialOf(self &, id PartId) MaterialId {
    imm row = rows.find(id);
    if row == NO_ROW { return MaterialId.none(); }
    rows.rows[row].material;
  }

  // Apply an Effect: a slot of the particle renderer for each layer. A part
  // given an effect again with as many layers keeps its slots; otherwise
  // its old slots are stilled and new ones added (the particle renderer
  // does not take slots back yet)
  pub fn effect(self &mut, device &mut Device, id PartId, layers &List[EffectLayer], seed u32, start f64, stop f64) {
    imm n = u32.from(layers.len());
    imm row = effects.find(id);
    mut first = u32.from(emitters.len());
    mut reuse = false;
    if row != NO_ROW {
      imm old = *effects.rows[row];
      if old.count == n { first = old.first; reuse = true; } else { self.still(device, old); }
    }
    mut k = 0usize;
    while k < layers.len() {
      imm layer = layers[k];
      if reuse {
        emitters.set(usize.from(first) + k, layer.emitter);
        styles.set(usize.from(first) + k, layer.style);
      } else {
        emitters.push(layer.emitter);
        styles.push(layer.style);
        counts.push(0u32);
        handles.push(particles.addEmitter(device, layer.style));
      }
      k = k + 1usize;
    }
    effects.put(id, new EffectRow(first, n, seed, start, stop));
  }

  // Apply a Fire: part 'id''s effect fired again, with 'seed', from 'start'
  // until 'stop'. False if it has no effect.
  pub fn fire(self &mut, id PartId, seed u32, start f64, stop f64) bool {
    imm row = effects.find(id);
    if row == NO_ROW { return false; }
    mut r = *effects.rows[row];
    r.seed = seed;
    r.start = start;
    r.stop = stop;
    effects.put(id, r);
    true;
  }

  // An effect's slots made to draw nothing: started in the far future
  fn still(self &mut, device &mut Device, r EffectRow) {
    imm never = Event.at(r.seed, 1000000000d, Mat4.identity());
    mut k = 0u32;
    while k < r.count {
      imm i = usize.from(r.first + k);
      particles.update(device, *handles[i], emitters[i], &never, 0d);
      k = k + 1u32;
    }
  }

  // Apply a Sky: the part becomes the sky (the last one applied is the sky drawn)
  pub fn sky(self &mut, id PartId, look SkyLook) {
    skies.remove(id);
    skies.put(id, look);
  }

  // A despawned part that is a light: the light goes from render's set
  pub fn dropLamp(self &mut, renderer &mut Renderer, id PartId) {
    quiet.remove(id);
    imm row = lamps.find(id);
    if row == NO_ROW { return; }
    renderer.lights.remove(lamps.rows[row].handle);
    lamps.remove(id);
  }

  // A despawned part's rows go (its mesh and material stay: they are
  // resources, perhaps shared); its effect is stilled
  pub fn drop(self &mut, device &mut Device, id PartId) {
    if rows.find(id) != NO_ROW {
      self.leaveBatch(id);
      rows.remove(id);
    }
    poses.remove(id);
    prevRows.remove(id);
    imm e = effects.find(id);
    if e != NO_ROW {
      self.still(device, *effects.rows[e]);
      effects.remove(id);
    }
    skies.remove(id);
  }

  // The sky drawn: the last applied, or a plain grey if no part is the sky
  // (in physical units: a grey overcast, the light from straight up)
  pub fn currentSky(self &) SkyLook {
    imm n = skies.len();
    if n == 0usize {
      return new SkyLook(Color.gray(8000.), new Vec3(0., 1., 0.), Color.gray(20000.), Color.gray(8000.));
    }
    *skies.rows[n - 1usize];
  }

  // The frame's draw list, batch by batch, from the snapshot's world
  // matrices, for a viewer whose eye is at 'eye'
  // 'skipIsland': under the island, with no picture of it wanted: what is on the island is left out (not even handed to the GPU to clip)
  // 'skipLab': on the island, with no picture of the labyrinth wanted: what is in the labyrinth is left out
  pub fn build(self &mut, snap &Snapshot, eye Vec3, skipIsland bool, skipLab bool) {
    list.clear();
    mut drawnNow = 0usize;
    mut skinnedNow = 0usize;
    imm allBones = poseBones.view();
    mut b = 0usize;
    while b < batches.len() {
      imm batch = batches[b];
      if batch.members.len() > 0usize {
        imm meshH = meshes.rows[meshes.find(batch.mesh.id)].handle;
        imm midY = meshes.rows[meshes.find(batch.mesh.id)].midY;
        imm mat = *materials.rows[materials.find(batch.material.id)];
        mut k = 0usize;
        while k < batch.members.len() {
          imm id = *batch.members[k];
          imm r = *rows.rows[rows.find(id)];
          // A thing of render's scene is drawn from there (syncScene), not from the list
          if r.scenic { k = k + 1usize; continue; }
          mut model = snap.worldOf(id);
          if r.anchor > 0. {
            imm sx = libc.floorf(eye.x / r.anchor) * r.anchor;
            imm sz = libc.floorf(eye.z / r.anchor) * r.anchor;
            model = Mat4.fromTranslation(new Vec3(sx, 0., sz)) * model;
          }
          // Which world it is in: the height of the middle of its mesh's bounds, where it is placed (the labyrinth's are placed at the
          // origin or at a floor, modelled where they stand)
          imm below = underground((model * new Vec3(0., midY, 0.)).y);
          if (skipIsland and !below) or (skipLab and below) {
            // (left out: its bones are not in this frame's, so what it was is kept as a place alone, and compared as such when it is drawn again)
            prevRows.put(id, new PrevRow(model, 0u32, 0u32));
            k = k + 1usize;
            continue;
          }
          imm material = if r.highlighted { mat.lit; } else { mat.handle; };
          imm posed = poses.find(id);
          // What it was last frame, to name it to temporal AA if it moved
          imm before = prevRows.find(id);
          mut oldRow = new PrevRow(model, 0u32, 0u32);
          if before != NO_ROW { oldRow = *prevRows.rows[before]; }
          mut moved = before != NO_ROW and !matricesEqual(&oldRow.model, &model);
          mut nowFirst = 0u32;
          mut nowCount = 0u32;
          if posed != NO_ROW {
            imm pr = *poses.rows[posed];
            imm from = usize.from(pr.first);
            list.addSkinnedTinted(meshH, material, model, r.tint, &allBones[from..<from + usize.from(pr.count)]);
            skinnedNow = skinnedNow + 1usize;
            nowFirst = u32.from(nextBones.len());
            nowCount = pr.count;
            mut j = 0usize;
            while j < usize.from(pr.count) {
              nextBones.push(*poseBones[from + j]);
              j = j + 1usize;
            }
            if before != NO_ROW and oldRow.count == nowCount {
              j = 0usize;
              while j < usize.from(nowCount) {
                if !matricesEqual(prevBones[usize.from(oldRow.first) + j], poseBones[from + j]) { moved = true; }
                j = j + 1usize;
              }
            }
          } else {
            list.addTinted(meshH, material, model, r.tint);
          }
          if moved {
            imm item = list.len() - 1usize;
            if nowCount > 0u32 and oldRow.count == nowCount {
              imm pb = prevBones.view();
              motion.addPosed(item, oldRow.model, &pb[usize.from(oldRow.first)..<usize.from(oldRow.first + nowCount)]);
            } else {
              motion.add(item, oldRow.model);
            }
          }
          prevRows.put(id, new PrevRow(model, nowFirst, nowCount));
          // What is in the labyrinth is on a layer of its own, so that a picture of the island does not draw it nor one of the labyrinth the island
          if below { list.setLayers(list.len() - 1usize, LAB_LAYER); }
          // A view surface is on its own layer (not in its own picture), casts no shadow, and is told its place
          if mat.surface {
            list.setLayers(list.len() - 1usize, SURFACE_LAYER);
            list.dontCastShadow();
            surfaces.note(batch.material, model);
            // (Temporal AA reprojects the pane by the wall's motion, not by the motion of what it shows: render treats a custom
            // pipeline's item as static and has no way to say otherwise, so a moving camera softens the picture's edges)
          }
          if quiet.len() > 0usize and quiet.find(id) != NO_ROW { list.dontCastShadow(); }
          drawnNow = drawnNow + 1usize;
          k = k + 1usize;
        }
      }
      b = b + 1usize;
    }
    drawn = drawnNow;
    skinned = skinnedNow;
    prevBones <=> nextBones;
    nextBones.clear();
  }

  // Each effect's emitters fired where its part is now, as they are at the
  // snapshot's scene time
  pub fn aimEffects(self &mut, device &mut Device, snap &Snapshot) {
    self.now = snap.now;
    mut i = 0usize;
    while i < effects.len() {
      imm r = *effects.rows[i];
      imm ev = new Event(r.seed, r.start, r.stop, snap.worldOf(*effects.ids[i]));
      mut k = 0u32;
      while k < r.count {
        imm e = usize.from(r.first + k);
        if *styles[e] == EFFECT_SMOKE {
          // Smoke's colours are albedos: lit by the sky as drawn
          mut lit = *emitters[e];
          mut c = 0usize;
          while c < 4usize {
            lit.colors[c].red = lit.colors[c].red * smokeLight;
            lit.colors[c].green = lit.colors[c].green * smokeLight;
            lit.colors[c].blue = lit.colors[c].blue * smokeLight;
            c = c + 1usize;
          }
          counts.set(e, particles.update(device, *handles[e], &lit, &ev, snap.now));
        } else {
          counts.set(e, particles.update(device, *handles[e], emitters[e], &ev, snap.now));
        }
        k = k + 1u32;
      }
      i = i + 1usize;
    }
  }

  // How many particles part 'id''s effect drew at the last aimEffects (0:
  // none, or it has no effect)
  pub fn effectParticles(self &, id PartId) u32 {
    imm row = effects.find(id);
    if row == NO_ROW { return 0u32; }
    imm r = *effects.rows[row];
    mut total = 0u32;
    mut k = 0u32;
    while k < r.count {
      total = total + *counts[usize.from(r.first + k)];
      k = k + 1u32;
    }
    total;
  }

  // Whether there are particles to draw
  pub fn hasEffects(self &) bool { effects.len() > 0usize or weatherHandles.len() > 0usize; }
}
