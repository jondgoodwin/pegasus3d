// The render system: the owner of how parts look. It keeps its own tables,
// keyed by part id (what each part is drawn as, the effects parts give off,
// and the sky), and the GPU resources behind them, made when a Show or an
// Effect request is applied. Each frame it turns its rows, with the scene's
// placements, into the render package's draw list, and fires each effect's
// emitters where its part is, as they are at the scene's time. The renderer
// itself never sees a part or walks a hierarchy: it gets world matrices and
// meshes.

// What one part is drawn as
pub struct Renderable {
  pub meshH MeshHandle;
  pub material MaterialHandle;
  pub anchor f32;             // 0: where the part is placed; else under the viewer, in steps of this
  pub base Material;          // the material's parameters, to make its highlight from
  pub lit MaterialHandle;     // the highlighted material, made the first time it is asked for
  pub highlighted Bool;
}

// What one part gives off: its emitters, 'count' of them from 'first' in the
// system's lists, fired with 'seed' from 'start' until 'stop' on the
// scene's clock
pub struct EffectRow {
  pub first u32;
  pub count u32;
  pub seed u32;
  pub start f64;
  pub stop f64;
}

// A highlighted part's material: its colour half way to a warm yellow,
// with a highlight
fn highlightOf(m &Material) Material {
  mut out = *m;
  out.baseColor = new Color(m.baseColor.red * 0.5 + 0.5, m.baseColor.green * 0.5 + 0.42, m.baseColor.blue * 0.5 + 0.05, 1.);
  out.specular = new Color(0.6, 0.6, 0.6, 1.);
  out.shininess = 24.;
  out;
}

pub struct RenderSystem {
  pub rows Table[Renderable];
  pub effects Table[EffectRow];
  pub skies Table[SkyLook];
  pub list DrawList;
  pub particles ParticleRenderer;
  emitters List[Emitter];     // every effect's layers, in the order their slots were added
  handles List[EmitterHandle];
  pub drawn usize;            // parts in the last draw list
  pub painted usize;          // Shows applied with a painted image
  pub now f64;                // the scene's time the effects were last drawn at

  // Drawing particles into targets of 'colorFormat' (the swapchain's)
  pub fn make(device &mut Device, colorFormat u32) RenderSystem {
    new RenderSystem(Table[Renderable].empty(), Table[EffectRow].empty(), Table[SkyLook].empty(), DrawList.empty(),
      ParticleRenderer.create(device, colorFormat, TEXTURE_FORMAT_DEPTH32_FLOAT), List[Emitter].empty(),
      List[EmitterHandle].empty(), 0usize, 0usize, 0d);
  }

  // Apply a Show: upload the mesh, make its material, and give the part its
  // row (a part shown again has its old mesh removed)
  pub fn show(self &mut, renderer &mut Renderer, device &mut Device, id PartId, m &Mesh, surface &Look,
      paint &Image, anchor f32) {
    imm handle = renderer.addMesh(device, m);
    mut material = Material.plain(surface.color);
    if surface.specular > 0. {
      material = Material.shiny(surface.color, surface.specular, surface.shininess);
    }
    if !paint.isEmpty() {
      // The painted image, multiplying the colour (its bytes are sRGB)
      material.texture = renderer.addTexture(device, paint);
      painted = painted + 1usize;
    } elif surface.checker {
      // Two squares by two: the light ones white, the dark ones the shade,
      // both multiplying the colour
      imm s = surface.checkerShade;
      imm checks = Image.checker(64, 64, 2, 2, new Color(1., 1., 1., 1.), new Color(s, s, s, 1.));
      material.texture = renderer.addTexture(device, &checks);
    }
    imm mh = renderer.addMaterial(device, &material);
    imm row = rows.find(id);
    if row != NO_ROW {
      imm old = (*rows.rows[row]).meshH;
      renderer.removeMesh(device, old);
    }
    rows.put(id, new Renderable(handle, mh, anchor, material, MaterialHandle.none(), false));
  }

  // Apply a Highlight: part 'id' drawn in its highlighted material, or its own
  pub fn highlight(self &mut, renderer &mut Renderer, device &mut Device, id PartId, on Bool) {
    imm row = rows.find(id);
    if row == NO_ROW { return; }
    mut r = *rows.rows[row];
    if on and r.lit.isNone() {
      imm lit = highlightOf(&r.base);
      r.lit = renderer.addMaterial(device, &lit);
    }
    r.highlighted = on;
    rows.put(id, r);
  }

  // Apply an Effect: a slot of the particle renderer for each layer. A part
  // given an effect again with as many layers keeps its slots; otherwise
  // its old slots are stilled and new ones added (the particle renderer
  // does not take slots back yet)
  pub fn effect(self &mut, device &mut Device, id PartId, layers &List[EffectLayer], seed u32, start f64, stop f64) {
    imm n = u32.from(layers.len());
    imm row = effects.find(id);
    mut first = u32.from(emitters.len());
    mut reuse = false;
    if row != NO_ROW {
      imm old = *effects.rows[row];
      if old.count == n { first = old.first; reuse = true; } else { self.still(device, old); }
    }
    mut k = 0usize;
    while k < layers.len() {
      imm layer = layers[k];
      if reuse {
        emitters.set(usize.from(first) + k, layer.emitter);
      } else {
        emitters.push(layer.emitter);
        handles.push(particles.addEmitter(device, layer.style));
      }
      k = k + 1usize;
    }
    effects.put(id, new EffectRow(first, n, seed, start, stop));
  }

  // Apply a Fire: part 'id''s effect fired again, with 'seed', from 'start'
  // until 'stop'. False if it has no effect.
  pub fn fire(self &mut, id PartId, seed u32, start f64, stop f64) Bool {
    imm row = effects.find(id);
    if row == NO_ROW { return false; }
    mut r = *effects.rows[row];
    r.seed = seed;
    r.start = start;
    r.stop = stop;
    effects.put(id, r);
    true;
  }

  // An effect's slots made to draw nothing: started in the far future
  fn still(self &mut, device &mut Device, r EffectRow) {
    imm never = Event.at(r.seed, 1000000000d, Mat4.identity());
    mut k = 0u32;
    while k < r.count {
      imm i = usize.from(r.first + k);
      particles.update(device, *handles[i], emitters[i], &never, 0d);
      k = k + 1u32;
    }
  }

  // Apply a Sky: the part becomes the sky (the last one applied is the sky drawn)
  pub fn sky(self &mut, id PartId, look SkyLook) {
    skies.remove(id);
    skies.put(id, look);
  }

  // A despawned part's rows go, and its mesh; its effect is stilled
  pub fn drop(self &mut, renderer &mut Renderer, device &mut Device, id PartId) {
    imm row = rows.find(id);
    if row != NO_ROW {
      imm old = (*rows.rows[row]).meshH;
      renderer.removeMesh(device, old);
      rows.remove(id);
    }
    imm e = effects.find(id);
    if e != NO_ROW {
      self.still(device, *effects.rows[e]);
      effects.remove(id);
    }
    skies.remove(id);
  }

  // The sky drawn: the last applied, or a plain grey if no part is the sky
  pub fn currentSky(self &) SkyLook {
    imm n = skies.len();
    if n == 0usize {
      return new SkyLook(new Color(0.2, 0.2, 0.2, 1.), new Vec3(0., 1., 0.), new Color(1., 1., 1., 1.),
        new Color(0.2, 0.2, 0.2, 1.));
    }
    *skies.rows[n - 1usize];
  }

  // The frame's draw list, from every row and the scene's placements, for a
  // viewer whose eye is at 'eye'
  pub fn build(self &mut, scene &Scene, eye Vec3) {
    list.clear();
    mut i = 0usize;
    while i < rows.len() {
      imm r = *rows.rows[i];
      mut model = scene.worldMatrix(*rows.ids[i]);
      if r.anchor > 0. {
        imm sx = libc.floorf(eye.x / r.anchor) * r.anchor;
        imm sz = libc.floorf(eye.z / r.anchor) * r.anchor;
        model = Mat4.fromTranslation(new Vec3(sx, 0., sz)) * model;
      }
      list.add(r.meshH, if r.highlighted { r.lit; } else { r.material; }, model);
      i = i + 1usize;
    }
    drawn = rows.len();
  }

  // Each effect's emitters fired where its part is now, as they are at the
  // scene's time 'now'
  pub fn aimEffects(self &mut, device &mut Device, scene &Scene, now f64) {
    self.now = now;
    mut i = 0usize;
    while i < effects.len() {
      imm r = *effects.rows[i];
      imm ev = new Event(r.seed, r.start, r.stop, scene.worldMatrix(*effects.ids[i]));
      mut k = 0u32;
      while k < r.count {
        imm e = usize.from(r.first + k);
        particles.update(device, *handles[e], emitters[e], &ev, now);
        k = k + 1u32;
      }
      i = i + 1usize;
    }
  }

  // Whether there are particles to draw
  pub fn hasEffects(self &) Bool { effects.len() > 0usize; }
}
