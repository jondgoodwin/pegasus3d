// The mirror's headless checks (part of 'browser.exe --checks'): viewsurface.cone's geometry, worked out by hand, with no GPU.
// The mirror hangs on a wall facing -z: its plane mesh (-1 to 1 in x and z, facing +y) turned about x by -90 degrees, as
// the cottage places it. The numbers: a wall at z = 99.966 (the mirror's plane), the eye 6 m out at (2, 1.7, 94), the
// mirror 1 m wide and 1.7 m tall, its middle at (2.3, 1.4, 99.966).

fn mirrorNear(a: f32, b: f32, within: f32) bool { absF(a - b) <= within }

// The pane's model matrix: the middle 'at', half sizes 0.5 and 0.85, turned to face -z
fn mirrorModel(at: Vec3) Mat4 {
  Mat4.fromTrs(at, Quat.angleAxis(0. - 1.5707963, Vec3(1., 0., 0.)), Vec3(0.5, 1., 0.85))
}

// Where a point 'p' (world) is on a camera's picture, as texture coordinates (x 0 at the left, y 0 at the top)
fn mirrorUv(camera: &Camera, aspect: f32, p: Vec3) Vec2 {
  let vp = camera.projectionMatrix(aspect) * camera.viewMatrix();
  let c = clipOf(&vp, p);
  Vec2(c.x / c.w * 0.5 + 0.5, 0.5 - c.y / c.w * 0.5)
}

// Whether the main camera sees a point 'p' in front of the mirror reflected where the picture's camera puts it: the point's
// image seen in the mirror is where the ray from the eye to the point's mirror image crosses the mirror's plane, and the mirror
// material reads the picture at 1 - u of that place (the picture is mirrored left to right: camera.cone), the same v. So
// the picture's camera must put the point itself at texture x = 1 - u, y = v of that place.
fn mirrorAgrees(name: &str, main: &Camera, other: &Camera, aspect: f32, p: Vec3, wallZ: f32) bool {
  let eye = main.position();
  let image = Vec3(p.x, p.y, 2. * wallZ - p.z);
  let t = (wallZ - eye.z) / (image.z - eye.z);
  let hit = eye + (image - eye) * t;
  let seen = mirrorUv(main, aspect, hit);
  let drawn = mirrorUv(other, aspect, p);
  print <- "  ("; printStr(name); print <- ": the pane's point at "; print <- hit.x; print <- ", "; print <- hit.y; print <- ", seen at ";
  print <- seen.x; print <- ", "; print <- seen.y; print <- ", the picture puts it at "; print <- drawn.x; print <- ", "; print <- drawn.y; print <- ")\n";
  expect(name, mirrorNear(drawn.x, 1. - seen.x, 0.002) && mirrorNear(drawn.y, seen.y, 0.002)
    && absF(hit.x - 2.3) < 0.5 && absF(hit.y - 1.4) < 0.85)
}

pub fn checkMirror() bool {
  print <- "The mirror (viewsurface.cone):\n";
  let model = mirrorModel(Vec3(2.3, 1.4, 99.966));
  let eye = Vec3(2., 1.7, 94.);
  var ok = expect("the pane's normal is (0, 0, -1)", mirrorNear(model.m[4], 0., 0.0001) && mirrorNear(model.m[5], 0., 0.0001)
    && mirrorNear(model.m[6], -1., 0.0001));
  ok = expect("it faces an eye in front of it and not one behind it", facesEye(&model, eye) && !facesEye(&model, Vec3(2., 1.7, 110.))) && ok;
  // The plane: n.p + d = 0 on it, the eye on the positive side
  let plane = surfacePlane(&model, eye);
  ok = expect("its plane is z = 99.966, the eye on the positive side", mirrorNear(plane.z, -1., 0.0001) && mirrorNear(plane.w, 99.966, 0.001)
    && plane.x * eye.x + plane.y * eye.y + plane.z * eye.z + plane.w > 0.) && ok;
  // The camera it shows: the eye reflected about the plane (z = 99.966 + 5.966), looking the other way in z
  var main = Camera.make();
  main.fov = 1.0471976;
  main.near = 0.1;
  main.far = 500.;
  main.lookAt(eye, Vec3(2.3, 1.4, 99.966), Vec3(0., 1., 0.));
  let other = cameraThrough(&model, SURFACE_MIRROR, &main);
  ok = expect("the picture is drawn by the eye reflected about the plane", mirrorNear(other.position().x, 2., 0.0001)
    && mirrorNear(other.position().y, 1.7, 0.0001) && mirrorNear(other.position().z, 105.932, 0.001)) && ok;
  ok = expect("with nothing behind the plane drawn (an oblique near plane)", other.clipped && other.reflected) && ok;
  // Handedness and place: points in front of the mirror are drawn where the mirror shows them
  let aspect = 16.f / 9.;
  ok = mirrorAgrees("a point 3 m before the mirror's middle", &main, &other, aspect, Vec3(2.3, 1.1, 97.), 99.966) && ok;
  ok = mirrorAgrees("a point to the right, nearer and higher", &main, &other, aspect, Vec3(2.9, 1.5, 96.), 99.966) && ok;
  ok = mirrorAgrees("a point to the left, further and lower", &main, &other, aspect, Vec3(1.9, 0.9, 98.), 99.966) && ok;
  // Seen or not: the quad in the frustum of the camera looking at it, not in one turned away or looking up
  let vp = main.projectionMatrix(aspect) * main.viewMatrix();
  ok = expect("the mirror is in the frustum of the eye looking at it", inFrustum(&vp, &model)) && ok;
  var away = main;
  away.lookAt(eye, Vec3(2., 1.7, 80.), Vec3(0., 1., 0.));
  let vpAway = away.projectionMatrix(aspect) * away.viewMatrix();
  ok = expect("and not in that of the eye turned the other way", !inFrustum(&vpAway, &model)) && ok;
  var aside = main;
  aside.lookAt(eye, Vec3(30., 1.7, 94.), Vec3(0., 1., 0.));
  let vpAside = aside.projectionMatrix(aspect) * aside.viewMatrix();
  ok = expect("and not in that of the eye turned a quarter turn", !inFrustum(&vpAside, &model)) && ok;
  // The pane's size: a standing figure 1.75 m tall (eyes 1.7) is seen head to foot if the bottom edge is no higher than half the
  // eye's height and the top no lower than the mean of the eye's and the crown's
  let spec = cottageMirror();
  ok = expect("the pane shows a standing 1.75 m figure head to foot (bottom at most 0.85 m up, top at least 1.725 m)",
    spec.y <= 0.85 && spec.y + spec.w >= 1.725) && ok;
  ok
}

// A headset eye's mirror (--xr): the eye's own off-axis frustum, the picture cut to the pane's window, read back by the pane. For
// a point 'p' in front of the glass: the pane shows it at the frame's clip (xf, yf); the pane reads its picture at the window
// (x taken the other way round for a mirror), so the picture's own clip x must be -(xf - win.x) / win.z and y (yf - win.y) / win.w.
fn eyeMirrorAgrees(name: &str, eyePos: Vec3, model: &Mat4, p: Vec3, wallZ: f32) bool {
  var main = Camera.make();
  main.near = 0.1;
  main.far = 500.;
  main.lookAt(eyePos, Vec3(2.3, 1.4, wallZ), Vec3(0., 1., 0.));
  main.setFovAngles(-0.85, 0.75, 0.8, -0.7);
  let aspect = 1.f;
  let vp = main.projectionMatrix(aspect) * main.viewMatrix();
  let win = windowOf(&vp, model);
  var other = cameraThrough(model, SURFACE_MIRROR, &main);
  fitWindow(&mut other, main.fov, win, false, 0., 0.);
  let eye = main.position();
  let image = Vec3(p.x, p.y, 2. * wallZ - p.z);
  let t = (wallZ - eye.z) / (image.z - eye.z);
  let hit = eye + (image - eye) * t;
  let ch = clipOf(&vp, hit);
  let xf = ch.x / ch.w;
  let yf = ch.y / ch.w;
  let vpo = other.projectionMatrix(aspect) * other.viewMatrix();
  let co = clipOf(&vpo, p);
  let xp = co.x / co.w;
  let yp = co.y / co.w;
  let wantX = 0. - (xf - win.x) / win.z;
  let wantY = (yf - win.y) / win.w;
  print <- "  ("; printStr(name); print <- ": window "; print <- win.z; print <- " x "; print <- win.w; print <- ", the pane reads "; print <- wantX; print <- ", ";
  print <- wantY; print <- ", the picture puts it at "; print <- xp; print <- ", "; print <- yp; print <- ")\n";
  expect(name, mirrorNear(xp, wantX, 0.003) && mirrorNear(yp, wantY, 0.003) && absF(xp) <= 1. && absF(yp) <= 1.)
}

pub fn checkEyeMirror() bool {
  print <- "The mirror in a headset (viewsurface.cone, off-axis eyes):\n";
  let model = mirrorModel(Vec3(2.3, 1.4, 99.966));
  let p = Vec3(2.5, 1.2, 97.);
  var ok = true;
  // (the head 6 m, 3 m and 1.2 m from the glass, each eye 32 mm either side of it)
  let dists = [6.f, 3., 1.2];
  var i = 0usize;
  while i < 3usize {
    let d = dists[i];
    ok = eyeMirrorAgrees("left eye of a head near the glass", Vec3(2.0 - 0.032, 1.7, 99.966 - d), &model, p, 99.966) && ok;
    ok = eyeMirrorAgrees("right eye of a head near the glass", Vec3(2.0 + 0.032, 1.7, 99.966 - d), &model, p, 99.966) && ok;
    i = i + 1usize;
  }
  // The disparity of the reflection: the object 2.966 m in front of the glass is as far behind it, so the eyes 3 m from the glass see it
  // at places of the glass that differ by the eyes' gap times d / (D + d)
  let wall: f32 = 99.966;
  let img = Vec3(p.x, p.y, 2. * wall - p.z);
  let eL = Vec3(2.0 - 0.032, 1.7, wall - 3.);
  let eR = Vec3(2.0 + 0.032, 1.7, wall - 3.);
  let xL = eL.x + (img.x - eL.x) * (wall - eL.z) / (img.z - eL.z);
  let xR = eR.x + (img.x - eR.x) * (wall - eR.z) / (img.z - eR.z);
  let dd = wall - p.z;
  ok = expect("the two eyes see the reflected point at glass places a gap d / (D + d) of theirs apart, not the same",
    mirrorNear(xR - xL, 0.064 * dd / (3. + dd), 0.0005) && xR - xL > 0.01) && ok;
  ok
}
