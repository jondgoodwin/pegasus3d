// The ragdoll's part of the scripted run, after the weather's (frame FALL_FROM): the second mannequin is set down
// on the cottage's lawn, lifted 11 m and let go. It falls limp from 5 m/s down (a ragdoll of ragdollrig, in the
// physics world), lands hard, lies, and, once it has lain still 2 s, plays the get-up and stands again where it
// fell. The picture is taken from a fixed eye on the lawn, looking at it, at seven moments:
//
//   physics-fall      falling, limp, on the way down
//   physics-landing   just after the landing
//   physics-lying     lying still
//   physics-getup-1/2/3   three moments of the get-up
//   physics-stand     standing again
//
// The frames are offsets from FALL_FROM. The moments are measured, not guessed: the run prints the mode and time of
// the figure at each, and checks that it was a ragdoll, then getting up, then walking, in that order.

pub const FALL_FROM = WX_FROM + WX_FRAMES;
pub const FALL_FRAMES = 520u64;

mut fallOk bool = true;
mut fallSawRag bool = false;
mut fallSawGetUp bool = false;
mut fallRagAt u64 = 0u64;
mut fallGetUpAt u64 = 0u64;
mut fallWalkAt u64 = 0u64;

fn fallSpot(isl &Island) Vec3 { cot(isl, 6., 0., 12.); }

pub fn fallHasView(f u64) bool { f >= FALL_FROM and f < FALL_FROM + FALL_FRAMES; }

// The eye: on the lawn, 4.5 m to the side of the spot and 7.5 m out, 1.6 m up, looking at the figure
pub fn fallView(st &mut SimState, f u64) Pose {
  imm at = st.cast.beings[2usize].body.position;
  imm spot = fallSpot(&st.land);
  imm eye = new Vec3(spot.x + 2.4, spot.y + 1.4, spot.z + 4.6);
  imm look = new Vec3(at.x, if at.y < spot.y + 1.2 { spot.y + 0.7; } else { at.y; }, at.z);
  lookFrom(eye, look);
}

pub fn fallShotAt(f u64) &str {
  imm k = f - FALL_FROM;
  if k == 70u64 { return "physics-fall"; }
  if k == 112u64 { return "physics-landing"; }
  if k == 190u64 { return "physics-lying"; }
  if k == 300u64 { return "physics-getup-1"; }
  if k == 380u64 { return "physics-getup-2"; }
  if k == 440u64 { return "physics-getup-3"; }
  if k == 500u64 { return "physics-stand"; }
  "";
}

// The ragdoll's requests of the scene at frame 'f'
pub fn fallDrive(st &mut SimState, f u64) {
  if f < FALL_FROM or f >= FALL_FROM + FALL_FRAMES { return; }
  imm k = f - FALL_FROM;
  imm b = &mut st.cast.beings[2usize];
  if k == 0u64 {
    imm spot = fallSpot(&st.land);
    b.setDown(spot, 0.);
    b.body.position = new Vec3(spot.x, spot.y + 11., spot.z);
    b.before = b.body;
    b.figure.grounded = false;
    b.figure.health = 1.;
  }
  if b.figure.mode == FIG_RAG and !fallSawRag { fallSawRag = true; fallRagAt = k; }
  if b.figure.mode == FIG_GETUP and !fallSawGetUp { fallSawGetUp = true; fallGetUpAt = k; }
  if b.figure.mode == FIG_WALK and fallSawGetUp and fallWalkAt == 0u64 { fallWalkAt = k; }
  if k == 70u64 or k == 112u64 or k == 190u64 or k == 300u64 or k == 380u64 or k == 440u64 or k == 500u64 {
    print <- "Frame "; print <- f; print <- ", "; print <- k; print <- " frames into the fall: mode "; print <- b.figure.mode; print <- ", "; print <- b.figure.modeT;
    print <- " s in it, "; print <- b.body.position.y - groundHeight(&st.land, b.body.position.x, b.body.position.z); print <- " m up, health "; print <- b.figure.health;
    print <- "\n";
  }
  if k == FALL_FRAMES - 1u64 {
    print <- "The ragdoll's fall: limp at frame +"; print <- fallRagAt; print <- ", getting up at +"; print <- fallGetUpAt; print <- ", walking again at +";
    print <- fallWalkAt; print <- "\n";
    fallOk = yesNo("  it fell limp, lay, got up and walks again, in that order", fallSawRag and fallSawGetUp and fallRagAt < fallGetUpAt
      and fallGetUpAt < fallWalkAt and b.figure.mode == FIG_WALK) and fallOk;
    fallOk = yesNo("  one hard landing, and it hurt (whole health 1, left less, not dead)", b.figure.hardLandings >= 1u32
      and b.figure.health < 0.95 and b.figure.health > 0.2 and b.figure.respawns == 0u32) and fallOk;
    fallOk = yesNo("  standing on the ground where it fell (not set down on the beach)", b.figure.grounded
      and absF(b.body.position.y - groundHeight(&st.land, b.body.position.x, b.body.position.z)) < GROUND_SLACK
      and flatDist(b.body.position.x, b.body.position.z, BEACH_X, BEACH_Z) > 20.) and fallOk;
  }
}

// Whether the ragdoll's checks have held
pub fn checkFallRun() bool { fallOk; }
