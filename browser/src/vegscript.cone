// The vegetation's part of the scripted run: after the sky's windows (frame
// 1170), the day clock is set to noon and the views of the cottage scene's
// trees, rocks and plants are saved, a window of ten frames each (the clock
// set at the first window's first frame, each picture saved at its fifth).
// Every eye and target is worked out from the layout (bakedworld's items) and
// the island, so the views follow the scene's rules, not fixed numbers.
//
//   window  what is looked at
//     0     the specimen maple in front of the cottage, whole, from the walker's eye
//     1     the same maple close, trunk and lower crown, from 5 m
//     2     the path from the beach into the forest, from where you land
//     3     the path in the forest's middle, from the walker's eye
//     4     the cottage among its trees, from the approach
//     5     the cottage and its trees from above and to the side
//     6     ground plants close: hostas and ferns by the cottage
//     7     the flowers in front of the cottage
//     8     the rocks: a beach boulder, from 3 m
//     9     the edging stones along the path
//    10     the forest from above, from over the sea

pub const VEG_FROM = 1230u64;      // after glow and glass's views (glowscript.cone, from 1170)
pub const VEG_WINDOW = 10u64;
pub const VEG_WINDOWS = 11u64;

fn vegWindow(f u64) u64 { (f - VEG_FROM) / VEG_WINDOW; }

pub fn vegShotAt(f u64) &Array[u8] {
  if f < VEG_FROM or f >= VEG_FROM + VEG_WINDOW * VEG_WINDOWS { return ""; }
  if (f - VEG_FROM) % VEG_WINDOW != 4u64 { return ""; }
  imm w = vegWindow(f);
  if w == 0u64 { return "veg-maple"; }
  if w == 1u64 { return "veg-maple-close"; }
  if w == 2u64 { return "veg-path-beach"; }
  if w == 3u64 { return "veg-path-forest"; }
  if w == 4u64 { return "veg-cottage-trees"; }
  if w == 5u64 { return "veg-cottage-above"; }
  if w == 6u64 { return "veg-plants"; }
  if w == 7u64 { return "veg-flowers"; }
  if w == 8u64 { return "veg-rocks"; }
  if w == 9u64 { return "veg-edging"; }
  "veg-overview";
}

// The clock set to noon at the first frame
pub fn vegDrive(st &mut SceneState, f u64) {
  if f == VEG_FROM { st.scene.clock.ns = u64.from(nanosOf(f64.from(12. - 7.) * 60d)); }
}

// The first item of 'kind' (and 'variant', unless 'any'), or the first of the kind past 'skip' of them
fn vegItem(kind u32, skip usize) Item {
  imm items = vegetationLayout();
  mut seen = 0usize;
  mut i = 0usize;
  while i < items.len() {
    if items[i].kind == kind {
      if seen == skip { return *items[i]; }
      seen = seen + 1usize;
    }
    i = i + 1usize;
  }
  new Item(kind, 0u32, COT_X, groundHeight(COT_X, COT_Z), COT_Z, 0., 1., 1.);
}

// The largest rock, by scale, nearest the beach
fn vegBigRock() Item {
  imm items = vegetationLayout();
  mut best = vegItem(K_ROCK, 0usize);
  mut i = 0usize;
  while i < items.len() {
    if items[i].kind == K_ROCK and items[i].z > 470. and items[i].scale > best.scale { best = *items[i]; }
    i = i + 1usize;
  }
  best;
}

pub fn vegView(f u64) Pose {
  imm w = vegWindow(f);
  imm line = pathCentreline();
  if w <= 1u64 {
    imm m = vegItem(K_SPECIMEN, 0usize);
    imm top = new Vec3(m.x, m.y + 6.5, m.z);
    // from the path's side, 17 m out; or close, 5.5 m out at the trunk's height
    if w == 0u64 { return lookFrom(new Vec3(m.x + 3., m.y + 1.7, m.z + 19.), new Vec3(m.x, m.y + 6., m.z)); }
    return lookFrom(new Vec3(m.x + 2.5, m.y + 1.7, m.z + 6.5), new Vec3(m.x, m.y + 4.5, m.z));
  }
  if w == 2u64 {
    return lookFrom(new Vec3(START_X_V, groundHeight(START_X_V, START_Z_V) + 1.7, START_Z_V), cot(0., 1.5, 20.));
  }
  if w == 3u64 {
    imm k = line.len() * 6usize / 10usize;
    imm a = *line[k];
    imm b = *line[k - 8usize];
    return lookFrom(new Vec3(a.x, a.y + 1.7, a.z), new Vec3(b.x, b.y + 2.5, b.z));
  }
  if w == 4u64 { return lookFrom(cot(3., 1.7, 25.), cot(0.3, 3., 0.)); }
  if w == 5u64 { return lookFrom(cot(28., 16., 34.), cot(-2., 3., -2.)); }
  if w == 6u64 {
    imm h = vegItem(K_HOSTA, 0usize);
    return lookFrom(new Vec3(h.x + 0.5, h.y + 1.0, h.z + 2.1), new Vec3(h.x, h.y + 0.15, h.z));
  }
  if w == 7u64 { return lookFrom(cot(-1.3, 1.1, 7.5), cot(-1.6, 0.3, 2.4)); }
  if w == 8u64 {
    imm r = vegBigRock();
    return lookFrom(new Vec3(r.x + 1.5, r.y + 1.3, r.z + 3.5), new Vec3(r.x, r.y + 0.3, r.z));
  }
  if w == 9u64 {
    imm k = line.len() * 3usize / 10usize;
    imm a = *line[k];
    imm b = *line[k - 6usize];
    return lookFrom(new Vec3(a.x, a.y + 1.2, a.z), new Vec3(b.x, b.y + 0.2, b.z));
  }
  lookFrom(new Vec3(-10., 160., 640.), new Vec3(-18., 4., 400.));
}

pub fn vegFov(f u64) f32 {
  imm w = vegWindow(f);
  if w == 6u64 or w == 7u64 or w == 8u64 { return 1.0; }
  FOV;
}

const START_X_V f32 = -22.;
const START_Z_V f32 = 499.;
