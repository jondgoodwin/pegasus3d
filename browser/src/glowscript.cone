// The lights' part of the scripted run, after the sky's (frame 1170): the
// day clock set forward to the next evening and night, and the glow and the
// glass saved, a window of ten frames each (the clock set at the window's
// first frame, the picture saved at its fifth), as the sky's are. The hours
// only run forward, so the scene's dusk timer rings on the way and the
// lamps are found on (bakedworld's lights.cone counts the fade from dusk's
// own time).
//
//   window  hour    what is looked at
//     0     41.81   the cottage at dusk (17:48, twenty minutes after the sun's set), from the walker's place 15 m out
//     1     43.83   the cottage at dusk from the reference photograph's place and lens
//     2     43.83   the porch's right bay window close up: the glass, the room behind
//     3     47.0    the cottage at night (23:00), from the walker's place
//     4     47.0    the nearest path lantern close up, brightened: the walker was
//                   set down within its area at window 2 (behind that window's eye)
//     5     47.0    the bay window close up at night
//
// At frame 1222 the lights are checked: on, the bulb's glow the hour's, and
// the lantern the walker stands by brightened (its parts' Tint the full gain).

pub const GLOW_FROM = 1170u64;
pub const GLOW_WINDOW = 10u64;
pub const GLOW_WINDOWS = 6u64;

fn glowWindow(f u64) u64 { (f - GLOW_FROM) / GLOW_WINDOW; }

fn glowHour(w u64) f32 { if w < 3u64 { 41.8083; } else { 47.; }; }

// The pictures saved at frame 'f', or an empty name
pub fn glowShotAt(f u64) &[]u8 {
  if f < GLOW_FROM or f >= GLOW_FROM + GLOW_WINDOW * GLOW_WINDOWS { return ""; }
  if (f - GLOW_FROM) % GLOW_WINDOW != 4u64 { return ""; }
  imm w = glowWindow(f);
  if w == 0u64 { return "glow-dusk-approach"; }
  if w == 1u64 { return "glow-dusk-photo"; }
  if w == 2u64 { return "glow-glass-dusk"; }
  if w == 3u64 { return "glow-night-approach"; }
  if w == 4u64 { return "glow-lantern-night"; }
  "glow-glass-night";
}

// The nearest path lantern's foot (the one 6 m back from the steps)
fn nearestLantern(st &mut SceneState) Vec3 { st.scene.worldMatrix(st.world.partOf(LANTERNS, 0usize)).translation(); }

// The cottage's root: the middle of its front wall, on the ground
fn cottageRoot(st &mut SceneState) Vec3 { st.scene.worldMatrix(st.world.partOf(COTTAGE, COTTAGE_ROOT)).translation(); }

// Where the walker is set down for the lantern close-up: inside its area
// (3.2 m from its foot), out of the picture, well to the camera's left
fn byTheLantern(st &mut SceneState) Vec3 {
  imm l = nearestLantern(st);
  imm x = l.x - 2.0;
  imm z = l.z - 2.5;
  new Vec3(x, groundHeight(x, z), z);
}

// The script's requests at frame 'f': the day clock set at the first frame
// of each window whose hour is not the last's; the walker brought by the
// lantern for window 4
pub fn glowDrive(st &mut SceneState, f u64) {
  if f < GLOW_FROM or f >= GLOW_FROM + GLOW_WINDOW * GLOW_WINDOWS { return; }
  if (f - GLOW_FROM) % GLOW_WINDOW != 0u64 { return; }
  imm w = glowWindow(f);
  if w == 0u64 or glowHour(w) != glowHour(w - 1u64) {
    imm seconds = f64.from(glowHour(w) - 7.) * 60d;
    st.scene.clock.ns = u64.from(nanosOf(seconds));
  }
  if w == 2u64 {
    imm at = byTheLantern(st);
    imm cast = &mut st.cast;
    imm b = &mut cast.beings[cast.possessed];
    b.body.position = at;
    b.before = b.body;
  }
}

// The eye for frame 'f'
pub fn glowView(st &mut SceneState, f u64) Pose {
  imm w = glowWindow(f);
  imm r = cottageRoot(st);
  if w == 0u64 or w == 3u64 { return lookFrom(skyEye(), ow(-10. + 0.3, 3.2, -24.)); }
  if w == 1u64 { return lookFrom(cot(-4.25, 1.63, 15.31), cot(-2.18, 2.64, 5.58)); }
  if w == 4u64 {
    imm l = nearestLantern(st);
    return lookFrom(l + new Vec3(-1.1, 0.75, 1.0), l + new Vec3(0., 0.2, 0.));
  }
  // The porch's right bay (x 1.15 to 1.77, 1.37 to 2.61 up, in the cottage's
  // frame), from in front and a little to its right, at its height
  lookFrom(r + new Vec3(2.15, 2.0, 1.75), r + new Vec3(1.46, 1.95, 0.));
}

// The lens: the photograph's for window 1, a longer one for the close-ups
pub fn glowFov(f u64) f32 {
  imm w = glowWindow(f);
  if w == 1u64 { return COTTAGE_PHOTO_FOV; }
  if w == 2u64 or w == 5u64 or w == 4u64 { return 0.7; }
  FOV;
}

// The lights checked at frame 1222 (window 5, the walker by the lantern
// since window 4, the clock at 23:00)
pub fn checkGlow(st &mut SceneState, f u64) bool {
  if f != GLOW_FROM + 52u64 { return true; }
  imm scene = &st.scene;
  imm world = &st.world;
  imm rendered = &st.rendered;
  imm lights = &world.lights;
  imm want = nitsAt(hourAt(scene.now()));
  imm bulb = lights.sentNits(0usize);
  print <- "Frame "; print <- f; print <- ", the lights at "; print <- hourAt(scene.now()); print <- " h: ";
  if lights.on { print <- "on"; } else { print <- "OFF"; }
  print <- ", the bulb "; print <- bulb; print <- " nits (want "; print <- want; print <- "), ";
  print <- lights.comings; print <- " lantern areas entered, ";
  print <- world.dusks; print <- " dusks read\n";
  mut ok = lights.on and lights.level == 1. and bulb > want * 0.98 and bulb < want * 1.02 and lights.comings >= 1u64;
  if rendered.gpu {
    imm t = rendered.tintOf(world.partOf(LANTERNS, 1usize));
    imm far = rendered.tintOf(world.partOf(LANTERNS, 5usize));
    print <- "  the nearest lantern's glass tinted "; print <- t.red; print <- " (want "; print <- NEAR_GAIN;
    print <- "), the next one's "; print <- far.red; print <- " (want 1)\n";
    ok = ok and t.red == NEAR_GAIN and far.red == 1.;
  }
  if !ok { print <- "  the lights are WRONG\n"; }
  ok;
}
