// The --checks of the brook (island/brook.cone): its course on the baked land. The water is never
// buried by the ground under the ribbon, it never rises and falls at least 0.3% in the yard, it ends
// at the sea above the beach, it keeps off the path and inside the dressed area, and it comes no nearer the
// cottage than the design says.

// The ribbon's half width of core (the wet half width) and its feather
fn ribbonHalf(p &BrookPoint) f32 { p.width * 0.5; }

fn checkBrookCourse(isl &Island) bool {
  print <- "The brook's course:\n";
  let pts = brookPoints(isl);
  let n = pts.len();
  var ok = expect("it has a point about every metre (400 to 480 of them)", n > 400usize and n < 480usize);
  print <- "  ("; print <- n; print <- " points, "; print <- brookLength(isl); print <- " m long)\n";
  ok = expect("about 434 m long (420 to 450)", brookLength(isl) > 420. and brookLength(isl) < 450.) and ok;
  // The water against the ground under the ribbon: the margin of the water above the highest ground within the
  // wet width (the cross-section at 0, +-0.3 and +-the half width), and where it is least
  var worst = 1000.;
  var worstAt = 0usize;
  var risen = false;
  var yardFall f32 = 0.;
  var yardLen f32 = 0.;
  var k = 0usize;
  while k < n {
    let p = pts[k];
    if k > 0usize {
      if p.w > pts[k - 1usize].w + 0.00001 { risen = true; }
    }
    // The across direction
    let a = *pts[if k == 0usize { 0usize; } else { k - 1usize; }];
    let b = *pts[if k + 1usize >= n { n - 1usize; } else { k + 1usize; }];
    let tx = b.x - a.x;
    let tz = b.z - a.z;
    let tl = (tx * tx + tz * tz).sqrt() + 0.0001;
    let nx = (0. - tz) / tl;
    let nz = tx / tl;
    var o = -2;
    while o <= 2 {
      let off = f32.from(o) * 0.25 * p.width;
      let g = groundHeight(isl, p.x + nx * off, p.z + nz * off);
      let margin = p.w - g;
      if margin < worst { worst = margin; worstAt = k; }
      o = o + 1;
    }
    k = k + 1usize;
  }
  print <- "  (the water's least depth over the ground under the ribbon: "; print <- worst; print <- " m, at point "; print <- worstAt;
  print <- " ("; print <- pts[worstAt].x; print <- ", "; print <- pts[worstAt].z; print <- "))\n";
  ok = expect("the ground under the ribbon is never within 0.08 m of the water (it is never buried)", worst > 0.08) and ok;
  ok = expect("the water never rises going downstream", !risen) and ok;
  // The yard: from the bridge's control on to the dingle's: the fall
  var y0 = 0usize;
  var y1 = 0usize;
  k = 0usize;
  while k < n {
    if pts[k].ctl == BROOK_BRIDGE and y0 == 0usize { y0 = k; }
    if pts[k].ctl == BROOK_BRIDGE + 7usize { y1 = k; }
    k = k + 1usize;
  }
  if y1 > y0 {
    yardFall = pts[y0].w - pts[y1].w;
    yardLen = pts[y1].s - pts[y0].s;
  }
  print <- "  (the yard: "; print <- yardLen; print <- " m, falling "; print <- yardFall; print <- " m, "; print <- yardFall / yardLen * 100.; print <- " percent)\n";
  ok = expect("the yard falls at least 0.3 percent", yardFall / yardLen >= 0.0029) and ok;
  let last = pts[n - 1usize];
  ok = expect("it ends at the sea: the mouth's water at or above its level, on land that is not under water", last.w >= 0.1 and groundHeight(isl, last.x, last.z) > -0.3) and ok;
  ok = expect("and the spring is on the hill, 30 m up", pts[0usize].w > 29. and pts[0usize].w < 31.) and ok;
  // The path and the dressed area
  var near = 1000.;
  var outside = 0usize;
  k = 0usize;
  while k < n {
    if pathDistanceAt(isl, pts[k].x, pts[k].z) < near { near = pathDistanceAt(isl, pts[k].x, pts[k].z); }
    if pts[k].ctl >= 8usize and !insideDressedArea(isl, pts[k].x, pts[k].z) { outside = outside + 1usize; }
    k = k + 1usize;
  }
  print <- "  (the path's distance field says "; print <- near; print <- " m at the nearest; the field is capped at 16)\n";
  ok = expect("it never comes within 8 m of the path (the path's carve reaches 6 m)", near >= 8.) and ok;
  ok = expect("from the lawn on (control 8) it is inside the dressed area", outside == 0usize) and ok;
  // The steepest stretch of bank: the walker's ground along the bed
  var steepest f32 = 0.;
  k = 0usize;
  while k + 1usize < n {
    let p = pts[k];
    let q = pts[k + 1usize];
    let run = len2d(q.x - p.x, q.z - p.z) + 0.0001;
    let slope = (if groundHeight(isl, p.x, p.z) > groundHeight(isl, q.x, q.z) { groundHeight(isl, p.x, p.z) - groundHeight(isl, q.x, q.z); }
      else { groundHeight(isl, q.x, q.z) - groundHeight(isl, p.x, p.z); }) / run;
    if p.ctl >= 8usize and slope > steepest { steepest = slope; }
    k = k + 1usize;
  }
  print <- "  (the bed's steepest metre below the lawn: "; print <- steepest; print <- ")\n";
  ok = expect("a walker can follow the bed below the lawn: nowhere steeper than 0.45", steepest < 0.45) and ok;
  // The yard against a cottage turned a quarter turn: the nearest the yard's centreline comes to a long side wall
  // running back from the current front corner
  var yardNorth f32 = 1000.;
  k = 0usize;
  while k < n {
    if pts[k].ctl >= BROOK_BRIDGE and pts[k].ctl < BROOK_BRIDGE + 5usize and pts[k].x < -12. and pts[k].x > -22. {
      if COT_Z - pts[k].z < yardNorth { yardNorth = COT_Z - pts[k].z; }
    }
    k = k + 1usize;
  }
  print <- "  (the yard's centreline is "; print <- yardNorth; print <- " m behind the cottage's front wall at the nearest, between x -22 and -12)\n";
  ok = expect("the yard's centreline is at least 15 m behind the front wall where a turned cottage's side wall would stand", yardNorth >= 15.) and ok;
  ok;
}

// A walker walked 'seconds' from (x, y, z) facing 'yaw' on the world's solids: where it ends, and the highest it got
fn walkFrom(s &mut Scene, c &mut Cast, at Vec3, yaw f32, seconds f32, highest &mut f32) Vec3 {
  let w = putWalker(s, c, at, yaw);
  let go = new Intents(1., 0., false, false);
  var k = 0;
  let n = i32.from(seconds * 60.);
  *highest = at.y;
  while k < n {
    c.step(go, 1. / 60.);
    if c.beings[w].body.position.y > *highest { *highest = c.beings[w].body.position.y; }
    k = k + 1;
  }
  c.beings[w].body.position;
}

// The bridge, walked: up the south ramp, over the crest and down the north ramp at the road's heights, the
// parapets stop a walker on the crest and on a ramp, the water is no wall, and the bed is ground
fn checkBridgeWalk(isl &Island) bool {
  print <- "The bridge:\n";
  let list = worldSolids(isl);
  var c = Cast.empty(isl.share());
  c.phys.ensureGround();
  c.phys.setSolids(&list);
  let bank = bridgeBank(isl);
  let crest = bank + BRIDGE_CREST_UP;
  var ok = expect("it has nine solids: a crest, two ramps and a parapet's three each side", BRIDGE_SOLIDS == 9usize);
  print <- "  (banks "; print <- bank; print <- " m, the road's crest "; print <- crest; print <- " m, the water "; print <- bridgeWater(isl); print <- " m)\n";
  // Up and over, from 6 m south of the middle, facing north (-z)
  var s = Scene.empty();
  let w = putWalker(&mut s, &mut c, new Vec3(BRIDGE_X, groundHeight(isl, BRIDGE_X, BRIDGE_Z + 6.), BRIDGE_Z + 6.), 0.);
  let go = new Intents(1., 0., false, false);
  var worstOff f32 = 0.;
  var top f32 = 0.;
  var sawUp = false;
  var sawCrest = false;
  var sawDown = false;
  var k = 0;
  while k < 720 {
    c.step(go, 1. / 60.);
    let p = c.beings[w].body.position;
    let dz = p.z - BRIDGE_Z;
    if p.y > top { top = p.y; }
    if dz > -BRIDGE_END + 0.4 and dz < BRIDGE_END - 0.4 {
      let want = bridgeDeck(dz, bank);
      // (the footprint's highest point is up to a radius up the slope)
      let off = libc.fabsf(p.y - want);
      if off > worstOff { worstOff = off; }
      if dz > 1.2 and dz < 3. and p.y > bank + 0.1 { sawUp = true; }
      if dz > -0.9 and dz < 0.9 and nearly(p.y, crest, 0.01) { sawCrest = true; }
      if dz < -1.2 and dz > -3. and p.y > bank + 0.1 and p.y < crest - 0.05 { sawDown = true; }
    }
    k = k + 1;
  }
  let end = c.beings[w].body.position;
  print <- "  (walked from 6 m south to z "; print <- end.z - BRIDGE_Z; print <- "; the highest "; print <- top - bank; print <- " m over the banks; off the road's height by at most ";
  print <- worstOff; print <- " m)\n";
  ok = expect("a walker climbs the south ramp, crosses the crest at 0.58 m over the banks and comes down the north ramp onto the ground beyond",
    sawUp and sawCrest and sawDown and end.z < BRIDGE_Z - BRIDGE_END and nearly(end.y, groundHeight(isl, end.x, end.z), GROUND_SLACK)) and ok;
  ok = expect("on the road it is at the road's height, within the slope under its feet (0.08 m)", worstOff < 0.08 and nearly(top, crest, 0.01)) and ok;
  // The parapets: on the crest facing east, then on the south ramp facing west
  var hi f32 = 0.;
  let east = walkFrom(&mut s, &mut c, new Vec3(BRIDGE_X, crest, BRIDGE_Z), 0. - 0.5 * pi, 3., &mut hi);
  print <- "  (walked east from the crest: stopped at x "; print <- east.x - BRIDGE_X; print <- ", the parapet's face at 0.7)\n";
  ok = expect("the east parapet stops a walker on the crest, a radius from its inner face, still on the road",
    nearly(east.x - BRIDGE_X, 0.7 - 0.2625, 0.01) and nearly(east.y, crest, 0.01)) and ok;
  let west = walkFrom(&mut s, &mut c, new Vec3(BRIDGE_X, bridgeDeck(2.2, bank), BRIDGE_Z + 2.2), 0.5 * pi, 3., &mut hi);
  print <- "  (walked west from the south ramp: stopped at x "; print <- west.x - BRIDGE_X; print <- ", y "; print <- west.y - bank; print <- " over the banks)\n";
  ok = expect("so does the west parapet on the south ramp (sloped like the road)",
    nearly(west.x - BRIDGE_X, 0. - 0.7 + 0.2625, 0.01) and nearly(west.y, bridgeDeck(2.2, bank), 0.07)) and ok;
  // From the bank beside the bridge the parapet is a wall, not a step: walked at from the east at the ramp's foot
  let side = walkFrom(&mut s, &mut c, new Vec3(BRIDGE_X + 4., groundHeight(isl, BRIDGE_X + 4., BRIDGE_Z + 3.), BRIDGE_Z + 3.), 0.5 * pi, 4., &mut hi);
  var si = 0usize;
  while si < list.len() {
    if list[si].over(side.x, side.z) { print <- "    (over solid "; print <- si; print <- " kind "; print <- list[si].kind; print <- ", top "; print <- list[si].topAt(side.x, side.z) - bank; print <- " over the banks)\n"; }
    si = si + 1usize;
  }
  print <- "  (walked west at the south ramp from the bank: stopped at x ";print <- side.x - BRIDGE_X; print <- ", z "; print <- side.z - BRIDGE_Z; print <- ", y "; print <- side.y - groundHeight(isl, side.x, side.z); print <- " over the ground)\n";
  // (its footprint's edge rests on the road's edge under the parapet, so its feet stand at the road's height there)
  ok = expect("walked at from the bank beside a ramp the parapet is a wall: it stops outside it, no higher than the road's edge",
    nearly(side.x - BRIDGE_X, 1.0 + 0.2625, 0.01) and side.y <= bridgeDeck(3., bank) + 0.01) and ok;
  // The bed: the channel is ordinary ground, walked down the yard and down the dingle
  var bedOk = true;
  var moved = 0.;
  var g = 0;
  while g < 2 {
    let x0 = if g == 0 { -26.; } else { -53.; };
    let z0 = if g == 0 { 313.7; } else { 382.; };
    let yaw = if g == 0 { 0.5 * pi; } else { pi; };
    var p0 = 0usize;
    let pts = brookPoints(isl);
    var best = 1000000.;
    var q = 0usize;
    while q < pts.len() {
      let d = (pts[q].x - x0) * (pts[q].x - x0) + (pts[q].z - z0) * (pts[q].z - z0);
      if d < best { best = d; p0 = q; }
      q = q + 1usize;
    }
    let sx = pts[p0].x;
    let sz = pts[p0].z;
    let start = new Vec3(sx, groundHeight(isl, sx, sz), sz);
    let after = walkFrom(&mut s, &mut c, start, yaw, 4., &mut hi);
    let run = ((after.x - sx) * (after.x - sx) + (after.z - sz) * (after.z - sz)).sqrt();
    print <- "  (walked down the "; print <- (if g == 0 { "yard"; } else { "dingle"; }); print <- ": "; print <- run; print <- " m in 4 s, on ground "; print <- after.y - groundHeight(isl, after.x, after.z); print <- ")\n";
    moved = run;
    if run < 5. or !nearly(after.y, groundHeight(isl, after.x, after.z), 0.45) { bedOk = false; }
    g = g + 1;
  }
  ok = expect("the channel bed is walkable: a walker set on it walks along the yard's and the dingle's bed (5 m or more in 4 s)", bedOk) and ok;
  ok;
}

// The layout against the brook: no tree, rock (but the bed stones in the water), fern, hosta or flower in its channel
// (within 2.4 m of the course), and the bed stones' tops over the water and a step or less over the bed
fn checkBrookLayout(isl &Island) bool {
  print <- "The brook's layout:\n";
  let items = vegetationLayout(isl);
  let pts = brookPoints(isl);
  var inChannel = 0usize;
  var nearest f32 = 1000.;
  var stones = 0usize;
  var lips = 0usize;
  var worstAbove f32 = 0.;
  var least f32 = 1000.;
  var most f32 = -1000.;
  var i = 0usize;
  let squat = rockVariant(0u32).bounds().max.y;
  let squat3 = rockVariant(3u32).bounds().max.y;
  print <- "  (the squat rocks' meshes stand "; print <- squat; print <- " and "; print <- squat3; print <- " m; the layout assumes "; print <- SQUAT_ROCK_TOP; print <- ")\n";
  while i < items.len() {
    let it = items[i];
    let d = brookDistanceAt(isl, it.x, it.z);
    if vegBedStone(isl, it) {
      stones = stones + 1usize;
      let top = it.y + rockTop(if it.variant == 0u32 { squat; } else { squat3; }, it.scale);
      let bed = groundHeight(isl, it.x, it.z);
      var k = 0usize;
      let w = pts[0usize].w;
      var idx = 0usize;
      brookNearest(isl, it.x, it.z, &mut idx);
      let over = top - pts[idx].w;
      if over < least { least = over; }
      if over > most { most = over; }
      if top - bed > worstAbove { worstAbove = top - bed; }
    } elif vegLipStone(isl, it) {
      lips = lips + 1usize;
    } else {
      if d < nearest { nearest = d; }
      if d < 2.4 { inChannel = inChannel + 1usize; }
    }
    i = i + 1usize;
  }
  print <- "  ("; print <- stones; print <- " bed stones, tops "; print <- least; print <- " to "; print <- most; print <- " m over the water, at most "; print <- worstAbove;
  print <- " m over the bed; "; print <- lips; print <- " lip stones; the nearest other item "; print <- nearest; print <- " m from the course)\n";
  var ok = expect("no tree, rock, fern, hosta or flower stands in the channel (within 2.4 m of the course)", inChannel == 0usize);
  ok = expect("a good number of bed stones (60 to 140) and of lip stones (80 or more)", stones > 60usize and stones < 140usize and lips >= 80usize) and ok;
  ok = expect("a bed stone's top is 0 to 0.2 m over the water, so it shows", least > 0. and most < 0.2) and ok;
  ok = expect("and no more than a step (0.4 m) over the bed, so a walker wades over it", worstAbove <= STEP_UP) and ok;
  ok;
}

fn checkBrook(isl &Island) bool {
  var ok = checkBrookCourse(isl);
  ok = checkBrookLayout(isl) and ok;
  ok;
}

fn checkBridge(isl &Island) bool { checkBridgeWalk(isl); }
