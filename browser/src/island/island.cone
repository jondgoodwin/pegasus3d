// The island: the browser's own landscape, baked once on the CPU at start-up.
//
// An island about a mile across in water, in metres, y up, sea level y = 0,
// its middle near the origin. Inlets and peninsulas round its coast rise to
// a hill 150 m high; a sheltered lowland on the south shore, in a cove, holds
// the cottage; you land on the cove's beach and a path leads inland to it.
// A walker may go anywhere on it and stops at the water's edge (constrain,
// below: ground more than WADE_DEPTH under the sea is not walked into). The
// vegetation is laid out only inside the 'dressed area', a polygon over the
// beach, the path, the forest and the cottage's lawn; the rest is bare ground.
//
// ONE FIELD. The land is a single grid of heights, N x N samples CELL
// metres apart, covering WORLD metres. The GPU draws it (terrain.slang, from
// the same numbers uploaded as an r32float texture), the walker's feet and
// capsule read it (groundHeight), the water takes its depth from it, and the
// ground's colours are painted from it. 'groundHeight' is exact against the
// drawn triangles: the fine mesh's quads are split into triangles by one
// rule (diagonalFlipped), and the query uses the triangle the mesh has.
//
//   the coast       a signed distance (negative: land), the main body, two
//                   peninsulas and a cove subtracted from them, smoothed, then
//                   warped and roughened by noise near the coast only
//   the hill        150 m, round, its summit and ridges ridged noise, then
//                   the ERODED by a per-point filter (below) on the hill alone
//   the shore       a gentle shelf into the sea, a beach rising 1.5 m in
//                   18 m, a lowland of 4 to 5 m behind it
//   the lowland     rolling a little (the farther from the cottage, the more)
//                   and flat on a pad about the cottage
//   the path        a Catmull-Rom curve from the beach to the cottage's
//                   steps, its height smoothed along it and pressed into the
//                   ground in a ribbon
//
// THE EROSION FILTER (per point, no simulation) follows runevision's "Fast
// and Gorgeous Erosion Filter" (blog.runevision.com, 30 Mar 2026), written
// from his description of it (his Shadertoys could not be fetched): at each
// octave a phacelle noise (noise/phacelle.cone) gives stripes running down
// the slope there, its cosine a gully profile and its sine the profile's
// slope; the gullies are masked to steep ground and faded towards the summit
// and the foot, and the gradient they leave steers the next octave's stripes,
// so smaller gullies branch off larger ones. The filter's constants below
// are mine, tuned by eye on the 2 m grid (nothing finer than 15 m is made:
// a wavelength must stay several cells long).
//
// Everything is deterministic: the bake is a function of the constants here.

mod island;

import collections use *;
import sync use Arc;
import geomath use *;
import libc;
import actors;
import noise;
import render use Image;
import path use Path;
import mesh;
import stdio use *;

// ---- The grid ----

// Metres between samples, samples a side, and the world's edge: the grid
// covers x and z from -HALF to HALF
pub const CELL: f32 = 2.;
pub const N: i32 = 1025;
pub const HALF: f32 = 1024.;

// The fine mesh (a vertex a sample) covers samples FINE_I0 to FINE_I1 in
// x and FINE_J0 to FINE_J1 in z (multiples of 4 samples); outside it the
// coarse mesh has a vertex every 4th sample. The fine mesh is the ground a
// walker stands on exactly (groundHeight), so it covers the whole island's
// land (the coarse mesh beyond it is the sea floor and the sea's edge): a
// walker may go anywhere on the island.
pub const COARSE_STRIDE: i32 = 4;
pub const FINE_I0: i32 = 192;       // x = -640
pub const FINE_I1: i32 = 904;       // x =  784
pub const FINE_J0: i32 = 164;       // z = -696
pub const FINE_J1: i32 = 864;       // z =  704

// ---- The layout ----

// The cottage's frame (the middle of its front wall on the ground, its door
// towards +z, the south, the sea) and where the old flat world's origin went:
// everything the browser had before stands where it stood, shifted by this
pub const COTTAGE_X: f32 = -16.;
pub const COTTAGE_Z: f32 = 330.;
pub const WORLD_DX: f32 = COTTAGE_X + 10.;
pub const WORLD_DZ: f32 = COTTAGE_Z + 24.;

// Where you land: the beach at the cove's head, where the path begins, facing
// north (-z, yaw 0), inland
pub const START_X: f32 = -22.;
pub const START_Z: f32 = 499.;

// The flat pad about the cottage: its middle, how far it is flat, and how far
// it takes to fall into the land about it
pub const PAD_X: f32 = COTTAGE_X + 12.;
pub const PAD_Z: f32 = COTTAGE_Z + 8.;
pub const PAD_FLAT: f32 = 46.;
pub const PAD_BLEND: f32 = 100.;

// The hill: its summit, its radius at the foot, its height
const HILL_X: f32 = 30.;
const HILL_Z: f32 = -230.;
const HILL_RADIUS: f32 = 540.;
pub const HILL_HEIGHT: f32 = 150.;

// ---- Small helpers ----

fn clamp01(x: f32) f32 { if x < 0. { 0. } else if x > 1. { 1. } else { x } }
fn mixf(a: f32, b: f32, t: f32) f32 { a + (b - a) * t }
fn len2(x: f32, z: f32) f32 { (x * x + z * z).sqrt() }
fn absf(x: f32) f32 { libc.fabsf(x) }
fn minf(a: f32, b: f32) f32 { if a < b { a } else { b } }
fn maxf(a: f32, b: f32) f32 { if a > b { a } else { b } }

// GLSL's smoothstep (edges either way round)
fn smooth(a: f32, b: f32, x: f32) f32 {
  let t = clamp01((x - a) / (b - a));
  t * t * (3. - 2. * t)
}

// Quilez's polynomial smooth minimum and maximum, blending over 'k' metres
fn smin(a: f32, b: f32, k: f32) f32 {
  let h = clamp01(0.5 + 0.5 * (b - a) / k);
  mixf(b, a, h) - k * h * (1. - h)
}
fn smax(a: f32, b: f32, k: f32) f32 { 0. - smin(0. - a, 0. - b, k) }

fn sdCapsule(x: f32, z: f32, ax: f32, az: f32, bx: f32, bz: f32, r: f32) f32 {
  let pax = x - ax;
  let paz = z - az;
  let bax = bx - ax;
  let baz = bz - az;
  let h = clamp01((pax * bax + paz * baz) / (bax * bax + baz * baz));
  len2(pax - bax * h, paz - baz * h) - r
}

fn fbm(x: f32, z: f32, seed: u32, octaves: i32) f32 {
  noise.fbm2(Vec2(x, z), seed, octaves, 2., 0.5).value
}

// ---- The coast ----

// The coast's signed distance (metres, negative on land) before any noise:
// a body, two peninsulas to the south and a cove between them
fn baseCoast(x: f32, z: f32) f32 {
  var d = len2(x, z + 40.) - 640.;
  // The east peninsula: reaching south-east
  d = smin(d, sdCapsule(x, z, 420., 380., 700., 600., 75.), 100.);
  // The west one, reaching south and a little east, to shelter the cove
  d = smin(d, sdCapsule(x, z, -330., 430., -250., 720., 65.), 100.);
  // A spit on the cove's east side
  d = smin(d, sdCapsule(x, z, 190., 600., 130., 730., 45.), 60.);
  // The cove itself, cut out of the body's south: the cottage's, its beach at the head
  d = smax(d, 0. - (len2(x + 60., z - 790.) - 290.), 80.);
  // A bay on the north-east, an inlet on the west and a cleft on the north
  d = smax(d, 0. - (len2(x - 430., z + 470.) - 100.), 60.);
  d = smax(d, 0. - (len2(x + 640., z + 60.) - 80.), 50.);
  d = smax(d, 0. - (len2(x + 120., z + 700.) - 70.), 50.);
  d
}

// The coast with its warp and roughness: near the coast only (the noise
// fades out 70 to 130 m away from it, so the far sea and the inland are the
// plain curve and cost nothing)
fn coast(x: f32, z: f32) f32 {
  let d0 = baseCoast(x, z);
  let w = 1. - smooth(70., 130., absf(d0));
  if w <= 0. { return d0; }
  // A domain warp (about 40 m over 300 m) and a roughness (about 20 m at
  // 180 m, six octaves): bays gain islets and the coast gains rocks
  let qx = x + 40. * fbm(x / 300., z / 300., 11u32, 3);
  let qz = z + 40. * fbm(x / 300. + 17., z / 300. - 9., 13u32, 3);
  d0 + w * 22. * fbm(qx / 180., qz / 180., 17u32, 6)
}

// ---- The hill ----

// The hill's raw height (before the erosion), as a fraction of HILL_HEIGHT
// times its summit's, at (x, z): zero beyond its foot
fn hillRaw(x: f32, z: f32) f32 {
  let wx = x + 70. * fbm(x / 300. + 3.1, z / 300. + 7.7, 21u32, 3);
  let wz = z + 70. * fbm(x / 300. + 11.3, z / 300. + 2.2, 23u32, 3);
  // Elongated a little east-west
  let dx = (wx - HILL_X) * 0.86;
  let dz = wz - HILL_Z;
  let t = len2(dx, dz) / HILL_RADIUS;
  if t >= 1. { return 0.; }
  let f = libc.powf(1. - smooth(0., 1., t), 1.4);
  // Ridges: ridged noise, stronger on the flanks than at the summit
  let ridge = noise.ridged2(Vec2(wx / 230., wz / 230.), 29u32, 5, 2., 0.5).value;
  let flank = smooth(0.0, 0.25, t) * (1. - smooth(0.6, 1., t));
  f * 1.0 + 0.16 * f * (ridge - 0.9) * (0.35 + flank)
}

// Eased out: 0 at 0, 1 at 1, steep at the start (runevision's ease_out)
fn easeOut(t: f32) f32 {
  let v = 1. - clamp01(t);
  1. - v * v
}

// The eroded height of a hill point: 'h' metres high with the gradient
// (gx, gz), at (x, z). Four octaves of gullies from 140 m down to 17 m.
fn erode(x: f32, z: f32, h: f32, gx: f32, gz: f32) f32 {
  var sx = gx;
  var sz = gz;
  var out = h;
  var amp: f32 = 9.;
  var wavelength: f32 = 140.;
  var o = 0;
  while o < 4 {
    let sl = len2(sx, sz);
    if sl > 0.02 {
      let dir = Vec2(sx / sl, sz / sl);
      let ph = noise.phacelle2(Vec2(x / wavelength, z / wavelength), dir, 1., 0., 0.4, 31u32 + u32.from(o));
      // Gullies only on slopes (a steeper slope than 0.1 is fully gullied),
      // faded to nothing at the summit and at the foot, so both stay crisp
      let tt = clamp01(h / HILL_HEIGHT);
      let fade = smooth(0.02, 0.2, tt) * (1. - 0.6 * smooth(0.75, 1., tt));
      let k = amp * easeOut(sl / 0.25) * fade;
      // Valleys down to -k, ridges at 0: material is only taken away
      out = out + k * (ph.value.x * 0.5 - 0.5);
      // The profile's slope (per metre), which steers the next octave:
      // d(cos)/dp = -sin * side, over the wavelength
      let ddx = 0. - ph.value.y * ph.side.x / wavelength * k * 0.5;
      let ddz = 0. - ph.value.y * ph.side.y / wavelength * k * 0.5;
      sx = sx + ddx;
      sz = sz + ddz;
    }
    amp = amp * 0.5;
    wavelength = wavelength * 0.5;
    o = o + 1;
  }
  out
}

// ---- The land ----

// Depth of the sea floor 'u' metres out from the coast: gently shelving to
// 30 m
fn seaDepth(u: f32) f32 { minf(30., 0.05 * u + 0.0003 * u * u) }

// The height of the shore and lowland, 's' metres in from the coast
// (negative: out to sea): the sea floor, a beach and a lowland
fn shelf(s: f32) f32 {
  if s < 0. { return 0. - 0.3 - seaDepth(0. - s); }
  mixf(-0.3, 5.8, smooth(0., 90., s)) + 1.2 * smooth(0., 18., s)
}

// How far (x, z) is from the pad's middle, as the pad's blend weight sees it
fn padWeight(x: f32, z: f32) f32 {
  1. - smooth(PAD_FLAT, PAD_BLEND, len2(x - PAD_X, z - PAD_Z))
}

// How much the lowland rolls at (x, z): a little by the cottage, more
// farther off (metres of amplitude)
fn rollAmplitude(x: f32, z: f32) f32 {
  0.8 + 7.5 * smooth(46., 170., len2(x - PAD_X, z - PAD_Z))
}

// The height at (x, z) given the eroded hill's height 'hill' there: before the path
fn landHeight(x: f32, z: f32, hill: f32) f32 {
  let s = 0. - coast(x, z);
  var h = shelf(s);
  if s > 0. {
    h = h + hill * smooth(60., 220., s);
    // Rolling ground: two scales, fading in from the shore
    let roll = fbm(x / 70., z / 70., 41u32, 4) * 0.9 + fbm(x / 26., z / 26., 43u32, 2) * 0.25;
    h = h + roll * rollAmplitude(x, z) * smooth(0., 40., s);
  }
  // The pad: flat at its own height, so the cottage and the things about it stand level
  let pw = padWeight(x, z);
  if pw > 0. { h = mixf(h, PAD_HEIGHT, pw); }
  h
}

// The pad's height: the lowland's, at the pad's middle
pub const PAD_HEIGHT: f32 = 4.6;

// ---- The grid, stored ----

// Sample (i, j) of the field; clamped to the grid
fn sampleIn(heights: &List[f32], i: i32, j: i32) f32 {
  let ci = if i < 0 { 0 } else if i >= N { N - 1 } else { i };
  let cj = if j < 0 { 0 } else if j >= N { N - 1 } else { j };
  *heights[usize.from(cj * N + ci)]
}

// The ground's height at (x, z), exact against the drawn fine mesh's triangles (outside the grid: the sea floor's depth at its
// edge); 0 where there are no heights (the island is not baked: a unit check's flat floor)
fn heightIn(heights: &List[f32], x: f32, z: f32) f32 {
  if heights.len() == 0usize { return 0.; }
  let gx = (x + HALF) / CELL;
  let gz = (z + HALF) / CELL;
  if gx < 0. || gz < 0. || gx >= f32.from(N - 1) || gz >= f32.from(N - 1) { return -30.; }
  let i = i32.from(libc.floorf(gx));
  let j = i32.from(libc.floorf(gz));
  let fx = gx - f32.from(i);
  let fz = gz - f32.from(j);
  let a = sampleIn(heights, i, j);
  let b = sampleIn(heights, i + 1, j);
  let c = sampleIn(heights, i, j + 1);
  let d = sampleIn(heights, i + 1, j + 1);
  if !diagonalFlipped(i, j) {
    // The diagonal from a to d
    if fx >= fz { return a + fx * (b - a) + fz * (d - b); }
    return a + fx * (d - c) + fz * (c - a);
  }
  // The diagonal from b to c
  if fx + fz <= 1. { return a + fx * (b - a) + fz * (c - a); }
  d + (1. - fx) * (c - d) + (1. - fz) * (b - d)
}

// The height of the triangle of the COARSE mesh (a vertex every COARSE_STRIDE samples, quads split by the same rule on the
// vertices' sample indices divided by the stride) over (x, z): what is drawn beyond the fine mesh
fn coarseHeightIn(heights: &List[f32], x: f32, z: f32) f32 {
  if heights.len() == 0usize { return 0.; }
  let gx = (x + HALF) / (CELL * f32.from(COARSE_STRIDE));
  let gz = (z + HALF) / (CELL * f32.from(COARSE_STRIDE));
  let cells = f32.from((N - 1) / COARSE_STRIDE);
  if gx < 0. || gz < 0. || gx >= cells || gz >= cells { return -30.; }
  let ci = i32.from(libc.floorf(gx));
  let cj = i32.from(libc.floorf(gz));
  let fx = gx - f32.from(ci);
  let fz = gz - f32.from(cj);
  let a = sampleIn(heights, ci * COARSE_STRIDE, cj * COARSE_STRIDE);
  let b = sampleIn(heights, (ci + 1) * COARSE_STRIDE, cj * COARSE_STRIDE);
  let c = sampleIn(heights, ci * COARSE_STRIDE, (cj + 1) * COARSE_STRIDE);
  let d = sampleIn(heights, (ci + 1) * COARSE_STRIDE, (cj + 1) * COARSE_STRIDE);
  if !diagonalFlipped(ci, cj) {
    if fx >= fz { return a + fx * (b - a) + fz * (d - b); }
    return a + fx * (d - c) + fz * (c - a);
  }
  if fx + fz <= 1. { return a + fx * (b - a) + fz * (c - a); }
  d + (1. - fx) * (c - d) + (1. - fz) * (b - d)
}

// The height of the coarse mesh's triangle over (x, z), against groundHeight: how far the drawn ground beyond the fine mesh is from
// the ground a walker stands on (--checks measures it)
pub fn coarseGroundHeight(isl: &Island, x: f32, z: f32) f32 {
  coarseHeightIn(&*isl.heights, x, z)
}

// The island as the bake builds it: plain lists, filled in by the bake's steps, each reading what the steps before it made
struct Baking {
  heights: List[f32];
  pathDistance: List[f32];     // metres to the path's centre, capped
  centre: List[Vec3];          // the path's centreline, a point every metre, on the ground
  dressed: List[Vec2];         // the dressed area's polygon
  brook: List[BrookPoint];
  brookDistance: List[f32];    // metres to the course, capped at BROOK_NEAR

  fn empty() Baking {
    Baking(List[f32].empty(), List[f32].empty(), List[Vec3].empty(), List[Vec2].empty(), List[BrookPoint].empty(),
      List[f32].empty())
  }

  fn heightAt(self: &, x: f32, z: f32) f32 { heightIn(&heights, x, z) }
}

// One thing the vegetation's layout puts on the island: a tree, rock, edging stone, hosta, fern or flower (bakedworld's layout.cone
// makes them; they are declared here because the Island holds the list)
pub struct Item {
  pub kind: u32;
  pub variant: u32;
  pub x: f32;
  pub y: f32;                  // the ground's height there (a rock or an edging stone is set into it by its own sink)
  pub z: f32;
  pub yaw: f32;
  pub scale: f32;
  pub radius: f32;             // the footprint it keeps others off by, metres
}

// The baked island, which every query reads: the land's heights and the distance grids, the path's centreline, the dressed area, the
// brook's course and the vegetation's layout. Made once by bake() (the layout is added right after it, by bakedworld's
// 'layOutVegetation') and never changed; each list is a shared read-only owner, so a copy ('share') is a handful of counts and
// every actor, and the physics world, holds one.
pub struct Island {
  heights: Arc[imm, List[f32]];
  pathDistance: Arc[imm, List[f32]];
  centre: Arc[imm, List[Vec3]];
  dressed: Arc[imm, List[Vec2]];
  brook: Arc[imm, List[BrookPoint]];
  brookDistance: Arc[imm, List[f32]];
  vegetation: Arc[imm, List[Item]];   // the vegetation's layout: empty until laid out, and when the vegetation is left out
  pub vegetationOff: bool;     // the vegetation is left out (--no-vegetation): its layout is empty; every caller of it has an island

  // An island with nothing in it: not baked (the ground is 0 m, there is no dressed area)
  pub fn empty() Island { Island.of(Baking.empty()) }

  fn of(b: Baking) Island {
    var src = b;
    var heights = List[f32].empty();
    var pathDistance = List[f32].empty();
    var centre = List[Vec3].empty();
    var dressed = List[Vec2].empty();
    var brook = List[BrookPoint].empty();
    var brookDistance = List[f32].empty();
    heights <-> src.heights;
    pathDistance <-> src.pathDistance;
    centre <-> src.centre;
    dressed <-> src.dressed;
    brook <-> src.brook;
    brookDistance <-> src.brookDistance;
    Island(Arc[imm, List[f32]](heights), Arc[imm, List[f32]](pathDistance), Arc[imm, List[Vec3]](centre),
      Arc[imm, List[Vec2]](dressed), Arc[imm, List[BrookPoint]](brook), Arc[imm, List[f32]](brookDistance),
      Arc[imm, List[Item]](List[Item].empty()), false)
  }

  // Another owner of the same island (what each actor, and the physics world, keeps)
  pub fn share(self: &) Island { Island(heights, pathDistance, centre, dressed, brook, brookDistance, vegetation, vegetationOff) }

  // The same island with the vegetation switched on or off
  pub fn withVegetation(self: &, on: bool) Island {
    Island(heights, pathDistance, centre, dressed, brook, brookDistance, vegetation, !on)
  }

  // The same island with the vegetation's layout in it (made once, after the bake)
  pub fn withLayout(self: &, items: List[Item]) Island {
    Island(heights, pathDistance, centre, dressed, brook, brookDistance, Arc[imm, List[Item]](items), vegetationOff)
  }

  // The vegetation's layout, a copy of the list the island holds
  pub fn layout(self: &) List[Item] {
    let src = &*vegetation;
    var out = List[Item].withCapacity(src.len());
    var i = 0usize;
    while i < src.len() { out.push(*src[i]); i = i + 1usize; }
    out
  }

  fn sample(self: &, i: i32, j: i32) f32 { sampleIn(&*heights, i, j) }
  fn heightAt(self: &, x: f32, z: f32) f32 { heightIn(&*heights, x, z) }

  // Whether (x, z) is inside the dressed area
  fn inside(self: &, x: f32, z: f32) bool { polygonContains(dressed.view(), Vec2(x, z)) }
}

// Whether the quad (i, j) of the mesh is split along its other diagonal,
// the one from its (i + 1, j) corner to its (i, j + 1) corner. The drawn
// meshes use this rule (terrain mesh) and so does the height query.
pub fn diagonalFlipped(i: i32, j: i32) bool { ((i + j) & 1) == 1 }

// The ground's height at (x, z), exact against the drawn fine mesh's triangles
// (outside the grid: the sea floor's depth at its edge)
pub fn groundHeight(isl: &Island, x: f32, z: f32) f32 {
  isl.heightAt(x, z)
}

// The ground's slope (rise over run) at (x, z), by differences either side
pub fn groundSlope(isl: &Island, x: f32, z: f32) f32 {
  let e: f32 = 1.;
  let dx = (groundHeight(isl, x + e, z) - groundHeight(isl, x - e, z)) / (2. * e);
  let dz = (groundHeight(isl, x, z + e) - groundHeight(isl, x, z - e)) / (2. * e);
  len2(dx, dz)
}

// ---- The bake ----

fn bakeGrid(isl: &mut Baking) {
  let total = usize.from(N * N);
  // 1. The hill's scale: its raw summit, found on a coarse grid, set to HILL_HEIGHT
  var top: f32 = 0.;
  var j = 0;
  while j < N {
    var i = 0;
    while i < N {
      let x = f32.from(i) * CELL - HALF;
      let z = f32.from(j) * CELL - HALF;
      let r = hillRaw(x, z);
      if r > top { top = r; }
      i = i + 16;
    }
    j = j + 16;
  }
  let scale = HILL_HEIGHT / top;
  // 2. The raw hill on the grid (where it is not zero)
  var raw = List[f32].withCapacity(total);
  raw.resize(total, 0.);
  // each of the parallel loops fills one buffer a row to a pass
  let row = usize.from(N);
  parallel each jj, line in raw.mutChunks(row).indexed() {
    let j = i32.from(jj);
    each ii, v in line.mutItems().indexed() {
      let i = i32.from(ii);
      let x = f32.from(i) * CELL - HALF;
      let z = f32.from(j) * CELL - HALF;
      *v = (if absf(x - HILL_X) < HILL_RADIUS * 1.3 && absf(z - HILL_Z) < HILL_RADIUS * 1.3 {
        hillRaw(x, z) * scale
      } else { 0. });
    }
  }
  // 3. Eroded: each point of the hill with its gradient
  var eroded = List[f32].withCapacity(total);
  eroded.resize(total, 0.);
  parallel each jj, line in eroded.mutChunks(row).indexed() {
    let j = i32.from(jj);
    each ii, v in line.mutItems().indexed() {
      let i = i32.from(ii);
      let idx = jj * row + ii;
      let h = *raw[idx];
      if h > 1. && i > 0 && i < N - 1 && j > 0 && j < N - 1 {
        let gx = (*raw[idx + 1usize] - *raw[idx - 1usize]) / (2. * CELL);
        let gz = (*raw[idx + row] - *raw[idx - row]) / (2. * CELL);
        *v = erode(f32.from(i) * CELL - HALF, f32.from(j) * CELL - HALF, h, gx, gz);
      } else {
        *v = h;
      }
    }
  }
  // 4. The land: coast, shelf, hill, rolling, pad
  // (filled in a local, then stored: a parallel each lends the items to change only from a local, never a global)
  var land = List[f32].withCapacity(total);
  land.resize(total, 0.);
  parallel each jj, line in land.mutChunks(row).indexed() {
    let j = i32.from(jj);
    each ii, v in line.mutItems().indexed() {
      let x = f32.from(i32.from(ii)) * CELL - HALF;
      let z = f32.from(j) * CELL - HALF;
      *v = landHeight(x, z, *eroded[jj * row + ii]);
    }
  }
  isl.heights = land;
}

// ---- The path ----

// The path's control points, from the landing beach (heading north, -z,
// for its first 22 m) to the foot of the cottage's steps, which it ends at
let PATH_CONTROLS: Array[f32, 18] = [
  -22., 498.,   -22., 476.,   -34., 450.,   -14., 424.,   -38., 400.,
  -12., 378.,   -22., 354.,   -16., 340.,   -16., 333.6];

// The path ends here, at the steps' foot (the cottage's z = 3.6 in front of its wall)
pub const PATH_HALF_WIDTH: f32 = 0.9;
// How far the path's carve reaches
const PATH_REACH: f32 = 6.;


// Catmull-Rom through four points, at t from 0 to 1 between the middle two
fn catmull(p0: f32, p1: f32, p2: f32, p3: f32, t: f32) f32 {
  0.5 * ((2. * p1) + (0. - p0 + p2) * t + (2. * p0 - 5. * p1 + 4. * p2 - p3) * t * t
    + (0. - p0 + 3. * p1 - 3. * p2 + p3) * t * t * t)
}

// The path's polyline, sampled every metre or so along the curve
fn buildCentre() List[Vec2] {
  var centreXZ = List[Vec2].empty();
  let n = 9usize;
  var k = 0usize;
  while k + 1usize < n {
    let i0 = if k == 0usize { 0usize } else { k - 1usize };
    let i3 = if k + 2usize >= n { n - 1usize } else { k + 2usize };
    let ax = PATH_CONTROLS[i0 * 2usize];
    let az = PATH_CONTROLS[i0 * 2usize + 1usize];
    let bx = PATH_CONTROLS[k * 2usize];
    let bz = PATH_CONTROLS[k * 2usize + 1usize];
    let cx = PATH_CONTROLS[(k + 1usize) * 2usize];
    let cz = PATH_CONTROLS[(k + 1usize) * 2usize + 1usize];
    let dx = PATH_CONTROLS[i3 * 2usize];
    let dz = PATH_CONTROLS[i3 * 2usize + 1usize];
    let segLen = len2(cx - bx, cz - bz);
    let steps = i32.from(segLen) + 1;
    var s = 0;
    while s < steps {
      let t = f32.from(s) / f32.from(steps);
      centreXZ.push(Vec2(catmull(ax, bx, cx, dx, t), catmull(az, bz, cz, dz, t)));
      s = s + 1;
    }
    k = k + 1usize;
  }
  centreXZ.push(Vec2(PATH_CONTROLS[16], PATH_CONTROLS[17]));
  centreXZ
}

// The path pressed into the ground: its height smoothed along it (a box of
// about 9 m, twice), then within PATH_REACH of it the ground eased to that
// height less 6 cm; and the grid of distances to it
fn carvePath(isl: &mut Baking) {
  let centreXZ = buildCentre();
  let n = centreXZ.len();
  var hp = List[f32].withCapacity(n);
  var k = 0usize;
  while k < n {
    hp.push(isl.heightAt(centreXZ[k].x, centreXZ[k].y));
    k = k + 1usize;
  }
  var pass = 0;
  while pass < 2 {
    var smoothed = List[f32].withCapacity(n);
    k = 0usize;
    while k < n {
      var sum: f32 = 0.;
      var cnt: f32 = 0.;
      var o = -4;
      while o <= 4 {
        let q = i32.from(k) + o;
        if q >= 0 && q < i32.from(n) { sum = sum + *hp[usize.from(q)]; cnt = cnt + 1.; }
        o = o + 1;
      }
      smoothed.push(sum / cnt);
      k = k + 1usize;
    }
    hp = smoothed;
    pass = pass + 1;
  }
  // Where the path ends the ground is the pad's, so no step: the last point keeps the ground
  hp.set(n - 1usize, PAD_HEIGHT);
  var best = List[f32].withCapacity(usize.from(N * N));
  var target = List[f32].withCapacity(usize.from(N * N));
  isl.pathDistance = List[f32].withCapacity(usize.from(N * N));
  var q = 0;
  while q < N * N {
    best.push(99.);
    target.push(0.);
    isl.pathDistance.push(16.);
    q = q + 1;
  }
  k = 0usize;
  while k + 1usize < n {
    let a = *centreXZ[k];
    let b = *centreXZ[k + 1usize];
    let ha = *hp[k];
    let hb = *hp[k + 1usize];
    let minx = minf(a.x, b.x) - 16.;
    let maxx = maxf(a.x, b.x) + 16.;
    let minz = minf(a.y, b.y) - 16.;
    let maxz = maxf(a.y, b.y) + 16.;
    let i0 = i32.from(libc.floorf((minx + HALF) / CELL));
    let i1 = i32.from(libc.floorf((maxx + HALF) / CELL)) + 1;
    let j0 = i32.from(libc.floorf((minz + HALF) / CELL));
    let j1 = i32.from(libc.floorf((maxz + HALF) / CELL)) + 1;
    var j = j0;
    while j <= j1 {
      var i = i0;
      while i <= i1 {
        let x = f32.from(i) * CELL - HALF;
        let z = f32.from(j) * CELL - HALF;
        let abx = b.x - a.x;
        let abz = b.y - a.y;
        let t = clamp01(((x - a.x) * abx + (z - a.y) * abz) / (abx * abx + abz * abz));
        let d = len2(x - (a.x + abx * t), z - (a.y + abz * t));
        let idx = usize.from(j * N + i);
        if d < *best[idx] {
          best.set(idx, d);
          target.set(idx, mixf(ha, hb, t));
          isl.pathDistance.set(idx, minf(d, 16.));
        }
        i = i + 1;
      }
      j = j + 1;
    }
    k = k + 1usize;
  }
  var idx = 0usize;
  while idx < usize.from(N * N) {
    let d = *best[idx];
    if d < PATH_REACH {
      let w = smooth(PATH_REACH, 1.4, d);
      // Pressed 5 cm into the ground, none at its end, where the pad is level
      let x = f32.from(i32.from(idx) % N) * CELL - HALF;
      let z = f32.from(i32.from(idx) / N) * CELL - HALF;
      let press = 0.05 * smooth(5., 14., len2(x - PATH_CONTROLS[16], z - PATH_CONTROLS[17]));
      isl.heights.set(idx, mixf(*isl.heights[idx], *target[idx] - press, w));
    }
    idx = idx + 1usize;
  }
  // The centreline on the carved ground
  isl.centre = List[Vec3].withCapacity(n);
  k = 0usize;
  while k < n {
    let p = *centreXZ[k];
    isl.centre.push(Vec3(p.x, isl.heightAt(p.x, p.y), p.y));
    k = k + 1usize;
  }
}

// The path's centreline, from the landing beach to the steps' foot: a point
// about every metre, on the ground (x, y, z), for lanterns, edging stones and
// walkers to follow
pub fn pathCentreline(isl: &Island) List[Vec3] {
  var out = List[Vec3].withCapacity(isl.centre.len());
  var k = 0usize;
  while k < isl.centre.len() { out.push(*isl.centre[k]); k = k + 1usize; }
  out
}

// How far (x, z) is from the path's centre, in metres (16 at the most)
pub fn pathDistanceAt(isl: &Island, x: f32, z: f32) f32 {
  if isl.pathDistance.len() == 0usize { return 16.; }
  let gx = clamp01((x + HALF) / (CELL * f32.from(N - 1))) * f32.from(N - 1);
  let gz = clamp01((z + HALF) / (CELL * f32.from(N - 1))) * f32.from(N - 1);
  let i = minf(libc.floorf(gx), f32.from(N - 2));
  let j = minf(libc.floorf(gz), f32.from(N - 2));
  let fx = gx - i;
  let fz = gz - j;
  let ii = i32.from(i);
  let jj = i32.from(j);
  let a = *isl.pathDistance[usize.from(jj * N + ii)];
  let b = *isl.pathDistance[usize.from(jj * N + ii + 1)];
  let c = *isl.pathDistance[usize.from((jj + 1) * N + ii)];
  let d = *isl.pathDistance[usize.from((jj + 1) * N + ii + 1)];
  mixf(mixf(a, b, fx), mixf(c, d, fx), fz)
}

// ---- The dressed area ----

// The area the island is dressed in, corners in order (x, z): the beach, the
// forest to the east and west of the path, the cottage's lawn and the balloon's
// field behind it. The vegetation's layout, the brook's bed stones and the like
// are placed inside it only. It is not a boundary: a walker may go anywhere.
let DRESSED_CORNERS: Array[f32, 22] = [
  -190., 285.,   175., 285.,   200., 430.,   175., 540.,   120., 552.,   60., 525.,
  0., 507.,   -60., 505.,   -120., 512.,   -200., 545.,   -215., 420.];

fn buildDressedArea(isl: &mut Baking) {
  isl.dressed = List[Vec2].empty();
  var k = 0usize;
  while k < 11usize {
    isl.dressed.push(Vec2(DRESSED_CORNERS[k * 2usize], DRESSED_CORNERS[k * 2usize + 1usize]));
    k = k + 1usize;
  }
}

// Whether (x, z) is inside the dressed area
pub fn insideDressed(isl: &Island, x: f32, z: f32) bool {
  isl.inside(x, z)
}

// ---- The shoreline ----

// The deepest water a walker may wade into (metres below the sea's level): the
// shoreline stop. It is the whole of the island's edge: a walker goes anywhere
// on the island, up the hill or round the coast, and stops where the ground
// falls more than this below the sea (knee deep); the grid's own edge is 30 m
// down, so it is stopped there too.
pub const WADE_DEPTH: f32 = 0.6;

// Where a walker who was at 'from' and means to go to 'to' ends up: 'to', if
// that ground is no deeper than WADE_DEPTH; else the step with its seaward part
// taken off, so the walker slides along the shore (the seaward direction is
// the ground's steepest descent where it meant to go, from the height grid's
// central differences over 2 m); else the move along only one axis, if one of
// those is clear; else where it stands. A walker already deeper than the limit
// (it fell in, or was set down in the sea) may go to ground no deeper than its
// own, so it can walk out. Positions are on the ground plane (x, z); y is kept.
pub fn constrain(isl: &Island, from: Vec3, to: Vec3) Vec3 {
  if isl.heights.len() == 0usize { return to; }   // not baked
  let limit = minf(0. - WADE_DEPTH, isl.heightAt(from.x, from.z));
  var p = to;
  if isl.heightAt(p.x, p.z) < limit {
    // The way down at the target: minus the gradient
    let gx = (isl.heightAt(p.x + 1., p.z) - isl.heightAt(p.x - 1., p.z)) * 0.5;
    let gz = (isl.heightAt(p.x, p.z + 1.) - isl.heightAt(p.x, p.z - 1.)) * 0.5;
    let gl = len2(gx, gz);
    var slid = false;
    if gl > 0.0001 {
      let dx = 0. - gx / gl;
      let dz = 0. - gz / gl;
      let sx = p.x - from.x;
      let sz = p.z - from.z;
      let seaward = sx * dx + sz * dz;
      if seaward > 0. {
        let qx = p.x - dx * seaward;
        let qz = p.z - dz * seaward;
        if isl.heightAt(qx, qz) >= limit { p = Vec3(qx, p.y, qz); slid = true; }
      }
    }
    if !slid {
      if isl.heightAt(p.x, from.z) >= limit { p = Vec3(p.x, p.y, from.z); }
      else if isl.heightAt(from.x, p.z) >= limit { p = Vec3(from.x, p.y, p.z); }
      else { p = Vec3(from.x, p.y, from.z); }
    }
  }
  p
}

// ---- Where things may stand ----

// How thickly forest grows at (x, z), 0 to 1: from above the beach to part
// way up the hill, clear of the path and of the cottage's lawn, in patches.
// A scatter places trees by it; the ground's litter is painted from it.
pub fn forestDensity(isl: &Island, x: f32, z: f32) f32 {
  let h = groundHeight(isl, x, z);
  let lowland = smooth(2.8, 4.2, h) * (1. - smooth(50., 85., h));
  let clearing = smooth(34., 58., len2(x - PAD_X, z - PAD_Z));
  let offPath = smooth(2.2, 4.5, pathDistanceAt(isl, x, z));
  let patches = 0.55 + 0.45 * smooth(-0.25, 0.3, fbm(x / 55., z / 55., 61u32, 3));
  lowland * clearing * offPath * patches
}

// How thickly a conifer GROVE stands at (x, z), 0 to 1: the wider island's stands, on the lowland's fringe and the hill's lower slopes (above
// the beach, below the high ground where the hill is bare rock and thin grass), in clumps some 60 to 120 m across with clear ground between,
// off the path, clear of the cottage's clearing and out of the dressed area (the forest's own ground). It is a field of position
// alone, like forestDensity: layout.cone scatters trees by it and --checks ask it where a tree outside the dressed area may stand.
pub fn groveDensity(isl: &Island, x: f32, z: f32) f32 {
  if isl.inside(x, z) { return 0.; }
  let h = groundHeight(isl, x, z);
  let height = smooth(3.6, 6., h) * (1. - smooth(58., 92., h));
  if height <= 0. { return 0.; }
  let clearing = smooth(70., 110., len2(x - PAD_X, z - PAD_Z));
  let offPath = smooth(8., 14., pathDistanceAt(isl, x, z));
  let near = 1. - smooth(300., 480., len2(x - PAD_X, z - PAD_Z));
  let slope = 1. - smooth(0.5, 0.75, groundSlope(isl, x, z));
  // clumps: a coarse noise thresholded to a third of the ground, with a finer one breaking their edges up
  let clump = smooth(0.12, 0.4, fbm(x / 95., z / 95., 177u32, 2) + 0.22 * (fbm(x / 23., z / 23., 178u32, 2) - 0.5));
  height * clearing * offPath * slope * clump * near
}

// ---- The ground's mask ----

// The painted mask the ground shader reads, one RGBA texel a grid sample:
// red the forest litter (the forest's density, softened), green the distance
// to the path over 16 m, blue the brook's over BROOK_NEAR, alpha the conifer
// groves' density (so the far ground is painted darker under the groves, which
// are drawn as trees only near the eye). (The path's distance is also a
// field of its own, pathGrid: a byte is too coarse for it.) Rows from the grid's -z edge (row 0), as the heights are.
pub fn maskImage(isl: &Island) Image {
  var px = List[u8].withCapacity(usize.from(N * N * 4));
  var j = 0;
  while j < N {
    var i = 0;
    while i < N {
      let x = f32.from(i) * CELL - HALF;
      let z = f32.from(j) * CELL - HALF;
      let litter = clamp01(forestDensity(isl, x, z) * 1.4);
      let pd = *isl.pathDistance[usize.from(j * N + i)];
      let bd = *isl.brookDistance[usize.from(j * N + i)];
      px.push(u8.from(litter * 255.));
      px.push(u8.from(clamp01(pd / 16.) * 255.));
      px.push(u8.from(clamp01(bd / BROOK_NEAR) * 255.));
      px.push(u8.from(clamp01(groveDensity(isl, x, z) * 1.5) * 255.));
      i = i + 1;
    }
    j = j + 1;
  }
  Image(N, N, 4, px)
}

// The height grid, for the GPU (one f32 a sample, row by row from -z)
pub fn heightGrid(isl: &Island) List[f32] {
  var out = List[f32].withCapacity(isl.heights.len());
  var k = 0usize;
  while k < isl.heights.len() { out.push(*isl.heights[k]); k = k + 1usize; }
  out
}

// The distance to the path at every sample (metres, 16 at most), for the GPU:
// one f32 a sample, row by row from -z, as the heights are
pub fn pathGrid(isl: &Island) List[f32] {
  var out = List[f32].withCapacity(isl.pathDistance.len());
  var k = 0usize;
  while k < isl.pathDistance.len() { out.push(*isl.pathDistance[k]); k = k + 1usize; }
  out
}

// Bake the island (once)
pub fn bake() Island {
  var isl = Baking.empty();
  bakeGrid(&mut isl);
  buildDressedArea(&mut isl);
  carvePath(&mut isl);
  carveBrook(&mut isl);
  Island.of(isl)
}

// ---- The meshes ----

// A grid of quads over samples i0..i1 by j0..j1, a vertex every 'stride'
// samples, at (x, 0, z) in metres (the shader lifts it), its quads split by
// island's rule on the vertices' sample indices divided by 'stride'; with
// 'hole', the quads wholly inside samples hi0..hi1 by hj0..hj1 left out
fn gridMesh(i0: i32, j0: i32, i1: i32, j1: i32, stride: i32, hole: bool, hi0: i32, hj0: i32, hi1: i32, hj1: i32) mesh.Mesh {
  let cols = (i1 - i0) / stride + 1;
  let rows = (j1 - j0) / stride + 1;
  var m = mesh.Mesh.empty();
  m.positions.reserve(usize.from(cols * rows));
  m.normals.reserve(usize.from(cols * rows));
  m.uvs.reserve(usize.from(cols * rows));
  m.indices.reserve(usize.from(6 * (cols - 1) * (rows - 1)));
  var cj = 0;
  while cj < rows {
    var ci = 0;
    while ci < cols {
      m.positions.push(Vec3(f32.from(i0 + ci * stride) * CELL - HALF, 0., f32.from(j0 + cj * stride) * CELL - HALF));
      m.normals.push(Vec3(0., 1., 0.));
      m.uvs.push(Vec2(0., 0.));
      ci = ci + 1;
    }
    cj = cj + 1;
  }
  cj = 0;
  while cj + 1 < rows {
    var ci = 0;
    while ci + 1 < cols {
      let i = i0 + ci * stride;
      let j = j0 + cj * stride;
      let inside = hole && i >= hi0 && i + stride <= hi1 && j >= hj0 && j + stride <= hj1;
      if !inside {
        let a = u32.from(cj * cols + ci);
        let b = a + 1u32;
        let c = a + u32.from(cols);
        let d = c + 1u32;
        if !diagonalFlipped(i / stride, j / stride) {
          m.indices.push(a); m.indices.push(c); m.indices.push(d);
          m.indices.push(a); m.indices.push(d); m.indices.push(b);
        } else {
          m.indices.push(a); m.indices.push(c); m.indices.push(b);
          m.indices.push(b); m.indices.push(c); m.indices.push(d);
        }
      }
      ci = ci + 1;
    }
    cj = cj + 1;
  }
  m
}

// The fine mesh: a vertex a sample over FINE_I0..FINE_I1 by FINE_J0..FINE_J1
// (exactly the triangles groundHeight answers for)
pub fn fineMesh() mesh.Mesh { gridMesh(FINE_I0, FINE_J0, FINE_I1, FINE_J1, 1, false, 0, 0, 0, 0) }

// The coarse mesh: every 4th sample over the whole grid, with a hole where the fine mesh is
pub fn coarseMesh() mesh.Mesh { gridMesh(0, 0, N - 1, N - 1, COARSE_STRIDE, true, FINE_I0, FINE_J0, FINE_I1, FINE_J1) }

// The sea: a flat grid of 8 m cells over the heightfield's whole extent and,
// round it, a ring of eight big quads out to 8 km
pub fn waterMesh() mesh.Mesh {
  var m = gridMesh(0, 0, N - 1, N - 1, 4, false, 0, 0, 0, 0);
  // The ring: the 4 x 4 corners of -8000, -HALF, HALF, 8000
  var ring = mesh.Mesh.empty();
  let xs: Array[f32, 4] = [-8000., 0. - HALF, HALF, 8000.];
  var r = 0usize;
  while r < 4usize {
    var c = 0usize;
    while c < 4usize {
      ring.positions.push(Vec3(xs[c], 0., xs[r]));
      ring.normals.push(Vec3(0., 1., 0.));
      ring.uvs.push(Vec2(0., 0.));
      c = c + 1usize;
    }
    r = r + 1usize;
  }
  var qr = 0u32;
  while qr < 3u32 {
    var qc = 0u32;
    while qc < 3u32 {
      if !(qr == 1u32 && qc == 1u32) {
        let a = qr * 4u32 + qc;
        let b = a + 1u32;
        let c = a + 4u32;
        let d = c + 1u32;
        ring.indices.push(a); ring.indices.push(c); ring.indices.push(d);
        ring.indices.push(a); ring.indices.push(d); ring.indices.push(b);
      }
      qc = qc + 1u32;
    }
    qr = qr + 1u32;
  }
  m.append(&ring);
  m
}

// ---- The preview ----

fn markPixel(px: &mut List[u8], x: f32, z: f32, r: u8, g: u8, b: u8, radius: i32) {
  let ci = i32.from((x + HALF) / CELL);
  let cj = i32.from((z + HALF) / CELL);
  var dj = 0 - radius;
  while dj <= radius {
    var di = 0 - radius;
    while di <= radius {
      let i = ci + di;
      let j = cj + dj;
      if i >= 0 && i < N && j >= 0 && j < N {
        let at = usize.from(((N - 1 - j) * N + i) * 3);
        px.set(at, r);
        px.set(at + 1usize, g);
        px.set(at + 2usize, b);
      }
      di = di + 1;
    }
    dj = dj + 1;
  }
}

// A picture of the island, N x N pixels, north (-z) up, as a BMP at 'file':
// sea by depth, land by height with contour lines every 10 m, shaded by the slope
pub fn writePreview(file: &str) bool {
  let baked = bake();
  let isl = &baked;
  var px = List[u8].withCapacity(usize.from(N * N * 3));
  // Bottom row first: image row 0 is the south (largest z)
  var j = N - 1;
  while j >= 0 {
    var i = 0;
    while i < N {
      let h = isl.sample(i, j);
      let hx = (isl.sample(i + 1, j) - isl.sample(i - 1, j)) / (2. * CELL);
      let hz = (isl.sample(i, j + 1) - isl.sample(i, j - 1)) / (2. * CELL);
      let lit = clamp01(0.62 + 0.8 * (hx * 0.5 + hz * 0.6));
      var r: f32 = 0.;
      var g: f32 = 0.;
      var b: f32 = 0.;
      if h < 0. {
        let t = clamp01(0. - h / 25.);
        r = 0.05 * (1. - t) + 0.02;
        g = 0.35 * (1. - t) + 0.08;
        b = 0.55 * (1. - t) + 0.25;
      } else if h < 2.4 {
        r = 0.85; g = 0.78; b = 0.55;
      } else {
        let t = clamp01(h / 150.);
        r = (0.25 + 0.5 * t) * lit;
        g = (0.55 - 0.1 * t) * lit;
        b = (0.2 + 0.3 * t) * lit;
        let c = h - 10. * libc.floorf(h / 10.);
        if c < 0.6 && h > 8. { r = r * 0.6; g = g * 0.6; b = b * 0.6; }
      }
      px.push(u8.from(clamp01(r) * 255.));
      px.push(u8.from(clamp01(g) * 255.));
      px.push(u8.from(clamp01(b) * 255.));
      i = i + 1;
    }
    j = j - 1;
  }
  // The path in red-brown, the dressed area in white, the cottage a yellow dot
  var m = 0usize;
  while m < isl.centre.len() {
    markPixel(&mut px, isl.centre[m].x, isl.centre[m].z, 200u8, 80u8, 40u8, 1);
    m = m + 1usize;
  }
  // The brook in blue
  m = 0usize;
  while m < isl.brook.len() {
    markPixel(&mut px, isl.brook[m].x, isl.brook[m].z, 60u8, 140u8, 255u8, 1);
    m = m + 1usize;
  }
  m = 0usize;
  while m < isl.dressed.len() {
    let a = *isl.dressed[m];
    let b = *isl.dressed[if m + 1usize == isl.dressed.len() { 0usize } else { m + 1usize }];
    var t: f32 = 0.;
    while t < 1. {
      markPixel(&mut px, a.x + (b.x - a.x) * t, a.y + (b.y - a.y) * t, 255u8, 255u8, 255u8, 0);
      t = t + 0.01;
    }
    m = m + 1usize;
  }
  markPixel(&mut px, COTTAGE_X, COTTAGE_Z, 255u8, 255u8, 0u8, 3);
  let img = Image(N, N, 3, px);
  img.save(&Path.from(file))
}
