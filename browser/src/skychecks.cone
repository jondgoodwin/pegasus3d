// The sky's checks, run by --checks with no window or GPU: the sky's inputs
// and outputs follow the scene's day clock. The sun is where its formulas put
// it at the clock's noon, dusk and dawn, below the horizon all night, the
// moon above it all night, and the light the scene is given (sun, moon,
// ambient) and the exposure follow the hour. The package's own tests
// (analyticdaylight, boidflock) check the formulas; these check the wiring.

fn deg(r f32) f32 { r * (180. / pi); }

// The elevation, degrees, of the sun at the day clock's hour 'h' under the rig
fn sunDegAt(rig &mut SkyRig, h f32) f32 {
  rig.setHour(h);
  deg(asin(rig.sky.sunDir.y));
}

// The EV100 the scripted exposure is at the day clock's hour 'h'
fn evAt(rig &mut SkyRig, h f32) f32 {
  rig.setHour(h);
  ev100ForSun(rig.sunSine());
}

pub fn checkSky(isl &Island) bool {
  // A rig and a flock of their own: the render actor's rig and the scene
  // actor's flock are theirs
  mut rig = SkyRig.make();
  mut birds = Birds.make(isl);
  mut ok = true;
  print <- "The sky follows the clock:\n";
  // The sun at the day clock's noon, dusk and dawn
  imm noon = sunDegAt(&mut rig, 12.);
  ok = expect("noon: the sun 36.03 degrees up (45 N, 15 October)", nearly(noon, 36.03, 0.05)) and ok;
  rig.setHour(12.);
  ok = expect("noon: due south (x 0, z positive)", nearly(rig.sky.sunDir.x, 0., 0.0001) and rig.sky.sunDir.z > 0.) and ok;
  imm dusk = sunDegAt(&mut rig, f32.from(DUSK_HOUR));
  imm dawn = sunDegAt(&mut rig, f32.from(DAWN_HOUR));
  print <- "  the sun at the clock's dusk (17:28) is "; print <- dusk; print <- " degrees, at dawn (6:31) "; print <- dawn; print <- "\n";
  ok = expect("dusk: the sun's centre at the horizon (-0.84 degrees)", nearly(dusk, -0.84, 0.05)) and ok;
  ok = expect("dawn: the same", nearly(dawn, -0.84, 0.05)) and ok;
  rig.setHour(7.);
  ok = expect("7:00 (the start): the sun in the east, just up", rig.sky.sunDir.x > 0.5 and rig.sky.sunDir.y > 0.03) and ok;
  // Night: the sun below the horizon, the moon above it, the light the moon's
  mut nightOk = true;
  mut moonOk = true;
  mut h = 17.75;
  while h < 30.3 {
    rig.setHour(h);
    if rig.sky.sunDir.y >= 0. { nightOk = false; }
    if rig.sky.moonDir.y <= 0. { moonOk = false; }
    h = h + 0.25;
  }
  ok = expect("17:45 to 6:15: the sun below the horizon at every quarter hour", nightOk) and ok;
  ok = expect("and the moon above it", moonOk) and ok;
  rig.setHour(0.);
  imm night = rig.lighting;
  ok = expect("midnight: the light is the moon's (no sunlight, 0.05 to 0.3 lux), up in the sky",
    lumaOf(night.sunColor) == 0. and lumaOf(night.moonColor) > 0.05 and lumaOf(night.moonColor) < 0.3 and night.lightDir.y > 0.3) and ok;
  ok = expect("midnight: the ambient is not black", lumaOf(night.ambient) > 0.015) and ok;
  // Noon's light
  rig.setHour(12.);
  imm day = rig.lighting;
  print <- "  noon: sun "; print <- lumaOf(day.sunColor); print <- " lux, ambient "; print <- lumaOf(day.ambient); print <- " nits\n";
  ok = expect("noon: the sun about 81 000 lux (36 degrees up), no moonlight", nearly(lumaOf(day.sunColor), 81000., 8000.) and lumaOf(day.moonColor) == 0.) and ok;
  ok = expect("noon: the ambient a few thousand nits, the light the sun, high", lumaOf(day.ambient) > 3000. and lumaOf(day.ambient) < 14000.
    and day.lightDir.y > 0.5) and ok;
  // The exposure: EV 15 at noon, falling to -1 at night, never rising through the evening
  imm evNoon = evAt(&mut rig, 12.);
  ok = expect("noon: the exposure is EV 15", nearly(evNoon, 15., 0.0001)) and ok;
  rig.setHour(12.);
  imm expo = exposureForElevation(rig.sunSine());
  ok = expect("noon: the renderer's exposure is EV 14.5's (half a stop of compensation)",
    nearly(expo / exposureFromEv100(14.5), 1., 0.0001)) and ok;
  ok = expect("midnight: EV -1", nearly(evAt(&mut rig, 0.), -1., 0.0001)) and ok;
  mut falling = true;
  mut prev = evAt(&mut rig, 15.);
  mut e = 15.25;
  while e < 21. {
    imm ev = evAt(&mut rig, e);
    if ev > prev + 0.0001 { falling = false; }
    prev = ev;
    e = e + 0.25;
  }
  ok = expect("15:00 to 21:00: the exposure's EV only falls", falling) and ok;
  // The dusk level T5's lanterns switch on at, as the day clock reads it
  mut hh = 17.;
  print <- "  the ambient light by the evening clock (nits), the exposure's EV:\n";
  while hh < 21.1 {
    rig.setHour(hh);
    print <- "    "; print <- hh; print <- " h: sun "; print <- deg(asin(rig.sky.sunDir.y)); print <- " deg, ambient ";
    print <- lumaOf(rig.lighting.ambient); print <- ", EV "; print <- ev100ForSun(rig.sunSine()); print <- "\n";
    hh = hh + 0.5;
  }
  // The birds: forty, over the cottage, after a short flight still over it
  ok = expect("forty birds in the flock", birds.flock.birds.len() == BIRD_COUNT) and ok;
  birds.step(isl, 5.);
  mut closeBy = true;
  mut i = 0usize;
  while i < birds.flock.birds.len() {
    imm b = *birds.flock.birds[i];
    imm dx = b.pos.x - BIRD_HOME_X;
    imm dz = b.pos.z - BIRD_HOME_Z;
    if (dx * dx + dz * dz).sqrt() > 150. or b.pos.y < groundHeight(isl, b.pos.x, b.pos.z) + 3. { closeBy = false; }
    i = i + 1usize;
  }
  ok = expect("after 5 s every bird is within 150 m of the cottage and 3 m above the ground", closeBy) and ok;
  ok = checkWeather() and ok;
  ok;
}

// The weather's wiring (parts/weather.cone): the wind, the crossfade, and
// that the fair state is the look the browser had before there was weather
fn checkWeather() bool {
  mut ok = true;
  print <- "The weather:\n";
  // The wind carries a layer's pattern speed x time along +x: the low clouds' 7 m/s, the cirrus's 11
  imm low = cloudOffset(false, 60d);
  imm high = cloudOffset(true, 60d);
  print <- "  after 60 s the low layer is carried "; print <- low.x; print <- " m, the cirrus "; print <- high.x; print <- " m\n";
  ok = expect("the low clouds are carried 7 m/s x 60 s = 420 m east (+x), none north or south",
    nearly(low.x, 420., 0.001) and nearly(low.y, 0., 0.0001)) and ok;
  ok = expect("the cirrus 11 m/s x 60 s = 660 m east", nearly(high.x, 660., 0.001) and nearly(high.y, 0., 0.0001)) and ok;
  ok = expect("the wind is a unit vector towards +x and the cirrus is faster",
    nearly(WIND_DIR_X * WIND_DIR_X + WIND_DIR_Z * WIND_DIR_Z, 1., 0.00001) and WIND_DIR_X > 0. and WIND_HIGH > WIND_LOW) and ok;
  ok = expect("the offset is nothing at time 0 and grows in a line with time",
    cloudOffset(false, 0d).x == 0. and nearly(cloudOffset(false, 600d).x, 10. * low.x, 0.01)) and ok;
  // A crossfade is the state it left until it begins, a blend, and the target from its end on
  mut w = Weathering.fair();
  w.goTo(WEATHER_RAIN, 100d, 12.);
  imm rain = WeatherParams.state(WEATHER_RAIN);
  imm fair = WeatherParams.state(WEATHER_FAIR);
  imm snow = WeatherParams.state(WEATHER_SNOW);
  ok = expect("a crossfade to rain begun at 100 s is the fair state at 100 s", w.at(100d).same(&fair) and w.at(50d).same(&fair)) and ok;
  imm mid = w.at(106d);
  ok = expect("and half way through (smoothstep 0.5) every field is the mean of the two",
    nearly(mid.cloudLow, (fair.cloudLow + rain.cloudLow) * 0.5, 0.0001) and nearly(mid.fog, (fair.fog + rain.fog) * 0.5, 0.000001)
    and nearly(mid.rain, 0.5, 0.0001) and nearly(mid.ev, (fair.ev + rain.ev) * 0.5, 0.0001)) and ok;
  ok = expect("it is exactly the target at start + duration (112 s) and after", w.at(112d).same(&rain) and w.at(5000d).same(&rain)) and ok;
  mut monotone = true;
  mut t = 100d;
  mut last = 0.;
  while t <= 112d {
    imm r = w.at(t).rain;
    if r < last - 0.000001 { monotone = false; }
    last = r;
    t = t + 0.5d;
  }
  ok = expect("the rain's strength only rises through the fade", monotone) and ok;
  // A press part way starts from what is on screen
  w.goTo(WEATHER_SNOW, 106d, 12.);
  ok = expect("a key part way through starts from the blend then on screen, and ends on the new target",
    w.at(106d).same(&mid) and w.at(118d).same(&snow)) and ok;
  mut c = Weathering.fair();
  mut cycled = true;
  mut s = 0u32;
  while s < WEATHER_STATES {
    c.cycle(0d);
    if c.target != (WEATHER_FAIR + 1u32 + s) % WEATHER_STATES { cycled = false; }
    s = s + 1u32;
  }
  ok = expect("the key cycles through the six states and back to where it began", cycled and c.target == WEATHER_FAIR) and ok;
  // Fair is the look before weather: the cover the sky had, and everything else as the day gives it
  ok = expect("fair is the old cover, 0.42 and 0.5", fair.cloudLow == 0.42 and fair.cloudHigh == 0.5) and ok;
  ok = expect("and nothing else changed: full density, light, sun, ambient and tint, no grey, dimming, fog, exposure offset, rain or snow",
    fair.density == 1. and fair.cloudLight == 1. and fair.skyGrey == 0. and fair.skyDim == 1. and fair.sunDim == 1. and fair.fog == 0.
    and fair.ambient == 1. and fair.tintRed == 1. and fair.tintGreen == 1. and fair.tintBlue == 1. and fair.ev == 0. and fair.rain == 0.
    and fair.snow == 0.) and ok;
  ok = expect("a world that has had no key is fair at any time", Weathering.fair().at(0d).same(&fair) and Weathering.fair().at(86400d).same(&fair)) and ok;
  mut rig = SkyRig.make();
  rig.setHour(12.);
  imm plain = rig.look();
  rig.setWeather(fair);
  imm lit = rig.look();
  ok = expect("under fair weather the rig's light is the day's own, to the bit",
    lit.sunColor.red == rig.lighting.lightColor.x and lit.sunColor.green == rig.lighting.lightColor.y
    and lit.ambient.red == rig.lighting.ambient.x and lit.ambient.blue == rig.lighting.ambient.z
    and lit.sunColor.red == plain.sunColor.red and rig.exposureScale() == 1.) and ok;
  rig.setWeather(rain);
  imm wet = rig.look();
  ok = expect("under rain the direct light is gone, the ambient is dimmer, and the exposure opens up",
    wet.sunColor.red == 0. and wet.ambient.green < lit.ambient.green and rig.exposureScale() > 2.) and ok;
  ok;
}
