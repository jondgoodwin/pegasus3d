// The sky's checks, run by --checks with no window or GPU: the sky's inputs
// and outputs follow the scene's day clock. The sun is where its formulas put
// it at the clock's noon, dusk and dawn, below the horizon all night, the
// moon above it all night, and the light the scene is given (sun, moon,
// ambient) and the exposure follow the hour. The package's own tests
// (analyticdaylight, boidflock) check the formulas; these check the wiring.

fn deg(r: f32) f32 { r * (180. / pi) }

// The elevation, degrees, of the sun at the day clock's hour 'h' under the rig
fn sunDegAt(rig: &mut SkyRig, h: f32) f32 {
  rig.setHour(h);
  deg(asin(rig.sky.sunDir.y))
}

// The EV100 the scripted exposure is at the day clock's hour 'h'
fn evAt(rig: &mut SkyRig, h: f32) f32 {
  rig.setHour(h);
  ev100ForSun(rig.sunSine())
}

pub fn checkSky(isl: &Island) bool {
  // A rig and a flock of their own: the render actor's rig and the scene
  // actor's flock are theirs
  var rig = SkyRig.make();
  var birds = Birds.make(isl);
  var ok = true;
  print <- "The sky follows the clock:\n";
  // The sun at the day clock's noon, dusk and dawn
  let noon = sunDegAt(&mut rig, 12.);
  ok = expect("noon: the sun 36.03 degrees up (45 N, 15 October)", nearly(noon, 36.03, 0.05)) && ok;
  rig.setHour(12.);
  ok = expect("noon: due south (x 0, z positive)", nearly(rig.sky.sunDir.x, 0., 0.0001) && rig.sky.sunDir.z > 0.) && ok;
  let dusk = sunDegAt(&mut rig, f32.from(DUSK_HOUR));
  let dawn = sunDegAt(&mut rig, f32.from(DAWN_HOUR));
  print <- "  the sun at the clock's dusk (17:28) is "; print <- dusk; print <- " degrees, at dawn (6:31) "; print <- dawn; print <- "\n";
  ok = expect("dusk: the sun's centre at the horizon (-0.84 degrees)", nearly(dusk, -0.84, 0.05)) && ok;
  ok = expect("dawn: the same", nearly(dawn, -0.84, 0.05)) && ok;
  rig.setHour(7.);
  ok = expect("7:00 (the start): the sun in the east, just up", rig.sky.sunDir.x > 0.5 && rig.sky.sunDir.y > 0.03) && ok;
  // Night: the sun below the horizon, the moon above it, the light the moon's
  var nightOk = true;
  var moonOk = true;
  var h = 17.75f;
  while h < 30.3 {
    rig.setHour(h);
    if rig.sky.sunDir.y >= 0. { nightOk = false; }
    if rig.sky.moonDir.y <= 0. { moonOk = false; }
    h = h + 0.25;
  }
  ok = expect("17:45 to 6:15: the sun below the horizon at every quarter hour", nightOk) && ok;
  ok = expect("and the moon above it", moonOk) && ok;
  rig.setHour(0.);
  let night = rig.lighting;
  ok = expect("midnight: the light is the moon's (no sunlight, 0.05 to 0.3 lux), up in the sky",
    lumaOf(night.sunColor) == 0. && lumaOf(night.moonColor) > 0.05 && lumaOf(night.moonColor) < 0.3 && night.lightDir.y > 0.3) && ok;
  ok = expect("midnight: the ambient is not black", lumaOf(night.ambient) > 0.015) && ok;
  // Noon's light
  rig.setHour(12.);
  let day = rig.lighting;
  print <- "  noon: sun "; print <- lumaOf(day.sunColor); print <- " lux, ambient "; print <- lumaOf(day.ambient); print <- " nits\n";
  ok = expect("noon: the sun about 81 000 lux (36 degrees up), no moonlight", nearly(lumaOf(day.sunColor), 81000., 8000.) && lumaOf(day.moonColor) == 0.) && ok;
  ok = expect("noon: the ambient a few thousand nits, the light the sun, high", lumaOf(day.ambient) > 3000. && lumaOf(day.ambient) < 14000.
    && day.lightDir.y > 0.5) && ok;
  // The exposure: EV 15 at noon, falling to -1 at night, never rising through the evening
  let evNoon = evAt(&mut rig, 12.);
  ok = expect("noon: the exposure is EV 15", nearly(evNoon, 15., 0.0001)) && ok;
  rig.setHour(12.);
  let expo = exposureForElevation(rig.sunSine());
  ok = expect("noon: the renderer's exposure is EV 14.5's (half a stop of compensation)",
    nearly(expo / exposureFromEv100(14.5), 1., 0.0001)) && ok;
  ok = expect("midnight: EV -1", nearly(evAt(&mut rig, 0.), -1., 0.0001)) && ok;
  var falling = true;
  var prev = evAt(&mut rig, 15.);
  var e = 15.25f;
  while e < 21. {
    let ev = evAt(&mut rig, e);
    if ev > prev + 0.0001 { falling = false; }
    prev = ev;
    e = e + 0.25;
  }
  ok = expect("15:00 to 21:00: the exposure's EV only falls", falling) && ok;
  // The dusk level T5's lanterns switch on at, as the day clock reads it
  var hh = 17.f;
  print <- "  the ambient light by the evening clock (nits), the exposure's EV:\n";
  while hh < 21.1 {
    rig.setHour(hh);
    print <- "    "; print <- hh; print <- " h: sun "; print <- deg(asin(rig.sky.sunDir.y)); print <- " deg, ambient ";
    print <- lumaOf(rig.lighting.ambient); print <- ", EV "; print <- ev100ForSun(rig.sunSine()); print <- "\n";
    hh = hh + 0.5;
  }
  // The birds: forty, over the cottage, after a short flight still over it
  ok = expect("forty birds in the flock", birds.flock.birds.len() == BIRD_COUNT) && ok;
  birds.step(isl, 5.);
  var closeBy = true;
  var i = 0usize;
  while i < birds.flock.birds.len() {
    let b = *birds.flock.birds[i];
    let dx = b.pos.x - BIRD_HOME_X;
    let dz = b.pos.z - BIRD_HOME_Z;
    if (dx * dx + dz * dz).sqrt() > 150. || b.pos.y < groundHeight(isl, b.pos.x, b.pos.z) + 3. { closeBy = false; }
    i = i + 1usize;
  }
  ok = expect("after 5 s every bird is within 150 m of the cottage and 3 m above the ground", closeBy) && ok;
  ok = checkWeather() && ok;
  ok
}

// The weather's wiring (parts/weather.cone): the wind, the crossfade, and
// that the fair state is the look the browser had before there was weather
fn checkWeather() bool {
  var ok = true;
  print <- "The weather:\n";
  // The wind carries a layer's pattern speed x time along +x: the low clouds' 7 m/s, the cirrus's 11
  let low = cloudOffset(false, 60.0);
  let high = cloudOffset(true, 60.0);
  print <- "  after 60 s the low layer is carried "; print <- low.x; print <- " m, the cirrus "; print <- high.x; print <- " m\n";
  ok = expect("the low clouds are carried 7 m/s x 60 s = 420 m east (+x), none north or south",
    nearly(low.x, 420., 0.001) && nearly(low.y, 0., 0.0001)) && ok;
  ok = expect("the cirrus 11 m/s x 60 s = 660 m east", nearly(high.x, 660., 0.001) && nearly(high.y, 0., 0.0001)) && ok;
  ok = expect("the wind is a unit vector towards +x and the cirrus is faster",
    nearly(WIND_DIR_X * WIND_DIR_X + WIND_DIR_Z * WIND_DIR_Z, 1., 0.00001) && WIND_DIR_X > 0. && WIND_HIGH > WIND_LOW) && ok;
  ok = expect("the offset is nothing at time 0 and grows in a line with time",
    cloudOffset(false, 0.0).x == 0. && nearly(cloudOffset(false, 600.0).x, 10. * low.x, 0.01)) && ok;
  // A crossfade is the state it left until it begins, a blend, and the target from its end on
  var w = Weathering.fair();
  w.goTo(WEATHER_RAIN, 100.0, 12.);
  let rain = WeatherParams.state(WEATHER_RAIN);
  let fair = WeatherParams.state(WEATHER_FAIR);
  let snow = WeatherParams.state(WEATHER_SNOW);
  ok = expect("a crossfade to rain begun at 100 s is the fair state at 100 s", w.at(100.0).same(&fair) && w.at(50.0).same(&fair)) && ok;
  let mid = w.at(106.0);
  ok = expect("and half way through (smoothstep 0.5) every field is the mean of the two",
    nearly(mid.cloudLow, (fair.cloudLow + rain.cloudLow) * 0.5, 0.0001) && nearly(mid.fog, (fair.fog + rain.fog) * 0.5, 0.000001)
    && nearly(mid.rain, 0.5, 0.0001) && nearly(mid.ev, (fair.ev + rain.ev) * 0.5, 0.0001)) && ok;
  ok = expect("it is exactly the target at start + duration (112 s) and after", w.at(112.0).same(&rain) && w.at(5000.0).same(&rain)) && ok;
  var monotone = true;
  var t = 100.0f;
  var last = 0.f;
  while t <= 112.0 {
    let r = w.at(t).rain;
    if r < last - 0.000001 { monotone = false; }
    last = r;
    t = t + 0.5;
  }
  ok = expect("the rain's strength only rises through the fade", monotone) && ok;
  // A press part way starts from what is on screen
  w.goTo(WEATHER_SNOW, 106.0, 12.);
  ok = expect("a key part way through starts from the blend then on screen, and ends on the new target",
    w.at(106.0).same(&mid) && w.at(118.0).same(&snow)) && ok;
  var c = Weathering.fair();
  var cycled = true;
  var s = 0u32;
  while s < WEATHER_STATES {
    c.cycle(0.0);
    if c.target != (WEATHER_FAIR + 1u32 + s) % WEATHER_STATES { cycled = false; }
    s = s + 1u32;
  }
  ok = expect("the key cycles through the six states and back to where it began", cycled && c.target == WEATHER_FAIR) && ok;
  // Fair is the look before weather: the cover the sky had, and everything else as the day gives it
  ok = expect("fair is the old cover, 0.42 and 0.5", fair.cloudLow == 0.42 && fair.cloudHigh == 0.5) && ok;
  ok = expect("and nothing else changed: full density, light, sun, ambient and tint, no grey, dimming, fog, exposure offset, rain or snow",
    fair.density == 1. && fair.cloudLight == 1. && fair.skyGrey == 0. && fair.skyDim == 1. && fair.sunDim == 1. && fair.fog == 0.
    && fair.ambient == 1. && fair.tintRed == 1. && fair.tintGreen == 1. && fair.tintBlue == 1. && fair.ev == 0. && fair.rain == 0.
    && fair.snow == 0.) && ok;
  ok = expect("a world that has had no key is fair at any time", Weathering.fair().at(0.0).same(&fair) && Weathering.fair().at(86400.0).same(&fair)) && ok;
  var rig = SkyRig.make();
  rig.setHour(12.);
  let plain = rig.look();
  rig.setWeather(fair);
  let lit = rig.look();
  ok = expect("under fair weather the rig's light is the day's own, to the bit",
    lit.sunColor.red == rig.lighting.lightColor.x && lit.sunColor.green == rig.lighting.lightColor.y
    && lit.ambient.red == rig.lighting.ambient.x && lit.ambient.blue == rig.lighting.ambient.z
    && lit.sunColor.red == plain.sunColor.red && rig.exposureScale() == 1.) && ok;
  rig.setWeather(rain);
  let wet = rig.look();
  ok = expect("under rain the direct light is gone, the ambient is dimmer, and the exposure opens up",
    wet.sunColor.red == 0. && wet.ambient.green < lit.ambient.green && rig.exposureScale() > 2.) && ok;
  ok
}
