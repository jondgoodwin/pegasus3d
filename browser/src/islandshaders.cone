// The island's two shaders, as render's custom pipelines (shaders.cone's
// makeShaderPipeline hands these out for SHADER_TERRAIN and SHADER_WATER):
// the terrain's (terrain.slang) and the water's (water.slang), compiled
// ahead of time by Cone's tools/shaders/shaders.py, run over this folder,
// and embedded below.
//
// The terrain's material: 32 bytes of parameters, the heights (an r32float
// texture, read texel by texel) and the ground's mask (an RGBA8 image,
// filtered). The water's: 32 bytes and the heights. Both read the position
// stream alone.

pub fn makeTerrainPipeline(renderer &mut Renderer, device &mut Device) PipelineHandle {
  imm textures = [TEXTURE_SAMPLE_TYPE_UNFILTERABLE_FLOAT, TEXTURE_SAMPLE_TYPE_UNFILTERABLE_FLOAT, TEXTURE_SAMPLE_TYPE_FLOAT];
  imm desc = new CustomPipeline(spirv: &TERRAIN_SPIRV, textures: &textures, paramBytes: 32u64, streams: 1u32);
  renderer.addPipeline(device, &desc);
}

pub fn makeWaterPipeline(renderer &mut Renderer, device &mut Device) PipelineHandle {
  imm textures = [TEXTURE_SAMPLE_TYPE_UNFILTERABLE_FLOAT];
  imm desc = new CustomPipeline(spirv: &WATER_SPIRV, textures: &textures, paramBytes: 32u64, streams: 1u32);
  renderer.addPipeline(device, &desc);
}

