// People as assets: humanbody's people (game-quality bodies, a face that moves, clothes, a cape), made once and kept on disk.
//
// humanbody builds a person from measures: the base meshes of both sexes and their 29 blends take about 16 s each, a person's
// body, face and clothes 40 ms, the avatar's cape a second. That is too much to pay at every start, so a person is made ONCE and
// stored as a file of the data a browser draws and animates with (a PersonAsset): the body mesh and its skin, the face's morph
// targets, the eyes, ears, teeth, tongue and mouth, the clothes as pieces, the cape settled as a static drape, the skin's painted
// albedo and roughness, the 22-bone skeleton (the 19 of bonepose's humanoid with the person's own hips and shoulders, and the jaw
// and the eyes), and the face rig's spec. The blend sets are never needed again once every person is stored.
//
// WHERE. A stored person is looked for in this order: PEGASUS_PEOPLE_CACHE (a folder), a folder 'people' beside the executable
// (what a zip carries), %LOCALAPPDATA%\pegasus3d\people (XDG_CACHE_HOME or ~/.cache elsewhere). One made here is stored in the
// first of PEGASUS_PEOPLE_CACHE or the user cache folder. `browser.exe --bake-people DIR` makes every person and stores them in
// DIR (to put in a zip).
//
// THE KEY is the file's name: the format number and PEOPLE_REVISION (the humanbody revision these were made from: bump it when
// the package's cast, its meshes or its clothes change), the person's number and name, and PEGASUS_BAKE_SALT. NOT the program, so
// a new build of the browser does not make 16 s of blends again. A file is read only if its magic, format, key, length and
// checksum agree; any other is ignored and made again.
//
// WHO HOLDS THEM. People is the registry, read-only and shared by the actors (an Arc, as the island's data is); the simulation
// takes a person's skeleton and hips from it, a view the same and also the meshes it defines in the scene (personview.cone).

pub const PEOPLE_FORMAT = 1u32;
// The humanbody revision (Cone master's merge of PR #657) the stored people are made from
pub const PEOPLE_REVISION = "humanbody-25b216477-a";
pub const PEOPLE_MAGIC = 0x4b504550u32;       // "PEPK"
const PK_FNV_OFFSET = 14695981039346656037u64;
const PK_FNV_PRIME = 1099511628211u64;
const PK_MAX_BYTES = 1073741824usize;
// The skin's texture size (a side, texels) as stored
pub const SKIN_TEXTURE = 1024;

extern {
  fn @c("SDL_GetBasePath") pkBasePath() *u8;
}

// A piece of clothing: a shell of the body, skinned as it, in a colour
pub struct PieceAsset {
  pub name: String;
  pub mesh: Mesh;
  pub skin: Skin;
  pub color: Vec3;            // sRGB 0 to 255
  pub kind: u32;              // humanbody's CLOTH_...
}

// A rigid part of the head or face: its mesh and skin
pub struct SkinnedAsset {
  pub mesh: Mesh;
  pub skin: Skin;

  pub fn empty() SkinnedAsset { SkinnedAsset(Mesh.empty(), Skin.empty()) }
}

// Everything a browser needs of one person
pub struct PersonAsset {
  pub index: u32;                     // in humanbody's cast
  pub name: String;
  pub sex: u32;
  pub height: f32;
  pub hipSpan: f32;                   // the hip joints' distance from the midline, over the height (walkgait's Walker.hipSpan)
  pub skeleton: bonepose.Skeleton;    // 22 bones: the humanoid's 19 and the jaw and the eyes
  pub body: Mesh;                     // the dressed body: the whole mesh, and 'bodyIndices' the triangles not under clothes
  pub bodySkin: Skin;
  pub morph: MorphTargets;            // the face's targets, at their natural strengths
  pub spec: facerig.FaceSpec;
  pub unitTarget: List[i32];          // each unit's target
  pub targetCount: usize;
  pub faceHead: u32;                  // facerig's FaceBones: the head, jaw and eye bones, and the spec frame's origin in the head's
  pub faceJaw: u32;
  pub faceEyeL: u32;
  pub faceEyeR: u32;
  pub faceOrigin: Vec3;
  pub eyes: SkinnedAsset;
  pub ears: SkinnedAsset;
  pub teeth: SkinnedAsset;
  pub tongue: SkinnedAsset;
  pub cavity: SkinnedAsset;
  pub pieces: List[PieceAsset];
  pub cape: SkinnedAsset;             // the avatar's cape, settled (empty mesh for the others)
  pub albedo: Image;                  // the skin's painted albedo (sRGB) and roughness (linear, green)
  pub rough: Image;
  pub iris: Vec3;                     // sRGB 0 to 255

  pub fn hasCape(self: &) bool { cape.mesh.positions.len() > 0usize }

  // The face bones, as facerig has them
  pub fn faceBones(self: &) facerig.FaceBones {
    facerig.FaceBones(usize.from(faceHead), usize.from(faceJaw), usize.from(faceEyeL), usize.from(faceEyeR), faceOrigin)
  }
}

// The parts a person is in the scene: its own (the body) and under it the eyes, ears, teeth, tongue and mouth, each piece of clothing
// and the cape
pub fn personPartCount(a: &PersonAsset) usize {
  1usize + 5usize + a.pieces.len() + if a.hasCape() { 1usize } else { 0usize }
}

// The people a browser has, shared by its actors
pub struct People {
  pub assets: Arc[imm, List[PersonAsset]];

  pub fn empty() People { People(Arc[imm, List[PersonAsset]](List[PersonAsset].empty())) }
  pub fn share(self: &) People { People(assets) }
  pub fn count(self: &) usize { (&*assets).len() }
  pub fn has(self: &) bool { (&*assets).len() > 0usize }
  pub fn at(self: &, i: usize) &PersonAsset { &(&*assets)[i] }
}

// ---- The file ----

fn pkMixByte(h: u64, b: u8) u64 { (h ^ u64.from(b)) * PK_FNV_PRIME }

fn pkMixU64(h: u64, x: u64) u64 {
  var r = h;
  var k = 0u32;
  while k < 8u32 {
    r = pkMixByte(r, u8.from((x >> (k * 8u32)) & 0xFFu64));
    k = k + 1u32;
  }
  r
}

fn pkMixText(h: u64, s: &str) u64 {
  let b: &Array[u8] = s;
  var r = h;
  var i = 0usize;
  while i < b.len {
    r = pkMixByte(r, b[i]);
    i = i + 1usize;
  }
  pkMixByte(r, 0u8)
}

fn pkHex(x: u64) String {
  var out = String.empty();
  var k = 16i32;
  while k > 0i32 {
    k = k - 1i32;
    let d = u8.from((x >> (u64.from(k) * 4u64)) & 0xFu64);
    out.appendByte(if d < 10u8 { '0' + d } else { 'a' + (d - 10u8) });
  }
  out
}

fn pkSum(p: *u8, n: usize) u64 {
  var h = PK_FNV_OFFSET;
  let words = n / 8usize;
  let w = p as *u64;
  var i = 0usize;
  while i < words {
    h = ((h ^ *(w + i)) * PK_FNV_PRIME) ^ (h >> 29u64);
    i = i + 1usize;
  }
  var j = words * 8usize;
  while j < n {
    h = pkMixByte(h, *(p + j));
    j = j + 1usize;
  }
  h
}

fn pkPutU32(out: &mut List[u8], x: u32) {
  var k = 0u32;
  while k < 4u32 { out.push(u8.from((x >> (k * 8u32)) & 0xFFu32)); k = k + 1u32; }
}

fn pkPutU64(out: &mut List[u8], x: u64) {
  var k = 0u32;
  while k < 8u32 { out.push(u8.from((x >> (u64.from(k) * 8u64)) & 0xFFu64)); k = k + 1u32; }
}

fn pkPutRaw(out: &mut List[u8], src: *u8, n: usize) {
  let at = out.len();
  out.resize(at + n, 0u8);
  if n > 0usize { libc.memcpy((out.viewMut() as *u8) + at, src, n); }
}

// A float as its four bytes
fn pkPutF32(out: &mut List[u8], x: f32) {
  var one = List[f32].empty();
  one.push(x);
  let p: *f32 = one.view() as *f32;
  pkPutRaw(out, p as *u8, 4usize);
}

fn pkPutVec3(out: &mut List[u8], v: Vec3) { pkPutF32(out, v.x); pkPutF32(out, v.y); pkPutF32(out, v.z); }

fn pkPutVec3s(out: &mut List[u8], l: &List[Vec3]) {
  pkPutU64(out, u64.from(l.len()));
  let p: *Vec3 = l.view() as *Vec3;
  pkPutRaw(out, p as *u8, l.len() * 12usize);
}

fn pkPutVec2s(out: &mut List[u8], l: &List[Vec2]) {
  pkPutU64(out, u64.from(l.len()));
  let p: *Vec2 = l.view() as *Vec2;
  pkPutRaw(out, p as *u8, l.len() * 8usize);
}

fn pkPutU32s(out: &mut List[u8], l: &List[u32]) {
  pkPutU64(out, u64.from(l.len()));
  let p: *u32 = l.view() as *u32;
  pkPutRaw(out, p as *u8, l.len() * 4usize);
}

fn pkPutI32s(out: &mut List[u8], l: &List[i32]) {
  pkPutU64(out, u64.from(l.len()));
  let p: *i32 = l.view() as *i32;
  pkPutRaw(out, p as *u8, l.len() * 4usize);
}

fn pkPutF32s(out: &mut List[u8], l: &List[f32]) {
  pkPutU64(out, u64.from(l.len()));
  let p: *f32 = l.view() as *f32;
  pkPutRaw(out, p as *u8, l.len() * 4usize);
}

fn pkPutBytes(out: &mut List[u8], l: &List[u8]) {
  pkPutU64(out, u64.from(l.len()));
  pkPutRaw(out, l.view() as *u8, l.len());
}

fn pkPutString(out: &mut List[u8], s: &String) {
  let b: &Array[u8] = s.view();
  pkPutU64(out, u64.from(b.len));
  pkPutRaw(out, b as *u8, b.len);
}

fn pkPutMesh(out: &mut List[u8], m: &Mesh) {
  pkPutVec3s(out, &m.positions);
  pkPutVec3s(out, &m.normals);
  pkPutVec2s(out, &m.uvs);
  pkPutU32s(out, &m.indices);
}

fn pkPutSkin(out: &mut List[u8], s: &Skin) {
  pkPutU32s(out, &s.joints);
  pkPutU32s(out, &s.weights);
}

fn pkPutImage(out: &mut List[u8], im: &Image) {
  pkPutU32(out, u32.from(im.width));
  pkPutU32(out, u32.from(im.height));
  pkPutU32(out, u32.from(im.channels));
  pkPutBytes(out, &im.pixels);
}

fn pkPutTransform(out: &mut List[u8], t: Transform3) {
  pkPutVec3(out, t.translation);
  pkPutF32(out, t.rotation.x);
  pkPutF32(out, t.rotation.y);
  pkPutF32(out, t.rotation.z);
  pkPutF32(out, t.rotation.w);
  pkPutVec3(out, t.scale);
}

fn pkPutSkeleton(out: &mut List[u8], s: &bonepose.Skeleton) {
  pkPutU32(out, u32.from(s.bones.len()));
  var i = 0usize;
  while i < s.bones.len() {
    let b = s.bones[i];
    pkPutU32(out, u32.from(b.parent + 1i32));
    pkPutTransform(out, b.rest);
    i = i + 1usize;
  }
  pkPutU32(out, u32.from(s.sockets.len()));
  i = 0usize;
  while i < s.sockets.len() {
    let k = s.sockets[i];
    pkPutU32(out, u32.from(k.bone));
    pkPutTransform(out, k.offset);
    i = i + 1usize;
  }
}

fn pkPutMorph(out: &mut List[u8], m: &MorphTargets) {
  pkPutU64(out, u64.from(m.vertexCount));
  pkPutU32s(out, &m.targetStart);
  pkPutU32s(out, &m.vertex);
  pkPutVec3s(out, &m.dPos);
  pkPutVec3s(out, &m.dNor);
  pkPutVec3s(out, &m.dTan);
  pkPutF32s(out, &m.maxMove);
}

fn pkPutSkinned(out: &mut List[u8], a: &SkinnedAsset) {
  pkPutMesh(out, &a.mesh);
  pkPutSkin(out, &a.skin);
}

// ---- reading

fn pkGetU32(b: &Array[u8], at: usize) u32 {
  u32.from(b[at]) | (u32.from(b[at + 1usize]) << 8u32) | (u32.from(b[at + 2usize]) << 16u32) | (u32.from(b[at + 3usize]) << 24u32)
}

fn pkGetU64(b: &Array[u8], at: usize) u64 {
  u64.from(pkGetU32(b, at)) | (u64.from(pkGetU32(b, at + 4usize)) << 32u64)
}

// A reader: the file's bytes, where it is, and whether anything has run past the end
struct PkReader {
  b: &Array[u8];
  at: usize;
  ok: bool;
}

fn pkNext32(r: &mut PkReader) u32 {
  if r.at + 4usize > r.b.len { r.ok = false; return 0u32; }
  let v = pkGetU32(r.b, r.at);
  r.at = r.at + 4usize;
  v
}

fn pkNext64(r: &mut PkReader) u64 {
  if r.at + 8usize > r.b.len { r.ok = false; return 0u64; }
  let v = pkGetU64(r.b, r.at);
  r.at = r.at + 8usize;
  v
}

fn pkNextF32(r: &mut PkReader) f32 {
  if r.at + 4usize > r.b.len { r.ok = false; return 0.; }
  var one = List[f32].empty();
  one.push(0.);
  let dst: *f32 = one.viewMut() as *f32;
  libc.memcpy(dst as *u8, (r.b as *u8) + r.at, 4usize);
  r.at = r.at + 4usize;
  *one[0usize]
}

fn pkNextVec3(r: &mut PkReader) Vec3 {
  let x = pkNextF32(r);
  let y = pkNextF32(r);
  let z = pkNextF32(r);
  Vec3(x, y, z)
}

// 'n' items of 'size' bytes: the count read, and the room checked against what is left of the file
fn pkCount(r: &mut PkReader, size: usize) usize {
  let n = pkNext64(r);
  if !r.ok { return 0usize; }
  if n > u64.from(PK_MAX_BYTES) || r.at + usize.from(n) * size > r.b.len { r.ok = false; return 0usize; }
  usize.from(n)
}

fn pkNextVec3s(r: &mut PkReader) List[Vec3] {
  let n = pkCount(r, 12usize);
  var l = List[Vec3].withCapacity(n);
  if n > 0usize {
    l.resize(n, Vec3(0., 0., 0.));
    let dst: *Vec3 = l.viewMut() as *Vec3;
    libc.memcpy(dst as *u8, (r.b as *u8) + r.at, n * 12usize);
    r.at = r.at + n * 12usize;
  }
  l
}

fn pkNextVec2s(r: &mut PkReader) List[Vec2] {
  let n = pkCount(r, 8usize);
  var l = List[Vec2].withCapacity(n);
  if n > 0usize {
    l.resize(n, Vec2(0., 0.));
    let dst: *Vec2 = l.viewMut() as *Vec2;
    libc.memcpy(dst as *u8, (r.b as *u8) + r.at, n * 8usize);
    r.at = r.at + n * 8usize;
  }
  l
}

fn pkNextU32s(r: &mut PkReader) List[u32] {
  let n = pkCount(r, 4usize);
  var l = List[u32].withCapacity(n);
  if n > 0usize {
    l.resize(n, 0u32);
    let dst: *u32 = l.viewMut() as *u32;
    libc.memcpy(dst as *u8, (r.b as *u8) + r.at, n * 4usize);
    r.at = r.at + n * 4usize;
  }
  l
}

fn pkNextI32s(r: &mut PkReader) List[i32] {
  let n = pkCount(r, 4usize);
  var l = List[i32].withCapacity(n);
  if n > 0usize {
    l.resize(n, 0i32);
    let dst: *i32 = l.viewMut() as *i32;
    libc.memcpy(dst as *u8, (r.b as *u8) + r.at, n * 4usize);
    r.at = r.at + n * 4usize;
  }
  l
}

fn pkNextF32s(r: &mut PkReader) List[f32] {
  let n = pkCount(r, 4usize);
  var l = List[f32].withCapacity(n);
  if n > 0usize {
    l.resize(n, 0.);
    let dst: *f32 = l.viewMut() as *f32;
    libc.memcpy(dst as *u8, (r.b as *u8) + r.at, n * 4usize);
    r.at = r.at + n * 4usize;
  }
  l
}

fn pkNextBytes(r: &mut PkReader) List[u8] {
  let n = pkCount(r, 1usize);
  var l = List[u8].withCapacity(n);
  if n > 0usize {
    l.resize(n, 0u8);
    libc.memcpy(l.viewMut() as *u8, (r.b as *u8) + r.at, n);
    r.at = r.at + n;
  }
  l
}

fn pkNextString(r: &mut PkReader) String {
  let n = pkCount(r, 1usize);
  var s = String.empty();
  var i = 0usize;
  while i < n {
    s.appendByte(r.b[r.at + i]);
    i = i + 1usize;
  }
  r.at = r.at + n;
  s
}

fn pkNextMesh(r: &mut PkReader) Mesh {
  var m = Mesh.empty();
  m.positions = pkNextVec3s(r);
  m.normals = pkNextVec3s(r);
  m.uvs = pkNextVec2s(r);
  m.indices = pkNextU32s(r);
  m
}

fn pkNextSkin(r: &mut PkReader) Skin {
  var s = Skin.empty();
  s.joints = pkNextU32s(r);
  s.weights = pkNextU32s(r);
  s
}

fn pkNextImage(r: &mut PkReader) Image {
  let w = i32.from(pkNext32(r));
  let h = i32.from(pkNext32(r));
  let c = i32.from(pkNext32(r));
  var im = Image(w, h, c, List[u8].empty());
  im.pixels = pkNextBytes(r);
  im
}

fn pkNextTransform(r: &mut PkReader) Transform3 {
  let t = pkNextVec3(r);
  let qx = pkNextF32(r);
  let qy = pkNextF32(r);
  let qz = pkNextF32(r);
  let qw = pkNextF32(r);
  let s = pkNextVec3(r);
  Transform3(t, Quat(qx, qy, qz, qw), s)
}

fn pkNextSkeleton(r: &mut PkReader) bonepose.Skeleton {
  var s = bonepose.Skeleton.empty();
  let nb = usize.from(pkNext32(r));
  var i = 0usize;
  while i < nb && r.ok {
    let parent = i32.from(pkNext32(r)) - 1i32;
    let rest = pkNextTransform(r);
    s.addBone(parent, rest);
    i = i + 1usize;
  }
  let ns = usize.from(pkNext32(r));
  i = 0usize;
  while i < ns && r.ok {
    let bone = usize.from(pkNext32(r));
    let off = pkNextTransform(r);
    s.addSocket(bone, off);
    i = i + 1usize;
  }
  s
}

fn pkNextMorph(r: &mut PkReader) MorphTargets {
  let vc = usize.from(pkNext64(r));
  var m = MorphTargets.empty(vc);
  m.targetStart = pkNextU32s(r);
  m.vertex = pkNextU32s(r);
  m.dPos = pkNextVec3s(r);
  m.dNor = pkNextVec3s(r);
  m.dTan = pkNextVec3s(r);
  m.maxMove = pkNextF32s(r);
  m
}

fn pkNextSkinned(r: &mut PkReader) SkinnedAsset {
  var a = SkinnedAsset.empty();
  a.mesh = pkNextMesh(r);
  a.skin = pkNextSkin(r);
  a
}

// The person as the bytes of a file's payload
pub fn encodePerson(a: &PersonAsset) List[u8] {
  var out = List[u8].empty();
  pkPutU32(&mut out, a.index);
  pkPutString(&mut out, &a.name);
  pkPutU32(&mut out, a.sex);
  pkPutF32(&mut out, a.height);
  pkPutF32(&mut out, a.hipSpan);
  pkPutVec3(&mut out, a.iris);
  pkPutSkeleton(&mut out, &a.skeleton);
  pkPutMesh(&mut out, &a.body);
  pkPutSkin(&mut out, &a.bodySkin);
  pkPutMorph(&mut out, &a.morph);
  // the face's spec
  pkPutU32(&mut out, u32.from(a.spec.names.len()));
  var i = 0usize;
  while i < a.spec.names.len() { pkPutString(&mut out, &a.spec.names[i]); i = i + 1usize; }
  pkPutVec3s(&mut out, &a.spec.points);
  pkPutF32(&mut out, a.spec.scale);
  pkPutF32(&mut out, a.spec.eyeRadius);
  pkPutF32(&mut out, a.spec.upperLidEdge);
  pkPutF32(&mut out, a.spec.lowerLidEdge);
  pkPutF32(&mut out, a.spec.closingLine);
  pkPutVec3(&mut out, a.spec.jawPivot);
  pkPutF32(&mut out, a.spec.jawOpenMax);
  pkPutF32(&mut out, a.spec.eyeLimit);
  pkPutI32s(&mut out, &a.unitTarget);
  pkPutU32(&mut out, u32.from(a.targetCount));
  pkPutU32(&mut out, a.faceHead);
  pkPutU32(&mut out, a.faceJaw);
  pkPutU32(&mut out, a.faceEyeL);
  pkPutU32(&mut out, a.faceEyeR);
  pkPutVec3(&mut out, a.faceOrigin);
  pkPutSkinned(&mut out, &a.eyes);
  pkPutSkinned(&mut out, &a.ears);
  pkPutSkinned(&mut out, &a.teeth);
  pkPutSkinned(&mut out, &a.tongue);
  pkPutSkinned(&mut out, &a.cavity);
  pkPutU32(&mut out, u32.from(a.pieces.len()));
  i = 0usize;
  while i < a.pieces.len() {
    let p = &a.pieces[i];
    pkPutString(&mut out, &p.name);
    pkPutMesh(&mut out, &p.mesh);
    pkPutSkin(&mut out, &p.skin);
    pkPutVec3(&mut out, p.color);
    pkPutU32(&mut out, p.kind);
    i = i + 1usize;
  }
  pkPutSkinned(&mut out, &a.cape);
  pkPutImage(&mut out, &a.albedo);
  pkPutImage(&mut out, &a.rough);
  out
}

// The person a payload holds; None if it is not exactly one
pub fn decodePerson(b: &Array[u8]) Option[PersonAsset] {
  var r = PkReader(b, 0usize, true);
  let index = pkNext32(&mut r);
  let name = pkNextString(&mut r);
  let sex = pkNext32(&mut r);
  let height = pkNextF32(&mut r);
  let hipSpan = pkNextF32(&mut r);
  let iris = pkNextVec3(&mut r);
  let skeleton = pkNextSkeleton(&mut r);
  let body = pkNextMesh(&mut r);
  let bodySkin = pkNextSkin(&mut r);
  let morph = pkNextMorph(&mut r);
  var spec = facerig.FaceSpec.empty();
  let nn = usize.from(pkNext32(&mut r));
  var i = 0usize;
  while i < nn && r.ok {
    spec.names.push(pkNextString(&mut r));
    i = i + 1usize;
  }
  spec.points = pkNextVec3s(&mut r);
  spec.scale = pkNextF32(&mut r);
  spec.eyeRadius = pkNextF32(&mut r);
  spec.upperLidEdge = pkNextF32(&mut r);
  spec.lowerLidEdge = pkNextF32(&mut r);
  spec.closingLine = pkNextF32(&mut r);
  spec.jawPivot = pkNextVec3(&mut r);
  spec.jawOpenMax = pkNextF32(&mut r);
  spec.eyeLimit = pkNextF32(&mut r);
  let unitTarget = pkNextI32s(&mut r);
  let targetCount = usize.from(pkNext32(&mut r));
  let fh = pkNext32(&mut r);
  let fj = pkNext32(&mut r);
  let fl = pkNext32(&mut r);
  let fr = pkNext32(&mut r);
  let fo = pkNextVec3(&mut r);
  let eyes = pkNextSkinned(&mut r);
  let ears = pkNextSkinned(&mut r);
  let teeth = pkNextSkinned(&mut r);
  let tongue = pkNextSkinned(&mut r);
  let cavity = pkNextSkinned(&mut r);
  let np = usize.from(pkNext32(&mut r));
  var pieces = List[PieceAsset].empty();
  i = 0usize;
  while i < np && r.ok {
    let pname = pkNextString(&mut r);
    let pmesh = pkNextMesh(&mut r);
    let pskin = pkNextSkin(&mut r);
    let pcolor = pkNextVec3(&mut r);
    let pkind = pkNext32(&mut r);
    pieces.push(PieceAsset(pname, pmesh, pskin, pcolor, pkind));
    i = i + 1usize;
  }
  let cape = pkNextSkinned(&mut r);
  let albedo = pkNextImage(&mut r);
  let rough = pkNextImage(&mut r);
  if !r.ok || r.at != b.len { return None; }
  Some[PersonAsset](PersonAsset(index, name, sex, height, hipSpan, skeleton, body, bodySkin, morph, spec, unitTarget, targetCount,
    fh, fj, fl, fr, fo, eyes, ears, teeth, tongue, cavity, pieces, cape, albedo, rough, iris))
}

// ---- Where, and under what name ----

fn pkEnv(name: cstr) String {
  let v = libc.getenv(name);
  if (v as usize) == 0usize { return String.empty(); }
  String.fromCStr(cstr.fromPtr(v))
}

// The folder a made person is stored in (PEGASUS_PEOPLE_CACHE, else the user's cache folder); empty: none
fn pkStoreFolder() Path {
  let own = pkEnv("PEGASUS_PEOPLE_CACHE");
  if own.len() > 0usize {
    if own.equals("off") { return Path.from(""); }
    return Path.from(own.view());
  }
  let appData = pkEnv("LOCALAPPDATA");
  if appData.len() > 0usize { return Path.from(appData.view()).join("pegasus3d").join("people"); }
  let xdg = pkEnv("XDG_CACHE_HOME");
  if xdg.len() > 0usize { return Path.from(xdg.view()).join("pegasus3d").join("people"); }
  let home = pkEnv("HOME");
  if home.len() > 0usize { return Path.from(home.view()).join(".cache").join("pegasus3d").join("people"); }
  Path.from("")
}

// The folders a person is looked for in, in order
fn pkFolders() List[Path] {
  var out = List[Path].empty();
  let own = pkEnv("PEGASUS_PEOPLE_CACHE");
  if own.len() > 0usize {
    if !own.equals("off") { out.push(Path.from(own.view())); }
    return out;
  }
  let base = pkBasePath();
  if (base as usize) != 0usize {
    out.push(Path.from(String.fromCStr(cstr.fromPtr(base)).view()).join("people"));
  }
  let store = pkStoreFolder();
  if !store.isEmpty() { out.push(store); }
  out
}

// The file name of person 'index' called 'name'
pub fn personFileName(index: u32, name: &str) String {
  var h = pkMixU64(PK_FNV_OFFSET, u64.from(PEOPLE_FORMAT));
  h = pkMixText(h, PEOPLE_REVISION);
  h = pkMixU64(h, u64.from(index));
  h = pkMixText(h, name);
  let salt = pkEnv("PEGASUS_BAKE_SALT");
  if salt.len() > 0usize { h = pkMixText(h, salt.view()); }
  var f = String.from("person-");
  f.append(pkHex(u64.from(index)).view());
  f.append("-");
  f.append(pkHex(h).view());
  f.append(".people");
  f
}

fn pkKey(index: u32, name: &str) u64 {
  var h = pkMixU64(PK_FNV_OFFSET, u64.from(PEOPLE_FORMAT));
  h = pkMixText(h, PEOPLE_REVISION);
  h = pkMixU64(h, u64.from(index));
  h = pkMixText(h, name);
  let salt = pkEnv("PEGASUS_BAKE_SALT");
  if salt.len() > 0usize { h = pkMixText(h, salt.view()); }
  h
}

// A stored person read from 'file'; None if it is absent, not this key's, or damaged
fn pkReadFile(file: &Path, key: u64) Option[PersonAsset] {
  match fs.readFile(file) {
    case let Ok(text) {
      let b: &Array[u8] = text.view();
      if b.len < 32usize { return None; }
      if pkGetU32(b, 0usize) != PEOPLE_MAGIC || pkGetU32(b, 4usize) != PEOPLE_FORMAT || pkGetU64(b, 8usize) != key {
        return None;
      }
      let payload = pkGetU64(b, 16usize);
      let sum = pkGetU64(b, 24usize);
      if payload != u64.from(b.len - 32usize) { return None; }
      if pkSum((b as *u8) + 32usize, b.len - 32usize) != sum { return None; }
      return decodePerson(&b[32usize..<b.len]);
    }
    else {}
  }
  None
}

// Person 'a' stored as the file 'name' in 'dir'. A failure (no room, no rights) is silent: the person is simply not kept.
pub fn storePerson(dir: &Path, a: &PersonAsset) bool {
  match fs.makeDirAll(dir) { else {} }
  let payload = encodePerson(a);
  var out = List[u8].empty();
  let fname = personFileName(a.index, a.name.view());
  pkPutU32(&mut out, PEOPLE_MAGIC);
  pkPutU32(&mut out, PEOPLE_FORMAT);
  pkPutU64(&mut out, pkKey(a.index, a.name.view()));
  pkPutU64(&mut out, u64.from(payload.len()));
  pkPutU64(&mut out, pkSum(payload.view() as *u8, payload.len()));
  pkPutRaw(&mut out, payload.view() as *u8, payload.len());
  let file = dir.join(fname.view());
  var tmpName = String.from(fname.view());
  tmpName.append(".tmp");
  tmpName.append(pkHex(sdl.GetPerformanceCounter()).view());
  let tmp = dir.join(tmpName.view());
  var written = false;
  match fs.writeFile(&tmp, out.view()) {
    case is Ok { written = true; }
    else {}
  }
  if !written { return false; }
  var renamed = false;
  match fs.rename(&tmp, &file) {
    case is Ok { renamed = true; }
    else {}
  }
  if !renamed {
    match fs.removeFile(&file) { else {} }
    match fs.rename(&tmp, &file) {
      case is Ok { renamed = true; }
      else {}
    }
  }
  if !renamed { match fs.removeFile(&tmp) { else {} } }
  renamed
}

// Person 'index' of humanbody's cast, called 'name', from the first folder that has it
pub fn loadStoredPerson(index: u32, name: &str) Option[PersonAsset] {
  let folders = pkFolders();
  let fname = personFileName(index, name);
  let key = pkKey(index, name);
  var i = 0usize;
  while i < folders.len() {
    let file = folders[i].join(fname.view());
    match pkReadFile(&file, key) {
      case let Some(a) { return Some[PersonAsset](a); }
      else {}
    }
    i = i + 1usize;
  }
  None
}

// ---- Making a person ----

fn pkClamp(x: f32, lo: f32, hi: f32) f32 {
  if x < lo { return lo; }
  if x > hi { return hi; }
  x
}

fn pkSmooth(a: f32, b: f32, x: f32) f32 {
  let t = pkClamp((x - a) / (b - a), 0., 1.);
  t * t * (3. - 2. * t)
}

fn pkIndexed(m: &Mesh, idx: &List[u32]) Mesh {
  var out = Mesh.empty();
  out.append(m);
  out.indices.clear();
  var i = 0usize;
  while i < idx.len() { out.indices.push(*idx[i]); i = i + 1usize; }
  out
}

fn pkSkinned(m: &Mesh, s: &Skin) SkinnedAsset {
  var a = SkinnedAsset.empty();
  a.mesh.append(m);
  a.skin = humanbody.copySkin(s);
  a
}

// The cape settled on the person standing, as a mesh skinned to the chest, the spine and the pelvis. The cloth is garmentdrape's
// (draped at a grid too coarse to buckle into narrow folds: its folds are drawn in, as the bench does, as a wave round the neck along
// the cloth's normal growing from the collar to the hem). Two-sided: the second half of the vertices is the back face.
fn pkBakeCape(body: &humanbody.Body, w: &mut humanbody.Wardrobe) SkinnedAsset {
  var out = SkinnedAsset.empty();
  if w.capeIndex < 0i32 { return out; }
  let g = usize.from(w.capeIndex);
  var workers = xpbdsoftbody.Workers.none();
  let pose = humanbody.standPose(&body.skeleton);
  var world = List[Transform3].empty();
  body.skeleton.modelTransforms(&pose, &mut world);
  w.outfit.snap(&w.rig, &world);
  let neck = (*world[bonepose.NECK]).translation;
  humanbody.rippleGarment(w, g, neck, 7., 0.12);
  var k = 0;
  while k < 150 {
    w.outfit.step(&w.rig, &world, 1. / 60., Vec3(0.3, 0., 0.2), &mut workers);
    k = k + 1;
  }
  let garment = &mut w.outfit.garments[g];
  var scratch = Mesh.empty();
  var normals = List[Vec3].empty();
  xpbdsoftbody.writeMesh(&garment.soft, &mut scratch, true, &mut normals);
  let nv = scratch.positions.len() / 2usize;
  // the folds
  var i = 0usize;
  while i < nv {
    let p = *scratch.positions[i];
    let n = *scratch.normals[i];
    let dx = p.x - neck.x;
    let dz = p.z - neck.z;
    let ang = atan2(dx, dz);
    let below = neck.y - p.y;
    let amp = 0.022 * pkSmooth(0.04, 0.55, below);
    let wave = sin(16. * ang) + 0.35 * sin(16. * 0.43 * ang + 1.7);
    let q = p + n * (amp * wave);
    scratch.positions.set(i, q);
    scratch.positions.set(nv + i, q);
    i = i + 1usize;
  }
  // the normals of the folded surface
  var acc = List[Vec3].empty();
  i = 0usize;
  while i < nv { acc.push(Vec3(0., 0., 0.)); i = i + 1usize; }
  let half = scratch.indices.len() / 2usize;
  var t = 0usize;
  while t + 2usize < half {
    let a = usize.from(*scratch.indices[t]);
    let b = usize.from(*scratch.indices[t + 1usize]);
    let c = usize.from(*scratch.indices[t + 2usize]);
    let fa = (*scratch.positions[b] - *scratch.positions[a]).cross(*scratch.positions[c] - *scratch.positions[a]);
    acc.set(a, *acc[a] + fa);
    acc.set(b, *acc[b] + fa);
    acc.set(c, *acc[c] + fa);
    t = t + 3usize;
  }
  i = 0usize;
  while i < nv {
    let old = *scratch.normals[i];
    var n = *acc[i];
    if n.length() > 1e-12 {
      n = n.normalize();
      if n.dot(old) < 0. { n = n * -1.; }
      scratch.normals.set(i, n);
      scratch.normals.set(nv + i, n * -1.);
    }
    i = i + 1usize;
  }
  // its skin: the collar is the chest's; lower down the spine's, then the pelvis's
  var skin = Skin.empty();
  let chestY = (*world[bonepose.CHEST]).translation.y;
  let pelvisY = (*world[bonepose.PELVIS]).translation.y;
  i = 0usize;
  while i < 2usize * nv {
    let y = (*scratch.positions[i]).y;
    let tt = pkClamp((chestY - y) / (chestY - pelvisY + 0.45), 0., 1.);
    let toPelvis = pkSmooth(0.3, 1., tt);
    let toSpine = pkSmooth(0., 0.35, tt) * (1. - toPelvis);
    skin.push(u32.from(bonepose.CHEST), u32.from(bonepose.SPINE), u32.from(bonepose.PELVIS), u32.from(bonepose.CHEST),
      1. - toSpine - toPelvis, toSpine, toPelvis, 0.);
    i = i + 1usize;
  }
  out.mesh <-> scratch;
  out.skin <-> skin;
  out
}

// The people after humanbody's cast: bare-chested variants of two of its men for the labyrinth's guards (they wear a kilt, a belt and
// a helmet over humanbody's underwear, not its shirt and trousers): the tall slim man (the west guard) and the stocky older man (the
// east one). The cast's own people are numbers 0 to 6; these are 7 and 8.
pub const GUARD_SOURCES: Array[usize, 2] = [1usize, 2usize];
pub const GUARD_VARIANTS = 2usize;

// What a person of the asset's list is called (its file's name): the cast's name, with " (guard)" for the bare variants
fn pkNameOf(p: &humanbody.Person, bare: bool) String {
  var s = p.name.copy();
  if bare { s.append(" (guard)"); }
  s
}

// Person 'index' of the assets (the cast's, or a guard's variant: 'bare') made from the blend set of its sex
pub fn bakePerson(index: usize, p: &humanbody.Person, set: &humanbody.BlendSet, bare: bool) PersonAsset {
  var body = humanbody.personBody(set, &p.measures);
  let face = humanbody.buildFace(&mut body);
  var wardrobe = humanbody.dressPerson(&body, p, bare, 1u32);
  let skin = body.skin();
  let morph = humanbody.morphTargetsOf(&face, body.mesh.positions.len());
  var tex = humanbody.paintSkin(&body, &p.look, SKIN_TEXTURE);
  var spec = facerig.FaceSpec.empty();
  spec.names = copyStrings(&face.spec.names);
  spec.points = copyVec3s(&face.spec.points);
  spec.scale = face.spec.scale;
  spec.eyeRadius = face.spec.eyeRadius;
  spec.upperLidEdge = face.spec.upperLidEdge;
  spec.lowerLidEdge = face.spec.lowerLidEdge;
  spec.closingLine = face.spec.closingLine;
  spec.jawPivot = face.spec.jawPivot;
  spec.jawOpenMax = face.spec.jawOpenMax;
  spec.eyeLimit = face.spec.eyeLimit;
  var unitTarget = List[i32].empty();
  var u = 0usize;
  while u < face.targets.unitTarget.len() { unitTarget.push(*face.targets.unitTarget[u]); u = u + 1usize; }
  var pieces = List[PieceAsset].empty();
  var pi = 0usize;
  while pi < wardrobe.pieces.len() {
    let pc = &wardrobe.pieces[pi];
    var mesh = Mesh.empty();
    mesh.append(&pc.mesh);
    pieces.push(PieceAsset(pc.name.copy(), mesh, humanbody.copySkin(&pc.skin), pc.color, pc.kind));
    pi = pi + 1usize;
  }
  let cape = pkBakeCape(&body, &mut wardrobe);
  var albedo = Image.empty();
  albedo <-> tex.albedo;
  var rough = Image.empty();
  rough <-> tex.roughness;
  PersonAsset(u32.from(index), pkNameOf(p, bare), p.measures.sex, p.measures.height, humanbody.hipHalfSpan(&p.measures) / p.measures.height,
    humanbody.copySkeleton(&body.skeleton), pkIndexed(&body.mesh, &wardrobe.bodyIndices), skin, morph, spec, unitTarget,
    face.targets.count(), u32.from(face.bones.head), u32.from(face.bones.jaw), u32.from(face.bones.eyeL), u32.from(face.bones.eyeR),
    face.bones.origin, pkSkinned(&face.parts.eyes, &face.parts.eyesSkin), pkSkinned(&face.parts.ears, &face.parts.earsSkin),
    pkSkinned(&face.parts.teeth, &face.parts.teethSkin), pkSkinned(&face.parts.tongue, &face.parts.tongueSkin),
    pkSkinned(&face.parts.cavity, &face.parts.cavitySkin), pieces, cape, albedo, rough, p.look.iris)
}

fn copyStrings(l: &List[String]) List[String] {
  var out = List[String].empty();
  var i = 0usize;
  while i < l.len() { out.push(l[i].copy()); i = i + 1usize; }
  out
}

fn copyVec3s(l: &List[Vec3]) List[Vec3] {
  var out = List[Vec3].empty();
  var i = 0usize;
  while i < l.len() { out.push(*l[i]); i = i + 1usize; }
  out
}

// ---- The call ----

// What loadPeople did, for the log
pub struct PeopleLog {
  pub loaded: u32 = 0u32;
  pub made: u32 = 0u32;
  pub loadMs: f64 = 0.0;
  pub makeMs: f64 = 0.0;
  pub bytes: u64 = 0u64;
}

fn pkMillis(from: u64) f64 {
  f64.from(sdl.GetPerformanceCounter() - from) / f64.from(sdl.GetPerformanceFrequency()) * 1000.0
}

// Every person of humanbody's cast: each from its file where there is one, else made (the blend sets of the sexes missing are made
// first, about 16 s each) and stored. 'storeIn' (if not empty) is the folder to store in instead of the user's cache.
pub fn loadPeople(log: &mut PeopleLog, storeIn: &Path) People {
  let cast = humanbody.cast();
  var out = List[PersonAsset].empty();
  var menSet = List[humanbody.BlendSet].empty();
  var womenSet = List[humanbody.BlendSet].empty();
  var i = 0usize;
  // (the cast's people, then the guards' bare-chested variants of two of the men: GUARD_SOURCES)
  while i < cast.len() + GUARD_VARIANTS {
    let bare = i >= cast.len();
    let p = &cast[if bare { GUARD_SOURCES[i - cast.len()] } else { i }];
    let name = pkNameOf(p, bare);
    let t0 = sdl.GetPerformanceCounter();
    var have: Option[PersonAsset] = None;
    if storeIn.isEmpty() { have = loadStoredPerson(u32.from(i), name.view()); }
    else {
      let file = storeIn.join(personFileName(u32.from(i), name.view()).view());
      have = pkReadFile(&file, pkKey(u32.from(i), name.view()));
    }
    match have {
      case let Some(a) {
        log.loaded = log.loaded + 1u32;
        log.loadMs = log.loadMs + pkMillis(t0);
        out.push(a);
      }
      else {
        if p.measures.sex == humanbody.MALE {
          if menSet.len() == 0usize {
            print <- "People: making the men's blend set (once, about 16 s)\n";
            menSet.push(humanbody.buildBlendSet(humanbody.MALE, 1u32));
          }
        } else {
          if womenSet.len() == 0usize {
            print <- "People: making the women's blend set (once, about 16 s)\n";
            womenSet.push(humanbody.buildBlendSet(humanbody.FEMALE, 1u32));
          }
        }
        let a = bakePerson(i, p, if p.measures.sex == humanbody.MALE { &menSet[0usize] } else { &womenSet[0usize] }, bare);
        let dir = if storeIn.isEmpty() { pkStoreFolder() } else { storeIn.copy() };
        if !dir.isEmpty() { storePerson(&dir, &a); }
        log.made = log.made + 1u32;
        log.makeMs = log.makeMs + pkMillis(t0);
        out.push(a);
      }
    }
    i = i + 1usize;
  }
  People(Arc[imm, List[PersonAsset]](out))
}

// --bake-people DIR: every person made (if not already in DIR) and stored there; whether all are
pub fn bakePeopleInto(dir: &str) bool {
  let d = Path.from(dir);
  var log = PeopleLog();
  let people = loadPeople(&mut log, &d);
  print <- "People: "; print <- log.loaded; print <- " read in "; print <- log.loadMs; print <- " ms, "; print <- log.made;
  print <- " made in "; print <- log.makeMs; print <- " ms, into "; printStr(dir); print <- "\n";
  var i = 0usize;
  while i < people.count() {
    let a = people.at(i);
    print <- "  "; printStr(a.name.view()); print <- ": "; print <- a.height; print <- " m, "; print <- a.body.positions.len();
    print <- " vertices, "; print <- a.body.indices.len() / 3usize; print <- " triangles, "; print <- a.morph.count(); print <- " face targets ("; print <- a.morph.entryCount();
    print <- " entries), "; print <- a.pieces.len(); print <- " pieces, cape "; print <- a.cape.mesh.positions.len(); print <- " vertices, "; print <- a.skeleton.boneCount();
    print <- " bones\n";
    i = i + 1usize;
  }
  people.count() == humanbody.cast().len() + GUARD_VARIANTS
}
