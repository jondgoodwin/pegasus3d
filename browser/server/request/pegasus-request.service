# The request-to-play endpoint (see SERVER.md). Install: copy to /etc/systemd/system/, daemon-reload, enable --now.
[Unit]
Description=Pegasus3D request-to-play endpoint (127.0.0.1:8098, behind nginx)
After=network.target

[Service]
User=pegreq
Group=pegreq
ExecStart=/usr/bin/python3 /usr/local/lib/pegasus/request.py
Restart=on-failure
RestartSec=5
Nice=10
MemoryMax=100M
# It runs sudo for the one move helper, and ufw (a child of it) must write /etc/ufw: so no ProtectSystem, no PrivateTmp
# (a read-only /etc made every move fail on 13 Oct) and NoNewPrivileges stays off. Its own power is the sudoers line.
ProtectHome=yes

[Install]
WantedBy=multi-user.target
