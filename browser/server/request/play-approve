#!/bin/sh
# sudo play-approve <name> [ip]: open UDP 40000 to the address that asked as <name>, and issue its token. If the name was
# asked for from more than one address, say which (the list is in the error). With no name: show the last 10 requests.
if [ $# -eq 0 ]; then tail -n 10 /var/lib/pegasus-requests/requests.log; exit 0; fi
if [ $# -eq 1 ]; then exec /usr/bin/python3 /usr/local/lib/pegasus/players.py approve "$1"; fi
exec /usr/bin/python3 /usr/local/lib/pegasus/players.py approve "$1" "$2"
