# The Pegasus3D island server, as a systemd service on the VM (see SERVER.md).
# Install:  sudo cp pegasus3d-server.service /etc/systemd/system/ && sudo systemctl daemon-reload && sudo systemctl enable --now pegasus3d-server
[Unit]
Description=Pegasus3D island server (UDP 40000)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=ubuntu
Group=ubuntu
WorkingDirectory=/home/ubuntu/pegasus/run
# libSDL3.so beside the program is the headless stand-in (browser/server/sdl3shim.c), not the real SDL3
Environment=LD_LIBRARY_PATH=/home/ubuntu/pegasus/bin
ExecStart=/home/ubuntu/pegasus/bin/pegasus-server --serve 40000
# The server ends in order on SIGTERM (the stand-in turns it into SDL's quit); give it a few seconds, then kill it
TimeoutStopSec=15
Restart=on-failure
RestartSec=5
# The sites on this machine come first: the server runs at a lower priority and may not grow without bound
Nice=5
MemoryMax=1536M
# It writes nothing and needs nothing but its own files
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
ProtectHome=read-only

[Install]
WantedBy=multi-user.target
