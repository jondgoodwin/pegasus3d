// Test hooks for the input routing (script commands kbkey, deskclick in guidebrowser.cone): rays a person's hand would make.

// The ray from the eye to the middle of the key named 'label' (as it says: "a", "Space", "Enter"), if the keyboard stands
fn testKeyRay(inc: &Incubator, label: &str, eye: &mut Vec3, dir: &mut Vec3) bool {
  match &inc.kb {
    case let Some(k) {
      var i = 0usize;
      while i < k.keys.len() {
        if k.keys[i].label.view() == label || (k.keys[i].low.view() == label && label != " ") {
          let r = k.keyRect(i);
          let at = k.model() * Vec3((r.x + r.z) * 0.5, (r.y + r.w) * 0.5, 0.);
          *eye = inc.gazeEye;
          *dir = (at - inc.gazeEye).normalize();
          return true;
        }
        i = i + 1usize;
      }
    }
    else {}
  }
  false
}

// The ray from the eye to pixel (px, py) of the shown browser tab's page
fn testWebRay(inc: &Incubator, px: i32, py: i32, eye: &mut Vec3, dir: &mut Vec3) bool {
  let v = inc.tabVisible();
  if v >= inc.pgs.len() { return false; }
  let r = WebPanel.localRect();
  let x = r.x + (f32.from(px) / f32.from(WEB_TEX_W)) * (r.z - r.x);
  let y = r.y + (1. - f32.from(py) / f32.from(WEB_TEX_H)) * (r.w - r.y);
  let at = inc.pgModel(v) * Vec3(x, y, 0.);
  *eye = inc.gazeEye;
  *dir = (at - inc.gazeEye).normalize();
  true
}

// A click on the shown tab's address strip (what the beam's trigger does there)
fn testAddrStrip(inc: &mut Incubator) {
  let v = inc.tabVisible();
  if v < inc.pgs.len() { inc.tabClick(v, 32u32); } else { print <- "script: addrclick: no browser tab shown\n"; }
}

// The world point of pixel (px, py) of the laptop's screen on the desk panel
fn testDeskPoint(inc: &Incubator, px: i32, py: i32) Vec3 {
  match &inc.desk {
    case let Some(d) {
      if d.w > 0u32 && d.h > 0u32 {
        let u = (f32.from(px) + 0.5) / f32.from(d.w);
        let v = 1. - (f32.from(py) + 0.5) / f32.from(d.h);
        let lx = (u * 2. - 1.) * DESK_HALF_W;
        let ly = d.bottom() + v * (d.top() - d.bottom());
        return d.model() * Vec3(lx, ly, 0.);
      }
    }
    else {}
  }
  Vec3(0., 0., 0.)
}
