// Scrolling, one way for every panel (Jon, 11 Nov: the right thumbstick scrolls the page, tree or panel the beam is on; the wheel does the
// same on the desktop).
//
// A scrollable panel keeps one offset, in its own pixels, and takes scrolls as wheel notches through `scrollBy(dx, dy)` (positive: right,
// up the page); `offset()` gives this snapshot back. The warehouse routes a ray's scroll to the nearest scrollable under it (`scrollRay`):
// a panel type that wants to be scrolled (the zones build's trees) implements the same two methods and adds itself to that routing.

pub struct ScrollOffset {
  pub x: f32;           // pixels scrolled right, and the most
  pub y: f32;           // pixels scrolled down, and the most
  pub maxX: f32;
  pub maxY: f32;
}

// Notches a second at a full push of the right stick (about 1000 page pixels a second), and the curve by deflection: a light push is slow
// and a full one fast, so the page can be read while it moves
const STICK_SCROLL_NOTCHES = 9.f;
const STICK_SCROLL_DEAD = 0.12f;

pub fn stickScrollRate(v: f32) f32 {
  var a = if v < 0. { 0. - v } else { v };
  if a <= STICK_SCROLL_DEAD { return 0.; }
  a = (a - STICK_SCROLL_DEAD) / (1. - STICK_SCROLL_DEAD);
  if a > 1. { a = 1.; }
  let r = a * a * STICK_SCROLL_NOTCHES;
  if v < 0. { 0. - r } else { r }
}
