// --mesh-hashes FILE: a world built with no window, one line per part: "<part name> <hash of its mesh>".
// The determinism test's seed: the same world gives the same lines before and after any change to how parts are
// built (baselines in tools\mesh-hashes\*.txt, checked by tools\checkhashes.py).

// FNV-1a over a 32-bit word's four bytes, low byte first
fn fnvWord(h: u64, w: u32) u64 {
  var x = h;
  var k = 0u32;
  while k < 4u32 {
    x = (x ^ u64.from((w >> (8u32 * k)) & 0xFFu32)) * 1099511628211u64;
    k = k + 1u32;
  }
  x
}

// A mesh's hash: the counts, then every position, normal, uv and index, each by its bits
fn meshHash(m: &Mesh) u64 {
  var h = 14695981039346656037u64;
  h = fnvWord(h, u32.from(m.positions.len()));
  h = fnvWord(h, u32.from(m.normals.len()));
  h = fnvWord(h, u32.from(m.uvs.len()));
  h = fnvWord(h, u32.from(m.indices.len()));
  h = fnvWord(h, u32.from(m.groups.len()));
  var i = 0usize;
  while i < m.positions.len() {
    let p = *m.positions[i];
    h = fnvWord(h, p.x.bits()); h = fnvWord(h, p.y.bits()); h = fnvWord(h, p.z.bits());
    i = i + 1usize;
  }
  i = 0usize;
  while i < m.normals.len() {
    let p = *m.normals[i];
    h = fnvWord(h, p.x.bits()); h = fnvWord(h, p.y.bits()); h = fnvWord(h, p.z.bits());
    i = i + 1usize;
  }
  i = 0usize;
  while i < m.uvs.len() {
    let p = *m.uvs[i];
    h = fnvWord(h, p.x.bits()); h = fnvWord(h, p.y.bits());
    i = i + 1usize;
  }
  i = 0usize;
  while i < m.indices.len() {
    h = fnvWord(h, *m.indices[i]);
    i = i + 1usize;
  }
  h
}

// The world in FILE built and each part's line printed; false when the file cannot be read
fn meshHashes(file: &str) bool {
  match fs.readFile(&Path.from(file)) {
    case let Ok(text) {
      let reading = readWorld(text.view());
      showProblems(file, &reading.problems);
      var tx: Sender[Arrival];
      var rx: Receiver[Arrival];
      tx, rx = Channel[Arrival].make();
      build(&reading.understood, &tx, true);
      while true {
        match rx.tryRecv() {
          case let Some(a) {
            match &a {
              case let Part(p) {
                printStr(p.built.name.view()); print <- " "; print <- meshHash(&p.built.mesh); print <- "\n";
              }
              else {}
            }
          }
          else { break; }
        }
      }
      true
    }
    case let Err(e) {
      printStr(file); print <- ": cannot be read: "; print <- e; print <- "\n";
      false
    }
  }
}
