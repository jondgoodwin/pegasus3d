// The incubator: the incubator as a place (WI\incubator-world.md), desktop version, draft 2.
//
// The world file (worlds\incubator.ddd) holds the building and each project as a part standing at its own
// origin. THIS file, run on the loop, decides where those parts are each frame: five slots of a ring around the
// start spot (projects float at waist height over a soft ring of light, with a contact shadow beneath), 24 shelf
// slots, the flights between them, zoom by levels, the chips beside the selected project, and the production
// line's cards (a click on one opens its report beside it).
// Everything with writing on it (names, chips, cards) is a small page, drawn by the document panel's PagePass as
// an unlit quad on top of the finished picture, far to near. Draft 2's page pass blends (so things fade) and,
// for the labels, tests against the scene's depth (kept by ImageFx), so they hide behind what stands in front.

const LINE_FILE = "C:/src/incubator/line/line.json";
const LAB_W = 512u32;
const LAB_H = 128u32;
const FLIGHT_MS = 500.0f;
const CHIP_DELAY_MS = 300.0f;
const BENCH_R = 1.4;      // how far from the start spot a page opened from a board stands (as a focused pane)
const CHIPS_ON = false;          // the chips beside a project and over a page (close, shelve, grab, back, forward, park) are replaced by the palette
const FADE_S = 0.2f;
const RING_N = 5;
const MAX_ITEMS = 12;
const DEFAULT_ROOT_BROWSE = "C:/Users/jondg/MyDrive/Incubator";
var @threadlocal ringRadius = 2.5f;     // [ring] radius_cm of incubator.toml
var @threadlocal floatHeight = 0.95f;   // [ring] float_cm: projects float at waist height
const ZOOM1_H = 2.4f;            // "the project fills the ring": its height, meters
const ZOOM2_H = 7.0f;            // "fills the room"
const NO_ITEM = -1;
const PI = 3.14159265f;

fn fminf(a: f32, b: f32) f32 { if a < b { a } else { b } }
fn fmaxf(a: f32, b: f32) f32 { if a > b { a } else { b } }

// Move 'a' toward 'want' so that a full change takes FADE_S
fn fadeToward(a: f32, want: f32, dt: f32) f32 {
  let step = dt / FADE_S;
  if a < want { fminf(a + step, want) } else { fmaxf(a - step, want) }
}

// A small page with writing on it: its quad is w x h meters at scale 1
struct Label {
  pass: PagePass;
  w: f32;
  h: f32;
  ok: bool;             // its picture made (a few a frame: every picture is a command buffer, and a frame may record 128)
  text: String;
  bg: u32;
  ink: u32;
  size: f32;
  top: f32;
  card: bool;
  progress: f32;
  hot: bool;
  strong: bool;
  alpha: f32;           // how visible it is now (fades toward what it should be, over FADE_S)
}

// Draws short texts into images (the document panel's fonts and renderer, in a small texture)
struct Labeller {
  faces: Faces;
  rr: RichRenderer;
  target: Texture;
  readback: Buffer;

  fn create(device: &mut Device) Option[Labeller] {
    var made: Option[Labeller] = None;
    match makeFaces() {
      case let Some(faces) {
        var rr = RichRenderer.create(device, &faces, TEXTURE_FORMAT_RGBA8_UNORM);
        if rr.isValid() {
          let desc = TextureDescriptor(LAB_W, LAB_H, TEXTURE_FORMAT_RGBA8_UNORM,
            TEXTURE_USAGE_RENDER_ATTACHMENT | TEXTURE_USAGE_COPY_SRC);
          var target = device.createTexture(&desc);
          var readback = device.createBuffer(u64.from(LAB_W * LAB_H * 4u32), BUFFER_USAGE_MAP_READ | BUFFER_USAGE_COPY_DST);
          made = Some[Labeller](Labeller(faces, rr, target, readback));
        }
      }
      case is None { print <- "incubator: no font found\n"; }
    }
    made
  }

  // 'text' on 'bg' in 'ink' (0xRRGGBBAA), at 'size' pixels, its first line 'top' pixels down
  fn image(self: &mut, device: &mut Device, text: &str, bg: u32, ink: u32, size: f32, top: f32) Image {
    var eb = List[Block]();
    eb.push(Block.fromText(text, Style(true, false, false, 0., ink, 0u32, 0u32)));
    var cfg = LayoutConfig.standard(f32.from(LAB_W));
    cfg.margin = 16.;
    cfg.marginTop = top;
    cfg.baseSize = size;
    cfg.lineHeight = 1.15;
    cfg.textColor = ink;
    let images = List[ImageInfo]();
    let el = layoutRich(&eb, &images, &faces, &cfg);
    let view = RichView(f32.from(LAB_W), f32.from(LAB_H), 0., 0., bg, bg, 0u32, 0u32, f32.from(LAB_W), false);
    let sel = List[RectP]();
    let caret = CaretRect(0., 0., 0.);
    var encoder = device.createCommandEncoder();
    rr.draw(device, &mut encoder, &target, &view, &faces, &el, &images, &sel, &caret);
    encoder.copyTextureToBuffer(&target, &readback);
    device.queue.submit(encoder.finish());
    device.waitIdle();
    Image.fromTexels(readback.mappedRange(), i32.from(LAB_W), i32.from(LAB_H), false)
  }
}

// Make a label's picture and give it to its page pass
fn fillLabel(l: &mut Labeller, device: &mut Device, lab: &mut Label) {
  var img = l.image(device, lab.text.view(), lab.bg, lab.ink, lab.size, lab.top);
  if lab.card {
    var p = lab.progress;
    if p < 0. { p = 0.; }
    if p > 1. { p = 1.; }
    paint(&mut img, 16, 98, 496, 114, 0xc8c4bau32);
    paint(&mut img, 16, 98, 16 + i32.from(u32.from(p * 480.)), 114, 0x2e7d4fu32);
    if lab.hot {
      let b = if lab.strong { 12 } else { 5 };
      let c = if lab.strong { 0xf5a000u32 } else { 0xe8c070u32 };
      paint(&mut img, 0, 0, 512, b, c);
      paint(&mut img, 0, 128 - b, 512, 128, c);
      paint(&mut img, 0, 0, b, 128, c);
      paint(&mut img, 512 - b, 0, 512, 128, c);
    }
  }
  lab.pass.upload(device, &img);
  lab.ok = true;
}

// A rectangle of the image, rows counted from its top, in 0xRRGGBB
fn paint(img: &mut Image, x0: i32, y0: i32, x1: i32, y1: i32, rgb: u32) {
  var y = y0;
  while y < y1 {
    if y >= 0 && y < img.height {
      var x = x0;
      while x < x1 {
        if x >= 0 && x < img.width {
          let o = usize.from(u32.from((img.height - 1 - y) * img.width + x) * 3u32);
          img.pixels.set(o, u8.from((rgb >> 16u32) & 255u32));
          img.pixels.set(o + 1usize, u8.from((rgb >> 8u32) & 255u32));
          img.pixels.set(o + 2usize, u8.from(rgb & 255u32));
        }
        x = x + 1;
      }
    }
    y = y + 1;
  }
}

// A plain name or chip (its picture is made later, by fill); depth tested
fn textLabel(l: &mut Labeller, device: &mut Device, format: u32, text: &str, bg: u32, ink: u32, size: f32, w: f32) Label {
  Label(PagePass.createDepth(device, format), w, w / 4., false, String.from(text), bg, ink, size, 22., false, 0., false, false, 0.)
}

// The level readout at the foot of the view: no depth test (it is part of the view, not of the room)
fn readoutLabel(device: &mut Device, format: u32) Label {
  Label(PagePass.create(device, format), 0.36, 0.09, false, String.from("Incubator"), 0x202833ffu32, 0xffffffffu32, 50., 22.,
    false, 0., false, false, 0.)
}

// A card of the line: title, a bar, and an amber frame if it needs Jon (strong or soft)
fn cardLabel(l: &mut Labeller, device: &mut Device, format: u32, title: &str, progress: f32, hot: bool, strong: bool) Label {
  // 1.5x the old 32 px: one line up to 48 px, longer ones two lines of 38 (the progress bar starts at 98 px)
  let one = 470. / (0.6 * f32.from(u32.from(title.len() + 1usize)));
  let sz: f32 = if one >= 34. { if one < 48. { one } else { 48. } } else { 38. };
  let tp: f32 = if one >= 34. { 14. } else { 3. };
  Label(PagePass.createDepth(device, format), 1.1, 0.275, false, String.from(title), 0xf8f5eeffu32, 0x1c1c1cffu32, sz, tp, true,
    progress, hot, strong, 1.)       // its own alpha stays 1: the card's (Card.alpha) fades both frames together
}

// A soft disc of alpha, 128 px square, for the floor: the ring of light (a pale band with a faint glow inside it) or
// the contact shadow (black, strongest in the middle)
fn makeDecal(device: &mut Device, format: u32, ring: bool) PagePass {
  var pass = PagePass.createDepth(device, format);
  let n = 128u32;
  var px = List[u8].withCapacity(usize.from(n * n * 4u32));
  var y = 0u32;
  while y < n {
    var x = 0u32;
    while x < n {
      let fx = (f32.from(x) + 0.5) / f32.from(n) * 2. - 1.;
      let fy = (f32.from(y) + 0.5) / f32.from(n) * 2. - 1.;
      let r = (fx * fx + fy * fy).sqrt();
      var a: f32 = 0.;
      if ring {
        let d = (r - 0.78).abs() / 0.14;
        if d < 1. { a = (1. - d) * (1. - d) * 0.9; }
        if r < 0.78 { a = fmaxf(a, 0.14 * (1. - r / 0.78)); }
      } else {
        if r < 1. { a = 0.6 * (1. - r) * (1. - r); }
      }
      px.push(if ring { 255u8 } else { 0u8 });
      px.push(if ring { 244u8 } else { 0u8 });
      px.push(if ring { 214u8 } else { 0u8 });
      px.push(u8.from(u32.from(a * 255.)));
      x = x + 1u32;
    }
    y = y + 1u32;
  }
  pass.uploadRgba(device, n, n, &px);
  pass
}

struct Card {
  id: String;
  stage: u32;
  hot: bool;
  calm: Label;
  glow: Label;          // the strong frame; shown in turns with 'calm' when hot
  report: String;       // a file path, or empty
  alpha: f32;
  zone: String;         // which zone's line it belongs to (line.json "zone")
}

// A project: a part of the world (or the document page), and where it stands
struct Item {
  name: String;
  part: String;         // the part's name in the world; empty for the document page
  page: bool;
  home: u32;            // its shelf slot when shelved
  onTable: bool;        // in the ring (no table now: it floats)
  idx: u32;             // ring slot or shelf slot
  pos: Vec3;
  scale: f32;
  yaw: f32;
  fromPos: Vec3;
  fromScale: f32;
  flight: f32;          // 0 just launched, 1 arrived
  touched: u64;
  slot: u32;            // the part's slot once found
  tableScale: f32;
  shelfScale: f32;
  height: f32;          // at scale 1
  radius: f32;          // half its width at scale 1
  yawShelf: f32;
  label: Label;
  zlevel: u32;          // 0 in the ring, 1 fills the ring, 2 fills the room
  zf: f32;              // the zoom factor now (follows the level's)
  shade: f32;           // the contact shadow's strength now
  id: String;           // its key in incubator.toml and room.toml
  free: bool;           // placed by 'at:x,y,z' (in neither the ring nor a shelf)
  freePos: Vec3;
  mul: f32;             // scale_pct / 100
  menu: List[ChipEntry];    // its chips
  isApp: bool;          // the architecture walk: drawn by the walk's own code (archworld.cone), no part in the world
}

// A chip of a project's menu: what it says, what it does, and which picture of the pool is its
struct ChipEntry {
  text: String;
  action: String;
  known: bool;
  pool: usize;
}

// The visitor gliding to look at something
struct Glide {
  active: bool;
  t: f32;
  from: Vec3;
  to: Vec3;
  fromYaw: f32;
  toYaw: f32;
  fromPitch: f32;
  toPitch: f32;
}

pub struct Incubator {
  pub on: bool;
  labeller: Option[Labeller];
  items: List[Item];
  tableItem: List[i32];    // the ring's slots
  shelfItem: List[i32];
  chips: List[Label];      // shelve, bring, zoom, open, talk
  stages: List[Label];
  cards: List[Card];
  lineText: String;
  linePoll: u64;
  linesRead: u32;
  pub sel: i32;
  selAt: u64;
  lastMs: u64;
  startMs: u64;
  glide: Glide;
  format: u32;
  ticks: u32;
  decals: List[PagePass];  // [0] the ring of light, [1] the contact shadow
  slotGlow: List[f32];
  chipAnchor: i32;         // the item the chips stand beside (kept while they fade out)
  chipKinds: List[u32];
  readout: List[Label];
  readKey: i32;
  reportPanel: Option[DocPanel];
  reportWant: String;      // a report to open, asked for by a click and served in 'update'
  reportCard: i32;         // the card whose report is open, or -1
  reportOpen: bool;
  reportPos: Vec3;
  browserPanel: Option[DocPanel];   // the file browser: a panel standing ahead of the visitor where F was pressed
  browserOpen: bool;
  browserPos: Vec3;
  browserYaw: f32;
  navWant: u32;            // a chip asked for back (6), forward (7) or the file browser (8); the shell serves it
  browserWant: String;     // a folder to show in the browser, served in 'update'
  // the incubator's configuration (incubatorcfg.cone)
  cfgDir: String;
  incubatorSeen: String;      // the last text of incubator.toml read
  roomSeen: String;
  incubatorGood: Parsed;      // the last incubator.toml that read well
  roomGood: Parsed;        // the last room.toml that read well, plus what the room has done since
  haveIncubator: bool;
  cfgPoll: u64;
  incubatorErr: String;
  roomErr: String;
  errCard: Option[Label];  // the red card: what is wrong in a file
  errShown: String;
  applying: bool;          // the file is being applied: the moves it makes are not the room's own
  writeAt: u64;            // when room.toml is to be written (a second after the last move), or 0
  outLines: List[String];  // lines for the bridge, taken by the shell
  sayWant: String;         // a say: action's text, taken by the shell
  linkWant: String;        // a link: action's target, taken by the shell
  reloadAsk: bool;
  lineFileV: String;
  browseRoot: String;
  chipKeys: List[String];  // the pool's pictures' keys: text and colour
  docPath: String;
  aw: Option[Aw];
  eyeIx: u32;              // which eye the walk's words are drawn for (0 the window or the left eye)
  moves: u32;              // moves written to room.toml
  applied: bool;           // the files have been applied once (later changes fly)
  pgs: Pgs;                // the pages (pages.cone)
  pgChips: List[Label];    // close, shelve, grab; park
  markers: FolderPosts;    // the parked folders
  grabIx: i32;             // the page being moved by hand, or -1
  grabDist: f32;
  gazeEye: Vec3;           // where the visitor looks from and along (set by the shell each frame)
  gazeDir: Vec3;
  pgSerial: u32;
  lastBorn: u64;
  restoreQ: PageCfgs;      // pages room.toml holds that are yet to be opened
  restoreAt: u64;
  pageWant: String;        // a file or address to open as a page, taken by the shell
  browseCfg: bool;         // [panel.browser] gave a place
  browseCfgPos: Vec3;
  browseCfgYaw: f32;
  reportCfg: bool;         // [panel.report] gave a place
  reportCfgPos: Vec3;
  reportCfgYaw: f32;
  slotsBack: u32;          // [shelf.back] / [shelf.side] slots: how many the room uses when it shelves by itself
  slotsSide: u32;
  handHeld: bool;          // a hand's grip holds the gaze
  desk: Option[DeskPanel]; // --desk: the laptop's screen at a desk spot (desk.cone)
  grabKind: u32;           // what the grip holds besides a page: 1 the file browser, 2 the report, 3 a parked folder's post, 4 a project, else 0
  grabIt: i32;             // its number (marker or item); for kind 5 (the palette) unused; kind 6 is a board (zone number in grabIt)
  pal: Palette;            // the palette (palette.cone)
  focusPg: i32;            // the page (pgs) last clicked, or -1: with 'sel', what the palette's set follows
  palFocused: bool;        // "focus" was pressed: the root icon shows "release"
  zones: List[Zone];                 // the boards at the back (zones.cone)
  dimPass: Option[PagePass];          // the veil over the room while a pane is at the workbench
  addrBuf: String;                    // what is typed into the general browser's address strip
  addrShown: String;                  // what the strip's picture says now
  dictFile: String;                   // the file named in dictate.flag
  editOnOpen: String;                 // the page opened from this file starts in editing (a new note)
  zoneSeen: bool = false;
  benchN: u32 = 0u32;                 // pages opened from a board's tree so far (where the next stands on the workbench)
  tabCur: u32 = 0u32;                 // the general browser: the number of the tab shown (0: no tabs)
  tabSerial: u32 = 0u32;
  tabNext: bool = false;              // the next page opened is a tab
  addrEdit: bool = false;             // the address strip is being typed into
  dictOn: bool = false;               // "dictate" mode: the voice goes to the page's caret, and A/B are not Penny's (guidebrowser.cone voiceAct)
  dictPg: i32 = -1;                   // the page dictated into
  dictFlag: u32 = 0u32;               // the shell is to write (1) or remove (2) dictate.flag
  notesMade: u32 = 0u32;

  pub fn empty() Incubator {
    Incubator(false, None, List[Item](), List[i32](), List[i32](), List[Label](), List[Label](), List[Card](), String(), 0u64, 0u32,
      NO_ITEM, 0u64, 0u64, 0u64, Glide(false, 0., Vec3(0., 0., 0.), Vec3(0., 0., 0.), 0., 0., 0., 0.), 0u32, 0u32,
      List[PagePass](), List[f32](), NO_ITEM, List[u32](), List[Label](), -1, None, String(), -1, false,
      Vec3(0., 0., 0.), None, false, Vec3(0., 0., 0.), 0., 0u32, String(),
      String(), String(), String(), newParsed(), newParsed(), false, 0u64, String(), String(), None, String(), false, 0u64,
      List[String](), String(), String(), false, String.from(LINE_FILE), String.from(DEFAULT_ROOT_BROWSE), List[String](), String(),
      None, 0u32, 0u32, false,
      Pgs(), List[Label](), FolderPosts(), -1, 3., Vec3(0., 0., 0.), Vec3(0., 0., 0. - 1.), 0u32, 0u64, PageCfgs(), 0u64, String(),
      false, Vec3(0., 0., 0.), 0., false, Vec3(0., 0., 0.), 0., 16u32, 8u32, false, None, 0u32, -1, Palette.empty(), -1, false, List[Zone](), None, String(), String(), String(), String())
  }

  pub fn create(device: &mut Device, renderer: &mut Renderer, format: u32, cfgDir: &str, docPath: &str) Incubator {
    var w = Incubator.empty();
    w.format = format;
    w.cfgDir = String.from(cfgDir);
    w.docPath = String.from(docPath);
    var maybe = Labeller.create(device);
    match &mut maybe {
      case var &mut Some(l) {
        w.on = true;
        var i = 0;
        while i < RING_N { w.tableItem.push(NO_ITEM); w.slotGlow.push(0.); i = i + 1; }
        i = 0;
        while i < 24 { w.shelfItem.push(NO_ITEM); i = i + 1; }
        // one pass for each thing drawn (a pass has one set of uniforms, written when the draw is recorded):
        // [0..5) the rings of the slots, [5..14) the shadows of the nine items
        i = 0;
        while i < RING_N { w.decals.push(makeDecal(device, format, true)); i = i + 1; }
        i = 0;
        while i < MAX_ITEMS { w.decals.push(makeDecal(device, format, false)); i = i + 1; }
        w.readout.push(readoutLabel(device, format));
        w.errCard = Some[Label](Label(PagePass.create(device, format), 1.2, 0.3, false, String(), 0xb3261eff, 0xffffffffu32, 26., 10., false,
          0., false, false, 0.));
        // knight, page, amphora in the ring; six boxes on the shelf; the architecture walk
        w.addItem(l, device, "knight", "Knight", "knight", false, 8u32, 1.0, 0.45, 0.61, 0.2, PI * 0.5);
        w.addItem(l, device, "page", "Design page", "", true, 9u32, 0.5, 0.2, 1.903, 0.67, 0.);
        w.addItem(l, device, "amphora", "Amphora", "amphora", false, 10u32, 1.0, 0.6, 0.52, 0.17, 0.);
        w.addItem(l, device, "island", "Island", "box_island", false, 0u32, 1.6, 1.0, 0.30, 0.15, 0.);
        w.addItem(l, device, "labyrinth", "Labyrinth", "box_labyrinth", false, 1u32, 1.6, 1.0, 0.30, 0.15, 0.);
        w.addItem(l, device, "starship", "Starship", "box_starship", false, 2u32, 1.6, 1.0, 0.30, 0.15, 0.);
        w.addItem(l, device, "cottage", "Cottage", "box_cottage", false, 3u32, 1.6, 1.0, 0.30, 0.15, 0.);
        w.addItem(l, device, "chess", "Chess", "box_chess", false, 4u32, 1.6, 1.0, 0.30, 0.15, 0.);
        w.addItem(l, device, "horse", "Horse", "box_horse", false, 5u32, 1.6, 1.0, 0.30, 0.15, 0.);
        w.addItem(l, device, "archwalk", "Architecture walk", "", false, 6u32, 0.12, 0.05, 5.0, 0.7, 0.);
        (&mut w.items[9usize]).isApp = true;
        // who stands where at the start: the page dead ahead (slot 0), the amphora to its right (1), the walk next (2), the knight on the left (4)
        w.settle(0, true, 4u32);
        w.settle(1, true, 0u32);
        w.settle(2, true, 1u32);
        w.settle(9, true, 2u32);
        i = 3;
        while i < 9 { w.settle(i, false, w.items[usize.from(u32.from(i))].home); i = i + 1; }
        let white = 0xffffffffu32;
        let names = ["queued", "building", "testing", "in review", "merged"];
        let tint = [0x80808affu32, 0xc08a20ffu32, 0x3a78b0ffu32, 0x8a5aa8ffu32, 0x3a8a58ffu32];
        var s = 0usize;
        while s < 5usize {
          w.stages.push(textLabel(l, device, format, names[s], tint[s], white, 54., 0.9));
          s = s + 1usize;
        }
      }
      else {}
    }
    w.labeller = maybe;
    w.startMs = nowMs();
    w.lastMs = w.startMs;
    if w.on {
      w.aw = makeAw(device, renderer, format);
      w.ensureChips(device);
      w.initConfig(device, renderer);
    }
    w
  }

  fn addItem(self: &mut, l: &mut Labeller, device: &mut Device, id: &str, name: &str, part: &str, page: bool, home: u32,
             tableScale: f32, shelfScale: f32, height: f32, radius: f32, yawShelf: f32) {
    let label = textLabel(l, device, format, name, 0xf8f5eeffu32, 0x1c1c1cffu32, 50., 0.56);
    items.push(Item(String.from(name), String.from(part), page, home, false, 0u32, Vec3(0., 0., 0.), 1., 0.,
      Vec3(0., 0., 0.), 1., 1., 0u64, NO_SLOT, tableScale, shelfScale, height, radius, yawShelf, label, 0u32, 1., 0.,
      String.from(id), false, Vec3(0., 0., 0.), 1., List[ChipEntry](), false));
  }

  // Put item i where it stands, with no flight
  fn settle(self: &mut, i: i32, onTable: bool, idx: u32) {
    let k = usize.from(u32.from(i));
    (&mut items[k]).onTable = onTable;
    (&mut items[k]).idx = idx;
    if onTable { tableItem.set(usize.from(idx), i); } else { shelfItem.set(usize.from(idx), i); }
    let d = self.dest(k);
    (&mut items[k]).pos = d;
    (&mut items[k]).scale = self.destScale(k);
    (&mut items[k]).yaw = if onTable { self.slotYaw(idx) } else { items[k].yawShelf };
    (&mut items[k]).flight = 1.;
    (&mut items[k]).shade = if onTable { 1. } else { 0. };
  }

  // Slot t of the ring: evenly around the start spot, slot 0 straight ahead (-z), going round to the right
  // --desk: the laptop's screen panel, made once the labels' fonts are (after create)
  pub fn initDesk(self: &mut, device: &mut Device) {
    match &mut labeller {
      case var &mut Some(l) { desk = Some[DeskPanel](DeskPanel.create(l, device, format)); }
      else {}
    }
  }

  pub fn deskClick(self: &mut, eye: Vec3, dir: Vec3) bool {
    match &mut desk { case var &mut Some(d) { return d.click(eye, dir); } else {} }
    false
  }

  pub fn deskWheel(self: &mut, eye: Vec3, dir: Vec3, notches: f32) bool {
    match &mut desk { case var &mut Some(d) { return d.wheel(eye, dir, notches); } else {} }
    false
  }

  pub fn deskPoint(self: &mut, eye: Vec3, dir: Vec3) {
    match &mut desk { case var &mut Some(d) { d.point(eye, dir); } else {} }
  }

  pub fn deskProbe(self: &mut) {
    match &mut desk { case var &mut Some(d) { d.probeCorners(); } else {} }
  }

  pub fn deskReport(self: &) {
    match &desk { case let Some(d) { d.report(); } else {} }
  }

  pub fn deskToggle(self: &mut) {
    match &mut desk { case var &mut Some(d) { let on = !d.control; d.setControl(on); } else {} }
  }

  fn slotPos(t: u32) Vec3 {
    let a = f32.from(t) * 2. * PI / f32.from(RING_N);
    Vec3(ringRadius * sin(a), floatHeight, 0. - ringRadius * cos(a))
  }

  // The yaw that turns a page at slot t to face the start spot
  fn slotYaw(self: &, t: u32) f32 { 0. - f32.from(t) * 2. * PI / f32.from(RING_N) }

  fn shelfPos(j: u32) Vec3 {
    if j < 16u32 {
      let col = f32.from(j % 8u32);
      Vec3((col - 3.5) * 1.4, if j / 8u32 == 0u32 { 0.30 } else { 1.20 }, -11.0)
    } else {
      let q = j - 16u32;
      Vec3(11.0, if q / 4u32 == 0u32 { 0.30 } else { 1.20 }, (f32.from(q % 4u32) - 1.5) * 1.4)
    }
  }

  fn dest(self: &, k: usize) Vec3 {
    if items[k].free { items[k].freePos }
    else if items[k].onTable { Incubator.slotPos(items[k].idx) } else { Incubator.shelfPos(items[k].idx) }
  }

  fn destScale(self: &, k: usize) f32 {
    (if items[k].onTable { items[k].tableScale } else { items[k].shelfScale }) * items[k].mul
  }

  // Where item k is now once zoom is counted: x, y (its foot), z and the scale. Zoom scales it about its centre,
  // not lower than the floor.
  fn eff(self: &, k: usize) Vec4 {
    let it = &items[k];
    let s = it.scale * it.zf;
    var y = it.pos.y + 0.5 * it.height * it.scale - 0.5 * it.height * s;
    if y < 0. { y = 0.; }
    Vec4(it.pos.x, y, it.pos.z, s)
  }

  fn zoomHeight(level: u32) f32 {
    if level == 1u32 { ZOOM1_H } else { ZOOM2_H }
  }

  fn startFlight(self: &mut, k: usize) {
    (&mut items[k]).fromPos = items[k].pos;
    (&mut items[k]).fromScale = items[k].scale;
    (&mut items[k]).flight = 0.;
  }

  // Per frame: the clock, the flights, the turning, the zoom, the fades, the line's file, the report
  pub fn update(self: &mut, device: &mut Device, renderer: &mut Renderer) {
    let now = nowMs();
    var dt = f32.from(now - lastMs) / 1000.;
    if dt > 0.1 { dt = 0.1; }
    lastMs = now;
    self.editWatch(device, renderer);
    let clock = f32.from(now - startMs) / 1000.;
    var k = 0usize;
    while k < items.len() {
      let d = self.dest(k);
      let ds = self.destScale(k);
      var want: f32 = 0.;
      if items[k].onTable {
        want = if items[k].page { self.slotYaw(items[k].idx) + items[k].yawShelf } else { clock * 0.4 };
        if items[k].isApp { want = self.slotYaw(items[k].idx) + items[k].yawShelf; }
        else if !items[k].page { want = items[k].yawShelf + clock * 0.4; }
      } else { want = items[k].yawShelf; }
      // turn the short way, quickly after a flight so that the swap does not pop
      var delta = want - items[k].yaw;
      while delta > PI { delta = delta - 2. * PI; }
      while delta < 0. - PI { delta = delta + 2. * PI; }
      let follow: f32 = if items[k].flight < 1. { 8. * dt } else { 1. };
      var step: f32 = delta * (if follow > 1. { 1. } else { follow });
      (&mut items[k]).yaw = items[k].yaw + step;
      if items[k].flight < 1. {
        var f = items[k].flight + dt * 1000. / FLIGHT_MS;
        if f > 1. { f = 1.; }
        (&mut items[k]).flight = f;
        let e = f * f * (3. - 2. * f);
        var p = items[k].fromPos.lerp(d, e);
        p.y = p.y + 0.6 * sin(PI * e);
        (&mut items[k]).pos = p;
        (&mut items[k]).scale = items[k].fromScale + (ds - items[k].fromScale) * e;
      } else {
        (&mut items[k]).pos = d;
        (&mut items[k]).scale = ds;
      }
      // zoom: the factor follows the level's
      var tz: f32 = 1.;
      if items[k].zlevel > 0u32 { tz = Incubator.zoomHeight(items[k].zlevel) / (items[k].height * ds); }
      var zstep = 5. * dt;
      if zstep > 1. { zstep = 1.; }
      (&mut items[k]).zf = items[k].zf + (tz - items[k].zf) * zstep;
      (&mut items[k]).shade = fadeToward(items[k].shade, if items[k].onTable { 1. } else { 0. }, dt);
      (&mut items[k]).label.alpha = fadeToward(items[k].label.alpha, if items[k].zlevel > 0u32 { 0. } else { 1. }, dt);
      k = k + 1usize;
    }
    // the ring's slots glow: a filled slot fully, an empty one faintly
    var t = 0usize;
    while t < usize.from(u32.from(RING_N)) {
      slotGlow.set(t, fadeToward(*slotGlow[t], if *tableItem[t] == NO_ITEM { 0.3 } else { 1. }, dt));
      t = t + 1usize;
    }
    // the chips: shown a moment after a selection settles; fade by kind
    let shown = self.chipsShown(now);
    if shown {
      chipAnchor = sel;
      chipKinds = self.chipList();
    }
    var c = 0usize;
    while c < chips.len() {
      var has = false;
      var q = 0usize;
      while q < chipKinds.len() { if usize.from(*chipKinds[q]) == c { has = true; } q = q + 1usize; }
      (&mut chips[c]).alpha = fadeToward(chips[c].alpha, if shown && has { 1. } else { 0. }, dt);
      c = c + 1usize;
    }
    var si = 0usize;
    while si < stages.len() { (&mut stages[si]).alpha = fadeToward(stages[si].alpha, 1., dt); si = si + 1usize; }
    var ci = 0usize;
    while ci < cards.len() { (&mut cards[ci]).alpha = fadeToward(cards[ci].alpha, 1., dt); ci = ci + 1usize; }
    self.updateReadout(dt);
    let errWant: f32 = if errShown.len() > 0usize { 1. } else { 0. };
    match &mut errCard {
      case var &mut Some(ec) { ec.alpha = fadeToward(ec.alpha, errWant, dt); }
      else {}
    }
    if now >= linePoll + 250u64 {
      linePoll = now;
      self.readLine(device);
    }
    self.serveReport(device, renderer);
    self.tickBrowser(device, renderer);
    self.cfgTick(device, renderer, now);
    self.tickZones(device, renderer, dt, now);
    self.tickPages(device, renderer, dt);
    self.palTick(device, dt, now);
    self.awTick(dt);
    match &mut desk { case var &mut Some(d) { d.tick(device); } else {} }
    ticks = ticks + 1u32;
    if ticks > 4u32 { self.fillSome(device, 2); }
  }

  // The level readout: "Knight, room" while something is selected, fading out when nothing is
  fn updateReadout(self: &mut, dt: f32) {
    var key = -1;
    var text = String.from("Incubator");
    if sel >= 0 {
      let it = &items[usize.from(u32.from(sel))];
      key = sel * 4 + i32.from(it.zlevel);
      text = String.from(it.name.view());
      text.append(", ");
      text.append(if it.zlevel == 0u32 { "Incubator" } else if it.zlevel == 1u32 { "ring" } else { "room" });
    }
    if key >= 0 && key != readKey {
      readKey = key;
      (&mut readout[0usize]).text = text;
      (&mut readout[0usize]).ok = false;
    }
    (&mut readout[0usize]).alpha = fadeToward(readout[0usize].alpha, if sel >= 0 { 1. } else { 0. }, dt);
  }

  // A few pictures a frame: names, readout, chips, stage boards, then cards
  fn fillSome(self: &mut, device: &mut Device, most: i32) {
    var lab: Option[Labeller] = None;
    lab <-> labeller;
    var made = 0;
    match &mut lab {
      case var &mut Some(l) {
        var k = 0usize;
        while k < items.len() && made < most {
          if !items[k].label.ok { fillLabel(l, device, &mut items[k].label); made = made + 1; }
          k = k + 1usize;
        }
        if made < most && !readout[0usize].ok { fillLabel(l, device, &mut readout[0usize]); made = made + 1; }
        match &mut desk {
          case var &mut Some(d) {
            if made < most && !d.chipOff.ok { fillLabel(l, device, &mut d.chipOff); made = made + 1; }
            if made < most && !d.chipOn.ok { fillLabel(l, device, &mut d.chipOn); made = made + 1; }
          }
          else {}
        }
        k = 0usize;
        while k < chips.len() && made < most {
          if !chips[k].ok { fillLabel(l, device, &mut chips[k]); made = made + 1; }
          k = k + 1usize;
        }
        match &mut errCard {
          case var &mut Some(ec) { if made < most && !ec.ok && ec.text.len() > 0usize { fillLabel(l, device, ec); made = made + 1; } }
          else {}
        }
        k = 0usize;
        while k < stages.len() && made < most {
          if !stages[k].ok { fillLabel(l, device, &mut stages[k]); made = made + 1; }
          k = k + 1usize;
        }
        k = 0usize;
        while k < cards.len() && made < most {
          if !cards[k].calm.ok { fillLabel(l, device, &mut cards[k].calm); made = made + 1; }
          if made < most && !cards[k].glow.ok { fillLabel(l, device, &mut cards[k].glow); made = made + 1; }
          k = k + 1usize;
        }
        k = 0usize;
        while k < pgChips.len() && made < most {
          if !pgChips[k].ok { fillLabel(l, device, &mut pgChips[k]); made = made + 1; }
          k = k + 1usize;
        }
        k = 0usize;
        while k < pgs.len() && made < most {
          if !pgs[k].title.ok { fillLabel(l, device, &mut pgs[k].title); made = made + 1; }
          var cc = 0usize;
          while cc < pgs[k].chips.len() && made < most {
            if !pgs[k].chips[cc].ok { fillLabel(l, device, &mut pgs[k].chips[cc]); made = made + 1; }
            cc = cc + 1usize;
          }
          k = k + 1usize;
        }
        self.fillZones(l, device, &mut made, most);
        k = 0usize;
        while k < markers.len() && made < most {
          if !markers[k].label.ok { fillLabel(l, device, &mut markers[k].label); made = made + 1; }
          if made < most && !markers[k].post.ok { fillLabel(l, device, &mut markers[k].post); made = made + 1; }
          k = k + 1usize;
        }
      }
      else {}
    }
    labeller <-> lab;
  }

  // line.json read again when its text changes; a file that does not parse keeps the last cards
  fn readLine(self: &mut, device: &mut Device) {
    match fs.readFile(&Path.from(lineFileV.view())) {
      case let Ok(s) {
        if sameText(s.view(), lineText.view()) { return; }
        match json.parse(s.view()) {
          case let Ok(doc) {
            lineText = String.from(s.view());
            var lab: Option[Labeller] = None;
            lab <-> labeller;
            var fresh = List[Card]();
            match &mut lab {
              case var &mut Some(l) {
                var i = 0usize;
                while i < doc.len() {
                  match doc.at(i) {
                    case let Some(c) {
                      var title = String();
                      match c.getText("title") { case let Some(t) { title.append(t); } else {} }
                      var id = String();
                      match c.getText("id") { case let Some(t) { id.append(t); } else {} }
                      var report = String();
                      match c.getText("report") { case let Some(t) { report.append(t); } else {} }
                      var stage = 0u32;
                      match c.getText("stage") {
                        case let Some(t) {
                          if sameText(t, "building") { stage = 1u32; }
                          else if sameText(t, "testing") { stage = 2u32; }
                          else if sameText(t, "review") { stage = 3u32; }
                          else if sameText(t, "merged") { stage = 4u32; }
                        }
                        else {}
                      }
                      let progress = f32.from(c.f64Or("progress", 0.0f64));
                      let hot = c.boolOr("needs_jon", false);
                      let calm = cardLabel(l, device, format, title.view(), progress, hot, false);
                      let glow = cardLabel(l, device, format, title.view(), progress, hot, true);
                      // a card that was there keeps how visible it was, so a changed file does not blink the line
                      var was: f32 = 0.;
                      var o = 0usize;
                      while o < cards.len() { if sameText(cards[o].id.view(), id.view()) { was = cards[o].alpha; } o = o + 1usize; }
                      var zn = String();
                      match c.getText("zone") { case let Some(t) { zn.append(t); } else {} }
                      fresh.push(Card(id, stage, hot, calm, glow, report, was, zn));
                    }
                    else {}
                  }
                  i = i + 1usize;
                }
                self.buildStrips(l, device, &fresh);
              }
              else {}
            }
            labeller <-> lab;
            cards = fresh;
            reportCard = -1;
            linesRead = linesRead + 1u32;
            print <- "incubator: line.json read: "; print <- cards.len(); print <- " cards\n";
          }
          case let Err(e) {
            print <- "incubator: line.json does not parse; keeping the last cards\n";
            lineText = String.from(s.view());
          }
        }
      }
      case is Err {}
    }
  }

  // ---- the report page beside a card ----

  // Serve a click's request: open the file in the report panel (made on first use), keep it live
  fn serveReport(self: &mut, device: &mut Device, renderer: &mut Renderer) {
    if reportWant.len() > 0usize {
      match &mut reportPanel {
        case var &mut Some(p) { let rw = reportWant.clone(); p.open(device, renderer, rw.view()); }
        case is None { reportPanel = DocPanel.create(device, renderer, format, reportWant.view(), 0.); }
      }
      print <- "incubator: report opened: "; printStr(reportWant.view()); print <- "\n";
      reportWant = String();
      reportOpen = true;
    }
    if reportOpen {
      match &mut reportPanel {
        case var &mut Some(p) { p.tick(device, renderer); }
        else {}
      }
    }
  }

  // The card c's place on the line: its station's column, stacked upward among the cards of the same stage
  fn cardPlace(self: &, c: usize) Vec3 {
    var n = 0u32;
    var o = 0usize;
    while o < c { if cards[o].stage == cards[c].stage { n = n + 1u32; } o = o + 1usize; }
    self.cardPos(usize.from(cards[c].stage), n)
  }

  // Open (or close, if it is open) the report of card c, standing beside it, toward the room
  pub fn openCard(self: &mut, c: i32) bool {
    if c < 0 || usize.from(u32.from(c)) >= cards.len() { return false; }
    let cu = usize.from(u32.from(c));
    if cards[cu].report.len() == 0usize {
      print <- "incubator: card "; printStr(cards[cu].id.view()); print <- " has no report\n";
      return true;
    }
    if reportOpen && reportCard == c { reportOpen = false; reportCard = -1; print <- "incubator: report closed\n"; return true; }
    let p = self.cardPlace(cu);
    reportPos = Vec3(-3.5, 0., p.z + (if p.z > 0. { -1.2 } else { 1.2 }));
    if reportCfg { reportPos = reportCfgPos; }
    reportWant = String.from(cards[cu].report.view());
    reportCard = c;
    true
  }

  fn reportModel(self: &) Mat4 {
    Mat4.fromTrs(reportPos, Quat.angleAxis(if reportCfg { reportCfgYaw } else { PI * 0.5 }, Vec3(0., 1., 0.)), Vec3(1., 1., 1.))
  }

  // A click's ray: the open report page (taken, nothing more) or a card (opens its report)
  pub fn clickCard(self: &mut, eye: Vec3, dir: Vec3) bool {
    var best = -1;
    var bestT: f32 = 1000.;
    var c = 0usize;
    while c < cards.len() && OLD_LINE {
      let m = Mat4.fromTrs(self.cardPlace(c), Quat.angleAxis(PI * 0.5, Vec3(0., 1., 0.)), Vec3(1., 1., 1.));
      let inv = m.inverse();
      let e = inv * eye;
      let d = inv.transformVector(dir);
      if d.z > 0.00001 || d.z < -0.00001 {
        let t = (0. - e.z) / d.z;
        if t > 0. && t < bestT {
          let p = e + d * t;
          if p.x >= -0.55 && p.x <= 0.55 && p.y >= -0.1375 && p.y <= 0.1375 && cards[c].alpha > 0.3 {
            best = i32.from(c);
            bestT = t;
          }
        }
      }
      c = c + 1usize;
    }
    if best >= 0 {
      print <- "incubator: card clicked: "; printStr(cards[usize.from(u32.from(best))].id.view()); print <- "\n";
      return self.openCard(best);
    }
    if browserOpen {
      var bhit = false;
      match &mut browserPanel {
        case var &mut Some(p) {
          let inv = self.browserModel().inverse();
          bhit = p.click(inv * eye, inv.transformVector(dir));
        }
        else {}
      }
      if bhit { return true; }
    }
    if reportOpen {
      var hit = false;
      match &mut reportPanel {
        case var &mut Some(p) {
          let inv = self.reportModel().inverse();
          hit = p.click(inv * eye, inv.transformVector(dir));
        }
        else {}
      }
      if hit { return true; }
    }
    false
  }

  // ---- selection and actions ----

  fn itemOfSlot(self: &mut, parts: &List[Live], pi: usize) i32 {
    let slot = parts[pi].slot;
    var k = 0usize;
    while k < items.len() {
      if !items[k].page {
        if items[k].slot == slot { return i32.from(k); }
        if items[k].slot == NO_SLOT && sameText(items[k].part.view(), parts[pi].name.view()) {
          (&mut items[k]).slot = slot;
          return i32.from(k);
        }
      }
      k = k + 1usize;
    }
    NO_ITEM
  }

  pub fn isSelectedPart(self: &mut, parts: &List[Live], pi: usize) bool {
    if sel < 0 { return false; }
    self.itemOfSlot(parts, pi) == sel
  }

  // Where the part is this frame, or None for a part the loop does not move
  pub fn placeOf(self: &mut, parts: &List[Live], pi: usize) Option[Mat4] {
    let k = self.itemOfSlot(parts, pi);
    if k < 0 { return None; }
    let ku = usize.from(u32.from(k));
    let e = self.eff(ku);
    Some[Mat4](Mat4.fromTrs(Vec3(e.x, e.y, e.z), Quat.angleAxis(items[ku].yaw, Vec3(0., 1., 0.)), Vec3(e.w, e.w, e.w)))
  }

  fn pageIndex(self: &) i32 {
    var k = 0usize;
    while k < items.len() { if items[k].page { return i32.from(k); } k = k + 1usize; }
    NO_ITEM
  }

  // The page's model matrix: its local frame is the panel's own (z = 0, middle at DOC_CENTRE_Y)
  pub fn pageModel(self: &) Mat4 {
    let k = self.pageIndex();
    if k < 0 { return Mat4.identity(); }
    let ku = usize.from(u32.from(k));
    let e = self.eff(ku);
    let bottom = f32.from(DOC_CENTRE_Y) - 0.5 * f32.from(DOC_WORLD_W) * f32.from(DOC_TEX_H) / f32.from(DOC_TEX_W);
    Mat4.fromTrs(Vec3(e.x, e.y, e.z), Quat.angleAxis(items[ku].yaw, Vec3(0., 1., 0.)), Vec3(e.w, e.w, e.w))
      * Mat4.fromTranslation(Vec3(0., 0. - bottom, 0.))
  }

  pub fn select(self: &mut, k: i32) {
    deskFocus = false;
    if focusPg >= 0 || k != sel { focusPg = -1; palFocused = false; }
    if k == sel { return; }
    var o = 0usize;
    while o < items.len() { if i32.from(o) != k { (&mut items[o]).zlevel = 0u32; } o = o + 1usize; }
    sel = k;
    selAt = nowMs();
    if k >= 0 {
      (&mut items[usize.from(u32.from(k))]).touched = selAt;
      print <- "incubator: selected "; printStr(items[usize.from(u32.from(k))].name.view()); print <- "\n";
    }
  }

  pub fn selectPage(self: &mut) {
    self.select(self.pageIndex());
  }

  pub fn selectSlot(self: &mut, parts: &List[Live], pi: usize) {
    let k = self.itemOfSlot(parts, pi);
    self.select(k);
  }

  pub fn selectedIsPage(self: &) bool {
    sel >= 0 && items[usize.from(u32.from(sel))].page
  }

  // Which chips the selection has: 0 shelve, 1 bring, 2 zoom, 3 open, 4 talk
  fn chipList(self: &) List[u32] {
    var out = List[u32]();
    if sel < 0 { return out; }
    let ents = self.visibleEntries(usize.from(u32.from(sel)));
    var q = 0usize;
    while q < ents.len() { out.push(u32.from(items[usize.from(u32.from(sel))].menu[*ents[q]].pool)); q = q + 1usize; }
    out
  }

  // The entries of item k's menu that show now: shelve only on the ring, bring only on a shelf
  fn visibleEntries(self: &, k: usize) List[usize] {
    var out = List[usize]();
    var e = 0usize;
    while e < items[k].menu.len() {
      let a = items[k].menu[e].action.view();
      let hide = (a == "shelve" && !items[k].onTable) || (a == "bring" && items[k].onTable);
      if !hide { out.push(e); }
      e = e + 1usize;
    }
    out
  }

  fn freeShelf(self: &, k: usize) i32 {
    let h = items[k].home;
    if *shelfItem[usize.from(h)] == NO_ITEM { return i32.from(h); }
    var j = 0usize;
    while j < shelfItem.len() {
      let usable = if j < 16usize { u32.from(j) < slotsBack } else { u32.from(j) - 16u32 < slotsSide };
      if usable && *shelfItem[j] == NO_ITEM { return i32.from(j); }
      j = j + 1usize;
    }
    NO_ITEM
  }

  // A ring item to its shelf, in flight
  pub fn shelve(self: &mut, k: usize) bool {
    if !items[k].onTable { return false; }
    let j = self.freeShelf(k);
    if j < 0 { return false; }
    self.startFlight(k);
    tableItem.set(usize.from(items[k].idx), NO_ITEM);
    (&mut items[k]).onTable = false;
    (&mut items[k]).idx = u32.from(j);
    (&mut items[k]).zlevel = 0u32;
    shelfItem.set(usize.from(u32.from(j)), i32.from(k));
    (&mut items[k]).touched = nowMs();
    print <- "incubator: "; printStr(items[k].name.view()); print <- " to shelf slot "; print <- j; print <- "\n";
    self.noteMoved(k);
    true
  }

  // A shelved item to a free slot of the ring (the oldest-untouched one goes back to its shelf if all are full)
  pub fn bring(self: &mut, k: usize) bool {
    if items[k].onTable { return false; }
    var t = -1;
    let order = [0, 1, 4, 2, 3];
    var o = 0usize;
    while o < 5usize && t < 0 {
      if *tableItem[usize.from(u32.from(order[o]))] == NO_ITEM { t = order[o]; }
      o = o + 1usize;
    }
    if t < 0 {
      var oldest = 0usize;
      var best = 18446744073709551615u64;
      var q = 0usize;
      while q < 5usize {
        let who = usize.from(u32.from(*tableItem[q]));
        if items[who].touched < best { best = items[who].touched; oldest = who; }
        q = q + 1usize;
      }
      t = i32.from(items[oldest].idx);
      print <- "incubator: the ring is full; "; printStr(items[oldest].name.view()); print <- " goes back to its shelf\n";
      self.shelve(oldest);
    }
    self.startFlight(k);
    shelfItem.set(usize.from(items[k].idx), NO_ITEM);
    (&mut items[k]).onTable = true;
    (&mut items[k]).idx = u32.from(t);
    tableItem.set(usize.from(u32.from(t)), i32.from(k));
    (&mut items[k]).touched = nowMs();
    print <- "incubator: "; printStr(items[k].name.view()); print <- " to ring slot "; print <- t; print <- "\n";
    self.noteMoved(k);
    true
  }

  // Glide the visitor to stand 'dist' meters in front of item k and look at it
  fn glideTo(self: &mut, k: usize, eye: Vec3, yaw: f32, pitch: f32, dist: f32) {
    let c = self.dest(k);
    let hh = items[k].height * self.destScale(k) * 0.5;
    let target = Vec3(c.x, c.y + hh, c.z);
    var flat = Vec3(eye.x - c.x, 0., eye.z - c.z);
    if flat.length() < 0.01 { flat = Vec3(0., 0., 1.); }
    flat = flat.normalize();
    let to = Vec3(c.x + flat.x * dist, 1.6, c.z + flat.z * dist);
    let look = target - to;
    let len = look.length();
    glide = Glide(true, 0., eye, to, yaw, atan2(0. - look.x, 0. - look.z), pitch, asin(look.y / len));
  }

  // The view for zoom level 'level' of ring item k: standing on the line from the item through the start spot,
  // 2.5 m from it (at the start spot) for the ring, 9 m for the room, looking at its centre
  fn glideView(self: &mut, k: usize, level: u32, eye: Vec3, yaw: f32, pitch: f32) {
    let c = self.dest(k);
    let ds = self.destScale(k);
    let h = items[k].height * ds;
    var zt: f32 = 1.;
    if level > 0u32 { zt = Incubator.zoomHeight(level) / h; }
    var baseY = c.y + 0.5 * h - 0.5 * h * zt;
    if baseY < 0. { baseY = 0.; }
    let cy = baseY + 0.5 * h * zt;
    var flat = Vec3(0. - c.x, 0., 0. - c.z);
    if flat.length() < 0.01 { flat = Vec3(0., 0., 1.); }
    flat = flat.normalize();
    let dist = if level == 2u32 { 9.0 } else { ringRadius };
    let to = Vec3(c.x + flat.x * dist, 1.6, c.z + flat.z * dist);
    let look = Vec3(c.x, cy, c.z) - to;
    let len = look.length();
    glide = Glide(true, 0., eye, to, yaw, atan2(0. - look.x, 0. - look.z), pitch, asin(look.y / len));
  }

  // Z (dir 1) or Shift+Z (dir -1): the selected project one level up or down; the project scales about its centre
  // and the view steps to suit
  pub fn zoom(self: &mut, dir: i32, v: &Fly) bool {
    if sel < 0 { return false; }
    let k = usize.from(u32.from(sel));
    if !items[k].onTable {
      if dir < 0 { return false; }
      self.bring(k);
    }
    var lv = i32.from(items[k].zlevel) + dir;
    if lv < 0 { lv = 0; }
    if lv > 2 { lv = 2; }
    if lv == i32.from(items[k].zlevel) { return false; }
    (&mut items[k]).zlevel = u32.from(lv);
    (&mut items[k]).touched = nowMs();
    self.glideView(k, u32.from(lv), v.position, v.yaw, v.pitch);
    print <- "incubator: "; printStr(items[k].name.view()); print <- " zoom level "; print <- lv; print <- "\n";
    true
  }

  // The glide, one fixed step: moves the visitor
  pub fn glideStep(self: &mut, v: &mut Fly, dt: f32) {
    if !glide.active { return; }
    glide.t = glide.t + dt / 0.6;
    var t = glide.t;
    if t >= 1. { t = 1.; glide.active = false; }
    let e = t * t * (3. - 2. * t);
    v.position = glide.from.lerp(glide.to, e);
    var dy = glide.toYaw - glide.fromYaw;
    while dy > PI { dy = dy - 2. * PI; }
    while dy < 0. - PI { dy = dy + 2. * PI; }
    v.yaw = glide.fromYaw + dy * e;
    v.pitch = glide.fromPitch + (glide.toPitch - glide.fromPitch) * e;
  }

  // An action on the selection: 0 shelve, 1 bring, 2 zoom in, 3 open, 4 talk, 5 zoom out. True if it did something.
  pub fn act(self: &mut, a: u32, v: &Fly) bool {
    if sel < 0 { return false; }
    let k = usize.from(u32.from(sel));
    (&mut items[k]).touched = nowMs();
    if a == 0u32 { return self.shelve(k); }
    if a == 1u32 { return self.bring(k); }
    if a == 2u32 { return self.zoom(1, v); }
    if a == 5u32 { return self.zoom(-1, v); }
    if a == 3u32 {
      let d: f32 = if items[k].page { 1.1 } else { 0.9 };
      if !items[k].onTable { self.bring(k); }
      self.glideTo(k, v.position, v.yaw, v.pitch, d);
      return true;
    }
    if a >= 6u32 { navWant = a; return true; }
    a == 4u32
  }

  // ---- the file browser panel ----

  pub fn takeNav(self: &mut) u32 {
    let a = navWant;
    navWant = 0u32;
    a
  }

  fn browserModel(self: &) Mat4 {
    Mat4.fromTrs(browserPos, Quat.angleAxis(browserYaw, Vec3(0., 1., 0.)), Vec3(1., 1., 1.))
  }

  pub fn browserIsOpen(self: &) bool { browserOpen }

  // ---- the incubator's configuration (incubatorcfg.cone) ----

  // the Incubator's own file is incubator.toml; a config folder that still has only studio.toml (the old name) keeps working
  fn tomlName(self: &) &'static str {
    if !fs.exists(&Path.from(self.cfgPath("incubator.toml").view())) && fs.exists(&Path.from(self.cfgPath("studio.toml").view())) { return "studio.toml"; }
    "incubator.toml"
  }
  fn cfgPath(self: &, name: &str) String {
    var s = String.from(cfgDir.view());
    s.append("/");
    s.append(name);
    s
  }

  fn itemById(self: &, id: &str) i32 {
    var k = 0usize;
    while k < items.len() { if items[k].id.view() == id { return i32.from(k); } k = k + 1usize; }
    NO_ITEM
  }

  // Where an item stands, as a file says it
  fn placeText(self: &, k: usize) String {
    let it = &items[k];
    var s = String();
    if it.free {
      s.append("at:"); s.append(floatText(it.freePos.x).view()); s.append(",");
      s.append(floatText(it.freePos.y).view()); s.append(","); s.append(floatText(it.freePos.z).view());
    }
    else if it.onTable { s.append("ring:"); s.append(numText(i64.from(it.idx)).view()); }
    else if it.idx < 16u32 { s.append("shelf:back:"); s.append(numText(i64.from(it.idx)).view()); }
    else { s.append("shelf:side:"); s.append(numText(i64.from(it.idx - 16u32)).view()); }
    s
  }

  // The first run: incubator.toml written from the layout the incubator was built with; then both files are read as ever
  fn initConfig(self: &mut, device: &mut Device, renderer: &mut Renderer) {
    _ = fs.makeDirAll(&Path.from(cfgDir.view()));
    let sp = self.cfgPath(self.tomlName());
    if !fs.exists(&Path.from(sp.view())) {
      var r = newParsed();
      let now = isoUtc(unixMs());
      var k = 0usize;
      while k < items.len() {
        let it = &items[k];
        var p = newProj(it.id.view());
        p.name = String.from(it.name.view());
        if it.isApp { p.source = String.from("app:archwalk"); }
        else if it.page { p.source = String.from("doc:"); p.source.append(docPath.view()); }
        else { p.source = String.from("world:incubator.ddd#"); p.source.append(it.part.view()); }
        p.place = self.placeText(k);
        p.yaw = i64.from(i32.from(it.yawShelf * 180. / PI + 0.5));
        p.hasYaw = true;
        p.scale = 100i64;
        p.hasScale = true;
        p.at = String.from(now.view());
        p.menu = defaultMenu(if it.isApp { 2u32 } else if it.page { 1u32 } else { 0u32 });
        r.projects.push(p);
        k = k + 1usize;
      }
      r.folders.push(FolderCfg(String.from("cone"), String.from("Cone"), String.from("C:/src/cone"), String.from("at:-3,0,2.4"), String.from(now.view())));
      r.folders.push(FolderCfg(String.from("pegasus3d"), String.from("Pegasus 3D"), String.from("C:/src/pegasus3d"), String.from("at:-3,0,1.5"), String.from(now.view())));
      r.folders.push(FolderCfg(String.from("3dweb"), String.from("3D Web"), String.from("C:/Users/jondg/MyDrive/Incubator/3D Web"), String.from("at:-3,0,0.6"), String.from(now.view())));
      r.folders.push(FolderCfg(String.from("penny"), String.from("Penny prompts"), String.from("C:/Users/jondg/MyDrive/Incubator/Penny/prompts"), String.from("at:-3,0,-0.3"), String.from(now.view())));
      let text = incubatorText(&r, 250i64, 95i64, LINE_FILE, DEFAULT_ROOT_BROWSE);
      if writeAtomic(cfgDir.view(), "incubator.toml", text.view()) { print <- "incubator: no incubator.toml; wrote the first-run one from today's layout\n"; }
    }
    cfgPoll = 0u64;
    self.cfgTick(device, renderer, nowMs());
  }

  // Every 250 ms: both files are read, and a changed one that reads well is applied; one that does not keeps the last layout
  fn cfgTick(self: &mut, device: &mut Device, renderer: &mut Renderer, now: u64) {
    if writeAt != 0u64 && now >= writeAt { self.writeRoom(); }
    if now < cfgPoll + 250u64 { return; }
    cfgPoll = now;
    var cs = false;
    var cr = false;
    match fs.readFile(&Path.from(self.cfgPath(self.tomlName()).view())) {
      case let Ok(s) {
        if !sameText(s.view(), incubatorSeen.view()) {
          incubatorSeen = String.from(s.view());
          let p = parseConfig(s.view(), "incubator.toml");
          if p.ok {
            print <- "incubator: incubator.toml read, "; print <- p.projects.len(); print <- " projects, at "; print <- unixMs(); print <- " ms\n";
            incubatorGood = p; incubatorErr = String(); haveIncubator = true; cs = true;
          } else {
            print <- "incubator: "; printStr(p.err.view()); print <- " (keeping the last good layout), at "; print <- unixMs(); print <- " ms\n";
            incubatorErr = String.from(p.err.view());
          }
        }
      }
      case is Err {}
    }
    match fs.readFile(&Path.from(self.cfgPath("room.toml").view())) {
      case let Ok(s) {
        if !sameText(s.view(), roomSeen.view()) {
          roomSeen = String.from(s.view());
          let p = parseConfig(s.view(), "room.toml");
          if p.ok {
            print <- "incubator: room.toml read, "; print <- p.projects.len(); print <- " projects\n";
            roomGood = p; roomErr = String(); cr = true;
          } else {
            print <- "incubator: "; printStr(p.err.view()); print <- " (keeping the last good room)\n";
            roomErr = String.from(p.err.view());
          }
        }
      }
      case is Err {}
    }
    // the red card
    let want = if incubatorErr.len() > 0usize { String.from(incubatorErr.view()) } else { String.from(roomErr.view()) };
    if !sameText(want.view(), errShown.view()) {
      errShown = String.from(want.view());
      var shownText = String.from(if want.len() > 110usize { want.slice(0usize, 110usize) } else { want.view() });
      if want.len() > 0usize {
        match &mut errCard { case var &mut Some(ec) { if ec.text.len() > 0usize || true { ec.text = shownText; ec.ok = false; } } else {} }
      }
    }
    if (cs || cr) && haveIncubator { self.reapply(device, renderer, cs); }
  }

  fn reapply(self: &mut, device: &mut Device, renderer: &mut Renderer, incubatorChanged: bool) {
    if incubatorChanged {
      // [browser] roots, [panel.*] places, [shelf.*] slots
      if incubatorGood.roots.len() > 0usize { browseRoot = String.from(incubatorGood.roots[0usize].view()); }
      browseCfg = false; reportCfg = false;
      var pn = 0usize;
      // incubator.toml's places, then room.toml's (what Jon moved wins)
      var allp = List[PanelCfg]();
      var sp = 0usize;
      while sp < incubatorGood.panels.len() { let c = &incubatorGood.panels[sp]; allp.push(PanelCfg(c.id.clone(), c.place.clone(), c.yaw, c.hasYaw, c.width, c.hasWidth)); sp = sp + 1usize; }
      sp = 0usize;
      while sp < roomGood.panels.len() { let c = &roomGood.panels[sp]; allp.push(PanelCfg(c.id.clone(), c.place.clone(), c.yaw, c.hasYaw, c.width, c.hasWidth)); sp = sp + 1usize; }
      while pn < allp.len() {
        let pc = &allp[pn];
        var pl = Place(0u32, 0u32, 0., 0., 0.);
        let has = pc.place.len() > 0usize && parsePlace(pc.place.view(), &mut pl);
        let yw = if pc.hasYaw { f32.from(i32.from(pc.yaw)) * PI / 180. } else { 0. };
        if pc.id.view() == "browser" {
          if has { browseCfg = true; browseCfgPos = Vec3(pl.x, 0., pl.z); browseCfgYaw = if pc.hasYaw { yw } else { atan2(0. - pl.x, 0. - pl.z) }; }
          else if pc.hasYaw { browseCfg = true; browseCfgPos = Vec3(0. - 3.4, 0., 0. - 0.8); browseCfgYaw = yw; }
        } else if pc.id.view() == "report" {
          if has { reportCfg = true; reportCfgPos = Vec3(pl.x, 0., pl.z); reportCfgYaw = if pc.hasYaw { yw } else { PI * 0.5 }; }
          else if pc.hasYaw { reportCfg = true; reportCfgPos = Vec3(0. - 3.5, 0., 0.); reportCfgYaw = yw; }
        } else { print <- "incubator: [panel."; printStr(pc.id.view()); print <- "] is not a panel the room has (browser, report)\n"; }
        pn = pn + 1usize;
      }
      slotsBack = 16u32; slotsSide = 8u32;
      pn = 0usize;
      while pn < incubatorGood.shelves.len() {
        let sc = &incubatorGood.shelves[pn];
        if sc.hasSlots && sc.slots >= 0i64 {
          let n = u32.from(i32.from(sc.slots));
          if sc.wall.view() == "back" { slotsBack = if n > 16u32 { 16u32 } else { n }; } else { slotsSide = if n > 8u32 { 8u32 } else { n }; }
        }
        pn = pn + 1usize;
      }
      if incubatorGood.ringCm > 0i64 || incubatorGood.floatCm > 0i64 {
        if incubatorGood.ringCm > 0i64 { ringRadius = f32.from(i32.from(incubatorGood.ringCm)) / 100.; }
        if incubatorGood.floatCm > 0i64 { floatHeight = f32.from(i32.from(incubatorGood.floatCm)) / 100.; }
        var q = 0usize;
        while q < items.len() { if items[q].onTable && applied { self.startFlight(q); } q = q + 1usize; }
      }
      if incubatorGood.lineFile.len() > 0usize && !sameText(incubatorGood.lineFile.view(), lineFileV.view()) {
        lineFileV = String.from(incubatorGood.lineFile.view());
        lineText = String();
      }
      self.rebuildMenus(device);
    }
    let eff = overlay(&incubatorGood, &roomGood);
    let first = !applied;
    self.applyCfg(&eff, applied);
    self.applyExtra(device, renderer, &eff);
    self.applyZones(device);
    self.syncMarkers(device);
    if first {
      // the pages the room had open, to be opened one at a time (each costs a document panel)
      var r = 0usize;
      while r < roomGood.pages.len() {
        let g = &roomGood.pages[r];
        restoreQ.push(PageCfg(g.id.clone(), g.src.clone(), g.place.clone(), g.at.clone()));
        var num = 0u32;
        if g.id.len() > 1usize && cfgDigits(g.id.slice(1usize, g.id.len()), &mut num) && num > pgSerial { pgSerial = num; }
        r = r + 1usize;
      }
      // pages incubator.toml names ([page.ID], e.g. Penny's prompts as a tree beside the workbench) stand too, unless the room has the id
      var sg = 0usize;
      while sg < incubatorGood.pages.len() {
        let g = &incubatorGood.pages[sg];
        var dup = false;
        var q = 0usize;
        while q < roomGood.pages.len() { if roomGood.pages[q].id.view() == g.id.view() { dup = true; } q = q + 1usize; }
        if !dup { restoreQ.push(PageCfg(g.id.clone(), g.src.clone(), g.place.clone(), g.at.clone())); }
        sg = sg + 1usize;
      }
      restoreAt = nowMs() + 1500u64;
    }
    // where the palette was left (room.toml): floating there; none: on the hand
    if grabKind != 5u32 {
      var pp = Place(0u32, 0u32, 0., 0., 0.);
      if roomGood.palPlace.len() > 0usize && parsePlace(roomGood.palPlace.view(), &mut pp) && pp.kind == 3u32 {
        pal.docked = false; pal.floatPos = Vec3(pp.x, pp.y, pp.z);
      } else { pal.docked = true; }
    }
    applied = true;
  }

  // Projects the building does not have, whose source is a document, an address or a folder: they appear as pages and markers,
  // and leave when the file drops them
  fn applyExtra(self: &mut, device: &mut Device, renderer: &mut Renderer, eff: &List[EffProj]) {
    applying = true;
    var wantIds = List[String]();
    var e = 0usize;
    while e < eff.len() {
      let pj = &incubatorGood.projects[eff[e].pi];
      if self.itemById(pj.id.view()) < 0 {
        let src = pj.source.view();
        var isPage = false;
        var target = String();
        if startsWithText(src, "doc:") { isPage = true; target = String.from(src.slice(4usize, src.len())); }
        else if startsWithText(src, "url:") { isPage = true; target = String.from(src.slice(4usize, src.len())); }
        else if startsWithText(src, "web:") { isPage = true; target = String.from(src.slice(4usize, src.len())); }
        var shown = if pj.name.len() > 0usize { String.from(pj.name.view()) } else { String.from(pj.id.view()) };
        if pj.owner.len() > 0usize { shown.append(" - "); shown.append(pj.owner.view()); }
        if isPage {
          wantIds.push(pj.id.clone());
          var at = -1;
          var q = 0usize;
          while q < pgs.len() { if pgs[q].proj && pgs[q].id.view() == pj.id.view() && !pgs[q].gone { at = i32.from(q); } q = q + 1usize; }
          if at >= 0 && pgs[usize.from(u32.from(at))].src.view() != target.view() {
            self.closePage(usize.from(u32.from(at)));
            at = -1;
          }
          if at < 0 {
            at = self.openPageAs(device, renderer, target.view(), pj.id.view(), true);
            print <- "incubator: project '"; printStr(pj.id.view()); print <- "' appears as a page\n";
          }
          if at >= 0 {
            let a = usize.from(u32.from(at));
            if pgs[a].title.text.view() != shown.view() {
              (&mut pgs[a]).title.text = shown.clone();
              (&mut pgs[a]).title.size = fitSize(shown.len(), 56.);
              (&mut pgs[a]).title.ok = false;
            }
            if pgs[a].placeKey.view() != eff[e].place.view() {
              (&mut pgs[a]).placeKey = eff[e].place.clone();
              self.placeProjPage(a, eff[e].place.view());
            }
          }
        } else if startsWithText(src, "folder:") {
          wantIds.push(pj.id.clone());
          let path = src.slice(7usize, src.len());
          var at = -1;
          var q = 0usize;
          while q < markers.len() { if markers[q].proj && markers[q].id.view() == pj.id.view() { at = i32.from(q); } q = q + 1usize; }
          var row = 0usize;
          q = 0usize;
          while q < markers.len() { if markers[q].place.len() == 0usize { row = row + 1usize; } q = q + 1usize; }
          let made = self.makeMarker(device, pj.id.view(), shown.view(), path, eff[e].place.view(), false, true, row);
          if at < 0 { markers.push(made); print <- "incubator: project '"; printStr(pj.id.view()); print <- "' appears as a marker\n"; }
          else if markers[usize.from(u32.from(at))].path.view() != path || markers[usize.from(u32.from(at))].place.view() != eff[e].place.view() || markers[usize.from(u32.from(at))].name.view() != shown.view() {
            markers.set(usize.from(u32.from(at)), made);
          }
        }
      }
      e = e + 1usize;
    }
    // the ones the file dropped leave
    var i = 0usize;
    while i < pgs.len() {
      if pgs[i].proj && !pgs[i].gone {
        var keep = false;
        var w = 0usize;
        while w < wantIds.len() { if wantIds[w].view() == pgs[i].id.view() { keep = true; } w = w + 1usize; }
        if !keep { print <- "incubator: project '"; printStr(pgs[i].id.view()); print <- "' left the file: its page goes\n"; self.closePage(i); }
      }
      i = i + 1usize;
    }
    var m = markers.len();
    while m > 0usize {
      m = m - 1usize;
      if markers[m].proj {
        var keep = false;
        var w = 0usize;
        while w < wantIds.len() { if wantIds[w].view() == markers[m].id.view() { keep = true; } w = w + 1usize; }
        if !keep { print <- "incubator: project '"; printStr(markers[m].id.view()); print <- "' left the file: its marker goes\n"; var dead = markers.swapRemove(m); }
      }
    }
    applying = false;
  }

  // Where a project's page stands, from its place text
  fn placeProjPage(self: &mut, a: usize, place: &str) {
    var pl = Place(0u32, 0u32, 0., 0., 0.);
    (&mut pgs[a]).shelved = false;
    (&mut pgs[a]).free = false;
    if place.len() > 0usize && parsePlace(place, &mut pl) {
      if pl.kind == 3u32 { (&mut pgs[a]).free = true; (&mut pgs[a]).toPos = Vec3(pl.x, 0., pl.z); }
      else if pl.kind == 0u32 {
        let s = Incubator.slotPos(pl.idx);
        let out = ringRadius + 1.1;
        (&mut pgs[a]).free = true;
        (&mut pgs[a]).toPos = Vec3(s.x * out / ringRadius, 0., s.z * out / ringRadius);
      } else { (&mut pgs[a]).shelved = true; (&mut pgs[a]).shelfAt = self.pgShelfFree(); }
    }
    if !pgs[a].shelved && !pgs[a].free { (&mut pgs[a]).born = self.newBorn(); }
    self.retarget();
  }

  // The action's colour class (and so its chip's picture)
  fn actionClass(a: &str, known: bool) u32 {
    if !known { return 7u32; }
    if a == "bring" { return 1u32; }
    if a == "talk" { return 2u32; }
    if a == "back" || a == "forward" { return 3u32; }
    if a == "files" { return 4u32; }
    if a.len() >= 5usize && (a.slice(0usize, 5usize) == "step:" || a == "play" || a == "restart" || a == "legend" || a == "follow" || a == "timing") { return 5u32; }
    if a.len() >= 9usize && a.slice(0usize, 9usize) == "scenario:" { return 5u32; }
    if a == "reload" || a.len() >= 4usize && (a.slice(0usize, 4usize) == "say:" || a.slice(0usize, 4usize) == "link") { return 6u32; }
    0u32
  }

  // The pool's picture for this text in this class: made once, shared
  fn poolFor(self: &mut, l: &mut Labeller, device: &mut Device, text: &str, cls: u32) usize {
    var key = String.from(text);
    key.append("|");
    key.append(numText(i64.from(cls)).view());
    var i = 0usize;
    while i < chipKeys.len() { if chipKeys[i].view() == key.view() { return i; } i = i + 1usize; }
    let bgs = [0x2a5d9fffu32, 0x2f8a4fffu32, 0x8a4fa8ffu32, 0x5a6b7affu32, 0xb06a1affu32, 0x1f7a7affu32, 0x7a5a2affu32, 0x6a6a6affu32];
    var w = 0.03 * f32.from(u32.from(text.len()));
    if w < 0.24 { w = 0.24; }
    if w > 0.5 { w = 0.5; }
    chips.push(textLabel(l, device, format, text, bgs[usize.from(cls)], if cls == 7u32 { 0xc8c8c8ffu32 } else { 0xffffffffu32 }, 46., w));
    chipKeys.push(key);
    chips.len() - 1usize
  }

  // Each project's chips: from its [project.ID.menu.N] tables, or the default menu
  fn rebuildMenus(self: &mut, device: &mut Device) {
    var lab: Option[Labeller] = None;
    lab <-> labeller;
    match &mut lab {
      case var &mut Some(l) {
        var k = 0usize;
        while k < items.len() {
          var menu = defaultMenu(if items[k].isApp { 2u32 } else if items[k].page { 1u32 } else { 0u32 });
          var pi = 0usize;
          while pi < incubatorGood.projects.len() {
            if incubatorGood.projects[pi].id.view() == items[k].id.view() && incubatorGood.projects[pi].menu.len() > 0usize {
              menu = List[MenuCfg]();
              var m = 0usize;
              while m < incubatorGood.projects[pi].menu.len() {
                let mc = &incubatorGood.projects[pi].menu[m];
                menu.push(MenuCfg(String.from(mc.label.view()), String.from(mc.action.view()), String.from(mc.key.view())));
                m = m + 1usize;
              }
            }
            pi = pi + 1usize;
          }
          var es = List[ChipEntry]();
          var m = 0usize;
          while m < menu.len() {
            let known = knownAction(menu[m].action.view());
            if !known {
              print <- "incubator: menu '"; printStr(menu[m].label.view()); print <- "' of "; printStr(items[k].id.view());
              print <- ": unknown action '"; printStr(menu[m].action.view()); print <- "' (greyed)\n";
            }
            let pool = self.poolFor(l, device, menu[m].label.view(), Incubator.actionClass(menu[m].action.view(), known));
            es.push(ChipEntry(String.from(menu[m].label.view()), String.from(menu[m].action.view()), known, pool));
            m = m + 1usize;
          }
          (&mut items[k]).menu = es;
          k = k + 1usize;
        }
      }
      else {}
    }
    labeller <-> lab;
  }

  fn vacate(self: &mut, k: usize) {
    if items[k].free { return; }
    let me = i32.from(k);
    let i = usize.from(items[k].idx);
    if items[k].onTable { if *tableItem[i] == me { tableItem.set(i, NO_ITEM); } }
    else { if *shelfItem[i] == me { shelfItem.set(i, NO_ITEM); } }
  }

  // Item o is in the way of one being placed: it goes to a free shelf, in flight (not to 'avoid')
  fn displace(self: &mut, o: usize, avoid: i32) {
    self.startFlight(o);
    self.vacate(o);
    var j = -1;
    let h = i32.from(items[o].home);
    if h != avoid && *shelfItem[usize.from(u32.from(h))] == NO_ITEM { j = h; }
    var q = 0;
    while j < 0 && q < 24 {
      if q != avoid && *shelfItem[usize.from(u32.from(q))] == NO_ITEM { j = q; }
      q = q + 1;
    }
    (&mut items[o]).zlevel = 0u32;
    (&mut items[o]).free = false;
    (&mut items[o]).onTable = false;
    if j >= 0 {
      (&mut items[o]).idx = u32.from(j);
      shelfItem.set(usize.from(u32.from(j)), i32.from(o));
    }
    print <- "incubator: "; printStr(items[o].name.view()); print <- " makes way, to the shelf\n";
  }

  fn moveItem(self: &mut, k: usize, pl: &Place, animate: bool) {
    if animate { self.startFlight(k); }
    self.vacate(k);
    (&mut items[k]).zlevel = 0u32;
    if pl.kind == 3u32 {
      (&mut items[k]).free = true;
      (&mut items[k]).freePos = Vec3(pl.x, pl.y, pl.z);
      (&mut items[k]).onTable = false;
    } else {
      let onT = pl.kind == 0u32;
      let idx = if pl.kind == 2u32 { 16u32 + pl.idx } else { pl.idx };
      let ix = usize.from(idx);
      let occ = if onT { *tableItem[ix] } else { *shelfItem[ix] };
      if occ != NO_ITEM && occ != i32.from(k) { self.displace(usize.from(u32.from(occ)), if onT { -1 } else { i32.from(idx) }); }
      (&mut items[k]).free = false;
      (&mut items[k]).onTable = onT;
      (&mut items[k]).idx = idx;
      if onT { tableItem.set(ix, i32.from(k)); } else { shelfItem.set(ix, i32.from(k)); }
    }
    if !animate {
      (&mut items[k]).pos = self.dest(k);
      (&mut items[k]).scale = self.destScale(k);
      (&mut items[k]).flight = 1.;
      (&mut items[k]).shade = if items[k].onTable { 1. } else { 0. };
    }
  }

  // Make the room what the two files say: an item whose place, turn or size differs moves there (in flight when 'animate')
  fn applyCfg(self: &mut, eff: &List[EffProj], animate: bool) {
    applying = true;
    var want = List[Place]();
    var move = List[bool]();
    var who = List[i32]();
    var e = 0usize;
    while e < eff.len() {
      let id = incubatorGood.projects[eff[e].pi].id.clone();
      let k = self.itemById(id.view());
      var pl = Place(0u32, 0u32, 0., 0., 0.);
      var differs = false;
      if k < 0 {
        print <- "incubator: project '"; printStr(id.view()); print <- "' is not in this building (ignored)\n";
      } else {
        let ku = usize.from(u32.from(k));
        if eff[e].place.len() > 0usize && parsePlace(eff[e].place.view(), &mut pl) {
          differs = !sameText(self.placeText(ku).view(), eff[e].place.view());
          if differs { print <- "incubator: "; printStr(items[ku].name.view()); print <- " moves to "; printStr(eff[e].place.view()); print <- ", at "; print <- unixMs(); print <- " ms\n"; }
        }
      }
      want.push(pl); move.push(differs); who.push(k);
      // first lift every mover off its slot, so that a swap needs no third place
      if differs { self.vacate(usize.from(u32.from(*who[who.len() - 1usize]))); }
      e = e + 1usize;
    }
    e = 0usize;
    while e < eff.len() {
      let k = *who[e];
      if k >= 0 {
        let ku = usize.from(u32.from(k));
        if *move[e] { self.moveItem(ku, &want[e], animate); }
        let pi = eff[e].pi;
        if incubatorGood.projects[pi].name.len() > 0usize && !sameText(incubatorGood.projects[pi].name.view(), items[ku].name.view()) {
          (&mut items[ku]).name = String.from(incubatorGood.projects[pi].name.view());
        }
        // the label: the name, and who answers for the project
        var shown = String.from(items[ku].name.view());
        if incubatorGood.projects[pi].owner.len() > 0usize { shown.append(" - "); shown.append(incubatorGood.projects[pi].owner.view()); }
        if !sameText(shown.view(), items[ku].label.text.view()) {
          (&mut items[ku]).label.text = shown.clone();
          (&mut items[ku]).label.ok = false;
          if incubatorGood.projects[pi].owner.len() > 0usize {
            (&mut items[ku]).label.w = 1.1;
            (&mut items[ku]).label.h = 1.1 / 4.;
            (&mut items[ku]).label.size = fitSize(shown.len(), 50.);
          } else {
            (&mut items[ku]).label.w = 0.56;
            (&mut items[ku]).label.h = 0.56 / 4.;
            (&mut items[ku]).label.size = 50.;
          }
        }
        if eff[e].hasYaw {
          let y = f32.from(i32.from(eff[e].yaw)) * PI / 180.;
          if y != items[ku].yawShelf { (&mut items[ku]).yawShelf = y; print <- "incubator: "; printStr(items[ku].id.view()); print <- " turned to "; print <- eff[e].yaw; print <- " degrees\n"; }
        }
        if eff[e].hasScale {
          let m = f32.from(i32.from(eff[e].scale)) / 100.;
          if m != items[ku].mul {
            if animate && !*move[e] { self.startFlight(ku); }
            (&mut items[ku]).mul = m;
            if !animate { (&mut items[ku]).scale = self.destScale(ku); }
            print <- "incubator: "; printStr(items[ku].id.view()); print <- " scaled to "; print <- eff[e].scale; print <- " percent\n";
          }
        }
      }
      e = e + 1usize;
    }
    applying = false;
  }

  // The room moved item k by itself (Jon): remember it in room.toml (a second after the last move) and tell the session
  fn noteMoved(self: &mut, k: usize) {
    if applying { return; }
    var pi = 0usize;
    var found = false;
    while pi < roomGood.projects.len() { if roomGood.projects[pi].id.view() == items[k].id.view() { found = true; break; } pi = pi + 1usize; }
    if !found { roomGood.projects.push(newProj(items[k].id.view())); pi = roomGood.projects.len() - 1usize; }
    roomGood.projects[pi].place = self.placeText(k);
    roomGood.projects[pi].at = isoUtc(unixMs());
    writeAt = nowMs() + 1000u64;
    var line = String.from("moved ");
    line.append(items[k].name.view());
    line.append(" to ");
    var words = self.placeText(k);
    var w = String();
    var c = 0usize;
    while c < words.len() { w.append(if words[c] == ':' { " " } else { words.slice(c, c + 1usize) }); c = c + 1usize; }
    line.append(w.view());
    outLines.push(line);
  }

  fn writeRoom(self: &mut) {
    writeAt = 0u64;
    let text = roomText(&roomGood);
    if writeAtomic(cfgDir.view(), "room.toml", text.view()) {
      roomSeen = String.from(text.view());
      moves = moves + 1u32;
      print <- "incubator: room.toml written, "; print <- roomGood.projects.len(); print <- " projects\n";
    }
  }

  // Lines for the bridge, taken by the shell
  pub fn takeLines(self: &mut) List[String] {
    let l = outLines.clone();
    outLines = List[String]();
    l
  }

  pub fn takeSay(self: &mut) String { let s = sayWant.clone(); sayWant = String(); s }
  pub fn takeLink(self: &mut) String { let s = linkWant.clone(); linkWant = String(); s }

  // A menu action on the selection (the fixed vocabulary)
  pub fn doAction(self: &mut, a: &str, v: &Fly) bool {
    if sel < 0 { return false; }
    if a == "zoom" { return self.act(2u32, v); }
    if a == "zoomout" { return self.act(5u32, v); }
    if a == "shelve" { return self.act(0u32, v); }
    if a == "bring" { return self.act(1u32, v); }
    if a == "open" { return self.act(3u32, v); }
    if a == "talk" { return self.act(4u32, v); }
    if a == "back" { return self.act(6u32, v); }
    if a == "forward" { return self.act(7u32, v); }
    if a == "files" { return self.act(8u32, v); }
    if a == "reload" { cfgPoll = 0u64; incubatorSeen = String(); roomSeen = String(); return true; }
    if a.len() > 5usize && a.slice(0usize, 5usize) == "link:" { linkWant = String.from(a.slice(5usize, a.len())); return true; }
    if a.len() > 4usize && a.slice(0usize, 4usize) == "say:" { sayWant = String.from(a.slice(4usize, a.len())); return true; }
    self.awAction(a)
  }

  fn awAction(self: &mut, a: &str) bool {
    var did = false;
    match &mut aw {
      case var &mut Some(x) {
        did = true;
        if a == "step:+1" { stepForward(&mut x.app); }
        else if a == "step:-1" { stepBack(&mut x.app); }
        else if a == "play" { togglePlay(&mut x.app); }
        else if a == "restart" { restart(&mut x.app); }
        else if a == "legend" { x.app.legend = !x.app.legend; }
        else if a == "follow" { x.app.follow = !x.app.follow; }
        else if a == "timing" { toggleTrue(&mut x.app); }
        else if a == "scenario:+1" { setScenario(&mut x.app, (x.app.sc + 1usize) % SC_N); }
        else if a == "scenario:-1" { setScenario(&mut x.app, (x.app.sc + SC_N - 1usize) % SC_N); }
        else if a.len() > 9usize && a.slice(0usize, 9usize) == "scenario:" {
          var n = 0u32;
          if cfgDigits(a.slice(9usize, a.len()), &mut n) && usize.from(n) < SC_N { setScenario(&mut x.app, usize.from(n)); } else { did = false; }
        }
        else { did = false; }
        if did {
          print <- "incubator: walk: "; printStr(SC_NAME[x.app.sc]); print <- ", step "; print <- x.app.cur; print <- " of "; print <- x.app.count;
          print <- (if x.app.playing { ", playing" } else { "" }); print <- "\n";
        }
      }
      else {}
    }
    did
  }

  // ---- the architecture walk, a ring project ----

  fn awTick(self: &mut, dt: f32) {
    let k = self.itemById("archwalk");
    if k < 0 { return; }
    let live = items[usize.from(u32.from(k))].onTable || items[usize.from(u32.from(k))].free;
    match &mut aw {
      case var &mut Some(x) {
        x.live = live;
        if live { tick(&mut x.app, dt); x.app.pend = NONE; x.app.blink = 0.; }
      }
      else {}
    }
  }

  // The walk's solids into the frame's draw list (swapped in and out of the walk, which adds to it); its words wait for 'draw'
  pub fn collectAw(self: &mut, list: &mut DrawList, eye: Vec3) {
    let k = self.itemById("archwalk");
    if k < 0 { return; }
    let ku = usize.from(u32.from(k));
    let e = self.eff(ku);
    let ys = items[ku].yaw;
    let base = Mat4.fromTrs(Vec3(e.x, e.y, e.z), Quat.angleAxis(ys, Vec3(0., 1., 0.)), Vec3(e.w, e.w, e.w)) * Mat4.fromTranslation(Vec3(0., 0., 2.0));
    match &mut aw {
      case var &mut Some(x) {
        x.out.jobs.clear();
        if !x.live { return; }
        x.out.base = base;
        x.out.list <-> *list;
        let head = base.inverse() * eye;
        drawWorld(&mut x.out, &x.look, &mut x.tc, &x.app, head);
        x.out.list <-> *list;
      }
      else {}
    }
  }

  fn drawAwText(self: &mut, device: &mut Device, encoder: &mut CommandEncoder, target: &Texture, depth: &Texture, vp: Mat4) {
    let eyeNow = eyeIx;
    match &mut aw {
      case var &mut Some(x) {
        if !x.live { return; }
        if eyeNow == 0u32 {
          awSetJobs(&mut x.text0, device, &x.tc, &x.styles, &x.out.jobs, vp, &mut x.shown0);
          x.text0.renderWorld(encoder, target, depth);
        } else {
          awSetJobs(&mut x.text1, device, &x.tc, &x.styles, &x.out.jobs, vp, &mut x.shown1);
          x.text1.renderWorld(encoder, target, depth);
        }
      }
      else {}
    }
  }

  // A click on the walk's miniature (it has no part in the world to be picked): selects it
  pub fn clickApp(self: &mut, eye: Vec3, dir: Vec3) bool {
    let k = self.itemById("archwalk");
    if k < 0 { return false; }
    let ku = usize.from(u32.from(k));
    if !items[ku].onTable && !items[ku].free { return false; }
    let e = self.eff(ku);
    let r = 4.0 * e.w;
    let c = Vec3(e.x, e.y + 1.5 * e.w, e.z);
    let oc = eye - c;
    let b = oc.dot(dir);
    let disc = b * b - (oc.dot(oc) - r * r);
    if disc < 0. { return false; }
    self.select(k);
    true
  }

  // F: the browser stands to the left of the design page (the page is slot 0, dead ahead of the start spot, 2.5 m off),
  // turned toward the start spot so it does not block the page (at 'folder', or where it was); F again puts it away
  pub fn toggleBrowser(self: &mut, folder: &str, eye: Vec3, yaw: f32) {
    if browserOpen && folder.len() == 0usize { browserOpen = false; print <- "incubator: file browser closed\n"; return; }
    if !browserOpen {
      browserPos = Vec3(0. - 3.4, 0., 0. - 0.8);
      browserYaw = atan2(0. - browserPos.x, 0. - browserPos.z);
      if browseCfg { browserPos = browseCfgPos; browserYaw = browseCfgYaw; }
    }
    browserWant = if folder.len() == 0usize { String.from(browseRoot.view()) } else { String.from(folder) };
    var f = String.from(TREE_PREFIX);
    f.append(browserWant.view());
    browserWant = f;
  }

  // At start-up, while the world is still loading: the browser's panel made and its first listing drawn, hidden. Making
  // it (six font atlases and their pipelines) took 2.4 s, which fell on the frame of the first F press.
  pub fn prepareBrowser(self: &mut, device: &mut Device, renderer: &mut Renderer) {
    var f = String.from(TREE_PREFIX);
    f.append(browseRoot.view());
    match DocPanel.create(device, renderer, format, f.view(), 0.) {
      case let Some(p) { browserPanel = Some[DocPanel](p); }
      case is None {}
    }
    // the browser is a standing panel: up in its place from the start
    browserPos = Vec3(0. - 3.4, 0., 0. - 0.8);
    browserYaw = atan2(0. - browserPos.x, 0. - browserPos.z);
    if browseCfg { browserPos = browseCfgPos; browserYaw = browseCfgYaw; }
    browserOpen = true;
  }

  fn tickBrowser(self: &mut, device: &mut Device, renderer: &mut Renderer) {
    if browserWant.len() > 0usize {
      let tB0 = sdl.GetPerformanceCounter();
      match &mut browserPanel {
        case var &mut Some(p) {
          // made ahead (prepareBrowser) and still showing the folder asked for: nothing to load, so no frame pays for it
          if !p.showing(browserWant.view()) { let bw = browserWant.clone(); p.go(device, renderer, bw.view(), ""); }
        }
        case is None { browserPanel = DocPanel.create(device, renderer, format, browserWant.view(), 0.); }
      }
      print <- "incubator: file browser opened at "; printStr(browserWant.view()); print <- "\n";
      browserWant = String();
      browserOpen = true;
      print <- "incubator: opening the browser took "; print <- f64.from((sdl.GetPerformanceCounter() - tB0) * 1000000u64 / sdl.GetPerformanceFrequency()) / 1000.; print <- " ms\n";
    }
    if browserOpen {
      match &mut browserPanel {
        case var &mut Some(p) {
          let tB1 = sdl.GetPerformanceCounter();
          p.tick(device, renderer);
          let us = (sdl.GetPerformanceCounter() - tB1) * 1000000u64 / sdl.GetPerformanceFrequency();
          if us > 3000u64 { print <- "incubator: browser tick took "; print <- f64.from(us) / 1000.; print <- " ms\n"; }
        }
        else {}
      }
    }
  }

  // Each frame the browser is open: it learns the document panel's history, and any file it was asked to open comes back
  pub fn syncBrowser(self: &mut, device: &mut Device, renderer: &mut Renderer, history: &List[String], serial: u32) String {
    var out = String();
    if !browserOpen { return out; }
    match &mut browserPanel {
      case var &mut Some(p) {
        if p.recentSerial != serial {
          p.recentSerial = serial;
          p.recent = List[String]();
          var i = 0usize;
          while i < history.len() { p.recent.push(String.from(history[i].view())); i = i + 1usize; }
          p.refreshListing(device, renderer);
        }
        if p.outOpen.len() > 0usize { out = String.from(p.outOpen.view()); p.outOpen = String(); }
      }
      else {}
    }
    out
  }

  // The test hook: follow link n of the browser's page
  pub fn browserLink(self: &mut, n: usize) {
    match &mut browserPanel {
      case var &mut Some(p) { p.requestNth(n); }
      else {}
    }
  }

  // The test hooks for the simulator's fake hand (w 0: not there): where the chip for action 'a' stands, the k'th link on show in the
  // page, the k'th link on show in the file browser
  pub fn chipPoint(self: &, a: u32, view: Vec3) Vec4 {
    if !self.chipsShown(nowMs()) || chipAnchor != sel { return Vec4(0., 0., 0., 0.); }
    let list = self.chipList();
    var k = 0usize;
    while k < list.len() {
      if *list[k] == a {
        let f = self.chipFrame(k, list.len(), view);
        return Vec4(f.x, f.y, f.z, 1.);
      }
      k = k + 1usize;
    }
    Vec4(0., 0., 0., 0.)
  }

  pub fn pagePoint(self: &, page: &Option[DocPanel], k: usize) Vec4 {
    match page {
      case let Some(p) {
        let l = p.linkPoint(k);
        if l.w < 0.5 { return l; }
        let w = self.pageModel() * Vec3(l.x, l.y, 0.);
        return Vec4(w.x, w.y, w.z, 1.);
      }
      else {}
    }
    Vec4(0., 0., 0., 0.)
  }

  pub fn browserPoint(self: &, k: usize) Vec4 {
    if !browserOpen { return Vec4(0., 0., 0., 0.); }
    match &browserPanel {
      case let Some(p) {
        let l = p.linkPoint(k);
        if l.w < 0.5 { return l; }
        let w = self.browserModel() * Vec3(l.x, l.y, 0.);
        return Vec4(w.x, w.y, w.z, 1.);
      }
      else {}
    }
    Vec4(0., 0., 0., 0.)
  }

  // ---- pages and parked folders ----

  fn mkLabel(self: &, device: &mut Device, text: &str, bg: u32, ink: u32, size: f32, w: f32, h: f32) Label {
    Label(PagePass.createDepth(device, format), w, h, false, String.from(text), bg, ink, size, 22., false, 0., false, false, 1.)
  }

  // A board strip card: its text as large as the card holds (one or two lines, see cardSize)
  fn mkCard(self: &, device: &mut Device, text: &str, bg: u32, ink: u32, w: f32, h: f32) Label {
    var lb = self.mkLabel(device, text, bg, ink, cardSize(text.len()), w, h);
    lb.top = cardTop(text.len(), lb.size);
    lb
  }

  // The chips over a page (close, shelve, grab) and the browser's (park): made once
  fn ensureChips(self: &mut, device: &mut Device) {
    if pgChips.len() > 0usize { return; }
    pgChips.push(self.mkLabel(device, "park", 0xc08a20ffu32, 0xffffffffu32, 56., PG_CHIP_W, PG_CHIP_H));
    // the general browser's: new tab, close tab, the address strip
    pgChips.push(self.mkLabel(device, "+", 0x3a8a58ffu32, 0xffffffffu32, 96., 0.2, 0.1));
    pgChips.push(self.mkLabel(device, "x", 0xb3261effu32, 0xffffffffu32, 96., 0.2, 0.1));
    pgChips.push(self.mkLabel(device, "address", 0xf6f6f0ffu32, 0x1c1c1cffu32, 40., 1.0, 0.2));
  }

  // ---- the general browser: tabs (Jon, 11 Nov), an address strip, http links opening as tabs ----

  // The tab pages, by number
  fn tabList(self: &) List[usize] {
    var order = List[usize]();
    var i = 0usize;
    while i < pgs.len() {
      if pgs[i].tab && !pgs[i].gone {
        var at = order.len();
        while at > 0usize && pgs[*order[at - 1usize]].tabNo > pgs[i].tabNo { at = at - 1usize; }
        order.insert(at, i);
      }
      i = i + 1usize;
    }
    order
  }

  fn tabHidden(self: &, i: usize) bool { pgs[i].tab && pgs[i].tabNo != tabCur }

  // The tab shown, or the number of pages if none
  fn tabVisible(self: &) usize {
    var i = 0usize;
    while i < pgs.len() { if pgs[i].tab && !pgs[i].gone && pgs[i].tabNo == tabCur { return i; } i = i + 1usize; }
    pgs.len()
  }

  // Tab page 'to' takes the place of the shown tab and becomes the shown one
  fn showTab(self: &mut, to: usize) {
    let from = self.tabVisible();
    if from < pgs.len() && from != to {
      let p = pgs[from].pos; let y = pgs[from].yaw; let s = pgs[from].sc;
      (&mut pgs[to]).pos = p; (&mut pgs[to]).toPos = p; (&mut pgs[to]).fromPos = p;
      (&mut pgs[to]).yaw = y; (&mut pgs[to]).toYaw = y; (&mut pgs[to]).fromYaw = y;
      (&mut pgs[to]).sc = s; (&mut pgs[to]).toSc = s; (&mut pgs[to]).fromSc = s;
      (&mut pgs[to]).fly = 1.; (&mut pgs[to]).free = true; (&mut pgs[to]).shelved = false;
    }
    self.blurWeb();
    addrEdit = false;
    tabCur = pgs[to].tabNo;
    print <- "tabs: showing "; printStr(pgs[to].src.view()); print <- "\n";
  }

  fn switchTab(self: &mut, slot: usize) {
    let order = self.tabList();
    if slot < order.len() { self.showTab(*order[slot]); }
  }

  // A web address wanted as a tab (a link of a document, the "+" tab, a test hook): a new tab, shown
  fn openTab(self: &mut, device: &mut Device, renderer: &mut Renderer, src: &str) {
    var pos = Vec3(2.0, 0., 0. - 2.0);
    var yaw = Incubator.faceOrigin(pos);
    var sc: f32 = 1.;
    let vi = self.tabVisible();
    if vi < pgs.len() { pos = pgs[vi].pos; yaw = pgs[vi].yaw; sc = pgs[vi].sc; }
    self.tabNext = true;
    let n = self.openPageAs(device, renderer, src, "", false);
    self.tabNext = false;
    if n < 0 { return; }
    let u = usize.from(u32.from(n));
    self.blurWeb();
    (&mut pgs[u]).pos = pos; (&mut pgs[u]).toPos = pos; (&mut pgs[u]).fromPos = pos;
    (&mut pgs[u]).yaw = yaw; (&mut pgs[u]).toYaw = yaw; (&mut pgs[u]).fromYaw = yaw;
    (&mut pgs[u]).sc = sc; (&mut pgs[u]).toSc = sc; (&mut pgs[u]).fromSc = sc;
    (&mut pgs[u]).fly = 1.; (&mut pgs[u]).free = true;
    tabCur = pgs[u].tabNo;
    addrEdit = false;
    print <- "tabs: opened "; printStr(src); print <- " as tab "; print <- pgs[u].tabNo; print <- ", "; print <- self.tabList().len(); print <- " tabs\n";
  }

  fn closeTab(self: &mut) {
    let vi = self.tabVisible();
    if vi < pgs.len() { self.closePage(vi); }
  }

  // Where the shown tab's chrome stands in its page's frame: the tab row above the page, the address strip below
  fn tabRect(self: &, slot: usize, count: usize) Vec4 {
    let hw = pgHalfW(true);
    let top = pgTop(true);
    let pitch = fminf(0.63, 2.2 / f32.from(u32.from(count)));
    let x0 = 0. - hw + pitch * f32.from(u32.from(slot));
    Vec4(x0, top + 0.1, x0 + pitch - 0.03, top + 0.1 + (pitch - 0.03) * 0.25)
  }
  fn tabPlusRect(self: &, count: usize) Vec4 {
    let hw = pgHalfW(true);
    let top = pgTop(true);
    let pitch = fminf(0.63, 2.2 / f32.from(u32.from(count)));
    let x0 = 0. - hw + pitch * f32.from(u32.from(count)) + 0.03;
    Vec4(x0, top + 0.1, x0 + 0.3, top + 0.25)
  }
  fn tabCloseRect(self: &, count: usize) Vec4 {
    let p = self.tabPlusRect(count);
    Vec4(p.z + 0.04, p.y, p.z + 0.34, p.w)
  }
  fn addrRect(self: &) Vec4 {
    let hw = pgHalfW(true);
    let b = pgBottom(true);
    Vec4(0. - hw, b - 0.33, 0. - hw + 1.65, b - 0.03)
  }

  // The address strip's and tab titles' pictures follow the shown tab (a few times a second)
  fn refreshTabs(self: &mut) {
    let vi = self.tabVisible();
    var i = 0usize;
    while i < pgs.len() {
      if pgs[i].tab && !pgs[i].gone {
        let want: u32 = if i == vi { 0xffffffffu32 } else { 0xc9ccd4ffu32 };
        if pgs[i].title.bg != want { (&mut pgs[i].title).bg = want; (&mut pgs[i].title).ok = false; }
        let sz = fitSize(pgs[i].title.text.len() + pgs[i].title.text.len() / 3usize, 56.);
        if (pgs[i].title.size - sz).abs() > 0.5 { (&mut pgs[i].title).size = sz; (&mut pgs[i].title).ok = false; }
      }
      i = i + 1usize;
    }
    if vi >= pgs.len() || pgChips.len() < 4usize { return; }
    var want = String();
    if addrEdit { want = addrBuf.clone(); want.append("|"); }
    else {
      var a = String();
      if ticks % 12u32 == 0u32 || pgs[vi].title.text.len() == 0usize {
        match &pgs[vi].wp { case let Some(w) { a = w.address(); } else {} }
        if a.len() > 0usize {
          var sh = pageTitle(a.view());
          if sh.len() > 1usize && sh.view()[sh.len() - 1usize] == '/' { sh = String.from(sh.view().slice(0usize, sh.len() - 1usize)); }
          if sh.view() != pgs[vi].title.text.view() {
            (&mut pgs[vi]).title.text = sh.clone(); (&mut pgs[vi]).title.size = fitSize(sh.len(), 56.); (&mut pgs[vi]).title.ok = false;
            (&mut pgs[vi]).src = a.clone();
          }
        }
      }
      want = pgs[vi].src.clone();
      if want.len() > 1usize && want.view()[want.len() - 1usize] == '/' { want = String.from(want.view().slice(0usize, want.len() - 1usize)); }
      if startsWithText(want.view(), "https://") { want = String.from(want.view().sliceFrom(8usize)); }
      else if startsWithText(want.view(), "http://") { want = String.from(want.view().sliceFrom(7usize)); }
    }
    if want.view() != addrShown.view() {
      addrShown = want.clone();
      (&mut pgChips[3usize]).text = want.clone();
      (&mut pgChips[3usize]).size = fitSize(want.len() + want.len() / 4usize, 52.);
      (&mut pgChips[3usize]).ok = false;
    }
  }

  fn addrKey(self: &mut, vk: i32) {
    if vk == 27i32 { addrEdit = false; return; }
    if vk == 8i32 {
      var k = addrBuf.len();
      while k > 0usize { k = k - 1usize; if (addrBuf.view()[k] & 0xC0u8) != 0x80u8 { break; } }
      addrBuf = String.from(addrBuf.view().slice(0usize, k));
      return;
    }
    if vk == 13i32 {
      var u = String.from(trimmedText(addrBuf.view()));
      addrEdit = false;
      if u.len() == 0usize { return; }
      if !startsWithText(u.view(), "http://") && !startsWithText(u.view(), "https://") { var h = String.from("https://"); h.append(u.view()); u = h; }
      let vi = self.tabVisible();
      if vi < pgs.len() {
        match &mut pgs[vi].wp { case var &mut Some(w) { w.open(u.view()); } else {} }
        (&mut pgs[vi]).src = u.clone();
      }
      print <- "tabs: address entered "; printStr(u.view()); print <- "\n";
    }
  }

  // A click on the shown tab's chrome (kind 20+slot a tab, 30 "+", 31 "x", 32 the address strip)
  fn tabClick(self: &mut, pu: usize, kind: u32) {
    if kind >= 20u32 && kind < 30u32 { self.switchTab(usize.from(kind - 20u32)); return; }
    if kind == 30u32 { self.wantPage("https://jondgoodwin.com"); return; }
    if kind == 31u32 { self.closeTab(); return; }
    if kind == 32u32 {
      self.blurWeb();
      addrEdit = true;
      addrBuf = String();
      print <- "tabs: address strip active\n";
    }
  }

  // A page's own chips (a pass has one set of uniforms, so each page needs its own pictures): close, shelve, grab
  fn pageChips(self: &, device: &mut Device) List[Label] {
    var c = List[Label]();
    c.push(self.mkLabel(device, "close", 0xb3261effu32, 0xffffffffu32, 56., PG_CHIP_W, PG_CHIP_H));
    c.push(self.mkLabel(device, "shelve", 0x3a78b0ffu32, 0xffffffffu32, 56., PG_CHIP_W, PG_CHIP_H));
    c.push(self.mkLabel(device, "grab", 0x3a8a58ffu32, 0xffffffffu32, 56., PG_CHIP_W, PG_CHIP_H));
    c.push(self.mkLabel(device, "back", 0x5a6a78ffu32, 0xffffffffu32, 56., PG_CHIP_W, PG_CHIP_H));
    c.push(self.mkLabel(device, "forward", 0x5a6a78ffu32, 0xffffffffu32, 56., PG_CHIP_W, PG_CHIP_H));
    c
  }

  pub fn setGaze(self: &mut, eye: Vec3, dir: Vec3) { if !handHeld { gazeEye = eye; gazeDir = dir; } }

  // The start yaw in degrees (left of the start's own facing, which is -z) that faces the V between the boards:
  // the middle of the boards' places, seen from the start spot at the origin. 0 if there are no boards.
  pub fn startFacingDeg(self: &) f32 {
    if zones.len() == 0usize { return 0.; }
    var mx: f32 = 0.;
    var mz: f32 = 0.;
    var i = 0usize;
    while i < zones.len() { mx = mx + zones[i].wantPos.x; mz = mz + zones[i].wantPos.z; i = i + 1usize; }
    let n = f32.from(i32.from(zones.len()));
    mx = mx / n; mz = mz / n;
    let zero: f32 = 0.;
    atan2(zero - mx, zero - mz) * 180. / PI
  }

  // A hand's beam holds the gaze while its grip is down (a zero direction lets go)
  pub fn setHand(self: &mut, eye: Vec3, dir: Vec3) {
    if dir.length() < 0.01 { handHeld = false; return; }
    handHeld = true; gazeEye = eye; gazeDir = dir;
  }

  // The grip went down with the beam at (eye, dir): the page under it is grabbed and follows the hand until the grip is let go
  pub fn gripGrab(self: &mut, device: &mut Device, eye: Vec3, dir: Vec3) {
    var bi = -1;
    var bt: f32 = -1.;
    var i = 0usize;
    var zbt: f32 = -1.;
    var zbi = -1;
    while i < pgs.len() {
      var k = 0u32;
      let t = self.pgHit(i, eye, dir, &mut k);
      if pgs[i].zone >= 0 {
        // a grip on a pane takes its whole board
        if t > 0. && (zbt < 0. || t < zbt) { zbt = t; zbi = pgs[i].zone; }
      }
      else if t > 0. && (bt < 0. || t < bt) { bt = t; bi = i32.from(i); }
      i = i + 1usize;
    }
    var zq = 0usize;
    while zq < zones.len() {
      let t = self.boardHit(zq, eye, dir);
      if t > 0. && (zbt < 0. || t < zbt) { zbt = t; zbi = i32.from(zq); }
      zq = zq + 1usize;
    }
    // the other things a beam can hold: the browser, the report, a folder's post, a project; the nearest of all wins
    var ok = 0u32;
    var oi = -1;
    var ot: f32 = -1.;
    if browserOpen {
      let inv = self.browserModel().inverse();
      match &browserPanel {
        case let Some(p) { let t = p.reach(inv * eye, inv.transformVector(dir)); if t > 0. && (ot < 0. || t < ot) { ot = t; ok = 1u32; } }
        else {}
      }
    }
    if reportOpen {
      let inv = self.reportModel().inverse();
      match &reportPanel {
        case let Some(p) { let t = p.reach(inv * eye, inv.transformVector(dir)); if t > 0. && (ot < 0. || t < ot) { ot = t; ok = 2u32; } }
        else {}
      }
    }
    var q = 0usize;
    while q < markers.len() {
      let t = quadHit(Incubator.faceModel(markers[q].pos, eye), Vec4(-0.36, 0., 0.36, 1.68), eye, dir);
      if t > 0. && (ot < 0. || t < ot) { ot = t; ok = 3u32; oi = i32.from(q); }
      q = q + 1usize;
    }
    var k = 0usize;
    let dn = dir.normalize();
    while k < items.len() {
      if !items[k].page && items[k].part.len() > 0usize {
        let c = items[k].pos + Vec3(0., items[k].height * items[k].scale * 0.5, 0.) - eye;
        var rr = items[k].radius * items[k].scale;
        if rr < 0.3 { rr = 0.3; }
        let tca = c.dot(dn);
        if tca > 0. && c.dot(c) - tca * tca <= rr * rr && (ot < 0. || tca < ot) { ot = tca; ok = 4u32; oi = i32.from(k); }
      }
      k = k + 1usize;
    }
    if zbi >= 0 && (ok == 0u32 || zbt < ot) { ok = 6u32; oi = zbi; ot = zbt; }
    // (the palette's tray is a thing a beam can hold, too, and is usually the nearest)
    let pt = pal.reach(eye, dir);
    if pt > 0. && (ot < 0. || pt < ot) { ot = pt; ok = 5u32; oi = -1; }
    if ok > 0u32 && (bt < 0. || ot < bt) {
      gazeEye = eye; gazeDir = dir;
      var d = ot;
      if d < 1.5 { d = 1.5; }
      if d > 8. { d = 8.; }
      if ok == 5u32 {
        d = ot;
        if d < 0.25 { d = 0.25; }
        if d > 4. { d = 4.; }
        if pal.docked { pal.floatPos = pal.anchor(); }
        pal.docked = false;
      }
      grabDist = d;
      grabKind = ok; grabIt = oi;
      if ok == 4u32 {
        let ku = usize.from(u32.from(oi));
        let here = items[ku].pos;
        self.moveItem(ku, &Place(3u32, 0u32, here.x, here.y, here.z), false);
      }
      print <- "incubator: grabbed "; print <- (if ok == 1u32 { "the file browser" } else if ok == 2u32 { "the report" } else if ok == 3u32 { "a folder post" } else if ok == 5u32 { "the palette" } else if ok == 6u32 { "a board" } else { "a project" }); print <- "\n";
      return;
    }
    if bi >= 0 { gazeEye = eye; gazeDir = dir; self.startGrab(usize.from(u32.from(bi))); }
  }

  // Each frame while the grip holds a panel, post or project: it follows the point on the floor (the height kept for a project) along the gaze
  fn followGrab(self: &mut) {
    if grabKind == 0u32 { return; }
    if grabKind == 5u32 { pal.floatPos = gazeEye + gazeDir.normalize() * grabDist; return; }
    let h = Vec3(gazeDir.x, 0., gazeDir.z);
    if h.length() < 0.05 { return; }
    let hn = h.normalize();
    let p = Vec3(gazeEye.x + hn.x * grabDist, 0., gazeEye.z + hn.z * grabDist);
    if grabKind == 1u32 { browserPos = p; browserYaw = Incubator.faceOrigin(p); browseCfg = true; browseCfgPos = p; browseCfgYaw = browserYaw; }
    else if grabKind == 2u32 { reportPos = p; reportCfg = true; reportCfgPos = p; reportCfgYaw = Incubator.faceOrigin(p); }
    else if grabKind == 3u32 { let q = usize.from(u32.from(grabIt)); if q < markers.len() { (&mut markers[q]).pos = p; } }
    else if grabKind == 6u32 {
      let q = usize.from(u32.from(grabIt));
      if q < zones.len() {
        let y = zones[q].pos.y;
        (&mut zones[q]).pos = Vec3(p.x, y, p.z);
        (&mut zones[q]).wantPos = Vec3(p.x, y, p.z);
      }
    }
    else if grabKind == 4u32 {
      let k = usize.from(u32.from(grabIt));
      if k < items.len() {
        let y = items[k].freePos.y;
        (&mut items[k]).freePos = Vec3(p.x, y, p.z);
        (&mut items[k]).pos = Vec3(p.x, y, p.z);
        (&mut items[k]).flight = 1.;
      }
    }
  }

  // The grip let go of a panel, post or project: where it stands goes to room.toml
  fn dropOther(self: &mut) {
    let kind = grabKind;
    let it = grabIt;
    grabKind = 0u32; grabIt = -1;
    if kind == 5u32 { self.palSavePlace(); return; }
    var text = String.from("at:");
    var pos = Vec3(0., 0., 0.);
    var yawDeg: i64 = 0i64;
    if kind == 1u32 { pos = browserPos; yawDeg = i64.from(i32.from(browserYaw * 180. / PI)); }
    else if kind == 2u32 { pos = reportPos; yawDeg = i64.from(i32.from(reportCfgYaw * 180. / PI)); }
    else if kind == 3u32 { let q = usize.from(u32.from(it)); if q < markers.len() { pos = markers[q].pos; } }
    else if kind == 4u32 { let k = usize.from(u32.from(it)); if k < items.len() { self.noteMoved(k); print <- "incubator: dropped a project\n"; } return; }
    else if kind == 6u32 {
      let q = usize.from(u32.from(it));
      if q >= zones.len() { return; }
      var zt = String.from("at:");
      zt.append(floatText(zones[q].pos.x).view()); zt.append(",0,"); zt.append(floatText(zones[q].pos.z).view());
      var found = false;
      var r = 0usize;
      while r < roomGood.zones.len() {
        if roomGood.zones[r].id.view() == zones[q].id.view() { roomGood.zones[r].place = zt.clone(); roomGood.zones[r].at = isoUtc(unixMs()); found = true; }
        r = r + 1usize;
      }
      if !found {
        var nz = newZoneCfg(zones[q].id.view());
        nz.place = zt.clone(); nz.at = isoUtc(unixMs());
        roomGood.zones.push(nz);
      }
      print <- "incubator: dropped board "; printStr(zones[q].id.view()); print <- " at "; printStr(zt.view()); print <- "\n";
      writeAt = nowMs() + 1000u64;
      return;
    }
    text.append(floatText(pos.x).view()); text.append(","); text.append(floatText(pos.y).view()); text.append(","); text.append(floatText(pos.z).view());
    if kind == 1u32 || kind == 2u32 {
      let id = if kind == 1u32 { "browser" } else { "report" };
      var found = false;
      var pn = 0usize;
      while pn < roomGood.panels.len() {
        if roomGood.panels[pn].id.view() == id { roomGood.panels[pn].place = text.clone(); roomGood.panels[pn].yaw = yawDeg; roomGood.panels[pn].hasYaw = true; found = true; }
        pn = pn + 1usize;
      }
      if !found { roomGood.panels.push(PanelCfg(String.from(id), text.clone(), yawDeg, true, 0i64, false)); }
    } else if kind == 3u32 {
      let q = usize.from(u32.from(it));
      if q >= markers.len() { return; }
      (&mut markers[q]).place = text.clone();
      if markers[q].proj {
        var pi = 0usize;
        var found = false;
        while pi < roomGood.projects.len() { if roomGood.projects[pi].id.view() == markers[q].id.view() { found = true; break; } pi = pi + 1usize; }
        if !found { roomGood.projects.push(newProj(markers[q].id.view())); pi = roomGood.projects.len() - 1usize; }
        roomGood.projects[pi].place = text.clone();
        roomGood.projects[pi].at = isoUtc(unixMs());
      } else {
        var found = false;
        var fi = 0usize;
        while fi < roomGood.folders.len() {
          if roomGood.folders[fi].id.view() == markers[q].id.view() { roomGood.folders[fi].place = text.clone(); roomGood.folders[fi].at = isoUtc(unixMs()); found = true; }
          fi = fi + 1usize;
        }
        if !found { roomGood.folders.push(FolderCfg(markers[q].id.clone(), markers[q].name.clone(), markers[q].path.clone(), text.clone(), isoUtc(unixMs()))); }
        (&mut markers[q]).room = true;
      }
    }
    print <- "incubator: dropped at "; printStr(text.view()); print <- "\n";
    writeAt = nowMs() + 1000u64;
  }

  fn faceOrigin(p: Vec3) f32 { atan2(0. - p.x, 0. - p.z) }

  fn pgModel(self: &, i: usize) Mat4 {
    Mat4.fromTrs(pgs[i].pos, Quat.angleAxis(pgs[i].yaw, Vec3(0., 1., 0.)), Vec3(pgs[i].sc, pgs[i].sc, pgs[i].sc))
  }

  fn newBorn(self: &mut) u64 {
    var b = nowMs();
    if b <= lastBorn { b = lastBorn + 1u64; }
    lastBorn = b;
    b
  }

  // The pages standing (not shelved, not closed)
  fn standing(self: &) usize {
    var n = 0usize;
    var i = 0usize;
    while i < pgs.len() { if !pgs[i].shelved && !pgs[i].gone && pgs[i].zone < 0 && !pgs[i].tab { n = n + 1usize; } i = i + 1usize; }
    n
  }

  // How many arc pages are newer than page i: its place in the arc, 0 the nearest the browser
  fn arcRank(self: &, i: usize) usize {
    var r = 0usize;
    var j = 0usize;
    while j < pgs.len() {
      if j != i && !pgs[j].shelved && !pgs[j].free && !pgs[j].gone && pgs[j].zone < 0 && (pgs[j].born > pgs[i].born || (pgs[j].born == pgs[i].born && j > i)) {
        r = r + 1usize;
      }
      j = j + 1usize;
    }
    r
  }

  fn arcSpot(rank: usize) Vec3 {
    let b = PG_B0 - PG_STEP * f32.from(u32.from(rank + 1usize));
    Vec3(PG_R * sin(b), 0., 0. - PG_R * cos(b))
  }

  fn pgShelfFree(self: &) i32 {
    var q = 0i32;
    while q < 8i32 {
      var used = false;
      var i = 0usize;
      while i < pgs.len() { if pgs[i].shelved && pgs[i].shelfAt == q && !pgs[i].gone { used = true; } i = i + 1usize; }
      if !used { return q; }
      q = q + 1i32;
    }
    7i32
  }

  fn pgShelfSpot(web: bool, q: i32) Vec3 {
    let sp = Incubator.shelfPos(16u32 + u32.from(q));
    Vec3(sp.x - 0.4, sp.y - pgBottom(web) * PG_SHELVED_SCALE, sp.z)
  }

  // Every page set off toward the place it should stand now: the arc's (newest nearest), a shelf, or where it was put
  fn retarget(self: &mut) {
    var i = 0usize;
    while i < pgs.len() {
      if !pgs[i].gone && pgs[i].zone < 0 {
        var np = pgs[i].toPos;
        var ny = pgs[i].toYaw;
        var ns: f32 = 1.;
        if pgs[i].shelved {
          np = Incubator.pgShelfSpot(pgs[i].web, pgs[i].shelfAt);
          ny = 0. - PI * 0.5;
          ns = PG_SHELVED_SCALE;
        } else if pgs[i].free {
          ny = Incubator.faceOrigin(np);
        } else {
          np = Incubator.arcSpot(self.arcRank(i));
          ny = Incubator.faceOrigin(np);
        }
        (&mut pgs[i]).fromPos = pgs[i].pos;
        (&mut pgs[i]).fromYaw = pgs[i].yaw;
        (&mut pgs[i]).fromSc = pgs[i].sc;
        (&mut pgs[i]).toPos = np;
        (&mut pgs[i]).toYaw = pgs[i].yaw + turnBetween(pgs[i].yaw, ny);
        (&mut pgs[i]).toSc = ns;
        (&mut pgs[i]).fly = 0.;
      }
      i = i + 1usize;
    }
  }

  // More than PG_MAX standing: the oldest are shelved
  fn enforceLimit(self: &mut) {
    while self.standing() > PG_MAX {
      var old = pgs.len();
      var i = 0usize;
      while i < pgs.len() {
        if !pgs[i].shelved && !pgs[i].gone && pgs[i].zone < 0 && !pgs[i].tab && (old == pgs.len() || pgs[i].born < pgs[old].born) { old = i; }
        i = i + 1usize;
      }
      if old == pgs.len() { return; }
      print <- "pages: "; printStr(pgs[old].title.text.view()); print <- " shelved (more than "; print <- PG_MAX; print <- " standing)\n";
      (&mut pgs[old]).shelfAt = self.pgShelfFree();
      (&mut pgs[old]).shelved = true;
      (&mut pgs[old]).free = false;
    }
  }

  fn placeTextOfPage(self: &, i: usize) String {
    if pgs[i].shelved { var s = String.from("shelf:"); s.append(numText(i64.from(pgs[i].shelfAt)).view()); return s; }
    if pgs[i].free {
      var s = String.from("at:");
      s.append(floatText(pgs[i].toPos.x).view()); s.append(",0,"); s.append(floatText(pgs[i].toPos.z).view());
      return s;
    }
    String.from("arc")
  }

  // The pages the room opened, to room.toml (a second after the last change), oldest first
  fn syncRoom(self: &mut) {
    var order = List[usize]();
    var i = 0usize;
    while i < pgs.len() {
      if !pgs[i].gone && !pgs[i].proj && pgs[i].zone < 0 && !pgs[i].tab {
        var at = order.len();
        while at > 0usize && pgs[*order[at - 1usize]].born > pgs[i].born { at = at - 1usize; }
        order.insert(at, i);
      }
      i = i + 1usize;
    }
    var list = PageCfgs();
    let now = isoUtc(unixMs());
    var o = 0usize;
    while o < order.len() {
      let k = *order[o];
      list.push(PageCfg(pgs[k].id.clone(), pgs[k].src.clone(), self.placeTextOfPage(k), String.from(now.view())));
      o = o + 1usize;
    }
    roomGood.pages = list;
    writeAt = nowMs() + 1000u64;
  }

  pub fn wantPage(self: &mut, src: &str) { pageWant = String.from(src); }

  pub fn takePageWant(self: &mut) String { let s = pageWant.clone(); pageWant = String(); s }

  // A file or an address becomes a new page, at the near end of the arc. Returns its number, or -1.
  pub fn openPage(self: &mut, device: &mut Device, renderer: &mut Renderer, src: &str) {
    if src.startsWith("bench:") { self.openOnBench(device, renderer, src.sliceFrom(6usize)); return; }
    if isWebSrc(src) { self.openTab(device, renderer, src); return; }
    _ =self.openPageAs(device, renderer, src, "", false);
  }

  // A page opened at the workbench, 1.4 m from the start spot (as far as a focused pane): ahead, then to the left and right in turn
  fn openOnBench(self: &mut, device: &mut Device, renderer: &mut Renderer, src: &str) {
    let n = self.openPageAs(device, renderer, src, "", false);
    if n >= 0 && self.editOnOpen.view() == src {
      // a new note: it opens empty with the caret in it
      editOnOpen = String();
      let u0 = usize.from(u32.from(n));
      match &mut pgs[u0].doc { case var &mut Some(p) { p.editWant(0usize); } else {} }
      focusPg = n;
      palFocused = false;
      webPanelText(true);
    }
    if n >= 0 {
      let k = benchN % 3u32;
      let a: f32 = if k == 0u32 { 0. } else if k == 1u32 { 0. - 0.85 } else { 0.85 };
      benchN = benchN + 1u32;
      let u = usize.from(u32.from(n));
      (&mut pgs[u]).free = true;
      let br = f32.from(BENCH_R);
      (&mut pgs[u]).toPos = Vec3(br * sin(a), 0., 0. - br * cos(a));
      self.retarget();
      self.syncRoom();
    }
  }

  fn openPageAs(self: &mut, device: &mut Device, renderer: &mut Renderer, src: &str, id: &str, proj: bool) i32 {
    self.ensureChips(device);
    let t0 = sdl.GetPerformanceCounter();
    let web = isWebSrc(src);
    var doc: Option[DocPanel] = None;
    var wp: Option[WebPanel] = None;
    var okp = true;
    if web {
      wp = WebPanel.create(device, format, src);
      match &wp { case let Some(w0) {} case is None { okp = false; } }
    } else {
      doc = DocPanel.create(device, renderer, format, src, 0.);
      match &doc { case let Some(d0) {} case is None { okp = false; } }
    }
    if !okp { print <- "pages: could not open "; printStr(src); print <- "\n"; return -1; }
    var pid = String.from(id);
    if pid.len() == 0usize {
      pgSerial = pgSerial + 1u32;
      pid = String.from("p");
      pid.append(numText(i64.from(pgSerial)).view());
    }
    let title = pageTitle(src);
    let tl = self.mkLabel(device, title.view(), 0xf8f5eeffu32, 0x1c1c1cffu32, fitSize(title.len(), 56.), 0.8, 0.2);
    let from = if browserOpen { Vec3(browserPos.x, 0., browserPos.z) } else { Vec3(0. - 3.4, 0., 0. - 0.8) };
    let yaw0 = Incubator.faceOrigin(from);
    let born = self.newBorn();
    let chips = self.pageChips(device);
    pgs.push(Pg(pid, String.from(src), web, doc, wp, tl, chips, born, from, yaw0, 0.3, from, yaw0, 0.3, from, yaw0, 1., String()));
    let n = pgs.len() - 1usize;
    (&mut pgs[n]).proj = proj;
    if tabNext && web {
      tabSerial = tabSerial + 1u32;
      (&mut pgs[n]).tab = true; (&mut pgs[n]).tabNo = tabSerial; (&mut pgs[n]).free = true;
    }
    self.enforceLimit();
    self.retarget();
    if !proj { self.syncRoom(); }
    print <- "pages: opened "; printStr(src); print <- " as "; printStr(pgs[n].id.view()); print <- " in ";
    print <- f64.from((sdl.GetPerformanceCounter() - t0) * 1000000u64 / sdl.GetPerformanceFrequency()) / 1000.; print <- " ms, "; print <- self.standing(); print <- " standing\n";
    i32.from(n)
  }

  fn closePage(self: &mut, i: usize) {
    if i >= pgs.len() || pgs[i].gone || pgs[i].zone >= 0 { return; }
    print <- "pages: closed "; printStr(pgs[i].title.text.view()); print <- "\n";
    if pgs[i].tab && pgs[i].tabNo == tabCur {
      // the shown tab closes: the newest of the others takes its place
      var best = pgs.len();
      var j = 0usize;
      while j < pgs.len() { if j != i && pgs[j].tab && !pgs[j].gone && (best == pgs.len() || pgs[j].tabNo > pgs[best].tabNo) { best = j; } j = j + 1usize; }
      if best < pgs.len() { self.showTab(best); } else { tabCur = 0u32; addrEdit = false; }
    }
    (&mut pgs[i]).gone = true;
    if grabIx == i32.from(i) { grabIx = -1; }
    self.retarget();
    if !pgs[i].proj { self.syncRoom(); }
  }

  // Shelve a standing page; bring a shelved one back as the newest
  fn toggleShelve(self: &mut, i: usize) {
    if i >= pgs.len() || pgs[i].gone || pgs[i].zone >= 0 || pgs[i].tab { return; }
    if pgs[i].shelved {
      (&mut pgs[i]).shelved = false;
      (&mut pgs[i]).free = false;
      (&mut pgs[i]).born = self.newBorn();
      self.enforceLimit();
      print <- "pages: "; printStr(pgs[i].title.text.view()); print <- " brought back\n";
    } else {
      (&mut pgs[i]).shelfAt = self.pgShelfFree();
      (&mut pgs[i]).shelved = true;
      (&mut pgs[i]).free = false;
      print <- "pages: "; printStr(pgs[i].title.text.view()); print <- " shelved\n";
    }
    self.retarget();
    if !pgs[i].proj { self.syncRoom(); } else { self.noteProjPage(i); }
  }

  fn startGrab(self: &mut, i: usize) {
    if i >= pgs.len() || pgs[i].gone || pgs[i].zone >= 0 { return; }
    var d = (pgs[i].pos - gazeEye).length();
    if d < 1.5 { d = 1.5; }
    if d > 8. { d = 8.; }
    grabDist = d;
    grabIx = i32.from(i);
    (&mut pgs[i]).shelved = false;
    (&mut pgs[i]).free = true;
    (&mut pgs[i]).sc = 1.;
    print <- "pages: grabbed "; printStr(pgs[i].title.text.view()); print <- "\n";
    self.retarget();
  }

  pub fn dropGrab(self: &mut) {
    if grabKind > 0u32 { self.dropOther(); return; }
    if grabIx < 0 { return; }
    let i = usize.from(u32.from(grabIx));
    grabIx = -1;
    if i >= pgs.len() { return; }
    print <- "pages: dropped "; printStr(pgs[i].title.text.view()); print <- " at ("; print <- pgs[i].toPos.x; print <- ", "; print <- pgs[i].toPos.z; print <- ")\n";
    self.retarget();
    if !pgs[i].proj { self.syncRoom(); } else { self.noteProjPage(i); }
  }

  // A project's page was moved in the room: it goes to room.toml as the project's place
  fn noteProjPage(self: &mut, i: usize) {
    var pi = 0usize;
    var found = false;
    while pi < roomGood.projects.len() { if roomGood.projects[pi].id.view() == pgs[i].id.view() { found = true; break; } pi = pi + 1usize; }
    if !found { roomGood.projects.push(newProj(pgs[i].id.view())); pi = roomGood.projects.len() - 1usize; }
    let pt = self.placeTextOfPage(i);
    var text = pt.clone();
    if pt.view() == "arc" { text = String.from("ring:0"); }
    else if pt.view() != "" && startsWithText(pt.view(), "shelf:") { text = String.from("shelf:side:"); text.append(numText(i64.from(pgs[i].shelfAt)).view()); }
    roomGood.projects[pi].place = text.clone();
    roomGood.projects[pi].at = isoUtc(unixMs());
    (&mut pgs[i]).placeKey = text;
    writeAt = nowMs() + 1000u64;
  }

  // Once a frame: pages glide, tick and report; the grabbed one follows the gaze; the closed leave
  fn tickPages(self: &mut, device: &mut Device, renderer: &mut Renderer, dt: f32) {
    let now = nowMs();
    spareMake(device, format);
    var openWant = List[String]();
    var benchWant = List[String]();
    var browseWant = String();
    self.followGrab();
    var i = 0usize;
    while i < pgs.len() {
      if pgs[i].zone >= 0 { self.panePose(i, dt); }
      if pgs[i].fly < 1. && pgs[i].zone < 0 {
        var f = pgs[i].fly + dt / 0.6;
        if f > 1. { f = 1.; }
        let e = f * f * (3. - 2. * f);
        (&mut pgs[i]).fly = f;
        (&mut pgs[i]).pos = pgs[i].fromPos + (pgs[i].toPos - pgs[i].fromPos) * e;
        (&mut pgs[i]).yaw = pgs[i].fromYaw + (pgs[i].toYaw - pgs[i].fromYaw) * e;
        (&mut pgs[i]).sc = pgs[i].fromSc + (pgs[i].toSc - pgs[i].fromSc) * e;
      }
      if grabIx == i32.from(i) {
        let h = Vec3(gazeDir.x, 0., gazeDir.z);
        if h.length() > 0.05 {
          let hn = h.normalize();
          let p = Vec3(gazeEye.x + hn.x * grabDist, 0., gazeEye.z + hn.z * grabDist);
          (&mut pgs[i]).pos = p;
          (&mut pgs[i]).toPos = p;
          (&mut pgs[i]).fromPos = p;
          (&mut pgs[i]).yaw = Incubator.faceOrigin(p);
          (&mut pgs[i]).toYaw = pgs[i].yaw;
          (&mut pgs[i]).fromYaw = pgs[i].yaw;
          (&mut pgs[i]).sc = 1.; (&mut pgs[i]).toSc = 1.; (&mut pgs[i]).fromSc = 1.;
          (&mut pgs[i]).fly = 1.;
        }
      }
      if !pgs[i].gone {
        if pgs[i].web {
          let up = pgs[i].webUp;
          let idle = self.tabHidden(i);      // only the tab shown paints
          match &mut pgs[i].wp {
            case var &mut Some(w) {
              if !idle { w.tick(device); }
              if up > 0i32 {
                if up == 1i32 { w.button(w.lastX, w.lastY, true); }
              }
            }
            else {}
          }
          if up > 0i32 { (&mut pgs[i]).webUp = up - 1i32; }
        } else if !pgs[i].shelved {
          let isPane = pgs[i].zone >= 0;
          match &mut pgs[i].doc {
            case var &mut Some(p) {
              p.tick(device, renderer);
              p.openNew = false;
              if p.outOpen.len() > 0usize {
                if isPane { benchWant.push(p.outOpen.clone()); } else { openWant.push(p.outOpen.clone()); }
                p.outOpen = String();
              }
              if p.outWeb.len() > 0usize { openWant.push(p.outWeb.clone()); p.outWeb = String(); }
              if p.outBrowse.len() > 0usize { browseWant = p.outBrowse.clone(); p.outBrowse = String(); }
            }
            else {}
          }
        }
      }
      i = i + 1usize;
    }
    var w = 0usize;
    while w < openWant.len() { self.openPage(device, renderer, openWant[w].view()); w = w + 1usize; }
    self.refreshTabs();
    // a file clicked in a board's tree opens as a page on the workbench: near the start spot, ahead and to the sides in turn
    w = 0usize;
    while w < benchWant.len() { self.openOnBench(device, renderer, benchWant[w].view()); w = w + 1usize; }
    self.syncTrees();
    if browseWant.len() > 0usize { self.toggleBrowser(browseWant.view(), Vec3(0., 0., 0.), 0.); }
    // pages from room.toml, one at a time
    if restoreQ.len() > 0usize && now >= restoreAt {
      let pc = restoreQ[0usize].src.clone();
      let place = restoreQ[0usize].place.clone();
      let pid = restoreQ[0usize].id.clone();
      let nrest = restoreQ.len();
      var rest = PageCfgs();
      var r = 1usize;
      while r < restoreQ.len() { rest.push(PageCfg(restoreQ[r].id.clone(), restoreQ[r].src.clone(), restoreQ[r].place.clone(), restoreQ[r].at.clone())); r = r + 1usize; }
      restoreQ = rest;
      restoreAt = now + 600u64;
      var found = false;
      var q = 0usize;
      while q < pgs.len() { if pgs[q].id.view() == pid.view() { found = true; } q = q + 1usize; }
      if !found {
        let n = self.openPageAs(device, renderer, pc.view(), pid.view(), false);
        if n >= 0 { self.placeRestored(usize.from(u32.from(n)), place.view()); }
      }
    }
    // the closed leave (the device is idle first, so nothing the GPU still reads is freed)
    var any = false;
    var g = 0usize;
    while g < pgs.len() { if pgs[g].gone { any = true; } g = g + 1usize; }
    if any {
      device.waitIdle();
      var k = pgs.len();
      while k > 0usize {
        k = k - 1usize;
        if pgs[k].gone {
          match &mut pgs[k].wp { case var &mut Some(wv) { wv.close(); } else {} }
          var dead = pgs.swapRemove(k);
        }
      }
      grabIx = -1;
      self.retarget();
    }
  }

  // A page that came back from room.toml: where it stood
  fn placeRestored(self: &mut, n: usize, place: &str) {
    if startsWithText(place, "shelf:") {
      var q = 0u32;
      if cfgDigits(place.slice(6usize, place.len()), &mut q) && q < 8u32 { (&mut pgs[n]).shelved = true; (&mut pgs[n]).shelfAt = i32.from(q); }
    } else if startsWithText(place, "at:") {
      var pl = Place(0u32, 0u32, 0., 0., 0.);
      if parsePlace(place, &mut pl) { (&mut pgs[n]).free = true; (&mut pgs[n]).toPos = Vec3(pl.x, 0., pl.z); }
    }
    self.retarget();
  }

  // The test hooks: close (0), shelve or bring (1), grab (2) page n; drop (3); park the browser's folder (4)
  pub fn actPage(self: &mut, device: &mut Device, kind: i32, n: i32) {
    let i = if n >= 0 { usize.from(u32.from(n)) } else { 0usize };
    if kind == 0i32 { self.closePage(i); }
    else if kind == 1i32 { self.toggleShelve(i); }
    else if kind == 2i32 { self.startGrab(i); }
    else if kind == 3i32 { self.dropGrab(); }
    else if kind == 4i32 { self.parkBrowser(device); }
    // the general browser (test hooks): 10 switch to tab slot n, 11 close the shown tab, 12 type address n into the strip and press Enter,
    // 13 click the "+" chip, 14 report the tabs
    else if kind == 10i32 { self.switchTab(i); }
    else if kind == 11i32 { self.closeTab(); }
    else if kind == 12i32 {
      let urls = ["https://web3d.jondgoodwin.com", "https://cone.jondgoodwin.com", "jondgoodwin.com"];
      addrEdit = true; addrBuf = String();
      self.webTyped(urls[i % 3usize]);
      self.addrKey(13i32);
    }
    else if kind == 13i32 { self.tabClick(0usize, 30u32); }
    else if kind == 15i32 { self.openPlanCard(i / 100usize, i % 100usize); }   // click plan card n%100 of board n/100
    else if kind == 14i32 {
      let order = self.tabList();
      var s = 0usize;
      while s < order.len() {
        let k = *order[s];
        print <- "tabs: slot "; print <- s; print <- (if pgs[k].tabNo == tabCur { " SHOWN " } else { " hidden " }); printStr(pgs[k].src.view());
        match &pgs[k].wp { case let Some(w) { print <- " uploads "; print <- w.uploaded; } else {} }
        print <- "\n";
        s = s + 1usize;
      }
    }
    // zones: 6 focus the pane zone*8+kind (n), 7 release every pane, 8 follow link n%100 of the pane n/100 (a tree row), 9 scroll the pane n/100 by n%100 notches down
    else if kind == 6i32 {
      let pg = self.paneIndex(i / 8usize, u32.from(i % 8usize));
      if pg >= 0 { self.focusPane(usize.from(u32.from(pg))); }
    }
    else if kind == 7i32 { var j = 0usize; while j < pgs.len() { (&mut pgs[j]).wantFoc = false; j = j + 1usize; } }
    else if kind == 8i32 || kind == 9i32 {
      let q = i / 100usize;
      let pg = self.paneIndex(q / 8usize, u32.from(q % 8usize));
      if pg >= 0 {
        let pu = usize.from(u32.from(pg));
        if focusPg != pg { focusPg = pg; palFocused = false; }   // as a click on the pane does
        match &mut pgs[pu].doc {
          case var &mut Some(p) {
            if kind == 8i32 { p.openNew = false; p.requestNth(i % 100usize); } else { p.scroll(0. - f32.from(u32.from(i % 100usize))); }
          }
          else {}
        }
      }
    }
    else if kind == 5i32 && i < pgs.len() {
      match &mut pgs[i].doc { case var &mut Some(p) { p.openNew = true; p.requestNth(usize.from(u32.from(if n > 0 { 0 } else { 0 }))); } else {} }
    }
  }

  // The page under a ray and what of it: 0 nothing, 1 the page, 2 close, 3 shelve, 4 grab; the distance along the ray, or -1
  fn pgHit(self: &, i: usize, eye: Vec3, dir: Vec3, kind: &mut u32) f32 {
    *kind = 0u32;
    if pgs[i].gone || self.tabHidden(i) { return -1.; }
    let m = self.pgModel(i);
    var best: f32 = -1.;
    let web = pgs[i].web;
    if pgs[i].tab {
      let order = self.tabList();
      var s = 0usize;
      while s < order.len() {
        let t = quadHit(m, self.tabRect(s, order.len()), eye, dir);
        if t > 0. && (best < 0. || t < best) { best = t; *kind = 20u32 + u32.from(s); }
        s = s + 1usize;
      }
      var t2 = quadHit(m, self.tabPlusRect(order.len()), eye, dir);
      if t2 > 0. && (best < 0. || t2 < best) { best = t2; *kind = 30u32; }
      t2 = quadHit(m, self.tabCloseRect(order.len()), eye, dir);
      if t2 > 0. && (best < 0. || t2 < best) { best = t2; *kind = 31u32; }
      t2 = quadHit(m, self.addrRect(), eye, dir);
      if t2 > 0. && (best < 0. || t2 < best) { best = t2; *kind = 32u32; }
    }
    if !pgs[i].shelved {
      let hw = pgHalfW(web);
      let cy = pgTop(web) + 0.05;
      var c = 0u32;
      while CHIPS_ON && c < u32.from(self.chipCount(i)) {
        let cx = hw - 0.19 - 0.39 * f32.from(c);
        let t = quadHit(m, Vec4(cx - PG_CHIP_W * 0.5, cy - PG_CHIP_H * 0.5, cx + PG_CHIP_W * 0.5, cy + PG_CHIP_H * 0.5), eye, dir);
        if t > 0. && (best < 0. || t < best) { best = t; *kind = 2u32 + c; }
        c = c + 1u32;
      }
    }
    let inv = m.inverse();
    let le = inv * eye;
    let ld = inv.transformVector(dir);
    var tb: f32 = -1.;
    if web { match &pgs[i].wp { case let Some(w) { tb = w.reachLocal(le, ld); } else {} } }
    else { match &pgs[i].doc { case let Some(p) { tb = p.reach(le, ld); } else {} } }
    if tb > 0. && (best < 0. || tb < best) { best = tb; *kind = 1u32; }
    best
  }

  // The "park" chip on the browser panel's top edge: the distance along the ray, or -1
  fn parkHit(self: &, eye: Vec3, dir: Vec3) f32 {
    if !CHIPS_ON || !browserOpen || pgChips.len() < 1usize { return -1.; }
    let cx = pgHalfW(false) - 0.19;
    let cy = pgTop(false) + 0.05;
    quadHit(self.browserModel(), Vec4(cx - PG_CHIP_W * 0.5, cy - PG_CHIP_H * 0.5, cx + PG_CHIP_W * 0.5, cy + PG_CHIP_H * 0.5), eye, dir)
  }

  // A click's ray against the pages, their chips, the markers and the browser's park chip: true if one took it
  pub fn clickPages(self: &mut, device: &mut Device, eye: Vec3, dir: Vec3, view: Vec3, newTab: bool) bool {
    if grabIx >= 0 { self.dropGrab(); return true; }
    var bi = -1;
    var bt: f32 = -1.;
    var bk = 0u32;
    var i = 0usize;
    while i < pgs.len() {
      var k = 0u32;
      let t = self.pgHit(i, eye, dir, &mut k);
      if t > 0. && (bt < 0. || t < bt) { bt = t; bi = i32.from(i); bk = k; }
      i = i + 1usize;
    }
    var mi = -1;
    var mt: f32 = -1.;
    var m = 0usize;
    while m < markers.len() {
      let inv = Incubator.faceModel(markers[m].pos, view).inverse();
      let e = inv * eye;
      let d = inv.transformVector(dir);
      if d.z > 0.00001 || d.z < -0.00001 {
        let t = (0. - e.z) / d.z;
        if t > 0. {
          let p = e + d * t;
          if p.x >= -0.36 && p.x <= 0.36 && p.y >= 0. && p.y <= 1.72 && (mt < 0. || t < mt) { mt = t; mi = i32.from(m); }
        }
      }
      m = m + 1usize;
    }
    let pk = self.parkHit(eye, dir);
    if pk > 0. && (bt < 0. || pk < bt) && (mt < 0. || pk < mt) { self.parkBrowser(device); return true; }
    if mi >= 0 && (bt < 0. || mt < bt) {
      let mu = usize.from(u32.from(mi));
      print <- "pages: marker "; printStr(markers[mu].name.view()); print <- " opens the browser at "; printStr(markers[mu].path.view()); print <- "\n";
      let path = markers[mu].path.clone();
      self.toggleBrowser(path.view(), eye, 0.);
      return true;
    }
    if self.clickZones(eye, dir, bt) { return true; }
    if bi < 0 { self.blurWeb(); return false; }
    let pu = usize.from(u32.from(bi));
    if bk >= 20u32 { self.tabClick(pu, bk); return true; }
    deskFocus = false;
    if focusPg != bi { focusPg = bi; palFocused = false; print <- "palette: focus on page "; printStr(pgs[pu].title.text.view()); print <- "\n"; }
    if bk == 2u32 && pgs[pu].zone >= 0 { self.focusPane(pu); return true; }
    if bk == 2u32 { self.closePage(pu); return true; }
    if bk == 3u32 { self.toggleShelve(pu); return true; }
    if bk == 4u32 { self.startGrab(pu); return true; }
    if bk == 5u32 || bk == 6u32 {
      match &mut pgs[pu].doc { case var &mut Some(p) { p.requestNav(if bk == 5u32 { -1i32 } else { 1i32 }); } else {} }
      return true;
    }
    if pgs[pu].shelved { self.toggleShelve(pu); return true; }
    let inv = self.pgModel(pu).inverse();
    let le = inv * eye;
    let ld = inv.transformVector(dir);
    if pgs[pu].web {
      self.blurWeb();
      match &mut pgs[pu].wp {
        case var &mut Some(w) {
          let hit = w.pickLocal(le, ld);
          if hit.z > 0.5 {
            w.moved(i32.from(hit.x), i32.from(hit.y));
            w.setFocus(true);
            w.button(i32.from(hit.x), i32.from(hit.y), false);
          }
        }
        else {}
      }
      (&mut pgs[pu]).webUp = 4i32;
    } else {
      self.blurWeb();
      match &mut pgs[pu].doc { case var &mut Some(p) { p.openNew = newTab; _ = p.click(le, ld); } else {} }
    }
    true
  }

  fn blurWeb(self: &mut) {
    var i = 0usize;
    while i < pgs.len() {
      match &mut pgs[i].wp { case var &mut Some(w) { if w.focus { w.setFocus(false); } } else {} }
      i = i + 1usize;
    }
  }

  // Keys and text for the web page that holds the focus
  pub fn webFocused(self: &) bool {
    if addrEdit { return true; }
    var i = 0usize;
    while i < pgs.len() {
      match &pgs[i].wp { case let Some(w) { if w.focus { return true; } } else {} }
      i = i + 1usize;
    }
    false
  }

  pub fn webTyped(self: &mut, text: &str) {
    if addrEdit { addrBuf.append(text); return; }
    var i = 0usize;
    while i < pgs.len() {
      match &mut pgs[i].wp { case var &mut Some(w) { if w.focus { w.typed(text); } } else {} }
      i = i + 1usize;
    }
  }

  pub fn webKeyed(self: &mut, vk: i32, down: bool, mods: i32, back: bool, forward: bool) {
    if addrEdit { if down { self.addrKey(vk); } return; }
    var i = 0usize;
    while i < pgs.len() {
      match &mut pgs[i].wp {
        case var &mut Some(w) {
          if w.focus {
            if back { if down { w.back(); } }
            else if forward { if down { w.forward(); } }
            else if vk != 0i32 { w.key(vk, down, mods); }
          }
        }
        else {}
      }
      i = i + 1usize;
    }
  }

  // The wheel over a web page scrolls it; false if the ray is not on one
  pub fn webWheelRay(self: &mut, eye: Vec3, dir: Vec3, notches: f32) bool {
    var i = 0usize;
    while i < pgs.len() {
      if pgs[i].web && !pgs[i].shelved && !pgs[i].gone && !self.tabHidden(i) {
        let inv = self.pgModel(i).inverse();
        let le = inv * eye;
        let ld = inv.transformVector(dir);
        match &mut pgs[i].wp {
          case var &mut Some(w) {
            let hit = w.pickLocal(le, ld);
            if hit.z > 0.5 { w.wheel(i32.from(hit.x), i32.from(hit.y), notches); return true; }
          }
          else {}
        }
      }
      // a document page or a tree under the ray scrolls (the same offset the main page uses)
      if !pgs[i].web && !pgs[i].shelved && !pgs[i].gone {
        let inv = self.pgModel(i).inverse();
        let le = inv * eye;
        let ld = inv.transformVector(dir);
        match &mut pgs[i].doc {
          case var &mut Some(p) { if p.reach(le, ld) > 0. { p.scroll(notches); return true; } }
          else {}
        }
      }
      i = i + 1usize;
    }
    false
  }

  // The scroll of a ray, one way for every scrollable (scroll.cone): the nearest page (document or web), the file browser, the report or the
  // main page under the ray takes 'dx' and 'dy' notches (positive: right, up the page). With 'probe' nothing is scrolled: true says there is
  // one under the ray (the right stick then scrolls rather than turns). The zones build's trees join here by their own `scrollBy`.
  pub fn scrollRay(self: &mut, eye: Vec3, dir: Vec3, dx: f32, dy: f32, probe: bool, page: &mut Option[DocPanel]) bool {
    var bestT: f32 = -1.;
    var kind = 0u32;                 // 1 a page of pgs, 2 the browser, 3 the report, 4 the main page
    var which = 0usize;
    var i = 0usize;
    while i < pgs.len() {
      if !pgs[i].shelved && !pgs[i].gone {
        var pk = 0u32;
        let t = self.pgHit(i, eye, dir, &mut pk);
        if pk == 1u32 && t > 0. && (bestT < 0. || t < bestT) { bestT = t; kind = 1u32; which = i; }
      }
      i = i + 1usize;
    }
    if browserOpen {
      match &browserPanel {
        case let Some(p) {
          let inv = self.browserModel().inverse();
          let t = p.reach(inv * eye, inv.transformVector(dir));
          if t > 0. && (bestT < 0. || t < bestT) { bestT = t; kind = 2u32; }
        }
        else {}
      }
    }
    if reportOpen {
      match &reportPanel {
        case let Some(p) {
          let inv = self.reportModel().inverse();
          let t = p.reach(inv * eye, inv.transformVector(dir));
          if t > 0. && (bestT < 0. || t < bestT) { bestT = t; kind = 3u32; }
        }
        else {}
      }
    }
    let invPage = self.pageModel().inverse();
    match page {
      case let Some(p) {
        let t = p.reach(invPage * eye, invPage.transformVector(dir));
        if t > 0. && (bestT < 0. || t < bestT) { bestT = t; kind = 4u32; }
      }
      else {}
    }
    if kind == 0u32 { return false; }
    if probe { return true; }
    if kind == 1u32 {
      if pgs[which].web {
        let inv = self.pgModel(which).inverse();
        let le = inv * eye;
        let ld = inv.transformVector(dir);
        match &mut pgs[which].wp {
          case var &mut Some(w) {
            let hit = w.pickLocal(le, ld);
            if hit.z > 0.5 { w.wheel(i32.from(hit.x), i32.from(hit.y), dy); }
          }
          else {}
        }
      } else {
        match &mut pgs[which].doc { case var &mut Some(p) { p.scrollBy(dx, dy); } else {} }
      }
    }
    else if kind == 2u32 { match &mut browserPanel { case var &mut Some(p) { p.scrollBy(dx, dy); } else {} } }
    else if kind == 3u32 { match &mut reportPanel { case var &mut Some(p) { p.scrollBy(dx, dy); } else {} } }
    else { match page { case var &mut Some(p) { p.scrollBy(dx, dy); } else {} } }
    true
  }

  // ---- parked folders ----

  fn markerPos(place: &str, row: usize) Vec3 {
    var pl = Place(0u32, 0u32, 0., 0., 0.);
    if place.len() > 0usize && parsePlace(place, &mut pl) && pl.kind == 3u32 { return Vec3(pl.x, pl.y, pl.z); }
    Vec3(0. - 3.0, 0., 2.4 - 0.9 * f32.from(u32.from(row)))
  }

  fn makeMarker(self: &, device: &mut Device, id: &str, name: &str, path: &str, place: &str, room: bool, proj: bool, row: usize) FolderPost {
    let shown = if name.len() > 0usize { String.from(name) } else { folderName(path) };
    let lab = self.mkLabel(device, shown.view(), 0x2a3a46ffu32, 0xffffffffu32, fitSize(shown.len(), 54.), 0.72, 0.18);
    let post = self.mkLabel(device, "", 0xc08a20ffu32, 0xffffffffu32, 40., 0.06, 0.015);
    FolderPost(String.from(id), shown, String.from(path), String.from(place), Incubator.markerPos(place, row), lab, post, room, proj)
  }

  // The markers: the folders of incubator.toml and of room.toml (the room's win by id), and those of projects (kept as they are)
  fn syncMarkers(self: &mut, device: &mut Device) {
    // Jon, 11 Nov: no folder posts that retarget another pane. Each folder is its own tree pane (park, or a board's panes).
    if markers.len() < 1000000usize { return; }
    var want = Folders();
    var wroom = List[bool]();
    var i = 0usize;
    while i < incubatorGood.folders.len() {
      let f = &incubatorGood.folders[i];
      want.push(FolderCfg(f.id.clone(), f.name.clone(), f.path.clone(), f.place.clone(), f.at.clone()));
      wroom.push(false);
      i = i + 1usize;
    }
    i = 0usize;
    while i < roomGood.folders.len() {
      let f = &roomGood.folders[i];
      var at = want.len();
      var j = 0usize;
      while j < want.len() { if want[j].id.view() == f.id.view() { at = j; } j = j + 1usize; }
      let fc = FolderCfg(f.id.clone(), f.name.clone(), f.path.clone(), f.place.clone(), f.at.clone());
      if at == want.len() { want.push(fc); wroom.push(true); } else { want.set(at, fc); wroom.set(at, true); }
      i = i + 1usize;
    }
    var k = markers.len();
    while k > 0usize {
      k = k - 1usize;
      if !markers[k].proj {
        var keep = false;
        var j = 0usize;
        while j < want.len() { if want[j].id.view() == markers[k].id.view() { keep = true; } j = j + 1usize; }
        if !keep { print <- "pages: marker "; printStr(markers[k].name.view()); print <- " leaves\n"; var dead = markers.swapRemove(k); }
      }
    }
    var w = 0usize;
    while w < want.len() {
      var at = markers.len();
      var j = 0usize;
      while j < markers.len() { if !markers[j].proj && markers[j].id.view() == want[w].id.view() { at = j; } j = j + 1usize; }
      var row = 0usize;
      var q = 0usize;
      while q < markers.len() { if markers[q].place.len() == 0usize && q != at { row = row + 1usize; } q = q + 1usize; }
      if at == markers.len() {
        markers.push(self.makeMarker(device, want[w].id.view(), want[w].name.view(), want[w].path.view(), want[w].place.view(), *wroom[w], false, row));
        print <- "pages: marker "; printStr(markers[markers.len() - 1usize].name.view()); print <- " stands for "; printStr(want[w].path.view()); print <- "\n";
      } else if markers[at].path.view() != want[w].path.view() || markers[at].place.view() != want[w].place.view() || (want[w].name.len() > 0usize && markers[at].name.view() != want[w].name.view()) {
        let made = self.makeMarker(device, want[w].id.view(), want[w].name.view(), want[w].path.view(), want[w].place.view(), *wroom[w], false, row);
        markers.set(at, made);
      }
      w = w + 1usize;
    }
  }

  // The browser's folder is parked: a new marker beside the browser, written to room.toml
  pub fn parkBrowser(self: &mut, device: &mut Device) {
    var path = String();
    match &browserPanel {
      case let Some(p) {
        let f = p.file.view();
        if startsWithText(f, TREE_PREFIX) { path = String.from(f.slice(TREE_PREFIX.len(), f.len())); }
      }
      else {}
    }
    if path.len() == 0usize { print <- "pages: park: the browser shows no folder\n"; return; }
    // park the folder last opened in the tree (else its root) as a tree pane of its own: a page, grip-movable, kept in room.toml
    match &browserPanel {
      case let Some(p) { if p.openDirs.len() > 0usize { path = p.openDirs[p.openDirs.len() - 1usize].clone(); } }
      else {}
    }
    var src = String.from(TREE_PREFIX);
    src.append(path.view());
    print <- "pages: park: a tree pane for "; printStr(path.view()); print <- "\n";
    self.wantPage(src.view());
  }

  // ---- the camera-facing quads ----

  fn faceModel(p: Vec3, eye: Vec3) Mat4 {
    let th = atan2(eye.x - p.x, eye.z - p.z);
    Mat4.fromTrs(p, Quat.angleAxis(th, Vec3(0., 1., 0.)), Vec3(1., 1., 1.))
  }

  fn clampScale(d: f32, per: f32, hi: f32) f32 {
    var s = d / per;
    if s < 1. { s = 1.; }
    if s > hi { s = hi; }
    s
  }

  // An item's name label: its middle and the label's scale
  fn labelFrame(self: &, k: usize, eye: Vec3) Vec4 {
    let it = &items[k];
    let e = self.eff(k);
    let d = (Vec3(e.x, e.y, e.z) - eye).length();
    var ls = Incubator.clampScale(d, 3.5, 2.6);
    if !it.onTable { ls = 0.4 * Incubator.clampScale(d, 7., 1.8); }      // shelf names: small, growing slowly with distance
    let hh = it.label.h * ls * 0.5;
    let top = e.y + it.height * e.w + hh + 0.06;
    Vec4(e.x, top, e.z, ls)
  }

  // The chip k of n beside the anchor item: its middle and scale
  fn chipFrame(self: &, k: usize, n: usize, eye: Vec3) Vec4 {
    let ai = usize.from(u32.from(chipAnchor));
    let it = &items[ai];
    let e = self.eff(ai);
    let centre = Vec3(e.x, e.y + it.height * e.w * 0.5, e.z);
    let d = (centre - eye).length();
    let cs = Incubator.clampScale(d, 2.5, 3.);
    let th = atan2(eye.x - centre.x, eye.z - centre.z);
    let right = Vec3(cos(th), 0., 0. - sin(th));
    let side = it.radius * e.w + 0.2 * cs;
    let up = ((f32.from(n) - 1.) * 0.5 - f32.from(k)) * 0.095 * cs;
    Vec4(centre.x + right.x * side, centre.y + up, centre.z + right.z * side, cs)
  }

  fn chipsShown(self: &, now: u64) bool {
    CHIPS_ON && sel >= 0 && f32.from(now - selAt) >= CHIP_DELAY_MS && items[usize.from(u32.from(sel))].flight >= 1.
  }

  // A click's ray against the chips: true if one was taken
  // (the ray starts at 'eye'; the chips face and are sized for 'view', the head: a hand's beam starts elsewhere)
  pub fn clickChip(self: &mut, eye: Vec3, dir: Vec3, v: &Fly, view: Vec3) bool {
    let now = nowMs();
    if !self.chipsShown(now) || chipAnchor != sel { return false; }
    let list = self.chipList();
    let ents = self.visibleEntries(usize.from(u32.from(sel)));
    var k = 0usize;
    while k < list.len() {
      let c = *list[k];
      if chips[usize.from(c)].alpha > 0.5 {
        let f = self.chipFrame(k, list.len(), view);
        let w = chips[usize.from(c)].w * f.w * 0.5;
        let h = chips[usize.from(c)].h * f.w * 0.5;
        let m = Incubator.faceModel(Vec3(f.x, f.y, f.z), view);
        let inv = m.inverse();
        let e = inv * eye;
        let d = inv.transformVector(dir);
        if d.z > 0.00001 || d.z < -0.00001 {
          let t = (0. - e.z) / d.z;
          if t > 0. {
            let p = e + d * t;
            if p.x >= 0. - w && p.x <= w && p.y >= 0. - h && p.y <= h {
              let si = usize.from(u32.from(sel));
              let ent = *ents[k];
              let act = items[si].menu[ent].action.clone();
              print <- "incubator: chip "; printStr(items[si].menu[ent].text.view()); print <- " ("; printStr(act.view()); print <- ")\n";
              if items[si].menu[ent].known { self.doAction(act.view(), v); }
              return true;
            }
          }
        }
      }
      k = k + 1usize;
    }
    false
  }

  // ---- the headset's beam ----

  fn nearer(best: f32, t: f32) f32 { if t >= 0. && (best < 0. || t < best) { t } else { best } }

  // How far along a pointing ray (a unit vector) the nearest thing a click would take is met, or -1: the same tests as clickChip,
  // clickCard and the pages, taking nothing. The beam of a controller ends there. (The parts are the shell's: nearestPart.)
  pub fn reach(self: &, eye: Vec3, dir: Vec3, view: Vec3, page: &Option[DocPanel]) f32 {
    var best: f32 = -1.;
    var c = 0usize;
    while c < cards.len() && OLD_LINE {
      let m = Mat4.fromTrs(self.cardPlace(c), Quat.angleAxis(PI * 0.5, Vec3(0., 1., 0.)), Vec3(1., 1., 1.));
      let inv = m.inverse();
      let e = inv * eye;
      let d = inv.transformVector(dir);
      if d.z > 0.00001 || d.z < -0.00001 {
        let t = (0. - e.z) / d.z;
        if t > 0. {
          let p = e + d * t;
          if p.x >= -0.55 && p.x <= 0.55 && p.y >= -0.1375 && p.y <= 0.1375 && cards[c].alpha > 0.3 { best = Incubator.nearer(best, t); }
        }
      }
      c = c + 1usize;
    }
    let now = nowMs();
    if self.chipsShown(now) && chipAnchor == sel {
      let list = self.chipList();
      var k = 0usize;
      while k < list.len() {
        let ci = *list[k];
        if chips[usize.from(ci)].alpha > 0.5 {
          let f = self.chipFrame(k, list.len(), view);
          let w = chips[usize.from(ci)].w * f.w * 0.5;
          let h = chips[usize.from(ci)].h * f.w * 0.5;
          let inv = Incubator.faceModel(Vec3(f.x, f.y, f.z), view).inverse();
          let e = inv * eye;
          let d = inv.transformVector(dir);
          if d.z > 0.00001 || d.z < -0.00001 {
            let t = (0. - e.z) / d.z;
            if t > 0. {
              let p = e + d * t;
              if p.x >= 0. - w && p.x <= w && p.y >= 0. - h && p.y <= h { best = Incubator.nearer(best, t); }
            }
          }
        }
        k = k + 1usize;
      }
    }
    best = Incubator.nearer(best, pal.reach(eye, dir));
    if browserOpen {
      match &browserPanel {
        case let Some(p) {
          let inv = self.browserModel().inverse();
          best = Incubator.nearer(best, p.reach(inv * eye, inv.transformVector(dir)));
        }
        else {}
      }
      best = Incubator.nearer(best, self.parkHit(eye, dir));
    }
    var pi = 0usize;
    while pi < pgs.len() {
      var pk = 0u32;
      best = Incubator.nearer(best, self.pgHit(pi, eye, dir, &mut pk));
      pi = pi + 1usize;
    }
    var zk = 0u32; var zzi = 0usize; var zix = 0usize;
    best = Incubator.nearer(best, self.zoneHit(eye, dir, &mut zk, &mut zzi, &mut zix));
    var mi = 0usize;
    while mi < markers.len() {
      let inv = Incubator.faceModel(markers[mi].pos, view).inverse();
      let e = inv * eye;
      let d = inv.transformVector(dir);
      if d.z > 0.00001 || d.z < -0.00001 {
        let t = (0. - e.z) / d.z;
        if t > 0. {
          let p = e + d * t;
          if p.x >= -0.36 && p.x <= 0.36 && p.y >= 0. && p.y <= 1.72 { best = Incubator.nearer(best, t); }
        }
      }
      mi = mi + 1usize;
    }
    if reportOpen {
      match &reportPanel {
        case let Some(p) {
          let inv = self.reportModel().inverse();
          best = Incubator.nearer(best, p.reach(inv * eye, inv.transformVector(dir)));
        }
        else {}
      }
    }
    match &desk { case let Some(d) { best = Incubator.nearer(best, d.reach(eye, dir)); } else {} }
    let inv = self.pageModel().inverse();
    match page { case let Some(p) { best = Incubator.nearer(best, p.reach(inv * eye, inv.transformVector(dir))); } else {} }
    best
  }

  // ---- drawing ----

  fn sortKey(kind: u32, i: u32) u32 { kind * 1000u32 + i }

  fn faded(lab: &mut Label, device: &mut Device, encoder: &mut CommandEncoder, target: &Texture, depth: &Texture,
           vp: Mat4, rect: Vec4, extra: f32) {
    let a = lab.alpha * extra;
    if lab.ok && a > 0.01 { lab.pass.drawFaded(device, encoder, target, depth, vp, rect, a); }
  }

  pub fn draw(self: &mut, device: &mut Device, encoder: &mut CommandEncoder, target: &Texture, depth: &Texture, vp: Mat4,
              eye: Vec3, panel: &mut Option[DocPanel]) {
    let now = nowMs();
    let flat = Quat.angleAxis(0. - PI * 0.5, Vec3(1., 0., 0.));
    // the floor first: rings of light under the ring's slots, contact shadows under what floats
    var t = 0usize;
    while t < usize.from(u32.from(RING_N)) {
      let g = *slotGlow[t];
      if g > 0.01 {
        var zf: f32 = 1.;
        if *tableItem[t] != NO_ITEM { zf = items[usize.from(u32.from(*tableItem[t]))].zf; }
        let sp = Incubator.slotPos(u32.from(t));
        let m = Mat4.fromTrs(Vec3(sp.x, 0.015, sp.z), flat, Vec3(zf, zf, zf));
        (&mut decals[t]).drawFaded(device, encoder, target, depth, vp * m, Vec4(-0.65, -0.65, 0.65, 0.65), g);
      }
      t = t + 1usize;
    }
    var k = 0usize;
    while k < items.len() {
      if items[k].shade > 0.01 {
        let e = self.eff(k);
        let hs = fmaxf(0.3, 2.5 * items[k].radius * e.w);
        let m = Mat4.fromTrs(Vec3(e.x, 0.012, e.z), flat, Vec3(1., 1., 1.));
        (&mut decals[5usize + k]).drawFaded(device, encoder, target, depth, vp * m, Vec4(0. - hs, 0. - hs, hs, hs),
          items[k].shade * items[k].flight);
      }
      k = k + 1usize;
    }
    self.drawAwText(device, encoder, target, depth, vp);
    // the writing and the pages, far to near
    var codes = List[u32]();
    var dists = List[f32]();
    k = 0usize;
    while k < items.len() {
      let f = self.labelFrame(k, eye);
      codes.push(Incubator.sortKey(0u32, u32.from(k)));
      dists.push((Vec3(f.x, f.y, f.z) - eye).length());
      if items[k].page {
        let e = self.eff(k);
        codes.push(Incubator.sortKey(4u32, 0u32));
        dists.push((Vec3(e.x, e.y, e.z) - eye).length() - 0.01);
      }
      k = k + 1usize;
    }
    var s = 0usize;
    while s < stages.len() && OLD_LINE {
      codes.push(Incubator.sortKey(2u32, u32.from(s)));
      dists.push((Vec3(-4.74, 0.45, 3.2 - 1.6 * f32.from(s)) - eye).length());
      s = s + 1usize;
    }
    var c = 0usize;
    while c < cards.len() && OLD_LINE {
      codes.push(Incubator.sortKey(3u32, u32.from(c)));
      dists.push((self.cardPlace(c) - eye).length());
      c = c + 1usize;
    }
    if reportOpen {
      codes.push(Incubator.sortKey(5u32, 0u32));
      dists.push((self.reportPos - eye).length() - 0.5);
    }
    if browserOpen {
      codes.push(Incubator.sortKey(6u32, 0u32));
      dists.push((self.browserPos - eye).length() - 0.5);
    }
    var pq = 0usize;
    while pq < pgs.len() {
      if !pgs[pq].gone && !self.tabHidden(pq) {
        codes.push(Incubator.sortKey(7u32, u32.from(pq)));
        // a pane on its board is drawn just after the board's face (and before anything nearer than the board)
        if pgs[pq].zone >= 0 && pgs[pq].foc < 0.02 { dists.push((zones[usize.from(u32.from(pgs[pq].zone))].pos - eye).length() + 1.); }
        else { dists.push((pgs[pq].pos - eye).length() - 0.5); }
      }
      pq = pq + 1usize;
    }
    var zq = 0usize;
    while zq < zones.len() {
      codes.push(Incubator.sortKey(11u32, u32.from(zq)));
      dists.push((zones[zq].pos - eye).length() + 2.);
      zq = zq + 1usize;
    }
    let dimNow = self.dimAmount();
    if dimNow > 0.01 {
      var near: f32 = 1000.;
      var dq = 0usize;
      while dq < pgs.len() {
        if pgs[dq].zone >= 0 && pgs[dq].foc > 0.02 { near = fminf(near, (pgs[dq].pos - eye).length()); }
        dq = dq + 1usize;
      }
      codes.push(Incubator.sortKey(12u32, 0u32));
      dists.push(near - 0.3);
    }
    var mq = 0usize;
    while mq < markers.len() {
      codes.push(Incubator.sortKey(8u32, u32.from(mq)));
      dists.push((markers[mq].pos - eye).length() - 0.3);
      mq = mq + 1usize;
    }
    match &desk {
      case let Some(d) {
        if d.open && d.w > 0u32 {
          codes.push(Incubator.sortKey(9u32, 0u32));
          dists.push((d.pos + Vec3(0., 1.4, 0.) - eye).length());
          codes.push(Incubator.sortKey(10u32, 0u32));
          dists.push((d.pos + Vec3(0., 0.84, 0.) - eye).length() - 0.01);
        }
      }
      else {}
    }
    var list = List[u32]();
    var lq = 0usize;
    while lq < chipKinds.len() { list.push(*chipKinds[lq]); lq = lq + 1usize; }
    if chipAnchor >= 0 {
      var q = 0usize;
      while q < list.len() {
        if chips[usize.from(*list[q])].alpha > 0.01 {
          let f = self.chipFrame(q, list.len(), eye);
          codes.push(Incubator.sortKey(1u32, u32.from(q)));
          dists.push((Vec3(f.x, f.y, f.z) - eye).length() - 0.02);
        }
        q = q + 1usize;
      }
    }
    var i = 1usize;
    while i < codes.len() {
      var j = i;
      while j > 0usize && *dists[j - 1usize] < *dists[j] {
        let dc = *dists[j]; dists.set(j, *dists[j - 1usize]); dists.set(j - 1usize, dc);
        let cc = *codes[j]; codes.set(j, *codes[j - 1usize]); codes.set(j - 1usize, cc);
        j = j - 1usize;
      }
      i = i + 1usize;
    }
    let hotPhase = (now / 600u64) % 2u64 == 0u64;
    var n = 0usize;
    while n < codes.len() {
      let code = *codes[n];
      let kind = code / 1000u32;
      let idx = usize.from(code % 1000u32);
      if kind == 0u32 {
        let f = self.labelFrame(idx, eye);
        let m = Incubator.faceModel(Vec3(f.x, f.y, f.z), eye);
        let hw = items[idx].label.w * f.w * 0.5;
        let hh = items[idx].label.h * f.w * 0.5;
        Incubator.faded(&mut items[idx].label, device, encoder, target, depth, vp * m, Vec4(0. - hw, 0. - hh, hw, hh), 1.);
      }
      else if kind == 1u32 {
        let f = self.chipFrame(idx, list.len(), eye);
        let m = Incubator.faceModel(Vec3(f.x, f.y, f.z), eye);
        let which = usize.from(*list[idx]);
        let hw = chips[which].w * f.w * 0.5;
        let hh = chips[which].h * f.w * 0.5;
        Incubator.faded(&mut chips[which], device, encoder, target, depth, vp * m, Vec4(0. - hw, 0. - hh, hw, hh), 1.);
      }
      else if kind == 2u32 {
        let m = Mat4.fromTrs(Vec3(-4.74, 0.45, 3.2 - 1.6 * f32.from(idx)), Quat.angleAxis(PI * 0.5, Vec3(0., 1., 0.)), Vec3(1., 1., 1.));
        Incubator.faded(&mut stages[idx], device, encoder, target, depth, vp * m, Vec4(-0.45, -0.1125, 0.45, 0.1125), 1.);
      }
      else if kind == 3u32 {
        let m = Mat4.fromTrs(self.cardPlace(idx), Quat.angleAxis(PI * 0.5, Vec3(0., 1., 0.)), Vec3(1., 1., 1.));
        let a = cards[idx].alpha;
        if cards[idx].hot && hotPhase {
          Incubator.faded(&mut cards[idx].glow, device, encoder, target, depth, vp * m, Vec4(-0.55, -0.1375, 0.55, 0.1375), a);
        } else {
          Incubator.faded(&mut cards[idx].calm, device, encoder, target, depth, vp * m, Vec4(-0.55, -0.1375, 0.55, 0.1375), a);
        }
      }
      else if kind == 9u32 || kind == 10u32 {
        match &mut desk { case var &mut Some(d) { d.drawAll(device, encoder, target, depth, vp, kind - 9u32); } else {} }
      }
      else if kind == 6u32 {
        match &mut browserPanel {
          case var &mut Some(p) { p.drawPageDepth(device, encoder, target, depth, vp * self.browserModel()); }
          else {}
        }
        if CHIPS_ON && pgChips.len() > 0usize {
          let cx = pgHalfW(false) - 0.19;
          let cy = pgTop(false) + 0.05;
          Incubator.faded(&mut pgChips[0usize], device, encoder, target, depth, vp * self.browserModel(),
            Vec4(cx - PG_CHIP_W * 0.5, cy - PG_CHIP_H * 0.5, cx + PG_CHIP_W * 0.5, cy + PG_CHIP_H * 0.5), 1.);
        }
      }
      else if kind == 7u32 {
        let pm = self.pgModel(idx);
        let web = pgs[idx].web;
        if web {
          match &mut pgs[idx].wp { case var &mut Some(w) { w.drawLocal(device, encoder, target, depth, vp * pm); } else {} }
        } else {
          match &mut pgs[idx].doc { case var &mut Some(p) { p.drawPageDepth(device, encoder, target, depth, vp * pm); } else {} }
        }
        let hw = pgHalfW(web);
        let top = pgTop(web);
        if !pgs[idx].shelved {
          var c = 0usize;
          while CHIPS_ON && c < self.chipCount(idx) {
            let cx = hw - 0.19 - 0.39 * f32.from(u32.from(c));
            let cy = top + 0.05;
            let cl = if pgs[idx].zone >= 0 && pgs[idx].foc > 0.5 { 1usize } else { c };
            Incubator.faded(&mut pgs[idx].chips[cl], device, encoder, target, depth, vp * pm,
              Vec4(cx - PG_CHIP_W * 0.5, cy - PG_CHIP_H * 0.5, cx + PG_CHIP_W * 0.5, cy + PG_CHIP_H * 0.5), 1.);
            c = c + 1usize;
          }
          if pgs[idx].tab {
            let order = self.tabList();
            var s = 0usize;
            while s < order.len() {
              let rc = self.tabRect(s, order.len());
              Incubator.faded(&mut pgs[*order[s]].title, device, encoder, target, depth, vp * pm, rc, 1.);
              s = s + 1usize;
            }
            if pgChips.len() >= 4usize {
              Incubator.faded(&mut pgChips[1usize], device, encoder, target, depth, vp * pm, self.tabPlusRect(order.len()), 1.);
              Incubator.faded(&mut pgChips[2usize], device, encoder, target, depth, vp * pm, self.tabCloseRect(order.len()), 1.);
              Incubator.faded(&mut pgChips[3usize], device, encoder, target, depth, vp * pm, self.addrRect(), 1.);
            }
          } else {
            Incubator.faded(&mut pgs[idx].title, device, encoder, target, depth, vp * pm, Vec4(0. - hw, top + 0.1, 0. - hw + 0.8, top + 0.3), 1.);
          }
        } else {
          Incubator.faded(&mut pgs[idx].title, device, encoder, target, depth, vp * pm, Vec4(0. - hw, top + 0.05, 0. - hw + 1.6, top + 0.45), 1.);
        }
      }
      else if kind == 11u32 {
        self.drawZone(idx, device, encoder, target, depth, vp, hotPhase);
      }
      else if kind == 12u32 {
        match &mut dimPass {
          case var &mut Some(dp) {
            let inv = vp.inverse();
            let p0 = inv * Vec4(0., 0., 0., 1.);
            let p1 = inv * Vec4(0., 0., 1., 1.);
            let a = p0.xyz() * (1. / p0.w);
            let b = p1.xyz() * (1. / p1.w);
            let d = (b - a).normalize();
            let m = Incubator.faceModel(eye + d * 0.5, eye);
            dp.drawFaded(device, encoder, target, depth, vp * m, Vec4(-3., -3., 3., 3.), FOCUS_DIM * dimNow);
          }
          else {}
        }
      }
      else if kind == 8u32 {
        let mm = Incubator.faceModel(markers[idx].pos, eye);
        Incubator.faded(&mut markers[idx].post, device, encoder, target, depth, vp * mm, Vec4(-0.03, 0., 0.03, 1.5), 1.);
        Incubator.faded(&mut markers[idx].label, device, encoder, target, depth, vp * mm, Vec4(-0.36, 1.5, 0.36, 1.68), 1.);
      }
      else if kind == 5u32 {
        match &mut reportPanel {
          case var &mut Some(p) { p.drawPageDepth(device, encoder, target, depth, vp * self.reportModel()); }
          else {}
        }
      }
      else {
        match panel {
          case var &mut Some(p) { p.drawPageDepth(device, encoder, target, depth, vp * self.pageModel()); }
          else {}
        }
      }
      n = n + 1usize;
    }
    pal.draw(device, encoder, target, depth, vp, eye, now);
    // the level readout at the foot of the view, 0.8 m from the eye along the ray through the bottom of the screen
    if readout[0usize].alpha > 0.01 {
      let inv = vp.inverse();
      let p0 = inv * Vec4(0., -0.86, 0., 1.);
      let p1 = inv * Vec4(0., -0.86, 1., 1.);
      let a = p0.xyz() * (1. / p0.w);
      let b = p1.xyz() * (1. / p1.w);
      let dir = (b - a).normalize();
      let at = eye + dir * 0.8;
      let m = Incubator.faceModel(at, eye);
      let hw = readout[0usize].w * 0.5 * 0.5;
      let hh = readout[0usize].h * 0.5 * 0.5;
      let r = &mut readout[0usize];
      if r.ok { r.pass.drawFaded(device, encoder, target, depth, vp * m, Vec4(0. - hw, 0. - hh, hw, hh), r.alpha); }
    }
    // the red card of a file that does not read: higher up the view, the same way
    let errWant: f32 = if errShown.len() > 0usize { 1. } else { 0. };
    match &mut errCard {
      case var &mut Some(ec) {
        if ec.ok && ec.alpha > 0.01 {
          let inv = vp.inverse();
          let p0 = inv * Vec4(0., -0.55, 0., 1.);
          let p1 = inv * Vec4(0., -0.55, 1., 1.);
          let a = p0.xyz() * (1. / p0.w);
          let b = p1.xyz() * (1. / p1.w);
          let dir = (b - a).normalize();
          let m = Incubator.faceModel(eye + dir * 0.8, eye);
          let hw = ec.w * 0.5 * 0.7;
          let hh = ec.h * 0.5 * 0.7;
          ec.pass.drawFaded(device, encoder, target, depth, vp * m, Vec4(0. - hw, 0. - hh, hw, hh), ec.alpha);
        }
      }
      else {}
    }
  }

  // Test flag: the Nth shown chip of the selection, as a click would take it
  pub fn menuNth(self: &mut, n: usize, v: &Fly) bool {
    if sel < 0 { return false; }
    let si = usize.from(u32.from(sel));
    let ents = self.visibleEntries(si);
    if n >= ents.len() { return false; }
    let act = items[si].menu[*ents[n]].action.clone();
    print <- "incubator: menu "; print <- n; print <- " ("; printStr(act.view()); print <- ")\n";
    self.doAction(act.view(), v)
  }

  // ---- zones: the boards at the back (zones.cone) ----

  fn zoneModel(self: &, zi: usize) Mat4 {
    let s = zones[zi].width / ZN_DW;
    Mat4.fromTrs(zones[zi].pos, Quat.angleAxis(zones[zi].yaw, Vec3(0., 1., 0.)), Vec3(s, s, s))
  }

  fn paneName(kind: u32) &str {
    if kind == ZP_SITE { "site" } else if kind == ZP_REPO { "repo" } else if kind == ZP_INCUBATOR { "incubator" }
    else if kind == ZP_PROJECTS { "projects" } else if kind == ZP_LINE { "line" } else { "diagram" }
  }

  fn chipCount(self: &, i: usize) usize {
    if pgs[i].zone >= 0 { 1usize } else if pgs[i].web { 3usize } else { 5usize }
  }

  // Where pane i of a board stands in its place: x, y, z of its frame's origin, and its scale
  fn paneRest(self: &, i: usize) Vec4 {
    let zi = usize.from(u32.from(pgs[i].zone));
    let r = *zones[zi].rects[usize.from(pgs[i].pane)];
    let web = pgs[i].web;
    let nw = pgHalfW(web) * 2.;
    let nh = nw * (if web { f32.from(WEB_TEX_H) / f32.from(WEB_TEX_W) } else { f32.from(DOC_TEX_H) / f32.from(DOC_TEX_W) });
    let fit = fminf(r.z / nw, r.w / nh);
    let cy = f32.from(DOC_CENTRE_Y);
    let p = self.zoneModel(zi) * Vec3(r.x + r.z * 0.5 - ZN_DW * 0.5, r.y + r.w * 0.5 - cy * fit, 0.04);
    Vec4(p.x, p.y, p.z, fit * zones[zi].width / ZN_DW)
  }

  // Each frame: pane i is on its board, flying to the workbench, there, or flying back
  fn panePose(self: &mut, i: usize, dt: f32) {
    let zi = usize.from(u32.from(pgs[i].zone));
    let rest = self.paneRest(i);
    var f = pgs[i].foc;
    let tgt: f32 = if pgs[i].wantFoc { 1. } else { 0. };
    let step = dt / 0.7;
    if f < tgt { f = fminf(f + step, tgt); } else { f = fmaxf(f - step, tgt); }
    (&mut pgs[i]).foc = f;
    let e = f * f * (3. - 2. * f);
    let web = pgs[i].web;
    let fsc: f32 = if web { 0.85 } else { 0.78 };
    let cy = f32.from(DOC_CENTRE_Y);
    let fpos = Vec3(0., 1.35 - cy * fsc, 0. - FOCUS_D);
    var p = Vec3(rest.x, rest.y, rest.z).lerp(fpos, e);
    p.y = p.y + 0.3 * sin(PI * e);
    let ry = zones[zi].yaw;
    (&mut pgs[i]).pos = p;
    (&mut pgs[i]).yaw = ry + turnBetween(ry, 0.) * e;
    (&mut pgs[i]).sc = rest.w + (fsc - rest.w) * e;
    (&mut pgs[i]).toPos = p; (&mut pgs[i]).fromPos = p;
    (&mut pgs[i]).fly = 1.;
  }

  // The focus chip: bring the pane to the workbench, or send it back; one at a time
  fn focusPane(self: &mut, i: usize) {
    if i >= pgs.len() || pgs[i].zone < 0 || pgs[i].gone { return; }
    let on = !pgs[i].wantFoc;
    var j = 0usize;
    while j < pgs.len() { if pgs[j].zone >= 0 { (&mut pgs[j]).wantFoc = false; } j = j + 1usize; }
    (&mut pgs[i]).wantFoc = on;
    print <- "zones: "; print <- (if on { "focus " } else { "release " }); printStr(pgs[i].id.view()); print <- "\n";
  }

  fn dimAmount(self: &) f32 {
    var d: f32 = 0.;
    var i = 0usize;
    while i < pgs.len() { if pgs[i].zone >= 0 && !pgs[i].gone && pgs[i].foc > d { d = pgs[i].foc; } i = i + 1usize; }
    d
  }

  fn paneIndex(self: &, zi: usize, kind: u32) i32 {
    var i = 0usize;
    while i < pgs.len() {
      if pgs[i].zone == i32.from(zi) && pgs[i].pane == kind && !pgs[i].gone { return i32.from(i); }
      i = i + 1usize;
    }
    -1
  }

  fn paneSrc(self: &, zi: usize, kind: u32) String {
    let z = &zones[zi];
    if kind == ZP_SITE { return z.site.clone(); }
    if kind == ZP_DIAGRAM {
      // the board's Diagrams folder, listed (a file named here stands for its folder); a click on a diagram opens it rendered
      if z.diagram.len() == 0usize { return String(); }
      var dir = normalizePath(z.diagram.view());
      if !fs.isDir(&Path.from(dir.view())) { dir = dirOf(dir.view()); }
      var s = String.from(TREE_PREFIX);
      s.append(dir.view());
      return s;
    }
    let root = if kind == ZP_REPO { z.repo.view() } else { z.incubator.view() };
    if root.len() == 0usize { return String(); }
    var s = String.from(TREE_PREFIX);
    s.append(root);
    s
  }

  fn openPane(self: &mut, device: &mut Device, renderer: &mut Renderer, zi: usize, kind: u32) {
    let src = self.paneSrc(zi, kind);
    if src.len() == 0usize { return; }
    self.ensureChips(device);
    let t0 = sdl.GetPerformanceCounter();
    let web = isWebSrc(src.view());
    var doc: Option[DocPanel] = None;
    var wp: Option[WebPanel] = None;
    var okp = true;
    if web {
      wp = WebPanel.create(device, format, src.view());
      match &wp { case let Some(w0) {} case is None { okp = false; } }
    } else {
      doc = DocPanel.create(device, renderer, format, src.view(), 0.);
      match &doc { case let Some(d0) {} case is None { okp = false; } }
    }
    if !okp { print <- "zones: could not open "; printStr(src.view()); print <- "\n"; return; }
    var pid = String.from(zones[zi].id.view());
    pid.append("-");
    pid.append(Incubator.paneName(kind));
    var shown = String.from(zones[zi].name.view());
    shown.append(": ");
    shown.append(Incubator.paneName(kind));
    if kind == ZP_REPO || kind == ZP_INCUBATOR { shown.append("  "); shown.append(folderName(src.slice(TREE_PREFIX.len(), src.len())).view()); }
    let tl = self.mkLabel(device, shown.view(), 0xf8f5eeffu32, 0x1c1c1cffu32, fitSize(shown.len(), 56.), 0.8, 0.2);
    var chips = List[Label]();
    chips.push(self.mkLabel(device, "focus", 0x3a78b0ffu32, 0xffffffffu32, 56., PG_CHIP_W, PG_CHIP_H));
    chips.push(self.mkLabel(device, "release", 0xc08a20ffu32, 0xffffffffu32, 56., PG_CHIP_W, PG_CHIP_H));
    let born = self.newBorn();
    let at = Vec3(0., 0., 0.);
    pgs.push(Pg(pid.clone(), src.clone(), web, doc, wp, tl, chips, born, at, 0., 1., at, 0., 1., at, 0., 1., String()));
    let n = pgs.len() - 1usize;
    (&mut pgs[n]).zone = i32.from(zi);
    (&mut pgs[n]).pane = kind;
    let rest = self.paneRest(n);
    (&mut pgs[n]).pos = Vec3(rest.x, rest.y, rest.z);
    (&mut pgs[n]).toPos = pgs[n].pos; (&mut pgs[n]).fromPos = pgs[n].pos;
    (&mut pgs[n]).yaw = zones[zi].yaw; (&mut pgs[n]).toYaw = zones[zi].yaw; (&mut pgs[n]).fromYaw = zones[zi].yaw;
    (&mut pgs[n]).sc = rest.w; (&mut pgs[n]).toSc = rest.w; (&mut pgs[n]).fromSc = rest.w;
    self.restoreTree(device, renderer, n);
    print <- "zones: opened "; printStr(pid.view()); print <- " ("; printStr(src.view()); print <- ") in ";
    print <- f64.from((sdl.GetPerformanceCounter() - t0) * 1000000u64 / sdl.GetPerformanceFrequency()) / 1000.; print <- " ms\n";
  }

  // A tree pane takes the folders room.toml says it had open
  fn restoreTree(self: &mut, device: &mut Device, renderer: &mut Renderer, n: usize) {
    var open = List[String]();
    var found = false;
    var t = 0usize;
    while t < roomGood.trees.len() {
      if roomGood.trees[t].id.view() == pgs[n].id.view() {
        found = true;
        var q = 0usize;
        while q < roomGood.trees[t].open.len() { open.push(roomGood.trees[t].open[q].clone()); q = q + 1usize; }
      }
      t = t + 1usize;
    }
    if !found { return; }
    match &mut pgs[n].doc { case var &mut Some(p) { if isTree(p.file.view()) { p.setOpenDirs(device, renderer, &open); } } else {} }
  }

  // The folders a tree has open go to room.toml (a second after the last change)
  fn syncTrees(self: &mut) {
    var ids = List[String]();
    var opens = List[List[String]]();
    var i = 0usize;
    while i < pgs.len() {
      match &mut pgs[i].doc {
        case var &mut Some(p) {
          if p.treeDirty {
            p.treeDirty = false;
            ids.push(pgs[i].id.clone());
            var o = List[String]();
            var q = 0usize;
            while q < p.openDirs.len() { o.push(p.openDirs[q].clone()); q = q + 1usize; }
            opens.push(o);
          }
        }
        else {}
      }
      i = i + 1usize;
    }
    match &mut browserPanel {
      case var &mut Some(p) {
        if p.treeDirty {
          p.treeDirty = false;
          ids.push(String.from("browser"));
          var o = List[String]();
          var q = 0usize;
          while q < p.openDirs.len() { o.push(p.openDirs[q].clone()); q = q + 1usize; }
          opens.push(o);
        }
      }
      else {}
    }
    var k = 0usize;
    while k < ids.len() {
      var at = roomGood.trees.len();
      var t = 0usize;
      while t < roomGood.trees.len() { if roomGood.trees[t].id.view() == ids[k].view() { at = t; } t = t + 1usize; }
      if at == roomGood.trees.len() { roomGood.trees.push(TreeCfg(ids[k].clone(), List[String]())); }
      var o = List[String]();
      var q = 0usize;
      while q < opens[k].len() { o.push(opens[k][q].clone()); q = q + 1usize; }
      roomGood.trees[at].open = o;
      print <- "zones: tree "; printStr(ids[k].view()); print <- " keeps "; print <- opens[k].len(); print <- " folders open\n";
      writeAt = nowMs() + 1000u64;
      k = k + 1usize;
    }
  }

  // The projects pane's cell j, and the line strip's slot s, as rectangles in the board's design frame
  // four columns of 4:1 cards, five rows
  fn projRect(self: &, zi: usize, j: usize) Vec4 {
    let r = *zones[zi].rects[3usize];
    let cw = r.z / 4.;
    let hw = (cw - 0.04) * 0.5;
    let cx = r.x - ZN_DW * 0.5 + cw * (f32.from(u32.from(j % 4usize)) + 0.5);
    let cy = r.y + r.w - (r.w / 5.) * (f32.from(u32.from(j / 4usize)) + 0.5);
    Vec4(cx - hw, cy - hw * 0.25, cx + hw, cy + hw * 0.25)
  }

  fn projCount(self: &, zi: usize) usize { zones[zi].projLabels.len() + zones[zi].planLabels.len() }

  fn stripRect(self: &, zi: usize, s: usize) Vec4 {
    let r = *zones[zi].rects[4usize];
    let cw = r.z / 2.;
    let hw = (cw - 0.1) * 0.5;
    let cx = r.x - ZN_DW * 0.5 + cw * (f32.from(u32.from(s % 2usize)) + 0.5);
    let cy = r.y + r.w - (r.w / 4.) * (f32.from(u32.from(s / 2usize)) + 0.5);
    Vec4(cx - hw, cy - hw * 0.25, cx + hw, cy + hw * 0.25)
  }

  // What a ray meets of the boards' own labels: kind 1 a project (ix), 2 a line card (ix); the distance, or -1
  fn zoneHit(self: &, eye: Vec3, dir: Vec3, kind: &mut u32, zo: &mut usize, ix: &mut usize) f32 {
    *kind = 0u32;
    var best: f32 = -1.;
    var zi = 0usize;
    while zi < zones.len() {
      let m = self.zoneModel(zi);
      var j = 0usize;
      while j < self.projCount(zi) {
        let t = quadHit(m, self.projRect(zi, j), eye, dir);
        if t > 0. && (best < 0. || t < best) { best = t; *kind = 1u32; *zo = zi; *ix = j; }
        j = j + 1usize;
      }
      var s = 0usize;
      while s < zones[zi].strip.len() {
        let t = quadHit(m, self.stripRect(zi, s + 1usize), eye, dir);
        if t > 0. && (best < 0. || t < best) { best = t; *kind = 2u32; *zo = zi; *ix = s; }
        s = s + 1usize;
      }
      zi = zi + 1usize;
    }
    best
  }

  fn boardHit(self: &, zi: usize, eye: Vec3, dir: Vec3) f32 {
    quadHit(self.zoneModel(zi), Vec4(0. - ZN_DW * 0.5, ZN_BASE, ZN_DW * 0.5, ZN_BASE + ZN_DH), eye, dir)
  }

  fn openPlanCard(self: &mut, zi: usize, pj: usize) {
    if zi >= zones.len() || pj >= zones[zi].planFiles.len() { return; }
    let f = zones[zi].planFiles[pj].clone();
    print <- "zones: plan card "; printStr(zones[zi].planLabels[pj].text.view()); print <- " opens "; printStr(f.view()); print <- "\n";
    if f.len() > 0usize { var b = String.from("bench:"); b.append(f.view()); self.wantPage(b.view()); }
  }

  fn clickZones(self: &mut, eye: Vec3, dir: Vec3, limit: f32) bool {
    var k = 0u32;
    var zi = 0usize;
    var ix = 0usize;
    let t = self.zoneHit(eye, dir, &mut k, &mut zi, &mut ix);
    if t < 0. || (limit > 0. && t > limit) { return false; }
    if k == 1u32 && ix >= zones[zi].projLabels.len() {
      // a skein card of the plan: its first file opens as a page on the workbench
      self.openPlanCard(zi, ix - zones[zi].projLabels.len());
      return true;
    }
    if k == 1u32 {
      let it = *zones[zi].projItem[ix];
      if it >= 0 {
        let ku = usize.from(u32.from(it));
        print <- "zones: project "; printStr(items[ku].name.view()); print <- "\n";
        if !items[ku].onTable { _ = self.bring(ku); }
        self.select(it);
      }
      return true;
    }
    if k == 2u32 {
      let rp = zones[zi].strip[ix].report.clone();
      print <- "zones: line card "; printStr(zones[zi].strip[ix].id.view()); print <- "\n";
      if rp.len() > 0usize { var b = String.from("bench:"); b.append(rp.view()); self.wantPage(b.view()); }
      return true;
    }
    false
  }

  fn copyZoneCfg(z: &ZoneCfg) ZoneCfg {
    var r = newZoneCfg(z.id.view());
    r.name = z.name.clone(); r.place = z.place.clone(); r.yaw = z.yaw; r.hasYaw = z.hasYaw; r.width = z.width; r.hasWidth = z.hasWidth;
    r.site = z.site.clone(); r.repo = z.repo.clone(); r.incubator = z.incubator.clone(); r.diagram = z.diagram.clone();
    r.projects = z.projects.clone(); r.line = z.line.clone(); r.at = z.at.clone();
    var i = 0usize;
    while i < 6usize { r.rects.set(i, z.rects[i].clone()); i = i + 1usize; }
    r
  }

  fn makeZone(self: &mut, device: &mut Device, c: &ZoneCfg) Zone {
    let nm = if c.name.len() > 0usize { c.name.clone() } else { c.id.clone() };
    var rects = List[Vec4]();
    var i = 0usize;
    while i < ZN_PANES { rects.push(defaultRect(i)); i = i + 1usize; }
    let title = self.mkLabel(device, nm.view(), 0x2a3340ffu32, 0xffffffffu32, 70., 1.6, 0.4);
    let none = self.mkLabel(device, "no projects yet", 0xe9e4d8ffu32, 0x555555ffu32, 48., 2.4, 0.6);
    let count = self.mkLabel(device, "-", 0x2a3340ffu32, 0xffffffffu32, 44., 1.1, 0.275);
    Zone(c.id.clone(), nm, Vec3(0., 0., 0. - 6.), 0., 7.2, Vec3(0., 0., 0. - 6.), 0., 7.2, String(), String(), String(), String(),
      String.from(c.id.view()), List[String](), rects, 0u32, nowMs() + 2500u64, title, makeBoardPass(device, format),
      List[Label](), List[i32](), List[bool](), none, List[StripCard](), count, Vec4(0., 0., 0., 0.),
      String(), 0i64, 0i64, 0u64, List[Label](), List[String]())
  }

  // incubator.toml's boards (or the built-in two if the file has none), under room.toml's moves; what changed is applied, flying
  fn applyZones(self: &mut, device: &mut Device) {
    var eff = List[ZoneCfg]();
    var i = 0usize;
    if incubatorGood.zones.len() > 0usize {
      while i < incubatorGood.zones.len() { eff.push(Incubator.copyZoneCfg(&incubatorGood.zones[i])); i = i + 1usize; }
    } else {
      let d = parseConfig(zonesDefaultText().view(), "defaults");
      while i < d.zones.len() { eff.push(Incubator.copyZoneCfg(&d.zones[i])); i = i + 1usize; }
    }
    var e = 0usize;
    while e < eff.len() {
      var c = Incubator.copyZoneCfg(&eff[e]);
      var r = 0usize;
      while r < roomGood.zones.len() {
        let rz = &roomGood.zones[r];
        if rz.id.view() == c.id.view() && rz.at.view() >= c.at.view() {
          if rz.place.len() > 0usize { c.place = rz.place.clone(); }
          if rz.hasYaw { c.yaw = rz.yaw; c.hasYaw = true; }
          if rz.hasWidth { c.width = rz.width; c.hasWidth = true; }
        }
        r = r + 1usize;
      }
      var zi = 0usize;
      var have = false;
      while zi < zones.len() { if zones[zi].id.view() == c.id.view() { have = true; break; } zi = zi + 1usize; }
      if !have { let made = self.makeZone(device, &c); zones.push(made); zi = zones.len() - 1usize; }
      var pl = Place(3u32, 0u32, 0., 0., 0. - 6.);
      if c.place.len() > 0usize { _ = parsePlace(c.place.view(), &mut pl); }
      let wp = Vec3(pl.x, pl.y, pl.z);
      let wy = (if c.hasYaw { f32.from(i32.from(c.yaw)) } else { 0. }) * PI / 180.;
      let ww = if c.hasWidth { f32.from(i32.from(c.width)) / 100. } else { 7.2 };
      let moved = (wp - zones[zi].wantPos).length() > 0.001 || (wy - zones[zi].wantYaw).abs() > 0.0005 || (ww - zones[zi].wantWidth).abs() > 0.001;
      (&mut zones[zi]).wantPos = wp; (&mut zones[zi]).wantYaw = wy; (&mut zones[zi]).wantWidth = ww;
      if !have {
        (&mut zones[zi]).pos = wp; (&mut zones[zi]).yaw = wy; (&mut zones[zi]).width = ww;
      } else if moved {
        print <- "incubator: zone '"; printStr(c.id.view()); print <- "' now at ("; print <- wp.x; print <- ", "; print <- wp.z; print <- ") yaw "; print <- wy * 180. / PI;
        print <- " width "; print <- ww; print <- "\n";
      }
      (&mut zones[zi]).lineKey = if c.line.len() > 0usize { c.line.clone() } else { c.id.clone() };
      if c.name.len() > 0usize && zones[zi].name.view() != c.name.view() {
        (&mut zones[zi]).name = c.name.clone(); (&mut zones[zi]).title.text = c.name.clone(); (&mut zones[zi]).title.ok = false;
      }
      var k = 0usize;
      while k < ZN_PANES {
        var rc = defaultRect(k);
        var parsed = Vec4(0., 0., 0., 0.);
        if c.rects[k].len() > 0usize && parseRect(c.rects[k].view(), &mut parsed) { rc = parsed; }
        zones[zi].rects.set(k, rc);
        k = k + 1usize;
      }
      // sources: a changed one closes its pane, and the queue opens it again
      let srcs = [c.site.clone(), c.repo.clone(), c.incubator.clone(), String(), String(), c.diagram.clone()];
      k = 0usize;
      while k < ZN_PANES {
        if k != 3usize && k != 4usize {
          let want = srcs[k].clone();
          let kind = u32.from(k);
          var cur = String();
          if kind == ZP_SITE { cur = zones[zi].site.clone(); } else if kind == ZP_REPO { cur = zones[zi].repo.clone(); }
          else if kind == ZP_INCUBATOR { cur = zones[zi].incubator.clone(); } else { cur = zones[zi].diagram.clone(); }
          if cur.view() != want.view() {
            let pg = self.paneIndex(zi, kind);
            if pg >= 0 { (&mut pgs[usize.from(u32.from(pg))]).gone = true; }
            (&mut zones[zi]).made = zones[zi].made & (0xFFFFFFFFu32 ^ (1u32 << kind));
            if kind == ZP_SITE { (&mut zones[zi]).site = want.clone(); } else if kind == ZP_REPO { (&mut zones[zi]).repo = want.clone(); }
            else if kind == ZP_INCUBATOR { (&mut zones[zi]).incubator = want.clone(); } else { (&mut zones[zi]).diagram = want.clone(); }
          }
        }
        k = k + 1usize;
      }
      // projects
      let ids = cfgSplit(c.projects.view(), ',');
      var same = ids.len() == zones[zi].projIds.len() && !(ids.len() == 1usize && ids[0usize].len() == 0usize && zones[zi].projIds.len() == 0usize);
      if same {
        var q = 0usize;
        while q < ids.len() { if ids[q].view() != zones[zi].projIds[q].view() { same = false; } q = q + 1usize; }
      }
      if !same {
        var pids = List[String]();
        var labels = List[Label]();
        var pitems = List[i32]();
        var pon = List[bool]();
        var q = 0usize;
        while q < ids.len() {
          let ik = self.itemById(ids[q].view());
          if ik >= 0 && ids[q].len() > 0usize {
            let iu = usize.from(u32.from(ik));
            pids.push(ids[q].clone());
            pitems.push(ik);
            pon.push(items[iu].onTable);
            labels.push(self.mkCard(device, items[iu].name.view(), if items[iu].onTable { 0xcfe6d2ffu32 } else { 0xf8f5eeffu32 }, 0x1c1c1cffu32, 1.2, 0.3));
          }
          q = q + 1usize;
        }
        (&mut zones[zi]).projIds = pids; (&mut zones[zi]).projLabels = labels; (&mut zones[zi]).projItem = pitems; (&mut zones[zi]).projOn = pon;
      }
      e = e + 1usize;
    }
    var haveDim = false;
    match &dimPass { case let Some(d0) { haveDim = true; } else {} }
    if !haveDim { dimPass = Some[PagePass](makeVeilPass(device, format)); }
    self.rebuildStripsNow();
  }

  // The line strips again from the cards now held (also after the boards are first made)
  fn rebuildStripsNow(self: &mut) {
    lineText = String();
  }

  // The live cards of line.json whose zone is the board's: building, testing, review or a question; done work is a count
  fn buildStrips(self: &mut, l: &mut Labeller, device: &mut Device, fresh: &List[Card]) {
    var zi = 0usize;
    while zi < zones.len() {
      var live = List[usize]();
      var pass = 0u32;
      while pass < 2u32 {
        var c = 0usize;
        while c < fresh.len() {
          if fresh[c].zone.view() == zones[zi].lineKey.view() {
            let isLive = fresh[c].hot || (fresh[c].stage >= 1u32 && fresh[c].stage <= 3u32);
            if isLive && (fresh[c].hot == (pass == 0u32)) { live.push(c); }
          }
          c = c + 1usize;
        }
        pass = pass + 1u32;
      }
      var done = 0u32;
      var queued = 0u32;
      var c2 = 0usize;
      while c2 < fresh.len() {
        if fresh[c2].zone.view() == zones[zi].lineKey.view() && !fresh[c2].hot {
          if fresh[c2].stage == 4u32 { done = done + 1u32; } else if fresh[c2].stage == 0u32 { queued = queued + 1u32; }
        }
        c2 = c2 + 1usize;
      }
      var strip = List[StripCard]();
      var shown = 0usize;
      while shown < live.len() && shown < 7usize {
        let cd = &fresh[*live[shown]];
        let calm = cardLabel(l, device, format, cd.calm.text.view(), cd.calm.progress, cd.hot, false);
        let glow = cardLabel(l, device, format, cd.calm.text.view(), cd.calm.progress, cd.hot, true);
        strip.push(StripCard(cd.id.clone(), cd.report.clone(), cd.hot, calm, glow));
        shown = shown + 1usize;
      }
      var ct = String.from(numText(i64.from(done)).view());
      ct.append(" done");
      if queued > 0u32 { ct.append(", "); ct.append(numText(i64.from(queued)).view()); ct.append(" queued"); }
      if live.len() > 7usize { ct.append(", +"); ct.append(numText(i64.from(live.len() - 7usize)).view()); ct.append(" live"); }
      (&mut zones[zi]).strip = strip;
      (&mut zones[zi]).count.text = ct.clone();
      (&mut zones[zi]).count.size = cardSize(ct.len());
      (&mut zones[zi]).count.top = cardTop(ct.len(), zones[zi].count.size);
      (&mut zones[zi]).count.ok = false;
      zi = zi + 1usize;
    }
  }

  // The projects strip from the board's plan: one card per Active and Design skein, then "+N more" and the Backlog count; read again
  // when the plan's file changes
  fn pollPlan(self: &mut, device: &mut Device, zi: usize, now: u64) {
    if now < zones[zi].planNext { return; }
    (&mut zones[zi]).planNext = now + 1500u64;
    let inc = normalizePath(zones[zi].incubator.view());
    if zones[zi].planPath.len() == 0usize || dirOf(zones[zi].planPath.view()).view() != inc.view() {
      (&mut zones[zi]).planPath = findPlanFile(inc.view());
      (&mut zones[zi]).planStamp = 0i64; (&mut zones[zi]).planSize = 0i64;
      if zones[zi].planPath.len() == 0usize { (&mut zones[zi]).planNext = now + 5000u64; return; }
    }
    match fs.stat(&Path.from(zones[zi].planPath.view())) {
      case let Ok(info) {
        let m = info.modified.unixSeconds();
        if m == zones[zi].planStamp && info.size == zones[zi].planSize { return; }
        (&mut zones[zi]).planStamp = m;
        (&mut zones[zi]).planSize = info.size;
      }
      case let Err(e) { return; }
    }
    match fs.readFile(&Path.from(zones[zi].planPath.view())) {
      case let Ok(txt) {
        let pr = parsePlan(txt.view(), zones[zi].planPath.view());
        var labels = List[Label]();
        var files = List[String]();
        let room = if zones[zi].projLabels.len() < 20usize { 20usize - zones[zi].projLabels.len() } else { 1usize };
        var show = pr.cards.len();
        let more = if pr.cards.len() + 1usize > room { pr.cards.len() + 2usize - room } else { 0usize };
        if more > 0usize { show = pr.cards.len() - more; }
        var c = 0usize;
        while c < show {
          let pc = &pr.cards[c];
          labels.push(self.mkCard(device, pc.title.view(), if pc.design { 0xdfe9f3ffu32 } else { 0xf8f5eeffu32 }, 0x1c1c1cffu32, 1.0, 0.25));
          files.push(pc.file.clone());
          c = c + 1usize;
        }
        if more > 0usize {
          var mt = String.from("+");
          mt.append(numText(i64.from(more)).view());
          mt.append(" more skeins");
          labels.push(self.mkCard(device, mt.view(), 0xe9e4d8ffu32, 0x333333ffu32, 1.0, 0.25));
          files.push(zones[zi].planPath.clone());
        }
        var bt = String.from("Backlog: ");
        bt.append(numText(i64.from(pr.backlog)).view());
        labels.push(self.mkCard(device, bt.view(), 0x2a3340ffu32, 0xffffffffu32, 1.0, 0.25));
        files.push(zones[zi].planPath.clone());
        print <- "zones: plan "; printStr(zones[zi].planPath.view()); print <- ": "; print <- pr.cards.len(); print <- " skeins, backlog "; print <- pr.backlog; print <- "\n";
        (&mut zones[zi]).planLabels = labels;
        (&mut zones[zi]).planFiles = files;
      }
      case let Err(e) {}
    }
  }

  // Each frame: boards glide to where the files put them, panes open one at a time, project cells follow the ring
  fn tickZones(self: &mut, device: &mut Device, renderer: &mut Renderer, dt: f32, now: u64) {
    var zi = 0usize;
    while zi < zones.len() {
      var f = dt * 4.;
      if f > 1. { f = 1.; }
      if grabKind != 6u32 || grabIt != i32.from(zi) {
        (&mut zones[zi]).pos = zones[zi].pos + (zones[zi].wantPos - zones[zi].pos) * f;
        (&mut zones[zi]).yaw = zones[zi].yaw + turnBetween(zones[zi].yaw, zones[zi].wantYaw) * f;
        (&mut zones[zi]).width = zones[zi].width + (zones[zi].wantWidth - zones[zi].width) * f;
      }
      if now >= zones[zi].nextAt && ticks > 4u32 {
        var opened = false;
        let order = [ZP_SITE, ZP_REPO, ZP_INCUBATOR, ZP_DIAGRAM];
        var o = 0usize;
        while o < 4usize && !opened {
          let kind = order[o];
          if (zones[zi].made & (1u32 << kind)) == 0u32 {
            (&mut zones[zi]).made = zones[zi].made | (1u32 << kind);
            if self.paneSrc(zi, kind).len() > 0usize {
              self.openPane(device, renderer, zi, kind);
              (&mut zones[zi]).nextAt = now + 700u64;
              opened = true;
            }
          }
          o = o + 1usize;
        }
      }
      if ticks > 4u32 { self.pollPlan(device, zi, now); }
      var j = 0usize;
      while j < zones[zi].projLabels.len() {
        let ik = *zones[zi].projItem[j];
        if ik >= 0 {
          let on = items[usize.from(u32.from(ik))].onTable;
          if on != *zones[zi].projOn[j] {
            zones[zi].projOn.set(j, on);
            (&mut zones[zi].projLabels[j]).bg = if on { 0xcfe6d2ffu32 } else { 0xf8f5eeffu32 };
            (&mut zones[zi].projLabels[j]).ok = false;
          }
        }
        j = j + 1usize;
      }
      zi = zi + 1usize;
    }
  }

  // A few of the boards' pictures a frame
  fn fillZones(self: &mut, l: &mut Labeller, device: &mut Device, made: &mut i32, most: i32) {
    var zi = 0usize;
    while zi < zones.len() {
      if *made < most && !zones[zi].title.ok { fillLabel(l, device, &mut zones[zi].title); *made = *made + 1; }
      if *made < most && !zones[zi].count.ok { fillLabel(l, device, &mut zones[zi].count); *made = *made + 1; }
      var pl = 0usize;
      while pl < zones[zi].planLabels.len() && *made < most {
        if !zones[zi].planLabels[pl].ok { fillLabel(l, device, &mut zones[zi].planLabels[pl]); *made = *made + 1; }
        pl = pl + 1usize;
      }
      if self.projCount(zi) == 0usize && *made < most && !zones[zi].none.ok { fillLabel(l, device, &mut zones[zi].none); *made = *made + 1; }
      var j = 0usize;
      while j < zones[zi].projLabels.len() && *made < most {
        if !zones[zi].projLabels[j].ok { fillLabel(l, device, &mut zones[zi].projLabels[j]); *made = *made + 1; }
        j = j + 1usize;
      }
      j = 0usize;
      while j < zones[zi].strip.len() && *made < most {
        if !zones[zi].strip[j].calm.ok { fillLabel(l, device, &mut zones[zi].strip[j].calm); *made = *made + 1; }
        if *made < most && !zones[zi].strip[j].glow.ok { fillLabel(l, device, &mut zones[zi].strip[j].glow); *made = *made + 1; }
        j = j + 1usize;
      }
      zi = zi + 1usize;
    }
  }

  // One board: its face, its name, its projects and its line strip (the panes are pages, drawn in their own turn)
  fn drawZone(self: &mut, zi: usize, device: &mut Device, encoder: &mut CommandEncoder, target: &Texture, depth: &Texture, vp: Mat4, hotPhase: bool) {
    let m = vp * self.zoneModel(zi);
    (&mut zones[zi]).back.drawFaded(device, encoder, target, depth, m, Vec4(0. - ZN_DW * 0.5, ZN_BASE, ZN_DW * 0.5, ZN_BASE + ZN_DH), 1.);
    Incubator.faded(&mut zones[zi].title, device, encoder, target, depth, m, Vec4(0. - 3.6, 3.98, 0. - 2.0, 4.38), 1.);
    if self.projCount(zi) == 0usize {
      let r = *zones[zi].rects[3usize];
      let cx = r.x - ZN_DW * 0.5 + r.z * 0.5;
      let cy = r.y + r.w * 0.5;
      Incubator.faded(&mut zones[zi].none, device, encoder, target, depth, m, Vec4(cx - 1.0, cy - 0.25, cx + 1.0, cy + 0.25), 1.);
    }
    var j = 0usize;
    while j < zones[zi].projLabels.len() {
      let rc = self.projRect(zi, j);
      Incubator.faded(&mut zones[zi].projLabels[j], device, encoder, target, depth, m, rc, 1.);
      j = j + 1usize;
    }
    var pj = 0usize;
    while pj < zones[zi].planLabels.len() {
      let rc = self.projRect(zi, zones[zi].projLabels.len() + pj);
      Incubator.faded(&mut zones[zi].planLabels[pj], device, encoder, target, depth, m, rc, 1.);
      pj = pj + 1usize;
    }
    let cr = self.stripRect(zi, 0usize);
    Incubator.faded(&mut zones[zi].count, device, encoder, target, depth, m, cr, 1.);
    var s = 0usize;
    while s < zones[zi].strip.len() {
      let rc = self.stripRect(zi, s + 1usize);
      if zones[zi].strip[s].hot && hotPhase {
        Incubator.faded(&mut zones[zi].strip[s].glow, device, encoder, target, depth, m, rc, 1.);
      } else {
        Incubator.faded(&mut zones[zi].strip[s].calm, device, encoder, target, depth, m, rc, 1.);
      }
      s = s + 1usize;
    }
  }

  // ---- the palette (palette.cone) ----

  // What has focus: the page last clicked, else the selected project, else the room
  fn palKind(self: &) String {
    if deskFocus { return String.from("laptop"); }
    if focusPg >= 0 {
      let i = usize.from(u32.from(focusPg));
      if i < pgs.len() && !pgs[i].gone {
        if pgs[i].web { return String.from("web"); }
        let s = pgs[i].src.view();
        if startsWithText(s, "mermaid:") || (s.len() >= 4usize && s.slice(s.len() - 4usize, s.len()) == ".mmd") { return String.from("diagram"); }
        return String.from("document");
      }
    }
    if sel >= 0 {
      if items[usize.from(u32.from(sel))].page { return String.from("document"); }
      return String.from("project");
    }
    String.from("room")
  }

  // The set of a kind: incubator.toml's [palette.KIND] or the built-in one; for a project, its own menu entries are added (those that are not
  // already a standard icon), and shelve shows only on the ring, bring only on a shelf
  fn palBuild(self: &, kind: &str, out: &mut List[String], sig: &mut String) {
    var set = palDefault(kind);
    var q = 0usize;
    while q < incubatorGood.palSets.len() {
      if incubatorGood.palSets[q].kind.view() == kind && incubatorGood.palSets[q].icons.len() > 0usize { set = incubatorGood.palSets[q].icons.clone(); }
      q = q + 1usize;
    }
    var onTable = true;
    if kind == "project" && sel >= 0 { onTable = items[usize.from(u32.from(sel))].onTable; }
    var i = 0usize;
    while i < set.len() {
      let e = palEntryOf(set[i].view());
      var deskOnNow = false;
      match &desk { case let Some(dk) { deskOnNow = dk.control; } else {} }
      let hide = (kind == "project" && ((e.action.view() == "shelve" && !onTable) || (e.action.view() == "bring" && onTable)))
        || (kind == "laptop" && ((e.action.view() == "laptopon" && deskOnNow) || (e.action.view() == "laptopoff" && !deskOnNow)));
      if !hide {
        if dictOn && e.action.view() == "dictate" { out.push(String.from("mic-off|Stop dictating|dictate")); }
        else { out.push(set[i].clone()); }
      }
      i = i + 1usize;
    }
    if kind == "project" && sel >= 0 {
      let id = items[usize.from(u32.from(sel))].id.view();
      var pi = 0usize;
      while pi < incubatorGood.projects.len() {
        if incubatorGood.projects[pi].id.view() == id {
          var m = 0usize;
          while m < incubatorGood.projects[pi].menu.len() {
            let mc = &incubatorGood.projects[pi].menu[m];
            let a = mc.action.view();
            let standard = a == "zoom" || a == "zoomout" || a == "shelve" || a == "bring" || a == "open" || a == "talk" || a == "back" || a == "forward"
              || a == "files" || a == "reload";
            if !standard && knownAction(a) {
              var line = String.from(palIconFor(a));
              line.append("|"); line.append(mc.label.view()); line.append("|"); line.append(a);
              out.push(line);
            }
            m = m + 1usize;
          }
        }
        pi = pi + 1usize;
      }
    }
    sig.append("|"); sig.append(numText(i64.from(out.len())).view());
    sig.append(if onTable { "|r|" } else { "|s|" });
    if kind == "laptop" { match &desk { case let Some(dk) { sig.append(if dk.control { "|on" } else { "|off" }); } else {} } }
    sig.append(numText(i64.from(incubatorSeen.len())).view());
    if dictOn { sig.append("|dict"); }
  }

  // ---- editing in place, new notes, dictation (pageedit.cone; docpanel.cone) ----

  // The page being edited, or -1
  fn editIdx(self: &) i32 {
    var i = 0usize;
    while i < pgs.len() {
      match &pgs[i].doc { case let Some(p) { if p.editing() { return i32.from(i); } } else {} }
      i = i + 1usize;
    }
    -1
  }

  pub fn editActive(self: &) bool { self.editIdx() >= 0 }

  pub fn editKeyed(self: &mut, device: &mut Device, renderer: &mut Renderer, sc: u32, mods: u16) bool {
    let e = self.editIdx();
    if e < 0 { return false; }
    let u = usize.from(u32.from(e));
    var used = false;
    match &mut pgs[u].doc { case var &mut Some(p) { used = p.editKey(device, renderer, sc, mods); if !p.editing() { webPanelText(false); } } else {} }
    used
  }

  pub fn editTyped(self: &mut, device: &mut Device, renderer: &mut Renderer, s: &str) {
    let e = self.editIdx();
    if e < 0 { return; }
    let u = usize.from(u32.from(e));
    match &mut pgs[u].doc { case var &mut Some(p) { p.editText(device, renderer, s); } else {} }
  }

  // A click on a page that is not the one being edited ends that editing (saving it)
  pub fn editLeaveOthers(self: &mut, device: &mut Device, renderer: &mut Renderer, keep: i32) {
    var i = 0usize;
    while i < pgs.len() {
      if i32.from(i) != keep {
        match &mut pgs[i].doc { case var &mut Some(p) { if p.editing() { p.editEnd(device, renderer); webPanelText(false); } } else {} }
      }
      i = i + 1usize;
    }
  }

  // "New page": an empty dated Markdown file in the notes folder, opened at the workbench with the caret in it
  fn newPage(self: &mut) bool {
    var dir = String.from(NOTES_DIR);
    if notesArg != null { dir = String.from(cstr.fromPtr(notesArg).view()); }
    if let Err(e) = fs.makeDirAll(&Path.from(dir.view())) { print <- "notes: could not make "; printStr(dir.view()); print <- ": "; print <- e; print <- "\n"; return false; }
    var stamp = String();
    stamp.append(numText(i64.from(deskc.local_part(0i32))).view()); stamp.append("-");
    stamp.append(pad(i64.from(deskc.local_part(1i32)), 2usize).view()); stamp.append("-");
    stamp.append(pad(i64.from(deskc.local_part(2i32)), 2usize).view()); stamp.append("-");
    stamp.append(pad(i64.from(deskc.local_part(3i32)), 2usize).view());
    stamp.append(pad(i64.from(deskc.local_part(4i32)), 2usize).view());
    var k = 1u32;
    var path = String();
    while k < 100u32 {
      path = String.from(dir.view());
      path.append("/");
      path.append(editStampName(stamp.view(), k).view());
      if !fs.exists(&Path.from(path.view())) { break; }
      k = k + 1u32;
    }
    var none = List[u8]();
    if let Err(e) = fs.writeFile(&Path.from(path.view()), none.view()) { print <- "notes: could not write "; printStr(path.view()); print <- ": "; print <- e; print <- "\n"; return false; }
    editOnOpen = path.clone();
    pageWant = String.from("bench:");
    pageWant.append(path.view());
    notesMade = notesMade + 1u32;
    print <- "notes: new page "; printStr(path.view()); print <- "\n";
    true
  }

  // "Dictate here": the focused page takes the voice at its caret, until the icon is pressed again
  fn toggleDictate(self: &mut) bool {
    if dictOn {
      dictOn = false; dictPg = -1; dictFlag = 2u32;
      print <- "dictate: off (A and B talk to Penny again)\n";
      return true;
    }
    var target = self.editIdx();
    if target < 0 && focusPg >= 0 && usize.from(u32.from(focusPg)) < pgs.len() { target = focusPg; }
    if target < 0 { return false; }
    let u = usize.from(u32.from(target));
    var ok = false;
    match &mut pgs[u].doc {
      case var &mut Some(p) {
        if p.editable() {
          if !p.editing() { p.editWant(p.text.len()); webPanelText(true); }
          dictFile = p.file.clone();
          ok = true;
        }
      }
      else {}
    }
    if !ok { return false; }
    dictOn = true; dictPg = target; dictFlag = 1u32;
    print <- "dictate: on for "; printStr(dictFile.view()); print <- " (A records into the caret; B is ignored)\n";
    true
  }

  pub fn dictating(self: &) bool { dictOn }
  pub fn takeDictFlag(self: &mut) u32 { let f = dictFlag; dictFlag = 0u32; f }
  pub fn dictTarget(self: &) String { dictFile.clone() }

  // Transcribed text to the caret of the dictated page
  pub fn dictated(self: &mut, device: &mut Device, renderer: &mut Renderer, s: &str) {
    if !dictOn || dictPg < 0 || usize.from(u32.from(dictPg)) >= pgs.len() { return; }
    let u = usize.from(u32.from(dictPg));
    match &mut pgs[u].doc {
      case var &mut Some(p) {
        var t = String.from(s.trim());
        if t.len() == 0usize { return; }
        t.append(" ");
        p.editText(device, renderer, t.view());
        print <- "dictate: "; print <- t.len(); print <- " bytes at the caret\n";
      }
      else {}
    }
  }

  // Test hook: a palette action by name
  pub fn testAct(self: &mut, device: &mut Device, name: &str, v: &Fly) { _ = self.palAct(device, name, v); }

  // Test hook: a click on the page numbered i (0 the first opened) at the glyph 'off' of document block d: the page's own click, as a ray
  pub fn testClickPage(self: &mut, i: usize, d: usize, off: usize) bool {
    if i >= pgs.len() { return false; }
    focusPg = i32.from(i);
    palFocused = false;
    var hit = false;
    match &mut pgs[i].doc { case var &mut Some(p) { hit = p.testClickBlock(d, off); } else {} }
    hit
  }

  // Test hook: the text of a page's file as the editor holds it
  pub fn testText(self: &, i: usize) String {
    var out = String();
    if i < pgs.len() { match &pgs[i].doc { case let Some(p) { out = p.text.clone(); } else {} } }
    out
  }

  pub fn testPageCount(self: &) usize { pgs.len() }

  pub fn testSrc(self: &, i: usize) String { if i < pgs.len() { pgs[i].src.clone() } else { String() } }

  // The page whose file name ends as given (the last such), or the page count if none
  pub fn testPageIdx(self: &, suffix: &str) usize {
    var found = pgs.len();
    var i = 0usize;
    while i < pgs.len() {
      let s = pgs[i].src.view();
      if s.len() >= suffix.len() && s.slice(s.len() - suffix.len(), s.len()) == suffix { found = i; }
      i = i + 1usize;
    }
    found
  }

  // What a click elsewhere does to editing and dictation: editing ends on every page but the focused one (saved); dictation stops when the focus leaves its page
  fn editWatch(self: &mut, device: &mut Device, renderer: &mut Renderer) {
    if focusPg >= 0 && self.editIdx() >= 0 && self.editIdx() != focusPg { self.editLeaveOthers(device, renderer, focusPg); }
    if dictOn && focusPg >= 0 && focusPg != dictPg { dictOn = false; dictPg = -1; dictFlag = 2u32; print <- "dictate: off (focus moved)\n"; }
  }

  fn palTick(self: &mut, device: &mut Device, dt: f32, now: u64) {
    let kind = self.palKind();
    var build = List[String]();
    var sig = String.from(kind.view());
    self.palBuild(kind.view(), &mut build, &mut sig);
    var lab: Option[Labeller] = None;
    lab <-> labeller;
    match &mut lab {
      case var &mut Some(l) { pal.tick(device, l, format, dt, now, kind.view(), sig.view(), &build, palFocused); }
      else {}
    }
    labeller <-> lab;
  }

  // The hover of a hand's (or the mouse's) pointer; the beam of a hand ends at the tray (reach)
  pub fn palPoint(self: &mut, hand: u32, eye: Vec3, dir: Vec3) { _ = pal.point(hand, eye, dir, nowMs()); }
  pub fn setPalHand(self: &mut, pos: Vec3) { pal.setHand(pos); }
  pub fn palSpot(self: &, n: u32, eye: Vec3) Vec4 { pal.spot(n, eye) }
  pub fn palKindNow(self: &) String { pal.kindNow() }

  // A trigger or click along a ray: a button runs its action; the plate alone is swallowed (on the desktop it lifts the tray off, in place)
  pub fn palClick(self: &mut, device: &mut Device, eye: Vec3, dir: Vec3, v: &Fly) bool {
    var body = false;
    let a = pal.press(eye, dir, nowMs(), &mut body);
    if a.len() == 0usize {
      if body && !pal.xr && pal.docked { self.palLift(); }
      return body;
    }
    _ = self.palAct(device, a.view(), v);
    true
  }

  pub fn palLift(self: &mut) {
    if !pal.docked { return; }
    pal.floatPos = pal.anchor();
    pal.docked = false;
    self.palSavePlace();
  }

  pub fn palDock(self: &mut) {
    pal.docked = true;
    roomGood.palPlace = String();
    writeAt = nowMs() + 1000u64;
    print <- "palette: docked\n";
  }

  fn palSavePlace(self: &mut) {
    var text = String.from("at:");
    text.append(floatText(pal.floatPos.x).view()); text.append(","); text.append(floatText(pal.floatPos.y).view()); text.append(","); text.append(floatText(pal.floatPos.z).view());
    roomGood.palPlace = text;
    writeAt = nowMs() + 1000u64;
    print <- "palette: left floating at "; printStr(roomGood.palPlace.view()); print <- " (room.toml)\n";
  }

  // The action of a palette button. 1: it did something; 2: not wired yet, it only logs; 0: not available for this focus.
  fn palAct(self: &mut, device: &mut Device, action: &str, v: &Fly) u32 {
    let label = pal.labelOf(action);
    var r = 0u32;
    let pgOk = focusPg >= 0 && usize.from(u32.from(focusPg)) < pgs.len();
    if action == "dock" { self.palDock(); r = 1u32; }
    else if action == "focus" {
      if pgOk && pgs[usize.from(u32.from(focusPg))].zone >= 0 {
        // a board's pane: the same fly to the workbench and release the corner chip had
        let i = usize.from(u32.from(focusPg));
        self.focusPane(i);
        palFocused = pgs[i].wantFoc;
        r = 1u32;
      }
      else if palFocused { palFocused = false; if sel >= 0 { _ = self.zoom(-1, v); } r = 1u32; }
      else if !pgOk && sel >= 0 { _ = self.act(3u32, v); palFocused = true; r = 1u32; }
      else { r = 2u32; }
    }
    else if action == "back" || action == "forward" {
      if pgOk {
        let i = usize.from(u32.from(focusPg));
        match &mut pgs[i].doc { case var &mut Some(p) { p.requestNav(if action == "back" { -1i32 } else { 1i32 }); r = 1u32; } else { r = 2u32; } }
      } else { navWant = if action == "back" { 6u32 } else { 7u32 }; r = 1u32; }
    }
    else if action == "files" { navWant = 8u32; r = 1u32; }
    else if action == "laptopon" || action == "laptopoff" {
      match &mut desk { case var &mut Some(dk) { dk.setControl(action == "laptopon"); r = 1u32; } else { r = 0u32; } }
    }
    else if action == "close" { if pgOk { let i = usize.from(u32.from(focusPg)); focusPg = -1; self.closePage(i); r = 1u32; } }
    else if action == "shelve" {
      if pgOk { self.toggleShelve(usize.from(u32.from(focusPg))); r = 1u32; }
      else if sel >= 0 && self.act(0u32, v) { r = 1u32; }
    }
    else if action == "newpage" { r = if self.newPage() { 1u32 } else { 0u32 }; }
    else if action == "edit" {
      if pgOk {
        let i = usize.from(u32.from(focusPg));
        match &mut pgs[i].doc { case var &mut Some(p) { if p.editable() { p.editWant(p.text.len()); webPanelText(true); r = 1u32; } } else {} }
      }
    }
    else if action == "dictate" { r = if self.toggleDictate() { 1u32 } else { 0u32 }; }
    else if action == "park" { if browserOpen { self.parkBrowser(device); r = 1u32; } else { r = 0u32; } }
    else if sel >= 0 && self.doAction(action, v) { r = 1u32; }
    else if action == "reload" { cfgPoll = 0u64; incubatorSeen = String(); roomSeen = String(); r = 1u32; }
    else if sel < 0 && (action == "zoom" || action == "zoomout" || action == "bring" || action == "open" || action == "talk") { r = 0u32; }
    else if action == "undo" || action == "beforeafter" || action == "linkpage"
      || action == "webreload" || action == "address" || action == "addbox" || action == "connect" || action == "labelit" || action == "rename"
      || action == "delete" || action == "relayout" || action == "passthrough" || action == "look" { r = 2u32; }
    print <- "palette: "; printStr(label.view()); print <- " ("; printStr(action); print <- ") ";
    print <- (if r == 1u32 { "done" } else if r == 2u32 { "is a stub: logged, nothing done yet" } else { "has nothing to act on" });
    print <- "\n";
    r
  }

  fn cardPos(self: &, stage: usize, n: u32) Vec3 {
    Vec3(-4.62, 1.11 + 0.30 * f32.from(n), 3.2 - 1.6 * f32.from(stage))
  }
}

const NO_SLOT = 0xFFFFFFFDu32;
