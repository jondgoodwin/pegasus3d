// Understanding: a world's syntax tree checked and resolved into the form the
// builders read.
//
// Every part gets a SLOT, its number in the world, in the order written; the
// world itself is slot 0. What code reads is by slot, never by name: a path
// such as 'materials.stone' becomes the slot of the part it names, a call's
// arguments are put in the builder's own order, and a part's options in its
// kind's (the option slots below). Names stay only to say where a mistake is.
//
// A path's first name is looked for outward: among the children of the part
// the path is written in, then its parent's, and so on to the world; the
// nearest wins. The world's own name starts a path from the top.
//
// Numbers are checked against what they measure (Values and Types: units):
// a plain number where a shape wants a length is meters, a radian is a plain
// number, and a light's strength needs its unit. Each is kept in its kind's
// base unit: meters, radians, lux.
//
// Then the order: each part comes after the parts it uses and the part that
// holds it, as a spreadsheet's cells come after the cells they read. A part
// with a mistake is left out, with what is inside it and what uses it; the
// rest of the world goes on.
//
// What a world DOES is understood here too, from page 2 (the behaviors
// section below): a part's fields, its area, its derives, and the world's
// event rules with their animators. A behavior with a mistake is lost on its
// own; the part it is written in stays. 'solid(...)' is counted and set aside.

// What a value is
pub enum Ty {
  Pure;           // a plain number
  Length;
  Angle;
  Illuminance;
  Truth;
  Point;          // three lengths
  Direction;      // three plain numbers
  LengthRange;
  Color;
  Rotation;
  Shape;
  Material;
  Light;
  Duration;       // seconds
  SimTime;        // a duration on the world's running clock: sim(4 s)
  Volume;         // a space: sphere(...)
  Point2;         // two lengths: a point of an outline
  Outline;        // a flat path: outline.rectangle(...), or a list of points
  Outlines;       // a list of outlines
  Spine;          // a path through space: spine.line(...)
  Shapes;         // a list of shapes
  Modifier;       // what changes one setting of a material: translucent(...)
  Intensity;      // a light's strength in a direction: candela
  Camera;         // how a picture is taken: camera(lens:, aperture:, focus:, exposure:)
  Points;         // a list of points: what spine.through goes through
  Numbers;        // a list of plain numbers: a loft's stations
  Stroke;         // a brush drawn over a shape: brush.clay(...)
  Strokes;        // a list of strokes
}

// The builders the guide's pages call
pub enum Builder {
  Box;            // box(x: range, y: range, z: range)
  Plain;          // plain(color): a matte material
  Srgb;           // srgb(r, g, b), 0 to 255 as a paint program shows them
  LinearColor;    // color(r, g, b), 0 to 1
  Turn;           // rotation(angle, about: direction = up)
  SunLight;       // sunLight(direction:, color:, lux:, castsShadow:)
  Physical;       // physical(color:, roughness: = 1, metal: = 0)
  Sphere;         // sphere(radius:, at:)
  Sim;            // sim(duration)
  Lathe;          // lathe(profile:, axis:, angle:, steps:)
  LoftAlong;      // loftAlong(profiles:, spine:, stations:, count:, between:, smooth:, caps:)
  Join;           // join(shapes)
  ArrayRadial;    // arrayRadial(s, count:, axis:, angle:, origin:, merge:)
  OutlineRect;    // outline.rectangle(width:, height:)
  SpineLine;      // spine.line(from:, to:, segments:)
  Translucent;    // translucent(covers:)
  Layered;        // [material, modifier, ...]: its args the list's items
  OutlinePoints;  // [(x, y), ...] where an outline is wanted: an open outline
  Union;          // union(a, b, crease:): everything inside either
  Difference;     // difference(a, b, crease:): b cut out of a
  SpotLight;      // spotLight(reach, color:, intensity:, source:, aim:, cone:, softEdge:, castsShadow:)
  PointLight;     // pointLight(reach, color:, intensity:, source:, castsShadow:)
  ClearCoat;      // clearCoat(amount: = 1, roughness: = 0.05): a lacquer over the surface
  Reflective;     // reflective(amount: = 1): how much of the scene the surface mirrors
  CameraLens;     // camera(lens: = 50 mm, aperture: = 0 (all in focus), focus: = 2 m, exposure: = 0 stops)
  OutlineGiven;   // outline.points(points:, closed: = true)
  OutlineEllipse; // outline.ellipse(width:, height:, segments: = 32)
  SpineThrough;   // spine.through(points:, segments: = 8): centripetal Catmull-Rom, ends extrapolated
  Subdivide;      // subdivide(s, levels: = 1): Catmull-Clark
  Move;           // move(s, by:)
  TurnShape;      // turn(s, by:, about: = up, origin: = (0, 0, 0))
  OutlineOffset;  // outline.offset(outline:, by:): grown outward, or shrunk inward when negative
  Inflate;        // inflate(outline, thickness: = 1, cell: = 5 mm, fullness: = 1): an outline blown up round (mine: not in the manual)
  Smooth;         // smooth(s, factor: = 0.5, iterations: = 1, keepVolume: = false)
  Carve;          // carve(s, strokes:, mirror:): the strokes applied in order, each also mirrored
  Mirror;         // mirror(s, normal: = right, origin: = (0, 0, 0), merge: = 0.1 mm): the shape and its reflection
  // The brushes, each brush.NAME(along: | at:, onto: = front, radius:, strength: = 0.5, ends: = 0):
  // a negative strength takes away
  BrushDraw;
  BrushClay;
  BrushClayStrips;
  BrushCrease;
  BrushInflate;
  BrushPinch;
  BrushSmooth;
  BrushFlatten;
  BrushLayer;
  BrushBlob;
}

// A part's own values that behaviors read and write, by their key in the
// animators (keyframetracks' property keys: its PROP_ROTATION, and the
// program's own from its PROP_FIRST_USER)
pub const P_FIELD = 0u32;             // not a property: a field, by its number
pub const P_ROTATION = 2u32;          // a Quat
pub const P_OFFSET = 1024u32;         // a Vec3: how far it stands from where 'at:' put it
pub const P_TINT = 1025u32;           // a gray, multiplying its color

// What kind of thing a part is, by what makes it
pub enum Kind {
  Group;          // holds other parts: the world, 'materials'
  Shape;
  Material;
  Light;
  Arrival;        // a part of the world's 'arrivals'
}

// The option slots of each kind
pub const OPT_AT = 0usize;            // Group, Shape, Arrival: where (a Point)
pub const OPT_ROTATION = 1usize;      // Group, Shape: a Rotation
pub const OPT_MATERIAL = 2usize;      // Shape: a Material
pub const OPT_FACING = 1usize;        // Arrival: a Direction
pub const OPT_EYE = 2usize;           // Arrival: how high the eye is above where it stands (a Length)
pub const OPT_CAMERA = 3usize;        // Arrival: how its picture is taken (a Camera)

// A value checked
pub enum Val {
  Absent;                 // an optional argument or option not given
  Num(f64);               // in its kind's base unit
  Truth(bool);
  Tuple(List[Val]);
  Range(List[Val]);       // the low end, then the high
  Ref(usize);             // a part, by slot
  Make(Made);             // a builder called
  Items(List[Val]);       // a list: of outlines, of shapes
  Local(usize);           // the value of a function's step (its let), by its number in the function
  Call(usize);            // a function called, by its number
}

pub struct Made {
  pub builder: Builder;
  pub args: List[Val];    // in the builder's order
}

// A part's place in the tree
pub struct Node {
  pub name: u32;
  pub at: Spot;
  pub parent: usize;      // the world's is itself
  pub children: List[usize];
  pub kind: Kind;
}

// A part understood
pub struct Unit {
  pub make: Val;          // what makes it (Absent for a group or an arrival)
  pub options: List[Val]; // by its kind's option slots
  pub behaviors: usize;   // lines set aside
}

pub struct Understood {
  pub nodes: List[Node];  // by slot
  pub units: List[Unit];  // by slot
  pub alive: List[bool];  // by slot: false, left out for a mistake
  pub order: List[usize]; // the live slots, each after what it uses
  pub names: Names;       // the names the slots were written with, for what is said about them
  pub fields: List[FieldInfo];     // every part's fields, by number
  pub areas: List[AreaInfo];
  pub derives: List[DeriveInfo];
  pub deriveOrder: List[usize];    // the derives in the order they are worked out: each after what it reads
  pub rules: List[RuleInfo];
  pub functions: List[FnInfo];     // every part's functions, by number
  pub moves: List[MoveInfo];       // pick-and-place rules
}

// A function of a part, checked: its steps (its lets) and its result, each a
// value that may read the steps before it (Val.Local)
pub struct FnInfo {
  pub slot: usize;
  pub name: u32;
  pub at: Spot;
  pub ty: Ty;                      // what it makes: a shape, for now
  pub lets: List[Val];
  pub result: Val;
}

// -------- what behaviors are understood into --------

// A field: a value a part holds of its own
pub struct FieldInfo {
  pub slot: usize;
  pub name: u32;
  pub at: Spot;
  pub ty: Ty;             // Truth or Pure, for now
  pub init: f64;          // its default (a truth as 1 or 0)
  pub mutable: bool;
  pub derived: bool;
}

// The space round a part that the engines watch: a ball, in the part's own frame
pub struct AreaInfo {
  pub at: Spot;
  pub slot: usize;
  pub radius: f64;        // meters
  pub cx: f64;            // its middle, in meters
  pub cy: f64;
  pub cz: f64;
  pub live: bool;         // false: left out for a mistake
}

// A value a derive writes: a field, or a property of a part
pub struct Target {
  pub prop: u32;          // P_FIELD, P_TINT, ...
  pub index: usize;       // a field's number, or the part's slot
}

// A derive's formula, checked
pub enum Calc {
  Num(f64);               // a number, or a truth as 1 or 0
  Field(usize);           // a field's value, by its number
  Occupied(usize);        // is the visitor on this machine inside the area of this part (slot)?
  Choose(List[Calc]);     // if the first, the second, else the third
}

pub struct DeriveInfo {
  pub at: Spot;
  pub target: Target;
  pub calc: Calc;
  pub reads: List[usize]; // the fields it reads
  pub uses: List[usize];  // the parts it needs: where it is written, and what it names
  pub live: bool;
}

// keys(target, [key(time, value), ...], loop:, ease:)
pub struct KeysInfo {
  pub slot: usize;        // the part whose property it moves
  pub prop: u32;          // P_ROTATION or P_OFFSET
  pub times: List[f64];   // seconds from its start
  pub values: List[Val];  // a Make(Turn) for a rotation, a Tuple for an offset
  pub mode: u32;          // keyframetracks' LOOP_ONCE, LOOP_LOOP or LOOP_PINGPONG
  pub linear: bool;       // 'ease: linear' said
}

// on(trigger, start(animator))
pub struct RuleInfo {
  pub at: Spot;
  pub clicked: bool;      // on(clicked(part), ...); else on(created, ...)
  pub part: usize;        // the part clicked
  pub keys: KeysInfo;
  pub live: bool;
}

// One thing a pick-and-place rule does, in order:
//   set(field, part | None)                           kind 0: the field holds that part (value its slot, or -1)
//   start(transition(field.offset, to: part, over:))  kind 1: the part the field holds glides to stand
//                                                     where that part stands, over that many seconds
pub struct MoveAct {
  pub kind: u32;
  pub field: usize;
  pub value: i64;
  pub to: usize;
  pub seconds: f64;
}

// on(clicked(part), action or [actions]) whose actions are those
pub struct MoveInfo {
  pub at: Spot;
  pub part: usize;        // the part clicked: a click on any part inside it counts
  pub acts: List[MoveAct];
}

// A parameter of a builder, or an option of a kind
struct Param {
  name: u32;
  ty: Ty;
  required: bool;
}

fn param(name: u32, ty: Ty, required: bool) Param { Param(name, ty, required) }

fn signature(b: Builder) List[Param] {
  var p = List[Param].empty();
  if b == Builder.Box {
    p.push(param(N_X, Ty.LengthRange, true));
    p.push(param(N_Y, Ty.LengthRange, true));
    p.push(param(N_Z, Ty.LengthRange, true));
  }
  else if b == Builder.Plain { p.push(param(N_COLOR, Ty.Color, true)); }
  else if b == Builder.Srgb || b == Builder.LinearColor {
    p.push(param(N_R, Ty.Pure, true));
    p.push(param(N_G, Ty.Pure, true));
    p.push(param(N_B, Ty.Pure, true));
    p.push(param(N_OPACITY, Ty.Pure, false));
  }
  else if b == Builder.Turn {
    p.push(param(N_ANGLE, Ty.Angle, true));
    p.push(param(N_ABOUT, Ty.Direction, false));    // up
  }
  else if b == Builder.SunLight {
    p.push(param(N_DIRECTION, Ty.Direction, true));
    p.push(param(N_COLOR, Ty.Color, true));
    p.push(param(N_LUX, Ty.Illuminance, true));
    p.push(param(N_CASTSSHADOW, Ty.Truth, false));
  }
  else if b == Builder.Physical {
    p.push(param(N_COLOR, Ty.Color, true));
    p.push(param(N_ROUGHNESS, Ty.Pure, false));
    p.push(param(N_METAL, Ty.Pure, false));
  }
  else if b == Builder.Sphere {
    p.push(param(N_RADIUS, Ty.Length, true));
    p.push(param(N_AT, Ty.Point, false));
  }
  else if b == Builder.Sim { p.push(param(N_TIME, Ty.Duration, true)); }
  // The shape tools (Appendix: shape tools), their defaults the manual's
  else if b == Builder.Lathe {
    p.push(param(N_PROFILE, Ty.Outline, true));
    p.push(param(N_AXIS, Ty.Direction, false));     // up
    p.push(param(N_ANGLE, Ty.Angle, false));        // 360 deg
    p.push(param(N_STEPS, Ty.Pure, false));         // 32
  }
  else if b == Builder.LoftAlong {
    p.push(param(N_PROFILES, Ty.Outlines, true));
    p.push(param(N_SPINE, Ty.Spine, true));
    p.push(param(N_COUNT, Ty.Pure, false));         // 0: every outline's own points
    p.push(param(N_BETWEEN, Ty.Pure, false));       // 0
    p.push(param(N_SMOOTH, Ty.Truth, false));       // false
    p.push(param(N_CAPS, Ty.Truth, false));         // true
    p.push(param(N_STATIONS, Ty.Numbers, false));   // []: spread evenly (named, so its place in the list is free)
  }
  else if b == Builder.OutlineGiven {
    p.push(param(N_POINTS, Ty.Outline, true));
    p.push(param(N_CLOSED, Ty.Truth, false));       // true
  }
  else if b == Builder.OutlineEllipse {
    p.push(param(N_WIDTH, Ty.Length, true));
    p.push(param(N_HEIGHT, Ty.Length, true));
    p.push(param(N_SEGMENTS, Ty.Pure, false));      // 32
  }
  else if b == Builder.Mirror {
    p.push(param(N_S, Ty.Shape, true));
    p.push(param(N_NORMAL, Ty.Direction, false));   // right
    p.push(param(N_ORIGIN, Ty.Point, false));       // (0, 0, 0)
    p.push(param(N_MERGE, Ty.Length, false));       // 0.0001 m
  }
  else if b == Builder.Carve {
    p.push(param(N_S, Ty.Shape, true));
    p.push(param(N_STROKES, Ty.Strokes, true));
    p.push(param(N_MIRROR, Ty.Direction, false));   // none
  }
  else if isBrush(b) {
    p.push(param(N_ALONG, Ty.Outline, false));      // flat points on the side seen from 'onto'
    p.push(param(N_AT, Ty.Point2, false));          // or one dab there
    p.push(param(N_ONTO, Ty.Direction, false));     // front
    p.push(param(N_RADIUS, Ty.Length, true));
    p.push(param(N_STRENGTH, Ty.Pure, false));      // 0.5
    p.push(param(N_ENDS, Ty.Pure, false));          // 0: how much of each end thins away
  }
  else if b == Builder.Smooth {
    p.push(param(N_S, Ty.Shape, true));
    p.push(param(N_FACTOR, Ty.Pure, false));        // 0.5
    p.push(param(N_ITERATIONS, Ty.Pure, false));    // 1
    p.push(param(N_KEEPVOLUME, Ty.Truth, false));   // false
  }
  else if b == Builder.Inflate {
    p.push(param(N_OUTLINE, Ty.Outline, true));
    p.push(param(N_THICKNESS, Ty.Pure, false));     // 1: round in section
    p.push(param(N_CELL, Ty.Length, false));        // 5 mm
    p.push(param(N_FULLNESS, Ty.Pure, false));      // 1: round; higher, flatter sides and firmer edges
  }
  else if b == Builder.OutlineOffset {
    p.push(param(N_OUTLINE, Ty.Outline, true));
    p.push(param(N_BY, Ty.Length, true));
  }
  else if b == Builder.SpineThrough {
    p.push(param(N_POINTS, Ty.Points, true));
    p.push(param(N_SEGMENTS, Ty.Pure, false));      // 8
  }
  else if b == Builder.Subdivide {
    p.push(param(N_S, Ty.Shape, true));
    p.push(param(N_LEVELS, Ty.Pure, false));        // 1
  }
  else if b == Builder.Move {
    p.push(param(N_S, Ty.Shape, true));
    p.push(param(N_BY, Ty.Point, true));
  }
  else if b == Builder.TurnShape {
    p.push(param(N_S, Ty.Shape, true));
    p.push(param(N_BY, Ty.Angle, true));
    p.push(param(N_ABOUT, Ty.Direction, false));    // up
    p.push(param(N_ORIGIN, Ty.Point, false));       // (0, 0, 0)
  }
  else if b == Builder.Join { p.push(param(N_SHAPES, Ty.Shapes, true)); }
  else if b == Builder.ArrayRadial {
    p.push(param(N_S, Ty.Shape, true));
    p.push(param(N_COUNT, Ty.Pure, true));
    p.push(param(N_AXIS, Ty.Direction, false));     // up
    p.push(param(N_ANGLE, Ty.Angle, false));        // 360 deg
    p.push(param(N_ORIGIN, Ty.Point, false));       // (0, 0, 0)
    p.push(param(N_MERGE, Ty.Length, false));       // 0.0001 m
  }
  else if b == Builder.OutlineRect {
    p.push(param(N_WIDTH, Ty.Length, true));
    p.push(param(N_HEIGHT, Ty.Length, true));
  }
  else if b == Builder.SpineLine {
    p.push(param(N_FROM, Ty.Point, true));
    p.push(param(N_TO, Ty.Point, true));
    p.push(param(N_SEGMENTS, Ty.Pure, false));      // 1
  }
  else if b == Builder.Translucent { p.push(param(N_COVERS, Ty.Pure, true)); }
  else if b == Builder.ClearCoat {
    p.push(param(N_AMOUNT, Ty.Pure, false));
    p.push(param(N_ROUGHNESS, Ty.Pure, false));
  }
  else if b == Builder.Reflective { p.push(param(N_AMOUNT, Ty.Pure, false)); }
  else if b == Builder.CameraLens {
    p.push(param(N_LENS, Ty.Length, false));
    p.push(param(N_APERTURE, Ty.Pure, false));
    p.push(param(N_FOCUS, Ty.Length, false));
    p.push(param(N_EXPOSURE, Ty.Pure, false));
  }
  else if b == Builder.SpotLight || b == Builder.PointLight {
    p.push(param(N_REACH, Ty.Length, true));
    p.push(param(N_COLOR, Ty.Color, false));        // white
    p.push(param(N_INTENSITY, Ty.Intensity, false)); // 0 candela
    p.push(param(N_SOURCE, Ty.Length, false));       // 0 m
    p.push(param(N_CASTSSHADOW, Ty.Truth, false));   // false
    if b == Builder.SpotLight {
      p.push(param(N_AIM, Ty.Direction, false));     // down
      p.push(param(N_CONE, Ty.Angle, true));
      p.push(param(N_SOFTEDGE, Ty.Angle, false));    // 0
    }
  }
  else if b == Builder.Union || b == Builder.Difference {
    p.push(param(N_A, Ty.Shape, true));
    p.push(param(N_B, Ty.Shape, true));
    p.push(param(N_CREASE, Ty.Pure, false));      // 0
  }
  p
}

// A builder named by a path of two names: outline.rectangle, spine.line
fn builderNamed2(a: u32, b: u32) Option[Builder] {
  if a == N_OUTLINE && b == N_RECTANGLE { return Some[Builder](Builder.OutlineRect); }
  if a == N_SPINE && b == N_LINE { return Some[Builder](Builder.SpineLine); }
  if a == N_OUTLINE && b == N_POINTS { return Some[Builder](Builder.OutlineGiven); }
  if a == N_OUTLINE && b == N_ELLIPSE { return Some[Builder](Builder.OutlineEllipse); }
  if a == N_OUTLINE && b == N_OFFSET { return Some[Builder](Builder.OutlineOffset); }
  if a == N_BRUSH {
    if b == N_DRAW { return Some[Builder](Builder.BrushDraw); }
    if b == N_CLAY { return Some[Builder](Builder.BrushClay); }
    if b == N_CLAYSTRIPS { return Some[Builder](Builder.BrushClayStrips); }
    if b == N_CREASE { return Some[Builder](Builder.BrushCrease); }
    if b == N_INFLATE { return Some[Builder](Builder.BrushInflate); }
    if b == N_PINCH { return Some[Builder](Builder.BrushPinch); }
    if b == N_SMOOTH { return Some[Builder](Builder.BrushSmooth); }
    if b == N_FLATTEN { return Some[Builder](Builder.BrushFlatten); }
    if b == N_LAYER { return Some[Builder](Builder.BrushLayer); }
    if b == N_BLOB { return Some[Builder](Builder.BrushBlob); }
  }
  if a == N_SPINE && b == N_THROUGH { return Some[Builder](Builder.SpineThrough); }
  None
}

// The builder a call names, if it names one
fn builderOf(callee: &List[u32]) Option[Builder] {
  if callee.len() == 1usize { return builderNamed(*callee[0]); }
  if callee.len() == 2usize { return builderNamed2(*callee[0], *callee[1]); }
  None
}

fn optionsOf(k: Kind) List[Param] {
  var p = List[Param].empty();
  if k == Kind.Group {
    p.push(param(N_AT, Ty.Point, false));
    p.push(param(N_ROTATION, Ty.Rotation, false));
  }
  else if k == Kind.Shape {
    p.push(param(N_AT, Ty.Point, false));
    p.push(param(N_ROTATION, Ty.Rotation, false));
    p.push(param(N_MATERIAL, Ty.Material, true));
  }
  else if k == Kind.Light {
    p.push(param(N_AT, Ty.Point, false));
    p.push(param(N_ROTATION, Ty.Rotation, false));
  }
  else if k == Kind.Arrival {
    p.push(param(N_AT, Ty.Point, true));
    p.push(param(N_FACING, Ty.Direction, true));
    p.push(param(N_EYE, Ty.Length, false));          // a standing adult's, 1.6 m
    p.push(param(N_CAMERA, Ty.Camera, false));
  }
  p
}

fn builderNamed(name: u32) Option[Builder] {
  if name == N_BOX { return Some[Builder](Builder.Box); }
  if name == N_PLAIN { return Some[Builder](Builder.Plain); }
  if name == N_SRGB { return Some[Builder](Builder.Srgb); }
  if name == N_COLOR { return Some[Builder](Builder.LinearColor); }
  if name == N_ROTATION { return Some[Builder](Builder.Turn); }
  if name == N_SUNLIGHT { return Some[Builder](Builder.SunLight); }
  if name == N_PHYSICAL { return Some[Builder](Builder.Physical); }
  if name == N_SPHERE { return Some[Builder](Builder.Sphere); }
  if name == N_SIM { return Some[Builder](Builder.Sim); }
  if name == N_LATHE { return Some[Builder](Builder.Lathe); }
  if name == N_LOFTALONG { return Some[Builder](Builder.LoftAlong); }
  if name == N_JOIN { return Some[Builder](Builder.Join); }
  if name == N_ARRAYRADIAL { return Some[Builder](Builder.ArrayRadial); }
  if name == N_TRANSLUCENT { return Some[Builder](Builder.Translucent); }
  if name == N_UNION { return Some[Builder](Builder.Union); }
  if name == N_SPOTLIGHT { return Some[Builder](Builder.SpotLight); }
  if name == N_CLEARCOAT { return Some[Builder](Builder.ClearCoat); }
  if name == N_REFLECTIVE { return Some[Builder](Builder.Reflective); }
  if name == N_CAMERA { return Some[Builder](Builder.CameraLens); }
  if name == N_POINTLIGHT { return Some[Builder](Builder.PointLight); }
  if name == N_DIFFERENCE { return Some[Builder](Builder.Difference); }
  if name == N_SUBDIVIDE { return Some[Builder](Builder.Subdivide); }
  if name == N_INFLATE { return Some[Builder](Builder.Inflate); }
  if name == N_SMOOTH { return Some[Builder](Builder.Smooth); }
  if name == N_CARVE { return Some[Builder](Builder.Carve); }
  if name == N_MIRROR { return Some[Builder](Builder.Mirror); }
  if name == N_MOVE { return Some[Builder](Builder.Move); }
  if name == N_TURN { return Some[Builder](Builder.TurnShape); }
  None
}

fn isBrush(b: Builder) bool {
  b == Builder.BrushDraw || b == Builder.BrushClay || b == Builder.BrushClayStrips || b == Builder.BrushCrease
    || b == Builder.BrushInflate || b == Builder.BrushPinch || b == Builder.BrushSmooth || b == Builder.BrushFlatten
    || b == Builder.BrushLayer || b == Builder.BrushBlob
}

fn makes(b: Builder) Ty {
  if isBrush(b) { return Ty.Stroke; }
  if b == Builder.Box || b == Builder.Lathe || b == Builder.LoftAlong || b == Builder.Join || b == Builder.ArrayRadial
    || b == Builder.Union || b == Builder.Difference || b == Builder.Subdivide || b == Builder.Move || b == Builder.Inflate
    || b == Builder.Smooth || b == Builder.Carve || b == Builder.Mirror
    || b == Builder.TurnShape {
    return Ty.Shape;
  }
  if b == Builder.OutlineRect || b == Builder.OutlinePoints || b == Builder.OutlineGiven || b == Builder.OutlineEllipse
    || b == Builder.OutlineOffset {
    return Ty.Outline;
  }
  if b == Builder.SpineLine || b == Builder.SpineThrough { return Ty.Spine; }
  if b == Builder.Translucent || b == Builder.ClearCoat || b == Builder.Reflective { return Ty.Modifier; }
  if b == Builder.CameraLens { return Ty.Camera; }
  if b == Builder.Layered { return Ty.Material; }
  if b == Builder.Plain || b == Builder.Physical { return Ty.Material; }
  if b == Builder.Sphere { return Ty.Volume; }
  if b == Builder.Sim { return Ty.SimTime; }
  if b == Builder.Srgb || b == Builder.LinearColor { return Ty.Color; }
  if b == Builder.Turn { return Ty.Rotation; }
  Ty.Light
}

fn tyName(t: Ty) &str {
  if t == Ty.Pure { return "a plain number"; }
  if t == Ty.Length { return "a length"; }
  if t == Ty.Angle { return "an angle"; }
  if t == Ty.Illuminance { return "light falling on a surface (lux)"; }
  if t == Ty.Truth { return "true or false"; }
  if t == Ty.Point { return "a point (three lengths)"; }
  if t == Ty.Direction { return "a direction (three numbers)"; }
  if t == Ty.LengthRange { return "a range of lengths"; }
  if t == Ty.Color { return "a color"; }
  if t == Ty.Rotation { return "a rotation"; }
  if t == Ty.Shape { return "a shape"; }
  if t == Ty.Material { return "a material"; }
  if t == Ty.Duration { return "a duration, such as 4 s"; }
  if t == Ty.SimTime { return "a time on the world's clock, such as sim(4 s)"; }
  if t == Ty.Volume { return "a space, such as sphere(radius: 2 m)"; }
  if t == Ty.Point2 { return "a flat point (two lengths)"; }
  if t == Ty.Outline { return "an outline: a flat path, such as [(0, 0), (0.05, 0)]"; }
  if t == Ty.Outlines { return "a list of outlines, in [ ]"; }
  if t == Ty.Spine { return "a spine: a path through space, such as spine.line(...)"; }
  if t == Ty.Shapes { return "a list of shapes, in [ ]"; }
  if t == Ty.Modifier { return "a material's modifier, such as translucent(covers: 0.5)"; }
  if t == Ty.Intensity { return "a light's strength in a direction (candela)"; }
  if t == Ty.Camera { return "a camera, such as camera(lens: 85 mm)"; }
  if t == Ty.Points { return "a list of points, in [ ]"; }
  if t == Ty.Numbers { return "a list of plain numbers, in [ ]"; }
  if t == Ty.Stroke { return "a stroke, such as brush.clay(along: [...], radius: 1 cm)"; }
  if t == Ty.Strokes { return "a list of strokes, in [ ]"; }
  "a light"
}

fn kindName(k: Kind) &str {
  if k == Kind.Group { return "a group of parts"; }
  if k == Kind.Shape { return "a shape"; }
  if k == Kind.Material { return "a material"; }
  if k == Kind.Light { return "a light"; }
  "an arrival"
}

// A unit's kind and how many of the kind's base unit it is; Pure for no unit known
fn unitDim(unit: u32) Ty {
  if unit == N_M || unit == N_CM || unit == N_MM { return Ty.Length; }
  if unit == N_DEG || unit == N_DEGSIGN || unit == N_RAD { return Ty.Angle; }
  if unit == N_LUX { return Ty.Illuminance; }
  if unit == N_CANDELA { return Ty.Intensity; }
  if unit == N_S || unit == N_MS { return Ty.Duration; }
  Ty.Pure
}

fn unitScale(unit: u32) f64 {
  if unit == N_CM { return 0.01; }
  if unit == N_MM || unit == N_MS { return 0.001; }
  if unit == N_DEG || unit == N_DEGSIGN { return 3.14159265358979323846 / 180.; }
  1.
}

// The world a text's parts describe
pub fn understand(decls: &List[PartDecl], names: Names, problems: &mut List[Problem]) Understood {
  var c = Checker(List[Node].empty(), List[Problem].empty(), names, List[FieldInfo].empty(), List[AreaInfo].empty(),
    List[DeriveInfo].empty(), List[usize].empty(), List[RuleInfo].empty(), List[Problem].empty(), List[FnInfo].empty(),
    List[u32].empty(), List[Ty].empty(), List[MoveInfo].empty());
  var units = List[Unit].empty();
  if decls.len() > 0usize {
    c.place(&decls[0], 0usize);
    c.check(&decls[0], &mut units);
    var i = 1usize;
    while i < decls.len() {
      problems.push(problem(decls[i].at, "a world file holds one world: this part is left out"));
      i = i + 1usize;
    }
  }
  c.settleDerives();
  var alive = List[bool].empty();
  var k = 0usize;
  while k < units.len() { alive.push(true); k = k + 1usize; }
  var nodes = List[Node].empty();
  nodes <-> c.nodes;
  var table = Names.empty();
  table <-> c.names;
  var fields = List[FieldInfo].empty();
  fields <-> c.fields;
  var areas = List[AreaInfo].empty();
  areas <-> c.areas;
  var derives = List[DeriveInfo].empty();
  derives <-> c.derives;
  var rules = List[RuleInfo].empty();
  rules <-> c.rules;
  var deriveOrder = List[usize].empty();
  deriveOrder <-> c.deriveOrder;
  var functions = List[FnInfo].empty();
  functions <-> c.fns;
  var moves = List[MoveInfo].empty();
  moves <-> c.moves;
  var w = Understood(nodes, units, alive, List[usize].empty(), table, fields, areas, derives, deriveOrder, rules, functions,
    moves);
  order(&mut w, &mut c.problems);
  leaveOutBehaviors(&mut w, &mut c.later);
  var i = 0usize;
  while i < c.problems.len() {
    problems.push(Problem(c.problems[i].at, c.problems[i].message.copy()));
    i = i + 1usize;
  }
  i = 0usize;
  while i < c.later.len() {
    problems.push(Problem(c.later[i].at, c.later[i].message.copy()));
    i = i + 1usize;
  }
  w
}

struct Checker {
  nodes: List[Node];
  problems: List[Problem];   // these leave out the part they are written in
  names: Names;
  fields: List[FieldInfo];
  areas: List[AreaInfo];
  derives: List[DeriveInfo];
  deriveOrder: List[usize];
  rules: List[RuleInfo];
  later: List[Problem];      // a behavior's: only the behavior is lost
  fns: List[FnInfo];
  letNames: List[u32];       // the steps of the function being checked, so far
  letTys: List[Ty];
  moves: List[MoveInfo];

  fn failName(self: &mut, at: Spot, a: &str, name: u32, c: &str) {
    var m = String.from(a);
    m.append(self.names.text(name));
    m.append(c);
    self.problems.push(Problem(at, m));
  }

  fn fail(self: &mut, at: Spot, a: &str, b: &str, c: &str) {
    var m = String.from(a);
    m.append(b);
    m.append(c);
    self.problems.push(Problem(at, m));
  }

  // Pass 1: every part its slot, its place in the tree, and its kind, so a
  // path may name a part written later
  fn place(self: &mut, d: &PartDecl, parent: usize) {
    let slot = self.nodes.len();
    var kind = Kind.Group;
    match &d.kind {
      case let Some(e) {
        // What makes it: a builder, a function (a shape, for now), or a list
        // whose first item is a material
        var made = Ty.Pure;
        match e {
          case let Call(call) { made = self.callMakes(&call.callee, parent); }
          case let Items(l) {
            if l.items.len() > 0usize {
              match &l.items[0] {
                case let Call(first) { if self.callMakes(&first.callee, parent) == Ty.Material { made = Ty.Material; } }
                else {}
              }
            }
          }
          else {}
        }
        if made == Ty.Shape { kind = Kind.Shape; }
        else if made == Ty.Material { kind = Kind.Material; }
        else if made == Ty.Light { kind = Kind.Light; }
      }
      case is None {}
    }
    // A part with no kind inside the world's 'arrivals' is a place to arrive
    if d.kind is None && slot != 0usize && self.nodes[parent].name == N_ARRIVALS && self.nodes[parent].parent == 0usize
      && parent != 0usize {
      kind = Kind.Arrival;
    }
    self.nodes.push(Node(d.name, d.at, parent, List[usize].empty(), kind));
    if slot != parent {
      // A second part of the same name beside it could never be reached
      var i = 0usize;
      while i < self.nodes[parent].children.len() {
        let sib = *self.nodes[parent].children[i];
        if self.nodes[sib].name == d.name {
          self.failName(d.at, "a part named '", d.name, "' is already here: this one cannot be reached by its name");
        }
        i = i + 1usize;
      }
      (&mut self.nodes[parent]).children.push(slot);
    }
    // Its fields, so a path may name one written later; a child and a field
    // share one set of names
    var f = 0usize;
    while f < d.fields.len() {
      let fd = &d.fields[f];
      var ty = Ty.Pure;
      if fd.ty == N_BOOL { ty = Ty.Truth; }
      else if fd.ty == N_PART { ty = Ty.Shape; }     // holds a part, or None
      else if fd.ty != N_NUMBER {
        self.failName(fd.at, "a field's type is 'bool', 'number' or 'part', for now, not '", fd.ty, "'");
      }
      var g = 0usize;
      while g < self.fields.len() {
        if self.fields[g].slot == slot && self.fields[g].name == fd.name {
          self.failName(fd.at, "a field named '", fd.name, "' is already here");
        }
        g = g + 1usize;
      }
      self.fields.push(FieldInfo(slot, fd.name, fd.at, ty, 0., false, false));
      f = f + 1usize;
    }
    // Its functions, so the parts inside it may be made by one
    var g = 0usize;
    while g < d.functions.len() {
      let fd = &d.functions[g];
      if fd.ty != N_SHAPE {
        self.failName(fd.at, "a function makes a shape, for now, not '", fd.ty, "'");
      }
      self.fns.push(FnInfo(slot, fd.name, fd.at, Ty.Shape, List[Val].empty(), Val.Absent));
      g = g + 1usize;
    }
    var i = 0usize;
    while i < d.children.len() {
      self.place(&d.children[i], slot);
      i = i + 1usize;
    }
  }

  // What a call makes: a builder's type, or a function's; Pure if it names neither
  fn callMakes(self: &, callee: &List[u32], scope: usize) Ty {
    match builderOf(callee) {
      case let Some(b) { return makes(b); }
      case is None {}
    }
    if callee.len() == 1usize {
      match self.fnOutward(*callee[0], scope) {
        case let Some(f) { return self.fns[f].ty; }
        case is None {}
      }
    }
    Ty.Pure
  }

  // The nearest function of this name: the part at scope's, then its parent's, ...
  fn fnOutward(self: &, name: u32, scope: usize) Option[usize] {
    var s = scope;
    while true {
      var g = 0usize;
      while g < self.fns.len() {
        if self.fns[g].slot == s && self.fns[g].name == name { return Some[usize](g); }
        g = g + 1usize;
      }
      if s == 0usize { break; }
      s = self.nodes[s].parent;
    }
    None
  }

  // A function's steps and result checked, each step able to read the ones
  // before it by name
  fn checkFunction(self: &mut, fd: &FnDecl, slot: usize) {
    var index = 0usize;
    match self.fnNamedAt(slot, fd.name) {
      case let Some(g) { index = g; }
      case is None { return; }
    }
    self.letNames.clear();
    self.letTys.clear();
    var lets = List[Val].empty();
    var ok = true;
    var i = 0usize;
    while i < fd.lets.len() && ok {
      let ld = &fd.lets[i];
      // A step's type is what its value makes
      var ty = Ty.Pure;
      match &ld.value {
        case let Call(c) { ty = self.callMakes(&c.callee, slot); }
        case let Tuple(t) {
          // A flat point (a place on a side view), or a point
          if t.items.len() == 2usize { ty = Ty.Point2; }
          else if t.items.len() == 3usize { ty = Ty.Point; }
        }
        case let Items(l) {
          // A list of flat points: an outline; of points: what a spine runs through
          if l.items.len() > 0usize {
            match &l.items[0] {
              case let Tuple(t) {
                if t.items.len() == 2usize { ty = Ty.Outline; }
                else if t.items.len() == 3usize { ty = Ty.Points; }
              }
              else {}
            }
          }
        }
        case let Path(p) {
          if p.names.len() == 1usize {
            var k = 0usize;
            while k < self.letNames.len() { if *self.letNames[k] == *p.names[0] { ty = *self.letTys[k]; } k = k + 1usize; }
          }
        }
        else {}
      }
      if ty == Ty.Pure {
        self.failName(ld.at, "'", ld.name, "' is made by a call of a shape tool or a builder, or is a list of flat points, for now");
        ok = false;
      } else {
        match self.value(&ld.value, ty, slot) {
          case let Some(v) { lets.push(v); self.letNames.push(ld.name); self.letTys.push(ty); }
          case is None { ok = false; }
        }
      }
      i = i + 1usize;
    }
    var result = Val.Absent;
    if ok {
      match self.value(&fd.result, self.fns[index].ty, slot) {
        case let Some(v) { result = v; }
        case is None {}
      }
    }
    self.letNames.clear();
    self.letTys.clear();
    (&mut self.fns[index]).lets <-> lets;
    (&mut self.fns[index]).result = result;
  }

  fn fnNamedAt(self: &, slot: usize, name: u32) Option[usize] {
    var g = 0usize;
    while g < self.fns.len() {
      if self.fns[g].slot == slot && self.fns[g].name == name { return Some[usize](g); }
      g = g + 1usize;
    }
    None
  }

  // A field of the part at slot, by name
  fn fieldNamed(self: &, slot: usize, name: u32) Option[usize] {
    var g = 0usize;
    while g < self.fields.len() {
      if self.fields[g].slot == slot && self.fields[g].name == name { return Some[usize](g); }
      g = g + 1usize;
    }
    None
  }

  // Pass 2, in the same order: what makes each part, and its options
  fn check(self: &mut, d: &PartDecl, units: &mut List[Unit]) {
    let slot = units.len();
    let kind = self.nodes[slot].kind;
    // Its functions first: what makes it, or a part inside it, may call one
    var g = 0usize;
    while g < d.functions.len() {
      self.checkFunction(&d.functions[g], slot);
      g = g + 1usize;
    }
    var make = Val.Absent;
    match &d.kind {
      case let Some(e) {
        if kind == Kind.Group || kind == Kind.Arrival {
          // Nothing that makes a part, as pass 1 found: checked as a shape
          // only to say what it is instead
          match self.value(e, Ty.Shape, slot) {
            case let Some(v) {}
            case is None {}
          }
        }
        else {
          var want = Ty.Shape;
          if kind == Kind.Material { want = Ty.Material; }
          else if kind == Kind.Light { want = Ty.Light; }
          match self.value(e, want, slot) {
            case let Some(v) { make = v; }
            case is None {}
          }
        }
      }
      case is None {}
    }
    let opts = optionsOf(kind);
    var options = List[Val].empty();
    var given = List[bool].empty();
    var k = 0usize;
    while k < opts.len() { options.push(Val.Absent); given.push(false); k = k + 1usize; }
    var i = 0usize;
    while i < d.options.len() {
      let label = d.options[i].label;
      var found = false;
      k = 0usize;
      while k < opts.len() {
        if opts[k].name == label {
          found = true;
          if *given[k] { self.failName(d.options[i].value.spot(), "the option '", label, "' is given twice"); }
          // Given, even if wrong: its own mistake is reported, not its absence
          given.set(k, true);
          match self.value(&d.options[i].value, opts[k].ty, slot) {
            case let Some(v) { options.set(k, v); }
            case is None {}
          }
        }
        k = k + 1usize;
      }
      if !found {
        var m = String.from("'");
        m.append(self.names.text(label));
        m.append("' is not an option of ");
        m.append(kindName(kind));
        self.problems.push(Problem(d.options[i].value.spot(), m));
      }
      i = i + 1usize;
    }
    k = 0usize;
    while k < opts.len() {
      if opts[k].required && !*given[k] {
        var m = String.from("'");
        m.append(self.names.text(d.name));
        m.append("' needs the option '");
        m.append(self.names.text(opts[k].name));
        m.append("': ");
        m.append(tyName(opts[k].ty));
        self.problems.push(Problem(d.at, m));
      }
      k = k + 1usize;
    }
    // Its fields' defaults and options
    var f = 0usize;
    while f < d.fields.len() {
      self.checkField(&d.fields[f], slot);
      f = f + 1usize;
    }
    // Its behaviors: what is set aside is counted
    var aside = 0usize;
    var b = 0usize;
    while b < d.behaviors.len() {
      if !self.behavior(&d.behaviors[b], slot) { aside = aside + 1usize; }
      b = b + 1usize;
    }
    units.push(Unit(make, options, aside));
    i = 0usize;
    while i < d.children.len() {
      self.check(&d.children[i], units);
      i = i + 1usize;
    }
  }

  // An expression checked as a value of the type wanted; None after a mistake,
  // reported
  fn value(self: &mut, e: &Expr, want: Ty, scope: usize) Option[Val] {
    match e {
      case let Number(n) { return self.number(n.value, n.unit, n.at, want); }
      case let Truth(t) {
        if want == Ty.Truth { return Some[Val](Val.Truth(t.value)); }
        self.fail(t.at, "expected ", tyName(want), ", not true or false");
        return None;
      }
      case let Negative(g) {
        self.fail(g.at, "only a number can be negative, for now", "", "");
        return None;
      }
      case let Tuple(t) {
        var item = Ty.Length;
        var count = 3usize;
        if want == Ty.Direction { item = Ty.Pure; }
        else if want == Ty.Point2 { count = 2usize; }
        else if want != Ty.Point {
          self.fail(t.at, "expected ", tyName(want), ", not a group of values in ( )");
          return None;
        }
        if t.items.len() != count {
          self.fail(t.at, "expected ", tyName(want), ", written as its values in ( )");
          return None;
        }
        var items = List[Val].empty();
        var i = 0usize;
        while i < t.items.len() {
          match self.value(&t.items[i], item, scope) {
            case let Some(v) { items.push(v); }
            case is None { return None; }
          }
          i = i + 1usize;
        }
        return Some[Val](Val.Tuple(items));
      }
      case let Range(r) {
        if want != Ty.LengthRange {
          self.fail(r.at, "expected ", tyName(want), ", not a range");
          return None;
        }
        var ends = List[Val].empty();
        var i = 0usize;
        while i < 2usize {
          match self.value(&r.ends[i], Ty.Length, scope) {
            case let Some(v) { ends.push(v); }
            case is None { return None; }
          }
          i = i + 1usize;
        }
        if numOf(&ends[0]) > numOf(&ends[1]) {
          self.fail(r.at, "this range runs backward: its low end comes first", "", "");
          return None;
        }
        return Some[Val](Val.Range(ends));
      }
      case let Path(p) {
        // A direction by its name (Sculpting: up, down, left, right, front,
        // back), where a direction is wanted
        if want == Ty.Direction && p.names.len() == 1usize {
          let n = *p.names[0];
          var x = 0.;
          var y = 0.;
          var z = 0.;
          var named = true;
          if n == N_UP { y = 1.; }
          else if n == N_DOWN { y = -1.; }
          else if n == N_LEFT { x = -1.; }
          else if n == N_RIGHT { x = 1.; }
          else if n == N_FRONT { z = 1.; }
          else if n == N_BACK { z = -1.; }
          else { named = false; }
          if named {
            var items = List[Val].empty();
            items.push(Val.Num(x));
            items.push(Val.Num(y));
            items.push(Val.Num(z));
            return Some[Val](Val.Tuple(items));
          }
        }
        // A step of the function being checked, by its name
        if p.names.len() == 1usize {
          var k = self.letNames.len();
          while k > 0usize {
            k = k - 1usize;
            if *self.letNames[k] == *p.names[0] {
              if *self.letTys[k] != want {
                self.failName(p.at, "'", *p.names[0], "' is not the kind of value wanted here");
                return None;
              }
              return Some[Val](Val.Local(k));
            }
          }
        }
        return self.path(&p.names, p.at, want, scope);
      }
      case let Call(call) { return self.call(&call.callee, &call.args, call.at, want, scope); }
      case let Items(l) {
        // A list: of outlines, of shapes; of flat points where an outline is
        // wanted (an open outline); a material then its modifiers
        var item = Ty.Pure;
        if want == Ty.Outlines { item = Ty.Outline; }
        else if want == Ty.Shapes { item = Ty.Shape; }
        else if want == Ty.Outline { item = Ty.Point2; }
        else if want == Ty.Material { item = Ty.Material; }
        else if want == Ty.Points { item = Ty.Point; }
        else if want == Ty.Numbers { item = Ty.Pure; }
        else if want == Ty.Strokes { item = Ty.Stroke; }
        else {
          self.fail(l.at, "expected ", tyName(want), ", not a list");
          return None;
        }
        var items = List[Val].empty();
        var i = 0usize;
        while i < l.items.len() {
          let itemTy = if want == Ty.Material && i > 0usize { Ty.Modifier } else { item };
          match self.value(&l.items[i], itemTy, scope) {
            case let Some(v) { items.push(v); }
            case is None { return None; }
          }
          i = i + 1usize;
        }
        if want == Ty.Outline {
          if items.len() < 2usize { self.fail(l.at, "an outline needs at least two points", "", ""); return None; }
          return Some[Val](Val.Make(Made(Builder.OutlinePoints, items)));
        }
        if want == Ty.Material {
          if items.len() == 0usize { self.fail(l.at, "expected a material, then its modifiers", "", ""); return None; }
          return Some[Val](Val.Make(Made(Builder.Layered, items)));
        }
        return Some[Val](Val.Items(items));
      }
      case let If(i) {
        self.fail(i.at, "expected ", tyName(want), ": an 'if' is understood only in a derive, for now");
        return None;
      }
      // What is left of these after expand.cone reads a value only known as the world runs
      case let Binary(b) {
        self.fail(b.at, "expected ", tyName(want), ": arithmetic is understood only on numbers known as the world is read, for now");
        return None;
      }
      case let Not(n) {
        self.fail(n.at, "expected ", tyName(want), ", not a '!'");
        return None;
      }
      case let Below(r) {
        self.fail(r.at, "expected ", tyName(want), ": a range written '..<' is for 'each', for now");
        return None;
      }
    }
  }

  fn number(self: &mut, value: f64, unit: u32, at: Spot, want: Ty) Option[Val] {
    if want != Ty.Pure && want != Ty.Length && want != Ty.Angle && want != Ty.Illuminance && want != Ty.Duration
      && want != Ty.Intensity {
      self.fail(at, "expected ", tyName(want), ", not a number");
      return None;
    }
    if unit == N_NONE {
      // A plain number: meters in a shape, radians as an angle; a light's
      // strength and a duration say their unit
      if want == Ty.Illuminance || want == Ty.Duration || want == Ty.Intensity {
        self.fail(at, "expected ", tyName(want), ": a number with its unit");
        return None;
      }
      return Some[Val](Val.Num(value));
    }
    let dim = unitDim(unit);
    if dim == Ty.Pure {
      self.failName(at, "'", unit, "' is not a unit");
      return None;
    }
    if dim != want {
      self.fail(at, "expected ", tyName(want), ", not a number in that unit");
      return None;
    }
    Some[Val](Val.Num(value * unitScale(unit)))
  }

  // A path to a part, which must be of the kind wanted
  fn path(self: &mut, path: &List[u32], at: Spot, want: Ty, scope: usize) Option[Val] {
    var slot = 0usize;
    match self.lookOutward(*path[0], scope) {
      case let Some(s) { slot = s; }
      case is None {
        self.failName(at, "nothing named '", *path[0], "' is in reach here");
        return None;
      }
    }
    var i = 1usize;
    while i < path.len() {
      match self.childNamed(slot, *path[i]) {
        case let Some(s) { slot = s; }
        case is None {
          var m = String.from("'");
          m.append(self.names.text(self.nodes[slot].name));
          m.append("' holds no part named '");
          m.append(self.names.text(*path[i]));
          m.append("'");
          self.problems.push(Problem(at, m));
          return None;
        }
      }
      i = i + 1usize;
    }
    let kind = self.nodes[slot].kind;
    if (want == Ty.Material && kind == Kind.Material) || (want == Ty.Shape && kind == Kind.Shape)
      || (want == Ty.Light && kind == Kind.Light) {
      return Some[Val](Val.Ref(slot));
    }
    var m = String.from("expected ");
    m.append(tyName(want));
    m.append(", but '");
    m.append(self.names.text(self.nodes[slot].name));
    m.append("' is ");
    m.append(kindName(kind));
    self.problems.push(Problem(at, m));
    None
  }

  // The nearest part of this name: among the children of scope, then of its
  // parent, and so on; then the world itself
  fn lookOutward(self: &, name: u32, scope: usize) Option[usize] {
    var s = scope;
    while true {
      match self.childNamed(s, name) {
        case let Some(found) { return Some[usize](found); }
        case is None {}
      }
      if s == 0usize { break; }
      s = self.nodes[s].parent;
    }
    if self.nodes[0].name == name { return Some[usize](0usize); }
    None
  }

  fn childNamed(self: &, slot: usize, name: u32) Option[usize] {
    var i = 0usize;
    while i < self.nodes[slot].children.len() {
      let c = *self.nodes[slot].children[i];
      if self.nodes[c].name == name { return Some[usize](c); }
      i = i + 1usize;
    }
    None
  }

  // A builder called: its arguments put in its own order and checked
  fn call(self: &mut, callee: &List[u32], args: &List[Arg], at: Spot, want: Ty, scope: usize) Option[Val] {
    var b = Builder.Box;
    var found = false;
    match builderOf(callee) {
      case let Some(x) { b = x; found = true; }
      case is None {}
    }
    // A function of this part or one round it
    if !found && callee.len() == 1usize {
      match self.fnOutward(*callee[0], scope) {
        case let Some(f) {
          if args.len() > 0usize {
            self.failName(at, "'", *callee[0], "' takes no values");
            return None;
          }
          if self.fns[f].ty != want {
            var m = String.from("expected ");
            m.append(tyName(want));
            m.append(", but '");
            m.append(self.names.text(*callee[0]));
            m.append("' makes ");
            m.append(tyName(self.fns[f].ty));
            self.problems.push(Problem(at, m));
            return None;
          }
          return Some[Val](Val.Call(f));
        }
        case is None {}
      }
    }
    if !found {
      self.failName(at, "there is no '", *callee[callee.len() - 1usize], "' to call, for now");
      return None;
    }
    if makes(b) != want {
      var m = String.from("expected ");
      m.append(tyName(want));
      m.append(", but '");
      m.append(self.names.text(*callee[0]));
      m.append("' makes ");
      m.append(tyName(makes(b)));
      self.problems.push(Problem(at, m));
      return None;
    }
    let params = signature(b);
    var vals = List[Val].empty();
    var given = List[bool].empty();
    var k = 0usize;
    while k < params.len() { vals.push(Val.Absent); given.push(false); k = k + 1usize; }
    var ok = true;
    var next = 0usize;            // the next parameter an argument by position fills
    var i = 0usize;
    while i < args.len() {
      var p = params.len();
      if args[i].label == N_NONE {
        p = next;
        if p >= params.len() {
          self.failName(args[i].value.spot(), "too many values for '", *callee[0], "'");
          return None;
        }
      }
      else {
        k = 0usize;
        while k < params.len() {
          if params[k].name == args[i].label { p = k; }
          k = k + 1usize;
        }
        if p == params.len() {
          var m = String.from("'");
          m.append(self.names.text(*callee[0]));
          m.append("' has nothing named '");
          m.append(self.names.text(args[i].label));
          m.append("'");
          self.problems.push(Problem(args[i].value.spot(), m));
          return None;
        }
      }
      if *given[p] {
        self.failName(args[i].value.spot(), "'", params[p].name, "' is given twice");
        return None;
      }
      match self.value(&args[i].value, params[p].ty, scope) {
        case let Some(v) { vals.set(p, v); given.set(p, true); }
        case is None { ok = false; }
      }
      next = p + 1usize;
      i = i + 1usize;
    }
    if !ok { return None; }
    k = 0usize;
    while k < params.len() {
      if params[k].required && !*given[k] {
        var m = String.from("'");
        m.append(self.names.text(*callee[0]));
        m.append("' needs '");
        m.append(self.names.text(params[k].name));
        m.append("': ");
        m.append(tyName(params[k].ty));
        self.problems.push(Problem(at, m));
        return None;
      }
      k = k + 1usize;
    }
    Some[Val](Val.Make(Made(b, vals)))
  }

  // -------- fields and behaviors --------

  // The mistakes reported since 'from' become a behavior's: they lose the
  // behavior, not the part
  fn toLater(self: &mut, from: usize) {
    var moved = List[Problem].empty();
    while self.problems.len() > from {
      match self.problems.pop() {
        case let Some(p) { moved.push(p); }
        case is None {}
      }
    }
    while moved.len() > 0usize {
      match moved.pop() {
        case let Some(p) { self.later.push(p); }
        case is None {}
      }
    }
  }

  fn failLater(self: &mut, at: Spot, a: &str, b: &str) {
    var m = String.from(a);
    m.append(b);
    self.later.push(Problem(at, m));
  }

  // A field's default and its options: lives: client (for now), mutable:
  fn checkField(self: &mut, fd: &FieldDecl, slot: usize) {
    var idx = 0usize;
    match self.fieldNamed(slot, fd.name) {
      case let Some(i) { idx = i; }
      case is None { return; }
    }
    let ty = self.fields[idx].ty;
    if ty == Ty.Shape {
      // a part field: None, or a part by its path; kept as the part's slot, -1 for none
      (&mut self.fields[idx]).init = -1.;
      match &fd.value {
        case let Some(e) {
          match self.partOrNone(e, slot) {
            case let Some(s) { (&mut self.fields[idx]).init = f64.from(s); }
            case is None {}
          }
        }
        case is None {}
      }
    }
    else { match &fd.value {
      case let Some(e) {
        match self.value(e, ty, slot) {
          case let Some(v) {
            match &v {
              case let Num(x) { (&mut self.fields[idx]).init = *x; }
              case let Truth(b) { (&mut self.fields[idx]).init = if *b { 1. } else { 0. }; }
              else {}
            }
          }
          case is None {}
        }
      }
      case is None {}
    } }
    var i = 0usize;
    while i < fd.options.len() {
      let label = fd.options[i].label;
      if label == N_LIVES {
        var place = N_NONE;
        match &fd.options[i].value {
          case let Path(p) { if p.names.len() == 1usize { place = *p.names[0]; } }
          else {}
        }
        if place == N_SERVER || place == N_BOTH {
          self.fail(fd.options[i].value.spot(), "a field lives on each visitor's machine (lives: client), for now", "", "");
        }
        else if place != N_CLIENT {
          self.fail(fd.options[i].value.spot(), "where a field lives is client, server or both", "", "");
        }
      }
      else if label == N_MUTABLE {
        match self.value(&fd.options[i].value, Ty.Truth, slot) {
          case let Some(v) {
            match &v {
              case let Truth(b) { (&mut self.fields[idx]).mutable = *b; }
              else {}
            }
          }
          case is None {}
        }
      }
      else {
        self.failName(fd.options[i].value.spot(), "'", label, "' is not an option of a field, for now");
      }
      i = i + 1usize;
    }
  }

  // One behavior line of the part at slot, understood; false if it is set
  // aside ('solid', which has no physics yet, and what is not understood)
  fn behavior(self: &mut, e: &Expr, slot: usize) bool {
    let from = self.problems.len();
    var used = true;
    match e {
      case let Call(call) {
        var name = N_NONE;
        if call.callee.len() == 1usize { name = *call.callee[0]; }
        if name == N_SOLID { used = false; }
        else if name == N_AREA { self.area(&call.args, call.at, slot); }
        else if name == N_DERIVE { self.derive(&call.args, call.at, slot); }
        else if name == N_ON { self.rule(&call.args, call.at, slot); }
        else {
          self.failLater(call.at, "this behavior is not understood yet: it is set aside", "");
          used = false;
        }
      }
      else {
        self.failLater(e.spot(), "a behavior is a call, such as derive(...) or on(...)", "");
        used = false;
      }
    }
    self.toLater(from);
    used
  }

  // Are there exactly n arguments, all by position?
  fn positional(self: &mut, args: &List[Arg], n: usize, at: Spot, what: &str) bool {
    var ok = args.len() >= n;
    var i = 0usize;
    while i < n && i < args.len() {
      if args[i].label != N_NONE { ok = false; }
      i = i + 1usize;
    }
    if !ok { self.fail(at, what, "", ""); }
    ok
  }

  // area(self, sphere(radius:, at:))
  fn area(self: &mut, args: &List[Arg], at: Spot, slot: usize) {
    if !self.positional(args, 2usize, at, "area(self, space): the part, then the space round it") { return; }
    if !isName(&args[0].value, N_SELF) {
      self.fail(args[0].value.spot(), "an area is the space round the part it is written in: area(self, ...), for now", "", "");
      return;
    }
    var i = 0usize;
    while i < self.areas.len() {
      if self.areas[i].slot == slot {
        self.fail(at, "this part already has an area", "", "");
        return;
      }
      i = i + 1usize;
    }
    match self.value(&args[1].value, Ty.Volume, slot) {
      case let Some(v) {
        match &v {
          case let Make(m) {
            var c = Array[f64, 3]() <- fill 0.;
            match &m.args[1] {
              case let Tuple(items) { c[0] = numOf(&items[0]); c[1] = numOf(&items[1]); c[2] = numOf(&items[2]); }
              else {}
            }
            self.areas.push(AreaInfo(at, slot, numOf(&m.args[0]), c[0], c[1], c[2], true));
          }
          else {}
        }
      }
      case is None {}
    }
  }

  // derive(target, formula): the target a field of the part, or its tint
  fn derive(self: &mut, args: &List[Arg], at: Spot, slot: usize) {
    if !self.positional(args, 2usize, at, "derive(value, formula): what it keeps up to date, then how it is worked out") { return; }
    var target = Target(P_FIELD, 0usize);
    match &args[0].value {
      case let Path(p) {
        match self.member(&p.names, slot, p.at) {
          case let Some(t) { target = t; }
          case is None { return; }
        }
      }
      else {
        self.fail(args[0].value.spot(), "expected the value it keeps up to date: a field, or a part's tint", "", "");
        return;
      }
    }
    var want = Ty.Pure;
    var owner = slot;
    if target.prop == P_FIELD {
      want = self.fields[target.index].ty;
      owner = self.fields[target.index].slot;
      if self.fields[target.index].mutable {
        self.failName(at, "'", self.fields[target.index].name,
          "' is derived, so it is not marked mutable: derive writes it, and nothing else may");
        return;
      }
    }
    else if target.prop == P_TINT { owner = target.index; }
    else {
      self.fail(args[0].value.spot(), "a derive keeps a field or a tint up to date, for now", "", "");
      return;
    }
    var reads = List[usize].empty();
    var uses = List[usize].empty();
    uses.push(slot);
    uses.push(owner);
    match self.calc(&args[1].value, want, slot, &mut reads, &mut uses) {
      case let Some(c) { self.derives.push(DeriveInfo(at, target, c, reads, uses, true)); }
      case is None {}
    }
  }

  // A derive's formula, checked as a value of the type wanted; the fields it
  // reads and the parts it names are added to reads and uses
  fn calc(self: &mut, e: &Expr, want: Ty, scope: usize, reads: &mut List[usize], uses: &mut List[usize]) Option[Calc] {
    match e {
      case let Number(n) {
        match self.number(n.value, n.unit, n.at, want) {
          case let Some(v) { return Some[Calc](Calc.Num(numOf(&v))); }
          case is None { return None; }
        }
      }
      case let Truth(t) {
        if want == Ty.Truth { return Some[Calc](Calc.Num(if t.value { 1. } else { 0. })); }
        self.fail(t.at, "expected ", tyName(want), ", not true or false");
        return None;
      }
      case let Path(p) {
        match self.member(&p.names, scope, p.at) {
          case let Some(t) {
            if t.prop != P_FIELD {
              self.fail(p.at, "a formula reads fields, for now", "", "");
              return None;
            }
            if self.fields[t.index].ty != want {
              self.failName(p.at, "'", self.fields[t.index].name, "' is not the kind of value wanted here");
              return None;
            }
            reads.push(t.index);
            uses.push(self.fields[t.index].slot);
            return Some[Calc](Calc.Field(t.index));
          }
          case is None { return None; }
        }
      }
      case let Call(call) {
        if call.callee.len() != 1usize || *call.callee[0] != N_OCCUPIED {
          self.fail(call.at, "a formula calls occupied(...), for now", "", "");
          return None;
        }
        if want != Ty.Truth {
          self.fail(call.at, "expected ", tyName(want), ", but occupied(...) is true or false");
          return None;
        }
        if call.args.len() != 2usize || call.args[0].label != N_NONE || call.args[1].label != N_BY {
          self.fail(call.at, "occupied(part, by: me): the part whose area is watched, and by whom", "", "");
          return None;
        }
        if !isName(&call.args[1].value, N_ME) {
          self.fail(call.args[1].value.spot(), "occupied(..., by: me): by the visitor on this machine, for now", "", "");
          return None;
        }
        var part = scope;
        if !isName(&call.args[0].value, N_SELF) {
          match &call.args[0].value {
            case let Path(p) {
              match self.path(&p.names, p.at, Ty.Shape, scope) {
                case let Some(v) { part = refOf(&v); }
                case is None { return None; }
              }
            }
            else {
              self.fail(call.args[0].value.spot(), "expected the part whose area is watched", "", "");
              return None;
            }
          }
        }
        uses.push(part);
        return Some[Calc](Calc.Occupied(part));
      }
      case let If(i) {
        var parts = List[Calc].empty();
        var k = 0usize;
        while k < 3usize {
          match self.calc(&i.parts[k], if k == 0usize { Ty.Truth } else { want }, scope, reads, uses) {
            case let Some(c) { parts.push(c); }
            case is None { return None; }
          }
          k = k + 1usize;
        }
        return Some[Calc](Calc.Choose(parts));
      }
      else {
        self.fail(e.spot(), "expected ", tyName(want), ": a number, a field, occupied(...) or an if");
        return None;
      }
    }
  }

  // What a path in a behavior names: a field, or a property of a part
  // (rotation, offset, tint). One name is looked for among the fields and
  // properties of the part it is written in, then the fields of the parts
  // round it; a longer path names a part first, as any path does
  fn member(self: &mut, names: &List[u32], scope: usize, at: Spot) Option[Target] {
    let n = names.len();
    let last = *names[n - 1usize];
    var slot = scope;
    if n == 1usize {
      var s = scope;
      while true {
        match self.fieldNamed(s, last) {
          case let Some(f) { return Some[Target](Target(P_FIELD, f)); }
          case is None {}
        }
        if s == 0usize { break; }
        s = self.nodes[s].parent;
      }
    }
    else {
      if *names[0] == N_SELF { slot = scope; }
      else {
        match self.lookOutward(*names[0], scope) {
          case let Some(s) { slot = s; }
          case is None {
            self.failName(at, "nothing named '", *names[0], "' is in reach here");
            return None;
          }
        }
      }
      var i = 1usize;
      while i + 1usize < n {
        match self.childNamed(slot, *names[i]) {
          case let Some(s) { slot = s; }
          case is None {
            self.failName(at, "nothing named '", *names[i], "' is in that part");
            return None;
          }
        }
        i = i + 1usize;
      }
      match self.fieldNamed(slot, last) {
        case let Some(f) { return Some[Target](Target(P_FIELD, f)); }
        case is None {}
      }
    }
    var prop = 0u32;
    if last == N_ROTATION { prop = P_ROTATION; }
    else if last == N_OFFSET { prop = P_OFFSET; }
    else if last == N_TINT { prop = P_TINT; }
    if prop == 0u32 {
      self.failName(at, "no field or property named '", last, "' is in reach here");
      return None;
    }
    if self.nodes[slot].kind != Kind.Shape {
      self.failName(at, "'", last, "' is a property of a shape, for now");
      return None;
    }
    Some[Target](Target(prop, slot))
  }

  // on(trigger, start(animator)): the trigger 'created' or 'clicked(part)'
  fn rule(self: &mut, args: &List[Arg], at: Spot, slot: usize) {
    if !self.positional(args, 2usize, at, "on(trigger, action): when, then what") { return; }
    var clicked = false;
    var part = 0usize;
    if isName(&args[0].value, N_CREATED) {}
    else {
      var ok = false;
      match &args[0].value {
        case let Call(t) {
          if t.callee.len() == 1usize && *t.callee[0] == N_CLICKED && t.args.len() == 1usize {
            // any part: a click on a part inside it counts
            match self.partOf(&t.args[0].value, slot) {
              case let Some(s) { part = s; clicked = true; ok = true; }
              case is None { return; }
            }
          }
        }
        else {}
      }
      if !ok {
        self.fail(args[0].value.spot(), "a trigger is 'created' or 'clicked(part)', for now", "", "");
        return;
      }
    }
    // Pick and place: set(...), start(transition(...)), or a list of them
    if isMoveAction(&args[1].value) {
      if !clicked {
        self.fail(args[1].value.spot(), "set and transition follow a click, for now", "", "");
        return;
      }
      var acts = List[MoveAct].empty();
      match &args[1].value {
        case let Items(l) {
          var i = 0usize;
          while i < l.items.len() {
            match self.moveAct(&l.items[i], slot) {
              case let Some(m) { acts.push(m); }
              case is None { return; }
            }
            i = i + 1usize;
          }
        }
        else {
          match self.moveAct(&args[1].value, slot) {
            case let Some(m) { acts.push(m); }
            case is None { return; }
          }
        }
      }
      self.moves.push(MoveInfo(at, part, acts));
      return;
    }
    match &args[1].value {
      case let Call(a) {
        if a.callee.len() == 1usize && *a.callee[0] == N_START && a.args.len() == 1usize {
          match &a.args[0].value {
            case let Call(k) {
              if k.callee.len() == 1usize && *k.callee[0] == N_KEYS {
                match self.keys(&k.args, k.at, slot) {
                  case let Some(info) { self.rules.push(RuleInfo(at, clicked, part, info, true)); }
                  case is None {}
                }
                return;
              }
            }
            else {}
          }
        }
      }
      else {}
    }
    self.fail(args[1].value.spot(), "an action is start(keys(...)), for now", "", "");
  }

  // The part a path names, of any kind ('self' the part it is written in)
  fn partOf(self: &mut, e: &Expr, scope: usize) Option[usize] {
    match e {
      case let Path(p) {
        if p.names.len() == 1usize && *p.names[0] == N_SELF { return Some[usize](scope); }
        var slot = 0usize;
        match self.lookOutward(*p.names[0], scope) {
          case let Some(s) { slot = s; }
          case is None { self.failName(p.at, "nothing named '", *p.names[0], "' is in reach here"); return None; }
        }
        var i = 1usize;
        while i < p.names.len() {
          match self.childNamed(slot, *p.names[i]) {
            case let Some(s) { slot = s; }
            case is None { self.failName(p.at, "nothing named '", *p.names[i], "' is in that part"); return None; }
          }
          i = i + 1usize;
        }
        Some[usize](slot)
      }
      else {
        self.fail(e.spot(), "expected a part, by its path", "", "");
        None
      }
    }
  }

  // A part, as its slot, or None as -1
  fn partOrNone(self: &mut, e: &Expr, scope: usize) Option[i64] {
    if isName(e, N_NOTHING) { return Some[i64](-1i64); }
    match self.partOf(e, scope) {
      case let Some(s) { Some[i64](i64.from(s)) }
      case is None { None }
    }
  }

  // A field that holds a part, by its name, looked for outward
  fn partField(self: &mut, name: u32, at: Spot, scope: usize) Option[usize] {
    var s = scope;
    while true {
      match self.fieldNamed(s, name) {
        case let Some(f) {
          if self.fields[f].ty != Ty.Shape {
            self.failName(at, "'", name, "' holds no part: a field of type 'part' is wanted here");
            return None;
          }
          return Some[usize](f);
        }
        case is None {}
      }
      if s == 0usize { break; }
      s = self.nodes[s].parent;
    }
    self.failName(at, "no field named '", name, "' is in reach here");
    None
  }

  // set(field, part | None), or start(transition(field.offset, to: part, over: sim(time)))
  fn moveAct(self: &mut, e: &Expr, scope: usize) Option[MoveAct] {
    match e {
      case let Call(c) {
        if c.callee.len() == 1usize && *c.callee[0] == N_SET && c.args.len() == 2usize {
          var name = N_NONE;
          match &c.args[0].value {
            case let Path(p) { if p.names.len() == 1usize { name = *p.names[0]; } }
            else {}
          }
          if name == N_NONE { self.fail(c.at, "set(field, value): the field by its name", "", ""); return None; }
          var f = 0usize;
          match self.partField(name, c.at, scope) {
            case let Some(x) { f = x; }
            case is None { return None; }
          }
          match self.partOrNone(&c.args[1].value, scope) {
            case let Some(v) { return Some[MoveAct](MoveAct(0u32, f, v, 0usize, 0.)); }
            case is None { return None; }
          }
        }
        if c.callee.len() == 1usize && *c.callee[0] == N_START && c.args.len() == 1usize {
          match &c.args[0].value {
            case let Call(t) {
              if t.callee.len() == 1usize && *t.callee[0] == N_TRANSITION {
                return self.transitionAct(&t.args, t.at, scope);
              }
            }
            else {}
          }
        }
      }
      else {}
    }
    self.fail(e.spot(), "a pick-and-place action is set(field, part) or start(transition(field.offset, to:, over:)), for now", "", "");
    None
  }

  fn transitionAct(self: &mut, args: &List[Arg], at: Spot, scope: usize) Option[MoveAct] {
    var f = 0usize;
    var to = 0usize;
    var seconds = 0.5;
    var haveField = false;
    var haveTo = false;
    var i = 0usize;
    while i < args.len() {
      let a = &args[i];
      if a.label == N_NONE && i == 0usize {
        match &a.value {
          case let Path(p) {
            if p.names.len() == 2usize && *p.names[1] == N_OFFSET {
              match self.partField(*p.names[0], p.at, scope) {
                case let Some(x) { f = x; haveField = true; }
                case is None { return None; }
              }
            }
          }
          else {}
        }
        if !haveField {
          self.fail(a.value.spot(), "transition(field.offset, ...): the offset of the part a field holds, for now", "", "");
          return None;
        }
      }
      else if a.label == N_TO {
        match self.partOf(&a.value, scope) {
          case let Some(s) { to = s; haveTo = true; }
          case is None { return None; }
        }
      }
      else if a.label == N_OVER {
        match self.value(&a.value, Ty.SimTime, scope) {
          case let Some(v) {
            match &v {
              case let Make(m) { seconds = numOf(&m.args[0]); }
              else {}
            }
          }
          case is None { return None; }
        }
      }
      else {
        self.fail(a.value.spot(), "transition takes what it moves, then to: and over:", "", "");
        return None;
      }
      i = i + 1usize;
    }
    if !haveField || !haveTo {
      self.fail(at, "transition(field.offset, to: part, over: sim(time))", "", "");
      return None;
    }
    Some[MoveAct](MoveAct(1u32, f, 0i64, to, seconds))
  }

  // keys(target, [key(time, value), ...], loop:, ease:)
  fn keys(self: &mut, args: &List[Arg], at: Spot, scope: usize) Option[KeysInfo] {
    if !self.positional(args, 2usize, at, "keys(value, [key(time, value), ...]): what it moves, then its keys") { return None; }
    var target = Target(P_FIELD, 0usize);
    match &args[0].value {
      case let Path(p) {
        match self.member(&p.names, scope, p.at) {
          case let Some(t) { target = t; }
          case is None { return None; }
        }
      }
      else {
        self.fail(args[0].value.spot(), "expected what the keys move, such as block.rotation", "", "");
        return None;
      }
    }
    var want = Ty.Rotation;
    if target.prop == P_OFFSET { want = Ty.Point; }
    else if target.prop != P_ROTATION {
      self.fail(args[0].value.spot(), "keys move a part's rotation or offset, for now", "", "");
      return None;
    }
    var info = KeysInfo(target.index, target.prop, List[f64].empty(), List[Val].empty(), LOOP_ONCE, false);
    match &args[1].value {
      case let Items(l) {
        if l.items.len() == 0usize {
          self.fail(l.at, "keys need at least one key", "", "");
          return None;
        }
        var i = 0usize;
        while i < l.items.len() {
          var ok = false;
          match &l.items[i] {
            case let Call(k) {
              if k.callee.len() == 1usize && *k.callee[0] == N_KEY && k.args.len() == 2usize
                && k.args[0].label == N_NONE && k.args[1].label == N_NONE {
                match self.value(&k.args[0].value, Ty.SimTime, scope) {
                  case let Some(t) {
                    var seconds = 0.;
                    match &t {
                      case let Make(m) { seconds = numOf(&m.args[0]); }
                      else {}
                    }
                    if info.times.len() > 0usize && seconds < *info.times[info.times.len() - 1usize] {
                      self.fail(k.at, "a key's time comes before the key's before it", "", "");
                      return None;
                    }
                    match self.value(&k.args[1].value, want, scope) {
                      case let Some(v) { info.times.push(seconds); info.values.push(v); ok = true; }
                      case is None { return None; }
                    }
                  }
                  case is None { return None; }
                }
              }
            }
            else {}
          }
          if !ok {
            self.fail(l.items[i].spot(), "a key is key(time, value), such as key(sim(4 s), rotation(120 deg))", "", "");
            return None;
          }
          i = i + 1usize;
        }
      }
      else {
        self.fail(args[1].value.spot(), "expected the keys, in [ ]", "", "");
        return None;
      }
    }
    var i = 2usize;
    while i < args.len() {
      let label = args[i].label;
      var word = N_NONE;
      match &args[i].value {
        case let Path(p) { if p.names.len() == 1usize { word = *p.names[0]; } }
        else {}
      }
      if label == N_LOOP {
        if word == N_ONCE { info.mode = LOOP_ONCE; }
        else if word == N_LOOP { info.mode = LOOP_LOOP; }
        else if word == N_PINGPONG { info.mode = LOOP_PINGPONG; }
        else { self.fail(args[i].value.spot(), "loop: is once, loop or pingpong", "", ""); return None; }
      }
      else if label == N_EASE {
        if word == N_LINEAR { info.linear = true; }
        else { self.fail(args[i].value.spot(), "ease: linear, for now", "", ""); return None; }
      }
      else {
        self.fail(args[i].value.spot(), "keys(...) takes loop: and ease:, for now", "", "");
        return None;
      }
      i = i + 1usize;
    }
    Some[KeysInfo](info)
  }

  // After every part is read: each name used once, one writer for each value,
  // an area wherever occupied(...) watches one, and the derives put in the
  // order they are worked out
  fn settleDerives(self: &mut) {
    var f = 0usize;
    while f < self.fields.len() {
      match self.childNamed(self.fields[f].slot, self.fields[f].name) {
        case let Some(c) {
          self.failName(self.fields[f].at, "a part named '", self.fields[f].name, "' is here too: a child and a field share one set of names");
        }
        case is None {}
      }
      f = f + 1usize;
    }
    var d = 0usize;
    while d < self.derives.len() {
      let target = self.derives[d].target;
      let at = self.derives[d].at;
      // One writer
      var e = 0usize;
      while e < d {
        if self.derives[e].live && self.derives[e].target.prop == target.prop && self.derives[e].target.index == target.index {
          self.failLater(at, "this value has a derive already: a value is set by one thing at a time", "");
          (&mut self.derives[d]).live = false;
        }
        e = e + 1usize;
      }
      var r = 0usize;
      while r < self.rules.len() {
        if self.rules[r].keys.prop == target.prop && self.rules[r].keys.slot == target.index {
          self.failLater(at, "an animator moves this value: a value is set by one thing at a time", "");
          (&mut self.derives[d]).live = false;
        }
        r = r + 1usize;
      }
      if target.prop == P_FIELD { (&mut self.fields[target.index]).derived = true; }
      // An area to watch
      var watched = List[usize].empty();
      occupiedIn(&self.derives[d].calc, &mut watched);
      var w = 0usize;
      while w < watched.len() {
        var found = false;
        var a = 0usize;
        while a < self.areas.len() {
          if self.areas[a].slot == *watched[w] { found = true; }
          a = a + 1usize;
        }
        if !found {
          self.failLater(at, "occupied(...) watches a part with no area: give it one, area(self, ...)", "");
          (&mut self.derives[d]).live = false;
        }
        w = w + 1usize;
      }
      d = d + 1usize;
    }
    // The order: a derive after the derives that write what it reads
    var placed = List[bool].empty();
    d = 0usize;
    while d < self.derives.len() { placed.push(!self.derives[d].live); d = d + 1usize; }
    var progress = true;
    while progress {
      progress = false;
      d = 0usize;
      while d < self.derives.len() {
        if !*placed[d] {
          var ready = true;
          var r = 0usize;
          while r < self.derives[d].reads.len() {
            let field = *self.derives[d].reads[r];
            var e = 0usize;
            while e < self.derives.len() {
              if e != d && !*placed[e] && self.derives[e].target.prop == P_FIELD && self.derives[e].target.index == field {
                ready = false;
              }
              e = e + 1usize;
            }
            r = r + 1usize;
          }
          if ready {
            self.deriveOrder.push(d);
            placed.set(d, true);
            progress = true;
          }
        }
        d = d + 1usize;
      }
    }
    d = 0usize;
    while d < self.derives.len() {
      if !*placed[d] {
        let at = self.derives[d].at;
        self.failLater(at, "these derives each need the other worked out first", "");
        (&mut self.derives[d]).live = false;
      }
      d = d + 1usize;
    }
  }
}

// Is this expression the one name n?
// set(...), start(transition(...)), or a list of actions: a pick-and-place rule's
fn isMoveAction(e: &Expr) bool {
  match e {
    case let Items(l) { l.items.len() > 0usize && isMoveAction(&l.items[0]) }
    case let Call(c) {
      if c.callee.len() == 1usize && *c.callee[0] == N_SET { return true; }
      if c.callee.len() == 1usize && *c.callee[0] == N_START && c.args.len() == 1usize {
        match &c.args[0].value {
          case let Call(t) { return t.callee.len() == 1usize && *t.callee[0] == N_TRANSITION; }
          else {}
        }
      }
      false
    }
    else { false }
  }
}

fn isName(e: &Expr, n: u32) bool {
  match e {
    case let Path(p) { p.names.len() == 1usize && *p.names[0] == n }
    else { false }
  }
}

fn refOf(v: &Val) usize {
  match v {
    case let Ref(s) { *s }
    else { 0usize }
  }
}

// The parts whose areas a formula watches
fn occupiedIn(c: &Calc, out: &mut List[usize]) {
  match c {
    case let Occupied(s) { out.push(*s); }
    case let Choose(parts) { var i = 0usize; while i < parts.len() { occupiedIn(&parts[i], out); i = i + 1usize; } }
    else {}
  }
}

// A behavior that uses a part left out for a mistake is left out too
fn leaveOutBehaviors(w: &mut Understood, problems: &mut List[Problem]) {
  var i = 0usize;
  while i < w.areas.len() {
    if w.areas[i].live && !*w.alive[w.areas[i].slot] {
      (&mut w.areas[i]).live = false;
      leftOut(w, w.areas[i].at, w.areas[i].slot, problems);
    }
    i = i + 1usize;
  }
  i = 0usize;
  while i < w.derives.len() {
    var k = 0usize;
    while k < w.derives[i].uses.len() && w.derives[i].live {
      let s = *w.derives[i].uses[k];
      if !*w.alive[s] {
        (&mut w.derives[i]).live = false;
        leftOut(w, w.derives[i].at, s, problems);
      }
      k = k + 1usize;
    }
    i = i + 1usize;
  }
  i = 0usize;
  while i < w.rules.len() {
    let s = w.rules[i].keys.slot;
    let p = w.rules[i].part;
    if w.rules[i].live && (!*w.alive[s] || (w.rules[i].clicked && !*w.alive[p])) {
      (&mut w.rules[i]).live = false;
      leftOut(w, w.rules[i].at, if !*w.alive[s] { s } else { p }, problems);
    }
    i = i + 1usize;
  }
}

fn leftOut(w: &Understood, at: Spot, slot: usize, problems: &mut List[Problem]) {
  var m = String.from("this behavior is left out: it uses '");
  m.append(w.names.text(w.nodes[slot].name));
  m.append("', which has a mistake");
  problems.push(Problem(at, m));
}

fn numOf(v: &Val) f64 {
  match v {
    case let Num(x) { *x }
    else { 0. }
  }
}

// -------- the order --------

// Slots in an order each comes after its parent and the parts it uses; a
// part with a mistake, or using one, is left out, with what is inside it
fn order(w: &mut Understood, problems: &mut List[Problem]) {
  // A mistake reported at a part's own line, or inside it, leaves it out
  var s = 0usize;
  while s < w.nodes.len() {
    let first = w.nodes[s].at.line;
    var last = 0xFFFFFFFFu32;
    if s + 1usize < w.nodes.len() { last = w.nodes[s + 1usize].at.line; }
    var i = 0usize;
    while i < problems.len() {
      let line = problems[i].at.line;
      if line >= first && line < last { w.alive.set(s, false); }
      i = i + 1usize;
    }
    s = s + 1usize;
  }
  var state = List[u8].empty();       // 0 not yet, 1 under way, 2 placed
  s = 0usize;
  while s < w.nodes.len() { state.push(0u8); s = s + 1usize; }
  s = 0usize;
  while s < w.nodes.len() {
    visit(w, s, &mut state, problems);
    s = s + 1usize;
  }
}

fn visit(w: &mut Understood, s: usize, state: &mut List[u8], problems: &mut List[Problem]) {
  if *state[s] != 0u8 { return; }
  state.set(s, 1u8);
  var deps = List[usize].empty();
  if s != 0usize { deps.push(w.nodes[s].parent); }
  refsOf(&w.units[s].make, &mut deps);
  var k = 0usize;
  while k < w.units[s].options.len() {
    refsOf(&w.units[s].options[k], &mut deps);
    k = k + 1usize;
  }
  var i = 0usize;
  while i < deps.len() {
    let d = *deps[i];
    if *state[d] == 1u8 {
      var m = String.from("'");
      m.append(w.names.text(w.nodes[s].name));
      m.append("' and '");
      m.append(w.names.text(w.nodes[d].name));
      m.append("' each need the other made first");
      problems.push(Problem(w.nodes[s].at, m));
      w.alive.set(s, false);
    }
    else {
      visit(w, d, state, problems);
      if !*w.alive[d] && *w.alive[s] {
        w.alive.set(s, false);
        // Inside a part left out says nothing more; a part used says why
        if i > 0usize || s == 0usize {
          var m = String.from("'");
          m.append(w.names.text(w.nodes[s].name));
          m.append("' is left out: it uses '");
          m.append(w.names.text(w.nodes[d].name));
          m.append("', which has a mistake");
          problems.push(Problem(w.nodes[s].at, m));
        }
      }
    }
    i = i + 1usize;
  }
  state.set(s, 2u8);
  if *w.alive[s] { w.order.push(s); }
}

fn refsOf(v: &Val, out: &mut List[usize]) {
  match v {
    case let Ref(s) { out.push(*s); }
    case let Tuple(items) { var i = 0usize; while i < items.len() { refsOf(&items[i], out); i = i + 1usize; } }
    case let Range(items) { var i = 0usize; while i < items.len() { refsOf(&items[i], out); i = i + 1usize; } }
    case let Make(m) { var i = 0usize; while i < m.args.len() { refsOf(&m.args[i], out); i = i + 1usize; } }
    case let Items(items) { var i = 0usize; while i < items.len() { refsOf(&items[i], out); i = i + 1usize; } }
    else {}
  }
}

// -------- shown, to check what was understood --------

pub fn showUnderstood(w: &Understood) {
  print <- "  order:";
  var i = 0usize;
  while i < w.order.len() {
    print <- " "; printStr(w.names.text(w.nodes[*w.order[i]].name));
    i = i + 1usize;
  }
  print <- "\n";
  var s = 0usize;
  while s < w.nodes.len() {
    print <- "  ["; print <- s; print <- "] "; printStr(w.names.text(w.nodes[s].name));
    print <- " ("; printStr(kindName(w.nodes[s].kind)); print <- ")";
    if !*w.alive[s] { print <- " LEFT OUT"; }
    if !(w.units[s].make is Absent) { print <- " made by "; showVal(&w.units[s].make); }
    var k = 0usize;
    while k < w.units[s].options.len() {
      print <- " | "; showVal(&w.units[s].options[k]);
      k = k + 1usize;
    }
    if w.units[s].behaviors > 0usize { print <- " | behaviors set aside: "; print <- w.units[s].behaviors; }
    print <- "\n";
    s = s + 1usize;
  }
  i = 0usize;
  while i < w.fields.len() {
    print <- "  field "; printStr(w.names.text(w.fields[i].name)); print <- " of #"; print <- w.fields[i].slot;
    print <- " = "; print <- w.fields[i].init; if w.fields[i].derived { print <- ", derived"; }
    print <- "\n";
    i = i + 1usize;
  }
  i = 0usize;
  while i < w.areas.len() {
    print <- "  area of #"; print <- w.areas[i].slot; print <- ": radius "; print <- w.areas[i].radius;
    print <- " at ("; print <- w.areas[i].cx; print <- ", "; print <- w.areas[i].cy; print <- ", "; print <- w.areas[i].cz; print <- ")";
    if !w.areas[i].live { print <- " LEFT OUT"; }
    print <- "\n";
    i = i + 1usize;
  }
  i = 0usize;
  while i < w.deriveOrder.len() {
    let d = *w.deriveOrder[i];
    print <- "  derive "; print <- d; print <- ": "; showTarget(w, w.derives[d].target); print <- " = "; showCalc(w, &w.derives[d].calc);
    if !w.derives[d].live { print <- " LEFT OUT"; }
    print <- "\n";
    i = i + 1usize;
  }
  i = 0usize;
  while i < w.rules.len() {
    print <- "  on ";
    if w.rules[i].clicked { print <- "clicked #"; print <- w.rules[i].part; } else { print <- "created"; }
    print <- ": keys on "; showTarget(w, Target(w.rules[i].keys.prop, w.rules[i].keys.slot));
    print <- ", "; print <- w.rules[i].keys.times.len(); print <- " keys, last at "; print <- *w.rules[i].keys.times[w.rules[i].keys.times.len() - 1usize];
    print <- " s, loop mode "; print <- w.rules[i].keys.mode;
    if !w.rules[i].live { print <- " LEFT OUT"; }
    print <- "\n";
    i = i + 1usize;
  }
}

fn showTarget(w: &Understood, t: Target) {
  if t.prop == P_FIELD { print <- "field "; printStr(w.names.text(w.fields[t.index].name)); return; }
  print <- "#"; print <- t.index;
  if t.prop == P_ROTATION { print <- ".rotation"; }
  else if t.prop == P_OFFSET { print <- ".offset"; }
  else { print <- ".tint"; }
}

fn showCalc(w: &Understood, c: &Calc) {
  match c {
    case let Num(x) { print <- *x; }
    case let Field(f) { printStr(w.names.text(w.fields[*f].name)); }
    case let Occupied(s) { print <- "occupied(#"; print <- *s; print <- ", by: me)"; }
    case let Choose(parts) {
      print <- "if "; showCalc(w, &parts[0]); print <- " { "; showCalc(w, &parts[1]); print <- " } else { "; showCalc(w, &parts[2]); print <- " }";
    }
  }
}

fn showVal(v: &Val) {
  match v {
    case let Num(x) {
      match json.formatF64(*x) {
        case let Some(t) { printStr(t.view()); }
        case is None { print <- "?"; }
      }
    }
    case let Truth(b) { if *b { print <- "true"; } else { print <- "false"; } }
    case let Ref(s) { print <- "#"; print <- *s; }
    case let Tuple(items) { print <- "("; showVals(items); print <- ")"; }
    case let Range(items) { print <- "["; showVals(items); print <- "]"; }
    case let Make(m) { print <- "make"; print <- u64.from(builderNumber(m.builder)); print <- "("; showVals(&m.args); print <- ")"; }
    case let Items(items) { print <- "["; showVals(items); print <- "]"; }
    case let Local(k) { print <- "step"; print <- *k; }
    case let Call(f) { print <- "fn"; print <- *f; print <- "()"; }
    else { print <- "-"; }
  }
}

fn showVals(items: &List[Val]) {
  var i = 0usize;
  while i < items.len() {
    if i > 0usize { print <- ", "; }
    showVal(&items[i]);
    i = i + 1usize;
  }
}

fn builderNumber(b: Builder) u32 {
  if b == Builder.Box { return 0u32; }
  if b == Builder.Plain { return 1u32; }
  if b == Builder.Srgb { return 2u32; }
  if b == Builder.LinearColor { return 3u32; }
  if b == Builder.Turn { return 4u32; }
  if b == Builder.SunLight { return 5u32; }
  if b == Builder.Physical { return 6u32; }
  if b == Builder.Sphere { return 7u32; }
  8u32
}
