// deskshim.dll (shim\deskshim.c): the laptop's primary screen by DXGI Desktop Duplication, and the real pointer by SendInput.
// Flat C functions only; desk.cone is the panel that uses them.

mod @c("desk_") deskc;

pub extern {
  fn open(output: i32) i32;            // 1 on success; -1 = the primary output
  fn update(timeoutMs: i32) i32;       // 1 a finished picture was waiting (the capture thread makes them, at most 30 a second), else 0; never waits
  fn pixels() *u8;                     // width x height BGRA, the cursor drawn in, then the rest of the mip chain
  fn levels() i32;
  fn width() i32;
  fn height() i32;
  fn origin_x() i32;
  fn origin_y() i32;
  fn cursor_x() i32;
  fn cursor_y() i32;
  fn cursor_visible() i32;
  fn update_us() i32;                  // microseconds the last update took
  fn set_dry_run(on: i32);             // 1: move, button and wheel only print what they would send
  fn move(px: i32, py: i32);           // the real pointer to a pixel of the captured output
  fn button(b: i32, down: i32);        // 0 left, 1 right, 2 middle
  fn wheel(notches: i32);
  fn close();
  fn local_part(k: i32) i32;                    // the local time: year 0, month 1, day 2, hour 3, minute 4
  fn replace_file(from: cstr, to: cstr) i32;    // rename over an existing file in one step; 1 on success
}
