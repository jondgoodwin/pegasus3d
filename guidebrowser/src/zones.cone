// Zones: the two backdrop boards at the back of the incubator (WI\incubator-world.md, "Design thoughts" (b), "The layout of one space",
// "Second wear"). A board is a large panel in a shallow V, Cone on the left and 3D Web on the right, each turned about 25 degrees toward
// the start spot. It is made of FIXED PANES, each pane the live thing itself:
//   site (a web page), repo and Incubator (expandable file trees), diagram (a Mermaid page): ordinary pages (pages.cone) with Pg.zone set,
//   projects (a strip of the domain's projects, a click brings one to the ring) and line (live cards of line.json whose "zone" matches).
// A pane's focus chip flies it to the workbench at reading distance and dims the room; the chip again sends it back.
// incubator.cone does the work; this file holds what the boards are made of.

const ZP_SITE = 0u32;
const ZP_REPO = 1u32;
const ZP_INCUBATOR = 2u32;
const ZP_PROJECTS = 3u32;
const ZP_LINE = 4u32;
const ZP_DIAGRAM = 5u32;
const ZN_PANES = 6usize;
const ZN_DW = 7.2f;               // a board's design width, meters (a zone's width_cm scales it)
const ZN_DH = 3.5f;               // its design height
const ZN_BASE = 0.4f;             // the height of its foot above the floor
const OLD_LINE = false;           // the production line on the left wall (stations and cards): gone, the boards' strips replace it
const FOCUS_D = 1.4f;            // the workbench: a focused pane stands this far ahead of the start spot (reading distance)
const FOCUS_DIM = 0.42f;          // how dark the veil gets

// one live card in a board's line strip: a calm and an amber-framed picture, shown in turns when it needs Jon
struct StripCard {
  id: String;
  report: String;
  hot: bool;
  calm: Label;
  glow: Label;
}

struct Zone {
  id: String;
  name: String;
  pos: Vec3;               // the middle of the board's foot, now
  yaw: f32;
  width: f32;              // meters
  wantPos: Vec3;
  wantYaw: f32;
  wantWidth: f32;
  site: String;
  repo: String;
  incubator: String;
  diagram: String;
  lineKey: String;
  projIds: List[String];
  rects: List[Vec4];       // each pane's rectangle in design meters: x from the board's left edge, y from the floor, width, height
  made: u32;               // bits of the panes opened (1 << pane)
  nextAt: u64;             // when the next pane may be opened
  title: Label;
  back: PagePass;
  projLabels: List[Label];
  projItem: List[i32];
  projOn: List[bool];
  none: Label;
  strip: List[StripCard];
  count: Label;
  stripRect: Vec4;
  planPath: String;        // the plan of the board's Incubator folder (plans.cone), whose skeins are the projects strip's cards
  planStamp: i64;          // its modified time and size when last read
  planSize: i64;
  planNext: u64;           // when it is next looked at
  planLabels: List[Label]; // one card per skein, then "+N more" and the Backlog count
  planFiles: List[String]; // the file a click on each opens
}

fn defaultRect(i: usize) Vec4 {
  // top row: site, repo, incubator, diagram; bottom row: projects, line
  if i == 0usize { Vec4(0.1, 2.05, 2.8, 1.4) }
  else if i == 1usize { Vec4(3.0, 2.05, 1.3, 1.4) }
  else if i == 2usize { Vec4(4.35, 2.05, 1.3, 1.4) }
  else if i == 3usize { Vec4(0.1, 0.45, 4.3, 1.5) }
  else if i == 4usize { Vec4(4.5, 0.45, 2.6, 1.5) }
  else { Vec4(5.7, 2.05, 1.4, 1.4) }
}

// "x,y,w,h" (meters) to a rectangle; false if it does not read
fn parseRect(s: &str, out: &mut Vec4) bool {
  let parts = cfgSplit(s, ',');
  if parts.len() != 4usize { return false; }
  var v0: f32 = 0.; var v1: f32 = 0.; var v2: f32 = 0.; var v3: f32 = 0.;
  if !cfgFloat(parts[0usize].view(), &mut v0) || !cfgFloat(parts[1usize].view(), &mut v1) { return false; }
  if !cfgFloat(parts[2usize].view(), &mut v2) || !cfgFloat(parts[3usize].view(), &mut v3) { return false; }
  if v2 <= 0. || v3 <= 0. { return false; }
  *out = Vec4(v0, v1, v2, v3);
  true
}

// The board's face: a pale panel with a darker frame, 72 x 36 texels
fn makeBoardPass(device: &mut Device, format: u32) PagePass {
  var pass = PagePass.createDepth(device, format);
  let w = 72u32;
  let h = 36u32;
  var px = List[u8].withCapacity(usize.from(w * h * 4u32));
  var y = 0u32;
  while y < h {
    var x = 0u32;
    while x < w {
      let edge = x < 2u32 || y < 2u32 || x >= w - 2u32 || y >= h - 2u32;
      px.push(if edge { 96u8 } else { 214u8 });
      px.push(if edge { 104u8 } else { 217u8 });
      px.push(if edge { 118u8 } else { 224u8 });
      px.push(255u8);
      x = x + 1u32;
    }
    y = y + 1u32;
  }
  pass.uploadRgba(device, w, h, &px);
  pass
}

// A one-texel black veil
fn makeVeilPass(device: &mut Device, format: u32) PagePass {
  var pass = PagePass.create(device, format);
  var px = List[u8].withCapacity(16usize);
  var i = 0;
  while i < 4 { px.push(0u8); px.push(0u8); px.push(0u8); px.push(255u8); i = i + 1; }
  pass.uploadRgba(device, 2u32, 2u32, &px);
  pass
}
