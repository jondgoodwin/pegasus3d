// Mermaid diagrams drawn natively: mermaid.cone reads the text; this lays the result out with diagramlayout (a Graph
// for a flowchart, a SequenceDiagram for a sequence diagram), draws it with vector2d + msdftext into a small
// texture, and keeps the pixels (bottom row first, 3 bytes a pixel, ready to be copied into the document panel's
// page) with a rectangle for each named thing, so a click can point at a node or a message by its key.
//
// Notes in a sequence diagram are drawn here: diagramlayout has none ("Not built: notes"). The layout is run
// without them; each note then pushes the rows below it down and is drawn as a yellow box in the space it made.
//
// The caller (docpanel.cone) makes one Painter and caches the Diagram by its text and width.

const MV_MARGIN = 22.0f;
const MV_MAX_SCALE = 1.6f;
const MV_MAX_H = 1650.0f;
const MV_NOTE_H = 26.0f;
const NONE_IDX = 1000000000usize;

pub struct Painter {
  renderer: VectorRenderer;
  atlas: Atlas;
  font: Font;
}

pub struct Diagram {
  pub text: String;              // the source (the cache key, with 'maxW')
  pub maxW: u32;
  pub w: u32;
  pub h: u32;
  pub pending: bool;             // laid out and sized, its pixels not yet drawn (one diagram a frame: a frame may record 16 command buffers)
  pub canvas: Canvas;            // what is to be drawn, until it is
  pub pixels: List[u8];          // w x h, bottom row first, RGB
  pub keys: List[String];        // what can be pointed at: node keys, "msg N", "note N", participant keys
  pub labels: List[String];
  pub rects: List[f32];          // four a key: x, y (top), w, h in the picture's pixels
  pub kind: u32;                 // MM_...
  pub nodes: usize;              // nodes (or participants)
  pub edges: usize;              // edges (or messages)
  pub notes: usize;
  pub skipped: u32;              // lines the reader could not use
  pub micros: f64;               // time to read, lay out, draw and read back
}

pub fn emptyDiagram(text: &str, maxW: u32) Diagram {
  Diagram(String.from(text), maxW, 0u32, 0u32, false, Canvas.make(1., 1.), List[u8](), List[String](), List[String](), List[f32](), MM_NONE, 0usize, 0usize, 0usize, 0u32, 0.)
}

fn diagramFont() Option[Font] {
  var out: Option[Font] = None;
  match loadFont("C:/Windows/Fonts/arial.ttf") {
    case let Some(f) { out = Some[Font](f); }
    else {
      match Font.load(&DEMO_FONT) {
        case let Ok(f) { out = Some[Font](f); }
        case is Err {}
      }
    }
  }
  out
}

pub fn makePainter(device: &mut Device) Option[Painter] {
  var out: Option[Painter] = None;
  match diagramFont() {
    case let Some(font) {
      var atlas = Atlas.create(AtlasConfig.standard());
      var renderer = VectorRenderer.create(device, &atlas, TEXTURE_FORMAT_RGBA8_UNORM);
      if renderer.isValid() { out = Some[Painter](Painter(renderer, atlas, font)); }
      else { print <- "mermaid: the vector renderer is not valid\n"; }
    }
    else { print <- "mermaid: no font\n"; }
  }
  out
}

// ---- the picture's frame ----

struct Frame {
  s: f32;
  tx: f32;
  ty: f32;
  w: u32;
  h: u32;
}

fn frameFor(x0: f32, y0: f32, x1: f32, y1: f32, maxW: u32) Frame {
  let cw = x1 - x0 + MV_MARGIN * 2.;
  let ch = y1 - y0 + MV_MARGIN * 2.;
  var s = f32.from(maxW) / cw;
  if s > MV_MAX_SCALE { s = MV_MAX_SCALE; }
  if ch * s > MV_MAX_H { s = MV_MAX_H / ch; }
  var w = u32.from(cw * s) + 1u32;
  if w > maxW { w = maxW; }
  let h = u32.from(ch * s) + 1u32;
  Frame(s, (MV_MARGIN - x0) * s, (MV_MARGIN - y0) * s, w, h)
}

fn addKey(d: &mut Diagram, f: &Frame, key: &str, label: &str, x: f32, y: f32, w: f32, h: f32) {
  d.keys.push(String.from(key));
  d.labels.push(String.from(label));
  d.rects.push(x * f.s + f.tx);
  d.rects.push(y * f.s + f.ty);
  d.rects.push(w * f.s);
  d.rects.push(h * f.s);
}

// Draw 'canvas' into a w x h texture and keep its pixels in 'd'
fn readBack(p: &mut Painter, device: &mut Device, d: &mut Diagram) {
  let fw = d.w;
  let fh = d.h;
  let desc = TextureDescriptor(fw, fh, TEXTURE_FORMAT_RGBA8_UNORM, TEXTURE_USAGE_RENDER_ATTACHMENT | TEXTURE_USAGE_COPY_SRC);
  var target = device.createTexture(&desc);
  var readback = device.createBuffer(u64.from(fw * fh * 4u32), BUFFER_USAGE_MAP_READ | BUFFER_USAGE_COPY_DST);
  var encoder = device.createCommandEncoder();
  p.renderer.render(device, &mut encoder, &target, &d.canvas, &p.font, &mut p.atlas, true, Color(1., 1., 1., 1.));
  encoder.copyTextureToBuffer(&target, &readback);
  device.queue.submit(encoder.finish());
  device.waitIdle();
  let src = readback.mappedRange();
  d.pixels = List[u8].withCapacity(usize.from(fw * fh * 3u32));
  var r = 0u32;
  while r < fh {
    // output row r is r rows up from the bottom: texture row h-1-r
    let row = fh - 1u32 - r;
    var x = 0u32;
    while x < fw {
      let at = src + usize.from((row * fw + x) * 4u32);
      d.pixels.push(*at);
      d.pixels.push(*(at + 1usize));
      d.pixels.push(*(at + 2usize));
      x = x + 1u32;
    }
    r = r + 1u32;
  }
}

// ---- flowcharts ----

fn textWidth(p: &mut Painter, s: &str, size: f32) f32 {
  measureText(&p.font, &mut p.atlas, s, size, 0.).x
}

fn nodeSize(p: &mut Painter, mm: &Mermaid, i: usize) Vec2 {
  let tw = textWidth(p, mm.nodes[i].label.view(), 14.);
  let shape = mm.nodes[i].shape;
  if shape == SH_DIAMOND { return Vec2(tw * 1.8 + 30., 58.); }
  if shape == SH_CIRCLE { return Vec2(tw * 1.42 + 36., 50.); }
  if shape == SH_STADIUM { return Vec2(tw + 44., 36.); }
  Vec2(if tw + 28. < 46. { 46. } else { tw + 28. }, 36.)
}

// The shapes drawGraph does not draw (it draws every node as a rounded box): painted over the box
fn drawShapes(c: &mut Canvas, g: &Graph, st: &DiagramStyle) {
  var i = 0usize;
  while i < g.nodes.len() {
    let nd = &g.nodes[i];
    if nd.alive && (nd.kind == SH_STADIUM || nd.kind == SH_DIAMOND || nd.kind == SH_CIRCLE) {
      let fill = st.kindFills[usize.from(nd.kind) % st.kindFills.len()];
      let stroke = st.kindStrokes[usize.from(nd.kind) % st.kindStrokes.len()];
      let l = nd.x - nd.w * 0.5;
      let t = nd.y - nd.h * 0.5;
      c.fillRect(l - 1., t - 1., nd.w + 2., nd.h + 2., st.background);
      if nd.kind == SH_STADIUM {
        c.fillRoundRect(l, t, nd.w, nd.h, nd.h * 0.5, &Paint.solid(fill));
        c.strokeRoundRect(l, t, nd.w, nd.h, nd.h * 0.5, &Paint.solid(stroke), &StrokeStyle.make(1.6));
      }
      else if nd.kind == SH_CIRCLE {
        c.fillEllipse(nd.x, nd.y, nd.w * 0.5, nd.h * 0.5, &Paint.solid(fill));
        c.strokeEllipse(nd.x, nd.y, nd.w * 0.5, nd.h * 0.5, &Paint.solid(stroke), &StrokeStyle.make(1.6));
      }
      else {
        var path = VectorPath.make();
        path.moveTo(nd.x, t);
        path.lineTo(l + nd.w, nd.y);
        path.lineTo(nd.x, t + nd.h);
        path.lineTo(l, nd.y);
        path.close();
        c.fill(&path, &Paint.solid(fill));
        c.stroke(&path, &Paint.solid(stroke), &StrokeStyle.make(1.6));
      }
      c.text(nd.label.view(), nd.x, nd.y, 0.5, 0.5, st.fontSize, st.textColor);
    }
    i = i + 1usize;
  }
}

fn renderFlow(p: &mut Painter, device: &mut Device, mm: &Mermaid, maxW: u32, d: &mut Diagram) {
  var g = Graph.make();
  var i = 0usize;
  while i < mm.nodes.len() {
    let sz = nodeSize(p, mm, i);
    let id = g.addNode(mm.nodes[i].key.view(), mm.nodes[i].label.view(), sz.x, sz.y);
    g.nodes[usize.from(id)].kind = mm.nodes[i].shape;
    i = i + 1usize;
  }
  i = 0usize;
  while i < mm.edges.len() {
    let e = &mm.edges[i];
    let id = g.addEdge(u32.from(e.from), u32.from(e.to));
    if e.label.len() > 0usize { g.edges[usize.from(id)].label = e.label.clone(); }
    i = i + 1usize;
  }
  d.nodes = g.liveNodes();
  d.edges = g.liveEdges();
  var lo = LayeredOptions.make();
  lo.routeEdges = false;
  var routeOpt = RouteOptions.make();
  if mm.horizontal { lo.direction = DIR_LR; routeOpt.flow = FLOW_HORIZONTAL; }
  layoutLayered(&mut g, &lo);
  routeEdges(&mut g, &routeOpt);
  let b = g.bounds();
  let f = frameFor(b.min.x, b.min.y, b.max.x, b.max.y, maxW);
  let st = DiagramStyle.light();
  var canvas = Canvas.make(f32.from(f.w), f32.from(f.h));
  canvas.fillRect(0., 0., f32.from(f.w), f32.from(f.h), st.background);
  canvas.save();
  canvas.translate(f.tx, f.ty);
  canvas.scale(f.s, f.s);
  drawGraph(&mut canvas, &g, &st);
  drawShapes(&mut canvas, &g, &st);
  canvas.restore();
  i = 0usize;
  while i < g.nodes.len() {
    let nd = &g.nodes[i];
    addKey(d, &f, nd.key.view(), nd.label.view(), nd.x - nd.w * 0.5, nd.y - nd.h * 0.5, nd.w, nd.h);
    i = i + 1usize;
  }
  d.w = f.w;
  d.h = f.h;
  d.canvas = canvas;
  d.pending = true;
}

// ---- sequence diagrams ----

fn renderSeq(p: &mut Painter, device: &mut Device, mm: &Mermaid, maxW: u32, d: &mut Diagram) {
  var sd = SequenceDiagram.make();
  var i = 0usize;
  while i < mm.parts.len() {
    let tw = textWidth(p, mm.parts[i].name.view(), 15.);
    sd.addParticipant(mm.parts[i].name.view(), tw + 26., 32.);
    i = i + 1usize;
  }
  i = 0usize;
  while i < mm.msgs.len() {
    let m = &mm.msgs[i];
    let lw = textWidth(p, m.label.view(), 13.5);
    sd.addMessage(u32.from(m.from), u32.from(m.to), m.label.view(), lw, m.kind);
    i = i + 1usize;
  }
  d.nodes = mm.parts.len();
  d.edges = mm.msgs.len();
  d.notes = mm.notes.len();
  if mm.parts.len() == 0usize { return; }
  layoutSequence(&mut sd, &SequenceOptions.make());
  // the notes: make room, then remember where each box goes
  var nx = List[f32]();
  var ny = List[f32]();
  var nw = List[f32]();
  var minX = 0.0f;
  var maxX = sd.width;
  let dy = MV_NOTE_H + 24.;
  i = 0usize;
  while i < mm.notes.len() {
    let nt = &mm.notes[i];
    let tw = textWidth(p, nt.text.view(), 12.5);
    var bw = tw + 22.;
    let y = if nt.before < sd.messages.len() { sd.messages[nt.before].y } else { sd.lifelineBottom - 22. };
    let thr = y - 12.;
    var k = 0usize;
    while k < sd.messages.len() {
      if sd.messages[k].y >= thr { sd.messages[k].y = sd.messages[k].y + dy; }
      k = k + 1usize;
    }
    k = 0usize;
    while k < sd.activations.len() {
      if sd.activations[k].y0 >= thr { sd.activations[k].y0 = sd.activations[k].y0 + dy; }
      if sd.activations[k].y1 >= thr { sd.activations[k].y1 = sd.activations[k].y1 + dy; }
      k = k + 1usize;
    }
    sd.lifelineBottom = sd.lifelineBottom + dy;
    sd.height = sd.height + dy;
    let xa = sd.participants[nt.first].x;
    let xb = sd.participants[nt.last].x;
    var x = 0.0f;
    if nt.side == NOTE_RIGHT { x = xb + 14.; }
    else if nt.side == NOTE_LEFT { x = xa - 14. - bw; }
    else {
      if bw < xb - xa + 28. { bw = xb - xa + 28.; }
      x = (xa + xb) * 0.5 - bw * 0.5;
    }
    nx.push(x);
    ny.push(y - 10.);
    nw.push(bw);
    if x < minX { minX = x; }
    if x + bw > maxX { maxX = x + bw; }
    i = i + 1usize;
  }
  let f = frameFor(minX, 0., maxX, sd.height, maxW);
  let st = DiagramStyle.light();
  var canvas = Canvas.make(f32.from(f.w), f32.from(f.h));
  canvas.fillRect(0., 0., f32.from(f.w), f32.from(f.h), st.background);
  canvas.save();
  canvas.translate(f.tx, f.ty);
  canvas.scale(f.s, f.s);
  drawSequence(&mut canvas, &sd, &st);
  i = 0usize;
  while i < mm.notes.len() {
    canvas.fillRoundRect(*nx[i], *ny[i], *nw[i], MV_NOTE_H, 4., &Paint.solid(Color(1., 0.96, 0.66, 1.)));
    canvas.strokeRoundRect(*nx[i], *ny[i], *nw[i], MV_NOTE_H, 4., &Paint.solid(Color(0.80, 0.62, 0.15, 1.)), &StrokeStyle.make(1.2));
    canvas.text(mm.notes[i].text.view(), *nx[i] + *nw[i] * 0.5, *ny[i] + MV_NOTE_H * 0.5, 0.5, 0.5, 12.5, Color(0.25, 0.18, 0.02, 1.));
    i = i + 1usize;
  }
  canvas.restore();
  // what can be pointed at: messages, notes, then the participants (heads and lifelines)
  i = 0usize;
  while i < sd.messages.len() {
    let m = &sd.messages[i];
    let xa = sd.participants[usize.from(m.from)].x;
    let xb = sd.participants[usize.from(m.to)].x;
    let lo = if xa < xb { xa } else { xb };
    let hi = if xa < xb { xb } else { xa };
    var key = String.from("msg ");
    key.append(numberText(i + 1usize).view());
    addKey(d, &f, key.view(), m.label.view(), lo - 4., m.y - 18., (hi - lo) + (if xa == xb { 80. } else { 8. }), 30.);
    i = i + 1usize;
  }
  i = 0usize;
  while i < mm.notes.len() {
    var key = String.from("note ");
    key.append(numberText(i + 1usize).view());
    addKey(d, &f, key.view(), mm.notes[i].text.view(), *nx[i], *ny[i], *nw[i], MV_NOTE_H);
    i = i + 1usize;
  }
  i = 0usize;
  while i < sd.participants.len() {
    let q = &sd.participants[i];
    addKey(d, &f, mm.parts[i].key.view(), q.name.view(), q.x - q.w * 0.5, sd.lifelineTop - q.h, q.w, sd.lifelineBottom + q.h - (sd.lifelineTop - q.h));
    i = i + 1usize;
  }
  d.w = f.w;
  d.h = f.h;
  d.canvas = canvas;
  d.pending = true;
}

// ---- the entry point ----

// Read, lay out, draw and read back a diagram of 'src', at most 'maxW' pixels wide
pub fn renderMermaid(p: &mut Painter, device: &mut Device, src: &str, maxW: u32) Diagram {
  let began = sdl.GetPerformanceCounter();
  var d = emptyDiagram(src, maxW);
  let mm = parseMermaid(src);
  d.kind = mm.kind;
  d.skipped = mm.skipped;
  if mm.kind == MM_FLOW && mm.nodes.len() > 0usize { renderFlow(p, device, &mm, maxW, &mut d); }
  else if mm.kind == MM_SEQ { renderSeq(p, device, &mm, maxW, &mut d); }
  d.micros = micros(began, sdl.GetPerformanceCounter());
  d
}

// The diagram for 'src' from the cache (drawn and added if new): its index, or 1000000000 if there is no painter
pub fn diagramFor(painter: &mut Option[Painter], device: &mut Device, cache: &mut List[Diagram], src: &str, maxW: u32) usize {
  var i = 0usize;
  while i < cache.len() {
    if cache[i].maxW == maxW && cache[i].text.view() == src { return i; }
    i = i + 1usize;
  }
  var made = emptyDiagram(src, maxW);
  var ok = false;
  match painter {
    case let Some(p) {
      made = renderMermaid(p, device, src, maxW);
      ok = true;
      print <- "mermaid: "; print <- (if made.kind == MM_FLOW { "flowchart" } else if made.kind == MM_SEQ { "sequence diagram" } else { "unknown" });
      print <- ", "; print <- made.nodes; print <- " nodes, "; print <- made.edges; print <- " edges, "; print <- made.notes; print <- " notes, ";
      print <- made.skipped; print <- " lines skipped; "; print <- made.w; print <- "x"; print <- made.h; print <- " px in ";
      print <- made.micros / 1000.; print <- " ms\n";
    }
    else {}
  }
  if !ok { return 1000000000usize; }
  cache.push(made);
  cache.len() - 1usize
}

// Draw the pixels of the first diagram in the cache that has none yet: one a call, because a frame may record only 16
// command buffers (and the page's own redraw and the scene take most of them). True if one was drawn.
pub fn paintOne(painter: &mut Option[Painter], device: &mut Device, cache: &mut List[Diagram]) bool {
  var i = 0usize;
  while i < cache.len() {
    if cache[i].pending {
      match painter {
        case let Some(p) {
          let began = sdl.GetPerformanceCounter();
          readBack(p, device, &mut cache[i]);
          cache[i].pending = false;
          cache[i].canvas = Canvas.make(1., 1.);
          cache[i].micros = cache[i].micros + micros(began, sdl.GetPerformanceCounter());
          print <- "mermaid: diagram "; print <- i; print <- " drawn ("; print <- cache[i].w; print <- "x"; print <- cache[i].h; print <- ")\n";
        }
        else {}
      }
      return true;
    }
    i = i + 1usize;
  }
  false
}
