// The World: an actor that owns a world's changing values and runs its tick
// on the actors package's workers, while the loop draws.
//
// What it is started with, the Program, is built by the loader from what was
// understood (build.cone): every part's place in its parent, the fields and
// their defaults, the areas, the derives in the order they are worked out,
// and the event rules with their animators already built (tweenstack's Anim,
// plain data, so it crosses like a mesh does). The derives and the rules are
// code of the intermediate form (conescript's lowerSim), which the World
// verifies when it starts and runs through the interpreter (simhost.cone): a
// derive's unit gives its value; a rule's unit says what it does through
// staged writes, which the World applies when the unit returns.
//
// The loop sends one message a step: the step's number, and what came in for
// it (a part clicked, where the visitor's eye is). Nothing from outside
// writes a value in the middle of a step. Each step, in this order:
//
//   take in      the first step is 'created': its rules start; a click
//                starts the rules of the part clicked
//   before       the animators move what they own (tweenstack's registry)
//   physics      none yet ('solid' is set aside)
//   after        every part's place in the world, parent first; who is
//                inside each area; the derives, each after what it reads
//   publish      what changed, as a Published copy, to the loop
//
// Every value here has this one owner. The loop never reads them, only what
// is published, so nothing is shared and nothing is locked.

// A part's place in its parent, as written
pub struct SlotFrame {
  pub parent: u32;
  pub name: String;
  pub at: Vec3;
  pub rotation: Quat;          // its 'rotation:' option, or none
  pub drawn: bool;             // a shape: its state is published
}

pub struct FieldRt {
  pub slot: u32;
  pub name: String;
  pub value: f64;              // its default (a truth as 1 or 0)
  pub truth: bool;
}

pub struct AreaRt {
  pub slot: u32;
  pub center: Vec3;            // in the part's own frame
  pub radius: f32;
}

pub struct DeriveRt {
  pub prop: u32;               // P_FIELD or P_TINT
  pub index: u32;              // the field's number, or the part's slot
  pub number: u32;             // the derive's number in the checked world: its unit's entry
}

pub struct RuleRt {
  pub clicked: bool;           // on(clicked(part), ...); else on(created, ...)
  pub part: u32;
  pub anim: Anim;
  pub what: String;            // what it moves, to say so
}

// A pick-and-place rule: set(field, part | None) and
// start(transition(field.offset, to:, over:)), as its unit says
pub struct MoveRt {
  pub part: u32;               // clicked: it, or any part inside it
  pub number: u32;             // the rule's number in the checked world: its unit's entry (ENTRY_MOVE_FLAG | number)
}

pub struct Program {
  pub frames: List[SlotFrame]; // by slot
  pub fields: List[FieldRt];
  pub areas: List[AreaRt];
  pub derives: List[DeriveRt]; // in the order they are worked out
  pub rules: List[RuleRt];     // the live rules in order: a rule's unit says host.start_anim with its place here
  pub moves: List[MoveRt];
  pub middles: List[Vec3];     // by slot: the middle of the part's shape in its own frame (where a glide to it ends)
  pub code: Code;              // the derives' and rules' units (conescript's lowerSim)
}

// No part clicked this step
pub const NO_CLICK = 0xFFFFFFFFu32;

actor WorldActor {
  out: Sender[Published];
  program: Program;
  animators: Animators;
  started: bool;
  first: u64;                  // the step the world was created in
  sim: Option[SimHost];        // the derives' and rules' units and the values they read (None: the code was refused)
  deriveUnits: List[u32];      // by derive in the program: its unit (NO_UNIT: none)
  ruleUnits: List[u32];        // by rule in the program
  moveUnits: List[u32];        // by pick-and-place rule in the program
  positions: List[Vec3];       // by slot: in the world, at the end of this step
  rotations: List[Quat];
  tints: List[f32];
  sent: List[bool];            // by slot: published at least once
  sentPositions: List[Vec3];   // by slot: as published last
  sentRotations: List[Quat];
  sentTints: List[f32];

  fn init(self: &new, out: Sender[Published], program: Program) {
    var sim = None[SimHost];
    var deriveUnits = List[u32]();
    var ruleUnits = List[u32]();
    var moveUnits = List[u32]();
    var i = 0usize;
    match SimHost.make(&program.code, program.fields.len(), program.frames.len()) {
      case let Ok(host) {
        var h = host;
        i = 0usize;
        while i < h.refusals().len() {
          print <- "world: a behavior unit was refused and left out: "; printStr(h.refusals()[i].what.view()); print <- "\n";
          i = i + 1usize;
        }
        i = 0usize;
        while i < program.fields.len() { h.setValue(i, program.fields[i].value); i = i + 1usize; }
        i = 0usize;
        while i < program.derives.len() { deriveUnits.push(unitOrNone(h.unitFor(ENTRY_DERIVE, program.derives[i].number, 0u32))); i = i + 1usize; }
        i = 0usize;
        while i < program.rules.len() { ruleUnits.push(unitOrNone(h.unitFor(ENTRY_HANDLER, u32.from(i), 0u32))); i = i + 1usize; }
        i = 0usize;
        while i < program.moves.len() {
          moveUnits.push(unitOrNone(h.unitFor(ENTRY_HANDLER, ENTRY_MOVE_FLAG | program.moves[i].number, 0u32)));
          i = i + 1usize;
        }
        sim = Some[SimHost](h);
      }
      case let Err(problems) {
        // code that does not verify never runs: this world's derives and rules are left out
        i = 0usize;
        while i < problems.len() {
          print <- "world: the world's behavior code was refused: "; printStr(problems[i].what.view()); print <- "\n";
          i = i + 1usize;
        }
      }
    }
    var positions = List[Vec3]();
    var rotations = List[Quat]();
    var tints = List[f32]();
    var sent = List[bool]();
    var sentPositions = List[Vec3]();
    var sentRotations = List[Quat]();
    var sentTints = List[f32]();
    i = 0usize;
    while i < program.frames.len() {
      positions.push(Vec3(0., 0., 0.)); rotations.push(Quat.identity()); tints.push(1.);
      sent.push(false); sentPositions.push(Vec3(0., 0., 0.)); sentRotations.push(Quat.identity()); sentTints.push(1.);
      i = i + 1usize;
    }
    *self = Self(out: out, program: program, animators: Animators.make(), started: false, first: 0u64, sim: sim,
      deriveUnits: deriveUnits, ruleUnits: ruleUnits, moveUnits: moveUnits, positions: positions, rotations: rotations, tints: tints, sent: sent,
      sentPositions: sentPositions, sentRotations: sentRotations, sentTints: sentTints);
  }

  // One step of the world's clock: step 'index' of 'stepNs' nanoseconds,
  // with what came in for it
  pub async fn step(self, index: u64, stepNs: u64, clicked: u32, eye: Vec3) {
    // Take in
    if !started {
      started = true;
      first = index;
      var r = 0usize;
      while r < program.rules.len() {
        if !program.rules[r].clicked { self.runHandler(*ruleUnits[r], index, NO_CLICK); }
        r = r + 1usize;
      }
    }
    let now = f64.from(index - first) * f64.from(stepNs) / 1.0e9f64;
    if clicked != NO_CLICK {
      var any = false;
      // Pick and place, in the order written: the part clicked or one holding it
      var m = 0usize;
      while m < program.moves.len() {
        if self.within(clicked, program.moves[m].part) {
          any = true;
          self.runHandler(*moveUnits[m], index, clicked);
        }
        m = m + 1usize;
      }
      var r = 0usize;
      while r < program.rules.len() {
        if program.rules[r].clicked && self.within(clicked, program.rules[r].part) {
          self.runHandler(*ruleUnits[r], index, clicked);
          any = true;
        }
        r = r + 1usize;
      }
      if !any {
        print <- "world: step "; print <- index; print <- ", "; printStr(program.frames[usize.from(clicked)].name.view());
        print <- " clicked: no rule for it\n";
      }
    }

    // Before physics: the animators move what they own
    animators.tick(now);

    // After physics: places, parent first (a parent's slot is always lower)
    var s = 0usize;
    while s < program.frames.len() {
      let f = &program.frames[s];
      let turn = animators.valueQuat(u32.from(s), P_ROTATION, f.rotation);
      let shift = f.at + animators.valueVec3(u32.from(s), P_OFFSET, Vec3(0., 0., 0.));
      if s == 0usize {
        positions.set(s, shift);
        rotations.set(s, turn);
      } else {
        let p = usize.from(f.parent);
        let parentTurn = *rotations[p];
        positions.set(s, *positions[p] + parentTurn * shift);
        rotations.set(s, parentTurn * turn);
      }
      s = s + 1usize;
    }
    // Who is inside each area: a part is occupied if the visitor is inside any of its areas
    var a = 0usize;
    while a < program.areas.len() {
      self.setInside(usize.from(program.areas[a].slot), false);
      a = a + 1usize;
    }
    a = 0usize;
    while a < program.areas.len() {
      let area = program.areas[a];
      let k = usize.from(area.slot);
      let middle = *positions[k] + *rotations[k] * area.center;
      if (eye - middle).length() <= area.radius { self.setInside(k, true); }
      a = a + 1usize;
    }
    // The derives, in their order
    var d = 0usize;
    while d < program.derives.len() {
      var v = 0.;
      var got = false;
      let unit = *deriveUnits[d];
      if unit != NO_UNIT {
        match &mut sim {
          case var &mut Some(h) {
            match h.derive(unit) {
              case let Ok(x) { v = x; got = true; }
              case let Err(why) {
                print <- "world: step "; print <- index; print <- ", a derive was stopped: "; printStr(why.view()); print <- "\n";
              }
            }
          }
          else {}
        }
      }
      if !got { d = d + 1usize; continue; }
      let i = usize.from(program.derives[d].index);
      if program.derives[d].prop == P_FIELD {
        if v != self.valueOf(i) {
          self.setValue(i, v);
          let field = &program.fields[i];
          print <- "world: step "; print <- index; print <- " ("; print <- now; print <- " s), ";
          printStr(program.frames[usize.from(field.slot)].name.view()); print <- "."; printStr(field.name.view());
          print <- " is now ";
          if field.truth { print <- (if v != 0. { "true" } else { "false" }); } else { print <- v; }
          print <- "\n";
        }
      }
      else if program.derives[d].prop == P_TINT { tints.set(i, f32.from(v)); }
      d = d + 1usize;
    }

    // Publish what changed
    var changed = List[PartState]();
    s = 0usize;
    while s < program.frames.len() {
      if program.frames[s].drawn {
        let pos = *positions[s];
        let rot = *rotations[s];
        let tint = *tints[s];
        let was = *sentRotations[s];
        let had = *sentPositions[s];
        if !*sent[s] || pos.x != had.x || pos.y != had.y || pos.z != had.z
          || rot.x != was.x || rot.y != was.y || rot.z != was.z || rot.w != was.w || tint != *sentTints[s] {
          changed.push(PartState(u32.from(s), pos, rot, tint));
          sent.set(s, true);
          sentPositions.set(s, pos);
          sentRotations.set(s, rot);
          sentTints.set(s, tint);
        }
      }
      s = s + 1usize;
    }
    if changed.len() > 0usize { out.send(Published(index + 1u64, changed)); }
  }

  // Is the part at slot 'part' the part 'holder', or inside it?
  fn within(self: &, part: u32, holder: u32) bool {
    var s = part;
    while true {
      if s == holder { return true; }
      if s == 0u32 { return false; }
      s = program.frames[usize.from(s)].parent;
    }
    false
  }

  fn valueOf(self: &, i: usize) f64 {
    match &sim {
      case let Some(h) { h.value(i) }
      else { 0. }
    }
  }

  fn setValue(self: &mut, i: usize, v: f64) {
    match &mut sim { case var &mut Some(h) { h.setValue(i, v); } else {} }
  }

  fn setInside(self: &mut, slot: usize, inside: bool) {
    match &mut sim { case var &mut Some(h) { h.setInside(slot, inside); } else {} }
  }

  // Runs a rule's unit (none: nothing) as the click on 'clicked' or the creation of the world (NO_CLICK) at step 'index',
  // and applies what it staged, in order, once it has returned; a unit that traps is dropped whole, writes and all
  fn runHandler(self: &mut, unit: u32, index: u64, clicked: u32) {
    if unit == NO_UNIT { return; }
    var writes = List[StagedWrite]();
    var stopped = None[String];
    match &mut sim {
      case var &mut Some(h) { stopped = h.handle(unit, &mut writes); }
      else {}
    }
    match &stopped {
      case let Some(why) {
        print <- "world: step "; print <- index; print <- ", a rule was stopped and its changes dropped: "; printStr(why.view());
        print <- "\n";
        return;
      }
      else {}
    }
    var k = 0usize;
    while k < writes.len() {
      let w = &writes[k];
      if w.kind == WRITE_SET {
        let f = usize.from(w.a);
        let v = f64.fromBits(w.b);
        self.setValue(f, v);
        print <- "world: step "; print <- index; print <- ", ";
        printStr(program.fields[f].name.view()); print <- " is now ";
        if v < 0. { print <- "None"; } else { printStr(program.frames[usize.from(i64.from(v))].name.view()); }
        print <- "\n";
      }
      else if w.kind == WRITE_ANIM {
        let r = usize.from(w.a);
        animators.start(&program.rules[r].anim);
        print <- "world: step "; print <- index; print <- ", ";
        if clicked == NO_CLICK { print <- "created: "; }
        else { printStr(program.frames[usize.from(clicked)].name.view()); print <- " clicked: "; }
        printStr(program.rules[r].what.view()); print <- " started\n";
      }
      else if self.valueOf(usize.from(w.a)) >= 0. {
        // a glide: the part the field holds stands over the middle of the part 'to', level
        let piece = usize.from(i64.from(self.valueOf(usize.from(w.a))));
        let to = usize.from(w.b);
        let here = *positions[piece];
        let there = *positions[to] + *rotations[to] * program.middles[to];
        let parent = usize.from(program.frames[piece].parent);
        // the change in the piece's own parent's frame, level: it keeps its height
        let shift = rotations[parent].conjugate() * Vec3(there.x - here.x, 0., there.z - here.z);
        let now = animators.valueVec3(u32.from(piece), P_OFFSET, Vec3(0., 0., 0.));
        animators.start(&Anim.transition(u32.from(piece), P_OFFSET, AnimValue.ofVec3(now + shift), f32.from(f64.fromBits(w.c))));
        print <- "world: step "; print <- index; print <- ", "; printStr(program.frames[piece].name.view());
        print <- " glides to "; printStr(program.frames[to].name.view()); print <- "\n";
      }
      k = k + 1usize;
    }
  }
}

// An entry's unit, or NO_UNIT
fn unitOrNone(u: Option[u32]) u32 {
  match u {
    case let Some(x) { x }
    else { NO_UNIT }
  }
}
