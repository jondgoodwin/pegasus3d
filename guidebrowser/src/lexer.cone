// The lexer: a ConeScript text cut into tokens, each with its line and
// column, handed to the parser one at a time as it asks ('next'), as Cone's
// own lexer does; no list of tokens is made.
//
// Indentation gives nesting: a line indented deeper than the one before it
// opens a level (an Indent token), and a line indented less closes levels
// (Dedent tokens) back to one it matches. A line ends with a Newline token,
// except where it plainly goes on: inside '( )', '[ ]' or '{ }', or after a
// line that ends in ','. A continued line's indentation means nothing. The one
// '{' that does not join lines ends a line starting 'each': its body is parts,
// indented as parts are, and its '}' stands on a line of its own. '//' starts a comment to
// the end of the line; a blank or comment-only line is passed over.
//
// Every name is interned: the Names table holds each name's text once, and a
// token carries the name's number. A number's value is read as it is lexed.
// So a token is plain data and lexing allocates nothing but new names.
//
// A mistake (a tab in the indentation, a dedent to no outer level, a '(' never
// closed) is reported and the lexer goes on, so one pass finds them all. A
// byte that is no token becomes a Bad token, so the line it is in fails where
// it stands.

pub enum TokKind {
  Name;        // a name: 'part', 'box', 'materials', 'deg', 'true'
  Number;      // digits, with a fraction if written: '80000', '0.96'
  Symbol;      // '(' ')' '[' ']' '{' '}' ',' ':' ';' '.' '-' '=' '+' '*' '/' '%' '<' '>' '!',
               // or 'R' for '..=', 'L' for '..<', 'E' '==', 'N' '!=', 'l' '<=', 'g' '>=', 'A' '&&', 'O' '||'
  Newline;
  Indent;
  Dedent;
  End;
  Bad;         // a byte that is no token
}

// Where something was written: the line from 1, the column from 1, in bytes
pub struct Spot {
  pub line: u32;
  pub column: u32;
}

pub struct Token {
  pub kind: TokKind;
  pub at: Spot;
  pub name: u32;       // a Name's number in the Names table
  pub value: f64;      // a Number's value
  pub sym: u8;         // a Symbol's byte ('R' for '..='); a Bad token's byte;
                       // 'c' on a Newline the lexer cut short at a new part
}

fn token(kind: TokKind, at: Spot) Token { Token(kind, at, 0u32, 0., 0u8) }

// A mistake in the text, where it was found
pub struct Problem {
  pub at: Spot;
  pub message: String;
}

pub fn problem(at: Spot, message: &str) Problem { Problem(at, String.from(message)) }

// -------- names --------

// The names every world may use, numbered in the order 'Names.standard' puts
