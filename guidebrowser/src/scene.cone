// The scene: the parts that are live, drawn every frame, and what crosses to
// the loop to make them live and to move them.
//
// A part is BUILT off the loop, by the loader on the actors package's workers:
// its mesh made, its look decided, its place known. Nothing built touches the
// GPU. It crosses to the loop as an Arrival over a channel, and the loop's
// ACTIVATION SLICE makes it live between frames: its mesh and material go to
// the GPU, and it joins the scene, drawn from the next frame on. So building
// never makes a frame wait, and a part pops into existence whole.
//
// The slice takes what is waiting, up to a budget a frame; what is left
// waits for the next frame. Uploading a mesh is the slice's one real cost
// today, so the budget counts parts.
//
// What a world DOES arrives last, as its Program (world.cone): the loop starts
// a World actor with it, which owns the world's changing values and runs its
// tick on the workers. Each step the World PUBLISHES what changed, as
// Published: a copy that no longer changes, which the loop draws from.

// A part built and ready to be made live
pub struct Built {
  pub slot: u32;               // its number in the world
  pub name: String;
  pub mesh: Mesh;
  pub low: Vec3;               // its box, in its own frame: what a click is tested against
  pub high: Vec3;
  pub look: Look;
  pub place: Mat4;             // where it stands as built
}

// How a part's surface answers light
pub struct Look {
  pub color: Color;            // linear
  pub physical: bool;          // physical(...): by roughness and metal; else plain(...)
  pub roughness: f32;
  pub metal: f32;
  pub covers: f32;             // how much of what is behind it is hidden: 1 opaque, below 1 see-through
  pub coat: f32;               // a clear coat's strength, 0 none (physical only)
  pub coatRoughness: f32;
  pub reflects: f32;           // how much of the scene it mirrors, 0 the sky alone (physical only)
}

// What the loader sends the loop
pub enum Arrival {
  // A part built, to activate
  pub struct Part {
    pub built: Built;
  }
  // The world's sun, in physical units (its color is lux on a surface facing it)
  pub struct Sun {
    pub light: Light;
    pub shadows: bool;
    pub toSun: Vec3;           // the way to the sun, unit length
    pub lux: f32;              // the light it gives a surface facing it
  }
  // A point or spot light, in the world
  pub struct Lamp {
    pub lamp: LampInfo;
  }
  // Where the visitor stands, the eye's place, and which way they face; and how
  // the picture is taken: a lens's focal length in meters (0: the browser's own),
  // its aperture (an f-number; 0: everything in focus), the distance it focuses
  // at, and the stops the exposure is opened by
  pub struct Stand {
    pub eye: Vec3;
    pub facing: Vec3;
    pub lens: f32;
    pub aperture: f32;
    pub focus: f32;
    pub exposure: f32;
  }
  // What the world does: the loop starts its World actor with it
  pub struct Behaviors {
    pub program: Program;
  }
  // Every part of a world has been sent: the world is whole once the slice has
  // made them all live
  pub struct Whole {
    pub world: String;
    pub parts: u64;
  }
}

// A point or spot light, in the world
pub struct LampInfo {
  pub position: Vec3;
  pub aim: Vec3;               // a spot light's axis, unit length
  pub color: Color;            // linear
  pub candela: f32;
  pub reach: f32;              // meters
  pub source: f32;             // the radius of the glowing source, meters
  pub cone: f32;               // a spot light's: where it ends, radians from the axis
  pub softEdge: f32;           // how far inside the cone it begins to fade
  pub spot: bool;
  pub shadows: bool;
}

// A live part: its slot, what draws it, and its box
pub struct Live {
  pub slot: u32;
  pub name: String;
  pub mesh: MeshHandle;
  pub material: MaterialHandle;
  pub low: Vec3;
  pub high: Vec3;
  pub place: Mat4;             // where it was drawn last: what a click is tested against
}

pub struct Scene {
  pub parts: List[Live];

  pub fn empty() Scene { Scene(List[Live].empty()) }
}

// One part's state at the end of a step, as the World publishes it
pub struct PartState {
  pub slot: u32;
  pub position: Vec3;          // in the world
  pub rotation: Quat;
  pub tint: f32;               // a gray, multiplying its color
}

// What changed in one step, published by the World: it never changes after
pub struct Published {
  pub boundary: u64;           // the step's index + 1: the moment its state holds at, in steps
  pub parts: List[PartState];
}

// Parts the activation slice makes live in one frame, at most
pub const ACTIVATE_BUDGET = 64u64;
