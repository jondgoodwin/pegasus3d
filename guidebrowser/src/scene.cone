// The scene: the parts that are live, drawn every frame, and what the loader
// hands the loop to make live.
//
// A part is BUILT off the loop, by the loader on the actors package's workers:
// its mesh made, its look decided, its place known. Nothing built touches the
// GPU. It crosses to the loop as an Arrival over a channel, and the loop's
// ACTIVATION SLICE makes it live between frames: its mesh and material go to
// the GPU, and it joins the scene, drawn from the next frame on. So building
// never makes a frame wait, and a part pops into existence whole.
//
// The slice takes what is waiting, up to a budget a frame; what is left
// waits for the next frame. Uploading a mesh is the slice's one real cost
// today, so the budget counts parts.

// A part built and ready to be made live
pub struct Built {
  pub name: String;
  pub mesh: Mesh;
  pub color: Color;            // a plain material for now
  pub place: Mat4;
}

// What the loader sends the loop
pub enum Arrival {
  // A part built, to activate
  pub struct Part {
    pub built: Built;
  }
  // The world's sun, in physical units (its color is lux on a surface facing it)
  pub struct Sun {
    pub light: Light;
    pub shadows: bool;
  }
  // Where the visitor stands, the eye's place, and which way they face
  pub struct Stand {
    pub eye: Vec3;
    pub facing: Vec3;
  }
  // Every part of a world has been sent: the world is whole once the slice has
  // made them all live
  pub struct Whole {
    pub world: String;
    pub parts: u64;
  }
}

// A live part: its name, and what draws it
pub struct Live {
  pub name: String;
  pub mesh: MeshHandle;
  pub material: MaterialHandle;
  pub place: Mat4;
}

pub struct Scene {
  pub parts: List[Live];

  pub fn empty() Scene { Scene(List[Live].empty()) }
}

// Parts the activation slice makes live in one frame, at most
pub const ACTIVATE_BUDGET = 64u64;
