// Building: an understood world's parts made, in its order, each sent to the
// loop the moment it is made. The parts' values are not walked here: the world
// is lowered to code of the intermediate form (conescript's lower), verified,
// and each part is made by running its units through the interpreter
// (partbuild's PartBuilder), which gives plain products; this file maps them to
// what the loop is sent.
//
//   a material      its look, kept by slot for the shapes that name it
//   a shape         its mesh, its look, its place: an Arrival.Part
//   a light         the sun, in physical units: an Arrival.Sun
//   an arrival      the first one is where the visitor stands: an Arrival.Stand
//   a group         only its place, which the parts inside it start from
//
// A part's place is its parent's place, then its own 'at:' and 'rotation:'.
//
// A part whose tools refuse (a shim says why) is left out, with one line, and
// the rest of the world is built.
//
// Then what the world does, as the Program its World actor is started with
// (world.cone): each part's place in its parent, the fields, the areas, the
// derives in their order, and each rule's animator built as tweenstack's Anim.

// How high a visitor's eyes are above where they stand, in meters (mine:
// a standing adult, until a world says what body arrives)
pub const EYE_HEIGHT = 1.6;

// The sky's even light on everything, in nits, while a world has no sky
// (page 1 has none: the guide leaves what is behind everything open). Mine:
// a clear sky is several thousand nits.
pub const SKY_NITS = 4000.;

// The row the build knows by its place in the vocabulary (the first eight rows are fixed: partbuild/vocab.list)
const TOOL_BOX = 0u32;

// Every part of the world built and sent (built and dropped, unless send:
// to time building alone); how many parts were
pub fn build(w: &Understood, ready: &Sender[Arrival], send: bool) u64 {
  buildWith(toolImports(&w.vocab, &w.names), w, ready, send)
}

// The same with the imports given (a check swaps one for a shim that refuses)
pub fn buildWith(tables: ImportTables[ToolValue], w: &Understood, ready: &Sender[Arrival], send: bool) u64 {
  match PartBuilder.make(w, tables) {
    case let Ok(b) { buildParts(b, w, ready, send) }
    case let Err(problems) {
      // code that does not verify never runs: the world's parts are left out
      var i = 0usize;
      while i < problems.len() {
        print <- "build: the world's code was refused: "; printStr(problems[i].what.view()); print <- " (unit "; print <- problems[i].unit;
        print <- ", offset "; print <- problems[i].offset; print <- ")\n";
        i = i + 1usize;
      }
      0u64
    }
  }
}

fn buildParts(builder: PartBuilder, w: &Understood, ready: &Sender[Arrival], send: bool) u64 {
  var bld = builder;
  var looks = List[Look]();     // by slot: a material's look
  var places = List[Mat4]();    // by slot: where the part's own origin is, in the world
  var frames = List[SlotFrame]();
  var s = 0usize;
  while s < w.nodes.len() {
    looks.push(greyLook());
    places.push(Mat4.identity());
    var at = Vec3(0., 0., 0.);
    var turn = Quat.identity();
    let kind = w.nodes[s].kind;
    if kind == Kind.Group || kind == Kind.Shape || kind == Kind.Light {
      let own = bld.placeOf(s, kind);
      at = own.at;
      turn = own.turn;
    }
    frames.push(SlotFrame(u32.from(w.nodes[s].parent), String.from(w.names.text(w.nodes[s].name)), at, turn,
      kind == Kind.Shape && *w.alive[s]));
    s = s + 1usize;
  }
  var standing = false;
  var parts = 0u64;
  var i = 0usize;
  while i < w.order.len() {
    let slot = *w.order[i];
    let kind = w.nodes[slot].kind;
    let parent = w.nodes[slot].parent;
    if kind == Kind.Arrival && standing { i = i + 1usize; continue; }
    var p = bld.buildPart(slot, kind);
    if kind == Kind.Group || kind == Kind.Shape || kind == Kind.Light {
      places.set(slot, *places[parent] * p.placement);
    }
    var k = 0usize;
    while k < p.notes.len() { leftOut(w, slot, p.notes[k].view()); k = k + 1usize; }
    if kind == Kind.Material {
      looks.set(slot, lookOf(&p.material));
    }
    else if kind == Kind.Shape {
      if p.made {
        var mesh = Mesh();
        mesh <-> p.mesh;
        let a = Arrival.Part(Built(u32.from(slot), String.from(w.names.text(w.nodes[slot].name)), mesh, p.low, p.high,
          lookOf(&p.material), *places[slot]));
        if send { ready.send(a); }
        parts = parts + 1u64;
      }
    }
    else if kind == Kind.Light {
      if p.made {
        if p.light.kind == LIGHT_SUN {
          if send { ready.send(sunOf(&p.light.sun)); }
        }
        else if send { ready.send(lampOf(&p.light.lamp, *places[slot])); }
      }
    }
    else if kind == Kind.Arrival {
      let base = *places[parent];
      let feet = base * p.at;
      let facing = base.transformVector(p.facing);
      var height = f32.from(EYE_HEIGHT);
      if p.hasEye { height = p.eye; }
      var lens: f32 = 0.;
      var aperture: f32 = 0.;
      var focus: f32 = 2.;
      var exposure: f32 = 0.;
      if p.hasCamera {
        lens = p.camera.lens; aperture = p.camera.aperture; focus = p.camera.focus; exposure = p.camera.exposure;
      }
      let a = Arrival.Stand(feet + Vec3(0., height, 0.), facing, lens, aperture, focus, exposure);
      if send { ready.send(a); }
      standing = true;
    }
    i = i + 1usize;
  }
  if send && (w.rules.len() > 0usize || w.derives.len() > 0usize || w.areas.len() > 0usize || w.moves.len() > 0usize) {
    ready.send(Arrival.Behaviors(program(&mut bld, w, frames)));
  }
  parts
}

// A part whose tools refused: left out, and why
fn leftOut(w: &Understood, slot: usize, why: &str) {
  print <- "build: '"; printStr(w.names.text(w.nodes[slot].name)); print <- "' left out: "; printStr(why); print <- "\n";
}

fn greyLook() Look {
  Look(Color(0.5, 0.5, 0.5, 1.), false, 1., 0., 1., 0., 0.05, 0.)
}

// A material's look
fn lookOf(m: &MaterialRec) Look {
  Look(m.color, m.physical, m.roughness, m.metal, m.covers, m.coat, m.coatRoughness, m.reflects)
}


// What the world does, for its World actor
fn program(bld: &mut PartBuilder, w: &Understood, frames: List[SlotFrame]) Program {
  var fields = List[FieldRt]();
  var i = 0usize;
  while i < w.fields.len() {
    let f = w.fields[i];
    fields.push(FieldRt(u32.from(f.slot), String.from(w.names.text(f.name)), f.init, f.ty == Ty.Truth));
    i = i + 1usize;
  }
  var areas = List[AreaRt]();
  i = 0usize;
  while i < w.areas.len() {
    let a = w.areas[i];
    if a.live { areas.push(AreaRt(u32.from(a.slot), Vec3(f32.from(a.cx), f32.from(a.cy), f32.from(a.cz)), f32.from(a.radius))); }
    i = i + 1usize;
  }
  var derives = List[DeriveRt]();
  i = 0usize;
  while i < w.deriveOrder.len() {
    let d = &w.derives[*w.deriveOrder[i]];
    if d.live { derives.push(DeriveRt(d.target.prop, u32.from(d.target.index), u32.from(*w.deriveOrder[i]))); }
    i = i + 1usize;
  }
  var rules = List[RuleRt]();
  i = 0usize;
  while i < w.rules.len() {
    let r = &w.rules[i];
    if r.live {
      var what = String.from("keys on ");
      what.append(w.names.text(w.nodes[r.keys.slot].name));
      what.append(if r.keys.prop == P_ROTATION { ".rotation" } else { ".offset" });
      rules.push(RuleRt(r.clicked, u32.from(r.part), animOf(bld, i, &r.keys), what));
    }
    i = i + 1usize;
  }
  var moves = List[MoveRt]();
  i = 0usize;
  while i < w.moves.len() {
    let m = &w.moves[i];
    if *w.alive[m.part] { moves.push(MoveRt(u32.from(m.part), u32.from(i))); }
    i = i + 1usize;
  }
  var middles = List[Vec3]();
  i = 0usize;
  while i < w.nodes.len() { middles.push(middleOf(w, i)); i = i + 1usize; }
  Program(frames, fields, areas, derives, rules, moves, middles, lowerSim(w))
}

// Where a part's shape has its middle, in its own frame: a box's, from its
// ranges; the part's origin for any other
fn middleOf(w: &Understood, slot: usize) Vec3 {
  match &w.units[slot].make {
    case let Make(m) {
      if m.tool == TOOL_BOX {
        var mid = Array[f32, 3]() <- fill 0.;
        var k = 0usize;
        while k < 3usize {
          match &m.args[k] {
            case let Range(ends) { mid[k] = f32.from((numOf(&ends[0]) + numOf(&ends[1])) / 2.); }
            else {}
          }
          k = k + 1usize;
        }
        return Vec3(mid[0], mid[1], mid[2]);
      }
    }
    else {}
  }
  Vec3(0., 0., 0.)
}

// keys(...) as tweenstack's animator: one track of its keys, linear between
// them, in a clip that loops as it says
fn animOf(bld: &mut PartBuilder, rule: usize, k: &KeysInfo) Anim {
  var track = Track.make(if k.prop == P_ROTATION { TK_QUAT } else { TK_VEC3 });
  var i = 0usize;
  while i < k.times.len() {
    let t = f32.from(*k.times[i]);
    if k.prop == P_ROTATION { track.addQuat(t, bld.keyTurn(rule, i), INTERP_LINEAR); }
    else { track.addVec3(t, bld.keyOffset(rule, i), INTERP_LINEAR); }
    i = i + 1usize;
  }
  var clip = Clip.make("", k.mode);
  clip.addTrack(u32.from(k.slot), k.prop, track);
  Anim.keys(&clip)
}


// -------- lights --------

// sunLight(direction:, color:, lux:, castsShadow:): 'direction' points to the
// sun, so its light travels the other way; its color times its lux is the
// light on a surface facing it
fn sunOf(sun: &SunRec) Arrival {
  let way = sun.toSun.normalize();
  let c = sun.color;
  let lux = sun.lux;
  let sky = f32.from(SKY_NITS);
  let light = Light.directional(Vec3(0., 0., 0.) - sun.toSun, Color(c.red * lux, c.green * lux, c.blue * lux, 1.),
    Color(0.80 * sky, 0.88 * sky, 1.0 * sky, 1.));
  Arrival.Sun(light, sun.shadows, way, lux)
}

// spotLight(reach, color:, intensity:, source:, castsShadow:, aim:, cone:,
// softEdge:) or pointLight(reach, color:, intensity:, source:, castsShadow:),
// placed where its part is: its aim turned as its part is
fn lampOf(l: &LampRec, place: Mat4) Arrival {
  var lamp = LampInfo(place * Vec3(0., 0., 0.), Vec3(0., -1., 0.), l.color, l.candela, l.reach, l.source, 0., 0., false,
    l.shadows);
  if l.spot {
    lamp.spot = true;
    lamp.aim = place.transformVector(l.aim).normalize();
    lamp.cone = l.cone;
    lamp.softEdge = l.softEdge;
  }
  Arrival.Lamp(lamp)
}
