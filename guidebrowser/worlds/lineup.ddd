part lineup                                             // the six Staunton designs in a row, in the studio's light
  part materials
    part paper: physical(color: srgb(170, 214, 222), roughness: 1)          // robin's-egg backdrop paper
    part slate: [physical(color: srgb(38, 40, 44), roughness: 0.08), reflective(amount: 0.8)]      // polished slate
    part boxwood: [physical(color: srgb(238, 212, 168), roughness: 0.5), clearCoat(amount: 1, roughness: 0.05)]

  part backdrop                                         // a seamless sweep: the paper runs under and up behind
    fn sweep() shape {
      let curve = [(1.5, 3), (1.5, 0.9), (1.469, 0.667), (1.379, 0.45), (1.236, 0.264),
                   (1.05, 0.121), (0.833, 0.031), (0.6, 0), (-4, 0)];
      loftAlong(profiles: [curve, curve], spine: spine.line(from: (-3, 0, 0), to: (3, 0, 0)), caps: false)
    }
    part paper: sweep(), material: materials.paper
  part slab: box(x: -1.45 ..= 1.45, y: 0 ..= 0.03, z: -0.45 ..= 0.4), material: materials.slate

  part pieces, at: (0, 0.03, 0)
    fn pawn() shape {                                   // 49 cm: a turned foot and column, a collar, a ball
      lathe(profile: [(0, 0), (0.135, 0), (0.135, 0.016), (0.128, 0.024), (0.125, 0.032), (0.130, 0.040),
                      (0.130, 0.047), (0.120, 0.055), (0.102, 0.062), (0.094, 0.072), (0.082, 0.095),
                      (0.068, 0.150), (0.058, 0.230), (0.054, 0.268), (0.078, 0.282), (0.084, 0.292),
                      (0.078, 0.300), (0.056, 0.308), (0.044, 0.322),
                      (0.060, 0.336), (0.076, 0.361), (0.085, 0.384), (0.088, 0.405), (0.085, 0.428),
                      (0.076, 0.449), (0.062, 0.467), (0.044, 0.481), (0.023, 0.490), (0, 0.493)],
            steps: 96)
    }
    fn rook() shape {                                   // 57 cm
      let body  = lathe(profile: [(0, 0), (0.150, 0), (0.150, 0.018), (0.143, 0.026), (0.140, 0.034),
                                  (0.146, 0.042), (0.146, 0.050), (0.138, 0.058), (0.120, 0.064),
                                  (0.112, 0.074), (0.098, 0.092), (0.090, 0.115), (0.086, 0.160),
                                  (0.080, 0.330), (0.084, 0.370), (0.096, 0.392), (0.112, 0.400),
                                  (0.112, 0.412), (0.104, 0.420), (0.110, 0.428), (0.122, 0.440),
                                  (0.122, 0.560), (0.116, 0.568), (0.092, 0.568), (0.092, 0.545),
                                  (0, 0.545)],
                        steps: 96);
      let slots = union(box(x: -0.2 ..= 0.2, y: 0.515 ..= 0.6, z: -0.03 ..= 0.03),
                        box(x: -0.03 ..= 0.03, y: 0.515 ..= 0.6, z: -0.2 ..= 0.2));
      difference(body, slots)                           // four battlements
    }
    fn bishop() shape {                                 // 78 cm: an egg-shaped mitre with its slanted cut, a bead on top
      let body = lathe(profile: [(0, 0), (0.160, 0), (0.160, 0.018), (0.152, 0.027), (0.149, 0.036),
                                 (0.155, 0.045), (0.155, 0.053), (0.144, 0.062), (0.122, 0.070), (0.112, 0.082),
                                 (0.098, 0.105), (0.082, 0.170), (0.068, 0.300), (0.062, 0.400),
                                 (0.066, 0.430), (0.096, 0.446), (0.100, 0.458), (0.090, 0.468),
                                 (0.098, 0.476), (0.102, 0.486), (0.090, 0.494), (0.062, 0.500),
                                 (0.070, 0.518), (0.082, 0.545), (0.088, 0.575), (0.087, 0.605),
                                 (0.080, 0.635), (0.068, 0.665), (0.052, 0.695), (0.034, 0.718),
                                 (0.020, 0.732), (0.018, 0.738), (0.028, 0.748), (0.030, 0.760),
                                 (0.022, 0.772), (0.010, 0.778), (0, 0.780)],
                       steps: 96);
      let cut  = turn(box(x: -0.15 ..= 0.15, y: -0.013 ..= 0.013, z: 0.012 ..= 0.15), by: -45 deg,
                      about: (1, 0, 0), origin: (0, 0, 0));
      difference(body, move(cut, by: (0, 0.615, 0)))    // a slot cut down into the mitre's front
    }
    fn queen() shape {                                  // 85 cm: a flared cup, its rim cut into a coronet, a bead
      let body    = lathe(profile: [(0, 0), (0.180, 0), (0.180, 0.020), (0.171, 0.030), (0.168, 0.040),
                                    (0.174, 0.050), (0.174, 0.059), (0.162, 0.069), (0.138, 0.078),
                                    (0.126, 0.090), (0.110, 0.116), (0.090, 0.190), (0.074, 0.340),
                                    (0.066, 0.470), (0.070, 0.505), (0.104, 0.522), (0.108, 0.536),
                                    (0.096, 0.546), (0.104, 0.556), (0.108, 0.568), (0.090, 0.576),
                                    (0.068, 0.584), (0.074, 0.620), (0.090, 0.670), (0.112, 0.720),
                                    (0.124, 0.752), (0.112, 0.756), (0.070, 0.760), (0.064, 0.775),
                                    (0.058, 0.790), (0.034, 0.798), (0.028, 0.806), (0.036, 0.816),
                                    (0.038, 0.830), (0.030, 0.843), (0.014, 0.850), (0, 0.852)],
                          steps: 96);
      // a square stood on its corner and pushed out through the rim: its lower half cuts a V
      let notch   = move(turn(box(x: -0.02 ..= 0.02, y: -0.02 ..= 0.02, z: 0.08 ..= 0.16), by: 45 deg,
                              about: (0, 0, 1)), by: (0, 0.765, 0));
      difference(body, arrayRadial(notch, count: 10))   // ten points round the crown
    }
    fn king() shape {                                   // 95 cm: a cup, a domed cap, a cross
      let body  = lathe(profile: [(0, 0), (0.190, 0), (0.190, 0.021), (0.181, 0.032), (0.178, 0.042),
                                  (0.184, 0.053), (0.184, 0.062), (0.171, 0.073), (0.146, 0.083),
                                  (0.133, 0.096), (0.116, 0.124), (0.096, 0.200), (0.080, 0.360),
                                  (0.072, 0.520), (0.076, 0.560), (0.110, 0.578), (0.114, 0.592),
                                  (0.102, 0.603), (0.110, 0.614), (0.114, 0.626), (0.096, 0.635),
                                  (0.072, 0.644), (0.078, 0.680), (0.094, 0.730), (0.112, 0.775),
                                  (0.116, 0.790), (0.100, 0.795), (0.096, 0.805), (0.084, 0.822),
                                  (0.062, 0.834), (0.034, 0.841), (0, 0.843)],
                        steps: 96);
      let cross = union(box(x: -0.019 ..= 0.019, y: 0.830 ..= 0.955, z: -0.013 ..= 0.013),
                        box(x: -0.055 ..= 0.055, y: 0.880 ..= 0.912, z: -0.013 ..= 0.013));
      union(body, cross)
    }
    fn knight() shape {                                 // a knight, 61 cm tall, measured from a boxwood Staunton
      let base    = lathe(profile: [(0, 0), (0.085, 0), (0.096, 0.009), (0.114, 0.014), (0.127, 0.019),
                                    (0.137, 0.024), (0.143, 0.029), (0.146, 0.034), (0.150, 0.044),
                                    (0.148, 0.054), (0.143, 0.060), (0.134, 0.065), (0.135, 0.070),
                                    (0.140, 0.080), (0.141, 0.090), (0.138, 0.105), (0.131, 0.116),
                                    (0.119, 0.126), (0.108, 0.136), (0.100, 0.146), (0.094, 0.156),
                                    (0.102, 0.167), (0.105, 0.177), (0.100, 0.182), (0, 0.182)],
                          steps: 96);
      // The carver's pattern: the side seen from the right, the horse facing -x
      let pattern = [(0.130, 0.173), (0.041, 0.173), (-0.044, 0.173), (-0.086, 0.173), (-0.091, 0.187),
                     (-0.100, 0.202), (-0.109, 0.218), (-0.117, 0.233), (-0.124, 0.248), (-0.127, 0.263),
                     (-0.125, 0.279), (-0.113, 0.294), (-0.102, 0.309), (-0.096, 0.325), (-0.086, 0.340),
                     (-0.074, 0.355), (-0.061, 0.371), (-0.047, 0.386), (-0.034, 0.401), (-0.020, 0.416),
                     (-0.012, 0.427), (-0.107, 0.432), (-0.119, 0.437), (-0.142, 0.442), (-0.139, 0.452),
                     (-0.155, 0.457), (-0.158, 0.462), (-0.158, 0.473), (-0.157, 0.488), (-0.154, 0.503),
                     (-0.151, 0.513), (-0.142, 0.524), (-0.122, 0.534), (-0.096, 0.544), (-0.074, 0.554),
                     (-0.049, 0.564), (-0.026, 0.575), (-0.006, 0.585), (0.017, 0.595), (0.037, 0.605),
                     (0.058, 0.608), (0.080, 0.605), (0.106, 0.595), (0.138, 0.585), (0.137, 0.575),
                     (0.136, 0.564), (0.148, 0.544), (0.158, 0.524), (0.165, 0.503), (0.166, 0.483),
                     (0.168, 0.462), (0.168, 0.442), (0.165, 0.422), (0.167, 0.401), (0.167, 0.381),
                     (0.162, 0.360), (0.155, 0.340), (0.147, 0.320), (0.136, 0.299), (0.132, 0.279),
                     (0.131, 0.269), (0.134, 0.253), (0.139, 0.238), (0.146, 0.223), (0.151, 0.207),
                     (0.148, 0.197), (0.136, 0.187)];
      let side    = outline.points(pattern);
      // Blown up round: each part fuller than round in section, 0.42 as wide as it is tall in the pattern,
      // then made fine enough to carve
      let blank   = subdivide(inflate(side, thickness: 0.42, fullness: 2, cell: 4 mm), levels: 1);
      // Places on the side view, measured from the same photograph
      let eye     = (-0.030, 0.535);
      let nostril = (-0.138, 0.500);
      let jowl    = (0.005, 0.482);
      let head    = carve(blank, mirror: front, strokes: [
        brush.flatten(along: [(-0.135, 0.488), (-0.085, 0.505), (-0.040, 0.520)], radius: 24 mm, strength: 1),
        brush.crease(along: [(-0.045, 0.556), (-0.090, 0.538), (-0.135, 0.522)],
                     radius: 6 mm, strength: 0.4, ends: 0.3),                       // the bridge of the nose's edge
        brush.draw(along: [(-0.022, 0.512), (-0.052, 0.494), (-0.082, 0.481)],
                   radius: 7 mm, strength: 0.8, ends: 0.35),                        // the facial crest
        brush.draw(along: [(-0.105, 0.300), (-0.080, 0.330), (-0.040, 0.350), (0.010, 0.345)],
                   radius: 26 mm, strength: 0.5, ends: 0.3),                        // the neck's muscle
        brush.draw(along: [(-0.110, 0.225), (-0.105, 0.265), (-0.085, 0.290)],
                   radius: 22 mm, strength: 0.5, ends: 0.3),                        // the chest
        brush.crease(along: [(-0.070, 0.405), (-0.088, 0.340), (-0.100, 0.265)],
                     radius: 7 mm, strength: 0.5, ends: 0.3),                       // the throat's groove
        brush.inflate(at: jowl, radius: 32 mm, strength: 0.1),                       // the round jowl
        brush.crease(along: [(-0.075, 0.446), (-0.020, 0.440), (0.030, 0.452), (0.048, 0.495)],
                     radius: 5 mm, strength: 0.8, ends: 0.25),                      // its edge, the jaw
        brush.clay(along: [(-0.056, 0.551), (-0.032, 0.559), (-0.008, 0.551)],
                   radius: 8 mm, strength: 0.9, ends: 0.3),                         // the brow
        brush.draw(at: eye, radius: 16 mm, strength: -0.2),                         // the socket, 3 mm deep
        brush.inflate(at: eye, radius: 9 mm, strength: 0.35),                       // the eye in it
        brush.crease(along: [(-0.048, 0.538), (-0.030, 0.548), (-0.012, 0.540)],
                     radius: 4.5 mm, strength: 1, ends: 0.25),                      // its upper lid
        brush.crease(along: [(-0.048, 0.531), (-0.030, 0.523), (-0.012, 0.531)],
                     radius: 4 mm, strength: 0.8, ends: 0.25),                      // and lower: an almond
        brush.draw(at: nostril, radius: 10 mm, strength: -0.3),                     // the nostril
        brush.clay(along: [(-0.150, 0.512), (-0.130, 0.516), (-0.122, 0.500)],
                   radius: 5 mm, strength: 0.5, ends: 0.3),                         // its flare
        brush.crease(along: [(-0.157, 0.452), (-0.135, 0.456), (-0.110, 0.463)],
                     radius: 4 mm, strength: 0.9, ends: 0.2),                       // the mouth
        brush.crease(along: [(0.070, 0.580), (0.098, 0.500), (0.112, 0.420), (0.118, 0.330), (0.110, 0.230)],
                     radius: 6 mm, strength: 0.8, ends: 0.15)                       // where the mane starts
      ]);
      let mane    = carve(head, mirror: front, strokes: [                         // its combed strands
        brush.crease(along: [(0.086, 0.560), (0.126, 0.535)], radius: 4.5 mm, strength: 1, ends: 0.3),
        brush.crease(along: [(0.094, 0.528), (0.140, 0.500)], radius: 4.5 mm, strength: 1, ends: 0.3),
        brush.crease(along: [(0.100, 0.496), (0.150, 0.466)], radius: 4.5 mm, strength: 1, ends: 0.3),
        brush.crease(along: [(0.105, 0.464), (0.155, 0.434)], radius: 4.5 mm, strength: 1, ends: 0.3),
        brush.crease(along: [(0.109, 0.432), (0.158, 0.402)], radius: 4.5 mm, strength: 1, ends: 0.3),
        brush.crease(along: [(0.113, 0.400), (0.158, 0.370)], radius: 4.5 mm, strength: 1, ends: 0.3),
        brush.crease(along: [(0.116, 0.368), (0.154, 0.338)], radius: 4.5 mm, strength: 1, ends: 0.3),
        brush.crease(along: [(0.118, 0.336), (0.146, 0.306)], radius: 4.5 mm, strength: 1, ends: 0.3),
        brush.crease(along: [(0.117, 0.304), (0.138, 0.274)], radius: 4.5 mm, strength: 1, ends: 0.3),
        brush.crease(along: [(0.115, 0.272), (0.136, 0.242)], radius: 4.5 mm, strength: 1, ends: 0.3)
      ]);
      // An ear: a leaf blown up thin, its hollow facing forward and out, pricked a little forward
      let leaf    = inflate(outline.points([(0, 0), (0.024, 0.006), (0.030, 0.030), (0.024, 0.056), (0.012, 0.074),
                                            (0, 0.088), (-0.009, 0.072), (-0.018, 0.050), (-0.022, 0.026),
                                            (-0.018, 0.006)]),
                            thickness: 0.5, fullness: 1.5, cell: 1.5 mm);
      let cupped  = carve(subdivide(leaf, levels: 1), strokes: [                 // hollowed on the side it faces
        brush.draw(along: [(0.002, 0.012), (0.003, 0.040), (0.001, 0.066)], onto: front, radius: 9 mm,
                   strength: -0.8, ends: 0.2)
      ]);
      let ear     = move(turn(turn(cupped, by: -35 deg, about: up), by: 15 deg, about: front), by: (0.045, 0.575, 0.030));
      join([base, mane, mirror(ear, normal: front)])
    }
    part pawn:   pawn(),   material: materials.boxwood, at: (-1.15, 0, 0)
    part rook:   rook(),   material: materials.boxwood, at: (-0.69, 0, 0)
    part knight: knight(), material: materials.boxwood, at: (-0.23, 0, 0)
    part bishop: bishop(), material: materials.boxwood, at: (0.23, 0, 0)
    part queen:  queen(),  material: materials.boxwood, at: (0.69, 0, 0)
    part king:   king(),   material: materials.boxwood, at: (1.15, 0, 0)

  part key: sunLight(direction: (-0.55, 0.7, 0.55), color: color(1, 0.93, 0.84), lux: 50000 lux,
                castsShadow: true)                      // the key, high on the left
  part rimLeft: spotLight(5 m, color: color(1, 0.97, 0.92), intensity: 200000 candela, source: 0.25 m,
                          aim: (1.1, -0.55, 1.2), cone: 0.5 rad, softEdge: 0.2 rad), at: (-1.6, 0.9, -1.2)
  part rimRight: spotLight(5 m, color: color(1, 0.97, 0.92), intensity: 200000 candela, source: 0.25 m,
                           aim: (-1.1, -0.55, 1.2), cone: 0.5 rad, softEdge: 0.2 rad), at: (1.6, 0.9, -1.2)
  part glow: spotLight(5 m, color: color(0.95, 1, 1), intensity: 40000 candela, source: 0.3 m,      // on the paper
                      aim: (0, 0.45, -1), cone: 0.9 rad, softEdge: 0.6 rad), at: (0, 0.15, -0.7)

  part arrivals
    part start, at: (0, 0, 4.6), facing: (0, -0.06, -1), eye: 0.75 m,
                camera: camera(lens: 50 mm, exposure: 1.3)
