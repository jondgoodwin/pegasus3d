                                 (0.080, 0.635), (0.068, 0.665), (0.052, 0.695), (0.034, 0.718),
                                 (0.020, 0.732), (0.018, 0.738), (0.028, 0.748), (0.030, 0.760),
                                 (0.022, 0.772), (0.010, 0.778), (0, 0.780)],
                       steps: 96);
      let cut  = turn(box(x: -0.15 ..= 0.15, y: -0.013 ..= 0.013, z: 0.012 ..= 0.15), by: -45 deg,
                      about: (1, 0, 0), origin: (0, 0, 0));
      difference(body, move(cut, by: (0, 0.615, 0)))    // a slot cut down into the mitre's front
    }
    fn queen() shape {                                  // 85 cm: a flared cup, its rim cut into a coronet, a bead
      let body    = lathe(profile: [(0, 0), (0.180, 0), (0.180, 0.020), (0.171, 0.030), (0.168, 0.040),
                                    (0.174, 0.050), (0.174, 0.059), (0.162, 0.069), (0.138, 0.078),
                                    (0.126, 0.090), (0.110, 0.116), (0.090, 0.190), (0.074, 0.340),
                                    (0.066, 0.470), (0.070, 0.505), (0.104, 0.522), (0.108, 0.536),
                                    (0.096, 0.546), (0.104, 0.556), (0.108, 0.568), (0.090, 0.576),
