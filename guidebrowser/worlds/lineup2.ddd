part lineup2                                            // the six Staunton designs in a row, in the studio's light
  part materials
    part paper: physical(color: srgb(170, 214, 222), roughness: 1)          // robin's-egg backdrop paper
    part slate: [physical(color: srgb(38, 40, 44), roughness: 0.08), reflective(amount: 0.8)]      // polished slate
    part boxwood: [physical(color: srgb(238, 212, 168), roughness: 0.5), clearCoat(amount: 1, roughness: 0.05)]

  part backdrop                                         // a seamless sweep: the paper runs under and up behind
    fn sweep() shape {
      let curve = [(1.5, 3), (1.5, 0.9), (1.469, 0.667), (1.379, 0.45), (1.236, 0.264),
                   (1.05, 0.121), (0.833, 0.031), (0.6, 0), (-4, 0)];
      loftAlong(profiles: [curve, curve], spine: spine.line(from: (-3, 0, 0), to: (3, 0, 0)), caps: false)
    }
    part paper: sweep(), material: materials.paper
  part slab: box(x: -1.45 ..= 1.45, y: 0 ..= 0.03, z: -0.45 ..= 0.4), material: materials.slate

  part pieces, at: (0, 0.03, 0)
    fn pawn() shape {                                   // 49 cm: a turned foot and column, a collar, a ball
      lathe(profile: [(0, 0), (0.135, 0), (0.135, 0.016), (0.128, 0.024), (0.125, 0.032), (0.130, 0.040),
                      (0.130, 0.047), (0.120, 0.055), (0.102, 0.062), (0.094, 0.072), (0.082, 0.095),
                      (0.068, 0.150), (0.058, 0.230), (0.054, 0.268), (0.078, 0.282), (0.084, 0.292),
                      (0.078, 0.300), (0.056, 0.308), (0.044, 0.322),
                      (0.060, 0.336), (0.076, 0.361), (0.085, 0.384), (0.088, 0.405), (0.085, 0.428),
                      (0.076, 0.449), (0.062, 0.467), (0.044, 0.481), (0.023, 0.490), (0, 0.493)],
            steps: 96)
    }
    fn rook() shape {                                   // 57 cm
      let body  = lathe(profile: [(0, 0), (0.150, 0), (0.150, 0.018), (0.143, 0.026), (0.140, 0.034),
                                  (0.146, 0.042), (0.146, 0.050), (0.138, 0.058), (0.120, 0.064),
                                  (0.112, 0.074), (0.098, 0.092), (0.090, 0.115), (0.086, 0.160),
                                  (0.080, 0.330), (0.084, 0.370), (0.096, 0.392), (0.112, 0.400),
                                  (0.112, 0.412), (0.104, 0.420), (0.110, 0.428), (0.122, 0.440),
                                  (0.122, 0.560), (0.116, 0.568), (0.092, 0.568), (0.092, 0.545),
                                  (0, 0.545)],
                        steps: 96);
      let slots = union(box(x: -0.2 ..= 0.2, y: 0.515 ..= 0.6, z: -0.03 ..= 0.03),
                        box(x: -0.03 ..= 0.03, y: 0.515 ..= 0.6, z: -0.2 ..= 0.2));
      difference(body, slots)                           // four battlements
    }
    fn bishop() shape {                                 // 78 cm: an egg-shaped mitre with its slanted cut, a bead on top
      let body = lathe(profile: [(0, 0), (0.160, 0), (0.160, 0.018), (0.152, 0.027), (0.149, 0.036),
                                 (0.155, 0.045), (0.155, 0.053), (0.144, 0.062), (0.122, 0.070), (0.112, 0.082),
                                 (0.098, 0.105), (0.082, 0.170), (0.068, 0.300), (0.062, 0.400),
                                 (0.066, 0.430), (0.096, 0.446), (0.100, 0.458), (0.090, 0.468),
                                 (0.098, 0.476), (0.102, 0.486), (0.090, 0.494), (0.062, 0.500),
