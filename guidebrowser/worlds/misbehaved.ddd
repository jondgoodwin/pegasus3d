part misbehaved                                         // mistakes in behaviors: each loses only itself
  part materials
    part stone: plain(srgb(140, 140, 135))
  part block: box(x: -0.3 ..= 0.3, y: 0.4 ..= 1, z: -0.3 ..= 0.3), material: materials.stone
    field near: bool = false, lives: client
    field glow: number = 1, mutable: true
    derive(near, occupied(self, by: me))                // no area: occupied watches nothing
    derive(glow, 2)                                     // a mutable field derived
    derive(tint, if near { 1.4 } else { true })         // the two values differ
    derive(tint, 2)                                     // a second writer
    wobble(self)                                        // not a behavior
  part arrivals
    part start, at: (0, 0, 3), facing: (0, 0, -1)
  on(created, start(keys(block.tint, [key(sim(0 s), 1)])))
  on(clicked(nothing), start(keys(block.offset, [key(sim(0 s), (0, 0, 0))])))
  on(created, start(keys(block.rotation, [key(sim(2 s), rotation(0 deg)), key(sim(1 s), rotation(9 deg))])))
  on(created, start(keys(block.rotation, [key(4 s, rotation(0 deg))], loop: forever)))
