part docroom                                            // a room for the document panel (--doc FILE.md)
  part materials
    part stone: plain(srgb(120, 120, 116))              // a matte gray
  part floor: box(x: -6 ..= 6, y: -0.1 ..= 0, z: -6 ..= 6), material: materials.stone, at: (0, 0, 0)
    solid(self, derived)
  part sun: sunLight(direction: (0.15, 0.25, 1), color: color(1, 0.96, 0.9), lux: 80000 lux,
                castsShadow: false)
  part arrivals
    part start, at: (0, 0, 2.0), facing: (0, 0, -1), eye: 1.48 m,    // where you stand, facing the page (eye a little above its middle, so all of it shows)
                camera: camera(lens: 24 mm)
