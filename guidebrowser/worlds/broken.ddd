// Mistakes, one per part, to check that each loses only its own part
part broken
  part good1: box(x: -1 ..= 1, y: 0 ..= 1, z: -1 ..= 1)
  part noColon: box(x: 1 ..= 2 y: 0 ..= 1)
    part lostChild, at: (0, 0, 0)
  part badOption, at (0, 0, 0)
  part stray: plain(srgb(1, 2, 3)) extra
  part good2, at: (1, 2, 3)
    solid(self derived)
    solid(self, derived)
   part misindented
  part weird: plain(#ff0000)
  part unclosed: box(x: (1, 2
  part good3

  part trailing: box(x: 0 ..= 1),
  part good4: box(x: 0 ..= 1,
                  y: 0 ..= 1),
              at: (0, 0, 0)
  part good5
