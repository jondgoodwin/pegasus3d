part hello                                              // the world
  part materials
    part steel: physical(color: srgb(170, 172, 176), roughness: 0.35, metal: 1)   // new
    part stone: plain(srgb(140, 140, 135))
  part floor: box(x: -5 ..= 5, y: -0.1 ..= 0, z: -5 ..= 5), material: materials.stone, at: (0, 0, 0)
    solid(self, derived)
  part block: box(x: -0.3 ..= 0.3, y: 0.4 ..= 1, z: -0.3 ..= 0.3), material: materials.steel,
              at: (0, 0, 0)
    field near: bool = false, lives: client             // new: is this visitor close?
    area(self, sphere(radius: 2 m, at: (0, 0.7, 0)))     // new: the space round the block
    derive(near, occupied(self, by: me))                // new
    derive(tint, if near { 1.4 } else { 1 })            // new: brighter while you are near
  part sun: sunLight(direction: (0.4, 1, 0.3), color: color(1, 0.96, 0.9), lux: 80000 lux,
                castsShadow: true)
  part arrivals
    part start, at: (0, 0, 3), facing: (0, 0, -1)

  on(created, start(keys(block.rotation,               // new: one full turn every 12 seconds
      [key(sim(0 s), rotation(0 deg)),   key(sim(4 s), rotation(120 deg)),
       key(sim(8 s), rotation(240 deg)), key(sim(12 s), rotation(360 deg))],
      loop: loop, ease: linear)))
  on(clicked(block), start(keys(block.offset,           // new: a click makes it hop
      [key(sim(0 s), (0, 0, 0)), key(sim(0.3 s), (0, 30 cm, 0)), key(sim(0.6 s), (0, 0, 0))])))
