// Mistakes the checker finds, one per part
part unchecked
  part materials
    part red: plain(srgb(200, 30, 30))
    part bad: plain(srgb(200, 30))
  part a: box(x: 0 ..= 1, y: 0 ..= 1, z: 0 ..= 1), material: materials.red, at: (0, 0, 0)
  part b: box(x: 0 ..= 1, y: 0 ..= 1, z: 0 ..= 1), material: materials.blue
  part c: box(x: 0 ..= 1, y: 0 ..= 1, z: 0 ..= 1), material: a
  part d: box(x: 0 ..= 1, y: 0 ..= 1, z: 0 ..= 1), material: materials.bad
  part e: box(x: 1 ..= 0, y: 0 ..= 1, z: 0 ..= 1), material: materials.red
  part f: box(x: 0 ..= 1 lux, y: 0 ..= 1, z: 0 ..= 1), material: materials.red
  part g: box(x: 0 ..= 1, y: 0 ..= 1, z: 0 ..= 1), material: materials.red, rotation: rotation(30 m)
  part h: sunLight(direction: (0, 1, 0), color: color(1, 1, 1), lux: 80000)
  part i: box(x: 0 ..= 1, y: 0 ..= 1, z: 0 ..= 1), material: materials.red, colour: srgb(1, 2, 3)
  part j: sphere(radius: 1 m)
  part k: box(x: 0 ..= 1, y: 0 ..= 1, z: 0 ..= 1, w: 2), material: materials.red
  part l: box(x: 0 ..= 1, y: 0 ..= 1, z: 0 ..= 1), material: unchecked.materials.red, rotation: rotation(45 °)
  part m: box(x: 0 ..= 1, y: 0 ..= 1, z: 0 ..= 1), material: materials.red, at: (0, 0)
  part a
  part arrivals
    part start, at: (0, 0, 3)
