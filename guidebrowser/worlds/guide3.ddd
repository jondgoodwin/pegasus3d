part hello                                              // the world
  part materials
    part steel: physical(color: srgb(60, 62, 66), roughness: 0.4, metal: 1)     // new: blackened steel
    part amber: [plain(srgb(255, 205, 130)), translucent(covers: 0.5)]          // new: amber glass
    part stone: plain(srgb(140, 140, 135))
  part floor: box(x: -5 ..= 5, y: -0.1 ..= 0, z: -5 ..= 5), material: materials.stone, at: (0, 0, 0)
    solid(self, derived)
  part lantern, at: (0, 0, 0)                          // new: the block has become a lantern
    fn frame() shape {                                  // the post, plinth, corners and roof, as one shape
      let post   = lathe(profile: [(0, 0), (0.05, 0), (0.05, 0.03), (0.025, 0.08),
                                   (0.025, 0.9), (0, 0.9)]);
      let plinth = box(x: -0.15 ..= 0.15, y: 0.9 ..= 0.94, z: -0.15 ..= 0.15);
      let corner = box(x: 0.11 ..= 0.13, y: 0.94 ..= 1.2, z: 0.11 ..= 0.13);
      let roof   = loftAlong(profiles: [outline.rectangle(width: 0.34, height: 0.34),
                                        outline.rectangle(width: 0.06, height: 0.06)],
                             spine: spine.line(from: (0, 1.2, 0), to: (0, 1.36, 0)));
      join([post, plinth, arrayRadial(corner, count: 4), roof])
    }
    part body : frame(), material: materials.steel
    part glass: box(x: -0.11 ..= 0.11, y: 0.94 ..= 1.2, z: -0.11 ..= 0.11), material: materials.amber
    field near: bool = false, lives: client
    area(self, sphere(radius: 2 m, at: (0, 1, 0)))
    derive(near, occupied(self, by: me))
    derive(glass.tint, if near { 1.4 } else { 1 })      // now only the glass brightens
  part sun: sunLight(direction: (0.4, 1, 0.3), color: color(1, 0.96, 0.9), lux: 80000 lux,
                castsShadow: true)
  part arrivals
    part start, at: (0, 0, 3), facing: (0, 0, -1)
