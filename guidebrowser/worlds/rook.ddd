part hello                                              // the world
  part materials
    part ebony: physical(color: srgb(30, 24, 22), roughness: 0.18)          // lacquered ebony
    part boxwood: physical(color: srgb(226, 194, 146), roughness: 0.25)     // lacquered boxwood
    part limestone: physical(color: srgb(214, 200, 176), roughness: 0.6)
    part lawn: physical(color: srgb(118, 146, 92), roughness: 0.9)          // a soft sage-green lawn
  part ground: box(x: -40 ..= 40, y: -0.1 ..= 0, z: -40 ..= 40), material: materials.lawn, at: (0, 0, 0)
    solid(self, derived)
  part pedestal: box(x: -0.6 ..= 0.6, y: 0 ..= 0.8, z: -0.55 ..= 0.45), material: materials.limestone, at: (0, 0, 0)
  part rooks, at: (0, 0.8, 0)
    fn turned() shape {                                 // a garden-chess rook, 57 cm tall
      let body  = lathe(profile: [(0, 0), (0.150, 0), (0.150, 0.018), (0.143, 0.026), (0.140, 0.034),
                                  (0.146, 0.042), (0.146, 0.050), (0.138, 0.058), (0.120, 0.064),
                                  (0.112, 0.074), (0.098, 0.092), (0.090, 0.115), (0.086, 0.160),
                                  (0.080, 0.330), (0.084, 0.370), (0.096, 0.392), (0.112, 0.400),
                                  (0.112, 0.412), (0.104, 0.420), (0.110, 0.428), (0.122, 0.440),
                                  (0.122, 0.560), (0.116, 0.568), (0.092, 0.568), (0.092, 0.545),
                                  (0, 0.545)],
                        steps: 96);
      let slots = union(box(x: -0.2 ..= 0.2, y: 0.515 ..= 0.6, z: -0.03 ..= 0.03),
                        box(x: -0.03 ..= 0.03, y: 0.515 ..= 0.6, z: -0.2 ..= 0.2));
      difference(body, slots)                           // four battlements
    }
    part white: turned(), material: materials.boxwood, at: (-0.15, 0, 0.05)
    // Fallen: its base behind the white rook, its crown toward you and to the right. Lying,
    // it rests on its base's rim and its crown's, so it tilts 3 degrees, crown end lower
    part black: turned(), material: materials.ebony, at: (-0.05, 0.15, -0.3),
                rotation: rotation(92.8 deg, about: (0.85, 0, -0.5))
  part sun: sunLight(direction: (-0.8, 0.55, -0.45), color: color(1, 0.86, 0.68), lux: 60000 lux,
                castsShadow: true)
  part arrivals
    part start, at: (0, 0, 1.5), facing: (0, -0.3, -1)
