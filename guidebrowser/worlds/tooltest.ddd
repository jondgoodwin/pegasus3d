part toolTest                                           // the tools no other world calls: pointLight, smooth, outline.ellipse and five brushes
  part materials
    part clay: physical(color: srgb(200, 180, 160), roughness: 0.6)
  part pieces
    fn lump() shape {
      let blown   = inflate(outline.ellipse(width: 0.3, height: 0.2, segments: 24), thickness: 0.8, cell: 0.01);
      let eased   = smooth(blown, factor: 0.4, iterations: 2, keepVolume: true);
      let plain   = smooth(eased, factor: 0.3);
      carve(plain, strokes: [brush.clayStrips(along: [(-0.08, 0.0), (0.0, 0.03), (0.08, 0.0)], radius: 0.015),
                             brush.pinch(at: (0.05, 0.05), radius: 0.02),
                             brush.smooth(at: (-0.05, 0.02), radius: 0.03),
                             brush.layer(at: (0.0, -0.04), radius: 0.02, strength: 0.4),
                             brush.blob(at: (0.07, -0.03), radius: 0.02)])
    }
    part lump: lump(), material: materials.clay
  part lamp: pointLight(reach: 6 m, intensity: 200 candela, source: 0.02 m), at: (0.5, 1, 1)
  part arrivals
    part start, at: (0, 0, 1.5), facing: (0, 0, -1), eye: 0.3 m
