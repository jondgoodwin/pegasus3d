    part rbayLine3: move(turn(union(union(box(x: -2.5 ..= -2.41, y: 0 ..= 3.4, z: -0.04 ..= 0.04), box(x: 2.41 ..= 2.5, y: 0 ..= 3.4, z: -0.04 ..= 0.04)), move(difference(turn(lathe(profile: [(2.663, -0.04), (2.663, 0.04), (2.753, 0.04), (2.753, -0.04)], steps: 64), by: 90 deg, about: right), box(x: -4 ..= 4, y: -4 ..= 1.153, z: -1 ..= 1)), by: (0, 2.247, 0))), by: 90 deg, about: up), by: (14.95, 0, 2.5)), material: materials.brass
    part rbay4: move(turn(union(box(x: -2.5 ..= 2.5, y: 0 ..= 3.4, z: -0.015 ..= 0.015), move(difference(turn(lathe(profile: [(0, -0.015), (2.753, -0.015), (2.753, 0.015), (0, 0.015)], steps: 64), by: 90 deg, about: right), box(x: -4 ..= 4, y: -4 ..= 1.153, z: -1 ..= 1)), by: (0, 2.247, 0))), by: 90 deg, about: up), by: (14.97, 0, 8)), material: materials.sageDeep
    part rbayLine4: move(turn(union(union(box(x: -2.5 ..= -2.41, y: 0 ..= 3.4, z: -0.04 ..= 0.04), box(x: 2.41 ..= 2.5, y: 0 ..= 3.4, z: -0.04 ..= 0.04)), move(difference(turn(lathe(profile: [(2.663, -0.04), (2.663, 0.04), (2.753, 0.04), (2.753, -0.04)], steps: 64), by: 90 deg, about: right), box(x: -4 ..= 4, y: -4 ..= 1.153, z: -1 ..= 1)), by: (0, 2.247, 0))), by: 90 deg, about: up), by: (14.95, 0, 8)), material: materials.brass


  part shelves                                          // 8 slots a tier, 1.4 m apart, two tiers; round-ended boards
    part boardLow: box(x: -5.9 ..= 5.9, y: 0.25 ..= 0.3, z: -11.7 ..= -10.3), material: materials.shelfBoard
    part boardLowL: move(lathe(profile: [(0, 0), (0.7, 0), (0.7, 0.05), (0, 0.05)], steps: 32), by: (-5.9, 0.25, -11)), material: materials.shelfBoard
    part boardLowR: move(lathe(profile: [(0, 0), (0.7, 0), (0.7, 0.05), (0, 0.05)], steps: 32), by: (5.9, 0.25, -11)), material: materials.shelfBoard
    part boardMid: box(x: -5.9 ..= 5.9, y: 1.15 ..= 1.2, z: -11.7 ..= -10.3), material: materials.shelfBoard
    part boardMidL: move(lathe(profile: [(0, 0), (0.7, 0), (0.7, 0.05), (0, 0.05)], steps: 32), by: (-5.9, 1.15, -11)), material: materials.shelfBoard
    part boardMidR: move(lathe(profile: [(0, 0), (0.7, 0), (0.7, 0.05), (0, 0.05)], steps: 32), by: (5.9, 1.15, -11)), material: materials.shelfBoard
    part boardTop: box(x: -5.9 ..= 5.9, y: 2.05 ..= 2.1, z: -11.7 ..= -10.3), material: materials.shelfBoard
    part boardTopL: move(lathe(profile: [(0, 0), (0.7, 0), (0.7, 0.05), (0, 0.05)], steps: 32), by: (-5.9, 2.05, -11)), material: materials.shelfBoard
    part boardTopR: move(lathe(profile: [(0, 0), (0.7, 0), (0.7, 0.05), (0, 0.05)], steps: 32), by: (5.9, 2.05, -11)), material: materials.shelfBoard
    part postA: box(x: -6 ..= -5.9, y: 0 ..= 2.1, z: -11.7 ..= -11.6), material: materials.brass
    part postB: box(x: -2 ..= -1.9, y: 0 ..= 2.1, z: -11.7 ..= -11.6), material: materials.brass
    part postC: box(x: 1.9 ..= 2, y: 0 ..= 2.1, z: -11.7 ..= -11.6), material: materials.brass
    part postD: box(x: 5.9 ..= 6, y: 0 ..= 2.1, z: -11.7 ..= -11.6), material: materials.brass
