    part rightLowN: move(lathe(profile: [(0, 0), (0.7, 0), (0.7, 0.05), (0, 0.05)], steps: 32), by: (11, 0.25, -2.9)), material: materials.shelfBoard
    part rightLowS: move(lathe(profile: [(0, 0), (0.7, 0), (0.7, 0.05), (0, 0.05)], steps: 32), by: (11, 0.25, 2.9)), material: materials.shelfBoard
    part rightMid: box(x: 10.3 ..= 11.7, y: 1.15 ..= 1.2, z: -2.9 ..= 2.9), material: materials.shelfBoard
    part rightMidN: move(lathe(profile: [(0, 0), (0.7, 0), (0.7, 0.05), (0, 0.05)], steps: 32), by: (11, 1.15, -2.9)), material: materials.shelfBoard
    part rightMidS: move(lathe(profile: [(0, 0), (0.7, 0), (0.7, 0.05), (0, 0.05)], steps: 32), by: (11, 1.15, 2.9)), material: materials.shelfBoard
    part rightTop: box(x: 10.3 ..= 11.7, y: 2.05 ..= 2.1, z: -2.9 ..= 2.9), material: materials.shelfBoard
    part rightTopN: move(lathe(profile: [(0, 0), (0.7, 0), (0.7, 0.05), (0, 0.05)], steps: 32), by: (11, 2.05, -2.9)), material: materials.shelfBoard
    part rightTopS: move(lathe(profile: [(0, 0), (0.7, 0), (0.7, 0.05), (0, 0.05)], steps: 32), by: (11, 2.05, 2.9)), material: materials.shelfBoard
    part rpostA: box(x: 11.6 ..= 11.7, y: 0 ..= 2.1, z: -3 ..= -2.9), material: materials.brass
