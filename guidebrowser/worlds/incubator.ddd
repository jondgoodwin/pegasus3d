    part boardB: box(x: 8.38 ..= 8.5, y: 1.4 ..= 2.9, z: -7.6 ..= -6.4), material: materials.stBuilding
    part boardC: box(x: 8.38 ..= 8.5, y: 0.9 ..= 2.3, z: -6 ..= -4.8), material: materials.stMerged
