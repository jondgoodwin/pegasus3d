    part cornerNE: move(lathe(profile: [(0, 0), (0.45, 0), (0.45, 4.8), (0, 4.8)], steps: 24), by: (6.5, 0, -6.5)), material: materials.cornerMat
    part cornerSW: move(lathe(profile: [(0, 0), (0.45, 0), (0.45, 4.8), (0, 4.8)], steps: 24), by: (-6.5, 0, 2.5)), material: materials.cornerMat
