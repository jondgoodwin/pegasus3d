  part wash2: spotLight(8 m, color: color(1, 0.96, 0.88), intensity: 300000 candela, source: 0.4 m, aim: (0, 1, 0), cone: 1.2 rad, softEdge: 0.5 rad), at: (5, 2.6, -4)
  part wash3: spotLight(8 m, color: color(1, 0.96, 0.88), intensity: 300000 candela, source: 0.4 m, aim: (0, 1, 0), cone: 1.2 rad, softEdge: 0.5 rad), at: (-5, 2.6, 1)
  part wash4: spotLight(8 m, color: color(1, 0.96, 0.88), intensity: 300000 candela, source: 0.4 m, aim: (0, 1, 0), cone: 1.2 rad, softEdge: 0.5 rad), at: (5, 2.6, 1)
