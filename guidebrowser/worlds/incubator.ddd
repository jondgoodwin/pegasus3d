  part partitions                                       // the line's backing wall (left), the board wall beside the ring (right); round-ended
    part lineWall: box(x: -6.7 ..= -6.5, y: 0 ..= 4.2, z: -6 ..= 6), material: materials.wallPaint
    part lineWallN: move(lathe(profile: [(0, 0), (0.1, 0), (0.1, 4.2), (0, 4.2)], steps: 24), by: (-6.6, 0, -6)), material: materials.wallPaint
