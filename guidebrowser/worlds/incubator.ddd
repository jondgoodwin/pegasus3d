    part x5: box(x: 9.975 ..= 10.025, y: 0 ..= 0.004, z: -15 ..= 15), material: materials.floorLine
    part z1: box(x: -15 ..= 15, y: 0 ..= 0.004, z: -10.025 ..= -9.975), material: materials.floorLine
    part z2: box(x: -15 ..= 15, y: 0 ..= 0.004, z: -5.025 ..= -4.975), material: materials.floorLine
    part z3: box(x: -15 ..= 15, y: 0 ..= 0.004, z: -0.025 ..= 0.025), material: materials.floorLine
