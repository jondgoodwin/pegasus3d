  part down5: spotLight(9 m, color: color(1, 0.94, 0.82), intensity: 900000 candela, source: 0.3 m, aim: (0, -1, 0), cone: 0.8 rad, softEdge: 0.6 rad), at: (-4.5, 7.9, -8)
  part down6: spotLight(9 m, color: color(1, 0.94, 0.82), intensity: 900000 candela, source: 0.3 m, aim: (0, -1, 0), cone: 0.8 rad, softEdge: 0.6 rad), at: (4.5, 7.9, -8)
  part wash1: spotLight(12 m, color: color(1, 0.96, 0.88), intensity: 700000 candela, source: 0.4 m, aim: (0, 1, 0), cone: 1.2 rad, softEdge: 0.5 rad), at: (-7, 3.5, -6)
  part wash2: spotLight(12 m, color: color(1, 0.96, 0.88), intensity: 700000 candela, source: 0.4 m, aim: (0, 1, 0), cone: 1.2 rad, softEdge: 0.5 rad), at: (7, 3.5, -6)
  part wash3: spotLight(12 m, color: color(1, 0.96, 0.88), intensity: 700000 candela, source: 0.4 m, aim: (0, 1, 0), cone: 1.2 rad, softEdge: 0.5 rad), at: (-7, 3.5, 6)
  part wash4: spotLight(12 m, color: color(1, 0.96, 0.88), intensity: 700000 candela, source: 0.4 m, aim: (0, 1, 0), cone: 1.2 rad, softEdge: 0.5 rad), at: (7, 3.5, 6)
  part wash5: spotLight(12 m, color: color(1, 0.96, 0.88), intensity: 700000 candela, source: 0.4 m, aim: (0, 1, 0), cone: 1.2 rad, softEdge: 0.5 rad), at: (0, 3.5, 0)
  part wash6: spotLight(12 m, color: color(1, 0.96, 0.88), intensity: 700000 candela, source: 0.4 m, aim: (0, 1, 0), cone: 1.2 rad, softEdge: 0.5 rad), at: (0, 3.5, -12)
  part wash7: spotLight(12 m, color: color(1, 0.96, 0.88), intensity: 700000 candela, source: 0.4 m, aim: (0, 1, 0), cone: 1.2 rad, softEdge: 0.5 rad), at: (0, 3.5, 12)
  part wash8: spotLight(12 m, color: color(1, 0.96, 0.88), intensity: 700000 candela, source: 0.4 m, aim: (0, 1, 0), cone: 1.2 rad, softEdge: 0.5 rad), at: (-12, 3.5, 0)
  part wash9: spotLight(12 m, color: color(1, 0.96, 0.88), intensity: 700000 candela, source: 0.4 m, aim: (0, 1, 0), cone: 1.2 rad, softEdge: 0.5 rad), at: (12, 3.5, 0)

