part incubator                                          // the incubator as a incubator: look c (soft atelier: sand and sage, arched bays, brass linings)
  part materials
    part floorStone: plain(srgb(220, 208, 184))
    part floorLine: plain(srgb(196, 160, 90))
    part wallPaint: plain(srgb(230, 217, 192))
    part boardPaint: plain(srgb(240, 232, 212))
    part cornerMat: plain(srgb(226, 212, 186))
    part brass: physical(color: srgb(222, 186, 108), roughness: 0.4)
    part sage: plain(srgb(172, 188, 164))
    part sageDeep: plain(srgb(150, 170, 144))
    part shelfBoard: physical(color: srgb(214, 190, 150), roughness: 0.5)
    part ceilingPaint: plain(srgb(242, 238, 226))
    part glass: plain(srgb(255, 252, 238))
    part lamp: plain(srgb(255, 248, 224))
    part beltRubber: plain(srgb(44, 46, 50))
    part boxwood: [physical(color: srgb(238, 212, 168), roughness: 0.5), clearCoat(amount: 1, roughness: 0.05)]
    part clay: physical(color: srgb(176, 98, 62), roughness: 0.7)
    part stQueued: plain(srgb(160, 160, 168))
    part stBuilding: plain(srgb(226, 170, 60))
    part stTesting: plain(srgb(70, 150, 214))
    part stReview: plain(srgb(170, 110, 200))
    part stMerged: plain(srgb(70, 170, 100))
    part box_island: physical(color: srgb(120, 170, 110), roughness: 0.65)
    part box_labyrinth: physical(color: srgb(150, 120, 90), roughness: 0.65)
    part box_starship: physical(color: srgb(130, 140, 170), roughness: 0.65)
    part box_cottage: physical(color: srgb(190, 150, 120), roughness: 0.65)
    part box_chess: physical(color: srgb(150, 150, 150), roughness: 0.65)
    part box_horse: physical(color: srgb(170, 125, 95), roughness: 0.65)

  part floor: box(x: -7 ..= 7, y: -0.1 ..= 0, z: -7 ..= 3), material: materials.floorStone
  part panelLines                                       // inlaid lines every 5 m: the floor's scale
    part x1: box(x: -5.025 ..= -4.975, y: 0 ..= 0.004, z: -7 ..= 3), material: materials.floorLine
    part x2: box(x: -0.025 ..= 0.025, y: 0 ..= 0.004, z: -7 ..= 3), material: materials.floorLine
    part x3: box(x: 4.975 ..= 5.025, y: 0 ..= 0.004, z: -7 ..= 3), material: materials.floorLine
    part z1: box(x: -7 ..= 7, y: 0 ..= 0.004, z: -5.025 ..= -4.975), material: materials.floorLine
    part z2: box(x: -7 ..= 7, y: 0 ..= 0.004, z: -0.025 ..= 0.025), material: materials.floorLine
    part startRing: move(lathe(profile: [(2.4, 0), (2.4, 0.006), (2.46, 0.006), (2.46, 0)], steps: 64), by: (0, 0, 0)), material: materials.brass
    part startRing2: move(lathe(profile: [(2.62, 0), (2.62, 0.006), (2.65, 0.006), (2.65, 0)], steps: 64), by: (0, 0, 0)), material: materials.brass
  part building                                         // 14 m wide, 10 m deep, 5 m high
    part backWall: box(x: -7 ..= 7, y: 0 ..= 5, z: -7.2 ..= -7), material: materials.wallPaint
    part frontWall: box(x: -7 ..= 7, y: 0 ..= 5, z: 3 ..= 3.2), material: materials.wallPaint
    part leftOuter: box(x: -7.2 ..= -7, y: 0 ..= 5, z: -7 ..= 3), material: materials.wallPaint
    part rightOuter: box(x: 7 ..= 7.2, y: 0 ..= 5, z: -7 ..= 3), material: materials.wallPaint
    part winBack1: box(x: -5.8 ..= -3.2, y: 4.4 ..= 4.75, z: -6.95 ..= -6.9), material: materials.glass
    part winBack2: box(x: -1.3 ..= 1.3, y: 4.4 ..= 4.75, z: -6.95 ..= -6.9), material: materials.glass
    part winBack3: box(x: 3.2 ..= 5.8, y: 4.4 ..= 4.75, z: -6.95 ..= -6.9), material: materials.glass
