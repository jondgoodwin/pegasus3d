part hello                                              // the world
  part materials
    part slate: plain(srgb(70, 110, 160))               // a matte blue
    part stone: plain(srgb(140, 140, 135))              // a matte gray
  part floor: box(x: -5 ..= 5, y: -0.1 ..= 0, z: -5 ..= 5), material: materials.stone, at: (0, 0, 0)
    solid(self, derived)                                // you can stand on it
  part block: box(x: -0.3 ..= 0.3, y: 0.4 ..= 1, z: -0.3 ..= 0.3), material: materials.slate,
              at: (0, 0, 0), rotation: rotation(30 deg)
  part sun: sunLight(direction: (0.4, 1, 0.3), color: color(1, 0.96, 0.9), lux: 80000 lux,
                castsShadow: true)
  part arrivals
    part start, at: (0, 0, 3), facing: (0, -0.3, -1)    // where you stand, looking at the block
