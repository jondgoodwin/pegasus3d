// meshprobe: where does a lathe first differ across machines? For the half-angles a lathe of 96 steps uses, prints the
// bits of sin and cos (the C library's), of Quat.angleAxis, and of the quaternion turning a point (the arithmetic
// Cone does itself). Compared line by line between machines: the first line that differs is the first operation.
mod meshprobe;

import stdio use *;
import geomath use *;

fn main(argc: i32, argv: **u8) i32 {
  let axis = Vec3(0., 1., 0.);
  let start = Vec3(0.150, 0.018, 0.);
  var k = 0usize;
  while k < 96usize {
    let angle = 6.2831855 * f32.from(k) / 96.;
    let half = angle * 0.5;
    let s = sin(half);
    let c = cos(half);
    let q = Quat.angleAxis(angle, axis);
    let p = q * start;
    print <- "k"; print <- k;
    print <- " half "; print <- half.bits();
    print <- " sin "; print <- s.bits(); print <- " cos "; print <- c.bits();
    print <- " q "; print <- q.x.bits(); print <- " "; print <- q.y.bits(); print <- " "; print <- q.z.bits(); print <- " "; print <- q.w.bits();
    print <- " p "; print <- p.x.bits(); print <- " "; print <- p.y.bits(); print <- " "; print <- p.z.bits();
    print <- "\n";
    k = k + 1usize;
  }
  0i32
}
