// The Loader: the catalog of built content, content keys, and a pool of
// worker actors that build jobs nearest first. Plan step 4, first part.
//
//   openWorld(world, sim)  Player -> Loader: the world image moves to Sim first (two-phase
//                          arrival, phase 1: the declarations); then Sim's build requests
//                          queue by nearness (phase 2)
//   build(req)             Sim -> Loader: part req.part uses key req.key, req.nearness off
//   unused(key, part)      Sim -> Loader: the part no longer uses the key; at no users the
//                          mesh goes from Render (Render.release, a message this adds)
//   stop()
//
// The work is `buildContent` (partproducts.cone), run by a Worker. Today's
// mock content sits behind it; lane B's `partbuild.buildPart` replaces it.
//
// WORKERS AND PRIORITY. The actors package runs every actor on one
// work-stealing pool and has no priority. So "low priority" is kept by how the
// Loader hands out work: at most WORKERS jobs run at once, one per Worker,
// each job one message turn, so Sim's and Render's loops, which wait on a
// timer or the display, find a free pool thread. A real low-priority class
// waits for the runtime.
//
// THE CACHE (meshcache.cone). A real world's mesh and material keys are looked up on disk by the Worker first; what is built
// is written by this Loader, its only writer, when the job lands.
//
// NOT YET: the network fetch, the server-side Loader, the
// reader and the interpreter.

pub const MOCK_KEYS = 8usize;       // keys resident once the small mock world has arrived: four meshes and four materials
pub const MOCK_KEYS_40 = 9usize;    // the 40-part world's five meshes and five materials, less the mesh it lets go
const READ_CHUNK = 65536usize;     // a world file is read this much at a time
const WORKERS = 3usize;            // jobs in flight at once
const CACHE_EVICT_EVERY = 32u64;   // the mesh cache is trimmed to its cap after this many writes (and at stop)
pub const PARTS_NOT_KNOWN = 0xFFFFFFFFusize;   // Render.partsAwaited: the world's files are not all in
const SETTLE_US = 1000i64;        // the burst of requests that follows a world image is gathered for this long

// What a worker's job came back with: the products, and what the cache said (0: the cache was not asked: mock content, or off)
pub struct Built {
  pub products: PartProducts;
  pub outcome: u32;                 // 0, LOAD_HIT, LOAD_MISS, LOAD_CORRUPT or LOAD_OLD
}

actor Worker {
  // The world's builder: its code lowered and verified, its material parts made. Each worker makes its own (a
  // PartBuilder is one thread's), and every one is made the same way, so a job gives the same bits on any worker.
  builder: Option[PartBuilder];
  leaf: List[String];               // each part's own name, by slot (for the mesh hash lines)
  hashes: bool;                     // PEGASUS_MESH_HASHES is set
  cacheDir: Path;                   // the mesh cache's folder, read from only (empty: no cache)
  stamp: u64;                       // this build's stamp: an entry another build wrote is a miss
  lax: u32;                         // the mutants that read cache entries without checking the checksum or the stamp (cacheLax)

  fn init(self: &new) {
    let e = libc.getenv("PEGASUS_MESH_HASHES");
    *self = Self(None[PartBuilder], List[String](), (e as usize) != 0usize, Path.from(""), 0u64, cacheLax());
  }

  // Loader -> Worker: the world's text, or the part of it that has arrived (a part builder made from the text builds any part the
  // text has: slots are the same in any longer text). 'index' is this worker's number: the first one reports a refusal, for all, and
  // only when 'whole' says the text is every file's
  pub async fn open(self, index: usize, file: String, text: String, cacheDir: String, stamp: u64, whole: bool) {
    self.cacheDir = Path.from(cacheDir.view());
    self.stamp = stamp;
    var names = Names.standard();
    let vocab = vocabulary(&mut names);
    let reading = read(text.view(), names, vocab);
    let w = &reading.understood;
    match PartBuilder.make(w, toolImports(&w.vocab, &w.names)) {
      case let Ok(made) {
        var bld = made;
        var i = 0usize;
        while i < w.order.len() {
          let slot = *w.order[i];
          if w.nodes[slot].kind == Kind.Material { bld.buildPart(slot, Kind.Material); }
          i = i + 1usize;
        }
        // a unit the verifier refused leaves out the parts that use it; one line each, from the first worker only
        if index == 0usize && whole {
          let refused = bld.refusals();
          var r = 0usize;
          while r < refused.len() {
            print <- "build: "; printStr(file.view()); print <- ": a unit of the world's code was refused and the parts that use it are left out: ";
            printStr(refused[r].what.view()); print <- " (unit "; print <- refused[r].unit; print <- ", offset "; print <- refused[r].offset; print <- ")\n";
            r = r + 1usize;
          }
        }
        self.builder = Some[PartBuilder](bld);
        leaf = List[String]();
        i = 0usize;
        while i < w.nodes.len() { leaf.push(String.from(w.names.text(w.nodes[i].name))); i = i + 1usize; }
      }
      case let Err(problems) {
        // Only a fault in the code's shared tables (its version or types) refuses the world's code whole; no part is
        // built. Each problem names a unit.
        if index == 0usize && whole {
          var k = 0usize;
          while k < problems.len() {
            print <- "build: "; printStr(file.view()); print <- ": the world's code was refused: "; printStr(problems[k].what.view());
            print <- " (unit "; print <- problems[k].unit; print <- ", offset "; print <- problems[k].offset; print <- ")\n";
            k = k + 1usize;
          }
        }
      }
    }
  }

  // Loader -> Worker: build 'job'. Pure, so the worker that runs it never changes the bits. A real world's part
  // (shape "cs.") is made by the interpreter from its slot; the mock worlds' content by `buildContent`
  pub async fn build(self, job: BuildJob) Built {
    if job.recipe.shape.view() == MATERIAL_SHAPE {
      // a material key: the world's material, run alone from its slot (no mesh is built). The cache is asked first
      var cached = plainProducts(Mesh(), Color(0.5, 0.5, 0.5, 1.), Vec3(0., 0., 0.));
      var outcome = 0u32;
      if !cacheDir.isEmpty() {
        outcome = loadEntry(&cacheDir, job.key, CACHE_MATERIAL, stamp, lax, &mut cached);
        if outcome == LOAD_HIT { return Built(cached, outcome); }
      }
      match &mut builder {
        case var &mut Some(b) {
          var p = b.buildMaterial(usize.from(job.recipe.slot));
          each note in &p.notes { print <- "build: material of part "; print <- job.recipe.slot; print <- " left grey: "; printStr(note.view()); print <- "\n"; }
          return Built(p, outcome);
        }
        else {}
      }
      return Built(plainProducts(Mesh(), Color(0.5, 0.5, 0.5, 1.), Vec3(0., 0., 0.)), 0u32);
    }
    if job.recipe.shape.view() == MOCK_MATERIAL_SHAPE { return Built(buildMockMaterial(&job), 0u32); }
    if job.recipe.shape.view().startsWith("cs.") {
      var outcome = 0u32;
      var cached = plainProducts(Mesh(), Color(0.5, 0.5, 0.5, 1.), Vec3(0., 0., 0.));
      if !cacheDir.isEmpty() {
        outcome = loadEntry(&cacheDir, job.key, CACHE_MESH, stamp, lax, &mut cached);
        if outcome == LOAD_HIT {
          if hashes {
            printStr(meshHashLine(leaf[usize.from(job.recipe.slot)].view(), meshHash(&cached.mesh)).view());
          }
          return Built(cached, outcome);
        }
      }
      match &mut builder {
        case var &mut Some(b) {
          var p = b.buildPart(usize.from(job.recipe.slot), Kind.Shape);
          each note in &p.notes { print <- "build: part "; print <- job.recipe.slot; print <- " left out: "; printStr(note.view()); print <- "\n"; }
          if hashes && p.made {
            printStr(meshHashLine(leaf[usize.from(job.recipe.slot)].view(), meshHash(&p.mesh)).view());
          }
          return Built(p, outcome);
        }
        else {}
      }
      return Built(plainProducts(Mesh(), Color(0.5, 0.5, 0.5, 1.), Vec3(0., 0., 0.)), 0u32);
    }
    Built(buildContent(&job), 0u32)
  }
}

// The Loader's reader: reads a world's text, or the files of it that have arrived, off the Loader's own turns (so a file arriving
// meanwhile is taken in at once) with the `conescript` reader, which it uses as it is
actor Reader {
  reads: u64;

  fn init(self: &new) { *self = Self(0u64); }

  // Loader -> Reader: the shape parts of the first files, as far as they are understood (`readPrefix`)
  pub async fn prefix(self, file: String, text: String) ImageWorld {
    reads = reads + 1u64;
    readPrefix(file.view(), text.view())
  }

  // Loader -> Reader: the whole world: every part, the rules and derives, the keys and the looks (`readImage`)
  pub async fn whole(self, file: String, text: String) ImageWorld {
    reads = reads + 1u64;
    readImage(file.view(), text.view())
  }
}

pub actor Loader {
  render: RenderSink;
  sim: Option[Sim];
  core: LoaderCore;
  workers: List[Worker];
  busy: List[bool];                 // a job is running on worker i
  settling: bool;                   // a `settle` is waiting for the burst to end
  report: Sender[bool];             // told at stop whether the Loader's checks passed
  expectBuilds: u64;                // a check: how many keys the world makes
  retire: bool;                     // a check: once all are built, let go of the first key's parts
  retired: bool;
  simOnly: bool;                    // a server's Loader: builds what Sim needs (the shapes) and sends Render nothing
  cache: MeshCache;                 // built content kept on disk across runs (meshcache.cone); this Loader is its only writer
  hits: u64;                        // keys the cache gave
  built: u64;                       // keys the cache was asked for and did not have (or had damaged), so were built
  damaged: u64;                     // of those, entries that were damaged or unreadable
  opened: Instant;                  // when the world was opened
  arrived: bool;                    // the line saying every key landed has been printed
  fetcher: Fetcher;                 // this Loader's own connection for a world's files (worldfetch.cone), never Sim's
  pendingWorld: String;             // the world being fetched: the name its text is read under
  pieces: List[String];             // a manifest's files' texts, by place, as they arrive
  reader: Reader;
  arrival: FileArrival;             // which files are in, and which read to start next (worldfetch.cone)
  earlySlots: List[u32];            // the parts declared to Sim before every file was in: each one's slot,
  earlyKeys: List[ContentKey];      // ... and mesh key, to check against the whole world's parts when it is read
  earlyBroken: bool;                // a longer text disagreed with a part already declared: no more are declared early
  latest: String;                   // the text the latest read covered: what a worker that has not seen the newest parts is opened with
  latestSlots: usize;               // the number of parts that text has: a worker opened with it can build any slot below
  covers: List[usize];              // for each worker, the number of parts of the text it was opened with
  filesKept: u64;                   // of those, files the cache had by content hash (not fetched)
  filesFetched: u64;                // files fetched and found as the manifest said
  filesLeftOut: u64;                // files left out: not fetched, or the wrong size or hash, or a bad manifest line
  entries: List[ManifestEntry];     // the manifest's lines, to check each file's place when all are in
  fromKept: List[bool];             // for each file, whether it came from the kept files (else it was fetched)

  pub fn init(self: &new, render: RenderSink, report: Sender[bool], expectBuilds: u64, retire: bool, offByOne: bool, simOnly: bool) {
    var ws = List[Worker]();
    var b = List[bool]();
    var cov = List[usize]();
    let oneAtATime = (libc.getenv("PEGASUS_MESH_HASHES") as usize) != 0usize;
    var i = 0usize;
    while i < WORKERS {
      ws.push(Worker());
      cov.push(0usize);
      b.push(oneAtATime && i > 0usize);   // PEGASUS_MESH_HASHES: only worker 0 takes jobs, so the hash lines of two workers cannot tear into each other
      i = i + 1usize;
    }
    var catalog = LoaderCore.make(offByOne);
    catalog.learn(browserAvatarKey(), browserAvatarRecipe());   // the browser's own avatar needs nothing from a world
    catalog.learn(browserAvatarMaterialKey(), browserAvatarMaterialRecipe());
    *self = Self(render, None[Sim], catalog, ws, b, false, report, expectBuilds, retire, false, simOnly,
      MeshCache.make(Path.from(cacheFolder().view()), buildStamp(), CACHE_CAP_BYTES), 0u64, 0u64, 0u64, Instant.now(), false,
      Fetcher(), String(), List[String](), Reader(), FileArrival.make(0usize, false), List[u32](), List[ContentKey](), false, String(), 0usize,
      cov, 0u64, 0u64, 0u64, List[ManifestEntry](), List[bool]());
  }

  // Player -> Loader (event): open world 'world' for 'sim', which Player has
  // started. Phase 1: the world image is moved to that Sim; its parts name
  // their keys, and Sim then asks for each
  pub async fn openWorld(self, world: String, sim: Sim) {
    self.opened = Instant.now();
    self.sim = Some[Sim](sim.clone());
    if world.view() == "mock" || world.view() == "parts40" {
      sim.world(mockWorld(world, &mut core));
      return;
    }
    // A world named by a manifest: its files are asked for together (`piece`), and the world is made when the last is in. A world
    // named by one file: that file, then the world
    printStr(numberLine("arrival: opened at ", u64.from(opened.nanos()), " ns\n").view());
    pendingWorld = world.clone();
    if isManifest(world.view()) {
      let listing = await fetcher.text(world.clone());
      let names = manifestEntries(listing.text.view());
      // the table of contents as a whole must be sound (a fault in one line only costs that file): else the world does not open
      var fault = String();
      if !listing.ok { fault = String.from("could not be fetched"); }
      else { fault = manifestFault(listing.text.view(), &names); }
      if fault.len() > 0usize {
        printStr(manifestFaultLine(world.view(), fault.view()).view());
        return;
      }
      entries = manifestEntries(listing.text.view());
      fromKept = List[bool]();
      printStr(numberLine("arrival: manifest of ", u64.from(names.len()), numberLine(" files in at +", self.sinceOpenedMs(), " ms\n").view()).view());
      pieces = List[String]();
      arrival = FileArrival.make(names.len(), mutantIs("rules-early"));
      if !simOnly { render.partsAwaited(PARTS_NOT_KNOWN); }
      earlySlots = List[u32]();
      earlyKeys = List[ContentKey]();
      earlyBroken = false;
      filesKept = 0u64;
      filesFetched = 0u64;
      filesLeftOut = 0u64;
      var i = 0usize;
      while i < names.len() {
        pieces.push(String());
        fromKept.push(false);
        let n = &names[i];
        selfactor.piece(i, siblingOf(world.view(), n.name.view()), n.name.clone(), n.size, n.hash, n.path.clone(), n.ok);
        i = i + 1usize;
      }
      if names.len() == 0usize { self.begin(String()); }
    } else {
      var one = await fetcher.text(world.clone());
      var text = String();
      text <-> one.text;
      self.begin(text);
    }
  }

  // The fetch of one file of the manifest's world: put in its place, and when the last is in, the world begins
  // (a file whose line is not whole is not fetched). A file kept under its content hash is not fetched; one fetched is checked
  // against the size and hash, and if it fails it is left out (its text is empty) and said so, once
  pub async fn piece(self, i: usize, loc: String, name: String, size: u64, hash: u64, path: String, lineOk: bool) {
    var text = String();
    let remote = isUrl(loc.view()) && cache.on();
    if !lineOk {
      printStr("loader: manifest line of file ");
      printStr(name.view()); printStr(" is not whole (NAME SIZE HASH PATH): left out\n");
      filesLeftOut = filesLeftOut + 1u64;
    } else {
      var haveIt = false;
      if remote {
        var k = await fetcher.kept(String.from(cache.dir.view()), size, hash);
        if k.ok { text <-> k.text; haveIt = true; filesKept = filesKept + 1u64; fromKept.set(i, true); cache.touchFile(hash); cache.holdFile(hash); }
      }
      if !haveIt {
        var one = await fetcher.text(loc);
        text <-> one.text;
        if !one.ok {
          text = String();                                   // (the fetch said what went wrong)
          filesLeftOut = filesLeftOut + 1u64;
        } else {
          let verdict = judgeFile(size, hash, text.view(), mutantIs("manifest-skip-hash"));
          if verdict != FILE_FINE {
            printStr(dropLine(name.view(), path.view(), verdict, text.view(), size, hash).view());
            text = String();
            filesLeftOut = filesLeftOut + 1u64;
          } else {
            filesFetched = filesFetched + 1u64;
            if remote { cache.holdFile(hash); fetcher.keep(String.from(cache.dir.view()), hash, text.clone()); }
          }
        }
      }
    }
    // a file's text must begin where the manifest says: the part its first line declares must be the path's last part. Judged from
    // the file's own text, so a file left out for this (or any other reason) moves no other file's place. A mismatch is left out, said once
    if lineOk && text.len() > 0usize {
      let place = placeOfText(text.view());
      if !placeFits(path.view(), &place) {
        printStr(pathLine(name.view(), path.view(), &place).view());
        text = String();
        if *fromKept[i] { filesKept = filesKept - 1u64; } else { filesFetched = filesFetched - 1u64; }
        filesLeftOut = filesLeftOut + 1u64;
      }
    }
    pieces.set(i, text);
    arrival.arrive(i);
    if arrival.allIn() {
      printStr(numberLine("arrival: ", u64.from(pieces.len()), numberLine(" files: ", filesKept, numberLine(" kept, ", filesFetched,
        numberLine(" fetched, ", filesLeftOut, " left out\n").view()).view()).view()).view());
      printStr(numberLine("arrival: ", u64.from(self.joined(pieces.len()).len()), numberLine(" bytes of world in at +", self.sinceOpenedMs(), " ms\n").view()).view());
    }
    self.readNext();
  }

  // The files that have arrived: their texts one after the other, a newline between two that did not have one
  fn joined(self: &, files: usize) String {
    var out = String();
    var f = 0usize;
    while f < files && f < pieces.len() {
      out.appendBytes(pieces[f].view());
      out.append(joinAfter(pieces[f].view()).view());
      f = f + 1usize;
    }
    out
  }

  // Start the next read the arrived files call for, if none is under way: the first files read (a prefix, whose shape parts Sim
  // declares now), or every file read (the whole world: its rules and derives start only now)
  fn readNext(self: &mut) {
    let what = arrival.next();
    if what == READ_PREFIX { selfactor.readPrefix(arrival.inRun()); }
    if what == READ_WHOLE { selfactor.readWhole(arrival.inRun()); }
  }

  // Read the first 'files' files, and declare the shape parts that are settled. A file that arrives meanwhile waits for this read:
  // the next one then gathers every file in by that time
  pub async fn readPrefix(self, files: usize) {
    let text = self.joined(files);
    var img = await reader.prefix(pendingWorld.clone(), text.clone());
    self.takePrefix(text, &mut img);
    arrival.readDone(false);
    self.readNext();
  }

  // Every file is in: read the whole world and give it to Sim (with the rules, the derives and the looks)
  pub async fn readWhole(self, files: usize) {
    let text = self.joined(files);
    var img = await reader.whole(pendingWorld.clone(), text.clone());
    arrival.readDone(true);
    self.finish(text, &mut img);
  }

  // The parts the first files give that will be the same in the whole world: those before the first the reader left out (a part
  // naming one in a file not in yet is among the left-out), as far as the order the whole world gives them. They go to Sim now, each
  // key taught its recipe; a worker that is asked for one is opened with this text
  fn takePrefix(self: &mut, text: String, img: &mut ImageWorld) {
    latest = text;
    latestSlots = usize.from(img.slots);
    var k = 0usize;
    while k < img.parts.len() && img.parts[k].slot < img.firstDropped { k = k + 1usize; }
    var i = 0usize;
    var same = true;
    while i < earlySlots.len() {
      if i >= k || img.parts[i].slot != *earlySlots[i] || img.parts[i].key != *earlyKeys[i] { same = false; }
      i = i + 1usize;
    }
    if !same && !earlyBroken {
      earlyBroken = true;
      printStr(numberLine("loader: a longer text read differently a part already declared (", u64.from(earlySlots.len()), " declared early): no more are declared early\n").view());
    }
    if earlyBroken || k <= earlySlots.len() { return; }
    var decls = PartDecls();
    var j = earlySlots.len();
    while j < k {
      let p = &img.parts[j];
      core.learn(p.key, p.recipe.copy());
      core.learn(p.material, p.materialRecipe.copy());
      decls.push(PartDecl(p.path.clone(), p.key, p.material, noLook(), p.placement, p.slot));
      earlySlots.push(p.slot);
      earlyKeys.push(p.key);
      j = j + 1usize;
    }
    match &sim {
      case let Some(s) { s.declare(decls, img.startFeet); }
      case is None[Sim] {}
    }
    printStr(numberLine("arrival: ", u64.from(earlySlots.len()), numberLine(" parts declared early (", u64.from(arrival.inRun()),
      numberLine(" of ", u64.from(arrival.files()), numberLine(" files) at +", self.sinceOpenedMs(), " ms\n").view()).view()).view()).view());
  }

  // The whole world is read: the part of it that was not declared early goes to Sim with its rules, derives and looks
  fn finish(self: &mut, text: String, img: &mut ImageWorld) {
    latest = text;
    latestSlots = usize.from(img.slots);
    // worker 0 reads the whole world to report what the verifier refuses; the others are opened when asked for a part the text
    // they have lacks
    workers[0usize].open(0usize, pendingWorld.clone(), String.from(latest.view()), String.from(cache.dir.view()), cache.stamp, true);
    covers.set(0usize, latestSlots);
    var same = !earlyBroken && earlySlots.len() <= img.parts.len();
    var i = 0usize;
    while same && i < earlySlots.len() {
      if img.parts[i].slot != *earlySlots[i] || img.parts[i].key != *earlyKeys[i] { same = false; }
      i = i + 1usize;
    }
    if !same {
      printStr(numberLine("loader: the whole world's parts differ from the ", u64.from(earlySlots.len()), " declared early\n").view());
    }
    let partCount = img.parts.len();
    let worldName = pendingWorld.clone();          // a copy: self changes while it reads the name
    let image = self.imageOf(worldName.view(), img, earlySlots.len());
    if !simOnly { render.partsAwaited(partCount); }
    match &sim {
      case let Some(s) { s.world(image); }
      case is None[Sim] {}
    }
    if arrival.allIn() { pieces = List[String](); }
    printStr(numberLine("arrival: parts declared at +", self.sinceOpenedMs(), " ms\n").view());
  }

  fn sinceOpenedMs(self: &) u64 { u64.from((Instant.now() - opened).micros() / 1000i64) }

  // A world of one file is in (phase 1): the reader understands it, the workers are given it to build from, and the world image
  // moves to Sim, which declares every part. Phase 2, the content, follows as Sim asks for it, nearest first
  fn begin(self: &mut, text: String) {
    printStr(numberLine("arrival: ", u64.from(text.len()), numberLine(" bytes of world in at +", self.sinceOpenedMs(), " ms\n").view()).view());
    var w = 0usize;
    while w < WORKERS {
      workers[w].open(w, pendingWorld.clone(), String.from(text.view()), String.from(cache.dir.view()), cache.stamp, true);
      covers.set(w, 0xFFFFFFFFusize);
      w = w + 1usize;
    }
    let worldName = pendingWorld.clone();          // a copy: self changes while it reads the name
    let image = self.imageOfText(worldName.view(), text.view());
    match &sim {
      case let Some(s) { s.world(image); }
      case is None[Sim] {}
    }
    printStr(numberLine("arrival: parts declared at +", self.sinceOpenedMs(), " ms\n").view());
  }

  fn imageOfText(self: &mut, file: &str, text: &str) WorldImage {
    var image = readImage(file, text);
    self.imageOf(file, &mut image, 0usize)
  }

  // A world read, as the message Sim takes: every part the reader kept from the first 'skip' on (the ones before were declared
  // early), each key taught its recipe
  fn imageOf(self: &mut, file: &str, image: &mut ImageWorld, skip: usize) WorldImage {
    showProblems(file, &image.problems);
    var parts = PartDecls();
    var pi = skip;
    while pi < image.parts.len() {
      let p = &image.parts[pi];
      core.learn(p.key, p.recipe.copy());
      core.learn(p.material, p.materialRecipe.copy());
      parts.push(PartDecl(p.path.clone(), p.key, p.material, noLook(), p.placement, p.slot));
      pi = pi + 1usize;
    }
    // the world's lights, camera and sky: parts with no mesh or material, after the shape parts (their ids are the shape
    // parts' before them), a look each
    each lp in &image.looks {
      parts.push(PartDecl(lp.path.clone(), NO_CONTENT, NO_CONTENT, lp.look, lp.placement, lp.slot));
    }
    print <- "loader: world "; printStr(file); print <- ": "; print <- u64.from(image.parts.len()); print <- " parts, ";
    print <- u64.from(distinctKeys(image)); print <- " distinct mesh keys, "; print <- u64.from(distinctMaterials(image));
    print <- " distinct material keys, "; print <- u64.from(image.problems.len());
    print <- " problems, "; print <- u64.from(image.dropped.len()); print <- " parts dropped";
    var k = 0usize;
    while k < image.dropped.len() {
      if k == 0usize { print <- ": "; } else { print <- ", "; }
      printStr(image.dropped[k].view());
      k = k + 1usize;
    }
    print <- "\n";
    print <- "loader: world "; printStr(file); print <- ": "; print <- u64.from(image.looks.len()); print <- " look parts (sun, lamps, camera, sky)\n";
    var units = SimUnits();
    units.push(String.from(file));
    var behaviour = Behaviour.none();
    behaviour <-> image.behaviour;
    WorldImage(image.name.clone(), parts, units, image.startFeet, behaviour)
  }

  // Sim -> Loader (event): part 'req.part' uses key 'req.key', a mesh key or a material key. A key already
  // built is shared at once (Render holds the mesh or the material, Sim the shapes); a new
  // one is queued; the burst is gathered, then built nearest first
  pub async fn build(self, req: ContentRequest) {
    let how = core.ask(&req);
    if how == ASK_QUEUED && !settling {
      settling = true;
      selfactor.settle();
    }
  }

  // The end of the gathering window: start the jobs
  pub async fn settle(self) {
    _ = await aio.sleep(Duration.fromMicros(SETTLE_US));
    settling = false;
    self.pump();
  }

  // Hand the nearest jobs to the idle workers
  fn pump(self: &mut) {
    var w = 0usize;
    while w < WORKERS {
      if !busy[w] {
        match core.next() {
          case let Some(job) {
            busy.set(w, true);
            // a part of a world still arriving: this worker's text may lack it, so it is opened with the newest first (the
            // worker takes its messages in order, so the job finds the builder made)
            let shape = job.recipe.shape.view();
            if (shape == MATERIAL_SHAPE || shape.startsWith("cs.")) && usize.from(job.recipe.slot) >= covers[w] && latestSlots > 0usize {
              workers[w].open(w, pendingWorld.clone(), String.from(latest.view()), String.from(cache.dir.view()), cache.stamp, false);
              covers.set(w, latestSlots);
            }
            selfactor.run(w, job);
          }
          case is None[BuildJob] { break; }
        }
      }
      w = w + 1usize;
    }
  }

  // One job on worker 'w': the products come back moved, and go on to Render and Sim
  pub async fn run(self, w: usize, job: BuildJob) {
    let key = job.key;
    let isMaterial = isMaterialRecipe(&job.recipe);
    let worker = workers[w].clone();
    var built = await worker.build(job);
    var products = plainProducts(Mesh(), Color(0.5, 0.5, 0.5, 1.), Vec3(0., 0., 0.));
    products <-> built.products;
    self.landed(w, key, isMaterial, built.outcome, products);
  }

  // The cache's side of a landed job: a hit is the newest entry; anything else the cache was asked about, that was built,
  // is written (the Loader is the only writer), and the folder is kept under its cap
  fn cached(self: &mut, key: ContentKey, isMaterial: bool, outcome: u32, p: &PartProducts) {
    if outcome == 0u32 || !cache.on() { return; }
    if outcome == LOAD_HIT {
      hits = hits + 1u64;
      cache.touch(key);
      cache.hold(key);
      return;
    }
    built = built + 1u64;
    if outcome == LOAD_CORRUPT {
      damaged = damaged + 1u64;
      print <- "loader: mesh cache entry "; printStr(cacheHex(key).view()); print <- " was damaged or unreadable: rebuilt\n";
    }
    if cache.store(key, if isMaterial { CACHE_MATERIAL } else { CACHE_MESH }, p) {
      cache.hold(key);
      if cache.stored % CACHE_EVICT_EVERY == 0u64 { _ = cache.evict(); }
    }
  }

  fn landed(self: &mut, w: usize, key: ContentKey, isMaterial: bool, outcome: u32, p: PartProducts) {
    busy.set(w, false);
    self.cached(key, isMaterial, outcome, &p);
    if core.done(key) == DONE_DELIVER {
      if isMaterial {
        // a material key gives Render the material; Sim has no use for it
        if !simOnly { render.material(materialContentOf(key, &p)); }
      } else {
        let shapes = shapesOf(key, &p);
        if !simOnly { render.content(meshContentOf(key, p)); }
        match &sim {
          case let Some(s) { s.shapes(shapes); }
          case is None[Sim] {}
        }
      }
    }
    self.pump();
    if !arrived && core.started == expectBuilds && core.inFlight() == 0usize && core.queued() == 0usize {
      // every key the world makes has landed: how long it took from the world's opening, and what the cache did
      arrived = true;
      print <- "loader: all "; print <- core.started; print <- " keys landed "; print <- (Instant.now() - opened).micros() / 1000i64;
      print <- " ms after the world was opened; mesh cache: "; print <- hits; print <- " hits, "; print <- built; print <- " built, ";
      print <- damaged; print <- " damaged\n";
    }
    if retire && !retired && core.started == expectBuilds && core.inFlight() == 0usize && core.queued() == 0usize {
      retired = true;
      self.letGoOfFirst();
    }
  }

  // The check's own exercise of `unused`: the first key's users leave
  fn letGoOfFirst(self: &mut) {
    let key = core.firstKey();
    let parts = core.usersOf(key);
    each p in &parts { selfactor.unused(key, *p); }
  }

  // Sim -> Loader (event): part 'part' no longer uses 'key'. At no users the
  // mesh may go from Render (and the entry from the catalog)
  pub async fn unused(self, key: ContentKey, part: PartId) {
    if core.unused(key, part) == UNUSED_FREED { render.release(key); }
  }

  pub async fn stop(self) {
    self.sim = None[Sim];
    _ = cache.evict();
    let ordered =core.startedNearestFirst();
    var wantFreed = 0u64;
    if retire { wantFreed = 1u64; }
    let ok = core.started == expectBuilds && core.freed == wantFreed && ordered && core.unknown == 0u64;
    print <- "loader: "; print <- core.started; print <- " keys built (want "; print <- expectBuilds; print <- "), ";
    print <- core.shared; print <- " asks shared a built key, "; print <- core.freed; print <- " freed, ";
    print <- core.discarded; print <- " discarded; jobs started nearest first: ";
    if ordered { print <- "yes"; } else { print <- "NO"; }
    if ok { print <- ": ok\n"; } else { print <- ": FAILED\n"; }
    var r = report.clone();
    r <- ok;
  }
}

// ---- The mock worlds ----

pub fn recipe(shape: &str, args: List[f32]) Recipe { Recipe(String.from(shape), args, 0u32, 0u32) }

pub fn args3(a: f32, b: f32, c: f32) List[f32] {
  var l = List[f32]();
  l.push(a); l.push(b); l.push(c);
  l
}

fn args1(a: f32) List[f32] {
  var l = List[f32]();
  l.push(a);
  l
}

// A part of a world: its name, what its mesh and its material are made from (taught to the catalog), and where it stands
fn declare(core: &mut LoaderCore, parts: &mut PartDecls, name: &str, r: Recipe, m: Recipe, at: Vec3) {
  let key = keyOf(&r);
  let material = materialKeyOf(&m);
  core.learn(key, r);
  core.learn(material, m);
  parts.push(PartDecl(String.from(name), key, material, noLook(), Mat4.fromTranslation(at), 0u32));
}

// The five shapes of the 40-part world, and the five colours they are painted
fn forty(kind: usize) Recipe {
  if kind == 0usize { return recipe("box", args3(0.5, 0.5, 0.5)); }
  if kind == 1usize { return recipe("box", args3(0.5, 1.5, 0.5)); }
  if kind == 2usize { return recipe("box", args3(0.8, 0.4, 0.8)); }
  if kind == 3usize { return recipe("box", args3(0.3, 1.0, 0.3)); }
  recipe("rounded", args1(0.6))
}

fn fortyPaint(kind: usize) Recipe {
  if kind == 0usize { return plainMaterialRecipe(0.8, 0.3, 0.2); }
  if kind == 1usize { return plainMaterialRecipe(0.25, 0.35, 0.8); }
  if kind == 2usize { return plainMaterialRecipe(0.3, 0.7, 0.4); }
  if kind == 3usize { return plainMaterialRecipe(0.9, 0.8, 0.2); }
  plainMaterialRecipe(0.7, 0.4, 0.8)
}

// The world named 'name': "parts40" is forty parts sharing five mesh keys and five material keys; any
// other name is the small mock (a ground plane and three boxes). Fills 'core'
// with each key's recipe, as the real world image's code will
pub fn mockWorld(name: String, core: &mut LoaderCore) WorldImage {
  var parts = PartDecls();
  if name.view() == "parts40" {
    var k = 0usize;
    while k < 40usize {
      let kind = k % 5usize;
      let r = forty(kind);
      let x = f32.from(k % 7usize) * 1.5 - 4.5;
      let z = 0. - (6. + f32.from(k) * 0.9);
      var label = String.from("part-");
      label.appendByte('0' + u8.from(k / 10usize));
      label.appendByte('0' + u8.from(k % 10usize));
      if k == 3usize { label = String.from("box-a"); }   // the headless run's press aims at box-a: dead ahead of the person
      declare(core, &mut parts, label.view(), r, fortyPaint(kind), Vec3(x, 0.5, z));
      k = k + 1usize;
    }
  } else {
    declare(core, &mut parts, "ground", recipe("ground", args1(40.)), plainMaterialRecipe(0.35, 0.55, 0.25), Vec3(0., 0., 0.));
    declare(core, &mut parts, "box-a", forty(0usize), fortyPaint(0usize), Vec3(0., 0.5, -8.));
    declare(core, &mut parts, "box-b", forty(1usize), fortyPaint(1usize), Vec3(-3., 1.5, -10.));
    declare(core, &mut parts, "box-c", recipe("rounded", args1(0.7)), plainMaterialRecipe(0.85, 0.75, 0.3), Vec3(3., 0.7, -9.));
  }
  var units = SimUnits();
  units.push(String.from("mock.zone"));
  WorldImage(name, parts, units, Vec3(0., 0., 0.), Behaviour.none())
}
