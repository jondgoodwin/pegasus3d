// The headset's log, as far as the shared code writes to it (W149b: moved from the browser's xrhands.cone, because Sim
// logs each press's pick and the server program has no such log).
//
// `xrLogStart` (the browser) makes pegasus-xr.log beside the executable empty and leaves its path in PEGASUS_XR_LOG; any
// actor's `xrLog` then adds a line to it. With no such variable `xrLog` does nothing, as in every run of the server.

pub const XR_LOG_VAR = "PEGASUS_XR_LOG";

// Add a line to the headset's log, when this run has one (`xrLogStart`); nothing otherwise
pub fn xrLog(line: &str) {
  match env.get(XR_LOG_VAR) {
    case let Some(p) {
      var text = String();
      text <- format.fixed(f64.from(Instant.now().nanos()) * 1.0e-9, 3), " ", line, "\n";
      match fs.appendFile(&Path.fromString(p), text.view()) { else {} }
    }
    case is None[String] {}
  }
}

// A point or direction as the log writes it: "(x, y, z)" in metres, to the millimetre
pub fn vecText(v: Vec3) String {
  var s = String();
  s <- "(", format.fixed(f64.from(v.x), 3), ", ", format.fixed(f64.from(v.y), 3), ", ", format.fixed(f64.from(v.z), 3), ")";
  s
}
