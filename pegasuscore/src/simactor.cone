// Sim: the zone's simulation. It holds the zone's parts and the shapes the
// Loader moved to it, steps at 60 Hz on its own clock, moves the person from
// Player's intents, and publishes an immutable snapshot after each step to
// Render and Audio, which never wait for it (`Browser\doc\actors\sim.md`,
// design choices, all proposed).
//
// One program, three roles: 'role' chooses which parts of the step run.
//   whole    local play: admit, move the person from its intents, react, publish.
//   server   (W117, plan step 8) a shared zone's truth: admit and apply each
//            client's input samples (netplay.cone), react, send the shared and
//            personal snapshots every other step; no Render or Audio.
//   client   predicts its own person from its intents, reconciles on the
//            server's acknowledgement, interpolates the others from the shared
//            snapshots, and publishes one merged snapshot.
// The wire and the cores are in netplay.cone; this file is the step.
//
// The step, in its order: admit (actions that arrived, stamped for this
// step), move (the person from its intents), sense (stub), react (the action
// queue, with the handler-budget seam), derive (stub), publish.
//
// Its behaviours (the messages of `messages.cone`):
//   world(image)      Loader -> Sim, move: the world image and its Sim units
//   shapes(s)         Loader -> Sim, move: collision and pick shapes for a key
//   act(action)       Player -> Sim, event: a pointer press (or any action)
//   run(...)          started once by Player: the step loop
//   stop()            the run ends after the step under way

pub const SIM_WHOLE = 0u32;         // local play: the truth, every rule
pub const SIM_SERVER = 1u32;        // a shared zone's truth
pub const SIM_CLIENT = 2u32;        // predicts its person, follows a server

const JOIN_WAIT_STEPS = 900u64;     // a client not in this many steps (15 s) after it started gives up
const EMPTY_STEPS = 30u64;          // a server with --until-empty ends this long after its last client left

pub const STEP_HZ = 60u64;
pub const STEP_NS = 16666667u64;    // 1 / 60 s
pub const WALK_SPEED: f32 = 1.4;    // m/s, a person's walk
const STEP_SECONDS: f32 = 0.016666668;
const MOST_STEPS_A_TURN = 4u32;     // behind by more than this many steps: the rest are dropped

pub fn simRoleName(role: u32) &str {
  if role == SIM_WHOLE { return "whole"; }
  if role == SIM_SERVER { return "server"; }
  "client"
}

// A part as Sim holds it
struct SimPart {
  id: PartId;
  name: String;
  key: ContentKey;                  // its mesh key
  material: ContentKey;             // its material key now (a field that sets the material changes this alone: `setMaterial`)
  definedMaterial: ContentKey;      // its material key as the world defined it (the definition's sum holds this one)
  look: PartLook;                   // its light, camera settings or sky now (a field that sets a light changes this alone: `setLook`)
  definedLook: PartLook;            // its look as the world defined it (the definition's sum holds this one)
  placement: Mat4;                 // where the image put it; once a rule moves it, `placeOf` is where it stands
  slot: u32;                        // its number in the world's frames (`rules.slots`)
  asked: bool;                      // its content was asked of the Loader
}
alias SimParts = List[SimPart];
alias ShapeTable = List[ContentShapes];
alias Actions = List[Action];

// Whether the dotted path 'name' ("board.pieces.whiteRook1.body") holds the whole segments of 'want' ("pieces.whiteRook1"):
// 'want' is the path, or its beginning, its end or a stretch of it
fn pathHas(name: &str, want: &str) bool {
  if want.len() > name.len() { return false; }
  var i = 0usize;
  while i + want.len() <= name.len() {
    var same = true;
    var k = 0usize;
    while k < want.len() && same {
      if name[i + k] != want[k] { same = false; }
      k = k + 1usize;
    }
    let startsSegment = i == 0usize || name[i - 1usize] == '.';
    let endsSegment = i + want.len() == name.len() || name[i + want.len()] == '.';
    if same && startsSegment && endsSegment { return true; }
    i = i + 1usize;
  }
  false
}

// A press the Player aimed at a named part: from this eye, at the part's middle, once the part's shape is known
struct AimedPress {
  name: String;
  eye: Vec3;
  atNs: u64;
}
alias AimedPresses = List[AimedPress];

// A glide Sim started: the piece, and where it is to end (in the world, level), for the run's check
struct Landing {
  piece: u32;
  goal: Vec3;
}
alias Landings = List[Landing];

// What Player hands Sim when it starts it: the readers of Player's and
// Render's latest values, and how long to run
pub struct SimStart {
  pub moves: StateReader[MoveIntent];
  pub looks: StateReader[LookIntent];
  pub drawn: StateReader[DrawnFrame];
  pub steps: u64;                   // 0: until stopped
  pub stallAtStep: u64;             // a check: at this step, busy for 'stallMs' (0: never)
  pub stallMs: u64;
  pub finished: Sender[i32];        // told the run's verdict when 'steps' are done
  pub net: NetStart;                // the role, and what a server or a client needs of the network
}

pub actor Sim {
  role: u32;
  render: RenderSink;
  audio: AudioSink;
  loader: Loader;
  io: SimStart;                     // the latest values it reads, how long to run, whom to tell
  parts: SimParts;
  heldShapes: ShapeTable;
  arrived: Actions;                 // actions sent since the last admit
  aimed: AimedPresses;              // presses aimed at a named part (`--press-part`), until its shape is known
  queue: Actions;                   // this step's admitted actions, for react
  reacted: Actions;                 // the actions react ran, for the run's checks
  rules: SimRules;                  // the world's rules, their units and the frames a rule moves (simrules.cone)
  landings: Landings;               // the glides rules started, for the run's check
  person: PersonState;
  worldName: String;
  step: u64;
  running: bool;
  walkSteps: u64;                   // steps that moved the person forward
  walked: f32;                      // how far those steps moved it
  lateSteps: u64;                   // steps dropped because the loop fell behind
  mutateAfterPublish: bool;         // the snapshot check's mutant (PEGASUS_MUTANT=mutate-snapshot)
  lastPublished: Option[Published];
  net: NetState;                    // connected play (netplay.cone): the server's rows, the client's link, predictor and interpolator
  haveImage: bool;                  // the Loader's world image arrived
  declaredFromServer: bool;         // a client: the server's declarations were taken
  idleSteps: u64;                   // a client: steps waited to join
  startedNs: i64;
  zoneKeys: usize;                  // a server: the distinct keys of its parts
  finishedSent: bool;
  avatarKey: ContentKey;            // a client: the design other people are drawn as (`avatarDesign`)
  hasAvatar: bool;
  declaredAvatar: bool;             // a client: that design is the world's own, not the browser's figure
  resyncAsked: bool;                // a client: a full snapshot was asked for and no snapshot has matched since
  hashChecked: u64;                 // a client: shared snapshots whose part-state hash it compared with its own
  hashMismatched: u64;              // ... and the ones that differed
  shown: List[Mat4];                // a client: where each part is shown now, by id (its picks run against these)
  wasGliding: bool;                 // a server: a glide was under way last step
  landedNs: i64;                    // a server: when its last glide ended (steady clock)
  movedFirstNs: i64;                // a client: when it first showed a part displaced from where it showed it before
  movedLastNs: i64;                 // ... and the last time it did
  avatarMaterial: ContentKey;       // a client: the material key of that design
  materialChanges: u64;             // material keys a part changed to (`setMaterial`)
  lookChanges: u64;                 // looks a part changed to (`setLook`)
  poseHistory: PoseHistory;         // each part's place at the last POSE_STEPS steps, for picking at a press's drawn time
  held: PartDecls;                  // a shared zone's or a client's parts declared before the whole world is in: kept for `world`, which takes them first

  pub fn init(self: &new, role: u32, render: RenderSink, audio: AudioSink, loader: Loader, start: SimStart, mutant: bool) {
    *self = Self(role, render, audio, loader, start, SimParts(), ShapeTable(),
      Actions(), AimedPresses(), Actions(), Actions(), SimRules.none(), Landings(), PersonState(Vec3(0., 0., 0.), 0.), String(), 0u64, false, 0u64, 0., 0u64, mutant, None[Published],
      NetState.make(mutantIs("no-replay"), mutantIs("stale-personal"), mutantIs("stale-shared")), false, false, 0u64, 0i64, 0usize, false, 0u64, false, false, false, 0u64, 0u64, List[Mat4](), false, 0i64, 0i64, 0i64, 0u64, 0u64, 0u64, PoseHistory.make(), PartDecls());
  }

  // Loader -> Sim (move): the next parts of the world, declared before the whole world is in (the Loader read the files that have
  // arrived: the parts of a run of files from the start, in the order the whole world will give them). Local play declares them
  // now, each given its id and its content asked for by nearness to 'feet' (where the person is known to start, so far). A server
  // or a client keeps them for `world`: what it makes of the parts (what the clients are shown, or what the person is shown and
  // joined to) is made once, from the whole. Rules, derives and every look wait for `world`: a rule may name any part by its path
  pub async fn declare(self, decls: PartDecls, feet: Vec3) {
    if role != SIM_WHOLE {
      each d in &decls { held.push(PartDecl(d.name.clone(), d.key, d.material, d.look, d.placement, d.slot)); }
      return;
    }
    self.declareParts(&decls, feet);
  }

  // Give each part its id now, before its content exists, and ask the Loader for its content, the nearer to 'feet' the sooner
  fn declareParts(self: &mut, decls: &PartDecls, feet: Vec3) {
    each d in &*decls {
      let id = u32.from(parts.len());
      parts.push(SimPart(id, d.name.clone(), d.key, d.material, d.material, d.look, d.look, d.placement, d.slot, true));
      // a light, a camera or the sky has no content to ask for: its look is all it is
      if d.key == NO_CONTENT { continue; }
      let at = d.placement.translation();
      loader.build(ContentRequest(d.key, id, (at - feet).length()));
      // a server never draws: its Loader builds the shapes Sim needs and no material
      if role != SIM_SERVER { loader.build(ContentRequest(d.material, id, (at - feet).length())); }
    }
  }

  // Loader -> Sim (move): the world image. Each part is given its id now,
  // before its content exists, and its content is asked for by key
  pub async fn world(self, image: WorldImage) {
    var img = image;
    if held.len() > 0usize {
      // a server's or a client's earlier parts come first, as the whole world gives them
      var all = PartDecls();
      all <-> held;
      each d in &img.parts { all.push(PartDecl(d.name.clone(), d.key, d.material, d.look, d.placement, d.slot)); }
      img.parts <-> all;
    }
    worldName = img.name.clone();
    person.feet = img.startFeet;
    haveImage = true;
    var behaviour = Behaviour.none();
    behaviour <-> img.behaviour;
    if role == SIM_CLIENT {
      // A client builds the world from its own copy of the description, as any world arrives: nothing is declared over
      // the wire. It runs no rules, so the world's rules are not made, only read for the avatar it declares
      avatarKey, avatarMaterial = avatarDesign(&behaviour, &img.parts);
      hasAvatar = true;
      declaredAvatar = behaviour.avatar != NO_AVATAR && avatarKey != browserAvatarKey();
      // the browser's own figure is no part of the world, so nothing else asks the Loader for it
      if !declaredAvatar {
        loader.build(ContentRequest(avatarKey, NO_PART, 0.));
        loader.build(ContentRequest(avatarMaterial, NO_PART, 0.));
      }
    } else {
      rules = SimRules.make(behaviour, false);
      if mutantIs("anim-never") { rules.anim.mutant = ANIM_MUTANT_NEVER; }
      if mutantIs("anim-twice") { rules.anim.mutant = ANIM_MUTANT_TWICE; }
      let tr = libc.getenv("PEGASUS_TRACE_PART");
      if (tr as usize) != 0usize { rules.traceFor(tr); }
    }
    self.declareParts(&img.parts, person.feet);
    var keys = List[ContentKey]();
    each p in &parts {
      if p.key != NO_CONTENT && !keys.contains(&p.key) { keys.push(p.key); }
    }
    zoneKeys = keys.len();
    if role == SIM_SERVER {
      var defined = List[Mat4]();
      var definedMat = List[ContentKey]();
      var definedLook = List[PartLook]();
      each p in &parts { defined.push(self.placeOf(p)); definedMat.push(p.material); definedLook.push(p.look); }
      net.tracker = PartTracker.make(&defined, &definedMat, &definedLook, mutantIs("delta-vs-sent"));
    }
    if role == SIM_CLIENT {
      net.view = PartView.make(parts.len());
      print <- "sim: world "; printStr(worldName.view()); print <- ", "; print <- u64.from(parts.len());
      print <- " parts from its own copy of the description; other people are drawn as ";
      if declaredAvatar { print <- "the avatar design the world declares\n"; } else { print <- "the browser's own figure (the world declares no avatars)\n"; }
      self.maybeHello();
      return;
    }
    print <- "sim: world "; printStr(worldName.view()); print <- ", "; print <- u64.from(parts.len());
    print <- " parts, "; print <- u64.from(img.units.len()); print <- " world file(s), "; print <- u64.from(rules.moveCount());
    print <- " pick-and-place rules, "; print <- u64.from(rules.keysRuleCount());
    print <- " keys rules, rules "; print <- if rules.live() { "verified" } else { "none" }; print <- "\n";
  }

  // Loader -> Sim (move): the shapes of a key
  pub async fn shapes(self, s: ContentShapes) {
    // A client never rebuilds shapes: the server's are the truth (procgen is not bit-identical across machines)
    if role == SIM_CLIENT { return; }
    heldShapes.push(s);
  }

  // Player -> Sim (event): an action, admitted at the next step
  pub async fn act(self, a: Action) {
    arrived.push(a);
  }

  // Player -> Sim (event): a press along the ray from 'eye' to the middle of the part named 'part' (`--press-part`); the
  // ray is then an ordinary press, so picking decides what it reaches
  pub async fn actAtPart(self, part: String, eye: Vec3, atNs: u64) {
    aimed.push(AimedPress(part, eye, atNs));
  }

  pub async fn stop(self) {
    running = false;
  }

  // The step loop: a step every STEP_NS on the steady clock, catching up by
  // whole steps when late. Other messages are taken at each await.
  pub async fn run(self) {
    running = true;
    print <- "sim: role "; printStr(simRoleName(role)); print <- ", "; print <- STEP_HZ; print <- " Hz\n";
    self.openNet();
    var next = Instant.now().nanos() + i64.from(STEP_NS);
    while running {
      _ = await aio.sleepUntil(Instant.fromNanos(next));
      var taken = 0u32;
      while running && Instant.now().nanos() >= next {
        if taken < MOST_STEPS_A_TURN {
          self.stepOnce(u64.from(next));
          taken = taken + 1u32;
        } else {
          lateSteps = lateSteps + 1u64;
        }
        next = next + i64.from(STEP_NS);
      }
    }
    self.leaveNet();
    _ = await aio.sleep(Duration.fromMillis(150i64));   // the goodbye leaves before the socket does
    self.closeNet();
    render.stop();
    audio.stop();
    loader.stop();
  }

  fn stepOnce(self: &mut, atNs: u64) {
    if role == SIM_CLIENT && !self.clientReady() { return; }   // before it is in, a client's steps are not counted
    step = step + 1u64;
    if role == SIM_SERVER { self.serveJoins(); }
    if aimed.len() > 0usize { self.aimPresses(); }
    if role == SIM_CLIENT { self.admitClient(); } else { self.admit(); }
    if role == SIM_CLIENT { self.moveClient(); self.mergeParts(); }
    else if role == SIM_SERVER { self.moveServer(); }
    else { self.move(); }
    if role != SIM_CLIENT { rules.animate(step, STEP_NS); }   // move: the animators (a client's parts are the server's)
    if role != SIM_CLIENT { rules.stepAll(step, STEP_NS); }   // move: the step functions (W148, for review)
    if role != SIM_CLIENT { self.testLightChange(); }
    self.sense();
    self.react();
    self.derive();
    if role == SIM_SERVER { self.sendSnapshots(); self.hangUps(); }
    self.remember(atNs);
    self.publish(atNs);
    if step % STEP_HZ == 0u64 { self.printLine(); }
    if io.stallAtStep != 0u64 && step == io.stallAtStep { busyFor(io.stallMs); }
    if io.steps != 0u64 && step == io.steps { self.endRun(); }
    if role == SIM_SERVER && io.net.untilEmpty && net.everJoined && net.clients.len() == 0usize && step >= net.emptySince + EMPTY_STEPS {
      self.endRun();
    }
    if role == SIM_CLIENT && net.phase == PHASE_GONE && !finishedSent {
      print <- "sim: the server's connection ended\n";
      self.endRun();
    }
  }

  // The run is over: its checks, printed, and the verdict told once
  fn endRun(self: &mut) {
    running = false;
    if finishedSent { return; }
    finishedSent = true;
    rules.profileReport(step);
    rules.stepReport();
    self.printLights();
    let verdict = self.checks();
    var f = io.finished.clone();
    f <- verdict;
  }

  // The world's light as this Sim holds it (the sun's lux, the lamps, the camera): a client's is what the server's deltas said,
  // and a run that changes a light prints both ends to be read against each other
  fn printLights(self: &) {
    var sun = false;
    var lux: f32 = 0.;
    var lamps = 0usize;
    var first: f32 = 0.;
    var exposure: f32 = 0.;
    var camera = false;
    each p in &parts {
      if p.look.kind == LOOK_SUN { sun = true; lux = p.look.amount; }
      if p.look.kind == LOOK_POINT || p.look.kind == LOOK_SPOT { if lamps == 0usize { first = p.look.amount; } lamps = lamps + 1usize; }
      if p.look.kind == LOOK_CAMERA { camera = true; exposure = p.look.exposure; }
    }
    print <- "sim: light: sun "; print <- sun; print <- " lux "; printF(lux); print <- ", "; print <- u64.from(lamps); print <- " lamps (first ";
    printF(first); print <- " cd), camera "; print <- camera; print <- " exposure "; printF(exposure); print <- ", "; print <- lookChanges;
    print <- " look changes\n";
  }

  // A test aid: PEGASUS_LIGHT_CHANGE=STEP:NAME:AMOUNT sets the amount (lux or candela) of the light part whose path holds NAME at
  // that step, on a server or a whole run: what a rule that turns a lamp on at dusk would do (`setLook`)
  fn testLightChange(self: &mut) {
    let e = libc.getenv("PEGASUS_LIGHT_CHANGE");
    if (e as usize) == 0usize { return; }
    if argNumber(e) != step { return; }
    var i = 0usize;
    while *(e + i) != ':' && *(e + i) != 0u8 { i = i + 1usize; }
    if *(e + i) == ':' { i = i + 1usize; }
    var name = String();
    while *(e + i) != ':' && *(e + i) != 0u8 { name.appendByte(*(e + i)); i = i + 1usize; }
    if *(e + i) == ':' { i = i + 1usize; }
    let amount = f32.from(argNumber(e + i));
    var found = parts.len();
    each p in &parts {
      if found == parts.len() && p.look.kind != LOOK_NONE && pathHas(p.name.view(), name.view()) { found = usize.from(p.id); }
    }
    if found == parts.len() { print <- "sim: light change: no light part named "; printStr(name.view()); print <- "\n"; return; }
    var look = parts[found].look;
    look.amount = amount;
    self.setLook(found, look);
    print <- "sim: step "; print <- step; print <- ": light "; printStr(parts[found].name.view()); print <- " set to "; printF(amount); print <- "\n";
  }

  // The presses aimed at a named part whose shape is known become presses along the ray from the eye to the part's
  // middle, now; one for a name no part has is reported and dropped (once the world's parts are all here)
  fn aimPresses(self: &mut) {
    var waiting = AimedPresses();
    each q in &aimed {
      var found = false;
      var ready = false;
      var middle = Vec3(0., 0., 0.);
      each p in &parts {
        if !ready && pathHas(p.name.view(), q.name.view()) {
          found = true;
          each s in &heldShapes {
            if s.key == p.key { ready = true; middle = self.placeOf(p).transformPoint(s.pick.centre); }
          }
        }
      }
      if ready {
        let along = (middle - q.eye).normalize();
        arrived.push(Action(VERB_PRESS, NO_PART, q.eye, along, q.atNs, ORIGIN_PERSON));
      } else if found || !haveImage {
        waiting.push(AimedPress(q.name.clone(), q.eye, q.atNs));
      } else {
        print <- "sim: press-part: no part named "; printStr(q.name.view()); print <- "\n";
      }
    }
    aimed = waiting;
  }

  // Admit: the actions that arrived, in the order they came, stamped for
  // this step. A pointer press is given its receiver by picking along its ray
  fn admit(self: &mut) {
    var got = Actions();
    got <-> arrived;
    each a in &got {
      var b = *a;
      if b.verb == VERB_PRESS && b.receiver == NO_PART { b.receiver = self.pick(b.from, b.along, b.madeNs); }
      queue.push(b);
    }
    got.clear();
    got <-> arrived;                // the list's block is kept for the next step
  }

  // Move: the person from its intents (the body faces the look's yaw)
  fn move(self: &mut) {
    let m = io.moves.newest();
    let look = io.looks.newest();
    person.yaw = look.yaw;
    let d = walkDelta(look.yaw, m.forward, m.strafe);   // the body rule the server runs too (netplay.cone)
    person.feet = person.feet + d;
    if m.forward > 0.5 {
      walkSteps = walkSteps + 1u64;
      walked = walked + d.length();
    }
  }

  // ---- Connected play: the network ----

  // The endpoint of a server (listening, with a lossy relay in front if asked) or of a client (dialling)
  fn openNet(self: &mut) {
    if role == SIM_WHOLE { return; }
    let me = selfactor;
    let handler = eventHandler(Uni[fn(ev: NetEvent) + Sendable](fn(ev: NetEvent) [me] { me.onNet(ev); }));
    if role == SIM_SERVER {
      let bindTo = if io.net.loopback { SocketAddr.localhost(u16.from(io.net.port)) } else { SocketAddr.v4(0u8, 0u8, 0u8, 0u8, u16.from(io.net.port)) };
      let bound = mustListen(bindTo, NetConfig.defaults(), handler);
      net.port = u32.from(bound.port);
      print <- "Serving on UDP port "; print <- net.port; print <- "\n";
      if io.net.impairLoss > 0u32 || io.net.impairLatency > 0u32 || io.net.impairJitter > 0u32 {
        let link = LinkConfig.lossy(io.net.impairLoss, i64.from(io.net.impairLatency), i64.from(io.net.impairJitter));
        var relay = startLossyRelay(SocketAddr.localhost(bound.port), link, link, 1u64);
        net.relayPort = u32.from(relay.port);
        print <- "Relay: port "; print <- net.relayPort; print <- " ("; print <- io.net.impairLoss; print <- " per 1000 lost, ";
        print <- io.net.impairLatency; print <- " ms and up to "; print <- io.net.impairJitter; print <- " more each way)\n";
        net.relay = Some[LossyRelay](relay);
      }
      net.endpoint = Some[Endpoint](bound.endpoint);
      print.flush();
    } else {
      let bound = mustConnect(parseAddress(io.net.address.view()), NetConfig.defaults(), handler);
      net.endpoint = Some[Endpoint](bound.endpoint);
    }
  }

  // The run is over: a client tells the server it is leaving (its connection closes)
  fn leaveNet(self: &mut) {
    if role == SIM_CLIENT {
      match &mut net.link {
        case var &mut Some(c) { c.close(); }
        else {}
      }
    }
  }

  fn closeNet(self: &mut) {
    match &mut net.relay {
      case var &mut Some(r) { r.stop(); }
      else {}
    }
    match &net.endpoint {
      case let Some(e) { e.shutdown(); }
      else {}
    }
  }

  // netmsg -> Sim (event): a connection joined or left, a message came, a stream's newest value came
  pub async fn onNet(self, ev: NetEvent) {
    if role == SIM_SERVER { self.serverEvent(ev); }
    else if role == SIM_CLIENT { self.clientEvent(ev); }
  }

  // ---- Connected play: the server ----

  fn serverEvent(self: &mut, event: NetEvent) {
    var ev = event;
    match ev {
      case let Joined(j) {
        if net.row(j.id) == NO_ROW { net.clients.push(ClientRow.make(j.id, j.conn)); }
        print <- "sim: connection "; print <- j.id; print <- " opened\n";
      }
      case let Left(l) {
        let k = net.row(l.id);
        if k != NO_ROW {
          self.printRow(k, "left");
          net.clients.remove(k);
          net.leaves = net.leaves + 1u64;
          if net.clients.len() == 0usize { net.emptySince = step; }
        }
      }
      case var Message(m) {
        let data = m.data;
        self.serverMessage(m.id, data);
      }
      case var Update(u) {
        let data = u.data;
        self.serverUpdate(u.id, u.stream, data);
      }
      else {}
    }
  }

  fn serverMessage(self: &mut, id: u32, data: Bytes) {
    let k = net.row(id);
    if k == NO_ROW { return; }
    let says = decodeClientSays(data);
    if says.tag == 0u32 { net.malformed = net.malformed + 1u64; return; }
    if says.tag == C_HELLO {
      if net.clients[k].helloed { net.malformed = net.malformed + 1u64; return; }
      if says.version != NET_VERSION { self.refuse(k, "the wire version differs"); return; }
      // (the world's name is checked once the zone is loaded: serveJoins)
      net.clients[k].world = says.world.clone();
      net.clients[k].helloed = true;
    } else if says.tag == C_PRESS {
      if !net.clients[k].declared { net.malformed = net.malformed + 1u64; return; }
      var a = says.action;
      if a.receiver != NO_PART && usize.from(a.receiver) >= parts.len() { a.receiver = NO_PART; }
      arrived.push(a);
      net.clients[k].presses = net.clients[k].presses + 1u64;
    } else if says.tag == C_RESYNC {
      if !net.clients[k].declared { net.malformed = net.malformed + 1u64; return; }
      // its part states hashed differently from the server's: forget what it acknowledged, send everything changed
      net.clients[k].resync = true;
      net.clients[k].partsAck = 0u64;
      net.clients[k].resyncs = net.clients[k].resyncs + 1u64;
      print <- "net server: person "; print <- net.clients[k].id; print <- " asked for a full snapshot: its part states hashed differently\n";
    }
  }

  fn serverUpdate(self: &mut, id: u32, stream: u16, data: Bytes) {
    let k = net.row(id);
    if k == NO_ROW || u32.from(stream) != STREAM_INPUT || !net.clients[k].declared { return; }
    var got = BodySamples();
    var ack = 0u64;
    if !decodeInput(data, &mut got, &mut ack) { net.malformed = net.malformed + 1u64; return; }
    net.clients[k].take(&got);
    if ack > net.clients[k].partsAck { net.clients[k].partsAck = ack; }
  }

  fn refuse(self: &mut, k: usize, why: &str) {
    let r = &mut net.clients[k];
    sendReliable(&mut r.conn, &encodeRefused(why));
    r.hangUpAt = step + 30u64;
    net.refusals = net.refusals + 1u64;
    print <- "sim: connection "; print <- r.id; print <- " refused: "; printStr(why); print <- "\n";
  }

  // The clients that said Hello are let in once the zone is ready: its shapes
  // are all built. The declarations go as bulk (reliable, in order)
  fn serveJoins(self: &mut) {
    if !haveImage || heldShapes.len() < zoneKeys { return; }
    var i = 0usize;
    while i < net.clients.len() {
      if net.clients[i].helloed && !net.clients[i].declared && net.clients[i].hangUpAt == 0u64 {
        var live = 0usize;
        each q in &net.clients { if q.declared { live = live + 1usize; } }
        if net.clients[i].world.view() != worldName.view() { self.refuse(i, "this server runs another world"); }
        else if live >= MOST_PEOPLE { self.refuse(i, "the zone is full"); }
        else { self.admitPerson(i); }
      }
      i = i + 1usize;
    }
  }

  // Row 'i' is let in: its welcome, the declarations as bulk, and Joined
  fn admitPerson(self: &mut, i: usize) {
    let r = &mut net.clients[i];
    r.person = PersonState(person.feet, 0.);
    sendReliable(&mut r.conn, &encodeWelcome(r.id, worldName.view(), person.feet, parts.len(), definitionSum(&parts), heldShapes.len()));
    var sh = encodeShapes(&heldShapes);
    each m in &sh { sendReliable(&mut r.conn, m); }
    sendReliable(&mut r.conn, &encodeJoined());
    r.declared = true;
    net.joins = net.joins + 1u64;
    net.everJoined = true;
    print <- "sim: person "; print <- r.id; print <- " joined at step "; print <- step; print <- ": "; print <- u64.from(sh.len() + 2usize);
    print <- " declaration messages\n";
  }

  // Move, on the server: every client's body, from the samples it sent
  fn moveServer(self: &mut) {
    let now = Instant.now().nanos();
    each r in &mut net.clients { if r.declared { r.applyAll(now); } }
  }

  // The shared part, once, to everyone; each client's personal part (every
  // SNAPSHOT_EVERY steps: 30 a second)
  fn sendSnapshots(self: &mut) {
    if step % SNAPSHOT_EVERY != 0u64 || net.clients.len() == 0usize { return; }
    let people = personsOf(&net.clients);
    let head = encodePeople(step, &people);        // the people half is the same for all, encoded once
    var first = true;
    each r in &mut net.clients {
      if r.declared {
        // the parts half is this client's: what changed after the last change it acknowledged
        var deltas = PartDeltas();
        let fresh = r.resync;
        r.resync = false;
        let through = net.tracker.select(r.partsAck, partRoom(people.len()), fresh, &mut deltas);
        // the hash of every part's state once this snapshot is applied; only when the snapshot completes the client's picture
        var hash = 0u64;
        if through == net.tracker.version { hash = statesHash(&net.tracker.states(), &net.tracker.materials(), &net.tracker.looks()); }
        var full = List[u8]();
        full.appendSlice(head.view());
        full.appendList(encodePartTail(through, &deltas, hash));
        let shared = bytesOfList(&full);
        net.sharedBytes = net.sharedBytes + u64.from(shared.len());
        net.partEntries = net.partEntries + u64.from(deltas.len());
        r.lastShared = shared.len();
        if shared.len() > net.largestShared { net.largestShared = shared.len(); }
        if first && shared.len() != net.sizeShown {
          net.sizeShown = shared.len();
          print <- "net server: step "; print <- step; print <- ": shared snapshot to person "; print <- r.id; print <- " is "; print <- u64.from(shared.len());
          print <- " bytes ("; print <- u64.from(deltas.len()); print <- " changed parts, acknowledged through version "; print <- r.partsAck; print <- ")\n";
        }
        first = false;
        sendLatest(&mut r.conn, STREAM_SHARED, shared);
        net.sharedSent = net.sharedSent + 1u64;
        let personal = bytesOfList(&encodePersonal(step, r));
        if personal.len() > net.largestPersonal { net.largestPersonal = personal.len(); }
        sendLatest(&mut r.conn, STREAM_PERSONAL, personal);
        net.personalSent = net.personalSent + 1u64;
      }
    }
  }

  fn hangUps(self: &mut) {
    each r in &mut net.clients {
      if r.hangUpAt != 0u64 && step >= r.hangUpAt { r.hangUpAt = 0u64; r.conn.close(); }
    }
  }

  fn printRow(self: &, k: usize, when: &str) {
    let r = &net.clients[k];
    print <- "net server: person "; print <- r.id; print <- " "; printStr(when); print <- ": applied "; print <- r.applied;
    print <- " samples (last "; print <- r.lastApplied; print <- ", "; print <- r.gaps; print <- " never arrived), feet (";
    printF(r.person.feet.x); print <- ", "; printF(r.person.feet.y); print <- ", "; printF(r.person.feet.z); print <- "), ";
    print <- r.presses; print <- " presses, first moved at ns "; print <- r.firstMoveNs; print <- "\n";
  }

  // ---- Connected play: the client ----

  fn clientEvent(self: &mut, event: NetEvent) {
    var ev = event;
    match ev {
      case let Joined(j) {
        net.link = Some[Connection](j.conn);
        self.maybeHello();
      }
      case let Left(l) {
        if net.phase != PHASE_REFUSED { net.phase = PHASE_GONE; }
        print <- "sim: the connection ended\n";
      }
      case var Message(m) {
        let data = m.data;
        self.clientMessage(data);
      }
      case var Update(u) {
        let data = u.data;
        self.clientUpdate(u.stream, data);
      }
      else {}
    }
  }

  // Hello goes once the connection is open and the Loader's image has named the world
  fn maybeHello(self: &mut) {
    if role != SIM_CLIENT || net.phase != PHASE_DIALLING || !haveImage { return; }
    var sent = false;
    match &mut net.link {
      case var &mut Some(c) { sendReliable(c, &encodeHello(worldName.view())); sent = true; }
      else {}
    }
    if sent { net.phase = PHASE_ASKED; }
  }

  fn clientMessage(self: &mut, data: Bytes) {
    let says = decodeServerSays(data);
    if says.tag == 0u32 { net.malformed = net.malformed + 1u64; return; }
    if says.tag == S_REFUSED {
      net.refusedWhy = says.why.clone();
      net.phase = PHASE_REFUSED;
      print <- "REFUSED by the server: "; printStr(says.why.view()); print <- "\n";
    } else if says.tag == S_WELCOME {
      if says.version != NET_VERSION {
        net.phase = PHASE_REFUSED;
        net.refusedWhy = String.from("the wire version differs");
        print <- "sim: the server's wire version differs\n";
        return;
      }
      net.myId = says.yourId;
      net.worldName = says.world.clone();
      net.startFeet = says.feet;
      net.wantParts = says.parts;
      net.wantSum = says.sum;
      net.wantKeys = says.keys;
      net.welcomed = true;
    } else if says.tag == S_SHAPES {
      each s in &says.shapes { net.shapesGot.push(*s); }
    } else if says.tag == S_JOINED {
      if u32.from(net.shapesGot.len()) == net.wantKeys {
        net.joinedMsg = true;
      } else {
        net.malformed = net.malformed + 1u64;
        print <- "sim: the declarations were incomplete\n";
      }
    }
  }

  fn clientUpdate(self: &mut, stream: u16, data: Bytes) {
    if u32.from(stream) == STREAM_SHARED {
      var s = 0u64;
      var all = OtherPersons();
      var through = 0u64;
      var deltas = PartDeltas();
      var hash = 0u64;
      if !decodeShared(data, &mut s, &mut all, &mut through, &mut deltas, &mut hash) { net.malformed = net.malformed + 1u64; return; }
      var others = OtherPersons();
      each p in &all { if p.id != net.myId { others.push(*p); } }
      // an older snapshot than one held is dropped whole: its parts too, and its acknowledgement is never given
      if net.interp.add(s, Instant.now().nanos(), others) {
        net.view.apply(s, through, &deltas);
        if deltas.len() > 0usize { net.partsGot = net.partsGot + 1u64; }
        self.takeMaterialsFromView();
        self.takeLooksFromView();
        if hash != 0u64 { self.checkHash(s, hash); }
      }
      net.sharedGot = net.sharedGot + 1u64;
    } else if u32.from(stream) == STREAM_PERSONAL {
      var p = PersonalSnap(0u64, 0u32, Vec3(0., 0., 0.), 0.);
      if !decodePersonal(data, &mut p) { net.malformed = net.malformed + 1u64; return; }
      net.personal = Some[PersonalSnap](p);
      net.personalGot = net.personalGot + 1u64;
    }
  }

  // The shared snapshot of step 'step' said the parts stand so that their states hash to 'theirs'. This client's own
  // states, with that snapshot applied, should hash the same: acknowledged deltas never miss a change. If they differ
  // that is a defect made visible: report it and ask for a full snapshot, a fresh baseline
  fn checkHash(self: &mut, step: u64, theirs: u64) {
    var defined = List[Mat4]();
    var definedMat = List[ContentKey]();
    var definedLook = List[PartLook]();
    each p in &parts { defined.push(p.placement); definedMat.push(p.definedMaterial); definedLook.push(p.definedLook); }
    let mine = statesHash(&net.view.states(&defined), &net.view.materials(&definedMat), &net.view.looks(&definedLook));
    hashChecked = hashChecked + 1u64;
    if mine == theirs {
      if resyncAsked {
        resyncAsked = false;
        print <- "net client: person "; print <- net.myId; print <- ": the part states match the server's again at step "; print <- step; print <- "\n";
      }
      return;
    }
    hashMismatched = hashMismatched + 1u64;
    if !resyncAsked || hashMismatched % 30u64 == 0u64 {
      resyncAsked = true;
      print <- "net client: person "; print <- net.myId; print <- ": MISMATCH at step "; print <- step; print <- ": my part states hash to ";
      print <- mine; print <- ", the server's to "; print <- theirs; print <- "; asking for a full snapshot\n";
      net.view.ack = 0u64;
      match &mut net.link {
        case var &mut Some(c) { sendReliable(c, &encodeResync()); }
        else {}
      }
    }
  }

  // Whether the client is in and its steps may run. Once the server has said Joined and the Loader has
  // named the world, the parts are declared at once and their content asked of the Loader, nearest first
  fn clientReady(self: &mut) bool {
    if declaredFromServer { return true; }
    if net.joinedMsg && haveImage {
      // the server's definition must be the one this client built from: the same parts, by count and by their keys
      if u32.from(parts.len()) != net.wantParts || definitionSum(&parts) != net.wantSum {
        net.phase = PHASE_REFUSED;
        net.refusedWhy = String.from("the world's description differs from the server's");
        print <- "sim: the world's description differs from the server's ("; print <- u64.from(parts.len()); print <- " parts here, ";
        print <- u64.from(net.wantParts); print <- " there)\n";
        self.endRun();
        return false;
      }
      person.feet = net.startFeet;
      var gotShapes = ShapeTable();
      gotShapes <-> net.shapesGot;
      each s in &gotShapes { heldShapes.push(*s); }
      net.predictor = Predictor.make(net.startFeet, mutantIs("no-replay"), mutantIs("stale-personal"));
      net.phase = PHASE_JOINED;
      declaredFromServer = true;
      print <- "sim: joined as person "; print <- net.myId; print <- ": "; print <- u64.from(parts.len()); print <- " parts from its own copy of the world and ";
      print <- u64.from(heldShapes.len()); print <- " shapes from the server\n";
      return true;
    }
    idleSteps = idleSteps + 1u64;
    if net.phase == PHASE_REFUSED || net.phase == PHASE_GONE || idleSteps > JOIN_WAIT_STEPS {
      print <- "sim: not joined after "; print <- idleSteps; print <- " steps\n";
      self.endRun();
    }
    false
  }

  // Admit, on a client: a press is resolved against the pick shapes the server sent (where things were in the frame
  // the person saw) and forwarded as an event; nothing joins the local queue
  fn admitClient(self: &mut) {
    var got = Actions();
    got <-> arrived;
    each a in &got {
      var b = *a;
      if b.verb == VERB_PRESS && b.receiver == NO_PART { b.receiver = self.pick(b.from, b.along, b.madeNs); }
      match &mut net.link {
        case var &mut Some(c) { sendReliable(c, &encodePress(&b)); }
        else {}
      }
      net.pressesSent = net.pressesSent + 1u64;
    }
    got.clear();
    got <-> arrived;
  }

  // Move, on a client: the server's word first (the acknowledged sample, and the body after it), then this step's
  // sample moves the predicted body at once and goes to the server with every sample not yet acknowledged
  fn moveClient(self: &mut) {
    var have = false;
    var snap = PersonalSnap(0u64, 0u32, Vec3(0., 0., 0.), 0.);
    match &net.personal {
      case let Some(p) { snap = *p; have = true; }
      else {}
    }
    if have {
      net.predictor.acknowledge(snap.ack, snap.feet, snap.yaw);
      net.personal = None[PersonalSnap];
    }
    let m = io.moves.newest();
    let look = io.looks.newest();
    _ = net.predictor.sample(m.forward, m.strafe, look.yaw);
    net.predictor.smooth();
    person.feet = net.predictor.shown();
    person.yaw = look.yaw;
    if m.forward > 0.5 {
      walkSteps = walkSteps + 1u64;
      walked = walked + walkDelta(look.yaw, m.forward, m.strafe).length();
    }
    let bytes = bytesOfList(&net.predictor.encodeInput(net.view.ack));
    match &mut net.link {
      case var &mut Some(c) { sendLatest(c, STREAM_INPUT, bytes); }
      else {}
    }
    net.inputSent = net.inputSent + 1u64;
  }

  // Sense: areas crossed, contacts, timers due. None in the mock world
  fn sense(self: &mut) {}

  // React: the queue of triggers, in order. Actions a handler sends join the
  // back of the queue (to a depth limit, once handlers exist).
  fn react(self: &mut) {
    var q = Actions();
    q <-> queue;
    each a in &q {
      if self.runHandler(a) { reacted.push(*a); }
    }
    q.clear();
    q <-> queue;
  }

  // THE HANDLER-BUDGET SEAM. A world's handler runs here, under its budget
  // (`RULE_FUEL`); one that traps or overruns is stopped, its writes dropped
  // and the world told (simrules.cone, sim.md). A press on a part runs the
  // pick-and-place rules that hold it; the glides they ask for start here.
  fn runHandler(self: &mut, a: &Action) bool {
    print <- "sim: step "; print <- step; print <- " react: verb "; print <- a.verb; print <- " to part ";
    if a.receiver == NO_PART { print <- "none"; }
    else { print <- a.receiver; print <- " ("; printStr(parts[usize.from(a.receiver)].name.view()); print <- ")"; }
    print <- "\n";
    if a.verb == VERB_PRESS && a.receiver != NO_PART && rules.live() {
      var asks = GlideAsks();
      _ = rules.click(parts[usize.from(a.receiver)].slot, step, &mut asks);
      each k in &asks { self.startGlide(*k); }
    }
    true
  }

  // A glide a rule asked for: the piece goes to stand over the middle of the part 'to' (its shape's bounds), level
  fn startGlide(self: &mut, k: GlideAsk) {
    var middle = Vec3(0., 0., 0.);
    each p in &parts {
      if p.slot == k.to {
        each s in &heldShapes { if s.key == p.key { middle = s.pick.centre; } }
      }
    }
    let there = rules.slots.worldPoint(k.to, middle);
    let here = rules.slots.worldPoint(k.piece, Vec3(0., 0., 0.));
    rules.slots.startGlide(k.piece, there, k.seconds);
    landings.push(Landing(k.piece, there));
    print <- "sim: step "; print <- step; print <- ", glide from ("; printF(here.x); print <- ", "; printF(here.z);
    print <- ") to ("; printF(there.x); print <- ", "; printF(there.z); print <- ") over "; printF(k.seconds); print <- " s\n";
  }

  // Derive: the world's derives in dependency order, then what is moving moves (a glide's step)
  fn derive(self: &mut) {
    // what the animators moved stands before the derives read it; the areas, then, say who is inside them
    rules.slots.refresh();
    rules.sense(person.feet + Vec3(0., EYE_HEIGHT, 0.));
    if role == SIM_SERVER { each r in &net.clients { if r.declared { rules.senseMore(r.person.feet + Vec3(0., EYE_HEIGHT, 0.)); } } }
    rules.derive(step);
    if role != SIM_CLIENT { self.applyTints(); }
    rules.slots.tick();
    rules.trace(step);
    if role == SIM_SERVER {
      // what a rule moved is a change for the clients (partsync.cone)
      rules.slots.refresh();
      if wasGliding && !rules.slots.gliding() { landedNs = Instant.now().nanos(); }
      wasGliding = rules.slots.gliding();
      var i = 0usize;
      while i < parts.len() {
        let here = self.placeOf(&parts[i]);
        _ = net.tracker.observe(i, &here);
        _ = net.tracker.observeMaterial(i, parts[i].material);
        _ = net.tracker.observeLook(i, &parts[i].look);
        i = i + 1usize;
      }
    }
  }

  // Part 'id' has material key 'key' from now on (what a field that sets the material does): only that key changes, and it
  // reaches Render in the next snapshot. The Loader is asked for the new material before it is told the old one is
  // unused; Render draws the old until the new is resident. A server asks the Loader for no material
  fn setMaterial(self: &mut, id: usize, key: ContentKey) {
    if id >= parts.len() || parts[id].material == key { return; }
    let old = parts[id].material;
    let near = (parts[id].placement.translation() - person.feet).length();
    let part = &mut parts[id];
    part.material = key;
    materialChanges = materialChanges + 1u64;
    if role == SIM_SERVER { return; }
    loader.build(ContentRequest(key, u32.from(id), near));
    loader.unused(old, u32.from(id));
  }

  // Part 'id' has look 'look' from now on (what a rule that turns a lamp on, or moves the sun, does): it reaches Render, and
  // the other people through the shared snapshot, in the next snapshot, with no message of its own
  fn setLook(self: &mut, id: usize, look: PartLook) {
    if id >= parts.len() || sameLook(&parts[id].look, &look) { return; }
    let part = &mut parts[id];
    part.look = look;
    lookChanges = lookChanges + 1u64;
  }

  // The tints a world's derives wrote: a light inside a tinted part has its amount (lux or candela) set to the tint times the
  // amount the world defined (a derive that writes 1 gives it back). A rule changing a lamp, on a server or a whole run
  fn applyTints(self: &mut) {
    let changed = rules.takeTints();
    each c in &changed {
      var i = 0usize;
      while i < parts.len() {
        let p = &parts[i];
        if p.look.kind != LOOK_NONE && p.definedLook.amount > 0. && rules.slots.within(p.slot, c.slot) {
          var look = p.look;
          look.amount = p.definedLook.amount * c.value;
          self.setLook(i, look);
        }
        i = i + 1usize;
      }
    }
  }

  // A client: the looks the server's deltas say, taken as the parts' own
  fn takeLooksFromView(self: &mut) {
    var definedLook = List[PartLook]();
    each p in &parts { definedLook.push(p.definedLook); }
    let looks = net.view.looks(&definedLook);
    var i = 0usize;
    while i < looks.len() {
      self.setLook(i, *looks[i]);
      i = i + 1usize;
    }
  }

  // A client: the materials the server's deltas say, taken as the parts' own
  fn takeMaterialsFromView(self: &mut) {
    var definedMat = List[ContentKey]();
    each p in &parts { definedMat.push(p.definedMaterial); }
    let mats = net.view.materials(&definedMat);
    var i = 0usize;
    while i < mats.len() {
      self.setMaterial(i, *mats[i]);
      i = i + 1usize;
    }
  }

  // Where a part stands now: its frame in the world once a rule has moved it, else where the image put it. A client
  // runs no rules: it stands where the server's snapshots show it
  fn placeOf(self: &, p: &SimPart) Mat4 {
    if role == SIM_CLIENT {
      if usize.from(p.id) < shown.len() { return *shown[usize.from(p.id)]; }
      return p.placement;
    }
    if usize.from(p.slot) < rules.slots.count() { rules.slots.place(p.slot) } else { p.placement }
  }

  // A client's merge, second part: each part of the world between its two newest states from the server, shown the
  // same fixed delay in the past as the other people
  fn mergeParts(self: &mut) {
    let nowNs = Instant.now().nanos();
    let x = net.interp.shownAt(nowNs);
    let newest = net.interp.newestStep();
    var before = List[Mat4]();
    before <-> shown;
    each p in &parts {
      let at = net.view.placeAt(usize.from(p.id), x, newest, &p.placement);
      if usize.from(p.id) < before.len() && !sameMat(&at, &before[usize.from(p.id)]) {
        if movedFirstNs == 0i64 { movedFirstNs = nowNs; }
        movedLastNs = nowNs;
      }
      shown.push(at);
    }
  }

  // Keep this step's poses for picking against what the person saw (`PoseHistory`)
  fn remember(self: &mut, atNs: u64) {
    poseHistory.begin(atNs);
    each p in &parts { poseHistory.add(self.placeOf(p)); }
  }

  // Publish: the zone's parts and the person, as a snapshot nothing changes
  // after this
  fn publish(self: &mut, atNs: u64) {
    if role == SIM_SERVER { return; }   // a server's zone is sent to its clients (sendSnapshots), not drawn
    rules.slots.refresh();
    var ps = PartStates();
    each p in &parts { ps.push(PartState(p.id, p.key, p.material, p.look, NO_PART, self.placeOf(p))); }
    var others = OtherPersons();
    if role == SIM_CLIENT { others = self.mergeOthers(); }
    // Other people are parts of the avatar design, standing where the server's snapshots put them (the id: after the world's)
    if role == SIM_CLIENT && hasAvatar {
      each o in &others {
        let turn = Quat.angleAxis(o.yaw, Vec3(0., 1., 0.));
        ps.push(PartState(u32.from(parts.len()) + o.id, avatarKey, avatarMaterial, noLook(), NO_PART,
          Mat4.fromTrs(o.feet, turn, Vec3(1., 1., 1.))));
      }
    }
    var s = Snapshot(step, atNs, person, ps, others, 0u64);
    s.sum = snapshotSum(&s);
    let out = Published(s);
    if mutateAfterPublish {
      // The mutant: change the step before this one's snapshot after it was
      // published, as a pool that reused snapshots too soon would
      match &lastPublished {
        case let Some(prev) {
          let p = &**prev as *Snapshot;
          (*p).person.feet.x = (*p).person.feet.x + 1.;
          if step == 2u64 { print <- "sim: MUTANT: changing each snapshot after publishing\n"; }
        }
        case is None[Published] {}
      }
    }
    render.snapshot(out);
    audio.snapshot(out);
    lastPublished = Some[Published](out);
  }

  // The part whose pick shape the ray meets first, or NO_PART
  // as the person saw it: the poses of the press's drawn time (`rayPlacedAt`). On a client these are the poses it showed
  // (`shown`, its interpolated view), since `placeOf` is what each step records
  fn pick(self: &, from: Vec3, along: Vec3, madeNs: u64) PartId {
    var best = NO_PART;
    var bestT: f32 = 1000000000.;
    each p in &parts {
      each s in &heldShapes {
        if s.key == p.key {
          let t = rayPlacedAt(&poseHistory, madeNs, usize.from(p.id), &self.placeOf(p), from, along, &s.pick, mutantIs("pick-at-current"));
          if t >= 0. && t < bestT { bestT = t; best = p.id; }
        }
      }
    }
    best
  }

  // The client's merge, third part: the other people, from the server's shared snapshots a fixed delay in the past.
  // Notes when it first sees one displaced from where it first saw it
  fn mergeOthers(self: &mut) OtherPersons {
    let now = Instant.now().nanos();
    let others = net.interp.at(now);
    if others.len() > net.othersSeen { net.othersSeen = others.len(); }
    if others.len() > 0usize {
      if !net.firstSeen {
        net.firstSeen = true;
        net.otherFirst = others[0usize].feet;
        net.otherFirstId = others[0usize].id;
      } else if net.firstOtherMovedNs == 0i64 {
        each o in &others {
          if o.id == net.otherFirstId && (o.feet - net.otherFirst).length() > 0.01 { net.firstOtherMovedNs = now; }
        }
      }
    }
    others
  }

  fn printLine(self: &mut) {
    if role == SIM_SERVER {
      print <- "step "; print <- step; print <- " people "; print <- u64.from(net.clients.len()); print <- " joined "; print <- net.joins;
      print <- " left "; print <- net.leaves; print <- "\n";
      return;
    }
    let d = io.drawn.newest();
    print <- "step "; print <- step; print <- " feet ("; printF(person.feet.x); print <- ", "; printF(person.feet.y);
    print <- ", "; printF(person.feet.z); print <- ") yaw "; printF(person.yaw); print <- " shapes ";
    print <- u64.from(heldShapes.len()); print <- "/"; print <- u64.from(parts.len()); print <- " actions ";
    print <- u64.from(reacted.len()); print <- " | drawn frame "; print <- d.frame; print <- " of step "; print <- d.step;
    print <- " look seq "; print <- d.lookSeq; print <- "\n";
  }

  // The run's checks, printed: 0 if all passed, 1 if not
  fn checks(self: &mut) i32 {
    if role == SIM_SERVER { return self.serverChecks(); }
    if role == SIM_CLIENT { return self.clientChecks(); }
    self.wholeChecks()
  }

  fn serverChecks(self: &mut) i32 {
    var k = 0usize;
    while k < net.clients.len() { self.printRow(k, "at the end"); k = k + 1usize; }
    print <- "net server: "; print <- net.joins; print <- " joined, "; print <- net.leaves; print <- " left, "; print <- net.refusals;
    print <- " refused; shared part sent "; print <- net.sharedSent; print <- " times (largest "; print <- u64.from(net.largestShared);
    print <- " bytes), personal part "; print <- net.personalSent; print <- " (largest "; print <- u64.from(net.largestPersonal);
    print <- " bytes); "; print <- net.malformed; print <- " messages did not parse\n";
    print <- "net server: "; print <- net.partEntries; print <- " changed-part states sent, in all; "; print <- net.tracker.version; print <- " part changes\n";
    each q in &parts {
      let at = self.placeOf(q);
      if net.tracker.changedAt(usize.from(q.id)) > 0u64 {
        print <- "net server: final part "; printStr(q.name.view()); print <- " at ("; printF(at.m[12]); print <- ", "; printF(at.m[13]);
        print <- ", "; printF(at.m[14]); print <- ")\n";
      }
    }
    each l in &landings {
      print <- "net server: a glide was sent to ("; printF(l.goal.x); print <- ", "; printF(l.goal.z); print <- ")\n";
    }
    print <- "net server: the last glide ended at ns "; print <- landedNs; print <- "\n";
    let ok = net.malformed == 0u64 && net.joins > 0u64;
    print <- "check server: "; if ok { print <- "ok\n"; } else { print <- "FAILED\n"; }
    print <- "sim: "; print <- step; print <- " steps, "; print <- lateSteps; print <- " dropped as late\n";
    if ok { 0 } else { 1 }
  }

  // A client's checks: it joined and took the server's declarations; its prediction matched the server's body at every
  // acknowledged sample, within PREDICT_TOLERANCE; and, when it walks, it walked as a whole Sim's person does
  fn clientChecks(self: &mut) i32 {
    var ok = true;
    print <- "check join: ";
    if declaredFromServer {
      print <- "person "; print <- net.myId; print <- ", "; print <- u64.from(parts.len()); print <- " parts built from its own copy of the world, ";
      print <- u64.from(heldShapes.len()); print <- " shapes taken from the server, none rebuilt: ok\n";
    } else {
      print <- "FAILED (never joined"; if net.phase == PHASE_REFUSED { print <- ": "; printStr(net.refusedWhy.view()); } print <- ")\n";
      ok = false;
    }
    let p = &net.predictor;
    print <- "check prediction: "; print <- p.samples; print <- " samples, "; print <- p.acks; print <- " acknowledged, worst difference from the server at an acknowledged sample ";
    printF(p.worstMismatch * 1000.); print <- " mm (tolerance "; printF(PREDICT_TOLERANCE * 1000.); print <- " mm), "; print <- p.mismatches;
    print <- " mismatches; "; print <- p.corrections; print <- " corrections (worst "; printF(p.worstCorrection * 1000.); print <- " mm, ";
    print <- p.snaps; print <- " snapped), "; print <- p.replayed; print <- " samples replayed, "; print <- p.stale; print <- " stale acknowledgements dropped";
    if declaredFromServer && p.acks > 0u64 && p.worstMismatch <= PREDICT_TOLERANCE { print <- ": ok\n"; } else { print <- ": FAILED\n"; ok = false; }
    print <- "net client: person "; print <- net.myId; print <- " shared "; print <- net.sharedGot; print <- " personal "; print <- net.personalGot;
    print <- " input "; print <- net.inputSent; print <- " stale shared dropped "; print <- net.interp.stale; print <- " malformed "; print <- net.malformed;
    print <- "; saw up to "; print <- u64.from(net.othersSeen); print <- " others; first other moved at ns "; print <- net.firstOtherMovedNs;
    print <- "; final feet ("; printF(net.predictor.person.feet.x); print <- ", "; printF(net.predictor.person.feet.y); print <- ", ";
    printF(net.predictor.person.feet.z); print <- ")\n";
    if net.malformed > 0u64 { ok = false; }
    // the shared-state hash: every shared snapshot that completed this client's picture carried the server's hash of it
    print <- "check part hashes: "; print <- hashChecked; print <- " shared snapshots compared, "; print <- hashMismatched; print <- " differed";
    if hashMismatched == 0u64 && hashChecked > 0u64 { print <- ": ok\n"; }
    else if hashChecked == 0u64 { print <- ": FAILED (none was compared)\n"; ok = false; }
    else { print <- ": FAILED (a full snapshot was asked for; it "; if resyncAsked { print <- "has not matched since"; } else { print <- "has matched since"; } print <- ")\n"; ok = false; }
    if io.net.walks {
      let expected = f32.from(walkSteps) * STEP_SECONDS * WALK_SPEED;
      print <- "check walk: "; print <- walkSteps; print <- " steps forward moved "; printF(walked); print <- " m";
      let good = walkSteps >= 110u64 && walkSteps <= 130u64 && absf(walked - expected) < 0.01;
      if good { print <- ": ok\n"; } else { print <- ": FAILED\n"; ok = false; }
      var boxA = NO_PART;
      each q in &parts { if q.name.view() == "box-a" { boxA = q.id; } }
      if boxA == NO_PART {
        print <- "check pointer: skipped, this world has no part named box-a\n";
      } else {
        print <- "check pointer: "; print <- net.pressesSent; print <- " press sent to the server aimed at part "; print <- boxA;
        if net.pressesSent >= 1u64 { print <- ": ok\n"; } else { print <- ": FAILED\n"; ok = false; }
      }
    }
    // The parts the server moved, as this client shows them at the end
    var movedParts = 0u64;
    let newestStep = net.interp.newestStep();
    each q in &parts {
      let at = net.view.placeAt(usize.from(q.id), 0., newestStep, &q.placement);
      if !sameMat(&at, &q.placement) {
        movedParts = movedParts + 1u64;
        print <- "net client: person "; print <- net.myId; print <- " final part "; printStr(q.name.view()); print <- " at (";
        printF(at.m[12]); print <- ", "; printF(at.m[13]); print <- ", "; printF(at.m[14]); print <- ")\n";
      }
    }
    print <- "check parts: "; print <- net.partsGot; print <- " shared snapshots carried parts, "; print <- net.view.applied;
    print <- " part states applied, acknowledged through version "; print <- net.view.ack; print <- ", "; print <- movedParts;
    print <- " parts end away from the definition, no rule ran here\n";
    print <- "net client: person "; print <- net.myId; print <- " showed a part move first at ns "; print <- movedFirstNs; print <- ", last at ns "; print <- movedLastNs; print <- "\n";
    print <- "sim: "; print <- step; print <- " steps, "; print <- lateSteps; print <- " dropped as late\n";
    if ok { 0 } else { 1 }
  }

  fn wholeChecks(self: &mut) i32 {
    var ok = true;
    let expected = f32.from(walkSteps) * STEP_SECONDS * WALK_SPEED;
    let seconds = f32.from(walkSteps) * STEP_SECONDS;
    print <- "check walk: "; print <- walkSteps; print <- " steps forward ("; printF(seconds); print <- " s) moved ";
    printF(walked); print <- " m, "; printF(walked / seconds); print <- " m/s against "; printF(WALK_SPEED);
    // the script walks from WALK_FROM to WALK_TO; a run that ends before WALK_TO (a world run for 120 steps) walks the part of it that ran
    let ranTo = if step < WALK_TO { step } else { WALK_TO };
    let wantSteps = if ranTo > WALK_FROM { ranTo - WALK_FROM } else { 0u64 };
    let good = walkSteps + 10u64 >= wantSteps && walkSteps <= wantSteps + 10u64 && absf(walked - expected) < 0.01;
    if good { print <- ": ok\n"; } else { print <- ": FAILED\n"; ok = false; }
    var boxA = NO_PART;
    each p in &parts { if p.name.view() == "box-a" { boxA = p.id; } }
    var hit = false;
    each a in &reacted { if a.verb == VERB_PRESS && a.receiver == boxA { hit = true; } }
    if boxA == NO_PART {
      print <- "check pointer: skipped, this world has no part named box-a (the press aims at the mock world's)\n";
    } else {
      print <- "check pointer: a press reached Sim with box-a's handle ("; print <- boxA; print <- ")";
      if hit { print <- ": ok\n"; } else { print <- ": FAILED\n"; ok = false; }
    }
    // Each piece a rule glided stands, once its glide is over, over the middle it was sent to (the last one for a piece)
    var li = 0usize;
    while li < landings.len() {
      var last = true;
      var lj = li + 1usize;
      while lj < landings.len() { if landings[lj].piece == landings[li].piece { last = false; } lj = lj + 1usize; }
      if last {
        let at = rules.slots.worldPoint(landings[li].piece, Vec3(0., 0., 0.));
        let goal = landings[li].goal;
        let off = absf(at.x - goal.x) + absf(at.z - goal.z);
        print <- "check glide: "; printStr(rules.slots.nameOf(landings[li].piece)); print <- " stands at ("; printF(at.x);
        print <- ", "; printF(at.z); print <- ") and was sent to ("; printF(goal.x); print <- ", "; printF(goal.z); print <- "), "; printF(off);
        print <- " m off";
        if !rules.slots.gliding() && off < 0.01 { print <- ": ok\n"; } else { print <- ": FAILED\n"; ok = false; }
      }
      li = li + 1usize;
    }
    print <- "sim: "; print <- step; print <- " steps, "; print <- lateSteps; print <- " dropped as late; rules fired ";
    print <- rules.fired; print <- ", stopped "; print <- rules.stopped; print <- "\n";
    if ok { 0 } else { 1 }
  }
}

// Where along the ray ('from', unit 'along') it enters the box at 'centre'
// with half sizes 'half', or -1 if it misses
fn rayBox(from: Vec3, along: Vec3, centre: Vec3, half: Vec3) f32 {
  var lo: f32 = -1000000000.;
  var hi: f32 = 1000000000.;
  if !slab(from.x, along.x, centre.x - half.x, centre.x + half.x, &mut lo, &mut hi) { return -1.; }
  if !slab(from.y, along.y, centre.y - half.y, centre.y + half.y, &mut lo, &mut hi) { return -1.; }
  if !slab(from.z, along.z, centre.z - half.z, centre.z + half.z, &mut lo, &mut hi) { return -1.; }
  if hi < 0. || lo > hi { return -1.; }
  if lo < 0. { 0. } else { lo }
}

fn slab(o: f32, d: f32, a: f32, b: f32, lo: &mut f32, hi: &mut f32) bool {
  if absf(d) < 0.00000001 { return o >= a && o <= b; }
  var t0 = (a - o) / d;
  var t1 = (b - o) / d;
  if t0 > t1 { let t = t0; t0 = t1; t1 = t; }
  if t0 > *lo { *lo = t0; }
  if t1 < *hi { *hi = t1; }
  *lo <= *hi
}

fn clampUnit(x: f32) f32 {
  if x > 1. { return 1.; }
  if x < -1. { return -1.; }
  x
}

fn absf(x: f32) f32 { if x < 0. { 0. - x } else { x } }

// A busy wait, standing in for a slow step in the stall check
fn busyFor(ms: u64) {
  let end = Instant.now().nanos() + i64.from(ms * 1000000u64);
  while Instant.now().nanos() < end {}
}

// A number with three decimals
pub fn printF(x: f32) {
  var v = x;
  if v < 0. { print <- "-"; v = 0. - v; }
  let whole = u64.from(v);
  print <- whole; print <- ".";
  let frac = u64.from((v - f32.from(whole)) * 1000. + 0.5);
  if frac < 100u64 { print <- "0"; }
  if frac < 10u64 { print <- "0"; }
  print <- frac;
}

// The design other people are drawn as: the design the world declares (worldAvatars), as its first part that is built;
// a world that declares none, or a design with nothing to draw, gets the browser's own plain figure (never one of the
// world's other parts)
// (its mesh key and its material key)
fn avatarDesign(b: &Behaviour, decls: &PartDecls) ContentKey, ContentKey {
  if b.avatar == NO_AVATAR { return browserAvatarKey(), browserAvatarMaterialKey(); }
  each d in &*decls {
    if frameWithin(&b.frames, d.slot, b.avatar) { return d.key, d.material; }
  }
  browserAvatarKey(), browserAvatarMaterialKey()
}

// Is the slot 'slot' the slot 'holder', or inside it?
fn frameWithin(frames: &SlotFrames, slot: u32, holder: u32) bool {
  var s = slot;
  var guard = frames.len();
  while guard > 0usize && usize.from(s) < frames.len() {
    if s == holder { return true; }
    let p = frames[usize.from(s)].parent;
    if p == s { return false; }
    s = p;
    guard = guard - 1usize;
  }
  false
}
