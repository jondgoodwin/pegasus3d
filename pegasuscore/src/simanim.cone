// Sim's animators: a world's keys rules (`on(created, start(keys(...)))`), run by tweenstack's registry in Sim's own
// state, as the guide browser's World actor runs them (`guidebrowser\src\world.cone`).
//
// The Loader turns each live keys rule into an `Anim` (plain data, `keysOf`, as guidebrowser\src\build.cone's `animOf`
// does) and sends them in the Behaviour. A rule's unit says `host.start_anim(k)`; Sim starts the k-th `Anim`. Each
// step, in MOVE (sim.md: animators belong to move, before any handler runs), the registry is ticked once and every part
// an animator owns takes the value it wrote: an offset or a turn in its parent's frame (`Slots.setOffset`, `setTurn`),
// so the parts inside move with it and the place Sim publishes is the animated one.

// The world's keys rules as animators (the PartBuilder runs the units that give each key's value)
pub fn keysOf(w: &Understood, bld: &mut PartBuilder) KeysDecls {
  var keys = KeysDecls();
  var i = 0usize;
  while i < w.rules.len() {
    let r = &w.rules[i];
    if r.live {
      var what = String.from("keys on ");
      what.append(w.names.text(w.nodes[r.keys.slot].name));
      what.append(if r.keys.prop == P_ROTATION { ".rotation" } else { ".offset" });
      keys.push(KeysDecl(r.clicked, u32.from(r.part), u32.from(r.keys.slot), r.keys.prop, animOf(bld, i, &r.keys), what));
    }
    i = i + 1usize;
  }
  keys
}

// keys(...) as tweenstack's animator: one track of its keys, linear between them, in a clip that loops as it says
fn animOf(bld: &mut PartBuilder, rule: usize, k: &KeysInfo) Anim {
  var track = Track.make(if k.prop == P_ROTATION { TK_QUAT } else { TK_VEC3 });
  var i = 0usize;
  while i < k.times.len() {
    let t = f32.from(*k.times[i]);
    if k.prop == P_ROTATION { track.addQuat(t, bld.keyTurn(rule, i), INTERP_LINEAR); }
    else { track.addVec3(t, bld.keyOffset(rule, i), INTERP_LINEAR); }
    i = i + 1usize;
  }
  var clip = Clip.make("", k.mode);
  clip.addTrack(u32.from(k.slot), k.prop, track);
  Anim.keys(&clip)
}

// What a check's mutant does to the clock
pub const ANIM_MUTANT_NONE = 0u32;
pub const ANIM_MUTANT_NEVER = 1u32;     // the registry is never ticked: an animator that never advances
pub const ANIM_MUTANT_TWICE = 2u32;     // it is ticked twice a step, its clock runs at twice the step's: one that advances twice a step

// The running animators of a world
pub struct SimAnim {
  reg: Animators;
  pub mutant: u32;
  pub started: u64;                 // animators started
  pub ticks: u64;                   // steps the registry was ticked

  pub fn make() SimAnim { SimAnim(Animators.make(), ANIM_MUTANT_NONE, 0u64, 0u64) }

  pub fn start(self: &mut, a: &Anim) { _ = self.reg.start(a); started = started + 1u64; }

  // One step: the clock moves to 'now' (seconds since the world's first step) and each animated part takes its value
  pub fn tick(self: &mut, now: f64, keys: &KeysDecls, slots: &mut Slots) {
    if mutant != ANIM_MUTANT_NEVER {
      self.reg.tick(if mutant == ANIM_MUTANT_TWICE { now * 2. } else { now });
      ticks = ticks + 1u64;
    }
    var k = 0usize;
    while k < keys.len() {
      let d = &keys[k];
      if self.reg.hasValue(d.target, d.prop) {
        if d.prop == P_ROTATION { slots.setTurn(d.target, self.reg.valueQuat(d.target, d.prop, slots.turnOf(d.target))); }
        else { slots.setOffset(d.target, self.reg.valueVec3(d.target, d.prop, Vec3(0., 0., 0.))); }
      }
      k = k + 1usize;
    }
  }
}
