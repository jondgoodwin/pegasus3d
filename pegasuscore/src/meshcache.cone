// The mesh cache: built content kept on disk across runs (loader-design section 8, kind 2). What a Loader worker built for
// a mesh key or a material key is written here by the Loader, and the next run reads it back instead of building it.
//
// THE KEY. An entry is named for its content key alone (`entryPath`). The key (partproducts.cone `contentKey`) already hashes
// everything the product depends on: the shape's name, its argument values (for a world's part, the flattened shape value,
// whose function calls carry their own steps, so the shape unit's code is in it), the vocabulary version and the level of
// detail. What it cannot hash is the code that interprets those: the geometry kernel and the interpreter. Those are covered by
// VOCAB_VERSION (bumped when the vocabulary's output changes) and CACHE_FORMAT here (bumped when the entry's layout changes);
// both are in the entry's header, and an entry with another of either is a clean miss, rebuilt and replaced. A change to the
// kernel that changes a product without bumping VOCAB_VERSION is caught by the build stamp below.
//
// THE BUILD STAMP. VOCAB_VERSION is bumped by hand, which is forgotten while a library is under change. So every entry carries the
// stamp of the build that wrote it (`buildStamp`: a hash of the running executable's bytes, which hold partbuild, sculpt and every
// package linked); an entry of another stamp is a clean miss, rebuilt and replaced. The stamp is not in the key, so a stale file
// is overwritten, not left beside the new one.
//
// THE FILE. header (48 bytes, little-endian): magic, CACHE_FORMAT, kind (mesh or material), VOCAB_VERSION, the key (u64), the
// build stamp (u64), the payload's length (u64), the payload's checksum (u64); then the payload. The reader checks all of them, the exact length and
// the payload's inside counts, and a file that fails any is a miss; an unreadable or damaged one is reported (once: the rebuilt
// product replaces it). Nothing is read back that this key's builder did not write, and nothing here can crash on a bad file.
//
// WHERE. PEGASUS_MESH_CACHE=DIR picks the folder, =off turns it off. Otherwise %LOCALAPPDATA%\Pegasus\cache\mesh (Windows),
// $XDG_CACHE_HOME/Pegasus/cache/mesh, or ~/.cache/Pegasus/cache/mesh.
//
// WHO WRITES. The Loader actor alone writes and deletes (`MeshCache`); its workers only read (`loadEntry`). A file is written
// under a temporary name and renamed into place, so a reader never meets half of one (a second browser on the same folder, such as
// a server beside a client, writes the same bytes for the same key).
//
// SIZE AND ORDER. The folder is kept under CACHE_CAP_BYTES by deleting the least recently used entry first. Recency is the file's
// last-written time, set on every hit (whole seconds: all the file system gives), and within one second the order this Loader
// used the entries in. The newest entry is never deleted, whatever the cap. The files a world keeps (`.wtx`, below) share this one
// cap and order: meshes, materials and kept files are evicted together, least recently used first, and what the running world is
// using (`hold`, `holdFile`) is never evicted, even if that leaves the folder over the cap.
//
// NOT CACHED: a build that left its part out or has notes (the notes are reported on every build), and meshes with vertex colours
// or tangents (the worlds' meshes have neither; the entry does not carry them). Mock worlds' content is not cached: it is cheaper
// to make than to read.

pub const CACHE_FORMAT = 2u32;
pub const CACHE_MESH = 1u32;        // an entry of a mesh key: the mesh, its box, its half sizes
pub const CACHE_MATERIAL = 2u32;    // an entry of a material key: the material's record

// The cap on the folder, in bytes. 512 MiB: the whole of a large world's meshes is tens of megabytes (the first world's is under 2),
// so this holds many worlds' at once, and is a small part of a disk that holds user data; a cap too small makes the cache forget
// what the next run wants, one too large is space the user did not choose to spend.
pub const CACHE_CAP_BYTES = 536870912u64;

// What `loadEntry` found
pub const LOAD_HIT = 1u32;          // the product was read back
pub const LOAD_MISS = 2u32;         // no entry
pub const LOAD_CORRUPT = 3u32;      // an entry that is damaged, truncated or unreadable: rebuilt, and reported
pub const LOAD_OLD = 4u32;          // an entry of another format, vocabulary version or build: rebuilt, nothing to report

// What a check's mutant makes `readEntry` trust (flags in `lax`; 0 is the real reader)
pub const LAX_SUM = 1u32;           // the payload's checksum is not checked
pub const LAX_STAMP = 2u32;         // the build stamp is not compared

const CACHE_MAGIC = 0x4d474550u32;  // "PEGM"
const HEADER_BYTES = 48usize;
const CACHE_MAX_ITEMS = 268435456usize;
const FNV_OFFSET = 14695981039346656037u64;
const FNV_PRIME = 1099511628211u64;
const CACHE_TMP_EXTENSION = ".tmp";
const CACHE_EXTENSION = ".pgm";
const FILE_EXTENSION = ".wtx";      // a kept world file

// The folder asked for by the environment; empty: no cache
pub fn cacheFolder() String {
  let own = libc.getenv("PEGASUS_MESH_CACHE");
  if (own as usize) != 0usize {
    if libc.strcmp(cstr.fromPtr(own), "off") == 0i32 || libc.strcmp(cstr.fromPtr(own), "") == 0i32 { return String(); }
    return String.fromCStr(cstr.fromPtr(own));
  }
  let appData = libc.getenv("LOCALAPPDATA");
  if (appData as usize) != 0usize { return String.from(Path.from(String.fromCStr(cstr.fromPtr(appData)).view()).join("Pegasus").join("cache").join("mesh").view()); }
  let xdg = libc.getenv("XDG_CACHE_HOME");
  if (xdg as usize) != 0usize { return String.from(Path.from(String.fromCStr(cstr.fromPtr(xdg)).view()).join("Pegasus").join("cache").join("mesh").view()); }
  let home = libc.getenv("HOME");
  if (home as usize) != 0usize { return String.from(Path.from(String.fromCStr(cstr.fromPtr(home)).view()).join(".cache").join("Pegasus").join("cache").join("mesh").view()); }
  String()
}

pub fn cacheHex(x: u64) String {
  var out = String();
  var k = 16i32;
  while k > 0i32 {
    k = k - 1i32;
    let d = u8.from((x >> (u64.from(k) * 4u64)) & 0xFu64);
    out.appendByte(if d < 10u8 { '0' + d } else { 'a' + (d - 10u8) });
  }
  out
}

// The file name of the entry of 'key', and of the kept world file of content hash 'hash'
pub fn entryName(key: ContentKey) String {
  var name = cacheHex(key);
  name.append(CACHE_EXTENSION);
  name
}

pub fn keptName(hash: u64) String {
  var name = cacheHex(hash);
  name.append(FILE_EXTENSION);
  name
}

// Where the entry of 'key' lives in 'dir'
pub fn entryPath(dir: &Path, key: ContentKey) Path {
  var name = cacheHex(key);
  name.append(CACHE_EXTENSION);
  dir.join(name.view())
}

fn sumOfBytes(b: &Array[u8]) u64 { cacheSum(b as *u8, b.len) }

// The mutants asked for in PEGASUS_MUTANT: cache-skip-checksum and cache-ignore-stamp
pub fn cacheLax() u32 {
  var lax = 0u32;
  if mutantIs("cache-skip-checksum") { lax = lax | LAX_SUM; }
  if mutantIs("cache-ignore-stamp") { lax = lax | LAX_STAMP; }
  lax
}

// The stamp of this build: a hash of the running executable's bytes (0: the file could not be read). Chosen over a hash of the
// sources taken when building because a source hash needs a build script that every way of building would have to run, and a
// build that skipped it would be stale without saying so; the executable cannot be stale. It over-misses (a change to code that
// makes no mesh changes it too), which costs one rebuild of the cache.
pub fn buildStamp() u64 {
  match process.currentExe() {
    case let Ok(exe) {
      match fs.readFile(&exe) {
        case let Ok(bytes) { return sumOfBytes(bytes.view()); }
        else {}
      }
    }
    else {}
  }
  0u64
}

// ---- Bytes in and out ----

fn cachePutU32(out: &mut List[u8], x: u32) {
  var k = 0u32;
  while k < 4u32 { out.push(u8.from((x >> (k * 8u32)) & 0xFFu32)); k = k + 1u32; }
}

fn cachePutU64(out: &mut List[u8], x: u64) {
  var k = 0u32;
  while k < 8u32 { out.push(u8.from((x >> (u64.from(k) * 8u64)) & 0xFFu64)); k = k + 1u32; }
}

fn putBytes(out: &mut List[u8], src: *u8, n: usize) {
  let at = out.len();
  out.resize(at + n, 0u8);
  if n > 0usize { libc.memcpy((out.viewMut() as *u8) + at, src, n); }
}

fn putFloats(out: &mut List[u8], f: &List[f32]) { putBytes(out, (f.view() as *f32) as *u8, f.len() * 4usize); }

fn putVec3s(out: &mut List[u8], v: &List[Vec3]) {
  cachePutU32(out, u32.from(v.len()));
  var flat = List[f32]();
  each p in v { flat.push(p.x); flat.push(p.y); flat.push(p.z); }
  putFloats(out, &flat);
}

fn cachePutVec3(out: &mut List[u8], p: Vec3) {
  var flat = List[f32]();
  flat.push(p.x); flat.push(p.y); flat.push(p.z);
  putFloats(out, &flat);
}

fn getU32(b: &Array[u8], at: usize) u32 {
  u32.from(b[at]) | (u32.from(b[at + 1usize]) << 8u32) | (u32.from(b[at + 2usize]) << 16u32) | (u32.from(b[at + 3usize]) << 24u32)
}

fn getU64(b: &Array[u8], at: usize) u64 {
  u64.from(getU32(b, at)) | (u64.from(getU32(b, at + 4usize)) << 32u64)
}

// The checksum of 'n' bytes at 'p': a word at a time
fn cacheSum(p: *u8, n: usize) u64 {
  var h = FNV_OFFSET;
  let words = n / 8usize;
  let w = p as *u64;
  var i = 0usize;
  while i < words {
    h = ((h ^ *(w + i)) * FNV_PRIME) ^ (h >> 29u64);
    i = i + 1usize;
  }
  var j = words * 8usize;
  while j < n {
    h = (h ^ u64.from(*(p + j))) * FNV_PRIME;
    j = j + 1usize;
  }
  h
}

// 'n' floats at 'at' of 'b', and 'at' moved past them; None if they do not fit
fn getFloats(b: &Array[u8], at: &mut usize, n: usize) Option[List[f32]] {
  if n > CACHE_MAX_ITEMS || *at + n * 4usize > b.len { return None[List[f32]]; }
  var out = List[f32]();
  out.resize(n, 0.);
  if n > 0usize { libc.memcpy((out.viewMut() as *f32) as *u8, (b as *u8) + *at, n * 4usize); }
  *at = *at + n * 4usize;
  Some[List[f32]](out)
}

fn getCount(b: &Array[u8], at: &mut usize) Option[usize] {
  if *at + 4usize > b.len { return None[usize]; }
  let n = getU32(b, *at);
  *at = *at + 4usize;
  Some[usize](usize.from(n))
}

fn getVec3s(b: &Array[u8], at: &mut usize, out: &mut List[Vec3]) bool {
  match getCount(b, at) {
    case let Some(n) {
      match getFloats(b, at, n * 3usize) {
        case let Some(f) {
          var i = 0usize;
          while i < n { out.push(Vec3(*f[i * 3usize], *f[i * 3usize + 1usize], *f[i * 3usize + 2usize])); i = i + 1usize; }
          return true;
        }
        case is None[List[f32]] {}
      }
    }
    case is None[usize] {}
  }
  false
}

fn getVec3(b: &Array[u8], at: &mut usize, out: &mut Vec3) bool {
  match getFloats(b, at, 3usize) {
    case let Some(f) { *out = Vec3(*f[0usize], *f[1usize], *f[2usize]); true }
    case is None[List[f32]] { false }
  }
}

// ---- What an entry holds ----

// Whether the products of a build are kept: a part left out, or one with notes to report, is built again each time
pub fn cacheable(kind: u32, p: &PartProducts) bool {
  if !p.made || p.notes.len() > 0usize { return false; }
  if kind == CACHE_MESH && (p.mesh.colors.len() > 0usize || p.mesh.tangents.len() > 0usize) { return false; }
  true
}

// The entry of 'p' under 'key', as the file's bytes
pub fn entryBytes(key: ContentKey, kind: u32, stamp: u64, p: &PartProducts) List[u8] {
  var body = List[u8]();
  if kind == CACHE_MESH {
    cachePutVec3(&mut body, p.low); cachePutVec3(&mut body, p.high); cachePutVec3(&mut body, p.half);
    putVec3s(&mut body, &p.mesh.positions);
    putVec3s(&mut body, &p.mesh.normals);
    cachePutU32(&mut body, u32.from(p.mesh.uvs.len()));
    var uv = List[f32]();
    each t in &p.mesh.uvs { uv.push(t.x); uv.push(t.y); }
    putFloats(&mut body, &uv);
    cachePutU32(&mut body, u32.from(p.mesh.indices.len()));
    putBytes(&mut body, (p.mesh.indices.view() as *u32) as *u8, p.mesh.indices.len() * 4usize);
    cachePutU32(&mut body, u32.from(p.mesh.groups.len()));
    each g in &p.mesh.groups { cachePutU32(&mut body, g.start); cachePutU32(&mut body, g.count); cachePutU32(&mut body, g.material); }
  } else {
    let m = &p.material;
    var f = List[f32]();
    f.push(m.color.red); f.push(m.color.green); f.push(m.color.blue); f.push(m.color.alpha);
    f.push(m.roughness); f.push(m.metal); f.push(m.covers); f.push(m.coat); f.push(m.coatRoughness); f.push(m.reflects);
    cachePutU32(&mut body, if m.physical { 1u32 } else { 0u32 });
    putFloats(&mut body, &f);
  }
  var out = List[u8]();
  cachePutU32(&mut out, CACHE_MAGIC);
  cachePutU32(&mut out, CACHE_FORMAT);
  cachePutU32(&mut out, kind);
  cachePutU32(&mut out, VOCAB_VERSION);
  cachePutU64(&mut out, key);
  cachePutU64(&mut out, stamp);
  cachePutU64(&mut out, u64.from(body.len()));
  cachePutU64(&mut out, cacheSum(body.view() as *u8, body.len()));
  out.appendSlice(body.view());
  out
}

// The products an entry's bytes hold, into 'out' (whose mesh is empty). LOAD_HIT, LOAD_CORRUPT or LOAD_OLD. 'skipSum' is the
// mutant that does not check the payload's checksum
pub fn readEntry(b: &Array[u8], key: ContentKey, kind: u32, stamp: u64, lax: u32, out: &mut PartProducts) u32 {
  if b.len < HEADER_BYTES { return LOAD_CORRUPT; }
  if getU32(b, 0usize) != CACHE_MAGIC { return LOAD_CORRUPT; }
  if getU32(b, 4usize) != CACHE_FORMAT || getU32(b, 12usize) != VOCAB_VERSION { return LOAD_OLD; }
  if getU32(b, 8usize) != kind || getU64(b, 16usize) != key { return LOAD_CORRUPT; }
  if (lax & LAX_STAMP) == 0u32 && getU64(b, 24usize) != stamp { return LOAD_OLD; }
  if getU64(b, 32usize) != u64.from(b.len - HEADER_BYTES) { return LOAD_CORRUPT; }
  if (lax & LAX_SUM) == 0u32 && cacheSum((b as *u8) + HEADER_BYTES, b.len - HEADER_BYTES) != getU64(b, 40usize) { return LOAD_CORRUPT; }
  var at = HEADER_BYTES;
  if kind == CACHE_MESH {
    var low = Vec3(0., 0., 0.);
    var high = Vec3(0., 0., 0.);
    var half = Vec3(0., 0., 0.);
    if !getVec3(b, &mut at, &mut low) || !getVec3(b, &mut at, &mut high) || !getVec3(b, &mut at, &mut half) { return LOAD_CORRUPT; }
    var mesh = Mesh();
    if !getVec3s(b, &mut at, &mut mesh.positions) || !getVec3s(b, &mut at, &mut mesh.normals) { return LOAD_CORRUPT; }
    match getCount(b, &mut at) {
      case let Some(n) {
        match getFloats(b, &mut at, n * 2usize) {
          case let Some(f) {
            var i = 0usize;
            while i < n { mesh.uvs.push(Vec2(*f[i * 2usize], *f[i * 2usize + 1usize])); i = i + 1usize; }
          }
          case is None[List[f32]] { return LOAD_CORRUPT; }
        }
      }
      case is None[usize] { return LOAD_CORRUPT; }
    }
    match getCount(b, &mut at) {
      case let Some(n) {
        if n > CACHE_MAX_ITEMS || at + n * 4usize > b.len { return LOAD_CORRUPT; }
        mesh.indices.resize(n, 0u32);
        if n > 0usize { libc.memcpy((mesh.indices.viewMut() as *u32) as *u8, (b as *u8) + at, n * 4usize); }
        at = at + n * 4usize;
      }
      case is None[usize] { return LOAD_CORRUPT; }
    }
    match getCount(b, &mut at) {
      case let Some(n) {
        if n > CACHE_MAX_ITEMS || at + n * 12usize > b.len { return LOAD_CORRUPT; }
        var i = 0usize;
        while i < n {
          mesh.groups.push(Group(getU32(b, at), getU32(b, at + 4usize), getU32(b, at + 8usize)));
          at = at + 12usize;
          i = i + 1usize;
        }
      }
      case is None[usize] { return LOAD_CORRUPT; }
    }
    if at != b.len { return LOAD_CORRUPT; }
    out.mesh <-> mesh;
    out.low = low; out.high = high; out.half = half;
  } else {
    if at + 4usize > b.len { return LOAD_CORRUPT; }
    let physical = getU32(b, at) != 0u32;
    at = at + 4usize;
    match getFloats(b, &mut at, 10usize) {
      case let Some(f) {
        if at != b.len { return LOAD_CORRUPT; }
        out.material = MaterialRec(Color(*f[0usize], *f[1usize], *f[2usize], *f[3usize]), physical, *f[4usize], *f[5usize], *f[6usize], *f[7usize], *f[8usize], *f[9usize]);
      }
      case is None[List[f32]] { return LOAD_CORRUPT; }
    }
  }
  LOAD_HIT
}

// Read the entry of 'key' from 'dir' into 'out'. No file is a miss; a file that cannot be read is corrupt
pub fn loadEntry(dir: &Path, key: ContentKey, kind: u32, stamp: u64, lax: u32, out: &mut PartProducts) u32 {
  let file = entryPath(dir, key);
  match fs.readFile(&file) {
    case let Ok(text) { return readEntry(text.view(), key, kind, stamp, lax, out); }
    case let Err(e) { if e.notFound() { return LOAD_MISS; } }
  }
  LOAD_CORRUPT
}

// ---- Files of a world kept by content ----
// A file the manifest names is kept under its content hash, beside the mesh entries (`.wtx`; counted in the cap with them and
// evicted by the same least-recently-used order, `MeshCache.evict`). A kept file is read back and checked against the size and hash
// the manifest gives, so a damaged or foreign file there is a miss, never a world.

// The hash of a file's bytes (the same sum that checks the entries)
pub fn contentHash(b: &Array[u8]) u64 { sumOfBytes(b) }

// Where the file of content hash 'hash' lives in 'dir'
pub fn keptFilePath(dir: &Path, hash: u64) Path {
  var name = cacheHex(hash);
  name.append(FILE_EXTENSION);
  dir.join(name.view())
}

// Write 'bytes' to 'file' by a temporary name beside it, then rename: a reader sees all of it or none. False if the disk would not
// take it
fn writeKept(dir: &Path, stem: String, file: &Path, bytes: &Array[u8]) bool {
  match fs.makeDirAll(dir) { else {} }
  var tmpName = stem;
  tmpName.append(CACHE_TMP_EXTENSION);
  tmpName.append(cacheHex(u64.from(time.Instant.now().nanos())).view());
  let tmp = dir.join(tmpName.view());
  var written = false;
  match fs.writeFile(&tmp, bytes) { case is Ok { written = true; } else {} }
  if !written { match fs.removeFile(&tmp) { else {} } return false; }
  var done = false;
  match fs.rename(&tmp, file) { case is Ok { done = true; } else {} }
  if !done {
    // (a file already there, which Windows will not rename over: a damaged one just refused, or another browser's)
    match fs.removeFile(file) { else {} }
    match fs.rename(&tmp, file) { case is Ok { done = true; } else {} }
  }
  if !done { match fs.removeFile(&tmp) { else {} } return false; }
  true
}

// The kept file of content hash 'hash', if there and of this size and hash: None otherwise (a miss). A file read back whose bytes
// do not hash to its name is removed
pub fn loadKeptFile(dir: &Path, size: u64, hash: u64) Option[String] {
  if dir.isEmpty() { return None[String]; }
  let file = keptFilePath(dir, hash);
  match fs.readFile(&file) {
    case let Ok(bytes) {
      if u64.from(bytes.len()) == size && sumOfBytes(bytes.view()) == hash { return Some[String](String.from(bytes.view())); }
      match fs.removeFile(&file) { else {} }
    }
    else {}
  }
  None[String]
}

// Keep 'bytes' under 'hash' in 'dir'; false if the disk would not take it (or there is no cache)
pub fn storeKeptFile(dir: &Path, hash: u64, bytes: &Array[u8]) bool {
  if dir.isEmpty() { return false; }
  writeKept(dir, cacheHex(hash), &keptFilePath(dir, hash), bytes)
}

// ---- The writer ----

struct Found {
  path: Path;
  size: u64;
  seconds: i64;
  rank: usize;                      // 0: not used by this Loader; else its place in the order it used entries
  held: bool;                       // in use by the running world: never deleted
}

// The cache as its one writer, the Loader, keeps it: the folder, the cap, and the order this run used its entries in. One cap holds
// every kind of file in the folder (mesh entries, material entries, kept world files), least recently used first
pub struct MeshCache {
  pub dir: Path;                    // empty: no cache
  pub cap: u64;
  pub stamp: u64;                   // the build that writes: its entries carry this (`buildStamp`)
  used: List[String];               // the file names, oldest use first
  held: List[String];               // the file names the running world is using (`hold`, `holdFile`)
  pub stored: u64;
  pub evicted: u64;

  pub fn make(dir: Path, stamp: u64, cap: u64) MeshCache {
    MeshCache(dir, cap, stamp, List[String](), List[String](), 0u64, 0u64)
  }

  pub fn on(self: &) bool { !dir.isEmpty() }

  fn markUsed(self: &mut, name: String) {
    var i = 0usize;
    while i < used.len() {
      if used[i].view() == name.view() { _ = used.remove(i); break; }
      i = i + 1usize;
    }
    used.push(name);
  }

  fn markHeld(self: &mut, name: String) {
    var i = 0usize;
    while i < held.len() {
      if held[i].view() == name.view() { return; }
      i = i + 1usize;
    }
    held.push(name);
  }

  // The entry of 'key' was read: it is the newest
  pub fn touch(self: &mut, key: ContentKey) {
    if !self.on() { return; }
    self.markUsed(entryName(key));
    let now = time.Timestamp.now();
    match fs.utime(&entryPath(&dir, key), now, now) { else {} }
  }

  // The kept world file of content hash 'hash' was read, or was just kept: it is the newest
  pub fn touchFile(self: &mut, hash: u64) {
    if !self.on() { return; }
    self.markUsed(keptName(hash));
    let now = time.Timestamp.now();
    match fs.utime(&keptFilePath(&dir, hash), now, now) { else {} }
  }

  // The running world uses the entry of 'key': eviction does not delete it, however small the cap
  pub fn hold(self: &mut, key: ContentKey) {
    if !self.on() { return; }
    self.markHeld(entryName(key));
  }

  // The running world uses the kept world file of content hash 'hash': likewise
  pub fn holdFile(self: &mut, hash: u64) {
    if !self.on() { return; }
    self.markHeld(keptName(hash));
  }

  // Keep 'p' under 'key'; false if it is not kept (not cacheable, or the disk would not take it)
  pub fn store(self: &mut, key: ContentKey, kind: u32, p: &PartProducts) bool {
    if !self.on() || !cacheable(kind, p) { return false; }
    let bytes = entryBytes(key, kind, stamp, p);
    if !writeKept(&dir, cacheHex(key), &entryPath(&dir, key), bytes.view()) { return false; }
    self.markUsed(entryName(key));
    self.stored = self.stored + 1u64;
    true
  }

  // Whether 'name' is a file the running world holds
  fn isHeld(self: &, name: &str) bool {
    var i = 0usize;
    while i < held.len() {
      if held[i].view() == name { return true; }
      i = i + 1usize;
    }
    false
  }

  // Delete the least recently used files (mesh entries, material entries and kept world files alike) until the folder is under the
  // cap; the newest is never deleted, nor one the running world holds (PEGASUS_MUTANT=cache-ignore-holds deletes those too, and a
  // check must fail on it). How many went
  pub fn evict(self: &mut) u64 {
    if !self.on() { return 0u64; }
    let ignoreHolds = mutantIs("cache-ignore-holds");
    var found = List[Found]();
    var total = 0u64;
    match fs.readDir(&dir) {
      case let Ok(entries) {
        each e in &entries {
          if !e.isFile || !(e.name.view().endsWith(CACHE_EXTENSION) || e.name.view().endsWith(FILE_EXTENSION)) { continue; }
          match fs.stat(&e.path) {
            case let Ok(info) {
              var rank = 0usize;
              var i = 0usize;
              while i < used.len() {
                if used[i].view() == e.name.view() { rank = i + 1usize; }
                i = i + 1usize;
              }
              found.push(Found(e.path.clone(), u64.from(info.size), info.modified.unixSeconds(), rank, !ignoreHolds && self.isHeld(e.name.view())));
              total = total + u64.from(info.size);
            }
            else {}
          }
        }
      }
      else {}
    }
    var gone = 0u64;
    while total > cap && found.len() > 1usize {
      // the least recently used that is not held: the oldest second, and within it the one this Loader used longest ago
      var oldest = found.len();
      var i = 0usize;
      while i < found.len() {
        let a = &found[i];
        if !a.held {
          if oldest == found.len() { oldest = i; }
          else {
            let b = &found[oldest];
            if a.seconds < b.seconds || (a.seconds == b.seconds && a.rank < b.rank) { oldest = i; }
          }
        }
        i = i + 1usize;
      }
      if oldest == found.len() { break; }
      let victim = found.remove(oldest);
      match fs.removeFile(&victim.path) { else {} }
      total = total - victim.size;
      gone = gone + 1u64;
    }
    self.evicted = self.evicted + gone;
    gone
  }
}

// "meshhash NAME HASH\n" as one string, so a line printed by one worker is never broken by another's (PEGASUS_MESH_HASHES)
pub fn meshHashLine(name: &str, hash: u64) String {
  var digits = List[u8]();
  var v = hash;
  if v == 0u64 { digits.push('0'); }
  while v > 0u64 {
    digits.push('0' + u8.from(v % 10u64));
    v = v / 10u64;
  }
  var s = String.from("meshhash ");
  s.append(name);
  s.append(" ");
  var i = digits.len();
  while i > 0usize {
    i = i - 1usize;
    s.appendByte(*digits[i]);
  }
  s.append("\n");
  s
}
