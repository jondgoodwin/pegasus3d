// What Sim and the Loader send to the display: the browser's Render, or nothing at all on a server
pub actor trait RenderSink {
  pub async fn snapshot(self, s: Published);
  pub async fn content(self, c: MeshContent);
  pub async fn material(self, c: MaterialContent);
  pub async fn release(self, key: ContentKey);
  pub async fn partsAwaited(self, n: usize);
  pub async fn stop(self);
}

// What Sim sends to the sound: the browser's Audio (a mock), or nothing on a server
pub actor trait AudioSink {
  pub async fn snapshot(self, s: Published);
  pub async fn stop(self);
}

// The command line's words, as C strings (`argv`)
pub fn argIs(a: *u8, b: &str) bool {
  var i = 0usize;
  while i < b.len() {
    if *(a + i) != b[i] { return false; }
    i = i + 1usize;
  }
  *(a + b.len()) == 0u8
}

pub fn argNumber(s: *u8) u64 {
  var n = 0u64;
  var i = 0usize;
  while *(s + i) >= '0' && *(s + i) <= '9' {
    n = n * 10u64 + u64.from(*(s + i) - '0');
    i = i + 1usize;
  }
  n
}

pub fn argString(s: *u8) String {
  var out = String();
  var i = 0usize;
  while *(s + i) != 0u8 {
    out.appendByte(*(s + i));
    i = i + 1usize;
  }
  out
}

// The mutant asked for in PEGASUS_MUTANT is 'name'
pub fn mutantIs(name: &str) bool {
  let e = libc.getenv("PEGASUS_MUTANT");
  if (e as usize) == 0usize { return false; }
  argIs(e, name)
}

// The driven checks of the shared code (connected play's reconciliation, stale snapshots and wire; the rules; picking; the
// blend; the mesh cache; the world fetch), each with its mutant (PEGASUS_MUTANT). `pegasus --checks` and
// `pegasus-server --checks` both run them
pub fn checkShared() bool {
  let netOk = checkConnected();
  let rulesOk = checkRules(mutantIs("trapped-writes"));
  let pickOk = checkPick(mutantIs("pick-ignores-turn"));
  let blendOk = checkBlend(mutantIs("blend-lerp-matrix"));
  let cacheOk = checkMeshCache(cacheLax());
  let fetchOk = checkWorldFetch(mutantIs("manifest-skip-hash"));
  netOk && rulesOk && pickOk && blendOk && cacheOk && fetchOk
}
