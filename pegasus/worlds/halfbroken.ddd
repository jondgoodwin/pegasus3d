// A world with two mistakes among good parts: the reader drops each bad part and the Loader keeps the rest
// (pegasus --world worlds\halfbroken.ddd names the dropped parts)
part half
  part materials
    part red: plain(srgb(200, 40, 30))
    part blue: plain(srgb(30, 60, 200))
  part good1: box(x: -1 ..= 1, y: 0 ..= 1, z: -1 ..= 1), material: materials.red
  part noZ: box(x: 0 ..= 1, y: 0 ..= 1), material: materials.blue, at: (3, 0, 0)
  part noMaterial: box(x: 0 ..= 1, y: 0 ..= 1, z: 0 ..= 1), at: (5, 0, 0)
  part good2: box(x: -0.5 ..= 0.5, y: 0 ..= 2, z: -0.5 ..= 0.5), material: materials.blue, at: (-3, 0, 0)
  part good3: box(x: -1 ..= 1, y: 0 ..= 1, z: -1 ..= 1), material: materials.red, at: (0, 0, -4)
  part stray: box(x: 1 ..= 2 y: 0 ..= 1)
