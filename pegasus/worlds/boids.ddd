part boids                                              // a flock (W148, FOR REVIEW: the step function is a proposal)
  part materials
    part sky: physical(color: srgb(70, 90, 120), roughness: 0.9)
    part feather: physical(color: srgb(235, 230, 220), roughness: 0.6)
    part ground: physical(color: srgb(86, 120, 62), roughness: 0.9)

  part bird                                             // a bird 0.5 m across, its nose along +z: a lofted body, flat wings
    field velocity: place = (0, 0, 5), mutable: true    // FOR REVIEW: a place field, own to each copy
    fn form() shape {
      let body = loftAlong(profiles: [outline.rectangle(width: 0.03, height: 0.03),
                                      outline.rectangle(width: 0.10, height: 0.09),
                                      outline.rectangle(width: 0.02, height: 0.02)],
                           spine: spine.line(from: (0, 0, -0.18), to: (0, 0, 0.22)));
      let wings = box(x: -0.30 ..= 0.30, y: -0.008 ..= 0.008, z: -0.05 ..= 0.08);
      join([body, wings])
    }
    part body: form(), material: materials.feather

  part floor: box(x: -200 ..= 200, y: -0.1 ..= 0, z: -200 ..= 200), material: materials.ground, at: (0, 0, 0)
    solid(self, derived)

  part flock
    each i in 0 ..< 50 {
      part b[i]: bird(velocity: (3 + 0.4 * (i % 7), 0.3 * (i % 5) - 0.6, 4 - 0.5 * (i % 3))),
                 at: (2 * (i % 10) - 10, 14 + 0.6 * ((i / 10) % 7), 2 * (i / 70) - 10)
    }

  // FOR REVIEW: one step function a bird runs each step: separation, alignment, cohesion, a leash to a home point 15 m
  // up, a speed clamp; then it moves and turns to its heading. Each bird reads the others as they stood at the step's start.
  fn steer(b: part, dt: duration) bool {
    var sep = (0, 0, 0);
    var vel = (0, 0, 0);
    var pos = (0, 0, 0);
    var n = 0;
    each o in flock.parts {
      let d = o.place - b.place;
      let d2 = dot(d, d);
      if d2 > 0.000001 && d2 < 144 {
        pos = pos + o.place;
        vel = vel + o.velocity;
        n = n + 1;
        var q = d2;
        if q < 0.04 { q = 0.04; }
        if d2 < 3.24 { sep = sep - d * (1 / q); }
      }
    }
    var a = sep * 3.5;
    if n > 0 {
      a = a + (vel / n - b.velocity);
      let toward = pos / n - b.place;
      let dist = length(toward);
      var ramp = dist / 4;
      if ramp > 1 { ramp = 1; }
      if dist > 0.01 { a = a + toward * (0.9 / dist * ramp); }
    }
    let home = (0, 15, 0) - b.place;
    let hd = length(home);
    if hd > 12 { a = a + home * ((hd - 12) / hd * 1.5); }
    var v = b.velocity + a * dt;
    let sp = length(v);
    if sp > 9 { v = v * (9 / sp); }
    if sp < 3 && sp > 0.01 { v = v * (3 / sp); }
    set(b.velocity, v);
    set(b.place, b.place + v * dt);
    set(b.facing, v);
    true
  }

  each b in flock.parts {
    on(created, start(stepAnimator(b, step: steer)))
  }

  part sun: sunLight(direction: (-0.4, 0.8, 0.45), color: color(1, 0.95, 0.88), lux: 70000 lux, castsShadow: true)
  part arrivals
    part start, at: (0, 1.7, 40), facing: (0, 0.2, -1), camera: camera(lens: 35 mm)
