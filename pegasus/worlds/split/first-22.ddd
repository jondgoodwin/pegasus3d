    each file in 0 ..< 8 {
      each rank in 0 ..< 8 {
        part sq[8 * rank + file]: box(x: 0.5 * file - 0.25 ..= 0.5 * file + 0.25, y: 0 ..= 0.08,
                                      z: -0.5 * rank - 0.25 ..= -0.5 * rank + 0.25),
                                  material: if (file + rank) % 2 == 0 { materials.walnut } else { materials.maple }
      }
    }

