part first                                              // the first world: an island, a board, a rook to move
  part materials
    part lawn: physical(color: srgb(86, 120, 62), roughness: 0.9)
    part sand: physical(color: srgb(222, 204, 160), roughness: 0.95)
    part sea: physical(color: srgb(40, 98, 130), roughness: 0.25)
    part maple: [physical(color: srgb(226, 198, 150), roughness: 0.4), clearCoat(amount: 1, roughness: 0.06)]
    part walnut: [physical(color: srgb(92, 60, 40), roughness: 0.4), clearCoat(amount: 1, roughness: 0.06)]
    part frame: [physical(color: srgb(60, 38, 26), roughness: 0.35), clearCoat(amount: 1, roughness: 0.05)]
    part boxwood: [physical(color: srgb(238, 212, 168), roughness: 0.5), clearCoat(amount: 1, roughness: 0.05)]
    part ebony: [physical(color: srgb(30, 24, 22), roughness: 0.45), clearCoat(amount: 1, roughness: 0.04)]
    part cloth: physical(color: srgb(196, 92, 52), roughness: 0.7)

  worldAvatars(cast: [people.figure])                   // visitors are drawn as the world's figure (spelling not chosen)
  part people                                           // the world's avatar designs, kept below the sea where nobody looks
    part figure: lathe(profile: [(0, 0), (0.11, 0), (0.12, 0.05), (0.10, 0.85), (0.20, 0.95), (0.22, 1.25), (0.17, 1.45),
                                 (0.06, 1.50), (0.06, 1.56), (0.10, 1.60), (0.11, 1.70), (0.07, 1.78), (0, 1.80)],
                       steps: 24),
                 material: materials.cloth, at: (0, -60, 0)  // a plain figure 1.8 m tall: a body turned on the lathe

  part chess                                            // the rook, the board world's own design
    part rook                                           // 57 cm: turned, then two slots cut across its top
      field wood: material = materials.boxwood
      fn form() shape {
        let body  = lathe(profile: [(0, 0), (0.150, 0), (0.150, 0.018), (0.143, 0.026), (0.140, 0.034),
                                    (0.146, 0.042), (0.146, 0.050), (0.138, 0.058), (0.120, 0.064),
                                    (0.112, 0.074), (0.098, 0.092), (0.090, 0.115), (0.086, 0.160),
                                    (0.080, 0.330), (0.084, 0.370), (0.096, 0.392), (0.112, 0.400),
                                    (0.112, 0.412), (0.104, 0.420), (0.110, 0.428), (0.122, 0.440),
                                    (0.122, 0.560), (0.116, 0.568), (0.092, 0.568), (0.092, 0.545),
                                    (0, 0.545)],
                          steps: 96);
        let slots = union(box(x: -0.2 ..= 0.2, y: 0.515 ..= 0.6, z: -0.03 ..= 0.03),
                          box(x: -0.03 ..= 0.03, y: 0.515 ..= 0.6, z: -0.2 ..= 0.2));
        difference(body, slots)                         // four battlements
      }
      part body: form(), material: wood

  part sea: box(x: -400 ..= 400, y: -0.6 ..= -0.5, z: -400 ..= 400), material: materials.sea, at: (0, 0, 0)
  part island                                           // a round island: a sand beach sloping into the sea, a lawn on top
    part sandBank: lathe(profile: [(0, -0.55), (30, -0.55), (30, -0.3), (26, -0.05), (24, 0), (0, 0)], steps: 96),
                   material: materials.sand, at: (0, 0, 0)
    part grass: lathe(profile: [(0, -0.01), (20, -0.01), (20, 0.02), (0, 0.02)], steps: 96),
                material: materials.lawn, at: (0, 0, 0)
      solid(self, derived)                              // you can stand on it

  part plinth: box(x: -2.2 ..= 2.2, y: 0.02 ..= 0.098, z: -2.2 ..= 2.2), material: materials.frame
  part squares, at: (-1.75, 0.02, 1.75)                 // 64 squares of 50 cm; a1, dark, at the near left
    each file in 0 ..< 8 {
      each rank in 0 ..< 8 {
        part sq[8 * rank + file]: box(x: 0.5 * file - 0.25 ..= 0.5 * file + 0.25, y: 0 ..= 0.08,
                                      z: -0.5 * rank - 0.25 ..= -0.5 * rank + 0.25),
                                  material: if (file + rank) % 2 == 0 { materials.walnut } else { materials.maple }
      }
    }

  part pieces, at: (-1.75, 0.1, 1.75)                   // on a1's centre: files run along x, ranks away along -z
    part whiteRook: chess.rook, at: (0, 0, 0)
    part blackRook: chess.rook(wood: materials.ebony), at: (3.5, 0, -3.5)

  field held: part = None, mutable: true                // the piece picked up, if any
  each p in pieces.parts {                              // click a piece to pick it up
    on(clicked(p), set(held, p))
  }
  each s in squares.parts {                             // then a square: the piece glides there
    on(clicked(s), [start(transition(held.offset, to: s, over: sim(0.6 s))), set(held, None)])
  }

  part sun: sunLight(direction: (-0.4, 0.8, 0.45), color: color(1, 0.95, 0.88), lux: 70000 lux, castsShadow: true)
  part arrivals                                         // on the lawn at white's end, looking down the board
    part start, at: (0, 0.02, 5.6), facing: (0, -0.62, -1), eye: 3.2 m, camera: camera(lens: 35 mm)
