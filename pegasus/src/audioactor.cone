// Audio, a MOCK: it takes each snapshot and does nothing with it
actor Audio {
  snapshots: u64;

  fn init(self: &new) { *self = Self(0u64); }

  // Sim -> Audio (latest)
  pub async fn snapshot(self, s: Published) { snapshots = snapshots + 1u64; }

  pub async fn stop(self) {
    print <- "audio (mock): "; print <- snapshots; print <- " snapshots taken\n";
  }
}
