// The driven checks of connected play (`pegasus --checks`): the pure cores of netplay.cone run with no network, so a
// silent failure is caught by a number. Each has a mutant (PEGASUS_MUTANT) the check must fail:
//   no-replay        the samples after the acknowledged one are never replayed over the server's body
//   stale-personal   an older acknowledgement is taken as if it were the newest
//   stale-shared     an older shared snapshot is merged as if it were the newest
//   delta-vs-sent    a part change is measured against the last snapshot SENT, not the last one the client acknowledged,
//                    so a change in a lost snapshot is never sent again (the server's tracker, partsync.cone)
// The wire check has no mutant: it is a round trip of every message.

const CHECK_STEPS = 120u32;
const CHECK_DELAY = 6u32;           // the server's answer to sample N reaches the client at step N + this

// The body after the first 'n' samples of the check's walk: every sample walks forward, the look turning a little each step
fn walkYaw(i: u32) f32 { 0.01 * f32.from(i) }

fn truthAfter(n: u32) PersonState {
  var p = PersonState(Vec3(0., 0., 0.), 0.);
  var i = 1u32;
  while i <= n { applyBody(&mut p, 1., 0., walkYaw(i)); i = i + 1u32; }
  p
}

// A client walks for CHECK_STEPS steps; the server's word on sample N arrives CHECK_DELAY steps after it, and one
// answer in twenty is lost. Every answer the server gives is its body after sample N, run with the same body code.
// Passes if prediction was never wrong: no correction, no mismatch, and the body ends where the whole walk puts it
fn checkReconcile(skipReplay: bool) bool {
  var p = Predictor.make(Vec3(0., 0., 0.), skipReplay, false);
  var lost = 0u32;
  var s = 1u32;
  while s <= CHECK_STEPS {
    _ = p.sample(1., 0., walkYaw(s));
    p.smooth();
    if s > CHECK_DELAY {
      let n = s - CHECK_DELAY;
      if (n * 7919u32) % 20u32 == 0u32 {
        lost = lost + 1u32;      // this answer never arrives; the next carries a later number
      } else {
        let t = truthAfter(n);
        p.acknowledge(n, t.feet, t.yaw);
      }
    }
    s = s + 1u32;
  }
  let end = truthAfter(CHECK_STEPS);
  let off = (p.person.feet - end.feet).length();
  print <- "check reconcile (a "; print <- CHECK_DELAY; print <- "-step delay, "; print <- lost; print <- " of "; print <- CHECK_STEPS - CHECK_DELAY;
  print <- " answers lost): "; print <- p.acks; print <- " taken, "; print <- p.replayed; print <- " samples replayed, "; print <- p.corrections;
  print <- " corrections, "; print <- p.mismatches; print <- " mismatches, ends "; printF(off * 1000.); print <- " mm from the whole walk";
  let ok = p.acks > 0u64 && p.replayed > 0u64 && p.corrections == 0u64 && p.mismatches == 0u64 && off < PREDICT_TOLERANCE;
  if ok { print <- ": ok\n"; } else { print <- ": FAILED (an unacknowledged sample was not replayed)\n"; }
  ok
}

// The server answers sample 20, then an older answer (sample 10) arrives late. The older must be dropped: the body
// stays where sample 30 put it
fn checkStalePersonal(takeStale: bool) bool {
  var p = Predictor.make(Vec3(0., 0., 0.), false, takeStale);
  var s = 1u32;
  while s <= 30u32 { _ = p.sample(1., 0., walkYaw(s)); s = s + 1u32; }
  let t20 = truthAfter(20u32);
  p.acknowledge(20u32, t20.feet, t20.yaw);
  let t10 = truthAfter(10u32);
  p.acknowledge(10u32, t10.feet, t10.yaw);
  let end = truthAfter(30u32);
  let off = (p.person.feet - end.feet).length();
  print <- "check stale acknowledgement: "; print <- p.stale; print <- " dropped, body "; printF(off * 1000.); print <- " mm from where sample 30 puts it";
  let ok = p.stale == 1u64 && off < PREDICT_TOLERANCE;
  if ok { print <- ": ok\n"; } else { print <- ": FAILED (an old acknowledgement was merged)\n"; }
  ok
}

fn onePerson(id: u32, x: f32) OtherPersons {
  var l = OtherPersons();
  l.push(OtherPerson(id, Vec3(x, 0., 0.), 0.));
  l
}

// Shared snapshots 10 and 12 arrive, then an old one (9) with the person far away. The merge must show the person
// where 10 and 12 put it, and at the middle time the halfway place
fn checkSharedInterp(takeStale: bool) bool {
  var ip = Interpolator.make(takeStale);
  let step = i64.from(STEP_NS);
  let t0 = 1000000000i64;
  _ = ip.add(10u64, t0, onePerson(2u32, 0.));
  _ = ip.add(12u64, t0 + 2i64 * step, onePerson(2u32, 1.));
  _ = ip.add(9u64, t0 + 2i64 * step + 1000i64, onePerson(2u32, 999.));
  // half way between 10 and 12 is step 11: "now" is the newest's arrival plus (6 - 1) steps of delay
  let mid = ip.at(t0 + 2i64 * step + 5i64 * step);
  var midX: f32 = -1.;
  if mid.len() == 1usize { midX = mid[0usize].feet.x; }
  // past the newest, it holds the newest
  let late = ip.at(t0 + 2i64 * step + 20i64 * step);
  var lateX: f32 = -1.;
  if late.len() == 1usize { lateX = late[0usize].feet.x; }
  print <- "check shared snapshots: "; print <- ip.stale; print <- " stale dropped; at the middle the person is at x "; printF(midX);
  print <- ", past the newest at x "; printF(lateX);
  let ok = ip.stale == 1u64 && absf(midX - 0.5) < 0.02 && absf(lateX - 1.) < 0.001;
  if ok { print <- ": ok\n"; } else { print <- ": FAILED (a stale or misplaced snapshot was merged)\n"; }
  ok
}

// The wire: every message encoded, taken apart again, and a message cut short refused
fn checkWire() bool {
  var ok = true;
  // the shared snapshot: the people, and the changed parts after them, in a packet; a snapshot with no part changed
  // carries the count byte only
  var people = OtherPersons();
  people.push(OtherPerson(3u32, Vec3(1., 0., 2.), 0.5));
  var deltas = PartDeltas();
  var i = 0u32;
  while i < 12u32 { deltas.push(PartDelta(i * 5u32, FIELD_PLACEMENT, Mat4.fromTranslation(Vec3(f32.from(i), 0.5, -8.)), 0u64, noLook())); i = i + 1u32; }
  // a lamp's look on the wire: one delta of the look alone, intact after the round trip
  var lampDeltas = PartDeltas();
  var lamp = noLook();
  lamp.kind = LOOK_SPOT; lamp.shadows = true; lamp.dir = Vec3(0., -1., 0.25); lamp.color = Vec3(1., 0.8, 0.5); lamp.amount = 4000.5;
  lamp.reach = 9.; lamp.source = 0.07; lamp.cone = 0.6; lamp.softEdge = 0.2;
  lampDeltas.push(PartDelta(9u32, FIELD_LOOK, Mat4.identity(), 0u64, lamp));
  let lampTail = encodePartTail(5u64, &lampDeltas, 0u64);
  var lampFull = List[u8]();
  lampFull.appendSlice(encodePeople(3u64, &OtherPersons()).view());
  lampFull.appendList(lampTail.clone());
  var lStep = 0u64;
  var lPeople = OtherPersons();
  var lThrough = 0u64;
  var lGot = PartDeltas();
  var lHash = 0u64;
  var lampOk = decodeShared(bytesOfList(&lampFull), &mut lStep, &mut lPeople, &mut lThrough, &mut lGot, &mut lHash);
  lampOk = lampOk && lGot.len() == 1usize && lGot[0usize].mask == FIELD_LOOK && sameLook(&lGot[0usize].look, &lamp)
    && lampTail.len() == 1usize + 8usize + LOOK_DELTA_BYTES + 1usize;
  let head = encodePeople(77u64, &people);
  var full = List[u8]();
  full.appendSlice(head.view());
  full.appendList(encodePartTail(41u64, &deltas, 0xABCDEF0123456789u64));
  var gotStep = 0u64;
  var gotPeople = OtherPersons();
  var gotThrough = 0u64;
  var gotDeltas = PartDeltas();
  var gotHash = 0u64;
  let sharedBytes = bytesOfList(&full);
  var partsOk = decodeShared(sharedBytes, &mut gotStep, &mut gotPeople, &mut gotThrough, &mut gotDeltas, &mut gotHash)
    && gotStep == 77u64 && gotPeople.len() == 1usize && gotPeople[0usize].id == 3u32 && gotThrough == 41u64 && gotDeltas.len() == 12usize
    && gotDeltas[7usize].id == 35u32 && gotDeltas[7usize].placement.m[12] == 7. && full.len() <= 1173usize
    && gotHash == 0xABCDEF0123456789u64
    && partRoom(1usize) >= 12usize * PLACEMENT_DELTA_BYTES && lampOk && full.len() == head.len() + 1usize + 8usize + 12usize * PLACEMENT_DELTA_BYTES + 9usize;
  let atRest = bytesOfList(&encodePartTail(41u64, &PartDeltas(), 0u64));
  partsOk = partsOk && atRest.len() == 2usize && head.len() + atRest.len() == 9usize + 20usize + 2usize;
  // the hash: the same states hash alike, one part moved a hair hashes differently, and the order matters
  var hs = List[Mat4]();
  hs.push(Mat4.fromTranslation(Vec3(1., 2., 3.))); hs.push(Mat4.identity());
  var hs2 = List[Mat4]();
  hs2.push(Mat4.fromTranslation(Vec3(1., 2., 3.))); hs2.push(Mat4.identity());
  var ms = List[ContentKey]();
  ms.push(7u64); ms.push(9u64);
  var ls = List[PartLook]();
  ls.push(noLook()); ls.push(lamp);
  let h1 = statesHash(&hs, &ms, &ls);
  let sameHash = h1 == statesHash(&hs2, &ms, &ls) && h1 != 0u64;
  hs2.set(1usize, Mat4.fromTranslation(Vec3(0., 0., 0.0001)));
  partsOk = partsOk && sameHash && statesHash(&hs2, &ms, &ls) != h1;
  // a lamp's intensity alone changes the hash
  var ls2 = ls.clone();
  var dimmer = lamp;
  dimmer.amount = 4000.25;
  ls2.set(1usize, dimmer);
  partsOk = partsOk && statesHash(&hs, &ms, &ls2) != h1;
  // a material key alone changes the hash, and so does a key's high half
  var ms2 = ms.clone();
  ms2.set(1usize, 9u64 + 0x100000000u64);
  partsOk = partsOk && statesHash(&hs, &ms2, &ls) != h1;
  ms2.set(1usize, 10u64);
  partsOk = partsOk && statesHash(&hs, &ms2, &ls) != h1;
  print <- "check wire snapshot: "; print <- u64.from(head.len()); print <- " bytes of people, 12 changed parts in "; print <- u64.from(full.len());
  print <- " bytes, none changed adds "; print <- u64.from(atRest.len()); print <- " byte";
  if partsOk { print <- ": ok\n"; } else { print <- ": FAILED\n"; ok = false; }
  var shapes = ShapeTable();
  i = 0u32;
  while i < 40u32 { shapes.push(ContentShapes(7000u64 + u64.from(i), BoxShape(Vec3(0.5, 0.5, 0.5), Vec3(0., 0.5, 0.)), BoxShape(Vec3(0.6, 0.5, 0.5), Vec3(0., 0.25, 0.)))); i = i + 1u32; }
  let sm = encodeShapes(&shapes);
  var shapesGot = 0usize;
  var shapesOk = true;
  each m in &sm {
    let says = decodeServerSays(bytesOfList(m));
    if says.tag != S_SHAPES || m.len() > 1173usize { shapesOk = false; }
    each s in &says.shapes { if s.pick.half.x != 0.6 { shapesOk = false; } shapesGot = shapesGot + 1usize; }
  }
  shapesOk = shapesOk && shapesGot == 40usize;
  print <- "check wire shapes: "; print <- u64.from(shapesGot); print <- " of 40"; if shapesOk { print <- ": ok\n"; } else { print <- ": FAILED\n"; ok = false; }
  // the input: the newest MOST_SENT_SAMPLES of what is unacknowledged
  var p = Predictor.make(Vec3(0., 0., 0.), false, false);
  i = 1u32;
  while i <= 45u32 { _ = p.sample(1., 0.5, walkYaw(i)); i = i + 1u32; }
  let inb = bytesOfList(&p.encodeInput(9u64));
  var back = BodySamples();
  var backAck = 0u64;
  let inOk = decodeInput(inb, &mut back, &mut backAck) && backAck == 9u64 && back.len() == 30usize && back[0usize].seq == 16u32 && back[29usize].seq == 45u32 && back[29usize].strafe == 0.5;
  print <- "check wire input: "; print <- u64.from(back.len()); print <- " samples in "; print <- u64.from(inb.len()); print <- " bytes, the newest 30";
  if inOk { print <- ": ok\n"; } else { print <- ": FAILED\n"; ok = false; }
  // hello and a press
  let hello = decodeClientSays(bytesOfList(&encodeHello("worlds/first.ddd")));
  let press = decodeClientSays(bytesOfList(&encodePress(&Action(VERB_PRESS, 3u32, Vec3(1., 2., 3.), Vec3(0., 0., -1.), 99u64, ORIGIN_PERSON))));
  let msgOk = hello.tag == C_HELLO && hello.version == NET_VERSION && hello.world.view() == "worlds/first.ddd"
    && press.tag == C_PRESS && press.action.receiver == 3u32 && press.action.from.y == 2. && press.action.along.z == -1. && press.action.madeNs == 99u64;
  print <- "check wire hello and press"; if msgOk { print <- ": ok\n"; } else { print <- ": FAILED\n"; ok = false; }
  // a message cut short, and one with an unknown tag
  var cut = encodePress(&Action(VERB_PRESS, 3u32, Vec3(1., 2., 3.), Vec3(0., 0., -1.), 99u64, ORIGIN_PERSON));
  _ = cut.pop();
  let bad = decodeClientSays(bytesOfList(&cut));
  var junk = List[u8]();
  junk.push(200u8);
  let unknown = decodeClientSays(bytesOfList(&junk));
  var shortInput = encodeHelloOnlyHeader();
  var none = BodySamples();
  var noAck = 0u64;
  let badInput = decodeInput(bytesOfList(&shortInput), &mut none, &mut noAck);
  let refusalOk = bad.tag == 0u32 && unknown.tag == 0u32 && !badInput;
  print <- "check wire refuses a message cut short or unknown"; if refusalOk { print <- ": ok\n"; } else { print <- ": FAILED\n"; ok = false; }
  ok
}

// An input message that says 3 samples and holds half of one
fn encodeHelloOnlyHeader() List[u8] {
  var out = List[u8]();
  var k = 0usize;
  while k < 8usize { out.push(0u8); k = k + 1usize; }       // the part acknowledgement
  out.push(3u8); out.push(0u8); out.push(0u8); out.push(0u8); out.push(1u8); out.push(0u8);
  out
}

// The server moves part 1 at steps 3 and 4 and part 2 at step 9; a shared snapshot goes every 2 steps, each through the
// wire, and the one at step 4 is lost; the client acknowledges the newest version it applied, which reaches the server 2
// steps later. Passes if the client ends with every part where the server has it (the lost snapshot's change was sent
// again, because only an acknowledged change counts as delivered) and the parts at rest cost nothing at the end
fn checkPartDelta(vsSent: bool) bool {
  var defined = List[Mat4]();
  var now = List[Mat4]();
  var i = 0usize;
  while i < 3usize {
    defined.push(Mat4.fromTranslation(Vec3(f32.from(i), 0., 0.)));
    now.push(Mat4.fromTranslation(Vec3(f32.from(i), 0., 0.)));
    i = i + 1usize;
  }
  var definedMat = List[ContentKey]();
  var nowMat = List[ContentKey]();
  i = 0usize;
  while i < 3usize { definedMat.push(100u64 + u64.from(i)); nowMat.push(100u64 + u64.from(i)); i = i + 1usize; }
  var definedLook = List[PartLook]();
  i = 0usize;
  while i < 3usize { definedLook.push(noLook()); i = i + 1usize; }
  var nowLook = definedLook.clone();
  var lampLook = noLook();
  lampLook.kind = LOOK_POINT; lampLook.amount = 800.; lampLook.reach = 6.;
  var tracker = PartTracker.make(&defined, &definedMat, &definedLook, vsSent);
  var view = PartView.make(3usize);
  var lookOnly = 0u64;              // deltas that carried a look and nothing else
  var materialOnly = 0u64;          // deltas that carried a material key and no placement
  var materialWithPlace = 0u64;     // deltas that carried both
  var ackAtServer = 0u64;
  var due = 0u64;                   // the step the client's newest acknowledgement reaches the server
  var dueAck = 0u64;
  var sent = 0u64;
  var lastBytes = 0usize;
  var sentLate = 0u64;              // parts sent in the last ten snapshots
  var firstBytes = 0usize;
  var step = 1u64;
  while step <= 40u64 {
    if step == 3u64 || step == 4u64 { now.set(1usize, Mat4.fromTranslation(Vec3(10. + f32.from(step), 0., 0.))); _ = tracker.observe(1usize, &now[1usize]); }
    if step == 9u64 { now.set(2usize, Mat4.fromTranslation(Vec3(50., 0., 0.))); _ = tracker.observe(2usize, &now[2usize]); }
    // part 0 changes its material alone at step 12, and part 2 changes it again at step 15 (the snapshot at 16 carries it)
    if step == 12u64 { nowMat.set(0usize, 200u64); _ = tracker.observeMaterial(0usize, 200u64); }
    if step == 15u64 { nowMat.set(2usize, 300u64); _ = tracker.observeMaterial(2usize, 300u64); }
    // part 1 is a lamp turned on at step 17 (the snapshot at 18 carries it)
    if step == 17u64 { nowLook.set(1usize, lampLook); _ = tracker.observeLook(1usize, &nowLook[1usize]); }
    if due != 0u64 && step >= due { if dueAck > ackAtServer { ackAtServer = dueAck; } due = 0u64; }
    if step % 2u64 == 0u64 {
      var deltas = PartDeltas();
      let through = tracker.select(ackAtServer, 8usize * DELTA_BYTES, false, &mut deltas);
      var full = List[u8]();
      full.appendSlice(encodePeople(step, &OtherPersons()).view());
      full.appendList(encodePartTail(through, &deltas, 0u64));
      lastBytes = full.len();
      if firstBytes == 0usize && deltas.len() > 0usize { firstBytes = full.len(); }
      sent = sent + u64.from(deltas.len());
      if step > 20u64 { sentLate = sentLate + u64.from(deltas.len()); }
      if step != 4u64 {              // the snapshot at step 4 never arrives
        var gotStep = 0u64;
        var people = OtherPersons();
        var gotThrough = 0u64;
        var got = PartDeltas();
        var gotHash = 0u64;
        if decodeShared(bytesOfList(&full), &mut gotStep, &mut people, &mut gotThrough, &mut got, &mut gotHash) {
          each d in &got {
            if d.mask == FIELD_LOOK { lookOnly = lookOnly + 1u64; }
            if (d.mask & FIELD_MATERIAL) != 0u32 {
              if (d.mask & FIELD_PLACEMENT) == 0u32 { materialOnly = materialOnly + 1u64; } else { materialWithPlace = materialWithPlace + 1u64; }
            }
          }
          view.apply(gotStep, gotThrough, &got);
          if view.ack > dueAck { dueAck = view.ack; due = step + 2u64; }
        }
      }
    }
    step = step + 1u64;
  }
  var same = true;
  i = 0usize;
  while i < 3usize {
    let shown = view.placeAt(i, 0., 40u64, &defined[i]);
    if !sameMat(&shown, &now[i]) { same = false; }
    i = i + 1usize;
  }
  // the client's materials are the server's, and a change of material alone was sent as that key alone
  let gotMat = view.materials(&definedMat);
  var matSame = true;
  i = 0usize;
  while i < 3usize { if *gotMat[i] != *nowMat[i] { matSame = false; } i = i + 1usize; }
  // ... and its looks, the lamp turned on sent as the look alone
  let gotLook = view.looks(&definedLook);
  var lookSame = true;
  i = 0usize;
  while i < 3usize { if !sameLook(&gotLook[i], &nowLook[i]) { lookSame = false; } i = i + 1usize; }
  same = same && matSame && materialOnly >= 1u64 && lookSame && lookOnly >= 1u64;
  print <- "check part deltas (the snapshot at step 4 lost): "; print <- sent; print <- " part states sent in all, "; print <- sentLate;
  print <- " in the last twenty steps, the snapshot "; print <- u64.from(firstBytes); print <- " bytes with a part and "; print <- u64.from(lastBytes);
  print <- " at rest; the client's parts "; if same { print <- "match"; } else { print <- "DIFFER from"; } print <- " the server's";
  let ok = same && sentLate == 0u64 && sent >= 3u64;
  if ok { print <- ": ok\n"; } else { print <- ": FAILED (a change was lost, or a part at rest was resent)\n"; }
  ok
}

pub fn checkConnected() bool {
  let a = checkReconcile(mutantIs("no-replay"));
  let b = checkStalePersonal(mutantIs("stale-personal"));
  let c = checkSharedInterp(mutantIs("stale-shared"));
  let d = checkWire();
  let e = checkPartDelta(mutantIs("delta-vs-sent"));
  a && b && c && d && e
}
