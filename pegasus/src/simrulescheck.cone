// The driven check of Sim's rules (`--checks`): a handler staged, applied, and dropped whole when it traps, with no
// window, GPU or thread. Hand-assembled code stands for a world's, as guidebrowser\src\simcheck.cone does for the guide
// browser's host; the world's own rule (first.ddd's click) is driven end to end by `--world ... --press`.
//
//   a handler that sets field 0 to 5 and then 6: its two writes apply, in order, once it has returned (the field is 6)
//   a handler that sets field 0 and then traps: the field is as it was and the world is told (stopped 1)
//   a click on a part no rule holds: no rule runs
//
// PEGASUS_MUTANT=trapped-writes hands a trapped handler's writes back anyway; the second check must catch it.

// A handler that sets field 0 to 5 and then to 6 and, if 'trap', then runs `unreachable`: pick-and-place rule 0
fn setTwiceCode(trap: bool) Code {
  var cw = CodeWriter.make();
  let setSig = setFieldSignature(&mut cw.code.types);
  let imp = cw.addImport(NS_HOST, HOST_SET_FIELD, setSig);
  let none = List[u32]();
  let sig = cw.code.types.sig(none.view(), none.view());
  let u = cw.beginUnit(sig, "h");
  cw.i64Const(0i64); cw.f64Const(5.); cw.opU(OP_IMPORT, imp);
  cw.i64Const(0i64); cw.f64Const(6.); cw.opU(OP_IMPORT, imp);
  if trap { cw.op(OP_UNREACHABLE); }
  cw.endUnit();
  cw.addEntry(ENTRY_HANDLER, u, ENTRY_MOVE_FLAG, 0u32);
  var done = Code.empty();
  done <-> cw.code;
  done
}

// A world of two slots (the world, and slot 1 that the rule holds) with one field, 'held', beginning at 0
fn tinyBehaviour(trap: bool) Behaviour {
  var frames = SlotFrames();
  frames.push(SlotFrame(String.from("world"), 0u32, Vec3(0., 0., 0.), Quat.identity()));
  frames.push(SlotFrame(String.from("piece"), 0u32, Vec3(0., 0., 0.), Quat.identity()));
  var fields = FieldDecls();
  fields.push(FieldDecl(String.from("held"), 0.));
  var moves = MoveDecls();
  moves.push(MoveDecl(1u32, 0u32));
  Behaviour(setTwiceCode(trap), frames, fields, DeriveDecls(), moves, KeysDecls(), AreaDecls(), NO_AVATAR)
}

// Two handlers: rule 0 (slot 1) sets field 0 to 5; rule 1 (slot 2) is code the verifier refuses (a call with no
// operands on the stack). The world's other rule must go on working
fn oneBadRuleBehaviour() Behaviour {
  var cw = CodeWriter.make();
  let setSig = setFieldSignature(&mut cw.code.types);
  let imp = cw.addImport(NS_HOST, HOST_SET_FIELD, setSig);
  let none = List[u32]();
  let sig = cw.code.types.sig(none.view(), none.view());
  let good = cw.beginUnit(sig, "good");
  cw.i64Const(0i64); cw.f64Const(5.); cw.opU(OP_IMPORT, imp);
  cw.endUnit();
  let bad = cw.beginUnit(sig, "bad");
  cw.opU(OP_IMPORT, imp);
  cw.endUnit();
  cw.addEntry(ENTRY_HANDLER, good, ENTRY_MOVE_FLAG, 0u32);
  cw.addEntry(ENTRY_HANDLER, bad, ENTRY_MOVE_FLAG | 1u32, 0u32);
  var code = Code.empty();
  code <-> cw.code;
  var frames = SlotFrames();
  frames.push(SlotFrame(String.from("world"), 0u32, Vec3(0., 0., 0.), Quat.identity()));
  frames.push(SlotFrame(String.from("goodPiece"), 0u32, Vec3(0., 0., 0.), Quat.identity()));
  frames.push(SlotFrame(String.from("badPiece"), 0u32, Vec3(0., 0., 0.), Quat.identity()));
  var fields = FieldDecls();
  fields.push(FieldDecl(String.from("held"), 0.));
  var moves = MoveDecls();
  moves.push(MoveDecl(1u32, 0u32));
  moves.push(MoveDecl(2u32, 1u32));
  Behaviour(code, frames, fields, DeriveDecls(), moves, KeysDecls(), AreaDecls(), NO_AVATAR)
}

fn rulesVerdict(ok: bool, what: &str) bool {
  print <- "check rules: "; printStr(what); print <- if ok { " ok\n" } else { " WRONG\n" };
  ok
}

// A world with a block that turns, started at creation, one 120 degree turn in four seconds; a field 'near' that a derive
// sets from the area round the block
const ANIM_WORLD = "
part hello
  part materials
    part stone: plain(srgb(140, 140, 135))
  part block: box(x: -0.3 ..= 0.3, y: 0.4 ..= 1, z: -0.3 ..= 0.3), material: materials.stone, at: (0, 0, 0)
    field near: bool = false
    area(self, sphere(radius: 2 m, at: (0, 0.7, 0)))
    derive(near, occupied(self, by: me))
  part arrivals
    part start, at: (0, 0, 3), facing: (0, 0, -1)
  on(created, start(keys(block.rotation,
      [key(sim(0 s), rotation(0 deg)), key(sim(4 s), rotation(120 deg))],
      loop: loop, ease: linear)))
";

// The slot named 'name' (or the world's, 0)
fn slotNamed(r: &SimRules, name: &str) u32 {
  var s = 0usize;
  while s < r.slots.count() {
    if r.slots.nameOf(u32.from(s)) == name { return u32.from(s); }
    s = s + 1usize;
  }
  0u32
}

// The animators and the areas, driven. After 30 steps (half a second) the block has turned 15 degrees of its 120 in
// four seconds: its turn's w is cos(7.5 deg) = 0.99144. An animator that never advances leaves w 1; one that advances
// twice a step is at 30 degrees, w 0.96593. 'mutant' is the check's: PEGASUS_MUTANT=anim-never or anim-twice
fn checkAnimators(mutant: u32) bool {
  var all = true;
  var image = readImage("anim.ddd", ANIM_WORLD);
  var behaviour = Behaviour.none();
  behaviour <-> image.behaviour;
  var r = SimRules.make(behaviour, false);
  r.anim.mutant = mutant;
  let block = slotNamed(&r, "block");
  var step = 1u64;
  while step <= 31u64 { r.animate(step, STEP_NS); step = step + 1u64; }
  let q = r.slots.turnOf(block);
  let d = q.w - 0.991445;
  all = rulesVerdict(r.keysRuleCount() == 1usize && r.anim.started == 1u64 && r.anim.ticks == 31u64 && block != 0u32,
    "the world's created keys rule is started once and the clock is ticked once a step") && all;
  all = rulesVerdict(d < 0.0005 && d > -0.0005 && q.y > 0.1,
    "after half a second the block has turned 15 of its 120 degrees") && all;
  // the places Sim publishes are the animated ones
  r.slots.refresh();
  let place = r.slots.place(block);
  all = rulesVerdict(place.translation().y == 0., "an animated turn leaves the block where it stood") && all;
  // areas: host.occupied now gives the area's value
  r.sense(Vec3(0., 1.6, 3.));
  r.derive(32u64);
  let far = r.fieldValue(0usize);
  r.sense(Vec3(0., 1.6, 1.));
  r.derive(33u64);
  all = rulesVerdict(far == 0. && r.fieldValue(0usize) == 1. && r.inside(block),
    "host.occupied is false with the visitor 3 m off, true at 1.3 m, and the derive says so") && all;
  all
}

// A lantern whose glass holds a lamp, lit by a tint derive from an area (W145): the derive's tint reaches `takeTints`, once per
// change, and the lamp's light is a part inside the glass. 'deaf' is the check's mutant (PEGASUS_MUTANT=tint-deaf): the
// rules never note a tint
const TINT_WORLD = "
part hello
  part materials
    part stone: plain(srgb(140, 140, 135))
  part lantern, at: (0, 0, -2)
    part glass: box(x: -0.11 ..= 0.11, y: 0.94 ..= 1.2, z: -0.11 ..= 0.11), material: materials.stone
      part flame: pointLight(reach: 8 m, intensity: 400 candela, source: 0.03 m), at: (0, 1.07, 0)
    field near: bool = false
    area(self, sphere(radius: 2.5 m, at: (0, 1, 0)))
    derive(near, occupied(self, by: me))
    derive(glass.tint, if near { 1 } else { 0 })
  part arrivals
    part start, at: (0, 0, 3), facing: (0, 0, -1)
";

fn checkTint(deaf: bool) bool {
  var all = true;
  var image = readImage("tint.ddd", TINT_WORLD);
  var behaviour = Behaviour.none();
  behaviour <-> image.behaviour;
  var r = SimRules.make(behaviour, false);
  r.tintDeaf = deaf;
  let glass = slotNamed(&r, "glass");
  let flame = slotNamed(&r, "flame");
  r.sense(Vec3(0., 1.6, 3.));                    // 5 m from the lantern: nobody near
  r.derive(1u64);
  let off = r.takeTints();
  r.sense(Vec3(0., 1.6, 3.));
  r.derive(2u64);
  let still = r.takeTints();
  r.sense(Vec3(0., 1.6, -1.));                   // 1 m from it
  r.derive(3u64);
  let on = r.takeTints();
  all = rulesVerdict(glass != 0u32 && off.len() == 1usize && off[0usize].slot == glass && off[0usize].value == 0.,
    "a tint derive with nobody near tints the glass 0, noted once") && all;
  all = rulesVerdict(still.len() == 0usize, "the same tint again is not noted again") && all;
  all = rulesVerdict(on.len() == 1usize && on[0usize].value == 1., "a visitor 1 m off tints the glass 1") && all;
  all = rulesVerdict(flame != 0u32 && r.slots.within(flame, glass), "the lamp's light is a part inside the tinted glass") && all;
  all
}

pub fn checkRules(applyOnTrap: bool) bool {
  var all = true;
  all = checkTint(mutantIs("tint-deaf")) && all;
  var stepMutant = STEP_MUTANT_NONE;
  if mutantIs("step-never") { stepMutant = STEP_MUTANT_NEVER; }
  if mutantIs("step-twice") { stepMutant = STEP_MUTANT_TWICE; }
  if mutantIs("step-drop") { stepMutant = STEP_MUTANT_DROP; }
  all = checkSteps(stepMutant) && all;
  var animMutant = ANIM_MUTANT_NONE;
  if mutantIs("anim-never") { animMutant = ANIM_MUTANT_NEVER; }
  if mutantIs("anim-twice") { animMutant = ANIM_MUTANT_TWICE; }
  all = checkAnimators(animMutant) && all;
  {
    var r = SimRules.make(tinyBehaviour(false), applyOnTrap);
    var asks = GlideAsks();
    let held = r.click(1u32, 1u64, &mut asks);
    all = rulesVerdict(held && r.fieldValue(0usize) == 6. && r.fired == 1u64 && r.stopped == 0u64,
      "a handler's two writes apply, in order, when it returns") && all;
    let none = r.click(0u32, 2u64, &mut asks);
    all = rulesVerdict(!none && r.fired == 1u64, "a click on a part no rule holds runs nothing") && all;
  }
  {
    var r = SimRules.make(tinyBehaviour(true), applyOnTrap);
    var asks = GlideAsks();
    _ = r.click(1u32, 1u64, &mut asks);
    all = rulesVerdict(r.fieldValue(0usize) == 0. && r.stopped == 1u64 && r.fired == 0u64,
      "a handler that traps leaves its writes unapplied, and the world is told") && all;
  }
  {
    // one rule the verifier refuses: the host is made, the bad rule does nothing, the good rule still runs
    var r = SimRules.make(oneBadRuleBehaviour(), applyOnTrap);
    var asks = GlideAsks();
    let bad = r.click(2u32, 1u64, &mut asks);
    let untouched = r.fieldValue(0usize) == 0. && r.fired == 0u64;
    let good = r.click(1u32, 2u64, &mut asks);
    all = rulesVerdict(r.live() && r.refusedCount() == 1usize && bad && untouched && good && r.fieldValue(0usize) == 5. && r.fired == 1u64,
      "a world with one refused rule keeps its other rule: 1 refused, the bad click does nothing, the good click runs") && all;
  }
  all
}

// Step functions (W148, FOR REVIEW), driven. Two birds a (0, 1, 0) and b (3, 1, 0), velocities (1, 0, 0) and (2, 0, 0). Each step
// a bird doubles its velocity, clamps it to 1.5 (an if, length, scaling), looks along it, and moves to the other's place plus
// the clamped velocity times the step: a swap, which shows only if each bird read the world as it stood at the step's start
// (a loop over the holder's parts, `dot`, points). After one step, a stands at (3.025, 1, 0), b at (0.025, 1, 0), and a faces +x.
// 'mutant' is the check's (PEGASUS_MUTANT=step-never, step-twice, step-drop)
const STEP_WORLD = "
part hello
  part materials
    part stone: plain(srgb(140, 140, 135))
  part bird: box(x: -0.1 ..= 0.1, y: -0.1 ..= 0.1, z: -0.1 ..= 0.1), material: materials.stone
    field velocity: place = (0, 0, 0), mutable: true
  part pair
    part a: bird(velocity: (1, 0, 0)), at: (0, 1, 0)
    part b: bird(velocity: (2, 0, 0)), at: (3, 1, 0)
  fn swap(p: part, dt: duration) bool {
    var target = p.place;
    each o in pair.parts {
      let d = o.place - p.place;
      if dot(d, d) > 0.001 { target = o.place; }
    }
    var v = p.velocity * 2;
    if length(v) > 1.5 { v = v * (1.5 / length(v)); }
    set(p.velocity, v);
    set(p.place, target + v * dt);
    set(p.facing, v);
    true
  }
  each p in pair.parts {
    on(created, start(stepAnimator(p, step: swap)))
  }
  part arrivals
    part start, at: (0, 0, 3), facing: (0, 0, -1)
";

fn near(x: f32, y: f32) bool { let d = x - y; d < 0.002 && d > -0.002 }

fn checkSteps(mutant: u32) bool {
  var all = true;
  var image = readImage("steps.ddd", STEP_WORLD);
  var behaviour = Behaviour.none();
  behaviour <-> image.behaviour;
  var r = SimRules.make(behaviour, false);
  r.steps.mutant = mutant;
  let a = slotNamed(&r, "a");
  let b = slotNamed(&r, "b");
  all = rulesVerdict(r.live() && r.refusedCount() == 0usize && a != 0u32 && b != 0u32 && r.steps.units.len() == 2usize,
    "a world with a step function and two steppers is verified with nothing refused") && all;
  r.animate(1u64, STEP_NS);            // the created rule starts the steppers
  r.stepAll(1u64, STEP_NS);
  r.slots.refresh();
  let pa = r.slots.place(a).translation();
  let pb = r.slots.place(b).translation();
  all = rulesVerdict(near(pa.x, 3.025) && near(pa.y, 1.) && near(pb.x, 0.025) && near(pb.y, 1.),
    "after one step the birds have swapped places and each moved 1.5 m/s: each read the world as it stood at the step's start") && all;
  let q = r.slots.turnOf(a);
  all = rulesVerdict(q.y > 0.7 && q.y < 0.72 && q.w > 0.7 && q.w < 0.72, "set(p.facing, v) turns a to face +x (90 degrees about y)") && all;
  all = rulesVerdict(r.steps.dropped == 0u64 && r.steps.runs == 2u64, "both steppers ran, none stopped") && all;
  all
}
