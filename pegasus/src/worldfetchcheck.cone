// The world fetch's driven checks (`pegasus --checks`): the manifest's lines, the location of a file beside its manifest, and a
// manifest world read from disk comes out as its files' texts in order, a newline between two that did not have one. (The URL
// path is measured end to end by tools\arrival-test.ps1: a served world arrives with the same keys and every check of the run.)

fn fetchLine(name: &str, good: bool) bool {
  print <- "check world fetch "; printStr(name);
  if good { print <- ": ok\n"; } else { print <- ": FAILED\n"; }
  good
}

fn writeText(path: &Path, text: &str) {
  var b = List[u8]();
  let raw: &Array[u8] = text;
  b.appendSlice(raw);
  match fs.writeFile(path, b.view()) { else {} }
}

// "NAME SIZE HASH PATH\n" for a file whose text is 'text'
fn manifestLineOf(name: &str, text: &str, path: &str) String {
  var s = String.from(name);
  s.append(" ");
  s.append(numberLine("", u64.from(text.len()), "").view());
  s.append(" ");
  s.append(cacheHex(contentHash(text)).view());
  s.append(" ");
  s.append(path);
  s.append("\n");
  s
}

// 'skipHash' is the mutant (PEGASUS_MUTANT=manifest-skip-hash): the hash is not looked at, so the wrong-hash lines must FAIL
fn checkWorldFetch(skipHash: bool) bool {
  var all = true;
  let names = manifestEntries("// the files\n a.ddd 3 00000000000000ff first.a\n\n b.ddd 10 0123456789abcdef first.b\r\n  // left out\nc.ddd 4 zz");
  all = fetchLine("a manifest lists its files in order, without blanks and comments, with size, hash and path",
    names.len() == 3usize && names[0].name.view() == "a.ddd" && names[1].name.view() == "b.ddd" && names[2].name.view() == "c.ddd"
    && names[0].ok && names[0].size == 3u64 && names[0].hash == 255u64 && names[0].path.view() == "first.a"
    && names[1].ok && names[1].size == 10u64 && names[1].hash == 81985529216486895u64 && names[1].path.view() == "first.b") && all;
  all = fetchLine("a manifest line that is not whole is not ok", !names[2].ok) && all;
  all = fetchLine("a number that is not a number, or a hash of the wrong length, is not ok",
    !manifestEntries("a.ddd 3x 00000000000000ff p")[0].ok && !manifestEntries("a.ddd 3 0000ff p")[0].ok
    && !manifestEntries("a.ddd 3 00000000000000fg p")[0].ok) && all;
  let good = "part a\n";
  all = fetchLine("a file of the size and hash the manifest gives is fine",
    judgeFile(7u64, contentHash(good), good, skipHash) == FILE_FINE) && all;
  all = fetchLine("a file of another size is judged by its size",
    judgeFile(8u64, contentHash(good), good, skipHash) == FILE_WRONG_SIZE) && all;
  all = fetchLine("a file of the right size and another hash is judged by its hash",
    judgeFile(7u64, contentHash("part b\n"), good, skipHash) == FILE_WRONG_HASH) && all;
  all = fetchLine("a file is found beside its manifest, by URL or by path",
    siblingOf("http://127.0.0.1:80/w/x.world", "a.ddd").view() == "http://127.0.0.1:80/w/a.ddd"
    && siblingOf("C:\\w\\x.world", "a.ddd").view() == "C:\\w\\a.ddd" && siblingOf("x.world", "a.ddd").view() == "a.ddd") && all;
  all = fetchLine("a location is told as a URL or a path, a manifest by its ending",
    isUrl("http://h/x") && isUrl("https://h/x") && !isUrl("C:\\x") && isManifest("a/b.world") && !isManifest("a/b.ddd")) && all;
  var temp = fs.tempDir();
  var root = Path.from("");
  match &temp { case let Ok(t) { root = t.path().clone(); } else {} }
  let dir = root.join("fetch");
  match fs.makeDirAll(&dir) { else {} }
  writeText(&dir.join("one.ddd"), "part first\n");
  writeText(&dir.join("two.ddd"), "  part a");              // no newline at its end
  writeText(&dir.join("three.ddd"), "  part b\n");
  var listing = String.from("// three files\n");
  listing.append(manifestLineOf("one.ddd", "part first\n", "first").view());
  listing.append(manifestLineOf("two.ddd", "  part a", "first.a").view());
  listing.append(manifestLineOf("three.ddd", "  part b\n", "first.b").view());
  writeText(&dir.join("w.world"), listing.view());
  let whole = readWorldNow(dir.join("w.world").view());
  all = fetchLine("a manifest world read from disk is its files in order, one line each",
    whole.view() == "part first\n  part a\n  part b\n") && all;
  all = fetchLine("a world file that is not a manifest reads as itself", readWorldNow(dir.join("one.ddd").view()).view() == "part first\n") && all;
  var gone = String.from(manifestLineOf("one.ddd", "part first\n", "first").view());
  gone.append(manifestLineOf("missing.ddd", "x", "first.x").view());
  writeText(&dir.join("gone.world"), gone.view());
  all = fetchLine("a manifest naming a file that is not there reads as nothing", readWorldNow(dir.join("gone.world").view()).len() == 0usize) && all;
  // a file whose hash is another's (same size), and one whose size is wrong: each is left out, and only that one
  var wrong = String.from(manifestLineOf("one.ddd", "part first\n", "first").view());
  wrong.append(manifestLineOf("two.ddd", "  part x", "first.a").view());
  wrong.append(manifestLineOf("three.ddd", "  part b\nmore", "first.b").view());
  writeText(&dir.join("wrong.world"), wrong.view());
  let rest = readWorldNow(dir.join("wrong.world").view());
  all = fetchLine("a file of the wrong hash or the wrong size is left out of the world, and the others stay",
    rest.view() == "part first\n") && all;
  var wrongHash = String.from(manifestLineOf("one.ddd", "part first\n", "first").view());
  wrongHash.append(manifestLineOf("two.ddd", "  part x", "first.a").view());
  wrongHash.append(manifestLineOf("three.ddd", "  part b\n", "first.b").view());
  writeText(&dir.join("wronghash.world"), wrongHash.view());
  all = fetchLine("a file of the wrong hash alone is left out and the others stay",
    readWorldNow(dir.join("wronghash.world").view()).view() == "part first\n  part b\n") && all;
  // files kept by content hash: a kept file is read back; another size, or damaged bytes, is a miss
  let keep = dir.join("kept");
  let body = "part kept\n";
  all = fetchLine("a file is kept under its hash and read back",
    storeKeptFile(&keep, contentHash(body), body) && match loadKeptFile(&keep, 10u64, contentHash(body)) { case let Some(t) { t.view() == body } case is None[String] { false } }) && all;
  all = fetchLine("a kept file of another size is not given",
    match loadKeptFile(&keep, 11u64, contentHash(body)) { case is Some[String] { false } case is None[String] { true } }) && all;
  writeText(&keptFilePath(&keep, contentHash(body)), "part kepx\n");
  all = fetchLine("a kept file whose bytes were changed is not given",
    match loadKeptFile(&keep, 10u64, contentHash(body)) { case is Some[String] { false } case is None[String] { true } }) && all;
  // the manifest as a whole: a table that cannot be read, or names a file twice, is a fault (the world does not open); a bad field on
  // one line is only that file's
  let goodTable = "a.ddd 3 00000000000000ff first.a\nb.ddd 10 0123456789abcdef first.b\n";
  all = fetchLine("a sound manifest has no fault", manifestFault(goodTable, &manifestEntries(goodTable)).len() == 0usize) && all;
  let junk = "<html>\n<body>404 not here</body>\n</html>\n";
  all = fetchLine("a manifest that is not a manifest (an error page) is a fault",
    manifestFault(junk, &manifestEntries(junk)).len() > 0usize) && all;
  var binary = String.from("a.ddd 3 00000000000000ff first.a\n");
  binary.appendByte(1u8); binary.appendByte(2u8);
  all = fetchLine("a manifest with control bytes is a fault", manifestFault(binary.view(), &manifestEntries(binary.view())).len() > 0usize) && all;
  let cutTable = "a.ddd 3 00000000000000ff first.a\nb.ddd 10 0123456789ab";
  all = fetchLine("a manifest cut off in the middle of a line is a fault", manifestFault(cutTable, &manifestEntries(cutTable)).len() > 0usize) && all;
  let emptyTable = "// nothing here\n\n";
  all = fetchLine("a manifest that lists no file is a fault", manifestFault(emptyTable, &manifestEntries(emptyTable)).len() > 0usize) && all;
  let twice = "a.ddd 3 00000000000000ff first.a\nb.ddd 10 0123456789abcdef first.b\na.ddd 3 00000000000000ff first.a\n";
  let twiceFault = manifestFault(twice, &manifestEntries(twice));
  all = fetchLine("a manifest naming a file twice is a fault", twiceFault.len() > 0usize) && all;
  let badField = "a.ddd 3x 00000000000000ff first.a\nb.ddd 10 0123456789abcdef first.b\n";
  let badEntries = manifestEntries(badField);
  all = fetchLine("a bad size or hash on one line is no fault of the manifest: that line's file alone is not ok",
    manifestFault(badField, &badEntries).len() == 0usize && !badEntries[0].ok && badEntries[1].ok) && all;
  // each file's place, from its own text alone: the indent and the part its first line of code declares (none if it starts with
  // something else, or has no code); the manifest's path must end in that part
  let p0 = placeOfText("part first\n");
  let p1 = placeOfText("// a comment\n\n  part materials\n    part lawn: physical(color: x)\n");
  let p2 = placeOfText("  worldAvatars(cast: [a])\n  part people\n");
  let p3 = placeOfText("// only a comment\n");
  all = fetchLine("a file's place is read from its first line of code alone",
    p0.has && p0.indent == 0usize && p0.name.view() == "first" && p1.has && p1.indent == 2usize && p1.name.view() == "materials"
    && p2.has && p2.indent == 2usize && p2.name.len() == 0usize && !p3.has) && all;
  all = fetchLine("a path fits a file that declares its last part, or has nothing of its own to compare",
    placeFits("first.materials", &p1) && !placeFits("first.sea", &p1) && !placeFits("materials2", &p1) && placeFits("first", &p2)
    && placeFits("anything", &p3) && placeFits("first", &p0)) && all;
  // a manifest whose path for a file is wrong (it says first.sea; the file begins at first.island), read from disk: that file is left
  // out and the others stay; and a manifest that is a fault reads as nothing
  writeText(&dir.join("p1.ddd"), "part first\n");
  writeText(&dir.join("p2.ddd"), "  part island\n");
  writeText(&dir.join("p3.ddd"), "  part sea\n");
  var placedWorld = String.from(manifestLineOf("p1.ddd", "part first\n", "first").view());
  placedWorld.append(manifestLineOf("p2.ddd", "  part island\n", "first.sea").view());
  placedWorld.append(manifestLineOf("p3.ddd", "  part sea\n", "first.sea").view());
  writeText(&dir.join("placed.world"), placedWorld.view());
  all = fetchLine("a file whose declared place is not the manifest's path is left out and the others stay",
    readWorldNow(dir.join("placed.world").view()).view() == "part first\n  part sea\n") && all;
  var rightWorld = String.from(manifestLineOf("p1.ddd", "part first\n", "first").view());
  rightWorld.append(manifestLineOf("p2.ddd", "  part island\n", "first.island").view());
  rightWorld.append(manifestLineOf("p3.ddd", "  part sea\n", "first.sea").view());
  writeText(&dir.join("right.world"), rightWorld.view());
  all = fetchLine("the same files with the right paths all stay",
    readWorldNow(dir.join("right.world").view()).view() == "part first\n  part island\n  part sea\n") && all;
  var dupWorld = String.from(rightWorld.view());
  dupWorld.append(manifestLineOf("p1.ddd", "part first\n", "first").view());
  writeText(&dir.join("dup.world"), dupWorld.view());
  all = fetchLine("a manifest naming a file twice reads as nothing: the world does not open", readWorldNow(dir.join("dup.world").view()).len() == 0usize) && all;
  all = fetchLine("a file that was never kept is not given",
    match loadKeptFile(&keep, 3u64, contentHash("abc")) { case is Some[String] { false } case is None[String] { true } }) && all;
  // a file in the middle that is left out (its hash is wrong) moves no later file's place, though a later file is a child of what it held
  writeText(&dir.join("d1.ddd"), "part first\n");
  writeText(&dir.join("d2.ddd"), "  part islanX\n");
  writeText(&dir.join("d3.ddd"), "    part dock\n");
  writeText(&dir.join("d4.ddd"), "  part sea\n");
  var droppedWorld = String.from(manifestLineOf("d1.ddd", "part first\n", "first").view());
  droppedWorld.append(manifestLineOf("d2.ddd", "  part island\n", "first.island").view());
  droppedWorld.append(manifestLineOf("d3.ddd", "    part dock\n", "first.island.dock").view());
  droppedWorld.append(manifestLineOf("d4.ddd", "  part sea\n", "first.sea").view());
  writeText(&dir.join("dropped.world"), droppedWorld.view());
  all = fetchLine("a file left out in the middle leaves the later files in their places",
    readWorldNow(dir.join("dropped.world").view()).view() == "part first\n    part dock\n  part sea\n") && all;
  // the files arrive in any order: nothing is read until the first file is in; a read under way holds the next until it is done; the
  // whole world (rules, derives, looks) is read only when every file is in. PEGASUS_MUTANT=rules-early reads it from the first file on
  var a = FileArrival.make(4usize, mutantIs("rules-early"));
  a.arrive(1usize);
  let n0 = a.next();
  a.arrive(0usize);
  let n1 = a.next();
  let allInThen = a.allIn();
  a.arrive(3usize);
  let n2 = a.next();
  a.readDone(false);
  let n3 = a.next();
  a.arrive(2usize);
  let wholeNow = a.allIn();
  let n4 = a.next();
  a.readDone(true);
  let n5 = a.next();
  all = fetchLine("files in any order: no read until the first file is in, a prefix read while others are missing, the whole only when every file is in",
    n0 == READ_NONE && n1 == READ_PREFIX && !allInThen && n2 == READ_NONE && n3 == READ_NONE && wholeNow && n4 == READ_WHOLE && n5 == READ_NONE
    && a.files() == 4usize) && all;
  all
}
