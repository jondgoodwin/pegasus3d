// Player: the person at the keyboard and mouse. It turns their input into
// intents (state: MoveIntent, and LookIntent, which is also the mouse-look
// slot Render reads the head pose from) and a pointer press into an action
// for Sim, aimed along the frame as Render drew it (DrawnFrame). It starts
// the zone's Sim, in startZoneSim, then asks the Loader to open the world for
// it (`Browser\doc\actors\player.md`; messages.cone rows 1, 5 and 6; proposed).
//
// Its behaviours: start (once, from the shell), input (the shell's input
// sample, each poll), script (headless: scripted intents), quit.

pub const HOLD_W = 1u32;            // InputSample.keys: the keys held
pub const HOLD_A = 2u32;
pub const HOLD_S = 4u32;
pub const HOLD_D = 8u32;
const LOOK_PER_PIXEL: f32 = 0.0025; // radians of look per pixel of mouse movement
const MOST_PITCH: f32 = 1.4;

// What the shell read from the devices since the last sample
pub struct InputSample {
  pub keys: u32;                    // HOLD_...
  pub dx: f32;                      // mouse movement, in pixels
  pub dy: f32;
  pub pressed: bool;                // the left button went down
}

// The way the person walks and faces (the yaw Sim takes): on the desktop the mouse look's; in the headset (--xr) the head's,
// as Render drew it last frame, so the body walks where the head turns and the mouse, which has no part in a headset, does
// not steer. PEGASUS_MUTANT=walk-mouse-yaw ignores the headset; checkSteerYaw must catch it.
pub fn steerYaw(xr: bool, mouseYaw: f32, headYaw: f32) f32 {
  if xr { headYaw } else { mouseYaw }
}

fn checkSteerYaw(mutant: bool) bool {
  let desk = steerYaw(false, 0.5, 2.);
  var head = steerYaw(true, 0.5, 2.);
  if mutant { head = steerYaw(false, 0.5, 2.); }
  let ok = desk == 0.5 && head == 2.;
  print <- "check steer yaw: desktop follows the mouse look "; print <- desk; print <- ", the headset the head "; print <- head;
  if ok { print <- ": ok\n"; } else { print <- ": FAILED\n"; }
  ok
}

// The script of a headless run, by the step the drawn frame shows
const WALK_FROM = 60u64;            // walk forward from this step
const WALK_TO = 180u64;             // to this one: 2 s
const PRESS_AT = 240u64;            // then press at box-a
const BOX_A_CENTRE = Vec3(0., 0.5, -8.);
const PRESS_FROM_HEIGHT: f32 = 10.;     // a scripted press looks straight down from this high over (x, z)

// A press a headless run is told to make (`--press STEP,XCM,ZCM`): at drawn step 'step', straight down on (x, z)
pub struct ScriptPress {
  pub step: u64;
  pub x: f32;
  pub z: f32;
  pub part: String;                 // `--press-part`: not empty, press along the ray from the eye to this part's middle instead
}
alias ScriptPresses = List[ScriptPress];

actor Player {
  render: Render;
  loader: Loader;
  audio: Audio;
  moves: StateWriter[MoveIntent];
  looks: StateWriter[LookIntent];
  drawn: StateReader[DrawnFrame];
  sim: Option[Sim];
  yaw: f32;
  pitch: f32;
  running: bool;
  pressed: bool;
  mutant: bool;                     // passed to Sim: the snapshot check's mutant
  plan: ScriptPresses;              // the presses a headless run was told to make, in step order (none: the box-a press)
  planned: usize;                   // how many of them are made
  still: bool;                      // the person stays where it arrived (a shot told to press)
  rays: StateReader[HandRay];       // --xr: the right controller's ray, as Render drew it
  seenPulls: u64;                   // the trigger pulls already made into presses
  xr: bool;                         // --xr: the head's yaw is the walking direction (steerYaw)

  fn init(self: &new, render: Render, loader: Loader, audio: Audio, moves: StateWriter[MoveIntent],
      looks: StateWriter[LookIntent], drawn: StateReader[DrawnFrame], rays: StateReader[HandRay], mutant: bool, xr: bool) {
    *self = Self(render, loader, audio, moves, looks, drawn, None[Sim], 0., -0.15, true, false, mutant, ScriptPresses(), 0usize, false,
      rays, 0u64, xr);
  }

  // The presses a headless run makes instead of the one at box-a; 'still': and the person does not walk
  pub async fn presses(self, list: ScriptPresses, still: bool) {
    plan = list;
    self.still = still;
  }

  // Start the zone's Sim, then ask the Loader to open 'world' for it
  pub async fn start(self, world: String, start: SimStart) {
    let s = self.startZoneSim(start);
    render.inhabit(NO_PART, NO_PART);   // the mock world has no avatar part yet: the eye is over the person's feet
    if world.len() > 0usize { loader.openWorld(world, s); }   // none: a client told its world's address by the server (Sim opens it)
    self.sim = Some[Sim](s);
  }

  // SIM START-UP, in this one place, so the world's owner can take it over
  // when worlds have more than one zone. One world, one zone, in the role the
  // start names (whole, or client of a server's zone)
  fn startZoneSim(self: &mut, start: SimStart) Sim {
    let role = start.net.role;
    let s = Sim(role, render, audio, loader, start, mutant);
    s.run();
    s
  }

  // The shell's input: intents, and a press aimed along the drawn frame
  pub async fn input(self, i: InputSample) {
    yaw = yaw - i.dx * LOOK_PER_PIXEL;
    pitch = pitch - i.dy * LOOK_PER_PIXEL;
    if pitch > MOST_PITCH { pitch = MOST_PITCH; }
    if pitch < 0. - MOST_PITCH { pitch = 0. - MOST_PITCH; }
    if xr {
      // the head's turn steers the walk, every poll (the mouse look is not read in a headset)
      looks.put(&LookIntent(steerYaw(xr, yaw, drawn.newest().yaw), pitch));
    } else if i.dx != 0. || i.dy != 0. { looks.put(&LookIntent(yaw, pitch)); }
    var f: f32 = 0.;
    var r: f32 = 0.;
    if (i.keys & HOLD_W) != 0u32 { f = f + 1.; }
    if (i.keys & HOLD_S) != 0u32 { f = f - 1.; }
    if (i.keys & HOLD_D) != 0u32 { r = r + 1.; }
    if (i.keys & HOLD_A) != 0u32 { r = r - 1.; }
    moves.put(&MoveIntent(f, r));
    if i.pressed {
      let d = drawn.newest();
      let along = Vec3(0. - sin(d.yaw) * cos(d.pitch), sin(d.pitch), 0. - cos(d.yaw) * cos(d.pitch));
      self.press(d.eye, along, d.displayNs);
    }
    // In the headset: the trigger's pulls Render counted since the last look become presses along the controller's ray
    // (the ray is the one Render drew, the same pointer action as a mouse press; on the desktop the count stays 0)
    let ray = rays.newest();
    if ray.pulls != seenPulls {
      seenPulls = ray.pulls;
      if ray.valid { self.press(ray.from, ray.along, ray.atNs); }
    }
  }

  // A headless run's person: walk forward for 2 s, then press at box-a, as
  // the drawn frames show the steps
  pub async fn script(self, ended: Sender[bool], walks: bool) {
    looks.put(&LookIntent(yaw, pitch));
    while running {
      _ = await aio.sleep(Duration.fromNanos(i64.from(STEP_NS)));
      if !running { break; }
      let d = drawn.newest();
      var f: f32 = 0.;
      if walks && !still && d.step >= WALK_FROM && d.step < WALK_TO { f = 1.; }
      moves.put(&MoveIntent(f, 0.));
      // the look moves a little every tick, so each frame has a newer pose to read
      let wobble = 0.001 * f32.from(d.frame % 7u64);
      looks.put(&LookIntent(yaw, pitch + wobble));
      if planned < plan.len() && d.step >= plan[planned].step {
        if plan[planned].part.len() > 0usize {
          match &sim {
            case let Some(s) { s.actAtPart(plan[planned].part.clone(), d.eye, d.displayNs); }
            case is None[Sim] {}
          }
        } else {
          self.press(Vec3(plan[planned].x, PRESS_FROM_HEIGHT, plan[planned].z), Vec3(0., -1., 0.), d.displayNs);
        }
        planned = planned + 1usize;
      }
      if walks && !pressed && plan.len() == 0usize && d.step >= PRESS_AT {
        pressed = true;
        let along = (BOX_A_CENTRE - d.eye).normalize();
        self.press(d.eye, along, d.displayNs);
      }
    }
    var e = ended;
    e <- true;
  }

  fn press(self: &mut, from: Vec3, along: Vec3, atNs: u64) {
    match &sim {
      case let Some(s) { s.act(Action(VERB_PRESS, NO_PART, from, along, atNs, ORIGIN_PERSON)); }
      case is None[Sim] {}
    }
  }

  pub async fn quit(self) {
    running = false;
    match &sim {
      case let Some(s) { s.stop(); }
      case is None[Sim] {}
    }
    self.sim = None[Sim];
  }
}
