// Picking in a part's own frame: a ray meets the part's box where the part stands, turned and scaled as it is.
//
// The ray is carried by the inverse of the part's placement into the part's frame, where the box is axis-aligned. The
// ray's parameter is unchanged by that (an affine map keeps the proportions along a line), so 'along' need not stay
// unit, and the hits of different parts compare by the same t in the world. Sim's `pick` uses `rayPlaced`.
//
// `checkPick` (`--checks`) drives it with a long thin box turned 45 degrees about Y: a ray that passes through the
// turned box's length hits, and a ray that would hit the unturned box but is clear of the turned one misses.
// PEGASUS_MUTANT=pick-ignores-turn tests the box where the part's origin is, unturned; the checks must fail.

// Where along the ray ('from', 'along') it enters 'shape' as placed by 'place', or -1 if it misses. 'ignoreTurn' is the
// mutant: only the placement's translation is honoured
fn rayPlaced(from: Vec3, along: Vec3, place: &Mat4, shape: &BoxShape, ignoreTurn: bool) f32 {
  if ignoreTurn {
    return rayBox(from, along, place.translation() + shape.centre, shape.half);
  }
  let inv = place.inverse();
  rayBox(inv.transformPoint(from), inv.transformVector(along), shape.centre, shape.half)
}

fn pickVerdict(ok: bool, what: &str) bool {
  print <- "check pick: "; print <- what; if ok { print <- ": ok\n"; } else { print <- ": WRONG\n"; }
  ok
}

fn checkPick(ignoreTurn: bool) bool {
  var all = true;
  // a long thin box: 2 m along x, 0.1 m across, 0.1 m high, about the part's origin
  let shape = BoxShape(Vec3(1., 0.05, 0.05), Vec3(0., 0., 0.));
  let down = Vec3(0., -1., 0.);
  let still = Mat4.identity();
  let turned = Mat4.fromTrs(Vec3(0., 0., 0.), Quat.angleAxis(0.78539816, Vec3(0., 1., 0.)), Vec3(1., 1., 1.));
  // 0.7 m along the turned box's length is at (0.495, y, -0.495) in the world (turn 45 degrees about Y)
  let hitsTurned = rayPlaced(Vec3(0.495, 3., -0.495), down, &turned, &shape, ignoreTurn);
  all = pickVerdict(hitsTurned >= 0., "a ray down through the turned box's length hits it") && all;
  // (0.7, y, 0) is on the unturned box's length, but 0.5 m from the turned box's line
  let missTurned = rayPlaced(Vec3(0.7, 3., 0.), down, &turned, &shape, ignoreTurn);
  all = pickVerdict(missTurned < 0., "a ray that would hit the unturned box misses the turned one") && all;
  let hitStill = rayPlaced(Vec3(0.7, 3., 0.), down, &still, &shape, ignoreTurn);
  all = pickVerdict(hitStill >= 0., "the same ray hits the box unturned") && all;
  // scale: the box doubled in x reaches 2 m each way
  let wide = Mat4.fromTrs(Vec3(0., 0., 0.), Quat.identity(), Vec3(2., 1., 1.));
  let hitWide = rayPlaced(Vec3(1.8, 3., 0.), down, &wide, &shape, ignoreTurn);
  all = pickVerdict(hitWide >= 0., "a ray at 1.8 m hits the box scaled 2x along x") && all;
  // the parameter is the world's: the box's top is 0.05 m up, so the hit is 2.95 m along a unit ray from 3 m
  let d = hitsTurned - 2.95;
  all = pickVerdict(d < 0.001 && d > -0.001, "the hit's distance is in world metres") && all;
  all
}
