// The Loader's driven checks (`pegasus --checks`): the content key, the
// catalog's sharing, nearest-first order, and `unused` freeing the mesh in
// Render. They drive LoaderCore and RenderCore directly, with no threads, so
// the order and the counts are exact. PEGASUS_MUTANT=unused-off-by-one makes
// the catalog free a key one user too soon; the unused check must catch it.

// The key of the first box below, pinned: the same on every run and machine
const GOLDEN_KEY = 6434191302331313117u64;

fn verdictLine(name: &str, good: bool) bool {
  print <- "check loader "; printStr(name);
  if good { print <- ": ok\n"; } else { print <- ": FAILED\n"; }
  good
}

fn checkContentKey() bool {
  let a = args6(0.5, 0.5, 0.5, 0.8, 0.3, 0.2);
  let k = contentKey("box", &a, VOCAB_VERSION, 0u32);
  let again = contentKey("box", &args6(0.5, 0.5, 0.5, 0.8, 0.3, 0.2), VOCAB_VERSION, 0u32);
  var other = a.clone();
  other.set(1usize, 0.6);
  let diffArg = contentKey("box", &other, VOCAB_VERSION, 0u32);
  let diffLod = contentKey("box", &a, VOCAB_VERSION, 1u32);
  let diffVocab = contentKey("box", &a, VOCAB_VERSION + 1u32, 0u32);
  let diffShape = contentKey("rounded", &a, VOCAB_VERSION, 0u32);
  let same = k == again && k == keyOf(&recipe("box", args6(0.5, 0.5, 0.5, 0.8, 0.3, 0.2)));
  let differs = diffArg != k && diffLod != k && diffVocab != k && diffShape != k && diffArg != diffLod;
  print <- "loader: key of the small box = "; print <- k; print <- "\n";
  let pinned = k == GOLDEN_KEY;
  verdictLine("content key stable, and different for different values", same && differs && pinned)
}

// A world's parts as Sim would ask for them: the person at the origin
fn requestsOf(image: &WorldImage) List[ContentRequest] {
  var out = List[ContentRequest]();
  var i = 0usize;
  while i < image.parts.len() {
    let d = &image.parts[i];
    out.push(ContentRequest(d.key, u32.from(i), d.placement.translation().length()));
    i = i + 1usize;
  }
  out
}

fn checkSharing(offByOne: bool) bool {
  var lw: StateWriter[LookIntent];
  var lr: StateReader[LookIntent];
  lw, lr = stateSlot[LookIntent](LookIntent(0., 0.));
  var dw: StateWriter[DrawnFrame];
  var dr: StateReader[DrawnFrame];
  dw, dr = stateSlot[DrawnFrame](zeroFrame());
  var render = RenderCore.make(lr, dw, false);
  var cat = LoaderCore.make(offByOne);
  let image = mockWorld(String.from("parts40"), &mut cat);
  let reqs = requestsOf(&image);

  // 40 parts ask; five keys are queued, the rest join them
  var queued = 0usize;
  var joined = 0usize;
  each r in &reqs {
    let how = cat.ask(r);
    if how == ASK_QUEUED { queued = queued + 1usize; }
    if how == ASK_JOINED { joined = joined + 1usize; }
  }

  // The order the keys should be built in: nearest user first, worked out apart from the catalog
  var want = List[ContentKey]();
  var round = 0usize;
  while round < 5usize {
    var best = reqs.len();
    var i = 0usize;
    while i < reqs.len() {
      var seen = false;
      each k in &want { if *k == reqs[i].key { seen = true; } }
      if !seen && (best == reqs.len() || reqs[i].nearness < reqs[best].nearness) { best = i; }
      i = i + 1usize;
    }
    want.push(reqs[best].key);
    round = round + 1usize;
  }

  // The jobs run, nearest first, and land in Render
  var order = List[ContentKey]();
  while true {
    match cat.next() {
      case let Some(job) {
        order.push(job.key);
        let p = buildContent(&job);
        if cat.done(job.key) == DONE_DELIVER { render.takeContent(meshContentOf(job.key, p)); }
      }
      case is None[BuildJob] { break; }
    }
  }
  var f = 0;
  while f < 8 { _ = render.prepare(); f = f + 1; }
  let sameOrder = order.len() == want.len() && order == want;
  var allResident = true;
  each d in &image.parts { if !render.isResident(d.key) { allResident = false; } }

  // A part asking later for a built key shares it: no new build
  let late = cat.ask(&reqs[0usize]);
  let againShared = cat.ask(&ContentRequest(reqs[1usize].key, 99u32, 1.)) == ASK_SHARED;

  print <- "loader: 40 parts asked; "; print <- u64.from(queued); print <- " keys queued, "; print <- u64.from(joined);
  print <- " joined; "; print <- cat.started; print <- " built; "; print <- u64.from(render.residentCount());
  print <- " meshes resident\n";
  var ok = verdictLine("40 parts sharing 5 keys build 5 meshes, each part's mesh resident",
    queued == 5usize && joined == 35usize && cat.started == 5u64 && render.residentCount() == 5usize && allResident
    && late == ASK_SHARED && againShared);
  ok = verdictLine("jobs run nearest first", sameOrder && cat.startedNearestFirst()) && ok;

  // unused: the first part's key has eight users; seven let go and the mesh stays
  let key = image.parts[0usize].key;
  var users = List[PartId]();
  var i = 0usize;
  while i < image.parts.len() {
    if image.parts[i].key == key { users.push(u32.from(i)); }
    i = i + 1usize;
  }
  var stillOk = users.len() == 8usize;
  var n = 0usize;
  while n + 1usize < users.len() {
    let how = cat.unused(key, users[n]);
    if how != UNUSED_STILL { stillOk = false; }
    if !render.isResident(key) { stillOk = false; }
    n = n + 1usize;
  }
  let lastUserHeld = cat.userCount(key) == 1usize && render.isResident(key);
  let doubleOk = cat.unused(key, users[0usize]) == UNUSED_NOT_USER;
  let freedHow = cat.unused(key, users[users.len() - 1usize]);
  if freedHow == UNUSED_FREED { render.releaseContent(key); }
  let gone = freedHow == UNUSED_FREED && !render.isResident(key) && cat.userCount(key) == 0usize && render.residentCount() == 4usize;
  ok = verdictLine("unused to zero frees the mesh in Render, and not before",
    stillOk && lastUserHeld && doubleOk && gone) && ok;
  ok
}

pub fn checkLoader(offByOne: bool) bool {
  let a = checkContentKey();
  let b = checkSharing(offByOne);
  a && b
}
