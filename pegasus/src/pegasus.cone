// Pegasus: the 3-D browser, first version (plan step 5): its actor skeleton
// on mock content. The actors (each in its own file):
//
//   Player   playeractor.cone   input to intents and actions; starts the zone's Sim
//   Sim      simactor.cone      the parts, the 60 Hz step, the snapshot
//   Render   renderactor.cone   the display, never waiting on Sim; the GPU's only submitter
//   Loader   loaderactor.cone   the catalog, content keys and a worker pool (mock content behind buildContent)
//   Audio    audioactor.cone    a MOCK: takes snapshots, does nothing
//
// and the messages between them, all proposed, in messages.cone.
//
//   pegasus                    a window: WASD walks, the mouse looks, the left button presses
//   pegasus --steps N          headless: N steps with scripted intents, no drawing; a line a second
//   pegasus --steps N --stall-sim MS
//                              and Sim busy for MS ms at step 300: Render must keep drawing
//   pegasus --shot FILE        one frame off screen, to FILE (a BMP), once its content is resident; with --press, after the
//                              last press's step + 120 (its glide done), or after the step --shot-after N names
//   pegasus --shot FILE --shot-view EXCM,EYCM,EZCM,LXCM,LYCM,LZCM,FOVDEG
//                              the shot from this eye, looking at this point (whole centimetres), vertical field of view in
//                              degrees: to set it beside the guide browser's shot of the same world (it settles 119 frames first)
//   pegasus --steps N --parts40
//                              the 40-part world sharing five keys; the Loader lets go of one
//   pegasus --world FILE       a real world's .ddd file read by the conescript package (with --steps or --shot); its
//                              parts get stand-in boxes until the interpreter builds them
//   pegasus --xr --world FILE  in the headset (OpenXR): both eyes drawn at the runtime's display time, the window mirroring the left
//                              eye; the right controller's trigger presses along its ray. Fails with a message when there is no
//                              runtime or headset
//   pegasus --checks          the driven checks (the head pose read last; the Loader's key, sharing, order, unused;
//                              connected play's reconciliation, stale snapshots and wire)
//
// Connected play (plan step 8, W117; netplay.cone, the roles in simactor.cone):
//   pegasus --serve PORT --world FILE [--steps N] [--loopback] [--until-empty] [--impair LOSS LATENCY JITTER]
//                              a server Sim (no window, no Render) with a Loader that builds Sim's products only. It listens on
//                              UDP PORT (0: the system chooses); --impair puts a lossy relay in front (loss per 1000, ms, ms) and
//                              prints the relay's port; --until-empty ends it once a client has joined and none is left
//   pegasus --join HOST:PORT --world FILE [--steps N] [--stand]
//                              Player, a client Sim and Render; headless with --steps (scripted: walks 2 s, presses at box-a;
//                              --stand stays still). The world file is the client's own, for its own Loader
//
// PEGASUS_MUTANT=pick-ignores-turn, stale-pose, mutate-snapshot, no-replay, stale-personal, stale-shared, delta-vs-sent, blend-lerp-matrix, walk-mouse-yaw, material-stale, material-no-show or material-missed runs a check's mutant, which
// the check must catch. The shell (this file) owns the window and the main
// thread, as SDL wants: it pumps the devices and hands Player each sample.

mod pegasus;

import stdio use *;
import libc;
import sdl;
