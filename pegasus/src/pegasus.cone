import actors;
import aio use File;
import iobuf use IoBuf, Bytes;
import iocore use Access, SocketAddr;
import netmsg use NetEvent, EventHandler, Connection, Endpoint, NetConfig, LinkConfig, LossyRelay, eventHandler, mustListen, mustConnect, startLossyRelay;
import fs;
import conescript use Understood, Val, Kind, Problem, Names, read, showProblems, numOf, OPT_AT, OPT_ROTATION, OPT_MATERIAL,
  Code, CodeWriter, CodeProblem, VerifiedCode, ImportTables, HandleTable, HANDLE_HOST, Interpreter, verify, verifyEach, lowerSim, entryUnit,
  ENTRY_DERIVE, ENTRY_HANDLER, ENTRY_MOVE_FLAG, NS_HOST, HOST_FIELD, HOST_OCCUPIED, HOST_SET_FIELD, HOST_START_ANIM, HOST_GLIDE,
  fieldSignature, occupiedSignature, setFieldSignature, startAnimSignature, glideSignature, P_FIELD, OP_IMPORT, OP_UNREACHABLE,
  KeysInfo, P_ROTATION, P_OFFSET;
import tweenstack use Anim, Animators;                                                 // the keys rules' animators (simanim.cone)
import keyframetracks use Track, Clip, TK_QUAT, TK_VEC3, INTERP_LINEAR;
import analyticdaylight use PreethamSky;
import partbuild use srgbToLinear, vocabulary, PartProducts, PartBuilder, toolImports, plainProducts, MaterialRec;
import sync use Arc, Channel, Sender, Receiver, LatestWriter, LatestReader, latestCell, CellRead;
import time use Instant, Duration;

const STALL_AT_STEP = 300u64;
const SHOT_W = 640u32;
const SHOT_H = 360u32;

fn argIs(a: *u8, b: &str) bool {
  var i = 0usize;
  while i < b.len() {
    if *(a + i) != b[i] { return false; }
    i = i + 1usize;
  }
  *(a + b.len()) == 0u8
}

fn argNumber(s: *u8) u64 {
  var n = 0u64;
  var i = 0usize;
  while *(s + i) >= '0' && *(s + i) <= '9' {
    n = n * 10u64 + u64.from(*(s + i) - '0');
    i = i + 1usize;
  }
  n
}

// "STEP,XCM,ZCM": a whole number of steps, then the place to press straight down on, in whole centimetres (may be negative)
fn parsePress(text: &str) Option[ScriptPress] {
  var at = 0usize;
  var got = List[i64]();
  while got.len() < 3usize {
    var neg = false;
    if at < text.len() && text[at] == '-' { neg = true; at = at + 1usize; }
    var n = 0i64;
    var digits = 0usize;
    while at < text.len() && text[at] >= '0' && text[at] <= '9' {
      n = n * 10i64 + i64.from(text[at] - '0');
      at = at + 1usize;
      digits = digits + 1usize;
    }
    if digits == 0usize { return None[ScriptPress]; }
    got.push(if neg { 0i64 - n } else { n });
    if got.len() < 3usize {
      if at >= text.len() || text[at] != ',' { return None[ScriptPress]; }
      at = at + 1usize;
    }
  }
  if at != text.len() || *got[0usize] < 0i64 { return None[ScriptPress]; }
  Some[ScriptPress](ScriptPress(u64.from(*got[0usize]), f32.from(*got[1usize]) * 0.01, f32.from(*got[2usize]) * 0.01))
}

// "EXCM,EYCM,EZCM,LXCM,LYCM,LZCM,FOVDEG": a shot's eye, the point it looks at (whole centimetres, may be negative), and its
// vertical field of view in whole degrees
fn parseShotView(text: &str) Option[ShotView] {
  var at = 0usize;
  var got = List[i64]();
  while got.len() < 7usize {
    var neg = false;
    if at < text.len() && text[at] == '-' { neg = true; at = at + 1usize; }
    var n = 0i64;
    var digits = 0usize;
    while at < text.len() && text[at] >= '0' && text[at] <= '9' {
      n = n * 10i64 + i64.from(text[at] - '0');
      at = at + 1usize;
      digits = digits + 1usize;
    }
    if digits == 0usize { return None[ShotView]; }
    got.push(if neg { 0i64 - n } else { n });
    if got.len() < 7usize {
      if at >= text.len() || text[at] != ',' { return None[ShotView]; }
      at = at + 1usize;
    }
  }
  if at != text.len() || *got[6usize] <= 0i64 || *got[6usize] >= 180i64 { return None[ShotView]; }
  let c: f32 = 0.01;
  Some[ShotView](ShotView(true, Vec3(f32.from(*got[0usize]) * c, f32.from(*got[1usize]) * c, f32.from(*got[2usize]) * c),
    Vec3(f32.from(*got[3usize]) * c, f32.from(*got[4usize]) * c, f32.from(*got[5usize]) * c), f32.from(*got[6usize])))
}

fn argString(s: *u8) String {
  var out = String();
  var i = 0usize;
  while *(s + i) != 0u8 {
    out.appendByte(*(s + i));
    i = i + 1usize;
  }
  out
}

// The mutant asked for in PEGASUS_MUTANT is 'name'
fn mutantIs(name: &str) bool {
  let e = libc.getenv("PEGASUS_MUTANT");
  if (e as usize) == 0usize { return false; }
  argIs(e, name)
}

fn zeroFrame() DrawnFrame { DrawnFrame(0u64, 0u64, 0u64, Vec3(0., EYE_HEIGHT, 0.), 0., 0., 0u64) }

fn noRay() HandRay { HandRay(false, Vec3(0., 0., 0.), Vec3(0., 0., -1.), 0u64, 0u64) }

// ---- The driven check: the head pose is read last ----

// A frame is prepared, the mouse moves, and the frame is finished: what it
// drew must be the pose after the move. The mutant reads the pose while
// preparing, and draws a stale one.
fn checkHeadPose(stale: bool) bool {
  var lw: StateWriter[LookIntent];
  var lr: StateReader[LookIntent];
  lw, lr = stateSlot[LookIntent](LookIntent(0., 0.));
  var dw: StateWriter[DrawnFrame];
  var dr: StateReader[DrawnFrame];
  dw, dr = stateSlot[DrawnFrame](zeroFrame());
  var core = RenderCore.make(lr, dw, stale);
  lw.put(&LookIntent(0.1, 0.));
  let plan = core.prepare();
  lw.put(&LookIntent(0.7, 0.2));
  let d = core.finish(&plan);
  let seen = dr.newest();
  let ok = d.yaw == 0.7 && d.pitch == 0.2 && d.lookSeq == lw.seq() && seen.frame == d.frame;
  print <- "check head pose read last: drew look seq "; print <- d.lookSeq; print <- " of "; print <- lw.seq();
  if ok { print <- ": ok\n"; } else { print <- ": FAILED (a stale pose)\n"; }
  ok
}

// ---- The run ----

fn main(argc: i32, argv: **u8) i32 {
  initAll();
  var steps = 0u64;
  var headless = false;
  var shot = String();
  var stallMs = 0u64;
  var checksOnly = false;
  var parts40 = false;
  var worldFile = String();
  var serving = false;
  var netStart = NetStart.whole();
  var shotAfter = 0u64;
  var shotView = ShotView.none();
  var presses = ScriptPresses();
  var xr = false;
  var a = 1;
  while a < argc {
    let arg = *(argv + usize.from(a));
    if argIs(arg, "--steps") && a + 1 < argc {
      steps = argNumber(*(argv + usize.from(a + 1)));
      headless = true;
      a = a + 1;
    } else if argIs(arg, "--shot") && a + 1 < argc {
      shot = argString(*(argv + usize.from(a + 1)));
      a = a + 1;
    } else if argIs(arg, "--stall-sim") && a + 1 < argc {
      stallMs = argNumber(*(argv + usize.from(a + 1)));
      a = a + 1;
    } else if argIs(arg, "--checks") {
      checksOnly = true;
    } else if argIs(arg, "--xr") {
      xr = true;
    } else if argIs(arg, "--parts40") {
      parts40 = true;
    } else if argIs(arg, "--world") && a + 1 < argc {
      worldFile = argString(*(argv + usize.from(a + 1)));
      a = a + 1;
    } else if argIs(arg, "--serve") && a + 1 < argc {
      serving = true;
      headless = true;
      netStart.role = SIM_SERVER;
      netStart.port = u32.from(argNumber(*(argv + usize.from(a + 1))));
      a = a + 1;
    } else if argIs(arg, "--join") && a + 1 < argc {
      netStart.role = SIM_CLIENT;
      netStart.address = argString(*(argv + usize.from(a + 1)));
      a = a + 1;
    } else if argIs(arg, "--loopback") {
      netStart.loopback = true;
    } else if argIs(arg, "--until-empty") {
      netStart.untilEmpty = true;
    } else if argIs(arg, "--stand") {
      netStart.walks = false;
    } else if argIs(arg, "--impair") && a + 3 < argc {
      netStart.impairLoss = u32.from(argNumber(*(argv + usize.from(a + 1))));
      netStart.impairLatency = u32.from(argNumber(*(argv + usize.from(a + 2))));
      netStart.impairJitter = u32.from(argNumber(*(argv + usize.from(a + 3))));
      a = a + 3;
    } else if argIs(arg, "--shot-after") && a + 1 < argc {
      shotAfter = argNumber(*(argv + usize.from(a + 1)));
      a = a + 1;
    } else if argIs(arg, "--shot-view") && a + 1 < argc {
      match parseShotView(argString(*(argv + usize.from(a + 1))).view()) {
        case let Some(v) { shotView = v; }
        case is None[ShotView] { print <- "pegasus: --shot-view wants EXCM,EYCM,EZCM,LXCM,LYCM,LZCM,FOVDEG (whole numbers; the eye and the point looked at, in centimetres)\n"; return 2; }
      }
      a = a + 1;
    } else if argIs(arg, "--press") && a + 1 < argc {
      match parsePress(argString(*(argv + usize.from(a + 1))).view()) {
        case let Some(p) { presses.push(p); }
        case is None[ScriptPress] { print <- "pegasus: --press wants STEP,XCM,ZCM (whole numbers; centimetres)\n"; return 2; }
      }
      a = a + 1;
    } else {
      print <- "pegasus: unknown argument; use --xr, --steps N, --stall-sim MS, --parts40, --world FILE, --press STEP,XCM,ZCM, --shot FILE [--shot-after N] [--shot-view EXCM,EYCM,EZCM,LXCM,LYCM,LZCM,FOVDEG], --checks, --serve PORT or --join HOST:PORT\n";
      return 2;
    }
    a = a + 1;
  }
  // A shot told to press waits for the last press and the glide after it (0.6 s is 36 steps; 120 leaves room), unless --shot-after says
  if shot.len() > 0usize && shotAfter == 0u64 {
    each p in &presses { if p.step + 120u64 > shotAfter { shotAfter = p.step + 120u64; } }
  }
  if netStart.role == SIM_CLIENT && steps != 0u64 { headless = true; }
  if xr && (headless || shot.len() > 0usize || serving) {
    print <- "pegasus: --xr needs the window's mirror and a live run: not with --steps, --shot, --serve or a headless client\n";
    return 2;
  }
  if checksOnly {
    let poseOk = checkHeadPose(mutantIs("stale-pose"));
    let loaderOk = checkLoader(mutantIs("unused-off-by-one"));
    let netOk = checkConnected();
    let rulesOk = checkRules(mutantIs("trapped-writes"));
    let pickOk = checkPick(mutantIs("pick-ignores-turn"));
    let blendOk = checkBlend(mutantIs("blend-lerp-matrix"));
    let steerOk = checkSteerYaw(mutantIs("walk-mouse-yaw"));
    let materialsOk = checkMaterials();
    let ok = poseOk && loaderOk && rulesOk && pickOk && netOk && blendOk && steerOk && materialsOk;
    finalAll();
    return if ok { 0 } else { 1 };
  }

  // The latest values: Player's intents (the look is the mouse-look slot
  // Render reads the head pose from), and the frame as Render drew it
  var moveW: StateWriter[MoveIntent];
  var moveR: StateReader[MoveIntent];
  moveW, moveR = stateSlot[MoveIntent](MoveIntent(0., 0.));
  var lookW: StateWriter[LookIntent];
  var lookR: StateReader[LookIntent];
  lookW, lookR = stateSlot[LookIntent](LookIntent(0., -0.15));
  let lookForRender = lookW.reader(LookIntent(0., -0.15));
  var drawnW: StateWriter[DrawnFrame];
  var drawnR: StateReader[DrawnFrame];
  drawnW, drawnR = stateSlot[DrawnFrame](zeroFrame());
  let drawnForSim = drawnW.reader(zeroFrame());
  var rayW: StateWriter[HandRay];
  var rayR: StateReader[HandRay];
  rayW, rayR = stateSlot[HandRay](noRay());

  var finishedS: Sender[i32];
  var finishedR: Receiver[i32];
  finishedS, finishedR = Channel[i32].make();
  var loaderS: Sender[bool];
  var loaderR: Receiver[bool];
  loaderS, loaderR = Channel[bool].make();
  var stoppedS: Sender[bool];
  var stoppedR: Receiver[bool];
  stoppedS, stoppedR = Channel[bool].make();

  // The window, unless headless or a shot
  let windowed = !headless && shot.len() == 0usize;
  // (opened in place: a Window dropped on reassignment would end SDL's video under the new one)
  var win = if windowed { Window.openVulkan("Pegasus") } else { Window.unopened() };
  var handle = 0usize;
  var w = SHOT_W;
  var h = SHOT_H;
  if windowed {
    if !win.isOpen() { print <- "pegasus: no window could be opened\n"; return 1; }
    handle = win.sdlHandle() as usize;
    let size = win.size();
    w = u32.from(size.w);
    h = u32.from(size.h);
    if !xr { _ = sdl.SetWindowRelativeMouseMode(win.sdlHandle(), true); }
  }

  var verdict = 0;
  {
    // A headless run checks what is resident at its end: the mock's four keys, or
    // the 40-part world's five less the one its Loader lets go of
    // (each key is a mesh key or a material key: the mock's four meshes and four materials, or the 40-part world's five
    // and five, less the mesh it lets go of)
    var exactKeys = 0usize;
    if headless { exactKeys = if parts40 { MOCK_KEYS_40 } else { MOCK_KEYS }; }
    var wantKeys = MOCK_KEYS;
    var wantBuilds = u64.from(MOCK_KEYS);
    if parts40 { wantBuilds = 10u64; }
    if worldFile.len() > 0usize {
      // A real world: how many keys it makes is what the run checks (the Loader reads it again, when it opens it)
      var keys = 0usize;
      match fs.readFile(&Path.from(worldFile.view())) {
        case let Ok(text) {
          let img = readImage(worldFile.view(), text.view());
          keys = distinctKeys(&img);
          // a server's Sim asks for no materials: it never draws
          if !serving { keys = keys + distinctMaterials(&img); }
          // a client of a world that declares no avatars also builds the browser's own figure and its material
          if netStart.role == SIM_CLIENT && img.behaviour.avatar == NO_AVATAR { keys = keys + 2usize; }
        }
        case let Err(e) { print <- "pegasus: "; printStr(worldFile.view()); print <- " cannot be read: "; print <- e; print <- "\n"; return 1; }
      }
      wantKeys = keys;
      if headless { exactKeys = keys; }
      wantBuilds = u64.from(keys);
    }
    // A server has no Render to run: it is never started, and its Loader sends it nothing
    if serving { exactKeys = 0usize; }
    let render = Render(handle, w, h, !headless, lookForRender, drawnW, shot.clone(), wantKeys, exactKeys, stoppedS,
      finishedS.clone(), stallMs, mutantIs("stale-pose"), shotAfter, xr, rayW, shotView);
    let audio = Audio();
    let loader = Loader(render, loaderS, wantBuilds, parts40 && headless, mutantIs("unused-off-by-one"), serving);
    let player = Player(render, loader, audio, moveW, lookW, drawnR, rayR, mutantIs("mutate-snapshot"), xr);
    var stallAt = 0u64;
    if stallMs > 0u64 { stallAt = STALL_AT_STEP; }
    var worldName = String.from("mock");
    if parts40 { worldName = String.from("parts40"); }
    if worldFile.len() > 0usize { worldName = worldFile.clone(); }
    let walks = netStart.walks;
    player.start(worldName,SimStart(moveR, lookR, drawnForSim, steps, stallAt, stallMs, finishedS, netStart));
    if !serving { render.run(); }
    var scriptS: Sender[bool];
    var scriptR: Receiver[bool];
    scriptS, scriptR = Channel[bool].make();
    // the script runs headless, and in a shot told to press (a shot of a rook moved); a server has none
    let scripted = headless || presses.len() > 0usize;
    if scripted && !serving { player.presses(presses, !headless); player.script(scriptS, walks); }

    var renderEnded = false;      // --xr: Render's loop ended (no headset, or its session is over) before the window was closed
    if windowed {
      var held = 0u32;
      while win.running {
        if xr {
          match stoppedR.tryRecv() {
            case let Some(clean) { renderEnded = true; if !clean { verdict = 1; } }
            case is None[bool] {}
          }
          if renderEnded { break; }
        }
        var sample = InputSample(0u32, 0., 0., false);
        var event = sdl.Event();
        while win.pollEvent(&mut event) {
          if event.type == sdl.EVENT_KEY_DOWN || event.type == sdl.EVENT_KEY_UP {
            let k = &event as &sdl.KeyboardEvent;
            var bit = 0u32;
            if k.scancode == sdl.SCANCODE_W { bit = HOLD_W; }
            if k.scancode == sdl.SCANCODE_A { bit = HOLD_A; }
            if k.scancode == sdl.SCANCODE_S { bit = HOLD_S; }
            if k.scancode == sdl.SCANCODE_D { bit = HOLD_D; }
            if k.down { held = held | bit; } else { held = held & (0xFFFFFFFFu32 ^ bit); }
          } else if event.type == sdl.EVENT_MOUSE_MOTION {
            let m = &event as &sdl.MouseMotionEvent;
            sample.dx = sample.dx + m.xrel;
            sample.dy = sample.dy + m.yrel;
          } else if event.type == sdl.EVENT_MOUSE_BUTTON_DOWN {
            sample.pressed = true;
          }
        }
        sample.keys = held;
        player.input(sample);
        sdl.Delay(2u32);
      }
    } else {
      match finishedR.recv() {
        case let Some(v) { verdict = v; }
        case is None[i32] { verdict = 1; }
      }
    }
    player.quit();
    if !serving && !renderEnded {
      match stoppedR.recv() {
        case let Some(clean) { if !clean { verdict = 1; } }
        case is None[bool] {}
      }
    }
    if headless {
      match loaderR.recv() {
        case let Some(clean) { if !clean { verdict = 1; } }
        case is None[bool] {}
      }
      if !serving { _ = scriptR.recv(); }
    }   // the script's last sleep ends before the program does
  }
  finalAll();
  print <- "pegasus: "; if verdict == 0 { print <- "ok\n"; } else { print <- "FAILED\n"; }
  verdict
}
