// What a world does, as the Loader reads it and moves it to Sim inside the world image (plan step 6, the click).
//
// The rules and derives of a world are lowered by conescript (`lowerSim`) to a Code of units that reach the world only
// through imports in namespace "host"; Sim verifies that Code against its own import table (`simrules.cone`) and runs a
// unit for each click. Everything else here is the plain data those units are numbered against: the values of the
// fields, the world's frames by slot (so a glide knows where a piece stands), the derives' order, the pick-and-place
// rules. The same facts the guide browser's `Program` holds (`guidebrowser\src\world.cone`).

// One slot of the world (a part, a group or the world itself): who holds it and where it stands in that holder
pub struct SlotFrame {
  pub name: String;                 // its own name, for what Sim says about it
  pub parent: u32;                  // the slot that holds it (the world is its own)
  pub at: Vec3;
  pub turn: Quat;
}
alias SlotFrames = List[SlotFrame];

// A field a part holds: its value to begin with (a part held is its slot, none is -1)
pub struct FieldDecl {
  pub name: String;
  pub value: f64;
}
alias FieldDecls = List[FieldDecl];

// A derive, in the order they are worked out: what it sets, and its number (its unit's entry)
pub struct DeriveDecl {
  pub prop: u32;                    // P_FIELD or P_TINT
  pub index: u32;                   // the field's number, or the part's slot
  pub number: u32;
}
alias DeriveDecls = List[DeriveDecl];

// A pick-and-place rule: on a click on 'part' or any part inside it, its unit runs
pub struct MoveDecl {
  pub part: u32;                    // a slot
  pub number: u32;                  // its number in the checked world: its unit's entry is ENTRY_MOVE_FLAG | number
}
alias MoveDecls = List[MoveDecl];

pub const NO_AVATAR = 0xFFFFFFFFu32;  // the world declares no avatar design: the browser's own is used

pub struct Behaviour {
  pub code: Code;                   // the units; empty when the world has no behaviour
  pub frames: SlotFrames;           // by slot
  pub fields: FieldDecls;           // by number
  pub derives: DeriveDecls;
  pub moves: MoveDecls;
  pub keysRules: usize;             // live keys rules (animators): not run by Sim yet, counted so that is said
  pub avatar: u32;                  // the slot of the design the world gives its visitors (worldAvatars), or NO_AVATAR

  pub fn none() Behaviour {
    Behaviour(Code.empty(), SlotFrames(), FieldDecls(), DeriveDecls(), MoveDecls(), 0usize, NO_AVATAR)
  }
}
