// A real world's image: the ConeScript reader's `Understood`, turned into the part table the Loader moves to Sim.
// Plan step 6, first part. The reader is the `conescript` package (`read`, over the `partbuild` vocabulary); this
// file only walks what it understood, as guidebrowser\src\build.cone does, but builds no mesh: each shape part becomes
// a row (its id and path, its parent, where it stands, how big, its colour) and a RECIPE for its content.
//
// THE RECIPE of a part (what a content key hashes, so equal fixed inputs share one build):
//   shape  "cs." and the name of the vocabulary row at the top of the part's value: "cs.lathe", "cs.difference",
//          "cs.box" (a function the part calls is followed into: its value is the function's result)
//   args   RECIPE_HEADER numbers, then the value as the reader holds it, flattened:
//            [0..2] low corner and [3..5] high corner of the shape's box, estimated from its value (a stand-in's size)
//            [6..8] the part's material colour, linear red, green, blue
//          then the value in prefix order, each node a tag: 0 absent; 1 number; 2 truth; 3 tuple, count, items;
//          4 range, count, items; 5 reference, slot; 6 call, its vocabulary row, count, arguments; 7 list, count,
//          items; 8 local, number; 9 function call, count of steps, the steps, the result.
// The colour is in the recipe because the mock `buildContent` makes the stand-in's material from it (the real build
// will take the material from the part's own).

pub const RECIPE_HEADER = 9usize;

// One shape part of the world
pub struct ImagePart {
  pub slot: u32;                    // its number in the world, in the order written (the world itself is 0)
  pub path: String;                 // "board.pieces.whiteRook1.body"
  pub parent: u32;                  // the slot of the part that holds it
  pub at: Vec3;                     // where it stands in its parent's frame
  pub turn: Quat;                   // how it is turned in its parent's frame
  pub placement: Mat4;              // its frame in the world's
  pub size: Vec3;                   // the shape's box, estimated from its value
  pub colour: Color;                // its material's colour, linear
  pub recipe: Recipe;
  pub key: ContentKey;
}
alias ImageParts = List[ImagePart];

// A world read: every shape part that has no problem, the parts dropped for one, and every problem
pub struct ImageWorld {
  pub name: String;
  pub parts: ImageParts;
  pub dropped: List[String];        // the paths of the parts the reader left out for a mistake
  pub problems: List[Problem];
  pub startFeet: Vec3;              // where the first arrival puts the person's feet
}

// The text of a world read into its image
pub fn readImage(file: &str, text: &Array[u8]) ImageWorld {
  var names = Names.standard();
  let vocab = vocabulary(&mut names);
  var reading = read(text, names, vocab);
  var problems = List[Problem]();
  problems <-> reading.problems;
  var parts = ImageParts();
  var dropped = List[String]();
  var feet = Vec3(0., 0., 0.);
  fillImage(&reading.understood, &mut parts, &mut dropped, &mut feet);
  ImageWorld(String.from(file), parts, dropped, problems, feet)
}

// How many different keys the parts have
pub fn distinctKeys(image: &ImageWorld) usize {
  var seen = List[ContentKey]();
  each p in &image.parts {
    if !seen.contains(&p.key) { seen.push(p.key); }
  }
  seen.len()
}

fn fillImage(w: &Understood, parts: &mut ImageParts, dropped: &mut List[String], feet: &mut Vec3) {
  var places = List[Mat4]();        // by slot: the part's own frame, in the world's
  var s = 0usize;
  while s < w.nodes.len() {
    places.push(Mat4.identity());
    if !*w.alive[s] { dropped.push(pathOf(w, s)); }
    s = s + 1usize;
  }
  var standing = false;
  var i = 0usize;
  while i < w.order.len() {
    let slot = *w.order[i];
    let kind = w.nodes[slot].kind;
    let parent = w.nodes[slot].parent;
    var at = Vec3(0., 0., 0.);
    var turn = Quat.identity();
    if kind == Kind.Group || kind == Kind.Shape || kind == Kind.Light {
      if !(w.units[slot].options[OPT_AT] is Absent) { at = vec3(&w.units[slot].options[OPT_AT]); }
      turn = turnOf(w, &w.units[slot].options[OPT_ROTATION]);
      places.set(slot, *places[parent] * Mat4.fromTrs(at, turn, Vec3(1., 1., 1.)));
    }
    if kind == Kind.Shape {
      var colour = Color(0.5, 0.5, 0.5, 1.);
      match &w.units[slot].options[OPT_MATERIAL] {
        case let Ref(m) { colour = colorOf(w, &w.units[*m].make); }
        case let Make(made) { colour = colorOf(w, &w.units[slot].options[OPT_MATERIAL]); }
        else {}
      }
      var span = Span(Vec3(0., 0., 0.), Vec3(0., 0., 0.), false);
      let none = List[Val]();
      boundsOf(w, &none, &w.units[slot].make, &mut span);
      if !span.any { span = Span(Vec3(-0.25, -0.25, -0.25), Vec3(0.25, 0.25, 0.25), true); }
      var args = List[f32]();
      args.push(span.lo.x); args.push(span.lo.y); args.push(span.lo.z);
      args.push(span.hi.x); args.push(span.hi.y); args.push(span.hi.z);
      args.push(colour.red); args.push(colour.green); args.push(colour.blue);
      flatten(w, &w.units[slot].make, &mut args);
      var shape = String.from("cs.");
      appendTopName(w, &w.units[slot].make, &mut shape);
      let recipe = Recipe(shape, args, 0u32);
      let key = keyOf(&recipe);
      parts.push(ImagePart(u32.from(slot), pathOf(w, slot), u32.from(parent), at, turn, *places[slot],
        span.hi - span.lo, colour, recipe, key));
    }
    else if kind == Kind.Arrival && !standing {
      *feet = *places[parent] * vec3(&w.units[slot].options[OPT_AT]);
      standing = true;
    }
    i = i + 1usize;
  }
}

// "board.pieces.whiteRook1.body"
fn pathOf(w: &Understood, slot: usize) String {
  var chain = List[u32]();
  var s = slot;
  chain.push(w.nodes[s].name);
  while w.nodes[s].parent != s {
    s = w.nodes[s].parent;
    chain.push(w.nodes[s].name);
  }
  var path = String();
  var k = chain.len();
  while k > 0usize {
    k = k - 1usize;
    path.append(w.names.text(*chain[k]));
    if k > 0usize { path.appendByte('.'); }
  }
  path
}

// ---- the recipe's values ----

// The name of vocabulary row 'tool', the names of its path joined by dots ("lathe", "outline.rectangle")
fn appendToolName(w: &Understood, tool: u32, out: &mut String) {
  let path = &w.vocab.tools[usize.from(tool)].path;
  var k = 0usize;
  while k < path.len() {
    if k > 0usize { out.appendByte('.'); }
    out.append(w.names.text(*path[k]));
    k = k + 1usize;
  }
}

// Is row 'tool' the one-name call 'name'?
fn toolIs(w: &Understood, tool: u32, name: &str) bool {
  let path = &w.vocab.tools[usize.from(tool)].path;
  path.len() == 1usize && w.names.text(*path[0usize]) == name
}

fn appendTopName(w: &Understood, v: &Val, out: &mut String) {
  match v {
    case let Make(m) { appendToolName(w, m.tool, out); }
    case let Call(n) { appendTopName(w, &w.functions[*n].result, out); }
    else { out.append("shape"); }
  }
}

// The value as numbers, in prefix order (see the top of this file)
fn flatten(w: &Understood, v: &Val, out: &mut List[f32]) {
  match v {
    case let Num(x) { out.push(1.); out.push(f32.from(*x)); }
    case let Truth(b) { out.push(2.); if *b { out.push(1.); } else { out.push(0.); } }
    case let Tuple(items) { out.push(3.); out.push(f32.from(items.len())); each it in &*items { flatten(w, it, out); } }
    case let Range(items) { out.push(4.); out.push(f32.from(items.len())); each it in &*items { flatten(w, it, out); } }
    case let Ref(slot) { out.push(5.); out.push(f32.from(*slot)); }
    case let Make(m) {
      out.push(6.); out.push(f32.from(m.tool)); out.push(f32.from(m.args.len()));
      each a in &m.args { flatten(w, a, out); }
    }
    case let Items(items) { out.push(7.); out.push(f32.from(items.len())); each it in &*items { flatten(w, it, out); } }
    case let Local(k) { out.push(8.); out.push(f32.from(*k)); }
    case let Call(n) {
      out.push(9.);
      let f = &w.functions[*n];
      out.push(f32.from(f.lets.len()));
      each l in &f.lets { flatten(w, l, out); }
      flatten(w, &f.result, out);
    }
    else { out.push(0.); }
  }
}

// ---- the shape's box, estimated from its value ----

struct Span {
  lo: Vec3;
  hi: Vec3;
  any: bool;
}

fn lesser(a: f32, b: f32) f32 { if a < b { a } else { b } }
fn greater(a: f32, b: f32) f32 { if a > b { a } else { b } }

fn widen(s: &mut Span, lo: Vec3, hi: Vec3) {
  if !s.any {
    s.lo = lo;
    s.hi = hi;
    s.any = true;
    return;
  }
  s.lo = Vec3(lesser(s.lo.x, lo.x), lesser(s.lo.y, lo.y), lesser(s.lo.z, lo.z));
  s.hi = Vec3(greater(s.hi.x, hi.x), greater(s.hi.y, hi.y), greater(s.hi.z, hi.z));
}

fn endOf(v: &Val, k: usize) f32 {
  match v {
    case let Range(ends) { f32.from(numOf(&ends[k])) }
    else { 0. }
  }
}

// Every pair of numbers in a profile: x holds the farthest out, y the lowest, z the highest
fn scanPoints(v: &Val, out: &mut Vec3, any: &mut bool) {
  match v {
    case let Tuple(items) {
      if items.len() == 2usize {
        let x = f32.from(numOf(&items[0usize]));
        let y = f32.from(numOf(&items[1usize]));
        if !*any { *out = Vec3(x, y, y); *any = true; }
        else { *out = Vec3(greater(out.x, x), lesser(out.y, y), greater(out.z, y)); }
      }
      each it in &*items { scanPoints(it, out, any); }
    }
    case let Items(items) { each it in &*items { scanPoints(it, out, any); } }
    case let Make(m) { each a in &m.args { scanPoints(a, out, any); } }
    else {}
  }
}

fn boundsOf(w: &Understood, lets: &List[Val], v: &Val, s: &mut Span) {
  match v {
    case let Make(m) {
      let t = m.tool;
      if toolIs(w, t, "box") {
        widen(s, Vec3(endOf(&m.args[0usize], 0usize), endOf(&m.args[1usize], 0usize), endOf(&m.args[2usize], 0usize)),
          Vec3(endOf(&m.args[0usize], 1usize), endOf(&m.args[1usize], 1usize), endOf(&m.args[2usize], 1usize)));
      }
      else if toolIs(w, t, "lathe") {
        var far = Vec3(0., 0., 0.);
        var any = false;
        scanPoints(&m.args[0usize], &mut far, &mut any);
        if any { widen(s, Vec3(0. - far.x, far.y, 0. - far.x), Vec3(far.x, far.z, far.x)); }
      }
      else if toolIs(w, t, "sphere") {
        let r = f32.from(numOf(&m.args[0usize]));
        widen(s, Vec3(0. - r, 0. - r, 0. - r), Vec3(r, r, r));
      }
      else if toolIs(w, t, "union") {
        boundsOf(w, lets, &m.args[0usize], s);
        boundsOf(w, lets, &m.args[1usize], s);
      }
      else if toolIs(w, t, "move") {
        var inner = Span(Vec3(0., 0., 0.), Vec3(0., 0., 0.), false);
        boundsOf(w, lets, &m.args[0usize], &mut inner);
        if inner.any {
          let shift = vec3(&m.args[1usize]);
          widen(s, inner.lo + shift, inner.hi + shift);
        }
      }
      else if toolIs(w, t, "join") {
        boundsOf(w, lets, &m.args[0usize], s);
      }
      else if toolIs(w, t, "arrayRadial") {
        var inner = Span(Vec3(0., 0., 0.), Vec3(0., 0., 0.), false);
        boundsOf(w, lets, &m.args[0usize], &mut inner);
        if inner.any {
          let r = greater(greater(0. - inner.lo.x, inner.hi.x), greater(0. - inner.lo.z, inner.hi.z));
          widen(s, Vec3(0. - r, inner.lo.y, 0. - r), Vec3(r, inner.hi.y, r));
        }
      }
      else if toolIs(w, t, "difference") || toolIs(w, t, "subdivide") || toolIs(w, t, "smooth") || toolIs(w, t, "carve")
          || toolIs(w, t, "mirror") || toolIs(w, t, "turn") {
        boundsOf(w, lets, &m.args[0usize], s);
      }
    }
    case let Items(items) { each it in &*items { boundsOf(w, lets, it, s); } }
    case let Local(k) { boundsOf(w, lets, &lets[*k], s); }
    case let Call(n) { boundsOf(w, &w.functions[*n].lets, &w.functions[*n].result, s); }
    else {}
  }
}

// ---- placement and colour, as guidebrowser\src\build.cone reads them (a copy of the little it needs: the
// browser reads them through the vocabulary's shims, which a stand-in has no use for) ----

fn vec3(v: &Val) Vec3 {
  match v {
    case let Tuple(items) {
      return Vec3(f32.from(numOf(&items[0usize])), f32.from(numOf(&items[1usize])), f32.from(numOf(&items[2usize])));
    }
    else {}
  }
  Vec3(0., 0., 0.)
}

// rotation(angle, about:), about the upright axis when 'about' is left out
fn turnOf(w: &Understood, rotation: &Val) Quat {
  match rotation {
    case let Make(m) {
      let axis = if m.args[1usize] is Absent { Vec3(0., 1., 0.) } else { vec3(&m.args[1usize]).normalize() };
      Quat.angleAxis(f32.from(numOf(&m.args[0usize])), axis)
    }
    else { Quat.identity() }
  }
}

// plain(c), physical(color:, ...), a list of a material and its modifiers, or a colour itself: srgb(r, g, b) with the
// true sRGB curve, or color(r, g, b), linear already
fn colorOf(w: &Understood, make: &Val) Color {
  match make {
    case let Make(m) {
      if toolIs(w, m.tool, "plain") || toolIs(w, m.tool, "physical") || m.tool == w.vocab.materialList {
        return colorOf(w, &m.args[0usize]);
      }
      var opacity = 1.;
      if !(m.args[3usize] is Absent) { opacity = numOf(&m.args[3usize]); }
      if toolIs(w, m.tool, "srgb") {
        return Color(srgbToLinear(numOf(&m.args[0usize])), srgbToLinear(numOf(&m.args[1usize])),
          srgbToLinear(numOf(&m.args[2usize])), f32.from(opacity));
      }
      return Color(f32.from(numOf(&m.args[0usize])), f32.from(numOf(&m.args[1usize])), f32.from(numOf(&m.args[2usize])),
        f32.from(opacity));
    }
    else {}
  }
  Color(0.5, 0.5, 0.5, 1.)
}

fn srgbToLinear(n: f64) f32 {
  let c = n / 255.;
  if c <= 0.04045 { return f32.from(c / 12.92); }
  f32.from(libc.pow((c + 0.055) / 1.055, 2.4))
}
