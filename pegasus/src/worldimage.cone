// A real world's image: the ConeScript reader's `Understood`, turned into the part table the Loader moves to Sim.
// Plan step 6. The reader is the `conescript` package (`read`, over the `partbuild` vocabulary); this file only walks
// what it understood, as guidebrowser\src\build.cone does, but builds no mesh: each shape part becomes a row (its id
// and path, its parent, where it stands) and a RECIPE for its content, which a Loader worker builds with `buildPart`.
//
// THE RECIPES of a part (what a content key hashes, so equal fixed inputs share one build). A part has two: its mesh's
// and its material's, each with its own key.
//   MESH   shape  "cs." and the name of the vocabulary row at the top of the part's value: "cs.lathe", "cs.difference",
//                 "cs.box" (a function the part calls is followed into: its value is the function's result)
//          args   the part's shape value as the reader holds it, flattened. Each node is a tag: 0 absent; 1 number; 2 truth;
//                 3 tuple, count, items; 4 range, count, items; 5 reference, slot; 6 call, its vocabulary row, count,
//                 arguments; 7 list, count, items; 8 local, number; 9 function call, count of steps, the steps, the result.
//          slot   the first part with this recipe: the part a worker builds it from (not part of the key)
//   MATERIAL  shape "cm.material" (`MATERIAL_SHAPE`)
//          args   the part's material value flattened the same way (a reference to a material part is followed to that
//                 part's own value, so two names for one wood agree)
//          slot   the first shape part with this material: the part a worker builds the material from (not part of the key)
// The mesh key is the shape alone: two parts of one shape in different woods share one mesh and have two material keys.

// One shape part of the world
pub struct ImagePart {
  pub slot: u32;                    // its number in the world, in the order written (the world itself is 0)
  pub path: String;                 // "board.pieces.whiteRook1.body"
  pub parent: u32;                  // the slot of the part that holds it
  pub at: Vec3;                     // where it stands in its parent's frame
  pub turn: Quat;                   // how it is turned in its parent's frame
  pub placement: Mat4;              // its frame in the world's
  pub recipe: Recipe;               // the mesh's
  pub key: ContentKey;              // the mesh key
  pub materialRecipe: Recipe;
  pub material: ContentKey;         // the material key
}
alias ImageParts = List[ImagePart];

// A world read: every shape part that has no problem, the parts dropped for one, and every problem
pub struct ImageWorld {
  pub name: String;
  pub parts: ImageParts;
  pub dropped: List[String];        // the paths of the parts the reader left out for a mistake
  pub problems: List[Problem];
  pub startFeet: Vec3;              // where the first arrival puts the person's feet
  pub behaviour: Behaviour;         // what the world's rules do (behaviour.cone)
  pub looks: LookParts;             // its sun, lamps, first arrival's camera and sky, each a part with no mesh (what Render needs to light and take the picture as the guide does)
  pub firstDropped: u32;            // the slot of the first part the reader left out (NO_SLOT if none): a part before it is the same in any longer text
  pub slots: u32;                   // how many parts (slots) the text has: a part builder made from this text can build any slot below it
}

pub const NO_SLOT = 0xFFFFFFFFu32;

// A part that is a light, a camera or the sky: it has a place and a look, no mesh and no material
pub struct LookPart {
  pub slot: u32;
  pub path: String;
  pub parent: u32;
  pub placement: Mat4;              // its frame in the world's
  pub look: PartLook;
}
alias LookParts = List[LookPart];

// A light part's slot and its frame in the world's, as fillImage finds them
struct LightAt {
  slot: u32;
  place: Mat4;
}

// The first part of a world's text, read as the files that have arrived so far: only its shape parts and where the person starts,
// with no rules, derives, keys or looks (those wait for every file: a rule may name any part by its path). A part that names one in
// a file not yet read is left out of this reading, not failed: a later, longer text gives it. The parts before `firstDropped` come
// out the same, in the same order, from every longer text that begins with this one (pegasus --checks proves it on the split world)
pub fn readPrefix(file: &str, text: &Array[u8]) ImageWorld {
  var names = Names.standard();
  let vocab = vocabulary(&mut names);
  var reading = read(text, names, vocab);
  var problems = List[Problem]();
  problems <-> reading.problems;
  var parts = ImageParts();
  var dropped = List[String]();
  var feet = Vec3(0., 0., 0.);
  var lights = List[LightAt]();
  var arrivals = List[u32]();
  let w = &reading.understood;
  fillImage(w, &mut parts, &mut dropped, &mut feet, &mut lights, &mut arrivals);
  ImageWorld(String.from(file), parts, dropped, problems, feet, Behaviour.none(), LookParts(), firstDroppedSlot(w), u32.from(w.nodes.len()))
}

// The slot of the first part the reader left out, or NO_SLOT
fn firstDroppedSlot(w: &Understood) u32 {
  var s = 0usize;
  while s < w.nodes.len() {
    if !*w.alive[s] { return u32.from(s); }
    s = s + 1usize;
  }
  NO_SLOT
}

// The text of a world read into its image
pub fn readImage(file: &str, text: &Array[u8]) ImageWorld {
  var names = Names.standard();
  let vocab = vocabulary(&mut names);
  var reading = read(text, names, vocab);
  var problems = List[Problem]();
  problems <-> reading.problems;
  var parts = ImageParts();
  var dropped = List[String]();
  var feet = Vec3(0., 0., 0.);
  var lights = List[LightAt]();
  var arrivals = List[u32]();       // the first arrival's slot, if any
  fillImage(&reading.understood, &mut parts, &mut dropped, &mut feet, &mut lights, &mut arrivals);
  // the keys rules' animators: a PartBuilder runs the units that give each key's value
  var keys = KeysDecls();
  var looks = LookParts();
  let w = &reading.understood;
  match PartBuilder.make(w, toolImports(&w.vocab, &w.names)) {
    case let Ok(made) { var bld = made; keys = keysOf(w, &mut bld); looks = lookPartsOf(w, &mut bld, &lights, &arrivals); }
    case let Err(why) {
      print <- "build: "; printStr(file); print <- ": the keys rules were left out, the world's code was refused ("; print <- u64.from(why.len()); print <- " problems)\n";
    }
  }
  ImageWorld(String.from(file), parts, dropped, problems, feet, behaviourOf(w, keys), looks, firstDroppedSlot(w), u32.from(w.nodes.len()))
}

// The world's sun, lamps, camera and sky as parts, each built by partbuild as the guide browser's build.cone builds it (sunOf,
// lampOf, the Stand): every light is a part where its part stands, the first arrival is the camera part (with its camera's
// settings, or none said), and a world with a sun has its root part carry the sky made from it. A world with none of these
// has no such part, and Render keeps its own
fn lookPartsOf(w: &Understood, bld: &mut PartBuilder, lights: &List[LightAt], arrivals: &List[u32]) LookParts {
  var out = LookParts();
  var hasSun = false;
  each at in lights {
    let p = bld.buildPart(usize.from(at.slot), Kind.Light);
    if !p.made { continue; }
    var look = noLook();
    if p.light.kind == LIGHT_SUN {
      hasSun = true;
      look.kind = LOOK_SUN;
      look.dir = p.light.sun.toSun;
      look.color = Vec3(p.light.sun.color.red, p.light.sun.color.green, p.light.sun.color.blue);
      look.amount = p.light.sun.lux;
      look.shadows = p.light.sun.shadows;
    } else {
      let l = &p.light.lamp;
      look.kind = LOOK_POINT;
      look.color = Vec3(l.color.red, l.color.green, l.color.blue);
      look.amount = l.candela;
      look.reach = l.reach;
      look.source = l.source;
      look.shadows = l.shadows;
      if l.spot {
        look.kind = LOOK_SPOT;
        look.dir = l.aim;
        look.cone = l.cone;
        look.softEdge = l.softEdge;
      }
    }
    out.push(LookPart(at.slot, pathOf(w, usize.from(at.slot)), u32.from(w.nodes[usize.from(at.slot)].parent), at.place, look));
  }
  if arrivals.len() > 0usize {
    let slot = *arrivals[0usize];
    let p = bld.buildPart(usize.from(slot), Kind.Arrival);
    var look = noLook();
    look.kind = LOOK_CAMERA;
    if p.hasCamera {
      look.lens = p.camera.lens;
      look.aperture = p.camera.aperture;
      look.focus = p.camera.focus;
      look.exposure = p.camera.exposure;
    }
    out.push(LookPart(slot, pathOf(w, usize.from(slot)), u32.from(w.nodes[usize.from(slot)].parent), Mat4.identity(), look));
  }
  if hasSun {
    var look = noLook();
    look.kind = LOOK_SKY;
    out.push(LookPart(0u32, pathOf(w, 0usize), 0u32, Mat4.identity(), look));
  }
  out
}

// How many different mesh keys the parts have
pub fn distinctKeys(image: &ImageWorld) usize {
  var seen = List[ContentKey]();
  each p in &image.parts {
    if !seen.contains(&p.key) { seen.push(p.key); }
  }
  seen.len()
}

// How many different material keys the parts have
pub fn distinctMaterials(image: &ImageWorld) usize {
  var seen = List[ContentKey]();
  each p in &image.parts {
    if !seen.contains(&p.material) { seen.push(p.material); }
  }
  seen.len()
}

fn fillImage(w: &Understood, parts: &mut ImageParts, dropped: &mut List[String], feet: &mut Vec3, lights: &mut List[LightAt],
    arrivals: &mut List[u32]) {
  var places = List[Mat4]();        // by slot: the part's own frame, in the world's
  var s = 0usize;
  while s < w.nodes.len() {
    places.push(Mat4.identity());
    if !*w.alive[s] { dropped.push(pathOf(w, s)); }
    s = s + 1usize;
  }
  var standing = false;
  var i = 0usize;
  while i < w.order.len() {
    let slot = *w.order[i];
    let kind = w.nodes[slot].kind;
    let parent = w.nodes[slot].parent;
    var at = Vec3(0., 0., 0.);
    var turn = Quat.identity();
    if kind == Kind.Group || kind == Kind.Shape || kind == Kind.Light {
      if !(w.units[slot].options[OPT_AT] is Absent) { at = vec3(&w.units[slot].options[OPT_AT]); }
      turn = turnOf(w, &w.units[slot].options[OPT_ROTATION]);
      places.set(slot, *places[parent] * Mat4.fromTrs(at, turn, Vec3(1., 1., 1.)));
    }
    if kind == Kind.Shape {
      var args = List[f32]();
      flatten(w, &w.units[slot].make, &mut args);
      var matArgs = List[f32]();
      match &w.units[slot].options[OPT_MATERIAL] {
        case let Ref(m) { flatten(w, &w.units[*m].make, &mut matArgs); }
        else { flatten(w, &w.units[slot].options[OPT_MATERIAL], &mut matArgs); }
      }
      var shape = String.from("cs.");
      appendTopName(w, &w.units[slot].make, &mut shape);
      let recipe = Recipe(shape, args, 0u32, u32.from(slot));
      let key = keyOf(&recipe);
      let materialRecipe = Recipe(String.from(MATERIAL_SHAPE), matArgs, 0u32, u32.from(slot));
      let material = materialKeyOf(&materialRecipe);
      parts.push(ImagePart(u32.from(slot), pathOf(w, slot), u32.from(parent), at, turn, *places[slot], recipe, key, materialRecipe, material));
    }
    else if kind == Kind.Light {
      if *w.alive[slot] { lights.push(LightAt(u32.from(slot), *places[slot])); }
    }
    else if kind == Kind.Arrival && !standing {
      arrivals.push(u32.from(slot));
      *feet = *places[parent] * vec3(&w.units[slot].options[OPT_AT]);
      standing = true;
    }
    i = i + 1usize;
  }
}

// The world's rules and what they need (behaviour.cone), as guidebrowser\src\build.cone's `program` makes them
fn behaviourOf(w: &Understood, keys: KeysDecls) Behaviour {
  var frames = SlotFrames();
  var s = 0usize;
  while s < w.nodes.len() {
    let kind = w.nodes[s].kind;
    var at = Vec3(0., 0., 0.);
    var turn = Quat.identity();
    if kind == Kind.Group || kind == Kind.Shape || kind == Kind.Light {
      if !(w.units[s].options[OPT_AT] is Absent) { at = vec3(&w.units[s].options[OPT_AT]); }
      turn = turnOf(w, &w.units[s].options[OPT_ROTATION]);
    }
    frames.push(SlotFrame(String.from(w.names.text(w.nodes[s].name)), u32.from(w.nodes[s].parent), at, turn));
    s = s + 1usize;
  }
  var fields = FieldDecls();
  var i = 0usize;
  while i < w.fields.len() {
    fields.push(FieldDecl(String.from(w.names.text(w.fields[i].name)), w.fields[i].init));
    i = i + 1usize;
  }
  var derives = DeriveDecls();
  i = 0usize;
  while i < w.deriveOrder.len() {
    let d = &w.derives[*w.deriveOrder[i]];
    if d.live { derives.push(DeriveDecl(d.target.prop, u32.from(d.target.index), u32.from(*w.deriveOrder[i]))); }
    i = i + 1usize;
  }
  var areas = AreaDecls();
  i = 0usize;
  while i < w.areas.len() {
    let a = &w.areas[i];
    if a.live { areas.push(AreaDecl(u32.from(a.slot), Vec3(f32.from(a.cx), f32.from(a.cy), f32.from(a.cz)), f32.from(a.radius))); }
    i = i + 1usize;
  }
  var moves = MoveDecls();
  i = 0usize;
  while i < w.moves.len() {
    if *w.alive[w.moves[i].part] { moves.push(MoveDecl(u32.from(w.moves[i].part), u32.from(i))); }
    i = i + 1usize;
  }
  var avatar = NO_AVATAR;
  if w.avatars.len() > 0usize && *w.alive[*w.avatars[0usize]] { avatar = u32.from(*w.avatars[0usize]); }
  Behaviour(lowerSim(w), frames, fields, derives, moves, keys, areas, avatar)
}

// "board.pieces.whiteRook1.body"
fn pathOf(w: &Understood, slot: usize) String {
  var chain = List[u32]();
  var s = slot;
  chain.push(w.nodes[s].name);
  while w.nodes[s].parent != s {
    s = w.nodes[s].parent;
    chain.push(w.nodes[s].name);
  }
  var path = String();
  var k = chain.len();
  while k > 0usize {
    k = k - 1usize;
    path.append(w.names.text(*chain[k]));
    if k > 0usize { path.appendByte('.'); }
  }
  path
}

// ---- the recipe's values ----

// The name of vocabulary row 'tool', the names of its path joined by dots ("lathe", "outline.rectangle")
fn appendToolName(w: &Understood, tool: u32, out: &mut String) {
  let path = &w.vocab.tools[usize.from(tool)].path;
  var k = 0usize;
  while k < path.len() {
    if k > 0usize { out.appendByte('.'); }
    out.append(w.names.text(*path[k]));
    k = k + 1usize;
  }
}

fn appendTopName(w: &Understood, v: &Val, out: &mut String) {
  match v {
    case let Make(m) { appendToolName(w, m.tool, out); }
    case let Call(n) { appendTopName(w, &w.functions[*n].result, out); }
    else { out.append("shape"); }
  }
}

// The value as numbers, in prefix order (see the top of this file)
fn flatten(w: &Understood, v: &Val, out: &mut List[f32]) {
  match v {
    case let Num(x) { out.push(1.); out.push(f32.from(*x)); }
    case let Truth(b) { out.push(2.); if *b { out.push(1.); } else { out.push(0.); } }
    case let Tuple(items) { out.push(3.); out.push(f32.from(items.len())); each it in &*items { flatten(w, it, out); } }
    case let Range(items) { out.push(4.); out.push(f32.from(items.len())); each it in &*items { flatten(w, it, out); } }
    case let Ref(slot) { out.push(5.); out.push(f32.from(*slot)); }
    case let Make(m) {
      out.push(6.); out.push(f32.from(m.tool)); out.push(f32.from(m.args.len()));
      each a in &m.args { flatten(w, a, out); }
    }
    case let Items(items) { out.push(7.); out.push(f32.from(items.len())); each it in &*items { flatten(w, it, out); } }
    case let Local(k) { out.push(8.); out.push(f32.from(*k)); }
    case let Call(n) {
      out.push(9.);
      let f = &w.functions[*n];
      out.push(f32.from(f.lets.len()));
      each l in &f.lets { flatten(w, l, out); }
      flatten(w, &f.result, out);
    }
    else { out.push(0.); }
  }
}

// ---- placement, as guidebrowser\src\build.cone reads it (a copy of the little it needs) ----

fn vec3(v: &Val) Vec3 {
  match v {
    case let Tuple(items) {
      return Vec3(f32.from(numOf(&items[0usize])), f32.from(numOf(&items[1usize])), f32.from(numOf(&items[2usize])));
    }
    else {}
  }
  Vec3(0., 0., 0.)
}

// rotation(angle, about:), about the upright axis when 'about' is left out
fn turnOf(w: &Understood, rotation: &Val) Quat {
  match rotation {
    case let Make(m) {
      let axis = if m.args[1usize] is Absent { Vec3(0., 1., 0.) } else { vec3(&m.args[1usize]).normalize() };
      Quat.angleAxis(f32.from(numOf(&m.args[0usize])), axis)
    }
    else { Quat.identity() }
  }
}
