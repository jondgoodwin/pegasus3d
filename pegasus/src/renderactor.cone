// Render: puts the picture on the display every frame and never waits for
// Sim, the Loader or a world's code (`Browser\doc\actors\render.md` and
// `doc\design\frame-and-deadlines.md`, design choices, all proposed).
//
// A frame, on Render's own clock (the display's, through a vsynced present;
// headless, a timer at HEADLESS_HZ):
//   1. take content the Loader moved, under the per-frame upload budget,
//      uploading it to the GPU and keeping no CPU copy;
//   2. blend the two newest snapshots by the frame's display time (drawn one
//      step behind, so there is a newer one to blend toward);
//   3. read the head pose, last (readHeadPose: the one function that reads it);
//   4. draw and present;
//   5. publish the frame as drawn (DrawnFrame, state) for Player and Sim.
//
// Its behaviours: snapshot (Sim, latest), content (Loader, bulk move),
// inhabit (Player, event), run (the frame loop), stop.
//
// It is the only code that submits to the GPU. Its device is made by its
// initializer, which runs on the shell's thread (the one that made the
// window, as SDL wants); from then on only its messages reach it, on
// whichever worker runs them, as the island's RenderActor does.

pub const UPLOAD_BUDGET_BYTES = 4194304usize;  // a frame's uploads (the island's 4 MB)
pub const HEADLESS_HZ = 72u64;                 // a headless Render's frame rate (a Quest's display)
pub const EYE_HEIGHT: f32 = 1.6;
const XR_TRIGGER_DOWN: f32 = 0.75;             // the right trigger counts as pulled past this, and as let go below the next
const XR_TRIGGER_UP: f32 = 0.5;
const XR_FLOOR_MIN: f32 = 0.8;                 // a first head height above this means the room's floor is the space's origin

// The GPU side. Made first, ended last: fields end in order, so what was
// made on the device comes before it.
struct Gfx {
  list: DrawList;
  renderer: Renderer;
  post: Post;
  fx: ImageFx;                      // the image-quality passes the guide browser draws through: anti-aliasing, ambient occlusion, auto-exposure
  swapchain: Option[SwapChain];     // a window's; none off screen
  color: Option[Texture];           // off screen (--shot): the picture and its depth
  depth: Option[Texture];
  width: u32;
  height: u32;
  xr: bool;                         // --xr: the headset's eyes are drawn, not a window
  target: SurfaceTexture;           // --xr: a stand-in the eye's images are swapped into while an eye is drawn
  headset: Headset;                 // --xr: ends before the device it draws on
  light: Light;
  device: Device;
  adapter: Adapter;
  surface: Surface;
  instance: Instance;
}

// A shot's own camera (--shot-view): where the eye is, what it looks at, and its vertical field of view in degrees
pub struct ShotView {
  pub set: bool;
  pub eye: Vec3;
  pub look: Vec3;
  pub fovDegrees: f32;

  pub fn none() ShotView { ShotView(false, Vec3(0., 0., 0.), Vec3(0., 0., 0.), 60.) }
}

const SHOT_SETTLE_FRAMES = 119u32;    // drawn before a shot's own: it is the 120th frame, as the guide browser's shot is

// Meshes and materials resident on the GPU, each by its own key
struct Resident {
  key: ContentKey;
  mesh: MeshHandle;
}
alias Residents = List[Resident];
alias Arrivals = List[MeshContent];

struct MaterialResident {
  key: ContentKey;
  material: MaterialHandle;
}
alias MaterialResidents = List[MaterialResident];

// A part as step 4 draws it (`chooseDrawn`): the mesh and the material chosen, and the keys they are resident under
pub struct Chosen {
  pub id: PartId;
  pub meshKey: ContentKey;
  pub materialKey: ContentKey;      // the material key drawn: the part's own, or its previous one until its own is resident
  pub mesh: MeshHandle;
  pub material: MaterialHandle;
  pub place: Mat4;
}
alias MaterialArrivals = List[MaterialContent];

// What steps 1 and 2 of a frame leave for 3 to 5
pub struct FramePlan {
  pub nowNs: u64;
  pub feet: Vec3;                   // the person, blended
  pub step: u64;                    // the newer snapshot's step (0: none yet)
  pub earlyLook: LookIntent;        // the mutant's stale read (PEGASUS_MUTANT=stale-pose)
  pub earlySeq: u64;
}

// The head as read (readHeadPose): where the eye is from the person's feet, and which way it looks. In the headset the eyes
// themselves are in the frame the runtime located at the display time, which this read took.
pub struct HeadRead {
  pub look: LookIntent;
  pub offset: Vec3;                 // the eye from the person's feet
  pub hand: HandRay;                // the right controller's ray at the same moment (--xr)
}

// Render's work, apart from the actor, so a check can drive a frame step by
// step without a GPU or a thread
pub struct RenderCore {
  gfx: Option[Gfx];
  looks: StateReader[LookIntent];
  drawnOut: StateWriter[DrawnFrame];
  older: Option[Published];
  newer: Option[Published];
  arrivals: Arrivals;               // moved by the Loader, not yet uploaded
  residents: Residents;
  materialArrivals: MaterialArrivals;
  materials: MaterialResidents;
  shownMaterial: List[ContentKey];  // by part id: the material key the part was last drawn with (0: none yet)
  deferred: List[ContentKey];       // material keys the Loader released while a part still drew with them
  mutantStaleMaterial: bool;        // the material check's mutant: a part keeps its first material for good
  mutantNoShow: bool;               // the material check's other mutant: a part waits for its new material, drawing nothing
  frame: u64;
  avatar: PartId;
  camera: PartId;
  stalePose: bool;                  // the head-pose check's mutant
  blendAlpha: f32;                  // how far between the two newest snapshots this frame is (1: the newer)
  pub uploadedBytes: usize;
  pub released: u64;                // keys whose mesh was dropped on the Loader's word
  pub uploadFrames: u64;            // frames that uploaded anything
  pub sumMismatches: u64;           // snapshots found changed after publishing
  pub lastFrameNs: u64;
  pub longestGapNs: u64;            // between two frames
  pub sameSince: u64;               // when the snapshot drawn last changed
  pub sameStep: u64;
  pub longestSameNs: u64;           // the longest time drawing without a new snapshot
  pub framesDuringSame: u64;        // frames drawn in that time
  pub framesNow: u64;
  pub firstDrawnNs: u64;            // arrival: when a frame first drew a part (the clock `Instant.now().nanos()`; 0: not yet)
  pub tenDrawnNs: u64;              // when a frame first drew ten parts
  pub allDrawnNs: u64;              // when a frame first drew every part of the snapshot
  pub arrivalGapNs: u64;            // the longest gap between two frames up to then
  xrFrame: Option[HeadsetFrame];    // --xr: the runtime's frame this Render frame draws, begun (waited for) when it was prepared
  rays: Option[StateWriter[HandRay]];   // --xr: where the controller's ray is published
  xrStand: f32;                     // --xr: added to the head's height when the space's origin is the head, not the floor
  xrBase: Vec3;                     // --xr: where the headset's space origin is in the world this frame
  xrPulls: u64;
  xrPulled: bool;                   // the trigger is held past XR_TRIGGER_DOWN
  xrStarted: bool;                  // the first located frame decided xrStand
  pub xrEnded: bool;                // the headset's session is over: the run ends
  pub view: ShotView;               // the shot's own camera, if --shot-view named one
  pub traceDrawn: bool;             // PEGASUS_TRACE_DRAWN is set: a part whose turn changes between snapshots prints its drawn turn

  pub fn make(looks: StateReader[LookIntent], drawnOut: StateWriter[DrawnFrame], stalePose: bool) RenderCore {
    RenderCore(None[Gfx], looks, drawnOut, None[Published], None[Published], Arrivals(), Residents(), MaterialArrivals(),
      MaterialResidents(), List[ContentKey](), List[ContentKey](), mutantIs("material-stale"), mutantIs("material-no-show"), 0u64,
      NO_PART, NO_PART, stalePose, 1., 0usize, 0u64, 0u64, 0u64, 0u64, 0u64, 0u64, 0u64, 0u64, 0u64, 0u64,
      0u64, 0u64, 0u64, 0u64, None[HeadsetFrame], None[StateWriter[HandRay]], 0., Vec3(0., 0., 0.), 0u64, false, false, false, ShotView.none(),
      (libc.getenv("PEGASUS_TRACE_DRAWN") as usize) != 0usize)
  }

  // Whether the picture is the headset's
  pub fn isXr(self: &) bool {
    var on = false;
    match &gfx {
      case let Some(g) { on = g.xr; }
      case is None[Gfx] {}
    }
    on
  }

  // --xr: begin the runtime's frame. This waits until the runtime wants one (the headset's pace), so it is done before the
  // snapshots are blended: the display time is then the time the wait ended, and the eyes the runtime located for it.
  fn awaitHeadsetFrame(self: &mut) {
    xrFrame = None[HeadsetFrame];
    match &mut gfx {
      case var &mut Some(g) {
        if !g.xr { return; }
        if !g.headset.pollEvents() { xrEnded = true; return; }
        let f = g.headset.beginFrame(&mut g.device);
        if !f.active { sdl.Delay(5u32); }     // (a session between READY and STOPPING only: not a spin)
        xrFrame = Some[HeadsetFrame](f);
      }
      else {}
    }
  }

  // --xr, the end of the run: the session ends as OpenXR has it end (asked to exit, STOPPING answered by pollEvents)
  pub fn endHeadset(self: &mut) {
    match &mut gfx {
      case var &mut Some(g) {
        if !g.xr { return; }
        g.headset.requestExit();
        var waited = 0;
        while g.headset.isRunning() && waited < 400 {
          g.headset.pollEvents();
          sdl.Delay(5u32);
          waited = waited + 1;
        }
        g.device.waitIdle();
      }
      else {}
    }
  }

  // The newest snapshot: kept with the one before it
  pub fn takeSnapshot(self: &mut, s: Published) {
    older = None[Published];
    older <-> newer;
    newer = Some[Published](s);
  }

  pub fn takeContent(self: &mut, c: MeshContent) { arrivals.push(c); }

  pub fn takeMaterial(self: &mut, c: MaterialContent) { materialArrivals.push(c); }

  // How many entries are resident: meshes and materials
  pub fn residentCount(self: &) usize { residents.len() + materials.len() }

  pub fn meshResident(self: &, key: ContentKey) bool {
    each r in &residents { if r.key == key { return true; } }
    false
  }

  pub fn materialResident(self: &, key: ContentKey) bool {
    each r in &materials { if r.key == key { return true; } }
    false
  }

  // Whether 'key' (a mesh key or a material key) is resident
  pub fn isResident(self: &, key: ContentKey) bool { self.meshResident(key) || self.materialResident(key) }

  // The material key part 'id' was last drawn with (0: none yet)
  pub fn shownMaterialOf(self: &, id: PartId) ContentKey {
    if usize.from(id) < shownMaterial.len() { *shownMaterial[usize.from(id)] } else { 0u64 }
  }

  fn drawsWith(self: &, key: ContentKey) bool {
    each m in &shownMaterial { if *m == key { return true; } }
    false
  }

  // Loader -> Render: nothing uses 'key' now, so its mesh or material may go: from the
  // arrivals if not yet uploaded, else from the GPU. A material a part still draws with, while its new one is not yet
  // resident, goes when no part draws with it
  pub fn releaseContent(self: &mut, key: ContentKey) {
    var i = 0usize;
    while i < arrivals.len() {
      if arrivals[i].key == key { _ = arrivals.remove(i); } else { i = i + 1usize; }
    }
    i = 0usize;
    while i < materialArrivals.len() {
      if materialArrivals[i].key == key { _ = materialArrivals.remove(i); } else { i = i + 1usize; }
    }
    if self.materialResident(key) && self.drawsWith(key) {
      if !deferred.contains(&key) { deferred.push(key); }
      return;
    }
    self.dropMaterial(key);
    i = 0usize;
    while i < residents.len() {
      if residents[i].key == key {
        match &mut gfx {
          case var &mut Some(g) {
            _ = g.renderer.removeMesh(&mut g.device, residents[i].mesh);
          }
          else {}
        }
        _ = residents.remove(i);
        released = released + 1u64;
      } else {
        i = i + 1usize;
      }
    }
  }

  // The material 'key' leaves the GPU (nothing if it is not resident)
  fn dropMaterial(self: &mut, key: ContentKey) {
    var i = 0usize;
    while i < materials.len() {
      if materials[i].key == key {
        match &mut gfx {
          case var &mut Some(g) { _ = g.renderer.removeMaterial(&mut g.device, materials[i].material); }
          else {}
        }
        _ = materials.remove(i);
        released = released + 1u64;
      } else {
        i = i + 1usize;
      }
    }
  }

  // The materials released while a part still drew with them, now that no part does
  fn dropDeferred(self: &mut) {
    var i = 0usize;
    while i < deferred.len() {
      let key = *deferred[i];
      if self.drawsWith(key) { i = i + 1usize; } else { self.dropMaterial(key); _ = deferred.remove(i); }
    }
  }

  // Steps 1 and 2
  pub fn prepare(self: &mut) FramePlan {
    self.awaitHeadsetFrame();     // (in the headset only: the runtime's wait is the frame's clock, so it comes first)
    let now = u64.from(Instant.now().nanos());
    frame = frame + 1u64;
    if lastFrameNs != 0u64 && now - lastFrameNs > longestGapNs { longestGapNs = now - lastFrameNs; }
    if allDrawnNs == 0u64 && lastFrameNs != 0u64 && now - lastFrameNs > arrivalGapNs { arrivalGapNs = now - lastFrameNs; }
    lastFrameNs = now;
    self.upload();
    var plan = FramePlan(now, Vec3(0., 0., 0.), 0u64, LookIntent(0., 0.), 0u64);
    self.blend(&mut plan);
    if plan.step != sameStep || sameSince == 0u64 {
      sameStep = plan.step;
      sameSince = now;
      framesNow = 0u64;
    } else {
      framesNow = framesNow + 1u64;
      if now - sameSince > longestSameNs { longestSameNs = now - sameSince; framesDuringSame = framesNow; }
    }
    if stalePose {
      plan.earlyLook = looks.newest();
      plan.earlySeq = looks.seq();
    }
    plan
  }

  // Steps 3 to 5: the head pose read last, the picture, the frame as drawn
  pub fn finish(self: &mut, plan: &FramePlan) DrawnFrame {
    var head = self.readHeadPose();
    var seq = looks.seq();
    if stalePose { head.look = plan.earlyLook; seq = plan.earlySeq; }
    let look = head.look;
    let eye = plan.feet + head.offset;
    xrBase = plan.feet + Vec3(0., xrStand, 0.);
    self.noteArrival();
    self.draw(eye, look, "");
    if head.hand.pulls != xrPulls || head.hand.valid {
      xrPulls = head.hand.pulls;
      match &mut rays {
        case var &mut Some(w) { var ray = head.hand; ray.atNs = plan.nowNs; ray.from = ray.from + plan.feet; w.put(&ray); }
        else {}
      }
    }
    let d = DrawnFrame(frame, plan.nowNs, plan.step, eye, look.yaw, look.pitch, seq);
    drawnOut.put(&d);
    d
  }

  // THE HEAD POSE, read in this one function only, last before drawing. On
  // the desktop it is Player's mouse look. In the headset it is the pose the
  // runtime located for this frame's display time (beginFrame, which
  // prepare called; it returns the pose with the wait's end, the latest the
  // runtime gives): the midpoint of the eyes from the floor, and the way the
  // left eye faces. The right controller's ray is read with it.
  fn readHeadPose(self: &mut) HeadRead {
    var head = HeadRead(looks.newest(), Vec3(0., EYE_HEIGHT, 0.), HandRay(false, Vec3(0., 0., 0.), Vec3(0., 0., -1.), xrPulls, 0u64));
    match &xrFrame {
      case let Some(f) {
        if f.active && f.shouldRender && f.located {
          let a = f.views[0usize].pose;
          let b = f.views[1usize].pose;
          let mid = Vec3((a.position.x + b.position.x) * 0.5, (a.position.y + b.position.y) * 0.5, (a.position.z + b.position.z) * 0.5);
          if !xrStarted {
            xrStarted = true;
            xrStand = if mid.y > XR_FLOOR_MIN { 0. } else { EYE_HEIGHT };
          }
          head.offset = mid + Vec3(0., xrStand, 0.);
          let fwd = Quat(a.orientation.x, a.orientation.y, a.orientation.z, a.orientation.w) * Vec3(0., 0., -1.);
          head.look = LookIntent(atan2(0. - fwd.x, 0. - fwd.z), asin(fwd.y));
          // the right controller: its aim pose is the ray, and the trigger's pulls are counted here, with hysteresis
          let h = f.hands[1usize];
          if h.active && h.aim.valid {
            head.hand.valid = true;
            head.hand.from = Vec3(0., xrStand, 0.) + h.aim.position;    // (relative to the feet; made absolute below)
            head.hand.along = h.aim.forward().normalize();
          }
          if h.active {
            if !xrPulled && h.trigger > XR_TRIGGER_DOWN { xrPulled = true; head.hand.pulls = head.hand.pulls + 1u64; }
            else if xrPulled && h.trigger < XR_TRIGGER_UP { xrPulled = false; }
          }
        }
      }
      case is None[HeadsetFrame] {}
    }
    head
  }

  // Step 1: what the Loader moved, under the budget (at least one item a
  // frame, so a large one is never starved). Each is uploaded, then dropped
  fn upload(self: &mut) {
    var spent = 0usize;
    // the materials first: a record each, and a part waits for its material as for its mesh
    var takenMats = 0usize;
    while takenMats < materialArrivals.len() && (takenMats == 0usize || spent + materialArrivals[takenMats].bytes <= UPLOAD_BUDGET_BYTES) {
      spent = spent + materialArrivals[takenMats].bytes;
      takenMats = takenMats + 1usize;
    }
    each arrivedMat in materialArrivals.drain(0usize, takenMats) {
      let c = arrivedMat;
      // a key that arrives again (released, then asked for anew) replaces what was resident
      match deferred.indexOf(&c.key) {
        case let Some(d) { _ = deferred.remove(d); }
        case is None[usize] {}
      }
      var gone = 0usize;
      while gone < materials.len() {
        if materials[gone].key == c.key { self.dropMaterial(c.key); gone = 0usize; } else { gone = gone + 1usize; }
      }
      match &mut gfx {
        case var &mut Some(g) { materials.push(MaterialResident(c.key, uploadLook(g, &c.look))); }
        else { materials.push(MaterialResident(c.key, MaterialHandle.none())); }
      }
    }
    var taken = 0usize;
    while taken < arrivals.len() && ((taken == 0usize && takenMats == 0usize) || spent + arrivals[taken].bytes <= UPLOAD_BUDGET_BYTES) {
      spent = spent + arrivals[taken].bytes;
      taken = taken + 1usize;
    }
    if taken == 0usize && takenMats == 0usize { return; }
    each arrived in arrivals.drain(0usize, taken) {
      var c = arrived;
      match &mut gfx {
        case var &mut Some(g) {
          // a part whose build left it out has no mesh: resident (so it is not asked for again), never drawn
          if c.mesh.positions.len() == 0usize {
            residents.push(Resident(c.key, MeshHandle.none()));
            continue;
          }
          // shading needs normals: flat ones when the build gave none
          var mesh = Mesh.cube(1.);
          mesh <-> c.mesh;
          if mesh.normals.len() != mesh.positions.len() { mesh.computeFlatNormals(); }
          let m = g.renderer.addMesh(&mut g.device, &mesh);
          residents.push(Resident(c.key, m));
        }
        else { residents.push(Resident(c.key, MeshHandle.none())); }
      }
    }
    uploadedBytes = uploadedBytes + spent;
    uploadFrames = uploadFrames + 1u64;
  }

  // Step 2: the person between the two newest snapshots, at the display
  // time less a step; and each snapshot checked against its sum
  fn blend(self: &mut, plan: &mut FramePlan) {
    let target = plan.nowNs - STEP_NS;
    match &newer {
      case let Some(b) {
        plan.step = b.step;
        plan.feet = b.person.feet;
        if snapshotSum(&**b) != b.sum { sumMismatches = sumMismatches + 1u64; }
        match &older {
          case let Some(a) {
            if snapshotSum(&**a) != a.sum { sumMismatches = sumMismatches + 1u64; }
            if b.atNs > a.atNs {
              var alpha: f32 = 1.;
              if target <= a.atNs { alpha = 0.; }
              else if target < b.atNs { alpha = f32.from(target - a.atNs) / f32.from(b.atNs - a.atNs); }
              plan.feet = a.person.feet + (b.person.feet - a.person.feet) * alpha;
              blendAlpha = alpha;
            }
          }
          case is None[Published] {}
        }
      }
      case is None[Published] {}
    }
  }

  // Where the k-th part of the newer snapshot is drawn: between where the older snapshot had it and where the newer has
  // it, by the same blend as the person (a part a rule glides or turns moves smoothly between steps): its place along
  // a line, its turn by slerp (blend.cone)
  fn blendedPlace(self: &, k: usize, p: &PartState) Mat4 {
    var place = p.placement;
    match &older {
      case let Some(a) {
        if k < a.parts.len() && a.parts[k].id == p.id && blendAlpha < 1. {
          place = blendPlacement(&a.parts[k].placement, &p.placement, blendAlpha);
          if traceDrawn && (a.parts[k].placement.m[0] != p.placement.m[0] || a.parts[k].placement.m[2] != p.placement.m[2]) {
            print <- "drawn turn: frame "; print <- frame; print <- " part "; print <- k;
            print <- " alpha "; print <- blendAlpha; print <- " yaw degrees "; print <- degrees(atan2(0. - place.m[2], place.m[0])); print <- "\n";
          }
        }
      }
      case is None[Published] {}
    }
    place
  }

  // The material to draw part 'p' with: its own once resident, else the one the part was last drawn with, while that is
  // resident; none when the part has had no material yet (it is not shown until its first is resident)
  fn materialToDraw(self: &mut, p: &PartState) Option[MaterialResident] {
    let id = usize.from(p.id);
    while shownMaterial.len() <= id { shownMaterial.push(0u64); }
    var want = p.material;
    if mutantStaleMaterial && *shownMaterial[id] != 0u64 { want = *shownMaterial[id]; }      // the mutant: never changes
    each m in &materials {
      if m.key == want { shownMaterial.set(id, want); return Some[MaterialResident](*m); }
    }
    if mutantNoShow { return None[MaterialResident]; }                                        // the mutant: waits, drawing nothing
    let last = *shownMaterial[id];
    if last != 0u64 {
      each m in &materials { if m.key == last { return Some[MaterialResident](*m); } }
    }
    None[MaterialResident]
  }

  // What step 4 draws: each part of the newer snapshot whose mesh and a material are resident, as its mesh, its
  // material and where it stands this frame. A part draws with its own material key once that is resident, and with the
  // one it showed before until then. (A mesh left out by its build is resident with no handle: chosen, never drawn.)
  pub fn chooseDrawn(self: &mut) List[Chosen] {
    var out = List[Chosen]();
    let snap = newer;
    match &snap {
      case let Some(s) {
        var k = 0usize;
        each p in &s.parts {
          let place = self.blendedPlace(k, p);
          match self.materialToDraw(p) {
            case let Some(mat) {
              each r in &residents {
                if r.key == p.key { out.push(Chosen(p.id, p.key, mat.key, r.mesh, mat.material, place)); }
              }
            }
            case is None[MaterialResident] {}
          }
          k = k + 1usize;
        }
      }
      case is None[Published] {}
    }
    self.dropDeferred();
    out
  }

  // Arrival's marks: the first frame that drew a part, ten parts, and every part of the snapshot, each printed once as
  // an absolute time on the clock the Loader's "arrival: opened" line uses (the difference is the time from the opening)
  fn noteArrival(self: &mut) {
    if allDrawnNs != 0u64 { return; }
    // the parts `chooseDrawn` would draw: a mesh and a material resident (counted here, so a headless run, which draws nothing, has marks too)
    var drawn = 0usize;
    var total = 0usize;
    let snap = newer;
    match &snap {
      case let Some(s) {
        total = s.parts.len();
        each p in &s.parts {
          match self.materialToDraw(p) {
            case is Some { if self.meshResident(p.key) { drawn = drawn + 1usize; } }
            case is None[MaterialResident] {}
          }
        }
      }
      case is None[Published] {}
    }
    if drawn == 0usize { return; }
    let now = u64.from(Instant.now().nanos());
    if firstDrawnNs == 0u64 { firstDrawnNs = now; printStr(numberLine("arrival: first part drawn at ", now, " ns\n").view()); }
    if tenDrawnNs == 0u64 && drawn >= 10usize { tenDrawnNs = now; printStr(numberLine("arrival: ten parts drawn at ", now, " ns\n").view()); }
    if drawn >= total {
      allDrawnNs = now;
      printStr(numberLine("arrival: all parts drawn at ", now, numberLine(" ns; longest gap between frames up to then ", arrivalGapNs / 1000u64, " us\n").view()).view());
    }
  }

  // Step 4: the newer snapshot's resident parts, from 'eye' looking along
  // 'look'; to the window, or off screen and saved to 'shot' when named
  fn draw(self: &mut, eye: Vec3, look: LookIntent, shot: &str) {
    var g: Option[Gfx] = None;
    g <-> gfx;
    match &mut g {
      case var &mut Some(some) { self.drawWith(some, eye, look, shot); }
      else {}
    }
    g <-> gfx;
  }

  fn drawWith(self: &mut, g: &mut Gfx, eye: Vec3, look: LookIntent, shot: &str) {
    var camera = Camera.make();
    camera.fov = radians(60.);
    camera.near = 0.1;
    camera.far = 500.;
    camera.background = Color(0.5, 0.7, 0.9, 1.);
    let ahead = Vec3(0. - sin(look.yaw) * cos(look.pitch), sin(look.pitch), 0. - cos(look.yaw) * cos(look.pitch));
    if shot.len() > 0usize && self.view.set {     // --shot-view: the shot's camera named, to be set beside another browser's
      camera.fov = radians(self.view.fovDegrees);
      camera.lookAt(self.view.eye, self.view.look, Vec3(0., 1., 0.));
    } else {
      camera.lookAt(eye, eye + ahead, Vec3(0., 1., 0.));
    }
    g.list.clear();
    let chosen = self.chooseDrawn();
    each c in &chosen {
      if !c.mesh.isNone() { g.list.add(c.mesh, c.material, c.place); }
    }
    if g.xr { self.drawEyes(g); return; }
    var w = g.width;
    var h = g.height;
    match &mut g.swapchain {
      case var &mut Some(sc) {
        let target = sc.getCurrentTexture(&mut g.device);
        if !target.ok() { return; }
        w = target.texture.width;
        h = target.texture.height;
        g.post.resize(&mut g.device, w, h);
        var encoder = g.device.createCommandEncoder();
        g.fx.render(&mut g.device, &mut encoder, &mut g.renderer, &mut g.post, &camera, &g.light, &g.list, &target.texture);
        _ = g.device.queue.submit(encoder.finish());
        _ = sc.present(&mut g.device);
        return;
      }
      else {}
    }
    // Off screen: drawn only when a shot is asked for
    if shot.len() == 0usize { return; }
    match &g.color {
      case let Some(color) {
        match &g.depth {
          case let Some(depth) {
            // The passes adapt over frames (the exposure to the scene, the anti-aliasing's history): the same frame is drawn
            // SHOT_SETTLE_FRAMES times first, as the guide browser's shot is its 120th
            var settle = 0u32;
            while settle < SHOT_SETTLE_FRAMES {
              var warm = g.device.createCommandEncoder();
              g.fx.render(&mut g.device, &mut warm, &mut g.renderer, &mut g.post, &camera, &g.light, &g.list, color);
              _ = g.device.queue.submit(warm.finish());
              g.device.endFrame();      // each is a frame of its own: a frame has a few command buffers, and past them drew black
              settle = settle + 1u32;
            }
            var encoder = g.device.createCommandEncoder();
            g.fx.render(&mut g.device, &mut encoder, &mut g.renderer, &mut g.post, &camera, &g.light, &g.list, color);
            var readback = g.device.createBuffer(u64.from(w) * u64.from(h) * 4u64, BUFFER_USAGE_MAP_READ | BUFFER_USAGE_COPY_DST);
            encoder.copyTextureToBuffer(color, &readback);
            _ = g.device.queue.submit(encoder.finish());
            g.device.waitIdle();
            let picture = Image.fromTexels(readback.mappedBytes(), i32.from(w), i32.from(h), false);
            let written = picture.save(&Path.from(shot));
            print <- "render: "; print <- u64.from(g.list.len()); print <- " parts drawn to "; printStr(shot);
            if written { print <- "\n"; } else { print <- " (NOT written)\n"; }
          }
          case is None[Texture] {}
        }
      }
      case is None[Texture] {}
    }
  }

  // --xr: the draw list 'drawWith' built, drawn once for each eye into that eye's swapchain image, as the runtime located the
  // eyes for the frame's display time; the window shows the left eye; then the frame goes back to the runtime. The headset's
  // space is placed at the person's feet (its floor is the ground), not turned (the mouse look and the headset's turn are not
// joined; see render.md)
  fn drawEyes(self: &mut, g: &mut Gfx) {
    match &self.xrFrame {
      case let Some(f) {
        if !f.active { return; }
        if f.shouldRender && f.located {
          g.post.resize(&mut g.device, g.headset.eyeWidth, g.headset.eyeHeight);
          var eye = 0usize;
          while eye < 2usize {
            if g.headset.acquireEye(f, eye) {
              var camera = g.headset.eyeCamera(f, eye);
              camera.far = 500.;
              camera.background = Color(0.5, 0.7, 0.9, 1.);
              camera.origin = camera.origin + self.xrBase;
              let started = Instant.now().nanos();
              g.headset.swapEye(eye, &mut g.target);
              var encoder = g.device.createCommandEncoder();
              g.headset.eyeStart(&mut encoder, eye);
              g.renderer.render(&mut g.device, &mut encoder, &g.post.hdr, &g.target.depth, &camera, &g.light, &g.list);
              g.post.apply(&mut encoder, &g.target.texture);
              g.headset.eyeEnd(&mut encoder, eye, &g.target.texture);
              _ = g.device.queue.submit(encoder.finish());
              g.headset.swapEye(eye, &mut g.target);
              g.headset.eyeSubmitted(&g.device, eye, f64.from(Instant.now().nanos() - started) * 1.0e-9);
              if eye == 0usize && g.headset.hasMirror() { _ = g.headset.mirrorEye(&mut g.device, 0usize); }
              _ = g.headset.releaseEye(eye);
            }
            eye = eye + 1usize;
          }
        }
        g.headset.endFrame(&mut g.device, f);
      }
      case is None[HeadsetFrame] {}
    }
  }

  // --shot: one frame off screen, from where the person stands
  pub fn shoot(self: &mut, file: &str) {
    let plan = self.prepare();
    let head = self.readHeadPose();
    self.draw(plan.feet + head.offset, head.look, file);
  }

  pub fn printStats(self: &) {
    print <- "render: "; print <- frame; print <- " frames; longest gap between frames "; printF(msOf(longestGapNs));
    print <- " ms; longest drawing with no new snapshot "; printF(msOf(longestSameNs)); print <- " ms ("; print <- framesDuringSame;
    print <- " frames); "; print <- u64.from(self.residentCount()); print <- " keys resident (meshes and materials), "; print <- u64.from(uploadedBytes);
    print <- " bytes uploaded over "; print <- uploadFrames; print <- " frames; snapshots changed after publishing: ";
    print <- sumMismatches; print <- "\n";
  }
}

fn msOf(ns: u64) f32 { f32.from(ns) / 1000000. }

// The world's sun, until its own `sun` part reaches Render (a message change for later): first.ddd's, as the guide
// browser reads it (the way to the sun, its colour, its lux). The sky and light below are the guide browser's, made the
// same way, so the same world looks the same in both.
fn worldToSun() Vec3 { Vec3(-0.4, 0.8, 0.45) }
fn worldSunColor() Color { Color(1., 0.95, 0.88, 1.) }
const WORLD_SUN_LUX = 70000.;
const SKY_NITS = 4000.;    // the sky's even light on everything, as the guide browser's (build.cone)

// The sun as the guide browser's sunOf makes it: its colour times its lux, with the sky's even light on everything
fn worldLight() Light {
  let toSun = worldToSun();
  let c = worldSunColor();
  let lux = f32.from(WORLD_SUN_LUX);
  let sky = f32.from(SKY_NITS);
  Light.directional(Vec3(0., 0., 0.) - toSun, Color(c.red * lux, c.green * lux, c.blue * lux, 1.),
    Color(0.80 * sky, 0.88 * sky, 1.0 * sky, 1.))
}

// The scene is in physical units (nits, lux), seen by a camera set for a sunny day, with the world's sun, its shadows and
// its sky, as the guide browser sets them; the light is returned
fn worldLook(renderer: &mut Renderer, device: &mut Device) Light {
  renderer.exposure = exposureFromEv100(15.);
  renderer.setShadows(device, &ShadowSettings(enabled: true));
  renderer.setSky(device, &clearDaySky(worldToSun().normalize(), f32.from(WORLD_SUN_LUX)));
  worldLight()
}

// What is drawn behind everything, and what a clear coat mirrors: the guide browser's clearDaySky (guidebrowser.cone),
// copied: a robin's-egg blue overhead, a pale haze at the horizon, each as bright as Preetham's clear day is there for
// this sun (turbidity 2.5), in the hue of the named sRGB colour; a mid-grey ground; no sun disc
fn clearDaySky(toSun: Vec3, lux: f32) Sky {
  let model = PreethamSky.make(2.5, toSun);
  let flat = Vec3(toSun.x, 0., toSun.z);
  let towardSun = if flat.length() > 0.001 { flat.normalize() } else { Vec3(1., 0., 0.) };
  let zenith = hued(model.radiance(Vec3(0., 1., 0.), toSun), 160., 212., 222.);
  let haze = hued(model.radiance((Vec3(0., 0.05, 0.) - towardSun).normalize(), toSun), 224., 238., 238.);
  let glow = hued(model.radiance((towardSun + Vec3(0., 0.05, 0.)).normalize(), toSun), 244., 236., 222.);
  let g = 0.25 * lux / 3.14159265;
  Sky(toSun, 0.0047, Color(0., 0., 0., 1.), zenith, haze, 5.,
    Color(fmaxZero(glow.red - haze.red), fmaxZero(glow.green - haze.green), fmaxZero(glow.blue - haze.blue), 1.), 8.,
    Color(g * 0.55, g * 0.62, g * 0.45, 1.), 10., Color(0., 0., 0., 1.), 0., Color(0., 0., 0., 1.), 0., 1., 1., 0., 0u32)
}

// A radiance's brightness (its luminance) in the hue of the sRGB colour (r, g, b)
fn hued(radiance: Vec3, r: f32, g: f32, b: f32) Color {
  let y = 0.2126 * radiance.x + 0.7152 * radiance.y + 0.0722 * radiance.z;
  let lr = srgbToLinear(f64.from(r));
  let lg = srgbToLinear(f64.from(g));
  let lb = srgbToLinear(f64.from(b));
  let ly = 0.2126 * lr + 0.7152 * lg + 0.0722 * lb;
  Color(lr * y / ly, lg * y / ly, lb * y / ly, 1.)
}
fn fmaxZero(x: f32) f32 { if x > 0. { x } else { 0. } }

// The image passes, as the guide browser sets them for a window or a shot: rays, temporal anti-aliasing, ambient occlusion
// and auto-exposure
fn makeFx(renderer: &mut Renderer, post: &mut Post, device: &mut Device) ImageFx {
  _ = renderer.setRayTracing(device, true);     // glass and reflections by rays where the GPU has them
  var fx = ImageFx.create(device, renderer, post);
  var settings = FxSettings.high();
  // Brightness measured against the guide browser's shot of this world (first.ddd, 120th frame): the same passes, light and sky
  // in Render gave a picture 1.4 stops darker (the guide's auto-exposure drifts up over its first seconds and Render's did not;
  // cause not found), so the exposure is opened by that much until the world's own camera exposure reaches Render
  settings.exposure.compensationEv = 1.4;
  fx.configure(&settings);
  fx
}

// The GPU for a window ('window': its SDL handle as a number, since a raw
// pointer is not Sendable), or off screen at 'w' x 'h' when 'window' is 0
// A part's material on the GPU, from partbuild's record: a physical one by its roughness, metal, clear coat and
// reflection, a plain one by its colour (and how much it covers), as the guide browser makes them
fn uploadLook(g: &mut Gfx, look: &MaterialRec) MaterialHandle {
  if look.physical {
    var pbr = PbrMaterial.standard(look.color, look.metal, look.roughness);
    pbr.clearcoat = look.coat;
    pbr.clearcoatRoughness = look.coatRoughness;
    if look.reflects > 0. { pbr = pbr.reflective(look.reflects); }
    return g.renderer.addPbrMaterial(&mut g.device, &pbr);
  }
  var plain = Material.plain(look.color);
  if look.covers < 1. { plain = plain.translucent(look.covers); }
  g.renderer.addMaterial(&mut g.device, &plain)
}

fn makeGfx(window: usize, w: u32, h: u32) Option[Gfx] {
  var instance = Instance.create("pegasus");
  if !instance.isValid() { print <- "render: no Vulkan 1.3 instance\n"; return None[Gfx]; }
  var surface = Surface.none();
  if window != 0usize { surface = instance.createSurface(window as *u8 as *sdl.Window); }
  var adapter = instance.requestAdapter(&surface, POWER_PREFERENCE_HIGH_PERFORMANCE);
  if !adapter.isValid() { print <- "render: no GPU\n"; return None[Gfx]; }
  var device = adapter.requestDevice();
  var swapchain = None[SwapChain];
  var color = None[Texture];
  var depth = None[Texture];
  var outFormat = TEXTURE_FORMAT_RGBA8_UNORM;
  if window != 0usize {
    let sc = device.createSwapChain(&surface, w, h, TEXTURE_FORMAT_DEPTH32_FLOAT);
    outFormat = sc.format;
    swapchain = Some[SwapChain](sc);
  } else {
    let cd = TextureDescriptor(w, h, TEXTURE_FORMAT_RGBA8_UNORM, TEXTURE_USAGE_RENDER_ATTACHMENT | TEXTURE_USAGE_COPY_SRC);
    color = Some[Texture](device.createTexture(&cd));
    let dd = TextureDescriptor(w, h, TEXTURE_FORMAT_DEPTH32_FLOAT, TEXTURE_USAGE_RENDER_ATTACHMENT);
    depth = Some[Texture](device.createTexture(&dd));
  }
  var renderer = Renderer.create(&mut device, TEXTURE_FORMAT_RGBA16_FLOAT, TEXTURE_FORMAT_DEPTH32_FLOAT);
  var post = Post.create(&mut device, outFormat, w, h);
  if !renderer.isValid() || !post.isValid() { print <- "render: the renderer could not be made\n"; return None[Gfx]; }
  // The world's sky and sun, fixed for now (the world's own `sun` part reaching Render is a message change for later)
  // The guide browser's order: rays and the image passes, then the exposure, the sun with its shadows and the sky
  let fx = makeFx(&mut renderer, &mut post, &mut device);
  let light = worldLook(&mut renderer, &mut device);
  let target = standInTarget(&mut device, 2u32, 2u32, TEXTURE_FORMAT_RGBA8_UNORM);
  Some[Gfx](Gfx(DrawList(), renderer, post, fx, swapchain, color, depth, w, h, false, target, Headset.none(), light, device, adapter,
    surface, instance))
}

// The eye's format with a depth texture: what the XR target is until an eye's images are swapped into it
fn standInTarget(device: &mut Device, width: u32, height: u32, format: u32) SurfaceTexture {
  let colorDesc = TextureDescriptor(width, height, format, TEXTURE_USAGE_RENDER_ATTACHMENT | TEXTURE_USAGE_COPY_SRC);
  let color = device.createTexture(&colorDesc);
  let depthDesc = TextureDescriptor(width, height, TEXTURE_FORMAT_DEPTH32_FLOAT, TEXTURE_USAGE_RENDER_ATTACHMENT);
  let depth = device.createTexture(&depthDesc);
  SurfaceTexture(color, depth, SURFACE_TEXTURE_SUCCESS_OPTIMAL)
}

// The GPU for the headset (--xr): the runtime makes the Vulkan instance and device; the window (when 'window' is not 0)
// mirrors the left eye. None, with a message, when there is no OpenXR runtime or headset, or its session does not begin.
fn makeGfxXr(window: usize, w: u32, h: u32) Option[Gfx] {
  // (declared in this order: the headset ends before the GPU it draws on)
  var gpu = HeadsetGpu.none();
  var options = HeadsetOptions();
  options.far = 500.;
  options.mirrorWindow = window;
  options.mirrorWidth = w;
  options.mirrorHeight = h;
  var headset = Headset.open("pegasus", &options, &mut gpu);
  if !headset.isValid() {
    print <- "pegasus: no headset could be opened (is an OpenXR runtime running, and a headset connected? see above)\n";
    return None[Gfx];
  }
  // The session begins when the runtime says READY, a moment after it was made: the first frame waits for it
  var waited = 0;
  while !headset.isRunning() && waited < 1000 {
    if !headset.pollEvents() { break; }
    sdl.Delay(10u32);
    waited = waited + 1;
  }
  if !headset.isRunning() {
    print <- "pegasus: the headset's session did not begin\n";
    return None[Gfx];
  }
  print <- "Adapter: "; printStr(gpu.adapterName()); print <- "; headset "; printStr(headset.systemName.view()); print <- " by ";
  printStr(headset.runtimeName.view()); print <- ", each eye "; print <- u64.from(headset.eyeWidth); print <- " x ";
  print <- u64.from(headset.eyeHeight); print <- if headset.hasMirror() { ", the left eye in the window\n" } else { ", no window\n" };
  var renderer = Renderer.create(&mut gpu.device, TEXTURE_FORMAT_RGBA16_FLOAT, TEXTURE_FORMAT_DEPTH32_FLOAT);
  var post = Post.create(&mut gpu.device, headset.colorFormat, headset.eyeWidth, headset.eyeHeight);
  if !renderer.isValid() || !post.isValid() { print <- "render: the renderer could not be made\n"; return None[Gfx]; }
  // The eyes are drawn by the renderer alone (no image passes), under the same sun, sky and exposure as a window's
  let fx = ImageFx.create(&mut gpu.device, &renderer, &mut post);
  let light = worldLook(&mut renderer, &mut gpu.device);
  let target = standInTarget(&mut gpu.device, 16u32, 16u32, headset.colorFormat);
  var made = Gfx(DrawList(), renderer, post, fx, None[SwapChain], None[Texture], None[Texture], w, h, true, target, Headset.none(), light,
    Device.none(), Adapter.none(), Surface.none(), Instance.none());
  made.headset <-> headset;
  made.device <-> gpu.device;
  made.adapter <-> gpu.adapter;
  made.instance <-> gpu.instance;
  Some[Gfx](made)
}

actor Render {
  core: RenderCore;
  running: bool;
  headless: bool;                   // no window: paced by a timer
  shot: String;                     // --shot FILE: one frame off screen, once its content is resident
  wantKeys: usize;                  // how many keys a shot waits for
  exactKeys: usize;                 // a check: how many keys are resident at the end (0: not checked)
  stopped: Sender[bool];            // told, once the loop has ended, whether Render's checks passed (the shell then lets the window go)
  finished: Sender[i32];            // a shot's verdict
  stallMs: u64;                     // the stall check: Sim is busy this long once (0: no stall)
  shotAfter: u64;                   // a shot waits for this step (--shot-after N; at least 10)
  headsetFailed: bool;              // --xr was asked and no headset opened: the run ends at once, not clean

  fn init(self: &new, window: usize, w: u32, h: u32, gpu: bool, looks: StateReader[LookIntent],
      drawnOut: StateWriter[DrawnFrame], shot: String, wantKeys: usize, exactKeys: usize, stopped: Sender[bool], finished: Sender[i32],
      stallMs: u64, stalePose: bool, shotAfter: u64, xr: bool, rays: StateWriter[HandRay], view: ShotView) {
    var core = RenderCore.make(looks, drawnOut, stalePose);
    core.view = view;
    var failed = false;
    if xr {
      core.gfx = makeGfxXr(window, w, h);
      core.rays = Some[StateWriter[HandRay]](rays);
      failed = !core.isXr();
    } else if gpu { core.gfx = makeGfx(window, w, h); }
    *self = Self(core, false, window == 0usize, shot, wantKeys, exactKeys, stopped, finished, stallMs,
      if shotAfter > 10u64 { shotAfter } else { 10u64 }, failed);
  }

  // Render's checks at the end of a run: no snapshot changed after it was
  // published, and, when Sim stalled, Render went on drawing at its own rate
  fn checks(self: &) bool {
    var ok = true;
    print <- "check snapshots unchanged after publishing: "; print <- core.sumMismatches; print <- " changed";
    if core.sumMismatches == 0u64 { print <- ": ok\n"; } else { print <- ": FAILED\n"; ok = false; }
    if exactKeys > 0usize {
      print <- "check resident keys: "; print <- u64.from(core.residentCount()); print <- " (want "; print <- u64.from(exactKeys);
      print <- "), "; print <- core.released; print <- " released";
      if core.residentCount() == exactKeys { print <- ": ok\n"; } else { print <- ": FAILED\n"; ok = false; }
    }
    if stallMs > 0u64 {
      let gapMs = msOf(core.longestGapNs);
      let sameMs = msOf(core.longestSameNs);
      print <- "check render never waited on sim: Sim stalled "; print <- stallMs; print <- " ms; Render drew ";
      print <- core.framesDuringSame; print <- " frames with no new snapshot over "; printF(sameMs);
      print <- " ms, its longest gap "; printF(gapMs); print <- " ms";
      let good = sameMs > f32.from(stallMs) * 0.8 && gapMs < 50. && core.framesDuringSame > stallMs * HEADLESS_HZ / 2000u64;
      if good { print <- ": ok\n"; } else { print <- ": FAILED\n"; ok = false; }
    }
    ok
  }

  // Sim -> Render (latest): the newest snapshot, kept with the one before
  pub async fn snapshot(self, s: Published) { core.takeSnapshot(s); }

  // Loader -> Render (bulk move): a key's look, uploaded under the budget
  pub async fn content(self, c: MeshContent) { core.takeContent(c); }

  // Loader -> Render (bulk move): a material key's material, uploaded under the budget
  pub async fn material(self, c: MaterialContent) { core.takeMaterial(c); }

  // Loader -> Render (event): nothing uses 'key' now; its mesh or material may go
  pub async fn release(self, key: ContentKey) { core.releaseContent(key); }

  // Player -> Render (event): the person inhabits 'avatar', seen from 'camera'
  pub async fn inhabit(self, avatar: PartId, camera: PartId) {
    core.avatar = avatar;
    core.camera = camera;
  }

  pub async fn stop(self) { running = false; }

  // The frame loop. With a window the present waits for the display; the
  // short sleep after it only lets the other messages in. Headless, a timer
  // at HEADLESS_HZ stands in for the display.
  pub async fn run(self) {
    if headsetFailed {
      var s = stopped.clone();
      s <- false;
      return;
    }
    running = true;
    let period = i64.from(1000000000u64 / HEADLESS_HZ);
    var next = Instant.now().nanos() + period;
    while running {
      if headless {
        _ = await aio.sleepUntil(Instant.fromNanos(next));
        next = next + period;
        if Instant.now().nanos() > next { next = Instant.now().nanos() + period; }
      } else {
        _ = await aio.sleep(Duration.fromMicros(100i64));
      }
      if !running { break; }
      if shot.len() > 0usize {
        let plan = core.prepare();
        _ = core.finish(&plan);     // a frame as any other (nothing is drawn: no shot is asked of it), so Player's script sees the steps
        if core.residentCount() >= wantKeys && plan.step > shotAfter {
          core.shoot(shot.view());
          var f = finished.clone();
          f <- 0;
          shot = String();
        }
      } else {
        let plan = core.prepare();
        if core.xrEnded { break; }
        _ = core.finish(&plan);
      }
    }
    core.endHeadset();
    core.printStats();
    let ok = self.checks();
    var s = stopped.clone();
    s <- ok;
  }
}
