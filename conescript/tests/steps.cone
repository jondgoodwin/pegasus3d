// Step functions (W148, FOR REVIEW): the reading of a step function, a stepper and a place field. Each construct is read
// once as written, and then with one thing broken (the check's mutant): the broken text must be told about, and what it
// breaks must be left out, not the world. (Lowering, verifying and running them are driven by pegasus's `--checks`.)

mod steps;

import testing use *;
import collections use *;
import conescript use *;

// 'body' is a step function's statements, 'result' its value, 'start' the stepper's step and 'field' the bird's field line
fn world(field: &str, body: &str, result: &str, start: &str) String {
  var s = String();
  s.append("part hello\n  part bird\n    "); s.append(field); s.append("\n  part pair\n");
  s.append("    part a: bird(velocity: (1, 0, 0)), at: (0, 1, 0)\n    part b: bird(velocity: (2, 0, 0)), at: (3, 1, 0)\n");
  s.append("  fn swap(p: part, dt: duration) bool {\n"); s.append(body); s.append("    "); s.append(result); s.append("\n  }\n");
  s.append("  each p in pair.parts {\n    on(created, start(stepAnimator(p, step: "); s.append(start); s.append(")))\n  }\n");
  s
}

const FIELD = "field velocity: place = (0, 0, 0), mutable: true";
const BODY = "    var target = p.place;\n    each o in pair.parts {\n      let d = o.place - p.place;\n      if dot(d, d) > 0.001 { target = o.place; }\n    }\n    var v = p.velocity * 2;\n    if length(v) > 1.5 { v = v * (1.5 / length(v)); }\n    set(p.velocity, v);\n    set(p.place, target + v * dt);\n    set(p.facing, v);\n";

fn readText(text: &String) Reading {
  var names = Names.standard();
  read(text.view(), names, Vocabulary.empty())
}

// The step function is still there, but marked with a mistake (ok false): it and its steppers are left out
fn left(r: &Reading) bool { r.understood.steps.len() == 1usize && !r.understood.steps[0usize].ok }

fn main() i32 {
  var ok = true;
  {
    let r = readText(&world(FIELD, BODY, "true", "swap"));
    ok = expectInt(i64.from(r.problems.len()), 0, "a step function, two steppers and a place field read with no problem") && ok;
    ok = expect(r.understood.steps.len() == 1usize && r.understood.steps[0usize].ok, "one step function, with no mistake in it") && ok;
    ok = expectInt(i64.from(r.understood.steppers.len()), 2, "one stepper for each bird the `each` reaches") && ok;
    ok = expect(r.understood.placeFields.len() >= 2usize && r.understood.placeNames.len() == 1usize,
      "each copy has its own place field, the name kept once") && ok;
  }
  // the mutants: each breaks one thing
  {
    let r = readText(&world(FIELD, BODY, "zz", "swap"));                       // an unknown name as the result
    ok = expect(r.problems.len() > 0usize && left(&r), "an unknown name in a step function is told, the function left out") && ok;
  }
  {
    let r = readText(&world(FIELD, BODY, "1", "swap"));                        // a number where a truth is wanted
    ok = expect(r.problems.len() > 0usize && left(&r), "a step function that does not end in a truth is told") && ok;
  }
  {
    let r = readText(&world(FIELD, "    let w = p.place + 1;\n", "true", "swap"));   // a point plus a number
    ok = expect(r.problems.len() > 0usize && left(&r), "a point added to a number is told") && ok;
  }
  {
    let r = readText(&world(FIELD, "    each o in nothing.parts { }\n", "true", "swap"));
    ok = expect(r.problems.len() > 0usize && left(&r), "a loop over a part that does not exist is told") && ok;
  }
  {
    let r = readText(&world(FIELD, "    set(p.velocity, 5);\n", "true", "swap"));  // a number into a place field
    ok = expect(r.problems.len() > 0usize && left(&r), "a number set into a place field is told") && ok;
  }
  {
    let r = readText(&world(FIELD, "    set(p.mass, p.place);\n", "true", "swap"));   // a field the part does not have
    ok = expect(r.problems.len() > 0usize && left(&r), "a field no part has is told") && ok;
  }
  {
    let r = readText(&world(FIELD, BODY, "true", "nope"));                      // a stepper naming nothing
    ok = expect(r.problems.len() > 0usize && r.understood.steppers.len() == 0usize && r.understood.steps.len() == 1usize,
      "a stepper naming no step function is told, and no stepper made") && ok;
  }
  {
    let r = readText(&world("field velocity: place = (0, 0, 0)", BODY, "true", "swap"));   // not mutable
    ok = expect(r.problems.len() > 0usize, "setting a place field that is not mutable is told") && ok;
  }
  if ok { 0 } else { 1 }
}
