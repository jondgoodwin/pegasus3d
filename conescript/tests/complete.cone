  w.beginUnit(sli, "givesI"); w.opU(OP_LOCAL_GET, 0u32); w.opU(OP_CALL, 0u32); w.endUnit();
  refused("a list of i64 passed where a list of f64 is wanted", &w, &tables, 1u32, "wrong type");

  // ---- imports: the signature the host offers, and the arguments ----
  var ti = ImportTables[u8].make();
  let th3 = ti.types.handle(3u32);
  let tl3 = ti.types.list(th3);
  ti.add("vocabulary", "mk", ti.types.sig(&[TY_F64], &[th3]), false, 1u32, &noop);
  ti.add("vocabulary", "use", ti.types.sig(&[tl3], &[TY_F64]), false, 1u32, &noop);
  ti.add("host", "two", ti.types.sig(&[TY_F64, TY_BOOL], &[TY_F64, TY_BOOL]), false, 1u32, &noop);
  w = CodeWriter.make();
  var c3 = w.code.types.handle(3u32);
  var cl3 = w.code.types.list(c3);
  var imk = w.addImport("vocabulary", "mk", w.code.types.sig(&[TY_F64], &[c3]));
  var iuse = w.addImport("vocabulary", "use", w.code.types.sig(&[cl3], &[TY_F64]));
  w.beginUnit(w.code.types.sig(e.view(), &[TY_F64]), "u");
  w.f64Const(1.0); w.opU(OP_IMPORT, imk); w.opUU(OP_LIST_MAKE, cl3, 1u32); w.opU(OP_IMPORT, iuse); w.endUnit();
