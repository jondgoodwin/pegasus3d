  w = CodeWriter.make();
  c3 = w.code.types.handle(4u32);
  imk = w.addImport("vocabulary", "mk", w.code.types.sig(&[TY_F64], &[c3]));
  w.beginUnit(w.code.types.sig(e.view(), e.view()), "u");
  w.f64Const(1.0); w.opU(OP_IMPORT, imk); w.opU(OP_DROP, c3); w.endUnit();
  refused("an import whose result is a handle of another kind", &w, &ti, 0u32, "different signature");
  w = CodeWriter.make();
  c3 = w.code.types.handle(3u32);
  cl3 = w.code.types.list(TY_F64);
  iuse = w.addImport("vocabulary", "use", w.code.types.sig(&[cl3], &[TY_F64]));
  w.beginUnit(w.code.types.sig(e.view(), e.view()), "u");
  w.opUU(OP_LIST_MAKE, cl3, 0u32); w.opU(OP_IMPORT, iuse); w.opU(OP_DROP, TY_F64); w.endUnit();
  refused("an import whose parameter is a list of another element type", &w, &ti, 0u32, "different signature");
  w = CodeWriter.make();
  imk = w.addImport("vocabulary", "mk", w.code.types.sig(&[TY_F64, TY_F64], &[w.code.types.handle(3u32)]));
  w.beginUnit(w.code.types.sig(e.view(), e.view()), "u");
  w.f64Const(1.0); w.f64Const(1.0); w.opU(OP_IMPORT, imk); w.opU(OP_DROP, w.code.types.handle(3u32)); w.endUnit();
  refused("an import with a parameter too many", &w, &ti, 0u32, "different signature");
  w = CodeWriter.make();
  imk = w.addImport("vocabulary", "mk", w.code.types.sig(e.view(), &[w.code.types.handle(3u32)]));
  w.beginUnit(w.code.types.sig(e.view(), e.view()), "u");
  w.opU(OP_IMPORT, imk); w.opU(OP_DROP, w.code.types.handle(3u32)); w.endUnit();
  refused("an import with a parameter too few", &w, &ti, 0u32, "different signature");
  w = CodeWriter.make();
  var itwo = w.addImport("host", "two", w.code.types.sig(&[TY_F64, TY_BOOL], &[TY_BOOL, TY_F64]));
  w.beginUnit(w.code.types.sig(e.view(), e.view()), "u");
  w.f64Const(1.0); w.boolConst(true); w.opU(OP_IMPORT, itwo); w.opU(OP_DROP, TY_F64); w.opU(OP_DROP, TY_BOOL); w.endUnit();
  refused("an import whose results are in another order", &w, &ti, 0u32, "different signature");
  w = CodeWriter.make();
  itwo = w.addImport("host", "two", w.code.types.sig(&[TY_F64, TY_BOOL], &[TY_F64, TY_BOOL]));
  w.beginUnit(w.code.types.sig(e.view(), e.view()), "u");
  w.boolConst(true); w.f64Const(1.0); w.opU(OP_IMPORT, itwo); w.opU(OP_DROP, TY_BOOL); w.opU(OP_DROP, TY_F64); w.endUnit();
  refused("an import called with its arguments in the wrong order", &w, &ti, 0u32, "wrong type");
  w = CodeWriter.make();
  itwo = w.addImport("host", "two", w.code.types.sig(&[TY_F64, TY_BOOL], &[TY_F64, TY_BOOL]));
  w.beginUnit(w.code.types.sig(e.view(), e.view()), "u");
  w.opU(OP_IMPORT, itwo); w.endUnit();
  refused("an import called with too few arguments", &w, &ti, 0u32, "empty");
  w = CodeWriter.make();
  itwo = w.addImport("host", "two", w.code.types.sig(&[TY_F64, TY_BOOL], &[TY_F64, TY_BOOL]));
  w.beginUnit(w.code.types.sig(e.view(), e.view()), "u");
  w.f64Const(1.0); w.boolConst(true); w.opU(OP_IMPORT, itwo); w.opU(OP_DROP, TY_BOOL); w.endUnit();
  refused("an import's results left on the stack", &w, &ti, 0u32, "left on the stack");
  w = CodeWriter.make();
  itwo = w.addImport("host", "two", w.code.types.sig(&[TY_F64, TY_BOOL], &[TY_F64, TY_BOOL]));
  w.beginUnit(w.code.types.sig(e.view(), e.view()), "u");
  w.f64Const(1.0); w.boolConst(true); w.opU(OP_IMPORT, itwo); w.opU(OP_DROP, TY_F64); w.opU(OP_DROP, TY_BOOL); w.endUnit();
  refused("an import's results dropped in the wrong order", &w, &ti, 0u32, "wrong type");
  w = CodeWriter.make();
  w.addImport("host", "two", TY_F64);
  w.beginUnit(w.code.types.sig(e.view(), e.view()), "u"); w.opU(OP_IMPORT, 0u32); w.endUnit();
  refused("an import whose type is not a signature", &w, &ti, 0u32, "not a signature");
  w = CodeWriter.make();
  w.addImport("host", "two", 99u32);
  w.beginUnit(w.code.types.sig(e.view(), e.view()), "u"); w.opU(OP_IMPORT, 0u32); w.endUnit();
  refused("an import whose type is out of range", &w, &ti, 0u32, "not a signature");
  w = CodeWriter.make();
  w.addImport("host", "Two", w.code.types.sig(&[TY_F64, TY_BOOL], &[TY_F64, TY_BOOL]));
  w.beginUnit(w.code.types.sig(e.view(), e.view()), "u"); w.opU(OP_IMPORT, 0u32); w.endUnit();
  refused("an import named in other case", &w, &ti, 0u32, "not offered");

  // ---- the unit's own declarations ----
  w = unit(e.view(), e.view());
  w.code.units[0usize].sig = TY_F64;
  w.endUnit();
  refused("a unit whose type is not a signature", &w, &tables, 0u32, "not a signature");
  w = unit(e.view(), e.view());
  w.code.units[0usize].sig = 77u32;
  w.endUnit();
  refused("a unit whose type is out of range", &w, &tables, 0u32, "not a signature");
  w = unit(e.view(), e.view());
  w.code.units[0usize].locals.push(88u32);
  w.endUnit();
  refused("a local whose type is out of range", &w, &tables, 0u32, "value type");
  w = unit(e.view(), e.view());
  w.code.units[0usize].locals.push(w.code.types.sig(e.view(), e.view()));
  w.endUnit();
  refused("a local whose type is a signature", &w, &tables, 0u32, "value type");
  w = unit(e.view(), e.view());
  w.endUnit();
  w.beginUnit(w.code.types.sig(e.view(), e.view()), "second"); w.op(OP_F64_NEG); w.endUnit();
  refused("a second unit's fault is the second unit's", &w, &tables, 1u32, "empty");

  // ---- types ----
  w = unit(e.view(), e.view());
  w.code.types.defs.push(TypeDef(T_TUPLE, 0u32, List[u32](), List[u32]()));
  w.endUnit();
  refused("an empty tuple type", &w, &tables, NO_UNIT, "malformed type");
  w = unit(e.view(), e.view());
  var sg = w.code.types.sig(e.view(), e.view());
  var td = TypeDef(T_TUPLE, 0u32, List[u32](), List[u32]());
  td.items.push(sg);
  w.code.types.defs.push(td);
  w.endUnit();
  refused("a tuple holding a signature", &w, &tables, NO_UNIT, "malformed type");
  w = unit(e.view(), e.view());
  sg = w.code.types.sig(e.view(), e.view());
  w.code.types.defs.push(TypeDef(T_LIST, sg, List[u32](), List[u32]()));
  w.endUnit();
  refused("a list of signatures", &w, &tables, NO_UNIT, "malformed type");
  w = unit(e.view(), e.view());
  w.code.types.defs.push(TypeDef(99u8, 0u32, List[u32](), List[u32]()));
  w.endUnit();
  refused("a type of an unknown kind", &w, &tables, NO_UNIT, "malformed type");
  w = unit(e.view(), e.view());
  w.code.types.defs.push(TypeDef(T_F64, 0u32, List[u32](), List[u32]()));
  w.endUnit();
  refused("a primitive type outside the first four", &w, &tables, NO_UNIT, "malformed type");
  w = unit(e.view(), e.view());
  w.code.types.defs[1usize].kind = T_F64;
  w.endUnit();
  refused("the first four types not the primitives", &w, &tables, NO_UNIT, "malformed type");
  w = unit(e.view(), e.view());
  td = TypeDef(T_TUPLE, 0u32, List[u32](), List[u32]());
  var q = 0u32;
  while q < 4097u32 { td.items.push(TY_F64); q = q + 1u32; }
  w.code.types.defs.push(td);
  w.endUnit();
  refused("a tuple of more than 4096 slots", &w, &tables, NO_UNIT, "malformed type");
  w = unit(e.view(), e.view());
  td = TypeDef(T_TUPLE, 0u32, List[u32](), List[u32]());
  q = 0u32;
  while q < 4096u32 { td.items.push(TY_F64); q = q + 1u32; }
  w.code.types.defs.push(td);
  w.endUnit();
  accepted("a tuple of exactly 4096 slots", &w, &tables);
  w = unit(e.view(), e.view());
  td = TypeDef(T_SIG, 0u32, List[u32](), List[u32]());
  td.items.push(500u32);
  w.code.types.defs.push(td);
  w.endUnit();
  refused("a signature whose parameter type is out of range", &w, &tables, NO_UNIT, "malformed type");
  w = unit(e.view(), e.view());
  sg = w.code.types.sig(e.view(), e.view());
  td = TypeDef(T_SIG, 0u32, List[u32](), List[u32]());
  td.results.push(sg);
  w.code.types.defs.push(td);
  w.endUnit();
  refused("a signature with a signature as a result", &w, &tables, NO_UNIT, "malformed type");
  w = unit(e.view(), e.view());
  w.code.types.defs.push(TypeDef(T_HANDLE, 5u32, List[u32](), List[u32]()));
  w.endUnit();
  accepted("a handle of any kind index", &w, &tables);

  // ---- entries, version, and the acting wall ----
  w = unit(e.view(), e.view());
  w.endUnit(); w.addEntry(ENTRY_FIXED, 5u32, 0u32, 0u32);
  refused("an entry for a unit that does not exist", &w, &tables, NO_UNIT, "does not exist");
  w = unit(e.view(), e.view());
  w.endUnit(); w.addEntry(9u8, 0u32, 0u32, 0u32);
  refused("an entry of an unknown kind", &w, &tables, 0u32, "unknown kind");
  w = unit(e.view(), e.view());
  w.endUnit();
  w.code.major = 2u16;
  refused("verify checks the major version itself", &w, &tables, NO_UNIT, "major version");
  w = unit(e.view(), e.view());
  w.endUnit();
  w.code.minor = 9u16;
  accepted("a newer minor version is accepted", &w, &tables);
  // two calls deep, and a mixed pair of entries on one unit
  var ta = ImportTables[u8].make();
  let asig = ta.types.sig(e.view(), e.view());
  ta.add("host", "act", asig, true, 1u32, &noop);
  w = CodeWriter.make();
  let wasig = w.code.types.sig(e.view(), e.view());
  let ia = w.addImport("host", "act", wasig);
  w.beginUnit(wasig, "acts"); w.opU(OP_IMPORT, ia); w.endUnit();
  w.beginUnit(wasig, "mid"); w.opU(OP_CALL, 0u32); w.endUnit();
  w.beginUnit(wasig, "top"); w.opU(OP_CALL, 1u32); w.endUnit();
  w.addEntry(ENTRY_DERIVE, 2u32, 0u32, 0u32);
  refused("a derive reaching an acting import through two calls", &w, &ta, 2u32, "acting");
  w = CodeWriter.make();
  let wasig2 = w.code.types.sig(e.view(), e.view());
  let ia2 = w.addImport("host", "act", wasig2);
  w.beginUnit(wasig2, "acts"); w.opU(OP_IMPORT, ia2); w.endUnit();
  w.addEntry(ENTRY_HANDLER, 0u32, 0u32, 0u32);
  w.addEntry(ENTRY_FIXED, 0u32, 1u32, 0u32);
  refused("a unit that is a handler and also a fixed entry", &w, &ta, 0u32, "acting");
  w = CodeWriter.make();
  let wasig3 = w.code.types.sig(e.view(), e.view());
  let ia3 = w.addImport("host", "act", wasig3);
  w.beginUnit(wasig3, "acts"); w.opU(OP_IMPORT, ia3); w.endUnit();
  w.beginUnit(wasig3, "calls"); w.opU(OP_CALL, 0u32); w.endUnit();
  w.addEntry(ENTRY_FIXED, 1u32, 0u32, 0u32);
  match verifyEach(&w.code, &ta) {
    case let Ok(v) { expect(v.isRefused(1usize), "the fixed caller is refused"); expect(!v.isRefused(0usize), "the acting unit itself is kept"); }
    case let Err(ps) { expect(false, "verifyEach gives a VerifiedCode for unit faults"); }
  }
  // a mutual recursion that reaches an acting import
  w = CodeWriter.make();
  let wasig4 = w.code.types.sig(e.view(), e.view());
  let ia4 = w.addImport("host", "act", wasig4);
  w.beginUnit(wasig4, "a"); w.opU(OP_CALL, 1u32); w.endUnit();
  w.beginUnit(wasig4, "b"); w.opU(OP_CALL, 0u32); w.opU(OP_IMPORT, ia4); w.endUnit();
  w.addEntry(ENTRY_DERIVE, 0u32, 0u32, 0u32);
  refused("a derive in a call cycle that reaches an acting import", &w, &ta, 0u32, "acting");

  // dead code is typed loosely, and a block that cannot fall through leaves every local "set" after it
  w = CodeWriter.make();
  ht = w.code.types.handle(2u32);
  b0 = w.code.types.sig(e.view(), e.view());
  w.beginUnit(w.code.types.sig(e.view(), e.view()), "u");
  l0 = w.local(ht);
  w.opU(OP_BLOCK, b0); w.op(OP_UNREACHABLE); w.op(OP_END);
  w.opU(OP_LOCAL_GET, l0); w.opU(OP_DROP, ht); w.endUnit();
  accepted("a block that never falls through leaves its locals set", &w, &tables);
  w = CodeWriter.make();
  ht = w.code.types.handle(2u32);
  w.beginUnit(w.code.types.sig(e.view(), e.view()), "u");
  l0 = w.local(ht);
  w.op(OP_UNREACHABLE); w.opU(OP_LOCAL_GET, l0); w.opU(OP_DROP, ht); w.endUnit();
  accepted("a read in dead code is not refused", &w, &tables);
  // a call to a unit whose own type is not a signature
  w = CodeWriter.make();
  sigB = w.code.types.sig(e.view(), e.view());
  w.beginUnit(sigB, "broken"); w.endUnit();
  w.beginUnit(sigB, "caller"); w.opU(OP_CALL, 0u32); w.endUnit();
  w.code.units[0usize].sig = TY_F64;
  refused("a call to a unit whose type is not a signature", &w, &tables, 1u32, "not a signature");

  // ---- the size of a frame: slot counts must not wrap (a wrapped count would put a local outside the frame) ----
  w = unit(e.view(), e.view());
  td = TypeDef(T_TUPLE, 0u32, List[u32](), List[u32]());
  q = 0u32;
  while q < 4096u32 { td.items.push(TY_F64); q = q + 1u32; }
  w.code.types.defs.push(td);
  let big = u32.from(w.code.types.defs.len() - 1usize);
  q = 0u32;
  while q < 256u32 { w.local(big); q = q + 1u32; }
  w.endUnit();
  accepted("locals filling exactly the largest frame", &w, &tables);
  w.code.units[0usize].locals.push(big);
  refused("locals one slot-block over the largest frame", &w, &tables, 0u32, "frame is too large");
  q = 0u32;
  while q < 1048320u32 { w.code.units[0usize].locals.push(big); q = q + 1u32; }
  refused("so many large locals that their slot count wraps 32 bits", &w, &tables, 0u32, "frame is too large");
  w = unit(e.view(), e.view());
  td = TypeDef(T_TUPLE, 0u32, List[u32](), List[u32]());
  q = 0u32;
  while q < 4096u32 { td.items.push(TY_F64); q = q + 1u32; }
  w.code.types.defs.push(td);
  let big2 = u32.from(w.code.types.defs.len() - 1usize);
  var bl = w.local(big2);
  q = 0u32;
  while q < 256u32 { w.opU(OP_LOCAL_GET, bl); q = q + 1u32; }
  q = 0u32;
  while q < 256u32 { w.opU(OP_DROP, big2); q = q + 1u32; }
  w.endUnit();
  accepted("an operand stack filling exactly the largest frame", &w, &tables);
  w = unit(e.view(), e.view());
  td = TypeDef(T_TUPLE, 0u32, List[u32](), List[u32]());
  q = 0u32;
  while q < 4096u32 { td.items.push(TY_F64); q = q + 1u32; }
  w.code.types.defs.push(td);
  let big3 = u32.from(w.code.types.defs.len() - 1usize);
  bl = w.local(big3);
  q = 0u32;
  while q < 257u32 { w.opU(OP_LOCAL_GET, bl); q = q + 1u32; }
  q = 0u32;
  while q < 257u32 { w.opU(OP_DROP, big3); q = q + 1u32; }
  w.endUnit();
  refused("an operand stack one slot-block over the largest frame", &w, &tables, 0u32, "too deep");
  // an import whose results alone are larger than a frame
  var tb2 = ImportTables[u8].make();
  var bigRes = List[u32]();
  td = TypeDef(T_TUPLE, 0u32, List[u32](), List[u32]());
  q = 0u32;
  while q < 4096u32 { td.items.push(TY_F64); q = q + 1u32; }
  tb2.types.defs.push(td);
  let tbig = u32.from(tb2.types.defs.len() - 1usize);
  q = 0u32;
  while q < 300u32 { bigRes.push(tbig); q = q + 1u32; }
  tb2.add("host", "huge", tb2.types.sig(e.view(), bigRes.view()), false, 1u32, &noop);
  w = CodeWriter.make();
  td = TypeDef(T_TUPLE, 0u32, List[u32](), List[u32]());
  q = 0u32;
  while q < 4096u32 { td.items.push(TY_F64); q = q + 1u32; }
  w.code.types.defs.push(td);
  let cbig = u32.from(w.code.types.defs.len() - 1usize);
  let ihuge = w.addImport("host", "huge", w.code.types.sig(e.view(), bigRes.view()));
  w.beginUnit(w.code.types.sig(e.view(), e.view()), "u");
  w.opU(OP_IMPORT, ihuge); w.endUnit();
  refused("an import whose results are larger than a frame", &w, &tb2, 0u32, "too deep");

  // ---- the container ----
  w = unit(e.view(), e.view());
  w.endUnit();
  let good = encode(&w.code);
  expect(reads(good.view()), "the container of a sound unit reads");
  var starts = List[usize]();
  var k = 8usize;
  while k < good.len() { starts.push(k); k = k + 2usize + usize.from(*good[k + 1usize]); }
  var bad = good.clone();
  bad.set(*starts[2usize] + 2usize, 1u8);
  expect(!reads(bad.view()), "a non-empty constants section is refused");
  bad = good.clone();
  bad.push(7u8); bad.push(0u8);
  expect(!reads(bad.view()), "an unknown section of the same minor version is refused");
  bad = good.clone();
  bad.push(7u8); bad.push(2u8); bad.push(1u8); bad.push(2u8);
  bad.set(6usize, 1u8);
  expect(reads(bad.view()), "an unknown section of a newer minor version is skipped");
  bad = good.clone();
  bad.set(6usize, 1u8);
  expect(reads(bad.view()), "a newer minor version with known sections reads");
  bad = good.clone();
  bad.push(7u8); bad.push(9u8); bad.set(6usize, 1u8);
  expect(!reads(bad.view()), "a skipped section must still fit in the bytes");
  bad = List[u8]();
  k = 0usize;
  while k < *starts[4usize] { bad.push(*good[k]); k = k + 1usize; }
  k = *starts[5usize];
  while k < good.len() { bad.push(*good[k]); k = k + 1usize; }
  expect(!reads(bad.view()), "a missing required section is refused");
  bad = List[u8]();
  k = 0usize;
  while k < *starts[5usize] { bad.push(*good[k]); k = k + 1usize; }
  k = *starts[4usize];
  while k < *starts[5usize] { bad.push(*good[k]); k = k + 1usize; }
  k = *starts[5usize];
  while k < good.len() { bad.push(*good[k]); k = k + 1usize; }
  expect(!reads(bad.view()), "a repeated section is refused");
  bad = good.clone();
  bad.set(*starts[1usize] + 1usize, *good[*starts[1usize] + 1usize] + 5u8);
  expect(!reads(bad.view()), "a section length that runs past the bytes is refused");
  bad = good.clone();
  bad.set(*starts[3usize] + 1usize, *good[*starts[3usize] + 1usize] + 1u8);
  expect(!reads(bad.view()), "a section length longer than its contents is refused");
  bad = good.clone();
  bad.truncate(5usize);
  expect(!reads(bad.view()), "a container cut inside the version is refused");
  bad = List[u8]();
  expect(!reads(bad.view()), "no bytes is refused");
  bad = good.clone();
  bad.truncate(8usize);
  expect(!reads(bad.view()), "a header with no sections is refused");
  bad = good.clone();
  bad.set(3usize, 1u8);
  expect(!reads(bad.view()), "a wrong fourth magic byte is refused");
  bad = good.clone();
  bad.set(5usize, 1u8);
  expect(!reads(bad.view()), "a major version of 256 is refused");
  bad = good.clone();
  bad.set(4usize, 0u8);
  expect(!reads(bad.view()), "a major version of 0 is refused");
  done()
}
