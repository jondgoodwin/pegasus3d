  let s4 = w.code.types.sig(&[h4], e.view());
  w.beginUnit(s3, "wants3"); w.endUnit();
  w.beginUnit(s4, "gives4"); w.opU(OP_LOCAL_GET, 0u32); w.opU(OP_CALL, 0u32); w.endUnit();
  refused("a handle of kind 4 passed where kind 3 is wanted", &w, &tables, 1u32, "wrong type");
  w = CodeWriter.make();
  let lf = w.code.types.list(TY_F64);
  let li = w.code.types.list(TY_I64);
  let sl = w.code.types.sig(&[lf], e.view());
  let sli = w.code.types.sig(&[li], e.view());
