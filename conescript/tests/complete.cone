  w = unit(e.view(), e.view());
  w.f64Const(1.0); w.f64Const(2.0); w.boolConst(true); w.opU(OP_SELECT, 99u32); w.endUnit();
  refused("select of a type out of range", &w, &tables, 0u32, "value type");
  w = unit(e.view(), e.view());
  b0 = w.code.types.sig(e.view(), e.view());
  w.f64Const(1.0); w.f64Const(2.0); w.boolConst(true); w.opU(OP_SELECT, b0); w.endUnit();
  refused("select of a signature type", &w, &tables, 0u32, "value type");
  w = unit(e.view(), &[TY_BOOL]);
  w.f64Const(1.0); w.f64Const(2.0); w.boolConst(true); w.opU(OP_SELECT, TY_F64); w.endUnit();
  refused("select gives its type", &w, &tables, 0u32, "wrong type");

  w = unit(e.view(), e.view());
  w.opU(OP_DROP, TY_F64); w.endUnit();
  refused("drop with an empty stack", &w, &tables, 0u32, "empty");
  w = unit(e.view(), e.view());
  w.f64Const(1.0); w.opU(OP_DROP, 99u32); w.endUnit();
  refused("drop of a type out of range", &w, &tables, 0u32, "value type");
  w = unit(e.view(), e.view());
  b0 = w.code.types.sig(e.view(), e.view());
  w.f64Const(1.0); w.opU(OP_DROP, b0); w.endUnit();
