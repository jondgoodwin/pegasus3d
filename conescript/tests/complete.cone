  // ---- calls ----
  w = CodeWriter.make();
  var sigF = w.code.types.sig(&[TY_F64], &[TY_F64]);
  var sigB = w.code.types.sig(e.view(), &[TY_F64]);
  w.beginUnit(sigF, "callee"); w.opU(OP_LOCAL_GET, 0u32); w.endUnit();
  w.beginUnit(sigB, "caller"); w.boolConst(true); w.opU(OP_CALL, 0u32); w.endUnit();
