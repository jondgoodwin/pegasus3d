// The verifier made complete for the subset (W135): every rule of the step-3 spec's section 6, each with a one-defect
// unit the verifier must refuse, per op where the rule is per op. The lane's report holds the table of rules and the
// mutants (a check removed, some case here fails).

mod complete;

import testing use *;
import stdio use *;
import collections use *;
import conescript use *;

fn has(s: &String, needle: &str) bool {
  let hay = s.view();
  let nd = String.from(needle);
  let n = nd.view();
  if n.len > hay.len { return false; }
  var i = 0usize;
  while i + n.len <= hay.len {
    var j = 0usize;
    while j < n.len && hay[i + j] == n[j] { j = j + 1usize; }
    if j == n.len { return true; }
    i = i + 1usize;
  }
  false
}

// True if the verifier refuses, with a problem in 'unit' whose text holds 'needle'
fn refusedBy(w: &CodeWriter, tables: &ImportTables[u8], unit: u32, needle: &str) bool {
  match verify(&w.code, tables) {
    case let Ok(v) { false }
    case let Err(ps) {
      var found = false;
      var i = 0usize;
      while i < ps.len() { if has(&ps[i].what, needle) && ps[i].unit == unit { found = true; } i = i + 1usize; }
      found
    }
  }
}

fn refused(label: &str, w: &CodeWriter, tables: &ImportTables[u8], unit: u32, needle: &str) {
  expect(refusedBy(w, tables, unit, needle), label);
}

fn accepted(label: &str, w: &CodeWriter, tables: &ImportTables[u8]) {
  match verify(&w.code, tables) {
    case let Ok(v) { expect(true, label); }
    case let Err(ps) { expect(false, label); }
  }
}

fn reads(b: &Array[u8]) bool {
  match decode(b) {
    case let Ok(c) { true }
    case let Err(p) { false }
  }
}

fn noop(h: &mut HandleTable[u8], s: &mut Array[u64]) bool { true }

fn unit(params: &Array[u32], results: &Array[u32]) CodeWriter {
  var w = CodeWriter.make();
  let sig = w.code.types.sig(params, results);
  w.beginUnit(sig, "u");
  w
}

// Pushes one value of a primitive type
fn pushOf(w: &mut CodeWriter, t: u32) {
  if t == TY_F64 { w.f64Const(1.0); }
  else if t == TY_BOOL { w.boolConst(true); }
  else if t == TY_I64 { w.i64Const(1i64); }
  else { w.opU(OP_PART_CONST, 0u32); }
}

fn wrongFor(t: u32) u32 { if t == TY_F64 { TY_BOOL } else { TY_F64 } }

// An op that takes 'n' plain values of type 'arg' and gives one of type 'res': right operands accepted, and a wrong
// type in the deepest operand refused
fn simpleOp(op: u8, n: u32, arg: u32, res: u32, tables: &ImportTables[u8]) {
  let e = List[u32]();
  var w = unit(e.view(), &[res]);
  pushOf(&mut w, arg);
  if n == 2u32 { pushOf(&mut w, arg); }
  w.op(op); w.endUnit();
  match verify(&w.code, tables) {
    case let Ok(v) {}
    case let Err(ps) { print <- "  right operands refused, op "; print <- u32.from(op); print <- "\n"; expect(false, "an op with right operands is accepted"); }
  }
  var x = unit(e.view(), &[res]);
  pushOf(&mut x, wrongFor(arg));
  if n == 2u32 { pushOf(&mut x, arg); }
  x.op(op); x.endUnit();
  if !refusedBy(&x, tables, 0u32, "wrong type") { print <- "  wrong operand accepted, op "; print <- u32.from(op); print <- "\n"; expect(false, "an op given a wrong operand type is refused"); }
  if n == 2u32 {
    var y = unit(e.view(), &[res]);
    pushOf(&mut y, arg); pushOf(&mut y, wrongFor(arg));
    y.op(op); y.endUnit();
    if !refusedBy(&y, tables, 0u32, "wrong type") { print <- "  wrong top operand accepted, op "; print <- u32.from(op); print <- "\n"; expect(false, "an op given a wrong top operand is refused"); }
  }
  var z = unit(e.view(), &[res]);
  if n == 2u32 { pushOf(&mut z, arg); }
  z.op(op); z.endUnit();
  if !refusedBy(&z, tables, 0u32, "empty") { print <- "  empty stack accepted, op "; print <- u32.from(op); print <- "\n"; expect(false, "an op on too few operands is refused"); }
}

fn main() i32 {
  let e = List[u32]();
  let tables = ImportTables[u8].make();
  var w = unit(e.view(), e.view());

  // ---- per op: operand types and the stack ----
  simpleOp(OP_F64_ADD, 2u32, TY_F64, TY_F64, &tables);
  simpleOp(OP_F64_SUB, 2u32, TY_F64, TY_F64, &tables);
  simpleOp(OP_F64_MUL, 2u32, TY_F64, TY_F64, &tables);
  simpleOp(OP_F64_DIV, 2u32, TY_F64, TY_F64, &tables);
  simpleOp(OP_F64_MIN, 2u32, TY_F64, TY_F64, &tables);
  simpleOp(OP_F64_MAX, 2u32, TY_F64, TY_F64, &tables);
  simpleOp(OP_F64_NEG, 1u32, TY_F64, TY_F64, &tables);
  simpleOp(OP_F64_ABS, 1u32, TY_F64, TY_F64, &tables);
  simpleOp(OP_F64_SQRT, 1u32, TY_F64, TY_F64, &tables);
  simpleOp(OP_F64_EQ, 2u32, TY_F64, TY_BOOL, &tables);
  simpleOp(OP_F64_NE, 2u32, TY_F64, TY_BOOL, &tables);
  simpleOp(OP_F64_LT, 2u32, TY_F64, TY_BOOL, &tables);
  simpleOp(OP_F64_LE, 2u32, TY_F64, TY_BOOL, &tables);
  simpleOp(OP_F64_GT, 2u32, TY_F64, TY_BOOL, &tables);
  simpleOp(OP_F64_GE, 2u32, TY_F64, TY_BOOL, &tables);
  simpleOp(OP_BOOL_NOT, 1u32, TY_BOOL, TY_BOOL, &tables);
  simpleOp(OP_BOOL_AND, 2u32, TY_BOOL, TY_BOOL, &tables);
  simpleOp(OP_BOOL_OR, 2u32, TY_BOOL, TY_BOOL, &tables);
  simpleOp(OP_BOOL_FROM_F64, 1u32, TY_F64, TY_BOOL, &tables);
  simpleOp(OP_F64_FROM_BOOL, 1u32, TY_BOOL, TY_F64, &tables);
  simpleOp(OP_I64_ADD, 2u32, TY_I64, TY_I64, &tables);
  simpleOp(OP_I64_SUB, 2u32, TY_I64, TY_I64, &tables);
  simpleOp(OP_I64_MUL, 2u32, TY_I64, TY_I64, &tables);
  simpleOp(OP_I64_EQ, 2u32, TY_I64, TY_BOOL, &tables);
  simpleOp(OP_I64_NE, 2u32, TY_I64, TY_BOOL, &tables);
  simpleOp(OP_I64_LT, 2u32, TY_I64, TY_BOOL, &tables);
  simpleOp(OP_I64_FROM_PART, 1u32, TY_PART, TY_I64, &tables);
  simpleOp(OP_F64_FROM_I64, 1u32, TY_I64, TY_F64, &tables);

  // the constants
  w = unit(e.view(), &[TY_I64]);
  w.i64Const(-5i64); w.endUnit();
  accepted("an i64 constant", &w, &tables);
  w = unit(e.view(), &[TY_PART]);
  w.opU(OP_PART_CONST, 3u32); w.endUnit();
  accepted("a part constant", &w, &tables);
  w = unit(e.view(), &[TY_F64]);
  w.i64Const(1i64); w.endUnit();
  refused("an i64 constant where an f64 is wanted", &w, &tables, 0u32, "wrong type");
  w = unit(e.view(), &[TY_F64]);
  w.opU(OP_PART_CONST, 0u32); w.endUnit();
  refused("a part constant where an f64 is wanted", &w, &tables, 0u32, "wrong type");
  w = unit(e.view(), e.view());
  w.op(OP_I64_CONST); w.op(0x80u8);
  refused("a cut-short i64 constant", &w, &tables, 0u32, "cut-short");
  w = unit(e.view(), e.view());
  w.op(OP_PART_CONST);
  refused("a cut-short part constant", &w, &tables, 0u32, "cut-short");
  w = unit(e.view(), e.view());
  w.op(OP_BOOL_CONST);
  refused("a bool constant with no byte", &w, &tables, 0u32, "bool constant");
  w = unit(e.view(), e.view());
  w.op(OP_BLOCK); w.op(0xFFu8); w.op(0xFFu8); w.op(0xFFu8); w.op(0xFFu8); w.op(0x1Fu8); w.endUnit();
  refused("an immediate too large for 32 bits", &w, &tables, 0u32, "oversized");

  // ---- control ----
  w = unit(e.view(), &[TY_F64]);
  var bf = w.code.types.sig(e.view(), &[TY_F64]);
  w.opU(OP_LOOP, bf); w.boolConst(true); w.op(OP_END); w.endUnit();
  refused("a loop ends with the wrong type", &w, &tables, 0u32, "wrong type");
  w = unit(e.view(), e.view());
  var b0 = w.code.types.sig(e.view(), e.view());
  w.f64Const(1.0); w.opU(OP_IF, b0); w.op(OP_END); w.endUnit();
  refused("an if whose condition is not a bool", &w, &tables, 0u32, "wrong type");
  w = unit(e.view(), e.view());
  b0 = w.code.types.sig(e.view(), e.view());
  w.opU(OP_IF, b0); w.op(OP_END); w.endUnit();
  refused("an if with no condition", &w, &tables, 0u32, "empty");
  w = unit(e.view(), &[TY_F64]);
  bf = w.code.types.sig(e.view(), &[TY_F64]);
  w.boolConst(true); w.opU(OP_IF, bf); w.f64Const(1.0); w.op(OP_ELSE); w.boolConst(false); w.op(OP_END); w.endUnit();
  refused("an else arm ends with the wrong type", &w, &tables, 0u32, "wrong type");
  w = unit(e.view(), &[TY_F64]);
  bf = w.code.types.sig(e.view(), &[TY_F64]);
  w.boolConst(true); w.opU(OP_IF, bf); w.boolConst(false); w.op(OP_ELSE); w.f64Const(1.0); w.op(OP_END); w.endUnit();
  refused("a then arm ends with the wrong type", &w, &tables, 0u32, "wrong type");
  w = unit(e.view(), e.view());
  b0 = w.code.types.sig(e.view(), e.view());
  w.boolConst(true); w.opU(OP_IF, b0); w.f64Const(1.0); w.op(OP_ELSE); w.op(OP_END); w.endUnit();
  refused("a then arm leaves a value its block does not give", &w, &tables, 0u32, "left on the stack");
  w = unit(e.view(), e.view());
  b0 = w.code.types.sig(e.view(), e.view());
  w.boolConst(true); w.opU(OP_IF, b0); w.op(OP_ELSE); w.f64Const(1.0); w.op(OP_END); w.endUnit();
  refused("an else arm leaves a value its block does not give", &w, &tables, 0u32, "left on the stack");
  w = unit(e.view(), e.view());
  b0 = w.code.types.sig(e.view(), e.view());
  w.boolConst(true); w.opU(OP_IF, b0); w.op(OP_ELSE); w.op(OP_ELSE); w.op(OP_END); w.endUnit();
  refused("a second else", &w, &tables, 0u32, "else");
  w = unit(e.view(), e.view());
  b0 = w.code.types.sig(e.view(), e.view());
  w.opU(OP_BLOCK, b0); w.op(OP_ELSE); w.op(OP_END); w.endUnit();
  refused("else inside a block", &w, &tables, 0u32, "else");
  w = unit(e.view(), e.view());
  b0 = w.code.types.sig(e.view(), e.view());
  w.opU(OP_LOOP, b0); w.op(OP_ELSE); w.op(OP_END); w.endUnit();
  refused("else inside a loop", &w, &tables, 0u32, "else");
  w = unit(e.view(), e.view());
  b0 = w.code.types.sig(e.view(), e.view());
  w.opU(OP_BLOCK, b0); w.endUnit();
  refused("a block never closed", &w, &tables, 0u32, "does not end");
  w = unit(e.view(), e.view());
  w.opU(OP_BLOCK, 99u32); w.op(OP_END); w.endUnit();
  refused("a block type out of range", &w, &tables, 0u32, "without parameters");
  w = unit(e.view(), e.view());
  w.opU(OP_BLOCK, TY_F64); w.op(OP_END); w.endUnit();
  refused("a block type that is not a signature", &w, &tables, 0u32, "without parameters");

  // branches
  w = unit(e.view(), e.view());
  b0 = w.code.types.sig(e.view(), e.view());
  w.opU(OP_BLOCK, b0); w.f64Const(1.0); w.opU(OP_BR_IF, 0u32); w.op(OP_END); w.endUnit();
  refused("br_if whose condition is not a bool", &w, &tables, 0u32, "wrong type");
  w = unit(e.view(), e.view());
  w.boolConst(true); w.opU(OP_BR_IF, 1u32); w.endUnit();
  refused("br_if with a depth out of range", &w, &tables, 0u32, "depth");
  w = unit(e.view(), e.view());
  b0 = w.code.types.sig(e.view(), e.view());
  w.opU(OP_BLOCK, b0); w.opU(OP_BR_IF, 0u32); w.op(OP_END); w.endUnit();
  refused("br_if with no condition", &w, &tables, 0u32, "empty");
  w = unit(e.view(), &[TY_F64]);
  bf = w.code.types.sig(e.view(), &[TY_F64]);
  w.opU(OP_BLOCK, bf); w.boolConst(true); w.boolConst(true); w.opU(OP_BR_IF, 0u32); w.op(OP_END); w.endUnit();
  refused("br_if carries the wrong type", &w, &tables, 0u32, "wrong type");
  w = unit(e.view(), &[TY_F64]);
  bf = w.code.types.sig(e.view(), &[TY_F64]);
  w.opU(OP_BLOCK, bf); w.boolConst(true); w.opU(OP_BR_IF, 0u32); w.op(OP_END); w.endUnit();
  refused("br_if carries nothing where a value is wanted", &w, &tables, 0u32, "empty");
  w = unit(e.view(), &[TY_F64]);
  bf = w.code.types.sig(e.view(), &[TY_F64]);
  w.opU(OP_BLOCK, bf); w.opU(OP_BR, 0u32); w.op(OP_END); w.endUnit();
  refused("br carries nothing where a value is wanted", &w, &tables, 0u32, "empty");
  w = unit(e.view(), &[TY_F64]);
  bf = w.code.types.sig(e.view(), &[TY_F64]);
  w.opU(OP_BLOCK, bf); w.f64Const(1.0); w.boolConst(true); w.opU(OP_BR_IF, 0u32); w.op(OP_END); w.endUnit();
  accepted("br_if carrying the right type", &w, &tables);
  w = unit(e.view(), &[TY_F64]);
  w.boolConst(true); w.op(OP_RETURN); w.endUnit();
  refused("return with the wrong type", &w, &tables, 0u32, "wrong type");
  w = unit(e.view(), &[TY_F64]);
  w.op(OP_RETURN); w.endUnit();
  refused("return with nothing where a value is wanted", &w, &tables, 0u32, "empty");
  w = unit(e.view(), &[TY_F64]);
  w.f64Const(1.0); w.op(OP_RETURN); w.endUnit();
  accepted("return with the right type", &w, &tables);
  w = unit(e.view(), &[TY_F64]);
  b0 = w.code.types.sig(e.view(), e.view());
  w.opU(OP_BLOCK, b0); w.f64Const(1.0); w.op(OP_RETURN); w.op(OP_END); w.f64Const(2.0); w.endUnit();
  accepted("return from inside a block", &w, &tables);
  w = unit(e.view(), &[TY_F64]);
  b0 = w.code.types.sig(e.view(), e.view());
  w.opU(OP_BLOCK, b0); w.boolConst(true); w.op(OP_RETURN); w.op(OP_END); w.f64Const(2.0); w.endUnit();
  refused("return from inside a block with the wrong type", &w, &tables, 0u32, "wrong type");
  w = unit(e.view(), e.view());
  b0 = w.code.types.sig(e.view(), e.view());
  w.opU(OP_LOOP, b0); w.f64Const(1.0); w.boolConst(true); w.opU(OP_BR_IF, 0u32); w.opU(OP_DROP, TY_F64); w.op(OP_END); w.endUnit();
  accepted("a back-edge with a stray value beneath", &w, &tables);

  // nothing is popped below a block's base
  w = unit(e.view(), &[TY_F64]);
  b0 = w.code.types.sig(e.view(), e.view());
  w.f64Const(1.0); w.opU(OP_BLOCK, b0); w.op(OP_F64_NEG); w.op(OP_END); w.endUnit();
  refused("a block pops a value from outside it", &w, &tables, 0u32, "empty");
  w = unit(e.view(), &[TY_F64]);
  b0 = w.code.types.sig(e.view(), e.view());
  w.f64Const(1.0); w.opU(OP_LOOP, b0); w.opU(OP_DROP, TY_F64); w.op(OP_END); w.endUnit();
  refused("a loop pops a value from outside it", &w, &tables, 0u32, "empty");
  w = unit(e.view(), &[TY_F64]);
  b0 = w.code.types.sig(e.view(), e.view());
  w.f64Const(1.0); w.boolConst(true); w.opU(OP_IF, b0); w.opU(OP_DROP, TY_F64); w.op(OP_ELSE); w.op(OP_END); w.endUnit();
  refused("an if arm pops a value from outside it", &w, &tables, 0u32, "empty");
  w = unit(e.view(), &[TY_F64]);
  b0 = w.code.types.sig(e.view(), e.view());
  w.f64Const(1.0); w.boolConst(true); w.opU(OP_IF, b0); w.op(OP_ELSE); w.opU(OP_DROP, TY_F64); w.op(OP_END); w.endUnit();
  refused("an else arm pops a value from outside it", &w, &tables, 0u32, "empty");
  w = unit(e.view(), &[TY_F64]);
  bf = w.code.types.sig(e.view(), &[TY_F64]);
  w.opU(OP_BLOCK, bf); w.op(OP_END); w.endUnit();
  refused("a block with results and an empty body", &w, &tables, 0u32, "empty");
  w = unit(e.view(), e.view());
  b0 = w.code.types.sig(e.view(), e.view());
  w.f64Const(1.0); w.opU(OP_BLOCK, b0); w.op(OP_END); w.endUnit();
  refused("a value beneath a block is left at the function's end", &w, &tables, 0u32, "left on the stack");

  // ---- locals ----
  w = unit(e.view(), e.view());
  var l0 = w.local(TY_F64);
  w.boolConst(true); w.opU(OP_LOCAL_SET, l0); w.endUnit();
  refused("local.set with the wrong type", &w, &tables, 0u32, "wrong type");
  w = unit(e.view(), e.view());
  w.f64Const(1.0); w.opU(OP_LOCAL_SET, 7u32); w.endUnit();
  refused("local.set out of range", &w, &tables, 0u32, "local out of range");
  w = unit(e.view(), e.view());
  w.opU(OP_LOCAL_SET, 0u32); w.endUnit();
  refused("local.set on a unit with no locals", &w, &tables, 0u32, "local out of range");
  w = unit(e.view(), e.view());
  l0 = w.local(TY_F64);
  w.opU(OP_LOCAL_SET, l0); w.endUnit();
  refused("local.set from an empty stack", &w, &tables, 0u32, "empty");
  w = unit(e.view(), e.view());
  l0 = w.local(TY_F64);
  w.boolConst(true); w.opU(OP_LOCAL_TEE, l0); w.opU(OP_DROP, TY_F64); w.endUnit();
  refused("local.tee with the wrong type", &w, &tables, 0u32, "wrong type");
  w = unit(e.view(), e.view());
  w.f64Const(1.0); w.opU(OP_LOCAL_TEE, 7u32); w.endUnit();
  refused("local.tee out of range", &w, &tables, 0u32, "local out of range");
  w = unit(e.view(), e.view());
  l0 = w.local(TY_F64);
  w.opU(OP_LOCAL_TEE, l0); w.opU(OP_DROP, TY_F64); w.endUnit();
  refused("local.tee from an empty stack", &w, &tables, 0u32, "empty");
  w = unit(e.view(), &[TY_BOOL]);
  l0 = w.local(TY_F64);
  w.opU(OP_LOCAL_GET, l0); w.endUnit();
  refused("local.get gives its local's type", &w, &tables, 0u32, "wrong type");
  w = unit(&[TY_F64], &[TY_BOOL]);
  w.opU(OP_LOCAL_GET, 0u32); w.endUnit();
  refused("local.get of a parameter gives its type", &w, &tables, 0u32, "wrong type");
  w = unit(e.view(), &[TY_F64]);
  l0 = w.local(TY_F64);
  w.opU(OP_LOCAL_GET, l0); w.endUnit();
  accepted("a scalar local may be read before it is set", &w, &tables);

  // handle, list and tuple-holding-a-handle locals must be set before they are read
  w = unit(e.view(), e.view());
  var lt = w.code.types.list(TY_F64);
  l0 = w.local(lt);
  w.opU(OP_LOCAL_GET, l0); w.opU(OP_DROP, lt); w.endUnit();
  refused("a list local read before it is set", &w, &tables, 0u32, "before it is set");
  w = unit(e.view(), e.view());
  var ht = w.code.types.handle(2u32);
  var tt = w.code.types.tuple(&[TY_F64, ht]);
  l0 = w.local(tt);
  w.opU(OP_LOCAL_GET, l0); w.opU(OP_DROP, tt); w.endUnit();
  refused("a tuple holding a handle read before it is set", &w, &tables, 0u32, "before it is set");
  w = unit(e.view(), e.view());
  ht = w.code.types.handle(2u32);
  tt = w.code.types.tuple(&[TY_F64, ht]);
  var tt2 = w.code.types.tuple(&[TY_F64, tt]);
  l0 = w.local(tt2);
  w.opU(OP_LOCAL_GET, l0); w.opU(OP_DROP, tt2); w.endUnit();
  refused("a tuple holding a tuple holding a handle, read before it is set", &w, &tables, 0u32, "before it is set");
  w = unit(e.view(), e.view());
  tt = w.code.types.tuple(&[TY_F64, TY_BOOL]);
  l0 = w.local(tt);
  w.opU(OP_LOCAL_GET, l0); w.opU(OP_DROP, tt); w.endUnit();
  accepted("a tuple of scalars may be read before it is set", &w, &tables);
  w = CodeWriter.make();
  ht = w.code.types.handle(2u32);
  let hs = w.code.types.sig(&[ht], e.view());
  w.beginUnit(hs, "u");
  w.opU(OP_LOCAL_GET, 0u32); w.opU(OP_DROP, ht); w.endUnit();
  accepted("a handle parameter is set on entry", &w, &tables);
  w = CodeWriter.make();
  ht = w.code.types.handle(2u32);
  w.beginUnit(w.code.types.sig(&[ht], e.view()), "u");
  l0 = w.local(ht);
  w.opU(OP_LOCAL_GET, 0u32); w.opU(OP_LOCAL_TEE, l0); w.opU(OP_DROP, ht);
  w.opU(OP_LOCAL_GET, l0); w.opU(OP_DROP, ht); w.endUnit();
  accepted("local.tee sets a handle local", &w, &tables);
  w = CodeWriter.make();
  ht = w.code.types.handle(2u32);
  var ht4 = w.code.types.handle(4u32);
  w.beginUnit(w.code.types.sig(&[ht], e.view()), "u");
  l0 = w.local(ht4);
  w.opU(OP_LOCAL_GET, 0u32); w.opU(OP_LOCAL_SET, l0); w.endUnit();
  refused("a handle of one kind stored in a local of another", &w, &tables, 0u32, "wrong type");
  // a loop body: set before the exit test, read after
  w = CodeWriter.make();
  ht = w.code.types.handle(2u32);
  b0 = w.code.types.sig(e.view(), e.view());
  w.beginUnit(w.code.types.sig(&[ht], e.view()), "u");
  l0 = w.local(ht);
  w.opU(OP_LOOP, b0); w.opU(OP_LOCAL_GET, 0u32); w.opU(OP_LOCAL_SET, l0); w.boolConst(false); w.opU(OP_BR_IF, 0u32); w.op(OP_END);
  w.opU(OP_LOCAL_GET, l0); w.opU(OP_DROP, ht); w.endUnit();
  accepted("a handle set in a loop body is set after the loop", &w, &tables);
  w = CodeWriter.make();
  ht = w.code.types.handle(2u32);
  b0 = w.code.types.sig(e.view(), e.view());
  w.beginUnit(w.code.types.sig(&[ht], e.view()), "u");
  l0 = w.local(ht);
  w.opU(OP_LOOP, b0); w.opU(OP_LOCAL_GET, l0); w.opU(OP_DROP, ht); w.opU(OP_LOCAL_GET, 0u32); w.opU(OP_LOCAL_SET, l0);
  w.boolConst(true); w.opU(OP_BR_IF, 0u32); w.op(OP_END); w.endUnit();
  refused("a handle read at the top of a loop, set only later in it", &w, &tables, 0u32, "before it is set");
  w = CodeWriter.make();
  ht = w.code.types.handle(2u32);
  b0 = w.code.types.sig(e.view(), e.view());
  w.beginUnit(w.code.types.sig(&[ht], e.view()), "u");
  l0 = w.local(ht);
  w.opU(OP_BLOCK, b0); w.opU(OP_LOCAL_GET, 0u32); w.opU(OP_LOCAL_SET, l0); w.opU(OP_BR, 0u32); w.op(OP_END);
  w.opU(OP_LOCAL_GET, l0); w.opU(OP_DROP, ht); w.endUnit();
  accepted("a handle set before an unconditional branch out of its block", &w, &tables);
  w = CodeWriter.make();
  ht = w.code.types.handle(2u32);
  b0 = w.code.types.sig(e.view(), e.view());
  w.beginUnit(w.code.types.sig(&[ht], e.view()), "u");
  l0 = w.local(ht);
  w.opU(OP_BLOCK, b0); w.boolConst(true); w.opU(OP_BR_IF, 0u32); w.opU(OP_LOCAL_GET, 0u32); w.opU(OP_LOCAL_SET, l0); w.opU(OP_BR, 0u32); w.op(OP_END);
  w.opU(OP_LOCAL_GET, l0); w.opU(OP_DROP, ht); w.endUnit();
  refused("a conditional branch skips the set, then an unconditional one leaves", &w, &tables, 0u32, "before it is set");
  w = CodeWriter.make();
  ht = w.code.types.handle(2u32);
  b0 = w.code.types.sig(e.view(), e.view());
  w.beginUnit(w.code.types.sig(&[ht], e.view()), "u");
  l0 = w.local(ht);
  w.opU(OP_BLOCK, b0); w.opU(OP_BLOCK, b0); w.boolConst(true); w.opU(OP_BR_IF, 1u32);
  w.opU(OP_LOCAL_GET, 0u32); w.opU(OP_LOCAL_SET, l0); w.op(OP_END); w.op(OP_END);
  w.opU(OP_LOCAL_GET, l0); w.opU(OP_DROP, ht); w.endUnit();
