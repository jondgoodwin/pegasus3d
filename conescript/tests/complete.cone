  w.f64Const(1.0); w.opUU(OP_TUPLE_GET, TY_F64, 0u32); w.endUnit();
  refused("tuple.get of a type that is not a tuple", &w, &tables, 0u32, "tuple type");
  w = unit(e.view(), e.view());
  w.f64Const(1.0); w.opUU(OP_TUPLE_GET, 99u32, 0u32); w.endUnit();
  refused("tuple.get of a type out of range", &w, &tables, 0u32, "tuple type");
  w = unit(e.view(), &[TY_BOOL]);
  tt = w.code.types.tuple(&[TY_F64, TY_BOOL]);
  w.f64Const(1.0); w.boolConst(true); w.opU(OP_TUPLE_MAKE, tt); w.opUU(OP_TUPLE_GET, tt, 0u32); w.endUnit();
  refused("tuple.get gives the field's type", &w, &tables, 0u32, "wrong type");
  w = unit(e.view(), &[TY_BOOL]);
  tt = w.code.types.tuple(&[TY_F64, TY_BOOL]);
  w.f64Const(1.0); w.boolConst(true); w.opU(OP_TUPLE_MAKE, tt); w.opUU(OP_TUPLE_GET, tt, 1u32); w.endUnit();
  accepted("tuple.make then tuple.get", &w, &tables);
  w = unit(e.view(), e.view());
  tt = w.code.types.tuple(&[TY_F64, TY_F64]);
  tt2 = w.code.types.tuple(&[TY_F64, TY_BOOL]);
  w.f64Const(1.0); w.f64Const(1.0); w.opU(OP_TUPLE_MAKE, tt); w.opUU(OP_TUPLE_GET, tt2, 0u32); w.endUnit();
  refused("tuple.get of a different tuple type", &w, &tables, 0u32, "wrong type");
  // two tuple types spelled twice, the same structure, are the same type
  w = CodeWriter.make();
  tt = w.code.types.tuple(&[TY_F64, TY_F64]);
  w.code.types.defs.push(TypeDef(T_TUPLE, 0u32, List[u32](), List[u32]()));
  (&mut w.code.types.defs[w.code.types.defs.len() - 1usize]).items.push(TY_F64);
