  w = CodeWriter.make();
  ht = w.code.types.handle(2u32);
  w.beginUnit(w.code.types.sig(&[ht], e.view()), "u");
  l0 = w.local(ht);
  w.boolConst(true); w.op(OP_RETURN); w.endUnit();
  accepted("a return needs no local set (it leaves the unit)", &w, &tables);

  // ---- aggregates ----
  w = unit(e.view(), e.view());
  tt = w.code.types.tuple(&[TY_F64, TY_BOOL]);
  w.boolConst(true); w.f64Const(1.0); w.opU(OP_TUPLE_MAKE, tt); w.opU(OP_DROP, tt); w.endUnit();
  refused("tuple.make with the fields in the wrong order", &w, &tables, 0u32, "wrong type");
  w = unit(e.view(), e.view());
  tt = w.code.types.tuple(&[TY_F64, TY_F64]);
  w.f64Const(1.0); w.opU(OP_TUPLE_MAKE, tt); w.opU(OP_DROP, tt); w.endUnit();
  refused("tuple.make with too few values", &w, &tables, 0u32, "empty");
  w = unit(e.view(), e.view());
  w.f64Const(1.0); w.opU(OP_TUPLE_MAKE, TY_F64); w.endUnit();
  refused("tuple.make of a type that is not a tuple", &w, &tables, 0u32, "tuple type");
  w = unit(e.view(), e.view());
  w.f64Const(1.0); w.opU(OP_TUPLE_MAKE, 99u32); w.endUnit();
  refused("tuple.make of a type out of range", &w, &tables, 0u32, "tuple type");
  w = unit(e.view(), e.view());
  tt = w.code.types.tuple(&[TY_F64, TY_F64]);
  w.f64Const(1.0); w.opUU(OP_TUPLE_GET, tt, 0u32); w.endUnit();
