// The vocabulary: the library calls a world may make, each one a row of a table. A row is a builder's ConeScript name
// (a path of one or two names), its parameters (name, type, required or its default), what it makes, how many 8-byte
// slots its result takes, and its fuel weight. The checker reads this table to check a call; the code that builds a
// part (partbuild) and the interpreter read the same table to pack a call's arguments into slots, so there is one
// description of the signatures and the two cannot drift apart. The rows themselves are written by a person in
// partbuild's vocab.list; this file holds only their types, which need no library.
//
// Slots: a value is a run of 8-byte slots. A number is one slot holding its f64 bits (f64.fromBits to read it); a
// truth is one slot, 0 or 1; a Point or Direction is three, a Point2 or LengthRange two, a Color four (linear red,
// green, blue, opacity) and a Rotation four (a quaternion's x, y, z, w), each as the f64 of the f32 value. Everything
// else (a shape, an outline, a list ...) is one slot holding a handle in the caller's own table; handle 0 is none.

// How many 8-byte slots a value of this type takes
pub fn slotsOf(t: Ty) u32 {
  if t == Ty.Point || t == Ty.Direction { return 3u32; }
  if t == Ty.Point2 || t == Ty.LengthRange { return 2u32; }
  if t == Ty.Color || t == Ty.Rotation { return 4u32; }
  1u32
}

// One parameter of a row, with its default as slot words (empty when it is required)
pub struct ToolParam {
  pub name: u32;
  pub ty: Ty;
  pub required: bool;
  pub fallback: List[u64];       // the default
}

// One row: a call by name
pub struct ToolSignature {
  pub path: List[u32];            // the names that spell the call: [lathe], [outline, rectangle]; empty for a form no path spells
  pub params: List[ToolParam];    // in the order a call's arguments by position fill them
  pub makes: Ty;
  pub resultSlots: u32;           // how many slots its result takes
  pub weight: u32;                // the fuel one call costs (1 unless a row says more)

  // How many slots the arguments take, all together
  pub fn argSlots(self: &) u32 {
    var n = 0u32;
    var i = 0usize;
    while i < params.len() { n = n + slotsOf(params[i].ty); i = i + 1usize; }
    n
  }
}

// The table
pub struct Vocabulary {
  pub tools: List[ToolSignature];
  pub outlineList: u32;           // the row for a list of flat points where an outline is wanted: [(x, y), ...]
  pub materialList: u32;          // the row for a material and its modifiers: [material, modifier, ...]

  pub fn empty() Vocabulary { Vocabulary(List[ToolSignature](), 0u32, 0u32) }

  // The row a call's path names, if any
  pub fn find(self: &, callee: &List[u32]) Option[u32] {
    var t = 0usize;
    while t < tools.len() {
      let p = &tools[t].path;
      if p.len() == callee.len() && p.len() > 0usize {
        var same = true;
        var k = 0usize;
        while k < p.len() { if *p[k] != *callee[k] { same = false; } k = k + 1usize; }
        if same { return Some[u32](u32.from(t)); }
      }
      t = t + 1usize;
    }
    None
  }
}
