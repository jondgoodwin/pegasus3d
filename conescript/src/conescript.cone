// ConeScript's front end: a world's text read and checked. Moved here from the guide browser (lexer, parser,
// expand, understand) so that every browser reads the language with one copy of the code.
//
//   read(src)           the text parsed, expanded and understood; never fails: what went wrong is in 'problems'
//   showProblems(f, p)  each problem as 'file:line:column: message'
//
// The stages stay public as they were: parse, expand, understand, and the types they pass (Names, Problem,
// PartDecl, Understood and the rest).

mod conescript;

import stdio use *;
import libc;
import collections use *;
import json;
import codegen use * but encode, decode;
import time use Instant;
import keyframetracks use LOOP_ONCE, LOOP_LOOP, LOOP_PINGPONG;

// What reading a world's text gave: what was understood, and every mistake found on the way
pub struct Reading {
  pub understood: Understood;     // its 'names' are the table the text was read with
  pub problems: List[Problem];
}

// A world's text parsed, expanded and understood against a vocabulary. 'names' is the table to read with, which holds
// the vocabulary's words (Names.standard(), then the vocabulary made over it); both end up in the result.
pub fn read(src: &Array[u8], names: Names, vocab: Vocabulary) Reading {
  var problems = List[Problem]();
  var table = names;
  let written = parse(src, &mut table, &mut problems);
  let decls = expand(&written, &mut table, &mut problems);
  let understood = understand(&decls, table, vocab, &mut problems);
  Reading(understood, problems)
}

// Each mistake, as 'file:line:column: message'
pub fn showProblems(file: &str, problems: &List[Problem]) {
  var i = 0usize;
  while i < problems.len() {
    printStr(file); print <- ":"; print <- problems[i].at.line; print <- ":"; print <- problems[i].at.column;
    print <- ": "; printStr(problems[i].message.view()); print <- "\n";
    i = i + 1usize;
  }
}
