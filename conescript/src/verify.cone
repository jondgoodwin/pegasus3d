// The verifier: code checked once, before anything runs, in one forward pass per unit (WebAssembly's algorithm:
// an operand-type stack and a control stack). What it checks, and what it builds for the interpreter, is in the
// step-3 spec, section 6. Only 'verify' makes a VerifiedCode, and the interpreter takes nothing else.

// What a unit needs at run time, worked out by the pass
struct UnitInfo {
  tgt: List[u32];         // by code offset: where a br, br_if, if, else or return goes
  keep: List[u32];        // by code offset: slots a taken branch carries
  drop: List[u32];        // by code offset: slots a taken branch discards beneath them
  maxDepth: u32;          // the most operand slots at once (an import's result window included)
  localOff: List[u32];    // each local's first slot in the frame
  localLen: List[u32];
  localSlots: u32;        // the locals' slots in all
  paramSlots: u32;
  resultSlots: u32;
}

// An import resolved against the tables
struct ResolvedImport {
  table: u32;             // its entry in the ImportTables
  paramSlots: u32;
  resultSlots: u32;
  weight: u32;
  why: String;            // empty if the host offers it as declared; else what is wrong (a unit that uses it is refused)
}

// Code that has passed 'verify'; the only thing the interpreter runs
pub struct VerifiedCode {
  code: Code;
  slots: List[u32];       // slots of each type
  units: List[UnitInfo];
  imports: List[ResolvedImport];
  refused: List[bool];            // by unit: its code did not verify, or it calls a unit that did not
  found: List[CodeProblem];       // what 'verifyEach' found, one per unit it refused

  // True if the unit was refused: it has no side tables, and 'run' will not run it
  pub fn isRefused(self: &, unit: usize) bool { *self.refused[unit] }
  // What was refused, once for each unit that is wrong in itself (a caller of one is refused without a line of its own)
  pub fn problems(self: &) &List[CodeProblem] { &self.found }
  pub fn unitCount(self: &) usize { self.units.len() }
  pub fn maxDepth(self: &, unit: usize) u32 { self.units[unit].maxDepth }
  // How many argument slots a unit takes (the length of the 'args' that 'run' wants)
  pub fn paramSlots(self: &, unit: usize) u32 { self.units[unit].paramSlots }
  pub fn source(self: &) &Code { &self.code }
}

fn problemAt(unit: u32, offset: u32, what: &str) CodeProblem { CodeProblem(unit, offset, String.from(what)) }

// ---- types ----

fn isValue(kind: u8) bool { kind != T_SIG }

// Checks the type table and works out each type's canonical number (the first structurally equal) and its slots
fn analyzeTypes(types: &TypeTable, canon: &mut List[u32], slots: &mut List[u32], problems: &mut List[CodeProblem]) {
  var i = 0usize;
  while i < types.defs.len() {
    let d = &types.defs[i];
    var ok = true;
    var n = 0u32;
    if i < 4usize {
      if usize.from(d.kind) != i { ok = false; }
      n = 1u32;
    } else {
      if d.kind < T_HANDLE || d.kind > T_SIG { ok = false; }
      if d.kind == T_LIST {
        if usize.from(d.arg) >= i || !isValue(types.defs[usize.from(d.arg)].kind) { ok = false; }
        n = 1u32;
      }
      if d.kind == T_HANDLE { n = 1u32; }
      if d.kind == T_TUPLE || d.kind == T_SIG {
        var j = 0usize;
        while j < d.items.len() {
          let f = usize.from(*d.items[j]);
          if f >= i || !isValue(types.defs[f].kind) { ok = false; } else if d.kind == T_TUPLE { n = n + *slots[f]; }
          j = j + 1usize;
        }
        j = 0usize;
        while j < d.results.len() {
          let f = usize.from(*d.results[j]);
          if f >= i || !isValue(types.defs[f].kind) { ok = false; }
          j = j + 1usize;
        }
        if d.kind == T_TUPLE && n > 4096u32 { ok = false; }
        if d.kind == T_SIG { n = 0u32; }
        if d.kind == T_TUPLE && d.items.len() == 0usize { ok = false; }
      }
    }
    if !ok {
      problems.push(problemAt(NO_UNIT, u32.from(i), "a malformed type (a reference forward or to a signature, an empty or oversized tuple, or an unknown kind)"));
      return;
    } else {
      // The first equal type (its parts compared by their canonical numbers)
      var c = u32.from(i);
      var k = 0usize;
      while k < i {
        let e = &types.defs[k];
        if *canon[k] == u32.from(k) && e.kind == d.kind && sameCanon(e, d, canon) { c = u32.from(k); break; }
        k = k + 1usize;
      }
      canon.push(c);
      slots.push(n);
    }
    i = i + 1usize;
  }
}

fn sameCanon(a: &TypeDef, b: &TypeDef, canon: &List[u32]) bool {
  if a.kind == T_HANDLE { return a.arg == b.arg; }
  if a.kind == T_LIST { return *canon[usize.from(a.arg)] == *canon[usize.from(b.arg)]; }
  if a.kind == T_TUPLE || a.kind == T_SIG {
    if a.items.len() != b.items.len() || a.results.len() != b.results.len() { return false; }
    var i = 0usize;
    while i < a.items.len() {
      if *canon[usize.from(*a.items[i])] != *canon[usize.from(*b.items[i])] { return false; }
      i = i + 1usize;
    }
    i = 0usize;
    while i < a.results.len() {
      if *canon[usize.from(*a.results[i])] != *canon[usize.from(*b.results[i])] { return false; }
      i = i + 1usize;
    }
  }
  true
}

// ---- the pass over one unit ----

struct Ctrl {
  kind: u8;               // 0 function, 1 block, 2 loop, 3 if, 4 else
  results: List[u32];     // canonical result types
  resultSlots: u32;
  base: usize;            // operand-stack depth (entries) at entry
  baseH: u32;             // operand-stack depth (slots) at entry
  unreachable: bool;
  ifOff: u32;             // an if's op offset
  elseOff: u32;
  loopTarget: u32;
  fix: List[u32];         // offsets whose target is this construct's end
  snap: List[bool];       // which locals were assigned at entry
  thenState: List[bool];
  merged: List[bool];
  hasMerged: bool;
}

struct Pass {
  vals: List[u32];
  h: u32;
  maxH: u32;
  ctrls: List[Ctrl];
  assigned: List[bool];
  tyslots: List[u32];
  failed: bool;
  why: String;
  at: u32;
  tgt: List[u32];
  keep: List[u32];
  drop: List[u32];

  fn fail(self: &mut, why: &str) {
    if !self.failed { self.failed = true; self.why = String.from(why); }
  }

  fn slotsOf(self: &, t: u32) u32 { if t == TY_ANY { 0u32 } else { *self.tyslots[usize.from(t)] } }

  fn push(self: &mut, t: u32) {
    if self.failed { return; }
    self.vals.push(t);
    self.h = self.h + self.slotsOf(t);
    if self.h > self.maxH { self.maxH = self.h; }
    if self.h > MAX_FRAME_SLOTS { self.fail("the operand stack is too deep"); }
  }

  // Pops a value; 'want' is TY_ANY to take any type
  fn pop(self: &mut, want: u32) u32 {
    let ci = self.ctrls.len() - 1usize;
    if self.vals.len() == self.ctrls[ci].base {
      if self.ctrls[ci].unreachable { return want; }
      self.fail("the operand stack is empty");
      return TY_ANY;
    }
    let t = self.vals.pop().unwrap();
    self.h = self.h - self.slotsOf(t);
    if want != TY_ANY && t != TY_ANY && t != want { self.fail("an operand has the wrong type"); }
    t
  }

  // After an unconditional branch, a return or an unreachable: the rest is dead code, typed loosely
  fn markUnreachable(self: &mut) {
    let ci = self.ctrls.len() - 1usize;
    self.vals.truncate(self.ctrls[ci].base);
    self.h = self.ctrls[ci].baseH;
    (&mut self.ctrls[ci]).unreachable = true;
    var i = 0usize;
    while i < self.assigned.len() { self.assigned.set(i, true); i = i + 1usize; }
  }

  fn immed(self: &mut, cb: &Array[u8], pos: &mut usize) u32 {
    var bad = false;
    let v = getU(cb, pos, cb.len, &mut bad);
    if bad || v > 0xFFFFFFFFu64 { self.fail("a cut-short or oversized immediate"); return 0u32; }
    u32.from(v)
  }

  // Records the side-table entry of a branch to the construct 'depth' out
  fn branch(self: &mut, depth: u32) {
    let ci = self.ctrls.len() - 1usize - usize.from(depth);
    let isLoop = self.ctrls[ci].kind == 2u8;
    let keep = if isLoop { 0u32 } else { self.ctrls[ci].resultSlots };
    let at = usize.from(self.at);
    self.keep.set(at, keep);
    let top = self.ctrls.len() - 1usize;
    var drop = 0u32;
    if !self.ctrls[top].unreachable && self.h >= self.ctrls[ci].baseH + keep { drop = self.h - self.ctrls[ci].baseH - keep; }
    self.drop.set(at, drop);
    if isLoop { self.tgt.set(at, self.ctrls[ci].loopTarget); } else { (&mut self.ctrls[ci]).fix.push(self.at); self.mergeTo(ci); }
  }

  fn mergeTo(self: &mut, ci: usize) {
    if !self.ctrls[ci].hasMerged {
      (&mut self.ctrls[ci]).merged = self.assigned.clone();
      (&mut self.ctrls[ci]).hasMerged = true;
    } else {
      var i = 0usize;
      while i < self.assigned.len() {
        if !*self.assigned[i] { (&mut self.ctrls[ci]).merged.set(i, false); }
        i = i + 1usize;
      }
    }
  }

  // The values a branch to depth d carries, popped (and checked) in reverse
  fn labelPop(self: &mut, depth: u32) {
    let ci = self.ctrls.len() - 1usize - usize.from(depth);
    if self.ctrls[ci].kind == 2u8 { return; }
    var i = self.ctrls[ci].results.len();
    while i > 0usize {
      i = i - 1usize;
      let t = *self.ctrls[ci].results[i];
      self.pop(t);
    }
  }
  fn labelPush(self: &mut, depth: u32) {
    let ci = self.ctrls.len() - 1usize - usize.from(depth);
    if self.ctrls[ci].kind == 2u8 { return; }
    var i = 0usize;
    while i < self.ctrls[ci].results.len() { let t = *self.ctrls[ci].results[i]; self.push(t); i = i + 1usize; }
  }

  // Pops the construct's results and demands nothing else above its base
  fn closeValues(self: &mut) {
    let ci = self.ctrls.len() - 1usize;
    var i = self.ctrls[ci].results.len();
    while i > 0usize {
      i = i - 1usize;
      let t = *self.ctrls[ci].results[i];
      self.pop(t);
    }
    if self.vals.len() != self.ctrls[ci].base { self.fail("values are left on the stack at the end of a block"); }
  }
}

fn newCtrl(kind: u8, results: List[u32], resultSlots: u32, base: usize, baseH: u32, assigned: &List[bool]) Ctrl {
  Ctrl(kind, results, resultSlots, base, baseH, false, 0u32, 0u32, 0u32, List[u32](), assigned.clone(), List[bool](), List[bool](), false)
}

// What an op that takes plain values and gives one does: how many it pops (0: not such an op), their type, its result
struct Simple { n: u32; arg: u32; res: u32; }

fn simple(op: u8) Simple {
  match op {
    case OP_F64_ADD { Simple(2u32, TY_F64, TY_F64) }
    case OP_F64_SUB { Simple(2u32, TY_F64, TY_F64) }
    case OP_F64_MUL { Simple(2u32, TY_F64, TY_F64) }
    case OP_F64_DIV { Simple(2u32, TY_F64, TY_F64) }
    case OP_F64_MIN { Simple(2u32, TY_F64, TY_F64) }
    case OP_F64_MAX { Simple(2u32, TY_F64, TY_F64) }
    case OP_F64_NEG { Simple(1u32, TY_F64, TY_F64) }
    case OP_F64_ABS { Simple(1u32, TY_F64, TY_F64) }
    case OP_F64_SQRT { Simple(1u32, TY_F64, TY_F64) }
    case OP_F64_EQ { Simple(2u32, TY_F64, TY_BOOL) }
    case OP_F64_NE { Simple(2u32, TY_F64, TY_BOOL) }
    case OP_F64_LT { Simple(2u32, TY_F64, TY_BOOL) }
    case OP_F64_LE { Simple(2u32, TY_F64, TY_BOOL) }
    case OP_F64_GT { Simple(2u32, TY_F64, TY_BOOL) }
    case OP_F64_GE { Simple(2u32, TY_F64, TY_BOOL) }
    case OP_BOOL_NOT { Simple(1u32, TY_BOOL, TY_BOOL) }
    case OP_BOOL_AND { Simple(2u32, TY_BOOL, TY_BOOL) }
    case OP_BOOL_OR { Simple(2u32, TY_BOOL, TY_BOOL) }
    case OP_BOOL_FROM_F64 { Simple(1u32, TY_F64, TY_BOOL) }
    case OP_F64_FROM_BOOL { Simple(1u32, TY_BOOL, TY_F64) }
    case OP_I64_ADD { Simple(2u32, TY_I64, TY_I64) }
    case OP_I64_SUB { Simple(2u32, TY_I64, TY_I64) }
    case OP_I64_MUL { Simple(2u32, TY_I64, TY_I64) }
    case OP_I64_EQ { Simple(2u32, TY_I64, TY_BOOL) }
    case OP_I64_NE { Simple(2u32, TY_I64, TY_BOOL) }
    case OP_I64_LT { Simple(2u32, TY_I64, TY_BOOL) }
    case OP_I64_FROM_PART { Simple(1u32, TY_PART, TY_I64) }
    case OP_F64_FROM_I64 { Simple(1u32, TY_I64, TY_F64) }
    else { Simple(0u32, 0u32, 0u32) }
  }
}

// Whether a type holds a handle or a list somewhere, so a local of it must be set before it is read
fn needsInit(types: &TypeTable, t: u32) bool {
  let d = &types.defs[usize.from(t)];
  if d.kind == T_HANDLE || d.kind == T_LIST { return true; }
  if d.kind == T_TUPLE {
    var i = 0usize;
    while i < d.items.len() { if needsInit(types, *d.items[i]) { return true; } i = i + 1usize; }
  }
  false
}

// The most slots a unit's locals, or its operand stack, may take. Every slot count is kept far below u32's range, so
// no sum of them can wrap and put a local or an operand outside its frame.
const MAX_FRAME_SLOTS = 1048576u32;

// The slots of a list of types, never more than MAX_FRAME_SLOTS + 1 (a count that large is refused where it is used)
fn slotsOfList(slots: &List[u32], ts: &List[u32]) u32 {
  var n = 0u64;
  var i = 0usize;
  while i < ts.len() {
    n = n + u64.from(*slots[usize.from(*ts[i])]);
    if n > u64.from(MAX_FRAME_SLOTS) { return MAX_FRAME_SLOTS + 1u32; }
    i = i + 1usize;
  }
  u32.from(n)
}

// What the pass found out about a unit
struct UnitFacts {
  callees: List[u32];
  imports: List[u32];     // every import it uses directly
}

// Checks one unit. The unit's signature and locals have been checked already. On a mistake, says so in 'problems'.
fn checkUnit[V](code: &Code, canon: &List[u32], slots: &List[u32], imps: &List[ResolvedImport], tables: &ImportTables[V],
             ui: usize, info: &mut UnitInfo, facts: &mut UnitFacts, problems: &mut List[CodeProblem]) {
  let u = &code.units[ui];
  let cb = u.code.view();
  let sig = &code.types.defs[usize.from(u.sig)];

  // The locals: the parameters, then the unit's own
  var localTy = List[u32]();
  var i = 0usize;
  while i < sig.items.len() { localTy.push(*canon[usize.from(*sig.items[i])]); i = i + 1usize; }
  i = 0usize;
  while i < u.locals.len() { localTy.push(*canon[usize.from(*u.locals[i])]); i = i + 1usize; }
  var off = 0u32;
  i = 0usize;
  while i < localTy.len() {
    let n = *slots[usize.from(*localTy[i])];
    if u64.from(off) + u64.from(n) > u64.from(MAX_FRAME_SLOTS) {
      problems.push(CodeProblem(u32.from(ui), 0u32, String.from("the frame is too large (its locals take too many slots)")));
      return;
    }
    info.localOff.push(off);
    info.localLen.push(n);
    off = off + n;
    i = i + 1usize;
  }
  info.localSlots = off;
  var results = List[u32]();
  i = 0usize;
  while i < sig.results.len() { results.push(*canon[usize.from(*sig.results[i])]); i = i + 1usize; }
  info.paramSlots = slotsOfList(slots, &code.types.defs[usize.from(u.sig)].items);
  info.resultSlots = slotsOfList(slots, &code.types.defs[usize.from(u.sig)].results);

  var assigned = List[bool]();
  i = 0usize;
  while i < localTy.len() {
    assigned.push(i < sig.items.len() || !needsInit(&code.types, *localTy[i]));
    i = i + 1usize;
  }

  var ps = Pass(List[u32](), 0u32, 0u32, List[Ctrl](), assigned.clone(), slots.clone(), false, String(), 0u32,
                List[u32](), List[u32](), List[u32]());
  i = 0usize;
  while i <= cb.len { ps.tgt.push(0u32); ps.keep.push(0u32); ps.drop.push(0u32); i = i + 1usize; }
  ps.ctrls.push(newCtrl(0u8, results.clone(), info.resultSlots, 0usize, 0u32, &assigned));

  var pos = 0usize;
  var finished = false;
  while pos < cb.len && !ps.failed && !finished {
    let at = pos;
    ps.at = u32.from(at);
    let op = cb[pos];
    pos = pos + 1usize;
    let s = simple(op);
    if s.n > 0u32 {
      var k = 0u32;
      while k < s.n { ps.pop(s.arg); k = k + 1u32; }
      ps.push(s.res);
      continue;
    }
    match op {
      case OP_UNREACHABLE { ps.markUnreachable(); }
      case OP_BLOCK {
        let bt = ps.immed(cb, &mut pos);
        if !ps.failed { enterBlock(&mut ps, code, canon, slots, bt, 1u8, u32.from(pos)); }
      }
      case OP_LOOP {
        let bt = ps.immed(cb, &mut pos);
        if !ps.failed { enterBlock(&mut ps, code, canon, slots, bt, 2u8, u32.from(pos)); }
      }
      case OP_IF {
        let bt = ps.immed(cb, &mut pos);
        if !ps.failed {
          ps.pop(TY_BOOL);
          enterBlock(&mut ps, code, canon, slots, bt, 3u8, u32.from(pos));
          let top = ps.ctrls.len() - 1usize;
          (&mut ps.ctrls[top]).ifOff = u32.from(at);
        }
      }
      case OP_ELSE {
        let top = ps.ctrls.len() - 1usize;
        if ps.ctrls[top].kind != 3u8 { ps.fail("else outside an if, or a second else"); }
        else {
          ps.closeValues();
          ps.tgt.set(usize.from(ps.ctrls[top].ifOff), u32.from(at) + 1u32);
          (&mut ps.ctrls[top]).kind = 4u8;
          (&mut ps.ctrls[top]).elseOff = u32.from(at);
          (&mut ps.ctrls[top]).fix.push(u32.from(at));
          (&mut ps.ctrls[top]).thenState = ps.assigned.clone();
          ps.assigned = ps.ctrls[top].snap.clone();
          ps.vals.truncate(ps.ctrls[top].base);
          ps.h = ps.ctrls[top].baseH;
          (&mut ps.ctrls[top]).unreachable = false;
        }
      }
      case OP_END {
        let top = ps.ctrls.len() - 1usize;
        if ps.ctrls[top].kind == 3u8 && ps.ctrls[top].results.len() > 0usize { ps.fail("an if with results needs an else"); }
        else {
          ps.closeValues();
          if !ps.failed {
            let c = ps.ctrls.pop().unwrap();
            let here = u32.from(at);
            var j = 0usize;
            while j < c.fix.len() { ps.tgt.set(usize.from(*c.fix[j]), here); j = j + 1usize; }
            if c.kind == 3u8 { ps.tgt.set(usize.from(c.ifOff), here); }
            // What is assigned after it: on every way in
            var a = ps.assigned.clone();
            if c.kind == 4u8 { andInto(&mut a, &c.thenState); }
            if c.kind == 3u8 { andInto(&mut a, &c.snap); }
            if c.hasMerged { andInto(&mut a, &c.merged); }
            ps.assigned = a;
            if ps.ctrls.len() == 0usize { finished = true; }
            else {
              var j2 = 0usize;
              while j2 < c.results.len() { ps.push(*c.results[j2]); j2 = j2 + 1usize; }
            }
          }
        }
      }
      case OP_BR {
        let d = ps.immed(cb, &mut pos);
        if !ps.failed {
          if usize.from(d) >= ps.ctrls.len() { ps.fail("a branch depth out of range"); }
          else { ps.branch(d); ps.labelPop(d); ps.markUnreachable(); }
        }
      }
      case OP_BR_IF {
        let d = ps.immed(cb, &mut pos);
        if !ps.failed {
          if usize.from(d) >= ps.ctrls.len() { ps.fail("a branch depth out of range"); }
          else {
            ps.pop(TY_BOOL);
            ps.branch(d);
            ps.labelPop(d);
            ps.labelPush(d);
          }
        }
      }
      case OP_RETURN {
        let d = u32.from(ps.ctrls.len() - 1usize);
        ps.branch(d);
        ps.labelPop(d);
        ps.markUnreachable();
      }
      case OP_LOCAL_GET {
        let l = ps.immed(cb, &mut pos);
        if !ps.failed {
          if usize.from(l) >= localTy.len() { ps.fail("a local out of range"); }
          else if !*ps.assigned[usize.from(l)] { ps.fail("a handle or list local is read before it is set"); }
          else { ps.push(*localTy[usize.from(l)]); }
        }
      }
      case OP_LOCAL_SET {
        let l = ps.immed(cb, &mut pos);
        if !ps.failed {
          if usize.from(l) >= localTy.len() { ps.fail("a local out of range"); }
          else { ps.pop(*localTy[usize.from(l)]); ps.assigned.set(usize.from(l), true); }
        }
      }
      case OP_LOCAL_TEE {
        let l = ps.immed(cb, &mut pos);
        if !ps.failed {
          if usize.from(l) >= localTy.len() { ps.fail("a local out of range"); }
          else { ps.pop(*localTy[usize.from(l)]); ps.push(*localTy[usize.from(l)]); ps.assigned.set(usize.from(l), true); }
        }
      }
      case OP_F64_CONST {
        if pos + 8usize > cb.len { ps.fail("a cut-short f64 constant"); } else { pos = pos + 8usize; ps.push(TY_F64); }
      }
      case OP_I64_CONST {
        var bad = false;
        getS(cb, &mut pos, cb.len, &mut bad);
        if bad { ps.fail("a cut-short i64 constant"); } else { ps.push(TY_I64); }
      }
      case OP_BOOL_CONST {
        if pos >= cb.len || cb[pos] > 1u8 { ps.fail("a bool constant must be 0 or 1"); } else { pos = pos + 1usize; ps.push(TY_BOOL); }
      }
      case OP_PART_CONST {
        ps.immed(cb, &mut pos);
        if !ps.failed { ps.push(TY_PART); }
      }
      case OP_TUPLE_MAKE {
        let t = ps.immed(cb, &mut pos);
        if !ps.failed {
          if usize.from(t) >= code.types.defs.len() || code.types.defs[usize.from(t)].kind != T_TUPLE { ps.fail("tuple.make needs a tuple type"); }
          else {
            let d = &code.types.defs[usize.from(t)];
            var j = d.items.len();
            while j > 0usize { j = j - 1usize; ps.pop(*canon[usize.from(*d.items[j])]); }
            ps.push(*canon[usize.from(t)]);
          }
        }
      }
      case OP_TUPLE_GET {
        let t = ps.immed(cb, &mut pos);
        let f = ps.immed(cb, &mut pos);
        if !ps.failed {
          if usize.from(t) >= code.types.defs.len() || code.types.defs[usize.from(t)].kind != T_TUPLE { ps.fail("tuple.get needs a tuple type"); }
          else if usize.from(f) >= code.types.defs[usize.from(t)].items.len() { ps.fail("a tuple field out of range"); }
          else {
            ps.pop(*canon[usize.from(t)]);
            ps.push(*canon[usize.from(*code.types.defs[usize.from(t)].items[usize.from(f)])]);
          }
        }
      }
      case OP_LIST_MAKE {
        let t = ps.immed(cb, &mut pos);
        let n = ps.immed(cb, &mut pos);
        if !ps.failed {
          if usize.from(t) >= code.types.defs.len() || code.types.defs[usize.from(t)].kind != T_LIST { ps.fail("list.make needs a list type"); }
          else if n > 65535u32 { ps.fail("list.make with too many items"); }
          else {
            let elem = *canon[usize.from(code.types.defs[usize.from(t)].arg)];
            var j = 0u32;
            while j < n { ps.pop(elem); j = j + 1u32; }
            ps.push(*canon[usize.from(t)]);
          }
        }
      }
      case OP_SELECT {
        let t = ps.immed(cb, &mut pos);
        if !ps.failed {
          if usize.from(t) >= code.types.defs.len() || !isValue(code.types.defs[usize.from(t)].kind) { ps.fail("select needs a value type"); }
          else {
            let ct = *canon[usize.from(t)];
            ps.pop(TY_BOOL); ps.pop(ct); ps.pop(ct); ps.push(ct);
          }
        }
      }
      case OP_DROP {
        let t = ps.immed(cb, &mut pos);
        if !ps.failed {
          if usize.from(t) >= code.types.defs.len() || !isValue(code.types.defs[usize.from(t)].kind) { ps.fail("drop needs a value type"); }
          else { ps.pop(*canon[usize.from(t)]); }
        }
      }
      case OP_CALL {
        let c = ps.immed(cb, &mut pos);
        if !ps.failed {
          if usize.from(c) >= code.units.len() { ps.fail("a call to a unit that does not exist"); }
          else if usize.from(code.units[usize.from(c)].sig) >= code.types.defs.len()
                  || code.types.defs[usize.from(code.units[usize.from(c)].sig)].kind != T_SIG { ps.fail("a call to a unit whose type is not a signature"); }
          else {
            facts.callees.push(c);
            let cs = &code.types.defs[usize.from(code.units[usize.from(c)].sig)];
            var j = cs.items.len();
            while j > 0usize { j = j - 1usize; ps.pop(*canon[usize.from(*cs.items[j])]); }
            j = 0usize;
            while j < cs.results.len() { ps.push(*canon[usize.from(*cs.results[j])]); j = j + 1usize; }
          }
        }
      }
      case OP_IMPORT {
        let k = ps.immed(cb, &mut pos);
        if !ps.failed {
          if usize.from(k) >= code.imports.len() { ps.fail("an import that does not exist"); }
          else if imps[usize.from(k)].why.len() > 0usize { ps.fail(imps[usize.from(k)].why.view()); }
          else {
            facts.imports.push(k);
            let cs = &code.types.defs[usize.from(code.imports[usize.from(k)].sig)];
            var j = cs.items.len();
            while j > 0usize { j = j - 1usize; ps.pop(*canon[usize.from(*cs.items[j])]); }
            // The call writes its results over its arguments, so the window is the larger of the two
            let r = &imps[usize.from(k)];
            if ps.h + r.resultSlots > ps.maxH { ps.maxH = ps.h + r.resultSlots; }            j = 0usize;
            while j < cs.results.len() { ps.push(*canon[usize.from(*cs.results[j])]); j = j + 1usize; }
          }
        }
      }
      else { ps.fail("an unknown op"); }
    }
  }
  if !ps.failed && !finished { ps.fail("the code does not end with the function's end"); }
  if !ps.failed && pos != cb.len { ps.fail("code after the function's end"); }
  if ps.failed {
    problems.push(CodeProblem(u32.from(ui), ps.at, ps.why.clone()));
    return;
  }
  info.maxDepth = ps.maxH;
  info.tgt = ps.tgt.clone();
  info.keep = ps.keep.clone();
  info.drop = ps.drop.clone();
}

// Whether an entry's unit has the signature its kind needs: derive () -> f64, handler () -> (), fixed () -> one result.
// The unit's signature has been checked already (a unit whose is not one is refused before this).
fn entryShapeOk(code: &Code, canon: &List[u32], e: &EntryDecl) bool {
  let s = &code.types.defs[usize.from(code.units[usize.from(e.unit)].sig)];
  if s.items.len() != 0usize { return false; }
  if e.kind == ENTRY_HANDLER { return s.results.len() == 0usize; }
  if s.results.len() != 1usize { return false; }
  if e.kind == ENTRY_DERIVE { return *canon[usize.from(*s.results[0usize])] == TY_F64; }
  true
}

fn andInto(a: &mut List[bool], b: &List[bool]) {
  var i = 0usize;
  while i < a.len() { if !*b[i] { a.set(i, false); } i = i + 1usize; }
}

// Pushes a block, loop or if, whose result types come from the signature type 'bt' (which has no parameters)
fn enterBlock(ps: &mut Pass, code: &Code, canon: &List[u32], slots: &List[u32], bt: u32, kind: u8, bodyAt: u32) {
  if usize.from(bt) >= code.types.defs.len() || code.types.defs[usize.from(bt)].kind != T_SIG || code.types.defs[usize.from(bt)].items.len() != 0usize {
    ps.fail("a block type must be a signature without parameters");
    return;
  }
  var results = List[u32]();
  let d = &code.types.defs[usize.from(bt)];
  var i = 0usize;
  while i < d.results.len() { results.push(*canon[usize.from(*d.results[i])]); i = i + 1usize; }
  let rs = slotsOfList(slots, &results);
  let a = ps.assigned.clone();
  var c = newCtrl(kind, results, rs, ps.vals.len(), ps.h, &a);
  c.loopTarget = bodyAt;
  ps.ctrls.push(c);
}

// ---- the whole verification ----

// Checks code against the imports a host offers, one unit at a time (ConeScript is resilient). A unit that is wrong
// is refused, with one CodeProblem naming the unit and the op's offset, and so is a unit that calls it; every
// other unit is checked and kept. Only a fault in the container's shared tables (its version, its types) is an Err.
// The VerifiedCode holds the side tables the interpreter reads, 'isRefused' and 'problems'.
pub fn verifyEach[V](code: &Code, tables: &ImportTables[V]) Result[VerifiedCode, List[CodeProblem]] {
  var problems = List[CodeProblem]();
  if code.major != FORM_MAJOR {
    problems.push(problemAt(NO_UNIT, 0u32, "the form's major version is not one this verifier knows"));
    return Err[VerifiedCode, List[CodeProblem]](problems);
  }
  var canon = List[u32]();
  var slots = List[u32]();
  analyzeTypes(&code.types, &mut canon, &mut slots, &mut problems);
  if problems.len() > 0usize { return Err[VerifiedCode, List[CodeProblem]](problems); }

  // Imports: each must be offered, with the same signature
  var imps = List[ResolvedImport]();
  var i = 0usize;
  while i < code.imports.len() {
    let m = &code.imports[i];
    var found = false;
    if usize.from(m.sig) >= code.types.defs.len() || code.types.defs[usize.from(m.sig)].kind != T_SIG {
      imps.push(ResolvedImport(0u32, 0u32, 0u32, 1u32, String.from("an import whose type is not a signature")));
    } else {
      var k = 0usize;
      var ri = ResolvedImport(0u32, 0u32, 0u32, 1u32, String());
      while k < tables.entries.len() && !found {
        let e = &tables.entries[k];
        if e.ns == m.ns && e.name == m.name {
          found = true;
          if sameType(&code.types, m.sig, &tables.types, e.sig) {
            ri = ResolvedImport(u32.from(k), slotsOfList(&slots, &code.types.defs[usize.from(m.sig)].items),
                                slotsOfList(&slots, &code.types.defs[usize.from(m.sig)].results), if e.weight == 0u32 { 1u32 } else { e.weight }, String());
          } else {
            var w = String.from("the import ");
            w.append(m.ns.view()); w.append("."); w.append(m.name.view()); w.append(" has a different signature from the host's");
            ri.why = w;
          }
        }
        k = k + 1usize;
      }
      if !found {
        var w = String.from("the import ");
        w.append(m.ns.view()); w.append("."); w.append(m.name.view()); w.append(" is not offered by the host");
        ri.why = w;
      }
      imps.push(ri);
    }
    i = i + 1usize;
  }

  // A bad import is not fatal: a unit that uses one is refused (see OP_IMPORT), and the rest go on

  // Units, each checked alone: a unit that is wrong is refused and the others go on. (A call reads the callee's
  // signature, so OP_CALL checks it is one.)
  var infos = List[UnitInfo]();
  var allFacts = List[UnitFacts]();
  var refused = List[bool]();
  i = 0usize;
  while i < code.units.len() {
    let u = &code.units[i];
    let problemsBefore = problems.len();
    var info = UnitInfo(List[u32](), List[u32](), List[u32](), 0u32, List[u32](), List[u32](), 0u32, 0u32, 0u32);
    var facts = UnitFacts(List[u32](), List[u32]());
    var ok = true;
    if usize.from(u.sig) >= code.types.defs.len() || code.types.defs[usize.from(u.sig)].kind != T_SIG {
      problems.push(CodeProblem(u32.from(i), 0u32, String.from("the unit's type is not a signature")));
      ok = false;
    }
    if ok {
      var j = 0usize;
      while j < u.locals.len() {
        if usize.from(*u.locals[j]) >= code.types.defs.len() || !isValue(code.types.defs[usize.from(*u.locals[j])].kind) {
          problems.push(CodeProblem(u32.from(i), 0u32, String.from("a local's type is not a value type")));
          ok = false;
        }
        j = j + 1usize;
      }
    }
    if ok { checkUnit(code, &canon, &slots, &imps, tables, i, &mut info, &mut facts, &mut problems); }
    infos.push(info);
    allFacts.push(facts);
    refused.push(problems.len() > problemsBefore);
    i = i + 1usize;
  }

  // Entries, and the second wall: a fixed or derive unit may not reach an acting import, directly or by call
  var reach = List[bool]();
  i = 0usize;
  while i < code.units.len() {
    var acts = false;
    var j = 0usize;
    while j < allFacts[i].imports.len() {
      let k = usize.from(*allFacts[i].imports[j]);
      if k < imps.len() && tables.entries[usize.from(imps[k].table)].acting { acts = true; }
      j = j + 1usize;
    }
    reach.push(acts);
    i = i + 1usize;
  }
  var changed = true;
  while changed {
    changed = false;
    i = 0usize;
    while i < code.units.len() {
      if !*reach[i] {
        var j = 0usize;
        while j < allFacts[i].callees.len() {
          if *reach[usize.from(*allFacts[i].callees[j])] { reach.set(i, true); changed = true; break; }
          j = j + 1usize;
        }
      }
      i = i + 1usize;
    }
  }
  i = 0usize;
  while i < code.entries.len() {
    let e = &code.entries[i];
    if usize.from(e.unit) >= code.units.len() { problems.push(CodeProblem(NO_UNIT, u32.from(i), String.from("an entry names a unit that does not exist"))); }
    else if e.kind > ENTRY_HANDLER { problems.push(CodeProblem(e.unit, 0u32, String.from("an entry of unknown kind"))); refused.set(usize.from(e.unit), true); }
    else if !*refused[usize.from(e.unit)] && !entryShapeOk(code, &canon, e) {
      problems.push(CodeProblem(e.unit, 0u32, String.from("an entry's unit has the wrong signature for its kind (derive () -> f64, handler () -> (), fixed no parameters and one result)")));
      refused.set(usize.from(e.unit), true);
    }
    else if e.kind != ENTRY_HANDLER && *reach[usize.from(e.unit)] && !*refused[usize.from(e.unit)] {
      problems.push(CodeProblem(e.unit, 0u32, String.from("a fixed or derive unit reaches an acting import")));
      refused.set(usize.from(e.unit), true);
    }
    i = i + 1usize;
  }

  // A unit that calls a refused one is refused too, with no line of its own: the cause is already told
  changed = true;
  while changed {
    changed = false;
    i = 0usize;
    while i < code.units.len() {
      if !*refused[i] {
        var j = 0usize;
        while j < allFacts[i].callees.len() {
          if *refused[usize.from(*allFacts[i].callees[j])] { refused.set(i, true); changed = true; break; }
          j = j + 1usize;
        }
      }
      i = i + 1usize;
    }
  }
  Ok[VerifiedCode, List[CodeProblem]](VerifiedCode(cloneCode(code), slots, infos, imps, refused, problems))
}

// The strict form: any problem refuses the whole code. For a caller that has nothing to do with part of it.
pub fn verify[V](code: &Code, tables: &ImportTables[V]) Result[VerifiedCode, List[CodeProblem]] {
  match verifyEach(code, tables) {
    case let Ok(v) {
      if v.found.len() > 0usize {
        var ps = List[CodeProblem]();
        var i = 0usize;
        while i < v.found.len() { ps.push(CodeProblem(v.found[i].unit, v.found[i].offset, v.found[i].what.clone())); i = i + 1usize; }
        Err[VerifiedCode, List[CodeProblem]](ps)
      }
      else { Ok[VerifiedCode, List[CodeProblem]](v) }
    }
    case let Err(ps) { Err[VerifiedCode, List[CodeProblem]](ps) }
  }
}
