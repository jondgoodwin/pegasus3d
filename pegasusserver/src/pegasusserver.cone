// pegasus-server: the program that runs a shared world (`pegasus\doc\actors\server.md`). It is Sim in the server role, a
// Loader that builds only what Sim needs (the world image, the Sim units, the collision and pick shapes), and the network.
// It has no Render, Player, Audio, window, XR or GPU of its own: the Sim and the Loader are `pegasuscore`'s, the same code
// the browser runs, and they send to a stand-in that takes everything and does nothing.
//
//   pegasus-server --port PORT --world FILE [--steps N] [--loopback] [--until-empty] [--impair LOSS LATENCY JITTER]
//                              serves FILE on UDP PORT (0: the system chooses); --impair puts a lossy relay in front (loss per
//                              1000, ms, ms) and prints the relay's port; --until-empty ends it once a client has joined and
//                              none is left; --steps N ends it after N steps
//   pegasus-server --checks    the driven checks of the shared code (connected play, rules, picking, blend, cache, fetch)
//
// (The executable is named `pegasusserver` by its package; build.ps1 copies it to pegasus-server.)

mod pegasusserver;

import stdio use *;
import libc;
import collections use *;
import geomath use *;
import actors;
import sync use Channel, Sender, Receiver;
import pegasuscore use *;

// Takes what Sim and the Loader send to a display and a sound, and drops it: a server draws and plays nothing
actor Mute {
  taken: u64;                       // (an actor holds a field; the stand-in counts nothing of use)

  fn init(self: &new) { *self = Self(0u64); }
  pub async fn snapshot(self, s: Published) {}
  pub async fn content(self, c: MeshContent) {}
  pub async fn material(self, c: MaterialContent) {}
  pub async fn release(self, key: ContentKey) {}
  pub async fn partsAwaited(self, n: usize) {}
  pub async fn stop(self) {}
}

fn main(argc: i32, argv: **u8) i32 {
  initAll();
  var steps = 0u64;
  var checksOnly = false;
  var worldFile = String();
  var netStart = NetStart.whole();
  netStart.role = SIM_SERVER;
  var a = 1;
  while a < argc {
    let arg = *(argv + usize.from(a));
    if argIs(arg, "--steps") && a + 1 < argc {
      steps = argNumber(*(argv + usize.from(a + 1)));
      a = a + 1;
    } else if argIs(arg, "--checks") {
      checksOnly = true;
    } else if argIs(arg, "--world") && a + 1 < argc {
      worldFile = argString(*(argv + usize.from(a + 1)));
      a = a + 1;
    } else if argIs(arg, "--port") && a + 1 < argc {
      netStart.port = u32.from(argNumber(*(argv + usize.from(a + 1))));
      a = a + 1;
    } else if argIs(arg, "--loopback") {
      netStart.loopback = true;
    } else if argIs(arg, "--until-empty") {
      netStart.untilEmpty = true;
    } else if argIs(arg, "--impair") && a + 3 < argc {
      netStart.impairLoss = u32.from(argNumber(*(argv + usize.from(a + 1))));
      netStart.impairLatency = u32.from(argNumber(*(argv + usize.from(a + 2))));
      netStart.impairJitter = u32.from(argNumber(*(argv + usize.from(a + 3))));
      a = a + 3;
    } else {
      print <- "pegasus-server: unknown argument; use --port PORT --world FILE [--steps N] [--loopback] [--until-empty] [--impair LOSS LATENCY JITTER] or --checks\n";
      return 2;
    }
    a = a + 1;
  }
  if checksOnly {
    let ok = checkShared();
    finalAll();
    return if ok { 0 } else { 1 };
  }
  if worldFile.len() == 0usize { print <- "pegasus-server: --world FILE is needed\n"; return 2; }

  // How many keys the world makes (the Loader reads it again when it opens it); a server's Sim asks for no materials.
  // A world at an address is not fetched here (the Loader does), so its keys are not counted
  var keys = 0usize;
  if !isUrl(worldFile.view()) {
    let text = readWorldNow(worldFile.view());
    if text.len() == 0usize { print <- "pegasus-server: "; printStr(worldFile.view()); print <- " cannot be read\n"; return 1; }
    let img = readImage(worldFile.view(), text.view());
    keys = distinctKeys(&img);
  }

  // The latest values Sim reads of a person at a keyboard: a server has none, so they stay as they began
  var moveW: StateWriter[MoveIntent];
  var moveR: StateReader[MoveIntent];
  moveW, moveR = stateSlot[MoveIntent](MoveIntent(0., 0.));
  var lookW: StateWriter[LookIntent];
  var lookR: StateReader[LookIntent];
  lookW, lookR = stateSlot[LookIntent](LookIntent(0., -0.15));
  var drawnW: StateWriter[DrawnFrame];
  var drawnR: StateReader[DrawnFrame];
  drawnW, drawnR = stateSlot[DrawnFrame](DrawnFrame(0u64, 0u64, 0u64, Vec3(0., EYE_HEIGHT, 0.), 0., 0., 0u64));
  var finishedS: Sender[i32];
  var finishedR: Receiver[i32];
  finishedS, finishedR = Channel[i32].make();
  var loaderS: Sender[bool];
  var loaderR: Receiver[bool];
  loaderS, loaderR = Channel[bool].make();

  var verdict = 0;
  {
    let mute = Mute();
    let loader = Loader(mute, loaderS, u64.from(keys), false, mutantIs("unused-off-by-one"), true);
    let sim = Sim(SIM_SERVER, mute, mute, loader, SimStart(moveR, lookR, drawnR, steps, 0u64, 0u64, finishedS, netStart), mutantIs("mutate-snapshot"));
    sim.run();
    loader.openWorld(worldFile.clone(), sim);
    match finishedR.recv() {
      case let Some(v) { verdict = v; }
      case is None[i32] { verdict = 1; }
    }
    sim.stop();
    match loaderR.recv() {
      case let Some(clean) { if !clean { verdict = 1; } }
      case is None[bool] {}
    }
  }
  finalAll();
  print <- "pegasus-server: "; if verdict == 0 { print <- "ok\n"; } else { print <- "FAILED\n"; }
  verdict
}
