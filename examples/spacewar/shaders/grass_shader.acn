+Shader
	# Grass blades: per-vertex colour, tinted by the world light, swaying in a
	# breeze. The sway grows with height so blade roots stay planted.
	uniforms: +List('lightColor', 'ambient', 'time', 'mvpmatrix')
	attributes: +List('positions', 'colors')
	vertex: "
		#version 130\n
		in vec3 positions;
		in vec4 colors;
		out vec4 vert_color;
		uniform mat4 mvpmatrix;
		uniform float time;
		uniform vec4 lightColor;
		uniform vec4 ambient;
		void main()
		{
			vec3 p = positions;
			float gust = sin(time * 1.4 + p.x * 0.35 + p.z * 0.25) + 0.5 * sin(time * 2.3 + p.z * 0.9);
			p.x += 0.12 * gust * p.y;
			p.z += 0.06 * gust * p.y;
			vert_color = vec4(colors.rgb * (ambient.rgb + 0.6 * lightColor.rgb), colors.a);
			gl_Position = mvpmatrix * vec4(p, 1.0);
		}"
	fragment: "
		#version 130\n
		in vec4 vert_color;
		out vec4 FragColor;
		void main() {
			FragColor = vert_color;
		}"
