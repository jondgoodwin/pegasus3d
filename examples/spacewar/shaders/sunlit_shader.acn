+Shader
	# Matte, sun-lit shading for models that carry no normals.
	# The face normal is derived per fragment from screen-space derivatives of the
	# world position, so the result is faceted. The light is treated as a direction
	# (the sun), not a position. No specular term.
	uniforms: +List('lightOrigin',  # Direction to the sun (its world-space origin, normalized)
					\ 'color',        # The single colour the surface reflects
					\ 'mmatrix', 'mvpmatrix')
	attributes: +List('positions')
	vertex: "
		#version 130\n
		in vec3 positions;
		out vec3 WorldPos;
		uniform mat4 mmatrix;
		uniform mat4 mvpmatrix;
		void main()
		{
			WorldPos = vec3(mmatrix * vec4(positions, 1.0));
			gl_Position = mvpmatrix * vec4(positions, 1.0);
		}"
	fragment: "
		#version 130\n
		in vec3 WorldPos;
		out vec4 FragColor;
		uniform vec3 lightOrigin;
		uniform vec4 color;
		void main() {
			vec3 normal = normalize(cross(dFdx(WorldPos), dFdy(WorldPos)));
			vec3 sundir = normalize(lightOrigin);
			float lit = 0.3 + 0.7 * max(dot(normal, sundir), 0.0);
			FragColor = vec4(color.rgb * lit, color.a);
		}"
