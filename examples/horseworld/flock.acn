# A flock of small flamingos flying as boids: each bird steers by separation,
# alignment and cohesion with its neighbours, plus a pull toward a point ahead of
# it on a ring around the paddock, so the flock keeps circling the pen.
+Group
	origin: +Xyz(0., 0., 0.)
	nbirds: 10
	radius: 9.          # radius of the ring the flock circles
	height: 5.          # cruising height
	speed: 3.           # preferred airspeed
	nearby: 3.          # how far a bird looks for flockmates
	tooclose: 1.2       # closer than this and birds push apart

	# The birds, spread around the ring, each flying along it
	parts: +List
		each i in 0 .. 9
			local a = 2. * Float.pi * i.Float / 10.
			local r = 9. + (i % 3).Float * 0.6
			local h = 5. + (i % 2).Float * 0.5
			local bird = +@flamingo
				origin: +Xyz(r * a.Cos, h, r * a.Sin)
				orientation: +Quat
				velocity: +Xyz(-3. * a.Sin, 0., 3. * a.Cos)
				scale: +Xyz(0.0005, 0.0005, 0.0005)
				modelnbr: i % 14
			<< bird

	animate: [dt]
		local birds = .parts
		local last = .nbirds - 1
		each i in 0 .. last
			local bird = birds[i]
			local center = +Xyz(0., 0., 0.)
			local heading = +Xyz(0., 0., 0.)
			local push = +Xyz(0., 0., 0.)
			local n = 0
			each j in 0 .. last
				local other = birds[j]
				local d = bird.origin.Distance(other.origin)
				if d > 0.01 and d < .nearby
					center.Add(other.origin)
					heading.Add(other.velocity)
					n = n + 1
					if d < .tooclose
						# Push away from the neighbour, harder the closer it is
						push.Add(bird.origin - other.origin, (.tooclose - d) / d)
			local accel = +Xyz(0., 0., 0.)
			if n > 0
				center.Scale(1. / n.Float)
				accel.Add(center - bird.origin, 0.5)       # cohesion
				heading.Scale(1. / n.Float)
				accel.Add(heading - bird.velocity, 0.5)   # alignment
				accel.Add(push, 2.)                       # separation
			# Steer toward a point a little way ahead on the ring
			local a = bird.origin.z.Atan2(bird.origin.x) + 0.6
			local target = +Xyz(.radius * a.Cos, .height, .radius * a.Sin)
			accel.Add(target - bird.origin, 0.8)
			bird.velocity.Add(accel, dt)
			# Keep the airspeed within bounds of the preferred speed
			local sp = bird.velocity.Length
			if sp > .speed * 1.3
				bird.velocity.Scale(.speed * 1.3 / sp)
			if sp < .speed * 0.6
				bird.velocity.Scale(.speed * 0.6 / sp)
			bird.origin.Add(bird.velocity, dt)
			# Face along the velocity: yaw from x and z, pitch from the climb
			local v = bird.velocity
			local yaw = v.x.Atan2(v.z)
			local pitch = 0. - (v.y / v.Length).Asin
			bird.orientation.SetRotateYxz(pitch, yaw, 0.)
			bird.flap(dt)
