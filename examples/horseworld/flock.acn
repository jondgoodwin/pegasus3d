# A flock of small flamingos flying as boids. Each bird steers by separation,
# alignment and cohesion with its neighbours, wanders a little on its own, and
# the whole flock is drawn toward a point ahead of its centre on a ring around
# the paddock, so the group keeps circling the pen while jostling within itself.
+Group
	origin: +Xyz(0., 0., 0.)
	nbirds: 10
	radius: 9.          # radius of the ring the flock circles
	height: 5.          # cruising height
	speed: 3.           # preferred airspeed
	nearby: 4.          # how far a bird looks for flockmates
	tooclose: 1.        # closer than this and birds push apart
	time: 0.            # elapsed time, drives each bird's wander

	# The birds start as a loose cluster on the ring, all flying along it
	parts: +List
		each i in 0 .. 9
			local a = i.Float * 0.12
			local r = 8. + (i % 3).Float * 0.9
			local h = 4.5 + (i % 4).Float * 0.4
			local bird = +@flamingo
				origin: +Xyz(r * a.Cos, h, r * a.Sin)
				orientation: +Quat
				velocity: +Xyz(-3. * a.Sin, 0., 3. * a.Cos)
				scale: +Xyz(0.0005, 0.0005, 0.0005)
				modelnbr: i % 14
				phase: i.Float * 0.7
			<< bird

	animate: [dt]
		local birds = .parts
		local last = .nbirds - 1
		.time = .time + dt
		local t = .time

		# Where the flock is, and where on the ring it should head next
		local middle = +Xyz(0., 0., 0.)
		each i in 0 .. last
			middle.Add(birds[i].origin)
		middle.Scale(1. / .nbirds.Float)
		local a = middle.z.Atan2(middle.x) + 0.4
		local target = +Xyz(.radius * a.Cos, .height, .radius * a.Sin)

		each i in 0 .. last
			local bird = birds[i]
			local center = +Xyz(0., 0., 0.)
			local heading = +Xyz(0., 0., 0.)
			local push = +Xyz(0., 0., 0.)
			local n = 0
			each j in 0 .. last
				local other = birds[j]
				local d = bird.origin.Distance(other.origin)
				if d > 0.01 and d < .nearby
					center.Add(other.origin)
					heading.Add(other.velocity)
					n = n + 1
					if d < .tooclose
						# Push away from the neighbour, harder the closer it is
						push.Add(bird.origin - other.origin, (.tooclose - d) / d)
			local accel = +Xyz(0., 0., 0.)
			if n > 0
				center.Scale(1. / n.Float)
				accel.Add(center - bird.origin, 0.6)       # cohesion
				heading.Scale(1. / n.Float)
				accel.Add(heading - bird.velocity, 0.8)   # alignment
				accel.Add(push, 3.)                       # separation
			# The flock's shared goal on the ring, and each bird's own wander
			accel.Add(target - bird.origin, 0.9)
			local p = bird.phase
			accel.Add((t * 1.3 + p).Sin, 0.5 * (t * 0.9 + p).Cos, (t * 1.1 + p).Cos)
			bird.velocity.Add(accel, dt)
			# Keep the airspeed within bounds of the preferred speed
			local sp = bird.velocity.Length
			if sp > .speed * 1.3
				bird.velocity.Scale(.speed * 1.3 / sp)
			if sp < .speed * 0.7
				bird.velocity.Scale(.speed * 0.7 / sp)
			bird.origin.Add(bird.velocity, dt)
			# Face along the velocity: yaw from x and z, pitch from the climb
			local v = bird.velocity
			local yaw = v.x.Atan2(v.z)
			local pitch = 0. - (v.y / v.Length).Asin
			bird.orientation.SetRotateYxz(pitch, yaw, 0.)
			bird.flap(dt)
