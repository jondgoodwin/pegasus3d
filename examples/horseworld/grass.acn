# A meadow of grass tufts, generated at load. Each tuft is a few tall thin
# triangles leaning out from a common root, with the tuft's own shade of green
# and the blade tips lighter than the base. The tufts are scattered at random
# over the middle of the ground plane, densest near the paddock.
+Shape
	shader: @shaders/grass_shader
	time: 0.
	seed: 20260906
	ntufts: 16000
	positions: +Xyzs(16000 * 4 * 3)
	colors: +Colors(16000 * 4 * 3)
	Rand: []
		seed: (.seed * 1103515245 + 12345) % 2147483648
		.seed.Float / 2147483648.
	Vert: [x, y, z, r, g, b]
		.positions << x
		.positions << y
		.positions << z
		.colors << r
		.colors << g
		.colors << b
		.colors << 1.
	each tuft in 1 .. .ntufts
		# Radius drawn so tufts thin out with distance from the paddock
		local rad = 30. * .Rand.Sqrt
		local ang = 6.2832 * .Rand
		local cx = rad * ang.Cos
		local cz = rad * ang.Sin - 3.
		# This tuft's shade: mostly green, some yellower, some darker
		local tone = .Rand
		local r0 = 0.16 + 0.16 * tone
		local g0 = 0.34 + 0.10 * .Rand
		local b0 = 0.06 + 0.06 * .Rand
		local tall = 0.35 + 0.45 * .Rand
		each blade in 1 .. 4
			local dir = 6.2832 * .Rand
			local dx = dir.Cos
			local dz = dir.Sin
			local lean = 0.05 + 0.25 * .Rand
			local h = tall * (0.6 + 0.4 * .Rand)
			local w = 0.02 + 0.02 * .Rand
			local tip = 1.5 + 0.4 * .Rand
			.Vert(cx - w * dz, 0., cz + w * dx, r0, g0, b0)
			.Vert(cx + w * dz, 0., cz - w * dx, r0, g0, b0)
			.Vert(cx + lean * dx, h, cz + lean * dz, r0 * tip, g0 * tip, b0 * tip)
