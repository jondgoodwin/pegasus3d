# Spacewar, two players: two ships circle a star in the same plane, pulled by
# its gravity, and try to shoot each other down with missiles.
#
# Player one, left hand:  A and D turn, W thrusts, S fires.
# Player two, keypad:     4 and 6 turn, 8 thrusts, 5 fires.
# Escape quits. Each player has five lives, shown as dots at the top of the map.
#
# The window shows each player's cockpit view across the top and a map of the
# whole arena, looking straight down, across the bottom.
$ = +World
	gm: 480.                     # strength of the star's gravity
	sunradius: 2.
	missilespeed: 14.            # launch speed relative to the ship
	missilelife: 5.
	hitradius: 2.5

	# Each ship starts 30 out from the star in a circular orbit (speed 4 at
	# gm 480), nose along its orbit, on opposite sides going opposite ways
	local ship1 = +@ship
		origin: +Xyz(-30., 0., 0.)
		orientation: +Quat.SetAngleAxis(Float.pi, 0., 1., 0.)
		velocity: +Xyz(0., 0., 4.)
		heading: Float.pi
		diffuse: +Color(1., 0.55, 0.45, 1.)
		startx: -30.
		startz: 0.
		starth: Float.pi
		startvz: 4.
		markers: +List
	local ship2 = +@ship
		origin: +Xyz(30., 0., 0.)
		orientation: +Quat
		velocity: +Xyz(0., 0., -4.)
		heading: 0.
		diffuse: +Color(0.5, 0.7, 1., 1.)
		startx: 30.
		startz: 0.
		starth: 0.
		startvz: -4.
		markers: +List

	local light = +Light
		origin: +Xyz(-3.5, 5.5, 10.0)
		ambient: +Color(0.45, 0.45, 0.5, 1.0)
		lightColor: +Color(1.0, 0.95, 0.85, 1.0)
	local skybox = Shape.NewSphere(499.0, 20)
		origin: +Xyz(0., 0., 0.)
		diffuse: +Color(0.5882, 0.5882, 0.5882, 1.0)
		tex: +Texture
			image: @tycho_cyl_glow.png
		shader: @shaders/diffuse_texshader
	local sun = @sun
	sun.origin = +Xyz(0., 0., 0.)
	sun.orientation = +Quat

	local parts = +List
	parts << light
	parts << skybox
	parts << sun
	parts << ship1
	parts << ship2

	# A pool of missiles, parked below the plane until launched
	local missiles = +List
	each i in 0 .. 15
		local m = +@missile
			origin: +Xyz(0., -1000., 0.)
			velocity: +Xyz(0., 0., 0.)
		missiles << m
		parts << m

	# Life markers: a row of dots per player along the top edge of the map,
	# hovering high above the plane so only the map camera sees them
	each i in 0 .. 4
		local m1 = +@missile
			origin: +Xyz(-58. + i.Float * 3., 120., 40.)
			color: +Color(1., 0.55, 0.45, 1.)
		ship1.markers << m1
		parts << m1
		local m2 = +@missile
			origin: +Xyz(46. + i.Float * 3., 120., 40.)
			color: +Color(0.5, 0.7, 1., 1.)
		ship2.markers << m2
		parts << m2

	ship1: ship1
	ship2: ship2
	missiles: missiles
	scene: +Group
		origin: +Xyz(0., 0., 0.)
		parts: parts

	# Cameras: the map underneath, the two cockpits over the top half.
	# Rect takes x, y, height, width.
	mapcam: +Camera
		viewport: +Rect(0, 0, 324, 1152)
		origin: +Xyz(0., 150., 0.)
		orientation: +Quat.SetAngleAxis(Float.pi / 2., 1., 0., 0.)
		projection: 'Orthogonal'
		viewHeight: 45.              # half the height of the view, in world units
		far: 700.
		shader: @shaders/diffuse_shader
	cam1: +Camera
		viewport: +Rect(0, 324, 324, 576)
		following: ship1
		orientation: +Quat
		shader: @shaders/diffuse_shader
	cam2: +Camera
		viewport: +Rect(576, 324, 324, 576)
		following: ship2
		orientation: +Quat
		shader: @shaders/diffuse_shader
	render: +List using '<<'
		$.mapcam
		$.cam1
		$.cam2

	input: +Object
		keyDown: +Object
			key_A: [] {$.ship1.turning = -1.}
			key_D: [] {$.ship1.turning = 1.}
			key_W: [] {$.ship1.thrusting = 1.}
			key_S: [] {$.ship1.firing = true}
			key_kp_4: [] {$.ship2.turning = -1.}
			key_kp_6: [] {$.ship2.turning = 1.}
			key_kp_8: [] {$.ship2.thrusting = 1.}
			key_kp_5: [] {$.ship2.firing = true}
		keyUp: +Object
			key_A: [] {$.ship1.turning = 0.}
			key_D: [] {$.ship1.turning = 0.}
			key_W: [] {$.ship1.thrusting = 0.}
			key_S: [] {$.ship1.firing = false}
			key_kp_4: [] {$.ship2.turning = 0.}
			key_kp_6: [] {$.ship2.turning = 0.}
			key_kp_8: [] {$.ship2.thrusting = 0.}
			key_kp_5: [] {$.ship2.firing = false}

	# Fire a missile from the ship's nose, if one is free in the pool
	Launch: [ship]
		each m in .missiles
			if not m.alive
				m.alive = true
				m.life = .missilelife
				local fwd = ship.Forward
				m.origin.Set(ship.origin)
				m.origin.Add(fwd, 3.)
				m.velocity.Set(ship.velocity)
				m.velocity.Add(fwd, .missilespeed)
				ship.cooldown = 0.45
				return

	# Park a spent missile
	Kill: [m]
		m.alive = false
		m.origin.Set(0., -1000., 0.)

	animate: [dt]
		@sun .animate(dt)
		local gm = .gm
		local s1 = .ship1
		local s2 = .ship2
		s1.Fly(dt, gm)
		s2.Fly(dt, gm)
		.Launch(s1) if s1.alive and s1.firing and s1.cooldown <= 0.
		.Launch(s2) if s2.alive and s2.firing and s2.cooldown <= 0.
		# Ships that fly into the star
		s1.Destroy if s1.alive and s1.origin.Length < .sunradius + 1.
		s2.Destroy if s2.alive and s2.origin.Length < .sunradius + 1.
		# Missiles fly, fall, expire, and hit
		each m in .missiles
			if m.alive
				m.life = m.life - dt
				local r = m.origin.Length
				if r > 0.1
					m.velocity.Add(m.origin, 0. - gm * dt / (r * r * r))
				m.origin.Add(m.velocity, dt)
				m.origin.y = 0.
				if m.life <= 0. or r < .sunradius
					.Kill(m)
				elif m.life < .missilelife - 0.4
					if s1.alive and m.origin.Distance(s1.origin) < .hitradius
						s1.Destroy
						.Kill(m)
					elif s2.alive and m.origin.Distance(s2.origin) < .hitradius
						s2.Destroy
						.Kill(m)
		# Respawn after the pause, while lives remain
		s1.Reset if not s1.alive and s1.respawn <= 0. and s1.lives > 0
		s2.Reset if not s2.alive and s2.respawn <= 0. and s2.lives > 0
