+Shader
	uniforms: +List('mvpmatrix')
	attributes: +List('positions', 'colors')
	vertex: "
		// Vertex shader for a self-lit mesh where each vertex has its own colors\n
		#version 130\n
		
		uniform mat4 mvpmatrix;
		
		in  vec3 positions;
		in  vec4 colors;
		
		out vec4 vert_color4;
		
		void main(void) {
			gl_Position = mvpmatrix * vec4(positions, 1.0);
			vert_color4 = colors;
		}
		"
	fragment: "
		// Fragment shader passes along interpolated colors from vertex shader\n
		#version 130\n
		
		in  vec4 vert_color4;
		
		void main(void) {
			gl_FragColor = vert_color4;
		}
		"
