# A missile: a small bright sphere that flies under the star's gravity for a
# few seconds. The world keeps a pool of these and parks the dead ones far
# below the plane rather than adding and removing scene parts.
Shape.NewSphere(0.4, 8)
	shader: @shaders/emitonecolor_shader
	color: +Color(1., 0.9, 0.3, 1.)
	alive: false
	life: 0.
