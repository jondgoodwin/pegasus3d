# One player's ship: the fighter, flying in the plane of the star with thrust,
# spin, the star's gravity, and a missile launcher. The world instantiates two
# of these, each with its own origin, velocity, colour, keys and start position.
+@fighter
	eye: +Xyz(0., 0.8, 4.)       # cockpit camera sits behind and above the ship
	heading: 0.                  # angle in the plane; the model's nose is -z,
	                             # so forward is (-sin, 0, -cos)
	turning: 0.                  # -1, 0 or 1 while a turn key is held
	thrusting: 0.                # 0 or 1 while the thrust key is held
	firing: false                # true while the fire key is held
	cooldown: 0.                 # seconds until the launcher can fire again
	alive: true
	respawn: 0.                  # seconds until a destroyed ship comes back
	lives: 5
	spin: 2.5                    # radians per second of turn
	thrust: 3.5                  # acceleration while thrusting
	maxspeed: 14.
	startx: 0.
	startz: 0.
	starth: 0.
	startvx: 0.                  # starting velocity: an orbit, so the ship
	startvz: 0.                  # does not simply fall into the star

	# Put the ship back at its start, in its starting orbit, alive
	Reset: []
		.origin.Set(.startx, 0., .startz)
		.velocity.Set(.startvx, 0., .startvz)
		.heading = .starth
		.orientation.SetAngleAxis(.heading, 0., 1., 0.)
		.alive = true

	# Unit vector the nose points along
	Forward: []
		+Xyz(0. - .heading.Sin, 0., 0. - .heading.Cos)

	# One time step: turn, thrust, fall toward the star, move, stay in the plane
	Fly: [dt, gm]
		if .alive
			.heading = .heading + .turning * .spin * dt
			if .thrusting > 0.
				.velocity.Add(.Forward, .thrust * dt)
			local r = .origin.Length
			if r > 0.1
				.velocity.Add(.origin, 0. - gm * dt / (r * r * r))
			local sp = .velocity.Length
			if sp > .maxspeed
				.velocity.Scale(.maxspeed / sp)
			.origin.Add(.velocity, dt)
			.origin.y = 0.
			.orientation.SetAngleAxis(.heading, 0., 1., 0.)
			.cooldown = .cooldown - dt if .cooldown > 0.
		else
			.respawn = .respawn - dt

	# Blow up: hide the ship below the plane until it respawns, spend a life
	Destroy: []
		.alive = false
		.respawn = 2.5
		.lives = .lives - 1
		.origin.Set(0., -1000., 0.)
		.velocity.Set(0., 0., 0.)
		if .lives >= 0
			.markers[.lives].origin.y = -1000.
