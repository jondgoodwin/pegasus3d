# The vocabulary: every library call a ConeScript world may make, one row each. This is the one place the signatures
# are written: gen_vocab.py turns this list into src/gen/vocabgen.cone (the table and one shim per row), and the checker
# and the builders read that. Edit this file, run `python partbuild/gen_vocab.py`, and commit both.
#
# A row:   NAME | MAKES | PARAMS | EXPRESSION
#   NAME        the call's path, dots between names: lathe, outline.rectangle. A name in [brackets] is a form no path
#               spells: [outline] is a list of flat points where an outline is wanted, [material] a material and its
#               modifiers.
#   MAKES       the type of what a call makes (a Ty of conescript's understand.cone).
#   PARAMS      name: Ty [as CONE] [= DEFAULT], comma separated, in the order arguments by position fill them.
#               Ty        the ConeScript type; it sets the slots (conescript's slotsOf) and the default Cone type:
#                         numbers f32, Truth bool, Point and Direction Vec3, Point2 and LengthRange Vec2, Color Color,
#                         Shape List[PolyMesh], Outline sculpt.Profile, Spine sculpt.Path, Stroke StrokeSpec,
#                         Material MaterialRec, Modifier ModifierRec, Light a handle, Outlines List[sculpt.Profile],
#                         Shapes List[PolyMesh] (all the pieces), Strokes List[StrokeSpec], Modifiers
#                         List[ModifierRec], Points List[Vec3], Points2 List[Vec2], Numbers List[f32].
#               as CONE   f64 (the number as written), u32 (a count), handle (the raw handle slot).
#               DEFAULT   a number, true or false, a tuple (0, 1, 0), or none (handle 0, an empty list). A parameter
#                         that is not required has one; a required parameter has none.
#               A parameter is required when it has no default.
#   EXPRESSION  Cone, with {name} for a parameter. It makes a ToolValue (Color: a Color; Rotation: a Quat; SimTime: an
#               f64 of seconds). It may not use a name that is not one of the row's.
# A row may continue on following lines that begin with a space.
#
# ORDER IS THE SIGNATURE: the first eight rows stay box, plain, srgb, color, rotation, sunLight, physical, sphere,
# because `--show` prints a builder's number as min(row, 8). gen_vocab.py checks this.

box | Shape | x: LengthRange, y: LengthRange, z: LengthRange | ToolValue.Pieces(toolBox({x}, {y}, {z}))
plain | Material | color: Color | ToolValue.Material(toolPlain({color}))
srgb | Color | r: Pure as f64, g: Pure as f64, b: Pure as f64, opacity: Pure as f64 = 1 |
  Color(srgbToLinear({r}), srgbToLinear({g}), srgbToLinear({b}), f32.from({opacity}))
color | Color | r: Pure, g: Pure, b: Pure, opacity: Pure = 1 | Color({r}, {g}, {b}, {opacity})
rotation | Rotation | angle: Angle, about: Direction = (0, 1, 0) | Quat.angleAxis({angle}, {about}.normalize())
sunLight | Light | direction: Direction, color: Color, lux: Illuminance, castsShadow: Truth = false |
  ToolValue.Sun(SunRec({direction}, {color}, {lux}, {castsShadow}))
physical | Material | color: Color, roughness: Pure = 1, metal: Pure = 0 | ToolValue.Material(toolPhysical({color}, {roughness}, {metal}))
sphere | Volume | radius: Length, at: Point = (0, 0, 0) | ToolValue.Volume
sim | SimTime | time: Duration as f64 | {time}
lathe | Shape | profile: Outline, axis: Direction = (0, 1, 0), angle: Angle = 6.2831853, steps: Pure as u32 = 32 |
  ToolValue.Pieces(pieceOf(sculpt.lathe(&{profile}, {axis}, {angle}, {steps})))
loftAlong | Shape | profiles: Outlines, spine: Spine, count: Pure as u32 = 0, between: Pure as u32 = 0, smooth: Truth = false,
  caps: Truth = true, stations: Numbers = none |
  ToolValue.Pieces(pieceOf(sculpt.loftAlong(&{profiles}, &{spine}, {stations}.view(), {count}, {between}, {smooth}, {caps})))
join | Shape | shapes: Shapes | ToolValue.Pieces({shapes})
arrayRadial | Shape | s: Shape, count: Pure as u32, axis: Direction = (0, 1, 0), angle: Angle = 6.2831853,
  origin: Point = (0, 0, 0), merge: Length = 0.0001 |
  ToolValue.Pieces(toolArrayRadial({s}, {count}, {axis}, {angle}, {origin}, {merge}))
translucent | Modifier | covers: Pure | ToolValue.Modifier(ModifierRec(MOD_COVERS, {covers}, 0.))
union | Shape | a: Shape, b: Shape, crease: Pure = 0 | ToolValue.Pieces(toolUnion({a}, {b}, {crease}))
difference | Shape | a: Shape, b: Shape, crease: Pure = 0 | ToolValue.Pieces(toolDifference({a}, {b}, {crease}))
spotLight | Light | reach: Length, color: Color = (1, 1, 1, 1), intensity: Intensity = 0, source: Length = 0,
  castsShadow: Truth = false, aim: Direction = (0, -1, 0), cone: Angle, softEdge: Angle = 0 |
  ToolValue.Lamp(toolLamp({reach}, {color}, {intensity}, {source}, {castsShadow}, {aim}, {cone}, {softEdge}, true))
pointLight | Light | reach: Length, color: Color = (1, 1, 1, 1), intensity: Intensity = 0, source: Length = 0,
  castsShadow: Truth = false |
  ToolValue.Lamp(toolLamp({reach}, {color}, {intensity}, {source}, {castsShadow}, Vec3(0., -1., 0.), 0., 0., false))
clearCoat | Modifier | amount: Pure = 1, roughness: Pure = 0.05 | ToolValue.Modifier(ModifierRec(MOD_COAT, {amount}, {roughness}))
reflective | Modifier | amount: Pure = 1 | ToolValue.Modifier(ModifierRec(MOD_REFLECTS, {amount}, 0.))
camera | Camera | lens: Length = 0.05, aperture: Pure = 0, focus: Length = 2, exposure: Pure = 0 |
  ToolValue.Camera(CameraRec({lens}, {aperture}, {focus}, {exposure}))
outline.rectangle | Outline | width: Length, height: Length | ToolValue.Outline(sculpt.Profile.rectangle({width}, {height}))
outline.points | Outline | points: Outline, closed: Truth = true | ToolValue.Outline(toolClosed({points}, {closed}))
outline.ellipse | Outline | width: Length, height: Length, segments: Pure as u32 = 32 |
  ToolValue.Outline(toolEllipse({width}, {height}, {segments}))
outline.offset | Outline | outline: Outline, by: Length | ToolValue.Outline(offsetOutline(&{outline}, {by}))
spine.line | Spine | from: Point, to: Point, segments: Pure as u32 = 1 | ToolValue.Spine(sculpt.Path.line({from}, {to}, {segments}))
spine.through | Spine | points: Points, segments: Pure as u32 = 8 | ToolValue.Spine(toolThrough({points}, {segments}))
subdivide | Shape | s: Shape, levels: Pure as u32 = 1 | ToolValue.Pieces(toolSubdivide({s}, {levels}))
move | Shape | s: Shape, by: Point | ToolValue.Pieces(toolMove({s}, {by}))
turn | Shape | s: Shape, by: Angle, about: Direction = (0, 1, 0), origin: Point = (0, 0, 0) |
  ToolValue.Pieces(toolTurn({s}, {by}, {about}, {origin}))
inflate | Shape | outline: Outline, thickness: Pure = 1, cell: Length = 0.005, fullness: Pure = 1 |
  ToolValue.Pieces(pieceOf(inflateOutline(&{outline}, {thickness}, {cell}, {fullness})))
smooth | Shape | s: Shape, factor: Pure = 0.5, iterations: Pure as u32 = 1, keepVolume: Truth = false |
  ToolValue.Pieces(toolSmooth({s}, {factor}, {iterations}, {keepVolume}))
carve | Shape | s: Shape, strokes: Strokes, mirror: Direction = (0, 0, 0) | ToolValue.Pieces(toolCarve({s}, {strokes}, {mirror}))
mirror | Shape | s: Shape, normal: Direction = (1, 0, 0), origin: Point = (0, 0, 0), merge: Length = 0.0001 |
  ToolValue.Pieces(toolMirror({s}, {normal}, {origin}, {merge}))
brush.draw | Stroke | along: Outline as handle = none, at: Point2 = (0, 0), onto: Direction = (0, 0, 1), radius: Length,
  strength: Pure = 0.5, ends: Pure = 0 |
  ToolValue.Stroke(toolStroke(handles, sculptbrush.BrushDraw, {along}, {at}, {onto}, {radius}, {strength}, {ends}))
brush.clay | Stroke | along: Outline as handle = none, at: Point2 = (0, 0), onto: Direction = (0, 0, 1), radius: Length,
  strength: Pure = 0.5, ends: Pure = 0 |
  ToolValue.Stroke(toolStroke(handles, sculptbrush.BrushClay, {along}, {at}, {onto}, {radius}, {strength}, {ends}))
brush.clayStrips | Stroke | along: Outline as handle = none, at: Point2 = (0, 0), onto: Direction = (0, 0, 1), radius: Length,
  strength: Pure = 0.5, ends: Pure = 0 |
  ToolValue.Stroke(toolStroke(handles, sculptbrush.BrushClayStrips, {along}, {at}, {onto}, {radius}, {strength}, {ends}))
brush.crease | Stroke | along: Outline as handle = none, at: Point2 = (0, 0), onto: Direction = (0, 0, 1), radius: Length,
  strength: Pure = 0.5, ends: Pure = 0 |
  ToolValue.Stroke(toolStroke(handles, sculptbrush.BrushCrease, {along}, {at}, {onto}, {radius}, {strength}, {ends}))
brush.inflate | Stroke | along: Outline as handle = none, at: Point2 = (0, 0), onto: Direction = (0, 0, 1), radius: Length,
  strength: Pure = 0.5, ends: Pure = 0 |
  ToolValue.Stroke(toolStroke(handles, sculptbrush.BrushInflate, {along}, {at}, {onto}, {radius}, {strength}, {ends}))
brush.pinch | Stroke | along: Outline as handle = none, at: Point2 = (0, 0), onto: Direction = (0, 0, 1), radius: Length,
  strength: Pure = 0.5, ends: Pure = 0 |
  ToolValue.Stroke(toolStroke(handles, sculptbrush.BrushPinch, {along}, {at}, {onto}, {radius}, {strength}, {ends}))
brush.smooth | Stroke | along: Outline as handle = none, at: Point2 = (0, 0), onto: Direction = (0, 0, 1), radius: Length,
  strength: Pure = 0.5, ends: Pure = 0 |
  ToolValue.Stroke(toolStroke(handles, sculptbrush.BrushSmooth, {along}, {at}, {onto}, {radius}, {strength}, {ends}))
brush.flatten | Stroke | along: Outline as handle = none, at: Point2 = (0, 0), onto: Direction = (0, 0, 1), radius: Length,
  strength: Pure = 0.5, ends: Pure = 0 |
  ToolValue.Stroke(toolStroke(handles, sculptbrush.BrushPlane, {along}, {at}, {onto}, {radius}, {strength}, {ends}))
brush.layer | Stroke | along: Outline as handle = none, at: Point2 = (0, 0), onto: Direction = (0, 0, 1), radius: Length,
  strength: Pure = 0.5, ends: Pure = 0 |
  ToolValue.Stroke(toolStroke(handles, sculptbrush.BrushLayer, {along}, {at}, {onto}, {radius}, {strength}, {ends}))
brush.blob | Stroke | along: Outline as handle = none, at: Point2 = (0, 0), onto: Direction = (0, 0, 1), radius: Length,
  strength: Pure = 0.5, ends: Pure = 0 |
  ToolValue.Stroke(toolStroke(handles, sculptbrush.BrushBlob, {along}, {at}, {onto}, {radius}, {strength}, {ends}))
[outline] | Outline | points: Points2 | ToolValue.Outline(sculpt.Profile({points}, false))
[material] | Material | base: Material, modifiers: Modifiers | ToolValue.Material(toolLayered({base}, {modifiers}))
