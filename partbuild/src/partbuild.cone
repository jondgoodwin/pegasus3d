// Part building: the tools a world's parts are made with, as one table and one shim for each of its rows.
//
// The table (conescript's Vocabulary) is written by a person as vocab.list and turned into Cone by gen_vocab.py
// (gen/vocabgen.cone, committed). A shim is the one function that makes a row's call: it reads its arguments from
// the caller's 8-byte slots, in the row's parameter order, borrows the handle arguments from the caller's handle table
// (ToolHandles) and writes its result over the same slots. A browser packs a call's arguments into slots (the table
// says how many, and what each default is), calls the shim, and reads the result back. The checker reads the same
// table, so the signatures are written once.
//
// This package knows sculpt and its brushes, not a window, a GPU or a renderer: what a shim makes is plain data (a
// list of PolyMesh pieces, an outline, a spine, a stroke, a material, a modifier, a light, a camera), which each
// browser maps to its own products.

mod partbuild;

import stdio use *;
import libc;
import collections use *;
import geomath use *;
import mesh use Mesh, PolyMesh;
import sculpt;
import sculptbrush;
import conescript use *;

// How a surface answers light (the guide browser's Look, as plain data)
pub struct MaterialRec {
  pub color: Color;            // linear
  pub physical: bool;          // physical(...): by roughness and metal; else plain(...)
  pub roughness: f32;
  pub metal: f32;
  pub covers: f32;             // how much of what is behind it is hidden: 1 opaque, below 1 see-through
  pub coat: f32;               // a clear coat's strength, 0 none (physical only)
  pub coatRoughness: f32;
  pub reflects: f32;           // how much of the scene it mirrors, 0 the sky alone (physical only)
}

// A material with nothing said: grey, matte, opaque
pub fn greyMaterial() MaterialRec {
  MaterialRec(Color(0.5, 0.5, 0.5, 1.), false, 1., 0., 1., 0., 0.05, 0.)
}

// What a modifier changes (its kind) and the numbers it carries
pub const MOD_COVERS = 0u32;     // translucent(covers:): a = covers
pub const MOD_COAT = 1u32;       // clearCoat(amount:, roughness:): a = amount, b = roughness
pub const MOD_REFLECTS = 2u32;   // reflective(amount:): a = amount
pub struct ModifierRec {
  pub kind: u32;
  pub a: f32;
  pub b: f32;
}

// sunLight(...): 'toSun' points to the sun; the light on a surface facing it is 'color' times 'lux'
pub struct SunRec {
  pub toSun: Vec3;
  pub color: Color;
  pub lux: f32;
  pub shadows: bool;
}

// spotLight(...) or pointLight(...), not yet placed: its aim is in its part's own frame
pub struct LampRec {
  pub aim: Vec3;
  pub color: Color;
  pub candela: f32;
  pub reach: f32;
  pub source: f32;
  pub cone: f32;
  pub softEdge: f32;
  pub spot: bool;
  pub shadows: bool;
}

// camera(...)
pub struct CameraRec {
  pub lens: f32;
  pub aperture: f32;
  pub focus: f32;
  pub exposure: f32;
}

// A brush stroke as written: the recipe carve resolves against the shape it is carved onto
pub struct StrokeSpec {
  pub kind: u32;               // sculptbrush's brush
  pub hasAlong: bool;          // false: one dab at 'at'
  pub along: sculpt.Profile;   // flat points on the side seen from 'onto'
  pub at: Vec2;
  pub onto: Vec3;
  pub radius: f32;
  pub given: f32;              // strength as written: negative takes away
  pub ends: f32;
}

fn copyProfile(p: &sculpt.Profile) sculpt.Profile {
  sculpt.Profile.fromPoints(p.points.view(), p.closed)
}

fn copyPath(p: &sculpt.Path) sculpt.Path {
  var points = List[Vec3]();
  var i = 0usize;
  while i < p.points.len() { points.push(*p.points[i]); i = i + 1usize; }
  var tangents = List[Vec3]();
  i = 0usize;
  while i < p.tangents.len() { tangents.push(*p.tangents[i]); i = i + 1usize; }
  sculpt.Path(points, tangents, p.closed, p.up)
}

fn copyStroke(s: &StrokeSpec) StrokeSpec {
  StrokeSpec(s.kind, s.hasAlong, copyProfile(&s.along), s.at, s.onto, s.radius, s.given, s.ends)
}

