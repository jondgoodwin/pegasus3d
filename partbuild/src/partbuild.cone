// Part building: the tools a world's parts are made with, as one table and one shim for each of its rows.
//
// The table (conescript's Vocabulary) is written by a person as vocab.list and turned into Cone by gen_vocab.py
// (gen/vocabgen.cone, committed). A shim is the one function that makes a row's call: it reads its arguments from
// the caller's 8-byte slots, in the row's parameter order, borrows the handle arguments from the caller's handle table
// (ToolHandles) and writes its result over the same slots. A browser packs a call's arguments into slots (the table
// says how many, and what each default is), calls the shim, and reads the result back. The checker reads the same
// table, so the signatures are written once.
//
// This package knows sculpt and its brushes, not a window, a GPU or a renderer: what a shim makes is plain data (a
// list of PolyMesh pieces, an outline, a spine, a stroke, a material, a modifier, a light, a camera), which each
// browser maps to its own products.

mod partbuild;

import stdio use *;
import libc;
import collections use *;
import geomath use *;
import mesh use Mesh, PolyMesh;
import sculpt;
import sculptbrush;
import conescript use *;

// How a surface answers light (the guide browser's Look, as plain data)
pub struct MaterialRec {
  pub color: Color;            // linear
  pub physical: bool;          // physical(...): by roughness and metal; else plain(...)
  pub roughness: f32;
  pub metal: f32;
  pub covers: f32;             // how much of what is behind it is hidden: 1 opaque, below 1 see-through
  pub coat: f32;               // a clear coat's strength, 0 none (physical only)
  pub coatRoughness: f32;
  pub reflects: f32;           // how much of the scene it mirrors, 0 the sky alone (physical only)
}

// A material with nothing said: grey, matte, opaque
pub fn greyMaterial() MaterialRec {
  MaterialRec(Color(0.5, 0.5, 0.5, 1.), false, 1., 0., 1., 0., 0.05, 0.)
}

// What a modifier changes (its kind) and the numbers it carries
pub const MOD_COVERS = 0u32;     // translucent(covers:): a = covers
pub const MOD_COAT = 1u32;       // clearCoat(amount:, roughness:): a = amount, b = roughness
pub const MOD_REFLECTS = 2u32;   // reflective(amount:): a = amount
pub struct ModifierRec {
  pub kind: u32;
  pub a: f32;
  pub b: f32;
}

// sunLight(...): 'toSun' points to the sun; the light on a surface facing it is 'color' times 'lux'
pub struct SunRec {
  pub toSun: Vec3;
  pub color: Color;
  pub lux: f32;
  pub shadows: bool;
}

// spotLight(...) or pointLight(...), not yet placed: its aim is in its part's own frame
pub struct LampRec {
  pub aim: Vec3;
  pub color: Color;
  pub candela: f32;
  pub reach: f32;
  pub source: f32;
  pub cone: f32;
  pub softEdge: f32;
  pub spot: bool;
  pub shadows: bool;
}

// camera(...)
pub struct CameraRec {
  pub lens: f32;
  pub aperture: f32;
  pub focus: f32;
  pub exposure: f32;
}

// A brush stroke as written: the recipe carve resolves against the shape it is carved onto
pub struct StrokeSpec {
  pub kind: u32;               // sculptbrush's brush
  pub hasAlong: bool;          // false: one dab at 'at'
  pub along: sculpt.Profile;   // flat points on the side seen from 'onto'
  pub at: Vec2;
  pub onto: Vec3;
  pub radius: f32;
  pub given: f32;              // strength as written: negative takes away
  pub ends: f32;
}

fn copyProfile(p: &sculpt.Profile) sculpt.Profile {
  sculpt.Profile.fromPoints(p.points.view(), p.closed)
}

fn copyPath(p: &sculpt.Path) sculpt.Path {
  var points = List[Vec3]();
  var i = 0usize;
  while i < p.points.len() { points.push(*p.points[i]); i = i + 1usize; }
  var tangents = List[Vec3]();
  i = 0usize;
  while i < p.tangents.len() { tangents.push(*p.tangents[i]); i = i + 1usize; }
  sculpt.Path(points, tangents, p.closed, p.up)
}

fn copyStroke(s: &StrokeSpec) StrokeSpec {
  StrokeSpec(s.kind, s.hasAlong, copyProfile(&s.along), s.at, s.onto, s.radius, s.given, s.ends)
}

// What a list handle holds: 'width' slots an item, items one after another
pub struct ItemsRec {
  pub width: u32;
  pub words: List[u64];
}

// What one handle holds
pub enum ToolValue {
  Nothing;                      // handle 0, and what a wrong handle reads as
  Pieces(List[PolyMesh]);       // a shape: pieces, not welded
  Outline(sculpt.Profile);
  Spine(sculpt.Path);
  Stroke(StrokeSpec);
  Material(MaterialRec);
  Modifier(ModifierRec);
  Sun(SunRec);
  Lamp(LampRec);
  Camera(CameraRec);
  Volume;                       // a space: read by the checker, never built
  Items(ItemsRec);              // a list
}

// The handles of one evaluation (a part's, in the guide browser): what the shims made and borrow. Handle 0 is none;
// handle n is the nth value made, counting from 1. A shim borrows its handle arguments (reads them, never takes
// them), so a value used twice is read twice.
pub struct ToolHandles {
  values: List[ToolValue];
  message: String;
  refusedNow: bool;

  pub fn make() ToolHandles { ToolHandles(List[ToolValue](), String.from(""), false) }

  // A new handle for a value
  pub fn add(self: &mut, v: ToolValue) u64 {
    self.values.push(v);
    u64.from(self.values.len())
  }

  // A shim declines the call: it says why, and returns false
  pub fn refuse(self: &mut, why: &str) {
    if !self.refusedNow { self.message = String.from(why); }
    self.refusedNow = true;
  }

  pub fn refused(self: &) bool { self.refusedNow }
  pub fn why(self: &) &str { self.message.view() }

  // A new list handle: 'items' holds 'width' slots an item
  pub fn newList(self: &mut, width: u32, items: &Array[u64]) u64 {
    var words = List[u64]();
    var i = 0usize;
    while i < items.len() { words.push(items[i]); i = i + 1usize; }
    self.add(ToolValue.Items(ItemsRec(width, words)))
  }

  fn bad(self: &mut, what: &str) {
    var m = String.from("expected ");
    m.append(what);
    self.refuse(m.view());
  }

  fn at(self: &, h: u64) usize { usize.from(h) - 1usize }

  // The pieces of a shape, copied (a handle that is not a shape refuses the call)
  pub fn pieces(self: &mut, h: u64) List[PolyMesh] {
    var out = List[PolyMesh]();
    if h == 0u64 || usize.from(h) > self.values.len() { self.bad("a shape"); return out; }
    match &self.values[self.at(h)] {
      case let Pieces(p) {
        var i = 0usize;
        while i < p.len() { out.push(p[i].clone()); i = i + 1usize; }
      }
      else { self.bad("a shape"); }
    }
    out
  }

  pub fn outline(self: &mut, h: u64) sculpt.Profile {
    if h == 0u64 || usize.from(h) > self.values.len() { self.bad("an outline"); return sculpt.Profile.rectangle(0.1, 0.1); }
    match &self.values[self.at(h)] {
      case let Outline(o) { return copyProfile(o); }
      else { self.bad("an outline"); }
    }
    sculpt.Profile.rectangle(0.1, 0.1)
  }

  pub fn spine(self: &mut, h: u64) sculpt.Path {
    if h == 0u64 || usize.from(h) > self.values.len() { self.bad("a spine"); return sculpt.Path.line(Vec3(0., 0., 0.), Vec3(0., 1., 0.), 1u32); }
    match &self.values[self.at(h)] {
      case let Spine(s) { return copyPath(s); }
      else { self.bad("a spine"); }
    }
    sculpt.Path.line(Vec3(0., 0., 0.), Vec3(0., 1., 0.), 1u32)
  }

  pub fn material(self: &mut, h: u64) MaterialRec {
    if h == 0u64 || usize.from(h) > self.values.len() { self.bad("a material"); return greyMaterial(); }
    match &self.values[self.at(h)] {
      case let Material(m) { return *m; }
      else { self.bad("a material"); }
    }
    greyMaterial()
  }

  pub fn modifier(self: &mut, h: u64) ModifierRec {
    if h == 0u64 || usize.from(h) > self.values.len() { self.bad("a modifier"); return ModifierRec(MOD_COVERS, 1., 0.); }
    match &self.values[self.at(h)] {
      case let Modifier(m) { return *m; }
      else { self.bad("a modifier"); }
    }
    ModifierRec(MOD_COVERS, 1., 0.)
  }

  pub fn sun(self: &mut, h: u64) SunRec {
    if h == 0u64 || usize.from(h) > self.values.len() { self.bad("a sun"); return SunRec(Vec3(0., 1., 0.), Color(0., 0., 0., 1.), 0., false); }
    match &self.values[self.at(h)] {
      case let Sun(s) { return *s; }
      else { self.bad("a sun"); }
    }
    SunRec(Vec3(0., 1., 0.), Color(0., 0., 0., 1.), 0., false)
  }

  pub fn lamp(self: &mut, h: u64) LampRec {
    if h == 0u64 || usize.from(h) > self.values.len() { self.bad("a light"); return LampRec(Vec3(0., -1., 0.), Color(1., 1., 1., 1.), 0., 1., 0., 0., 0., false, false); }
    match &self.values[self.at(h)] {
      case let Lamp(l) { return *l; }
      else { self.bad("a light"); }
    }
    LampRec(Vec3(0., -1., 0.), Color(1., 1., 1., 1.), 0., 1., 0., 0., 0., false, false)
  }

  pub fn camera(self: &mut, h: u64) CameraRec {
    if h == 0u64 || usize.from(h) > self.values.len() { self.bad("a camera"); return CameraRec(0.05, 0., 2., 0.); }
    match &self.values[self.at(h)] {
      case let Camera(c) { return *c; }
      else { self.bad("a camera"); }
    }
    CameraRec(0.05, 0., 2., 0.)
  }

  // What a list handle holds, as its words; handle 0 is the empty list
  fn words(self: &mut, h: u64, width: u32, what: &str) List[u64] {
    var out = List[u64]();
    if h == 0u64 { return out; }
    if usize.from(h) > self.values.len() { self.bad(what); return out; }
    match &self.values[self.at(h)] {
      case let Items(r) {
        if r.width != width { self.bad(what); }
        else {
          var i = 0usize;
          while i < r.words.len() { out.push(*r.words[i]); i = i + 1usize; }
        }
      }
      else { self.bad(what); }
    }
    out
  }

  // A list of shapes as the pieces of all of them
  pub fn shapes(self: &mut, h: u64) List[PolyMesh] {
    let ws = self.words(h, 1u32, "a list of shapes");
    var out = List[PolyMesh]();
    var i = 0usize;
    while i < ws.len() {
      var one = self.pieces(*ws[i]);
      var k = 0usize;
      while k < one.len() { out.push(one[k].clone()); k = k + 1usize; }
      i = i + 1usize;
    }
    out
  }

  pub fn outlines(self: &mut, h: u64) List[sculpt.Profile] {
    let ws = self.words(h, 1u32, "a list of outlines");
    var out = List[sculpt.Profile]();
    var i = 0usize;
    while i < ws.len() { out.push(self.outline(*ws[i])); i = i + 1usize; }
    out
  }

  pub fn strokes(self: &mut, h: u64) List[StrokeSpec] {
    let ws = self.words(h, 1u32, "a list of strokes");
    var out = List[StrokeSpec]();
    var i = 0usize;
    while i < ws.len() { out.push(self.stroke(*ws[i])); i = i + 1usize; }
    out
  }

  pub fn stroke(self: &mut, h: u64) StrokeSpec {
    if h == 0u64 || usize.from(h) > self.values.len() { self.bad("a stroke"); return noStroke(); }
    match &self.values[self.at(h)] {
      case let Stroke(s) { return copyStroke(s); }
      else { self.bad("a stroke"); }
    }
    noStroke()
  }

  pub fn modifiers(self: &mut, h: u64) List[ModifierRec] {
    let ws = self.words(h, 1u32, "a list of modifiers");
    var out = List[ModifierRec]();
    var i = 0usize;
    while i < ws.len() { out.push(self.modifier(*ws[i])); i = i + 1usize; }
    out
  }

  // A list of points (three slots an item, as the f64 of the f32 each)
  pub fn points(self: &mut, h: u64) List[Vec3] {
    let ws = self.words(h, 3u32, "a list of points");
    var out = List[Vec3]();
    var i = 0usize;
    while i + 2usize < ws.len() {
      out.push(Vec3(f32.from(f64.fromBits(*ws[i])), f32.from(f64.fromBits(*ws[i + 1usize])), f32.from(f64.fromBits(*ws[i + 2usize]))));
      i = i + 3usize;
    }
    out
  }

  // A list of flat points
  pub fn flatPoints(self: &mut, h: u64) List[Vec2] {
    let ws = self.words(h, 2u32, "a list of flat points");
    var out = List[Vec2]();
    var i = 0usize;
    while i + 1usize < ws.len() {
      out.push(Vec2(f32.from(f64.fromBits(*ws[i])), f32.from(f64.fromBits(*ws[i + 1usize]))));
      i = i + 2usize;
    }
    out
  }

  // A list of plain numbers
  pub fn numbers(self: &mut, h: u64) List[f32] {
    let ws = self.words(h, 1u32, "a list of numbers");
    var out = List[f32]();
    var i = 0usize;
    while i < ws.len() { out.push(f32.from(f64.fromBits(*ws[i]))); i = i + 1usize; }
    out
  }
}

fn noStroke() StrokeSpec {
  StrokeSpec(sculptbrush.BrushDraw, false, sculpt.Profile.rectangle(0.1, 0.1), Vec2(0., 0.), Vec3(0., 0., 1.), 0.001, 0., 0.)
}

// One shim: reads its arguments from the first slots, writes its result over them; false when it declines
// (it has said why through handles.refuse)
pub alias ToolShim = &fn(handles: &mut ToolHandles, slots: &mut Array[u64]) bool;
pub alias ToolShims = List[ToolShim];

// A world's text read with this package's table: parsed, expanded and understood
pub fn readWorld(src: &Array[u8]) Reading {
  var names = Names.standard();
  let vocab = vocabulary(&mut names);
  read(src, names, vocab)
}
