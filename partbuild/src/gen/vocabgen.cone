  let p_onto: Vec3 = Vec3(f32.from(f64.fromBits(slots[3usize])), f32.from(f64.fromBits(slots[4usize])), f32.from(f64.fromBits(slots[5usize])));
  let p_radius: f32 = f32.from(f64.fromBits(slots[6usize]));
  let p_strength: f32 = f32.from(f64.fromBits(slots[7usize]));
  let p_ends: f32 = f32.from(f64.fromBits(slots[8usize]));
  if refused(handles) { return false; }
  let result = ToolValue.Stroke(toolStroke(handles, sculptbrush.BrushPinch, p_along, p_at, p_onto, p_radius, p_strength, p_ends));
  if refused(handles) { return false; }
  slots[0usize] = handles.allocValue(result);
  true
}

