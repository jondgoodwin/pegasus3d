// The table: every row, in the list's order
pub fn vocabulary(names: &mut Names) Vocabulary {
  var v = Vocabulary.empty();
  v.tools.push(row0(names));
  v.tools.push(row1(names));
  v.tools.push(row2(names));
  v.tools.push(row3(names));
  v.tools.push(row4(names));
  v.tools.push(row5(names));
  v.tools.push(row6(names));
  v.tools.push(row7(names));
  v.tools.push(row8(names));
  v.tools.push(row9(names));
  v.tools.push(row10(names));
  v.tools.push(row11(names));
  v.tools.push(row12(names));
  v.tools.push(row13(names));
  v.tools.push(row14(names));
  v.tools.push(row15(names));
  v.tools.push(row16(names));
  v.tools.push(row17(names));
  v.tools.push(row18(names));
  v.tools.push(row19(names));
  v.tools.push(row20(names));
  v.tools.push(row21(names));
  v.tools.push(row22(names));
  v.tools.push(row23(names));
  v.tools.push(row24(names));
  v.tools.push(row25(names));
  v.tools.push(row26(names));
  v.tools.push(row27(names));
  v.tools.push(row28(names));
  v.tools.push(row29(names));
  v.tools.push(row30(names));
  v.tools.push(row31(names));
  v.tools.push(row32(names));
  v.tools.push(row33(names));
  v.tools.push(row34(names));
  v.tools.push(row35(names));
  v.tools.push(row36(names));
  v.tools.push(row37(names));
  v.tools.push(row38(names));
  v.tools.push(row39(names));
  v.tools.push(row40(names));
  v.tools.push(row41(names));
  v.tools.push(row42(names));
  v.tools.push(row43(names));
  v.tools.push(row44(names));
  v.tools.push(row45(names));
  v.outlineList = 44u32;
  v.materialList = 45u32;
  v
}

// 0: box
fn shim0(handles: &mut ToolHandles, slots: &mut Array[u64]) bool {
  let p_x: Vec2 = Vec2(f32.from(f64.fromBits(slots[0usize])), f32.from(f64.fromBits(slots[1usize])));
  let p_y: Vec2 = Vec2(f32.from(f64.fromBits(slots[2usize])), f32.from(f64.fromBits(slots[3usize])));
  let p_z: Vec2 = Vec2(f32.from(f64.fromBits(slots[4usize])), f32.from(f64.fromBits(slots[5usize])));
  if refused(handles) { return false; }
  let result = ToolValue.Pieces(toolBox(p_x, p_y, p_z));
  if refused(handles) { return false; }
  slots[0usize] = handles.allocValue(result);
  true
}

// 1: plain
fn shim1(handles: &mut ToolHandles, slots: &mut Array[u64]) bool {
  let p_color: Color = Color(f32.from(f64.fromBits(slots[0usize])), f32.from(f64.fromBits(slots[1usize])), f32.from(f64.fromBits(slots[2usize])), f32.from(f64.fromBits(slots[3usize])));
  if refused(handles) { return false; }
  let result = ToolValue.Material(toolPlain(p_color));
  if refused(handles) { return false; }
  slots[0usize] = handles.allocValue(result);
  true
}

// 2: srgb
fn shim2(handles: &mut ToolHandles, slots: &mut Array[u64]) bool {
  let p_r: f64 = f64.fromBits(slots[0usize]);
  let p_g: f64 = f64.fromBits(slots[1usize]);
  let p_b: f64 = f64.fromBits(slots[2usize]);
  let p_opacity: f64 = f64.fromBits(slots[3usize]);
  if refused(handles) { return false; }
  let result = Color(srgbToLinear(p_r), srgbToLinear(p_g), srgbToLinear(p_b), f32.from(p_opacity));
  if refused(handles) { return false; }
  slots[0usize] = f64.from(result.red).bits();
  slots[1usize] = f64.from(result.green).bits();
  slots[2usize] = f64.from(result.blue).bits();
  slots[3usize] = f64.from(result.alpha).bits();
  true
}

// 3: color
fn shim3(handles: &mut ToolHandles, slots: &mut Array[u64]) bool {
  let p_r: f32 = f32.from(f64.fromBits(slots[0usize]));
  let p_g: f32 = f32.from(f64.fromBits(slots[1usize]));
  let p_b: f32 = f32.from(f64.fromBits(slots[2usize]));
  let p_opacity: f32 = f32.from(f64.fromBits(slots[3usize]));
  if refused(handles) { return false; }
  let result = Color(p_r, p_g, p_b, p_opacity);
  if refused(handles) { return false; }
  slots[0usize] = f64.from(result.red).bits();
  slots[1usize] = f64.from(result.green).bits();
  slots[2usize] = f64.from(result.blue).bits();
  slots[3usize] = f64.from(result.alpha).bits();
  true
}

// 4: rotation
fn shim4(handles: &mut ToolHandles, slots: &mut Array[u64]) bool {
  let p_angle: f32 = f32.from(f64.fromBits(slots[0usize]));
  let p_about: Vec3 = Vec3(f32.from(f64.fromBits(slots[1usize])), f32.from(f64.fromBits(slots[2usize])), f32.from(f64.fromBits(slots[3usize])));
  if refused(handles) { return false; }
  let result = Quat.angleAxis(p_angle, p_about.normalize());
  if refused(handles) { return false; }
  slots[0usize] = f64.from(result.x).bits();
  slots[1usize] = f64.from(result.y).bits();
  slots[2usize] = f64.from(result.z).bits();
  slots[3usize] = f64.from(result.w).bits();
  true
}

// 5: sunLight
fn shim5(handles: &mut ToolHandles, slots: &mut Array[u64]) bool {
  let p_direction: Vec3 = Vec3(f32.from(f64.fromBits(slots[0usize])), f32.from(f64.fromBits(slots[1usize])), f32.from(f64.fromBits(slots[2usize])));
  let p_color: Color = Color(f32.from(f64.fromBits(slots[3usize])), f32.from(f64.fromBits(slots[4usize])), f32.from(f64.fromBits(slots[5usize])), f32.from(f64.fromBits(slots[6usize])));
  let p_lux: f32 = f32.from(f64.fromBits(slots[7usize]));
  let p_castsShadow: bool = slots[8usize] != 0u64;
  if refused(handles) { return false; }
  let result = ToolValue.Sun(SunRec(p_direction, p_color, p_lux, p_castsShadow));
  if refused(handles) { return false; }
  slots[0usize] = handles.allocValue(result);
  true
}

// 6: physical
fn shim6(handles: &mut ToolHandles, slots: &mut Array[u64]) bool {
  let p_color: Color = Color(f32.from(f64.fromBits(slots[0usize])), f32.from(f64.fromBits(slots[1usize])), f32.from(f64.fromBits(slots[2usize])), f32.from(f64.fromBits(slots[3usize])));
  let p_roughness: f32 = f32.from(f64.fromBits(slots[4usize]));
  let p_metal: f32 = f32.from(f64.fromBits(slots[5usize]));
  if refused(handles) { return false; }
  let result = ToolValue.Material(toolPhysical(p_color, p_roughness, p_metal));
  if refused(handles) { return false; }
  slots[0usize] = handles.allocValue(result);
  true
}

