// 44: [outline]
fn shim44(handles: &mut ToolHandles, slots: &mut Array[u64]) bool {
  let p_points = readFlatPoints(handles, slots[0usize]);
  if refused(handles) { return false; }
  let result = ToolValue.Outline(sculpt.Profile(p_points, false));
  if refused(handles) { return false; }
  slots[0usize] = handles.allocValue(result);
  true
}

// 45: [material]
fn shim45(handles: &mut ToolHandles, slots: &mut Array[u64]) bool {
  let p_base = readMaterial(handles, slots[0usize]);
  let p_modifiers = readModifiers(handles, slots[1usize]);
  if refused(handles) { return false; }
  let result = ToolValue.Material(toolLayered(p_base, p_modifiers));
  if refused(handles) { return false; }
  slots[0usize] = handles.allocValue(result);
  true
}

// The shims, by the table's row numbers
pub fn toolShims() ToolShims {
  var s = ToolShims();
  s.push(&shim0);
  s.push(&shim1);
  s.push(&shim2);
  s.push(&shim3);
  s.push(&shim4);
  s.push(&shim5);
  s.push(&shim6);
  s.push(&shim7);
  s.push(&shim8);
  s.push(&shim9);
  s.push(&shim10);
  s.push(&shim11);
  s.push(&shim12);
  s.push(&shim13);
  s.push(&shim14);
  s.push(&shim15);
  s.push(&shim16);
  s.push(&shim17);
  s.push(&shim18);
  s.push(&shim19);
  s.push(&shim20);
  s.push(&shim21);
  s.push(&shim22);
  s.push(&shim23);
  s.push(&shim24);
  s.push(&shim25);
  s.push(&shim26);
  s.push(&shim27);
  s.push(&shim28);
  s.push(&shim29);
  s.push(&shim30);
  s.push(&shim31);
  s.push(&shim32);
  s.push(&shim33);
  s.push(&shim34);
  s.push(&shim35);
  s.push(&shim36);
  s.push(&shim37);
  s.push(&shim38);
  s.push(&shim39);
  s.push(&shim40);
  s.push(&shim41);
  s.push(&shim42);
  s.push(&shim43);
  s.push(&shim44);
  s.push(&shim45);
  s
}
